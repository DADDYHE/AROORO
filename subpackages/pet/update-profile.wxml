<zy-navbar title="更新宠物档案" />
<scroll-view
  scroll-y
  enhanced
  refresher-enabled="{{true}}"
  refresher-triggered="{{_refresherTriggered}}"
  bindrefresherrefresh="_onRefresherRefresh"
  bindscrolltolower="_onScrollToLower"
  bindscroll="_onScroll"
  lower-threshold="100"
  style="height: calc(100vh - {{_navbarHeight}}px);"
>
<view class="gallery-container">
  <view class="gallery-header">
    <view class="brand-block">
      <view class="brand-accent-bar"></view>
      <view class="brand-main">
        <text class="brand-text">更新档案</text>
      </view>
      <view class="brand-meta">
        <view class="brand-meta-line"></view>
        <text class="brand-subtitle">修改宠物信息</text>
      </view>
    </view>
  </view>

  <view class="gallery-hall">
    <view class="gallery-portrait" bindtap="chooseAvatar">
      <view class="portrait-frame">
        <image wx:if="{{editingData.avatarUrl}}" lazy-load class="portrait-image" src="{{editingData.avatarUrl}}" mode="aspectFill" binderror="onCloudImageError" data-src="{{editingData.avatarUrl}}" data-path="editingData.avatarUrl" />
        <view wx:else class="portrait-canvas">
          <view class="canvas-crosshair-h"></view>
          <view class="canvas-crosshair-v"></view>
          <view class="canvas-corner canvas-tl"></view>
          <view class="canvas-corner canvas-tr"></view>
          <view class="canvas-corner canvas-bl"></view>
          <view class="canvas-corner canvas-br"></view>
        </view>
      </view>
      <view class="portrait-label">
        <view class="label-line"></view>
        <text class="label-text">{{editingData.avatarUrl ? '点击更换头像' : '点击上传宠物头像'}}</text>
      </view>
    </view>

    <view class="gallery-entrance">
      <view class="entrance-line"></view>
      <text class="entrance-label">基本信息</text>
    </view>

    <view class="gallery-collection">
      <view class="gallery-card">
        <view class="card-accent"></view>
        <view class="card-body">
          <view class="form-group">
            <!-- 宠物昵称 -->
            <view class="form-row">
              <view class="field-label"><text>宠物昵称</text><text class="label-required">（必填）</text></view>
              <input
                class="form-input"
                value="{{editingData.name}}"
                placeholder="请输入宠物昵称"
                placeholder-class="form-placeholder"
                bindinput="onNameInput"
              />
            </view>

            <view class="field-divider"></view>

            <!-- 宠物类型 -->
            <view class="form-row form-row--select" bindtap="selectPetType">
              <view class="field-label"><text>宠物类型</text><text class="label-required">（必填）</text></view>
              <view class="form-value {{editingData.type ? '' : 'form-placeholder'}}">
                <text class="form-value-text">{{editingData.type === 'dog' ? '狗狗' : (editingData.type === 'cat' ? '猫咪' : (editingData.type === 'exotic' ? '异宠' : '请选择宠物类型'))}}</text>
              </view>
              <view class="field-arrow">
                <view class="arrow-line"></view>
              </view>
            </view>

            <view class="field-divider"></view>

            <!-- 性别 -->
            <view class="form-row form-row--select" bindtap="selectGender">
              <view class="field-label"><text>性别</text><text class="label-required">（必填）</text></view>
              <view class="form-value {{editingData.gender ? '' : 'form-placeholder'}}">
                <text class="form-value-text">{{editingData.gender === 'male' ? '弟弟' : (editingData.gender === 'female' ? '妹妹' : (editingData.gender === 'unknown' ? '不确定' : '请选择性别'))}}</text>
              </view>
              <view class="field-arrow">
                <view class="arrow-line"></view>
              </view>
            </view>

            <view class="field-divider"></view>

            <!-- 品种 -->
            <view class="form-row">
              <view class="field-label"><text>品种</text></view>
              <input
                class="form-input"
                value="{{editingData.breed}}"
                placeholder="请输入品种"
                placeholder-class="form-placeholder"
                bindinput="onBreedInput"
              />
            </view>

            <view class="field-divider"></view>

            <!-- 出生日期（原生 picker mode="date"） -->
            <picker mode="date" value="{{editingData.birthday || todayStr}}" start="2000-01-01" end="{{todayStr}}" bindchange="onConfirmBirthday">
              <view class="form-row form-row--select">
                <view class="field-label"><text>出生日期</text></view>
                <view class="form-value {{editingData.birthday ? '' : 'form-placeholder'}}">
                  <text class="form-value-text">{{editingData.birthday || '请选择出生日期'}}</text>
                </view>
                <view class="field-arrow">
                  <view class="arrow-line"></view>
                </view>
              </view>
            </picker>

            <view class="field-divider"></view>

            <!-- 体重 -->
            <view class="form-row">
              <view class="field-label"><text>体重</text></view>
              <input
                class="form-input"
                type="digit"
                value="{{editingData.weight}}"
                placeholder="请输入体重（kg）"
                placeholder-class="form-placeholder"
                bindinput="onWeightInput"
              />
            </view>

            <view class="field-divider"></view>

            <!-- 备注 -->
            <view class="form-row form-row--textarea">
              <view class="field-label"><text>备注</text></view>
              <textarea
                class="form-textarea"
                value="{{editingData.note}}"
                placeholder="性格傲娇还是可爱？还有生活习惯和饮食习惯描述一下吧"
                placeholder-class="form-placeholder"
                auto-height
                maxlength="-1"
                bindinput="onNoteInput"
              />
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="gallery-footer">
      <view bindtap="savePetInfo" class="footer-action {{saving ? 'action-disabled' : 'action-active'}}">
        <text>保存修改</text>
      </view>
    </view>
  </view>

  <!-- 宠物类型选择 -->
  <zy-action-sheet
    show="{{showTypeSheet}}"
    actions="{{petTypes}}"
    cancel-text="取消"
    bind:select="onSelectType"
    bind:close="onCloseTypeSheet"
  />

  <!-- 性别选择 -->
  <zy-action-sheet
    show="{{showGenderSheet}}"
    actions="{{petGenders}}"
    cancel-text="取消"
    bind:select="onSelectGender"
    bind:close="onCloseGenderSheet"
  />
</view>
</scroll-view>
