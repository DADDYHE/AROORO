/* ================================================================
   pet/detail.wxss · AROORO 宠物详情页 — Haute-Luxury Editorial
   主色：深林绿家族 --primary-color
   Skyline 兼容：无 :active / text-transform / backdrop-filter / sticky
   ================================================================ */
@import './common.wxss';

/* ===== B · 深绿沉浸标题版（页级覆盖，不影响 common 共用页） ===== */
.gallery-header {
  background: var(--lux-green-grad);
  border-bottom: none;
}

.brand-block {
  padding: 220rpx var(--page-padding) 64rpx;
}

.brand-accent-bar {
  background: var(--lux-gold-500);
}

.brand-text {
  color: #F7F5EF;
}

.brand-meta-line {
  background: rgba(247, 245, 239, 0.35);
}

.brand-meta-line::after {
  background: var(--lux-gold-500);
}

.brand-subtitle {
  color: rgba(247, 245, 239, 0.72);
}

/* ===== A · 拆档案白卡为纸面分节 ===== */
.gallery-collection {
  background: transparent;
  border-radius: 0;
  border: none;
  border-bottom: 1rpx solid var(--hairline);
}

/* ===== 详情页头像（稍大） ===== */
.portrait-frame {
  width: 240rpx;
  height: 240rpx;
}

/* ===== 信息行 ===== */
.info-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: var(--zy-space-lg) var(--zy-space-lg);
  transition-property: background-color;
  transition-duration: 240ms;
  transition-timing-function: cubic-bezier(0.25,0.1,0.25,1);
}

.info-row--note {
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
}

.info-key {
  font-family: var(--font-sans);
  font-size: 26rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.04em;
  flex-shrink: 0;
  font-weight: 400;
  min-width: 140rpx;
}

.info-val {
  font-family: var(--font-sans);
  font-size: 28rpx;
  color: var(--text-primary);
  letter-spacing: 0.02em;
  text-align: right;
  flex: 1;
  margin-left: var(--zy-space-lg);
  line-height: 1.5;
  font-weight: 400;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.info-row--note .info-val {
  text-align: left;
  margin-left: 0;
  white-space: normal;
  overflow-wrap: break-word;
}

.info-divider {
  height: 1rpx;
  background: var(--hairline);
  margin: 0 var(--zy-space-lg) 0 var(--zy-space-lg);
}
