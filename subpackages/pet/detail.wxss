@import './common.wxss';

.canvas-tl {
  top: 50%;
  left: 50%;
  transform: translate(-56rpx, -56rpx);
  border-top-width: 2rpx;
  border-left-width: 2rpx;
}

.canvas-tr {
  top: 50%;
  right: 50%;
  transform: translate(56rpx, -56rpx);
  border-top-width: 2rpx;
  border-right-width: 2rpx;
}

.canvas-bl {
  bottom: 50%;
  left: 50%;
  transform: translate(-56rpx, 56rpx);
  border-bottom-width: 2rpx;
  border-left-width: 2rpx;
}

.canvas-br {
  bottom: 50%;
  right: 50%;
  transform: translate(56rpx, 56rpx);
  border-bottom-width: 2rpx;
  border-right-width: 2rpx;
}

.gallery-entrance {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
  padding: 0 8rpx;
}

.entrance-line {
  width: 32rpx;
  height: 4rpx;
  background: linear-gradient(90deg, var(--activity-primary) 0%, var(--activity-primary-mid) 100%);
  border-radius: 2rpx;
}

.entrance-label {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 600;
  letter-spacing: 4rpx;
}

.card-accent {
  width: 4rpx;
  background: linear-gradient(180deg, var(--activity-primary) 0%, var(--activity-primary-mid) 100%);
  flex-shrink: 0;
}

.card-body {
  flex: 1;
  padding: 8rpx 0 8rpx 36rpx;
  min-width: 0;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 36rpx 24rpx 0;
}

.info-row--note {
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
}

.info-key {
  font-size: 26rpx;
  color: var(--text-secondary);
  letter-spacing: 2rpx;
  flex-shrink: 0;
}

.info-val {
  font-size: 28rpx;
  color: var(--text-primary);
  letter-spacing: 1rpx;
  text-align: right;
  flex: 1;
  margin-left: 32rpx;
  line-height: 1.5;
}

.info-row--note .info-val {
  text-align: left;
  margin-left: 0;
}

.info-divider {
  height: 1rpx;
  background: var(--divider-color);
  margin: 0 36rpx 0 0;
}

.gallery-footer {
  padding: 0 0 20rpx;
}

.footer-action {
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  padding: 28rpx 0;
  text-align: center;
  transition: all 0.3s ease;
}

.action-active {
  background: linear-gradient(135deg, var(--activity-primary) 0%, var(--activity-primary-mid) 100%);
  color: var(--card-color);
  box-shadow: 0 6rpx 20rpx rgba(78, 205, 196, 0.3);
}

.action-active:active {
  transform: scale(0.98);
  box-shadow: 0 3rpx 12rpx rgba(78, 205, 196, 0.3);
}

.loading-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.loading-dot:nth-child(3) {
  animation-delay: 0.4s;
}
