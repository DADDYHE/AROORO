/* ================================================================
   components/zy-action-sheet · AROORO Haute-Luxury 底部动作面板
   ----------------------------------------------------------------
   奶油白底 · 发丝描边 · 顶部 20rpx 圆角 · 60×4rpx 手柄
   Skyline 兼容：无 :active / backdrop-filter / position:sticky
   按压反馈统一由 hover-class 驱动（--hover 类）
   ================================================================ */

.zy-action-sheet {
  width: 100%;
  background: var(--card-cream, #FBF9F4);
  padding-bottom: env(safe-area-inset-bottom, 0);
  position: relative;
  /* 顶部圆角由 zy-popup 容器提供，此处兜底 */
  border-radius: var(--zy-radius-xl) var(--zy-radius-xl) 0 0;
  overflow: hidden;
}

/* 顶部手柄 bar（60rpx × 4rpx，发丝灰，全圆角） */
.zy-action-sheet::before {
  content: '';
  display: block;
  width: 60rpx;
  height: 4rpx;
  background: var(--border-color, #E2DED3);
  border-radius: var(--zy-radius-pill);
  margin: 16rpx auto 0;
}

/* ---------- 头部 ---------- */
.zy-action-sheet__header {
  padding: 24rpx 48rpx 20rpx;
  text-align: center;
  background: var(--card-cream, #FBF9F4);
}

.zy-action-sheet__title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary, #1A1A17);
  line-height: 1.4;
  letter-spacing: 0.02em;
}

.zy-action-sheet__description {
  font-size: 24rpx;
  color: var(--text-tertiary);
  line-height: 1.5;
  margin-top: 8rpx;
  font-weight: 400;
  letter-spacing: 0.02em;
}

/* ---------- 选项列表 ---------- */
.zy-action-sheet__content {
  background: var(--card-cream, #FBF9F4);
}

.zy-action-sheet__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 96rpx;
  padding: 24rpx 48rpx;
  text-align: center;
  position: relative;
  background: var(--card-cream, #FBF9F4);
  color: var(--text-primary, #1A1A17);
  box-sizing: border-box;
  transition: background-color var(--transition-fast, 280ms cubic-bezier(0.25, 0.1, 0.25, 1)),
              transform var(--transition-fast, 280ms cubic-bezier(0.25, 0.1, 0.25, 1)),
              opacity var(--transition-fast, 280ms cubic-bezier(0.25, 0.1, 0.25, 1));
}

/* 发丝底部分割线（最后一项不显示） */
.zy-action-sheet__item::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 48rpx;
  right: 48rpx;
  height: 1rpx;
  background: var(--hairline, rgba(26, 26, 23, 0.08));
  pointer-events: none;
}

.zy-action-sheet__item:last-child::after {
  display: none;
}

/* 按压反馈（由 hover-class 驱动） */
.zy-action-sheet__item--hover {
  background: var(--primary-wash, #F2F5EC);
}

.zy-action-sheet__item--disabled {
  color: var(--text-tertiary);
  opacity: 0.5;
  pointer-events: none;
}

.zy-action-sheet__item--loading {
  color: var(--text-tertiary);
  pointer-events: none;
}

.zy-action-sheet__item-name {
  font-size: 32rpx;
  line-height: 1.4;
  font-weight: 400;
  letter-spacing: 0.02em;
}

.zy-action-sheet__item--disabled,
.zy-action-sheet__item--loading {
  color: var(--text-tertiary);
}

.zy-action-sheet__item--disabled .zy-action-sheet__item-name,
.zy-action-sheet__item--loading .zy-action-sheet__item-name {
  color: inherit;
}

.zy-action-sheet__item-subname {
  font-size: 24rpx;
  color: var(--text-tertiary);
  line-height: 1.5;
  margin-top: 6rpx;
  font-weight: 400;
  letter-spacing: 0.02em;
}

/* ---------- 分隔间隙（16rpx，奶油色间隔，非边框） ---------- */
.zy-action-sheet__gap {
  height: 16rpx;
  background: var(--background-color, #F7F5EF);
}

/* ---------- 取消按钮（奶油底，独立分区） ---------- */
.zy-action-sheet__cancel {
  background: var(--card-cream, #FBF9F4);
  padding: 28rpx 48rpx;
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 32rpx;
  color: var(--text-primary, #1A1A17);
  font-weight: 500;
  letter-spacing: 0.04em;
  position: relative;
  box-sizing: border-box;
  transition: background-color var(--transition-fast, 280ms cubic-bezier(0.25, 0.1, 0.25, 1));
}

/* 取消按钮按压反馈 */
.zy-action-sheet__cancel--hover {
  background: var(--primary-wash, #F2F5EC);
}
