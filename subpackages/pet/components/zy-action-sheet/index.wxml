<!-- zy-action-sheet · Skyline 兼容底部动作面板 -->
<zy-popup
  visible="{{show}}"
  position="bottom"
  round="{{round}}"
  closeable="{{closeable}}"
  overlay="{{true}}"
  close-on-click-overlay="{{true}}"
  z-index="{{zIndex}}"
  duration="{{500}}"
  bind:close="onClose"
>
  <view class="zy-action-sheet" catchtap="noop">
    <!-- 头部 -->
    <view wx:if="{{title || description}}" class="zy-action-sheet__header">
      <view wx:if="{{title}}" class="zy-action-sheet__title">{{title}}</view>
      <view wx:if="{{description}}" class="zy-action-sheet__description">{{description}}</view>
    </view>

    <!-- 选项列表 -->
    <view class="zy-action-sheet__content" wx:if="{{actions.length}}">
      <view
        wx:for="{{actions}}"
        wx:key="index"
        class="zy-action-sheet__item {{item.disabled ? 'zy-action-sheet__item--disabled' : ''}} {{item.loading ? 'zy-action-sheet__item--loading' : ''}}"
        hover-class="{{!item.disabled && !item.loading ? 'zy-action-sheet__item--hover' : ''}}"
        hover-stay-time="100"
        style="{{item.color ? 'color: ' + item.color : ''}}"
        data-index="{{index}}"
        catchtap="onSelect"
      >
        <view class="zy-action-sheet__item-name">{{item.name}}</view>
        <view wx:if="{{item.subname}}" class="zy-action-sheet__item-subname">{{item.subname}}</view>
      </view>
    </view>

    <!-- 自定义内容插槽 -->
    <slot></slot>

    <!-- 取消按钮 -->
    <view wx:if="{{cancelText}}" class="zy-action-sheet__gap"></view>
    <view
      wx:if="{{cancelText}}"
      class="zy-action-sheet__cancel"
      hover-class="zy-action-sheet__cancel--hover"
      hover-stay-time="100"
      catchtap="onCancel"
    >{{cancelText}}</view>
  </view>
</zy-popup>
