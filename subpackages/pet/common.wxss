/* ================================================================
   pet/common.wxss · AROORO 宠物子包公共样式 — Haute-Luxury Editorial
   主色：深林绿家族 --primary-color / --primary-deep
   Skyline 兼容：无 :active / text-transform / backdrop-filter / sticky
   ================================================================ */

/* ===== 页面级变量 ===== */
page {
  background-color: var(--background-color);
  font-family: var(--font-sans);
}

/* ===== 入场动画 ===== */
@keyframes fadeInUp {
  0% {
    opacity: 0;
    transform: translateY(28rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeIn {
  0% { opacity: 0; }
  100% { opacity: 1; }
}

/* ===== 页面容器 ===== */
.gallery-container {
  min-height: 100vh;
  background-color: var(--background-color);
  position: relative;
  overflow-x: hidden;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

/* ===== 顶部品牌栏 ===== */
.gallery-header {
  position: relative;
  background: var(--card-color);
  border-bottom: 1rpx solid var(--hairline);
  overflow: hidden;
}

.brand-block {
  padding: calc(var(--zy-space-xl) + env(safe-area-inset-top)) var(--page-padding) var(--zy-space-lg);
  position: relative;
  animation-name: fadeIn;
  animation-duration: 400ms;
  animation-timing-function: cubic-bezier(0.16,1,0.3,1);
  animation-fill-mode: forwards;
}

.brand-accent-bar {
  position: absolute;
  top: 0;
  left: var(--page-padding);
  width: 48rpx;
  height: 6rpx;
  background: var(--gradient-primary);
  border-radius: 0 0 4rpx 4rpx;
}

.brand-main {
  position: relative;
  margin-bottom: 20rpx;
}

.brand-text {
  font-family: var(--font-sans);
  font-size: 48rpx;
  font-weight: 300;
  color: var(--text-primary);
  letter-spacing: 0.10em;
  display: block;
  line-height: 1.1;
}

.brand-meta {
  display: flex;
  align-items: center;
  gap: var(--zy-space-sm2);
}

.brand-meta-line {
  width: 40rpx;
  height: 2rpx;
  background: var(--border-color);
  position: relative;
}

.brand-meta-line::after {
  content: '';
  position: absolute;
  top: 50%;
  right: -4rpx;
  transform: translateY(-50%);
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: var(--primary-color);
}

.brand-subtitle {
  font-family: var(--font-sans);
  font-size: 22rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.12em;
  font-weight: 400;
}

/* ===== 内容区 ===== */
.gallery-hall {
  padding: var(--zy-space-lg) var(--page-padding);
  animation-name: fadeIn;
  animation-duration: 400ms;
  animation-timing-function: cubic-bezier(0.16,1,0.3,1);
  animation-fill-mode: forwards;
}

/* ===== 头像上传区（圆形） ===== */
.gallery-portrait {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: var(--zy-space-lg);
}

.portrait-frame {
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  overflow: hidden;
  background: var(--card-cream);
  border: 1rpx solid var(--hairline);
  position: relative;
}

.portrait-image {
  width: 100%;
  height: 100%;
  display: block;
}

.portrait-canvas {
  width: 100%;
  height: 100%;
  position: relative;
  background: var(--primary-wash);
}

.canvas-crosshair-h {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 64rpx;
  height: 1rpx;
  background: var(--border-color);
}

.canvas-crosshair-v {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 1rpx;
  height: 64rpx;
  background: var(--border-color);
}

.canvas-corner {
  position: absolute;
  width: 24rpx;
  height: 24rpx;
  border-color: var(--text-tertiary);
  border-style: solid;
  border-width: 0;
  opacity: 0.4;
}

.canvas-tl {
  top: 24rpx;
  left: 24rpx;
  border-top-width: 2rpx;
  border-left-width: 2rpx;
}

.canvas-tr {
  top: 24rpx;
  right: 24rpx;
  border-top-width: 2rpx;
  border-right-width: 2rpx;
}

.canvas-bl {
  bottom: 24rpx;
  left: 24rpx;
  border-bottom-width: 2rpx;
  border-left-width: 2rpx;
}

.canvas-br {
  bottom: 24rpx;
  right: 24rpx;
  border-bottom-width: 2rpx;
  border-right-width: 2rpx;
}

.portrait-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: var(--zy-space-sm2);
}

.label-line {
  width: 20rpx;
  height: 2rpx;
  background: var(--primary-color);
}

.label-text {
  font-family: var(--font-sans);
  font-size: 22rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.06em;
  font-weight: 400;
}

/* ===== 区块标题 ===== */
.gallery-entrance {
  display: flex;
  align-items: center;
  gap: var(--zy-space-sm2);
  margin-bottom: var(--zy-space-sm2);
}

.entrance-line {
  width: 32rpx;
  height: 3rpx;
  background: var(--gradient-primary);
  border-radius: 2rpx;
  flex-shrink: 0;
}

.entrance-label {
  font-family: var(--font-sans);
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 500;
  letter-spacing: 0.08em;
  flex: 1;
}

/* ===== 卡片容器 ===== */
.gallery-collection {
  background: var(--card-color);
  border-radius: var(--zy-radius-lg);
  overflow: hidden;
  border: 1rpx solid var(--hairline);
  margin-bottom: var(--zy-space-lg);
}

.gallery-card {
  position: relative;
  display: flex;
}

.card-accent {
  width: 3rpx;
  background: var(--gradient-primary);
  flex-shrink: 0;
  opacity: 0.6;
}

.card-body {
  flex: 1;
  min-width: 0;
}

/* ===== 表单组 ===== */
.form-group {
  background: transparent;
}

.form-field {
  font-family: var(--font-sans);
  font-size: 28rpx;
  font-weight: 400;
  color: var(--text-primary);
  letter-spacing: 0.02em;
}

.field-divider {
  height: 1rpx;
  background: var(--hairline);
  margin: 0 var(--zy-space-lg);
}

.form-row {
  display: flex;
  align-items: center;
  padding: var(--zy-space-sm2) var(--zy-space-lg);
  min-height: 96rpx;
  box-sizing: border-box;
}

.form-row--textarea {
  align-items: flex-start;
  flex-direction: column;
  min-height: 0;
  padding-bottom: var(--zy-space-lg);
}

.form-input {
  flex: 1;
  min-width: 0;
  font-family: var(--font-sans);
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.5;
  text-align: right;
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
}

.form-textarea {
  width: 100%;
  min-height: 140rpx;
  font-family: var(--font-sans);
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.6;
  padding: 8rpx 0 var(--zy-space-sm2);
  margin: 0;
  border: none;
  background: transparent;
  box-sizing: border-box;
}

.form-value {
  flex: 1;
  min-width: 0;
  font-family: var(--font-sans);
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.5;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Skyline 下 view 的 text-align 不继承到内部 text 组件，需显式设置 */
.form-value-text {
  display: block;
  width: 100%;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.form-placeholder {
  color: var(--text-tertiary);
  font-size: 28rpx;
  font-weight: 400;
}

.field-label {
  font-family: var(--font-sans);
  font-size: 26rpx;
  color: var(--text-secondary);
  letter-spacing: 0.04em;
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-right: var(--zy-space-lg);
  font-weight: 400;
  min-width: 160rpx;
}

.label-required {
  color: var(--error-color);
  font-size: 22rpx;
  font-weight: 400;
  margin-left: 4rpx;
}

/* ===== 选择箭头 ===== */
.field-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  margin-left: var(--zy-space-sm);
  flex-shrink: 0;
}

.arrow-line {
  width: 18rpx;
  height: 1rpx;
  background: var(--text-tertiary);
  position: relative;
}

.arrow-line::after {
  content: '';
  position: absolute;
  top: 50%;
  right: 0;
  width: 10rpx;
  height: 1rpx;
  background: var(--text-tertiary);
  transform: rotate(45deg);
  transform-origin: right center;
  margin-top: -3rpx;
}

.arrow-line::before {
  content: '';
  position: absolute;
  bottom: 50%;
  right: 0;
  width: 10rpx;
  height: 1rpx;
  background: var(--text-tertiary);
  transform: rotate(-45deg);
  transform-origin: right center;
  margin-bottom: -3rpx;
}

/* ===== 底部主按钮 ===== */
.gallery-footer {
  padding: var(--zy-space-sm2) 0 0;
}

.footer-action {
  border-radius: var(--zy-radius-lg);
  font-family: var(--font-sans);
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 0.10em;
  padding: 28rpx 0;
  text-align: center;
  transition: transform 280ms cubic-bezier(0.25,0.1,0.25,1),
              opacity 280ms cubic-bezier(0.25,0.1,0.25,1),
              box-shadow 280ms cubic-bezier(0.25,0.1,0.25,1);
}

.action-active {
  background: var(--gradient-primary);
  color: var(--text-on-primary);
  box-shadow: var(--shadow-glow-primary-btn);
}

.action-active--pressed {
  transform: scale(0.98);
  box-shadow: var(--shadow-glow-primary-xs);
}

.action-disabled {
  background: var(--gradient-primary);
  color: rgba(247, 245, 239, 0.5);
  opacity: 0.5;
  box-shadow: none;
}

/* ===== 加载态（通用） ===== */
.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
  padding: var(--zy-space-2xl) var(--page-padding);
}

.loading-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--zy-space-lg);
}

.loading-brand-mark {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.brand-ring {
  position: absolute;
  width: 64rpx;
  height: 64rpx;
  border: 2rpx solid var(--primary-tint);
  border-top-color: var(--primary-color);
  border-radius: 50%;
  animation-name: spin;
  animation-duration: 1400ms;
  animation-timing-function: linear;
  animation-fill-mode: forwards;
  animation-iteration-count: infinite;
}

.brand-ring--delay {
  width: 44rpx;
  height: 44rpx;
  border-color: transparent;
  border-top-color: var(--primary-soft);
  animation-direction: reverse;
  animation-duration: 1800ms;
}

.brand-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--primary-color);
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-dots {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.loading-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--primary-color);
  opacity: 0.25;
  animation-name: dotPulse;
  animation-duration: 2400ms;
  animation-timing-function: cubic-bezier(0.45, 0, 0.55, 1);
  animation-fill-mode: forwards;
  animation-iteration-count: infinite;
}

.loading-dot:nth-child(2) {
  animation-delay: 400ms;
}

.loading-dot:nth-child(3) {
  animation-delay: 800ms;
}

@keyframes dotPulse {
  0%, 100% { opacity: 0.25; transform: scale(0.85); }
  50% { opacity: 0.9; transform: scale(1); }
}

.loading-text {
  font-family: var(--font-sans);
  font-size: 22rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.12em;
  font-weight: 400;
}
