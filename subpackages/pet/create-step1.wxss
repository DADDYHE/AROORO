.gallery-container {
  min-height: 100vh;
  background-color: #F5F5F7;
  padding-bottom: env(safe-area-inset-bottom);
}

.gallery-header {
  padding: 0;
  position: relative;
  overflow: hidden;
  background: #FFFFFF;
  animation: fadeUp 0.6s ease-out;
  padding-bottom: 20rpx;
}

.brand-block {
  padding: 80rpx 48rpx 64rpx;
  position: relative;
}

.brand-block::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, rgba(78, 205, 196, 0.15) 0%, transparent 70%);
  pointer-events: none;
}

.brand-accent-bar {
  position: absolute;
  top: 0;
  left: 48rpx;
  width: 48rpx;
  height: 6rpx;
  background: linear-gradient(90deg, #4ECDC4 0%, #2AB7A9 100%);
  border-radius: 0 0 4rpx 4rpx;
  animation: slideDown 0.5s ease-out;
}

.brand-main {
  position: relative;
  margin-bottom: 24rpx;
}

.brand-text {
  font-size: 64rpx;
  font-weight: 300;
  color: #1D1D1F;
  letter-spacing: 12rpx;
  display: block;
  line-height: 1;
  position: relative;
}

.brand-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.brand-meta-line {
  width: 40rpx;
  height: 2rpx;
  background: #E5E5EA;
  position: relative;
}

.brand-meta-line::after {
  content: '';
  position: absolute;
  top: 50%;
  right: -4rpx;
  transform: translateY(-50%);
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #4ECDC4;
}

.brand-subtitle {
  font-size: 22rpx;
  color: #8E8E93;
  letter-spacing: 8rpx;
  font-weight: 400;
}

.gallery-hall {
  padding: 32rpx;
  animation: fadeUp 0.6s ease-out 0.2s both;
}

.gallery-portrait {
  margin-bottom: 32rpx;
}

.portrait-frame {
  width: 100%;
  height: 400rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #FFFFFF;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(134, 134, 139, 0.1);
  position: relative;
}

.portrait-image {
  width: 100%;
  height: 100%;
  display: block;
}

.portrait-canvas {
  width: 100%;
  height: 100%;
  position: relative;
  background: #FAFAFA;
}

.canvas-crosshair-h {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80rpx;
  height: 2rpx;
  background: #D1D1D6;
}

.canvas-crosshair-v {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 2rpx;
  height: 80rpx;
  background: #D1D1D6;
}

.canvas-corner {
  position: absolute;
  width: 32rpx;
  height: 32rpx;
  border-color: #C7C7CC;
  border-style: solid;
  border-width: 0;
}

.canvas-tl {
  top: 50%;
  left: 50%;
  transform: translate(-56rpx, -56rpx);
  border-top-width: 2rpx;
  border-left-width: 2rpx;
}

.canvas-tr {
  top: 50%;
  right: 50%;
  transform: translate(56rpx, -56rpx);
  border-top-width: 2rpx;
  border-right-width: 2rpx;
}

.canvas-bl {
  bottom: 50%;
  left: 50%;
  transform: translate(-56rpx, 56rpx);
  border-bottom-width: 2rpx;
  border-left-width: 2rpx;
}

.canvas-br {
  bottom: 50%;
  right: 50%;
  transform: translate(56rpx, 56rpx);
  border-bottom-width: 2rpx;
  border-right-width: 2rpx;
}

.portrait-label {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
  padding: 0 8rpx;
}

.label-line {
  width: 24rpx;
  height: 2rpx;
  background: #4ECDC4;
}

.label-text {
  font-size: 22rpx;
  color: #8E8E93;
  letter-spacing: 4rpx;
}

.gallery-entrance {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
  padding: 0 8rpx;
}

.entrance-line {
  width: 32rpx;
  height: 4rpx;
  background: linear-gradient(90deg, #4ECDC4 0%, #2AB7A9 100%);
  border-radius: 2rpx;
}

.entrance-label {
  font-size: 26rpx;
  color: #1D1D1F;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.gallery-collection {
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(134, 134, 139, 0.1);
  margin-bottom: 40rpx;
}

.gallery-card {
  position: relative;
  display: flex;
}

.card-accent {
  width: 4rpx;
  background: linear-gradient(180deg, #4ECDC4 0%, #2AB7A9 100%);
  flex-shrink: 0;
}

.card-body {
  flex: 1;
  padding: 8rpx 0 8rpx 36rpx;
  min-width: 0;
}

.form-group {
  background: transparent !important;
}

.form-field {
  font-size: 28rpx;
  font-weight: 400;
  color: #1D1D1F;
  letter-spacing: 1rpx;
}

.form-field-textarea {
  padding-bottom: 32rpx !important;
}

.field-divider {
  height: 1rpx;
  background: #F2F2F7;
  margin: 0 24rpx;
}

.field-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
}

.arrow-line {
  width: 20rpx;
  height: 2rpx;
  background: #C7C7CC;
  position: relative;
}

.arrow-line::after {
  content: '';
  position: absolute;
  top: 50%;
  right: 0;
  width: 10rpx;
  height: 2rpx;
  background: #C7C7CC;
  transform: rotate(45deg);
  transform-origin: right center;
}

.arrow-line::before {
  content: '';
  position: absolute;
  bottom: 50%;
  right: 0;
  width: 10rpx;
  height: 2rpx;
  background: #C7C7CC;
  transform: rotate(-45deg);
  transform-origin: right center;
}

.gallery-footer {
  padding: 0 0 20rpx;
}

.footer-action {
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  padding: 28rpx 0;
  text-align: center;
  transition: all 0.3s ease;
}

.action-active {
  background: linear-gradient(135deg, #4ECDC4 0%, #2AB7A9 100%);
  color: #FFFFFF;
  box-shadow: 0 6rpx 20rpx rgba(78, 205, 196, 0.3);
}

.action-active:active {
  transform: scale(0.98);
  box-shadow: 0 3rpx 12rpx rgba(78, 205, 196, 0.3);
}

.action-disabled {
  background: linear-gradient(135deg, #4ECDC4 0%, #2AB7A9 100%);
  color: rgba(255, 255, 255, 0.5);
  opacity: 0.5;
}

.form-group .van-cell {
  background: transparent !important;
  padding-top: 20rpx !important;
  padding-bottom: 20rpx !important;
  padding-left: 0 !important;
  padding-right: 0 !important;
  align-items: center !important;
}

.form-group .van-cell::after {
  display: none !important;
}

.form-group .van-field {
  align-items: center !important;
}

.form-group .van-field__label {
  color: #8E8E93 !important;
  font-size: 26rpx !important;
  font-weight: 400 !important;
  letter-spacing: 2rpx !important;
  line-height: 1.4 !important;
  display: flex !important;
  align-items: center !important;
}

.field-label {
  font-size: 26rpx;
  color: #8E8E93;
  letter-spacing: 2rpx;
  display: flex;
  align-items: center;
}

.label-required {
  color: #E8433E;
  font-size: 24rpx;
}

.form-group .van-field__control {
  color: #1D1D1F !important;
  font-size: 28rpx !important;
  line-height: 1.4 !important;
}

.form-group .van-field__control::placeholder {
  color: #C7C7CC !important;
}

.form-group .van-field__right-icon {
  color: #C7C7CC !important;
  display: flex !important;
  align-items: center !important;
}

.form-group .van-field__required {
  display: none !important;
}

.form-group .van-field__body {
  flex: 1 !important;
  min-width: 0 !important;
  display: flex !important;
  align-items: center !important;
}

@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(24rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media screen and (max-width: 750rpx) {
  .brand-block {
    padding: 60rpx 36rpx 48rpx;
  }

  .brand-text {
    font-size: 48rpx;
    letter-spacing: 8rpx;
  }

  .brand-subtitle {
    font-size: 20rpx;
    letter-spacing: 4rpx;
  }

  .gallery-hall {
    padding: 24rpx;
  }

  .portrait-frame {
    height: 320rpx;
  }

  .form-field {
    padding: 12rpx 20rpx !important;
  }

  .field-divider {
    margin: 0 20rpx;
  }
}
