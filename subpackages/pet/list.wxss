.gallery-container {
  min-height: 100vh;
  background-color: #F5F5F7;
  padding-bottom: env(safe-area-inset-bottom);
}

.gallery-header {
  padding: 0;
  position: relative;
  overflow: hidden;
  background: #FFFFFF;
  animation: fadeUp 0.6s ease-out;
  padding-bottom: 20rpx;
}

.brand-block {
  padding: 80rpx 48rpx 64rpx;
  position: relative;
}

.brand-block::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, rgba(78, 205, 196, 0.15) 0%, transparent 70%);
  pointer-events: none;
}

.brand-accent-bar {
  position: absolute;
  top: 0;
  left: 48rpx;
  width: 48rpx;
  height: 6rpx;
  background: linear-gradient(90deg, #4ECDC4 0%, #2AB7A9 100%);
  border-radius: 0 0 4rpx 4rpx;
  animation: slideDown 0.5s ease-out;
}

.brand-main {
  position: relative;
  margin-bottom: 24rpx;
}

.brand-text {
  font-size: 64rpx;
  font-weight: 300;
  color: #1D1D1F;
  letter-spacing: 12rpx;
  display: block;
  line-height: 1;
}

.brand-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.brand-meta-line {
  width: 40rpx;
  height: 2rpx;
  background: #E5E5EA;
  position: relative;
}

.brand-meta-line::after {
  content: '';
  position: absolute;
  top: 50%;
  right: -4rpx;
  transform: translateY(-50%);
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #4ECDC4;
}

.brand-subtitle {
  font-size: 22rpx;
  color: #8E8E93;
  letter-spacing: 8rpx;
  font-weight: 400;
}

.gallery-hall {
  padding: 32rpx;
  animation: fadeUp 0.6s ease-out 0.2s both;
}

.gallery-entrance {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
  padding: 0 8rpx;
}

.entrance-line {
  width: 32rpx;
  height: 4rpx;
  background: linear-gradient(90deg, #4ECDC4 0%, #2AB7A9 100%);
  border-radius: 2rpx;
}

.entrance-label {
  font-size: 26rpx;
  color: #1D1D1F;
  font-weight: 600;
  letter-spacing: 4rpx;
  flex: 1;
}

.entrance-action {
  font-size: 24rpx;
  color: #8E8E93;
  letter-spacing: 2rpx;
  padding: 8rpx 20rpx;
  border: 1rpx solid #E5E5EA;
  border-radius: 8rpx;
  transition: all 0.3s ease;
}

.entrance-action:active {
  opacity: 0.7;
}

.entrance-action--cancel {
  color: #8E8E93;
  border-color: #E5E5EA;
}

.entrance-action--delete {
  color: #E8433E;
  border-color: rgba(232, 67, 62, 0.3);
}

.entrance-action--disabled {
  opacity: 0.4;
  pointer-events: none;
}

.entrance-actions {
  display: flex;
  gap: 16rpx;
}

.gallery-collection {
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(134, 134, 139, 0.1);
  margin-bottom: 40rpx;
}

.gallery-card {
  position: relative;
  display: flex;
}

.card-accent {
  width: 4rpx;
  background: linear-gradient(180deg, #4ECDC4 0%, #2AB7A9 100%);
  flex-shrink: 0;
}

.card-body {
  flex: 1;
  padding: 8rpx 0;
  min-width: 0;
}

.pet-item {
  display: flex;
  align-items: center;
  padding: 28rpx 36rpx 28rpx 36rpx;
  transition: background 0.3s ease;
  position: relative;
}

.pet-item:not(:last-child)::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 36rpx;
  right: 36rpx;
  height: 1rpx;
  background: #F2F2F7;
}

.pet-item:active {
  background: rgba(78, 205, 196, 0.04);
}

.pet-item--manage:active {
  background: transparent;
}

.pet-portrait {
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #F5F5F7;
  flex-shrink: 0;
  margin-right: 28rpx;
  border: 1rpx solid rgba(134, 134, 139, 0.1);
}

.pet-portrait-image {
  width: 100%;
  height: 100%;
  display: block;
}

.pet-info {
  flex: 1;
  min-width: 0;
}

.pet-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #1D1D1F;
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pet-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.pet-meta-tag {
  font-size: 22rpx;
  color: #8E8E93;
  letter-spacing: 1rpx;
  background: #F5F5F7;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.pet-meta-tag--light {
  background: transparent;
  color: #C7C7CC;
}

.pet-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.arrow-line {
  width: 20rpx;
  height: 2rpx;
  background: #C7C7CC;
  position: relative;
}

.arrow-line::after {
  content: '';
  position: absolute;
  top: 50%;
  right: 0;
  width: 10rpx;
  height: 2rpx;
  background: #C7C7CC;
  transform: rotate(45deg);
  transform-origin: right center;
}

.arrow-line::before {
  content: '';
  position: absolute;
  bottom: 50%;
  right: 0;
  width: 10rpx;
  height: 2rpx;
  background: #C7C7CC;
  transform: rotate(-45deg);
  transform-origin: right center;
}

.pet-selector {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.selector-circle {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #D1D1D6;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.selector-circle--active {
  background: #4ECDC4;
  border-color: #4ECDC4;
}

.selector-check {
  width: 16rpx;
  height: 10rpx;
  border-left: 3rpx solid #FFFFFF;
  border-bottom: 3rpx solid #FFFFFF;
  transform: rotate(-45deg);
  margin-top: -3rpx;
}

.gallery-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx 80rpx;
}

.empty-frame {
  width: 240rpx;
  height: 240rpx;
  position: relative;
  background: #FAFAFA;
  border-radius: 24rpx;
  border: 1rpx solid rgba(134, 134, 139, 0.1);
  margin-bottom: 32rpx;
}

.empty-crosshair-h {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80rpx;
  height: 2rpx;
  background: #D1D1D6;
}

.empty-crosshair-v {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 2rpx;
  height: 80rpx;
  background: #D1D1D6;
}

.empty-corner {
  position: absolute;
  width: 32rpx;
  height: 32rpx;
  border-color: #C7C7CC;
  border-style: solid;
  border-width: 0;
}

.empty-tl {
  top: 50%;
  left: 50%;
  transform: translate(-56rpx, -56rpx);
  border-top-width: 2rpx;
  border-left-width: 2rpx;
}

.empty-tr {
  top: 50%;
  right: 50%;
  transform: translate(56rpx, -56rpx);
  border-top-width: 2rpx;
  border-right-width: 2rpx;
}

.empty-bl {
  bottom: 50%;
  left: 50%;
  transform: translate(-56rpx, 56rpx);
  border-bottom-width: 2rpx;
  border-left-width: 2rpx;
}

.empty-br {
  bottom: 50%;
  right: 50%;
  transform: translate(56rpx, 56rpx);
  border-bottom-width: 2rpx;
  border-right-width: 2rpx;
}

.empty-label {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.label-line {
  width: 24rpx;
  height: 2rpx;
  background: #4ECDC4;
}

.label-text {
  font-size: 22rpx;
  color: #8E8E93;
  letter-spacing: 4rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #C7C7CC;
  letter-spacing: 2rpx;
}

.gallery-footer {
  padding: 0 0 20rpx;
}

.footer-action {
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  padding: 28rpx 0;
  text-align: center;
  transition: all 0.3s ease;
}

.action-active {
  background: linear-gradient(135deg, #4ECDC4 0%, #2AB7A9 100%);
  color: #FFFFFF;
  box-shadow: 0 6rpx 20rpx rgba(78, 205, 196, 0.3);
}

.action-active:active {
  transform: scale(0.98);
  box-shadow: 0 3rpx 12rpx rgba(78, 205, 196, 0.3);
}

.loading-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(245, 245, 247, 0.95);
  z-index: 9999;
}

.loading-spinner {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.spinner-outer {
  position: absolute;
  width: 100%;
  height: 100%;
  border: 4rpx solid transparent;
  border-top-color: #4ECDC4;
  border-right-color: rgba(78, 205, 196, 0.3);
  border-radius: 50%;
  animation: spin 1.2s linear infinite;
}

.spinner-inner {
  position: absolute;
  width: 60%;
  height: 60%;
  border: 3rpx solid transparent;
  border-bottom-color: #2AB7A9;
  border-left-color: rgba(42, 183, 169, 0.3);
  border-radius: 50%;
  animation: spin 0.8s linear infinite reverse;
}

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes slideDown {
  from { opacity: 0; transform: translateY(-20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

@media screen and (max-width: 750rpx) {
  .brand-block { padding: 60rpx 36rpx 48rpx; }
  .brand-text { font-size: 48rpx; letter-spacing: 8rpx; }
  .brand-subtitle { font-size: 20rpx; letter-spacing: 4rpx; }
  .gallery-hall { padding: 24rpx; }
  .pet-item { padding: 24rpx 28rpx; }
  .pet-portrait { width: 80rpx; height: 80rpx; margin-right: 24rpx; }
  .pet-name { font-size: 28rpx; }
}
