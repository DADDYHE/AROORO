/* ================================================================
   pet/list.wxss · AROORO 宠物列表页 — Haute-Luxury Editorial
   主色：深林绿家族 --primary-color
   Skyline 兼容：无 :active / text-transform / backdrop-filter / sticky
   ================================================================ */
@import './common.wxss';

/* ===== 入口操作栏（管理/取消/删除） ===== */
.entrance-action {
  font-family: var(--font-sans);
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 0.04em;
  padding: 8rpx 24rpx;
  border: 1rpx solid var(--hairline);
  border-radius: var(--zy-radius-lg);
  background: var(--card-color);
  font-weight: 400;
  transition: transform 240ms cubic-bezier(0.25,0.1,0.25,1),
              opacity 240ms cubic-bezier(0.25,0.1,0.25,1),
              border-color 240ms cubic-bezier(0.25,0.1,0.25,1);
}

.entrance-action--pressed {
  transform: scale(0.96);
}

.entrance-action--cancel {
  color: var(--text-secondary);
  border-color: var(--hairline);
}

.entrance-action--delete {
  color: var(--error-color);
  border-color: rgba(184, 92, 60, 0.25);
}

.entrance-action--disabled {
  opacity: 0.35;
}

.entrance-actions {
  display: flex;
  gap: var(--zy-space-sm);
}

/* ===== 宠物卡片条目 ===== */
.pet-item {
  display: flex;
  align-items: center;
  padding: var(--zy-space-lg) var(--zy-space-lg);
  position: relative;
  transition: transform 240ms cubic-bezier(0.25,0.1,0.25,1),
              background-color 240ms cubic-bezier(0.25,0.1,0.25,1);
}

.pet-item--pressed {
  background-color: var(--primary-wash);
}

.pet-item-divider {
  position: absolute;
  bottom: 0;
  left: var(--zy-space-lg);
  right: var(--zy-space-lg);
  height: 1rpx;
  background: var(--hairline);
}

/* ===== 宠物头像（圆形 + 1rpx 发丝边框） ===== */
.pet-portrait {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  overflow: hidden;
  background: var(--card-cream);
  flex-shrink: 0;
  margin-right: var(--zy-space-lg);
  border: 1rpx solid var(--hairline);
}

.pet-portrait-image {
  width: 100%;
  height: 100%;
  display: block;
}

/* ===== 宠物信息 ===== */
.pet-info {
  flex: 1;
  min-width: 0;
}

.pet-name {
  font-family: var(--font-sans);
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.04em;
  margin-bottom: 10rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pet-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.pet-meta-tag {
  font-family: var(--font-sans);
  font-size: 22rpx;
  color: var(--text-secondary);
  letter-spacing: 0.02em;
  background: var(--primary-wash);
  padding: 4rpx 14rpx;
  border-radius: var(--zy-radius-sm);
  font-weight: 400;
}

.pet-meta-tag--light {
  background: transparent;
  color: var(--text-tertiary);
  padding: 4rpx 0;
}

/* ===== 右侧箭头 ===== */
.pet-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  margin-left: var(--zy-space-sm);
}

/* ===== 管理模式选择圈 ===== */
.pet-selector {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  margin-left: var(--zy-space-sm);
}

.selector-circle {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 1rpx solid var(--border-color);
  background: var(--card-color);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color 240ms cubic-bezier(0.25,0.1,0.25,1),
              border-color 240ms cubic-bezier(0.25,0.1,0.25,1);
}

.selector-circle--active {
  background: var(--primary-color);
  border-color: var(--primary-color);
}

.selector-check {
  width: 14rpx;
  height: 8rpx;
  border-left: 2rpx solid var(--text-on-primary);
  border-bottom: 2rpx solid var(--text-on-primary);
  transform: rotate(-45deg);
  margin-top: -3rpx;
}

/* ===== 空状态（无宠物） ===== */
.gallery-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx var(--zy-space-lg) 80rpx;
  animation-name: fadeIn;
  animation-duration: 600ms;
  animation-timing-function: cubic-bezier(0.16,1,0.3,1);
  animation-fill-mode: forwards;
}

.empty-frame {
  width: 200rpx;
  height: 200rpx;
  position: relative;
  background: var(--card-cream);
  border-radius: 50%;
  border: 1rpx dashed var(--border-color);
  margin-bottom: var(--zy-space-lg);
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-crosshair-h {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 64rpx;
  height: 1rpx;
  background: var(--border-color);
}

.empty-crosshair-v {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 1rpx;
  height: 64rpx;
  background: var(--border-color);
}

.empty-corner {
  display: none;
}

.empty-tl, .empty-tr, .empty-bl, .empty-br {
  display: none;
}

.empty-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: var(--zy-space-sm);
}

.empty-hint {
  font-family: var(--font-sans);
  font-size: 24rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.06em;
  font-weight: 400;
}
