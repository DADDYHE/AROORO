@import './common.wxss';

.gallery-entrance {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
  padding: 0 8rpx;
}

.entrance-line {
  width: 32rpx;
  height: 4rpx;
  background: linear-gradient(90deg, var(--activity-primary) 0%, var(--activity-primary-mid) 100%);
  border-radius: 2rpx;
}

.entrance-label {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 600;
  letter-spacing: 4rpx;
  flex: 1;
}

.entrance-action {
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 2rpx;
  padding: 8rpx 20rpx;
  border: 1rpx solid var(--gray-200);
  border-radius: 8rpx;
}

.entrance-action--cancel {
  color: var(--text-secondary);
  border-color: var(--gray-200);
}

.entrance-action--delete {
  color: #E8433E;
  border-color: rgba(232, 67, 62, 0.3);
}

.entrance-action--disabled {
  opacity: 0.4;
  pointer-events: none;
}

.entrance-actions {
  display: flex;
  gap: 16rpx;
}

.card-accent {
  width: 4rpx;
  background: linear-gradient(180deg, var(--activity-primary) 0%, var(--activity-primary-mid) 100%);
  flex-shrink: 0;
}

.card-body {
  flex: 1;
  padding: 8rpx 0;
  min-width: 0;
}

.pet-item {
  display: flex;
  align-items: center;
  padding: 28rpx 36rpx 28rpx 36rpx;
  position: relative;
}

.pet-item:not(:last-child)::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 36rpx;
  right: 36rpx;
  height: 1rpx;
  background: var(--divider-color);
}

.pet-portrait {
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: var(--background-color);
  flex-shrink: 0;
  margin-right: 28rpx;
  border: 1rpx solid rgba(134, 134, 139, 0.1);
}

.pet-portrait-image {
  width: 100%;
  height: 100%;
  display: block;
}

.pet-info {
  flex: 1;
  min-width: 0;
}

.pet-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pet-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.pet-meta-tag {
  font-size: 22rpx;
  color: var(--text-secondary);
  letter-spacing: 1rpx;
  background: var(--background-color);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.pet-meta-tag--light {
  background: transparent;
  color: var(--text-tertiary);
}

.pet-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.arrow-line {
  width: 20rpx;
  height: 2rpx;
  background: var(--text-tertiary);
  position: relative;
}

.arrow-line::after {
  content: '';
  position: absolute;
  top: 50%;
  right: 0;
  width: 10rpx;
  height: 2rpx;
  background: var(--text-tertiary);
  transform: rotate(45deg);
  transform-origin: right center;
}

.arrow-line::before {
  content: '';
  position: absolute;
  bottom: 50%;
  right: 0;
  width: 10rpx;
  height: 2rpx;
  background: var(--text-tertiary);
  transform: rotate(-45deg);
  transform-origin: right center;
}

.pet-selector {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.selector-circle {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #D1D1D6;
  background: var(--card-color);
  display: flex;
  align-items: center;
  justify-content: center;
}

.selector-circle--active {
  background: var(--activity-primary);
  border-color: var(--activity-primary);
}

.selector-check {
  width: 16rpx;
  height: 10rpx;
  border-left: 3rpx solid var(--card-color);
  border-bottom: 3rpx solid var(--card-color);
  transform: rotate(-45deg);
  margin-top: -3rpx;
}

.empty-frame {
  width: 240rpx;
  height: 240rpx;
  position: relative;
  background: var(--surface-tint);
  border-radius: 24rpx;
  border: 1rpx solid rgba(134, 134, 139, 0.1);
  margin-bottom: 32rpx;
}

.empty-crosshair-h {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80rpx;
  height: 2rpx;
  background: #D1D1D6;
}

.empty-crosshair-v {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 2rpx;
  height: 80rpx;
  background: #D1D1D6;
}

.empty-corner {
  position: absolute;
  width: 32rpx;
  height: 32rpx;
  border-color: var(--text-tertiary);
  border-style: solid;
  border-width: 0;
}

.empty-tl {
  top: 50%;
  left: 50%;
  transform: translate(-56rpx, -56rpx);
  border-top-width: 2rpx;
  border-left-width: 2rpx;
}

.empty-tr {
  top: 50%;
  right: 50%;
  transform: translate(56rpx, -56rpx);
  border-top-width: 2rpx;
  border-right-width: 2rpx;
}

.empty-bl {
  bottom: 50%;
  left: 50%;
  transform: translate(-56rpx, 56rpx);
  border-bottom-width: 2rpx;
  border-left-width: 2rpx;
}

.empty-br {
  bottom: 50%;
  right: 50%;
  transform: translate(56rpx, 56rpx);
  border-bottom-width: 2rpx;
  border-right-width: 2rpx;
}

.empty-label {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: var(--text-tertiary);
  letter-spacing: 2rpx;
}

.gallery-footer {
  padding: 0 0 20rpx;
}

.footer-action {
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  padding: 28rpx 0;
  text-align: center;
}

.action-active {
  background: linear-gradient(135deg, var(--activity-primary) 0%, var(--activity-primary-mid) 100%);
  color: var(--card-color);
  box-shadow: 0 6rpx 20rpx rgba(79, 94, 53, 0.3);
}

.loading-dot:nth-child(2) {
}

.loading-dot:nth-child(3) {
}

@media screen and (max-width: 750rpx) {
  .pet-item { padding: 24rpx 28rpx; }
  .pet-portrait { width: 80rpx; height: 80rpx; margin-right: 24rpx; }
  .pet-name { font-size: 28rpx; }
}
