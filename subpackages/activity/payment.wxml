<zy-navbar title="支付" />
<scroll-view
  scroll-y
  enhanced
  refresher-enabled="{{true}}"
  refresher-triggered="{{_refresherTriggered}}"
  bindrefresherrefresh="_onRefresherRefresh"
  bindscrolltolower="_onScrollToLower"
  bindscroll="_onScroll"
  lower-threshold="100"
  style="height: calc(100vh - {{_navbarHeight}}px);"
>
<view class="payment-page">
  <view wx:if="{{isLoading}}" class="loading-container">
    <view class="loading-content">
      <view class="lux-cascade">
  <view class="lux-cascade-dot" style="left: 20rpx; background: #C9A24B; animation-delay: 0ms;"></view>
  <view class="lux-cascade-dot" style="left: 36rpx; background: #A8894A; animation-delay: 150ms;"></view>
  <view class="lux-cascade-dot" style="left: 52rpx; background: #C9A24B; animation-delay: 300ms;"></view>
  <view class="lux-cascade-dot" style="left: 68rpx; background: #A8894A; animation-delay: 450ms;"></view>
  <view class="lux-cascade-dot" style="left: 84rpx; background: #C9A24B; animation-delay: 600ms;"></view>
  <view class="lux-cascade-dot" style="left: 100rpx; background: #A8894A; animation-delay: 750ms;"></view>
  <view class="lux-cascade-dot" style="left: 48rpx; background: #C9A24B; animation-delay: 900ms;"></view>

      </view>
      <text class="loading-text">{{t.BIZ_CSIK0}}</text>
    </view>
  </view>

  <block wx:elif="{{mode === 'detail'}}">
    <order-status-banner
      status="{{orderStatus}}"
      status-text="{{orderStatusText}}"
      status-desc="{{orderStatus === 'pending_payment' ? '请尽快完成支付' : (orderStatus === 'paid' || orderStatus === 'completed') ? '平台已确认，期待您的参与' : ''}}"
      pay-countdown="{{payCountdown}}"
      has-icon="{{true}}"
      icon-src="{{orderStatus === 'pending_payment' ? '/images/icons/wallet-luxury-line.svg' : (orderStatus === 'paid' || orderStatus === 'completed') ? '/images/icons/check-circle-luxury-line.svg' : '/images/icons/x-circle-luxury-line.svg'}}"
      centered="{{true}}"
    />

    <order-card>
      <view slot="content">
        <view class="activity-info" wx:if="{{activity.coverUrl || activity.title}}">
          <image class="activity-cover" src="{{activity.coverUrl}}" mode="aspectFill" binderror="onCloudImageError" data-src="{{activity.coverUrl}}" data-path="activity.coverUrl" lazy-load />
          <view class="activity-details">
            <text class="activity-name">{{activity.title}}</text>
            <text class="activity-time" wx:if="{{activity.startTime}}">{{activity.startTime}}</text>
            <view class="activity-location" wx:if="{{activity.location}}"><image class="activity-location-icon" src="/images/icons/location-luxury-line.svg" mode="aspectFit"></image><text class="activity-location-text">{{activity.location}}</text></view>
          </view>
        </view>

        <view class="order-details">
          <view class="detail-row">
            <text class="detail-label">订单号</text>
            <text class="detail-value">{{orderNo || '-'}}</text>
          </view>
          <view class="detail-row">
            <text class="detail-label">参与宠物</text>
            <text class="detail-value">{{petNames || '无'}}</text>
          </view>
          <view class="detail-row" wx:if="{{participantCount > 1}}">
            <text class="detail-label">参与人数</text>
            <text class="detail-value">{{participantCount}}人</text>
          </view>
          <view class="detail-row">
            <text class="detail-label">联系电话</text>
            <text class="detail-value">{{phone}}</text>
          </view>
          <view class="detail-row" wx:if="{{notes}}">
            <text class="detail-label">备注</text>
            <text class="detail-value">{{notes}}</text>
          </view>
        </view>
      </view>
    </order-card>

    <order-card>
      <view slot="content">
        <view class="price-row">
          <text class="price-label">订单金额</text>
          <text class="price-value">¥{{originalAmount}}</text>
        </view>
        <view class="price-row" wx:if="{{couponDiscount > 0}}">
          <text class="price-label">优惠券抵扣</text>
          <text class="price-value discount">-¥{{couponDiscount}}</text>
        </view>
        <view class="price-row total">
          <text class="price-label">{{couponDiscount > 0 ? '优惠后金额' : '应付金额'}}</text>
          <text class="price-value final">¥{{finalAmount}}</text>
        </view>
      </view>
    </order-card>

    <root-portal>
      <order-action-bar
        actions="{{actions}}"
        tip="{{actionTip}}"
        disabled="{{paying}}"
        bindaction="onAction"
      />
    </root-portal>
  </block>

  <block wx:else>
    <view class="payment-header">
      <text class="payment-title">确认订单</text>
    </view>

    <view class="order-card">
      <view class="activity-info">
        <image class="activity-cover" src="{{activity.coverUrl}}" mode="aspectFill" binderror="onCloudImageError" data-src="{{activity.coverUrl}}" data-path="activity.coverUrl" lazy-load />
        <view class="activity-details">
          <text class="activity-name">{{activity.title}}</text>
          <text class="activity-time">{{activity.startTime}}</text>
        </view>
      </view>

      <view class="order-details">
        <view class="detail-row">
          <text class="detail-label">参与宠物</text>
          <text class="detail-value">{{petNames}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">联系电话</text>
          <text class="detail-value">{{phone}}</text>
        </view>
        <view class="detail-row" wx:if="{{couponDiscount > 0}}">
          <text class="detail-label">优惠券抵扣</text>
          <text class="detail-value discount">-¥{{couponDiscount}}</text>
        </view>
      </view>
    </view>

    <view class="price-card">
      <view class="price-row">
        <text class="price-label">订单金额</text>
        <text class="price-value">¥{{totalAmount}}</text>
      </view>
      <view class="price-row total" wx:if="{{couponDiscount > 0}}">
        <text class="price-label">优惠后</text>
        <text class="price-value final">¥{{finalAmount}}</text>
      </view>
    </view>

    <root-portal>
    <view class="pay-section">
      <button class="pay-btn" hover-class="pay-btn--pressed" bindtap="onConfirmPay" disabled="{{paying}}">
        <text class="pay-btn-text">{{paying ? '处理中...' : '确认支付 ¥' + finalAmount}}</text>
      </button>
    </view>
    </root-portal>
  </block>
</view>
</scroll-view>
