<!--subpackages/activity/register.wxml-->
<zy-navbar title="" transparent color="#F7F5EF" solid="{{_navbarSolid}}" />
<login-prompt visible="{{showLoginPrompt}}" bind:close="onLoginPromptClose" />
<scroll-view
  scroll-y
  enhanced
  refresher-enabled="{{true}}"
  refresher-triggered="{{_refresherTriggered}}"
  bindrefresherrefresh="_onRefresherRefresh"
  bindscrolltolower="_onScrollToLower"
  bindscroll="_onScroll"
  lower-threshold="100"
  style="height: 100vh;"
>
<!-- B · 深绿沉浸标题版（顶天） -->
<view class="lux-hero" style="padding-top: calc({{_navbarHeight}}px + 24rpx);">
  <text class="lux-hero-eyebrow">ACTIVITY · ENROLLMENT</text>
  <text class="lux-hero-title">{{activity ? activity.title : '活动报名'}}</text>
  <text class="lux-hero-sub" wx:if="{{activity}}">{{activityTime}} · {{activity.location}}</text>
  <text class="lux-hero-sub" wx:if="{{activity && isPaid}}">合计 ¥{{totalAmount}}</text>
  <text class="lux-hero-sub" wx:elif="{{activity}}">免费参加</text>
  <view class="lux-hero-sealline"></view>
</view>

<view class="paper">
  <!-- 已报名状态 -->
  <view wx:if="{{isRegistered}}" class="registered-status">
    <image class="registered-icon" src="/images/icons/check-luxury-line.svg" mode="aspectFit"></image>
    <text class="registered-text">您已报名此活动</text>
    <text class="registered-hint">请勿重复报名</text>
  </view>

  <block wx:else>
    <!-- ═══ 01 ENTRIES · 报名信息 ═══ -->
    <view class="lux-chapter">
      <text class="lux-chapter-no">01</text>
      <text class="lux-chapter-eyebrow">ENTRIES</text>
      <view class="lux-chapter-rule"></view>
    </view>
    <text class="lux-section-title">报名信息</text>

    <!-- 宠物信息：A-表单行（label 左 value 右 + 14% 墨行线） -->
    <view wx:for="{{pets}}" wx:key="index" class="pet-block">
      <view class="pet-head">
        <text class="pet-no">PET 0{{index + 1}}</text>
        <view wx:if="{{index > 0}}" class="remove-pet-btn" bindtap="onRemovePet" data-index="{{index}}" hover-class="remove-pet-btn--pressed" hover-stay-time="80">
          <text class="remove-icon">×</text>
          <text>移除</text>
        </view>
      </view>

      <view class="lux-field">
        <text class="lux-field-label">宠物姓名 *</text>
        <input
          class="field-input"
          placeholder="请输入宠物姓名"
          placeholder-class="field-placeholder"
          value="{{item.petName}}"
          data-field="petName"
          data-index="{{index}}"
          bindinput="onInput"
        />
      </view>

      <view class="lux-field">
        <text class="lux-field-label">宠物性别 *</text>
        <view class="field-chips">
          <view
            class="field-chip {{item.petGender === 'male' ? 'field-chip--on' : ''}}"
            data-gender="male"
            data-field="petGender"
            data-index="{{index}}"
            bindtap="onSelectGender"
            hover-class="field-chip--pressed"
            hover-stay-time="80"
          >
            <text>{{t.BIZ_GP9C}}</text>
          </view>
          <view
            class="field-chip {{item.petGender === 'female' ? 'field-chip--on' : ''}}"
            data-gender="female"
            data-field="petGender"
            data-index="{{index}}"
            bindtap="onSelectGender"
            hover-class="field-chip--pressed"
            hover-stay-time="80"
          >
            <text>{{t.BIZ_FR4W}}</text>
          </view>
        </view>
      </view>

      <view class="lux-field">
        <text class="lux-field-label">宠物品种 *</text>
        <input
          class="field-input"
          placeholder="请输入宠物品种"
          placeholder-class="field-placeholder"
          value="{{item.petBreed}}"
          data-field="petBreed"
          data-index="{{index}}"
          bindinput="onInput"
        />
      </view>
    </view>

    <!-- 档案快选 / 加宠：纸面文字按钮 -->
    <view class="row-actions">
      <button class="text-btn text-btn--primary" bindtap="onShowPetPicker" hover-class="text-btn--pressed" hover-stay-time="80">
        <text>选择我的宠物档案</text>
      </button>
      <button class="text-btn" bindtap="onAddMorePet" wx:if="{{pets.length < 5}}" hover-class="text-btn--pressed" hover-stay-time="80">
        <text class="add-icon">+</text>
        <text>添加更多宠物</text>
      </button>
    </view>

    <!-- 宠物档案选择弹窗 -->
    <root-portal>
    <view class="pet-picker-mask" wx:if="{{showPetPicker}}" bindtap="onHidePetPicker">
      <view class="pet-picker-panel" catchtap="">
        <view class="pet-picker-header">
          <text class="pet-picker-title">选择宠物档案</text>
          <text class="pet-picker-close" bindtap="onHidePetPicker">×</text>
        </view>
        <scroll-view class="pet-picker-body" scroll-y enhanced>
          <view wx:if="{{myPets.length === 0}}" class="pet-picker-empty">
            <text class="empty-text">还没有添加宠物档案</text>
            <text class="empty-hint">添加您的第一只宠物档案</text>
            <button class="add-pet-btn" bindtap="goToAddPet">
              <text>添加我的宠物档案</text>
            </button>
          </view>
          <view wx:else class="pet-picker-list">
            <view class="pet-picker-item" wx:for="{{myPets}}" wx:key="_id" bindtap="onSelectMyPet" data-index="{{index}}" hover-class="pet-picker-item--pressed" hover-stay-time="80">
              <image lazy-load class="pet-picker-avatar" src="{{item.avatarUrl || ''}}" mode="aspectFill" wx:if="{{item.avatarUrl}}" binderror="onCloudImageError" data-src="{{item.avatarUrl}}" data-path="myPets[{{index}}].avatarUrl" />
              <view class="pet-picker-avatar-placeholder" wx:else>
                <text class="pet-picker-avatar-text">{{item.name.charAt(0)}}</text>
              </view>
              <view class="pet-picker-info">
                <text class="pet-picker-name">{{item.name}}</text>
                <text class="pet-picker-detail">{{item.gender === 'male' ? '弟弟' : item.gender === 'female' ? '妹妹' : item.gender}} · {{item.breed || item.species || '未知品种'}}</text>
              </view>
              <text class="pet-picker-arrow">›</text>
            </view>
          </view>
        </scroll-view>
      </view>
    </view>
    </root-portal>

    <!-- 联系信息行 -->
    <view class="lux-field">
      <text class="lux-field-label">参加人数 *</text>
      <input
        class="field-input"
        type="number"
        placeholder="请输入参加人数"
        placeholder-class="field-placeholder"
        value="{{participantCount}}"
        bindinput="onParticipantCountInput"
      />
    </view>

    <view class="lux-field">
      <text class="lux-field-label">联系电话 *</text>
      <input
        class="field-input"
        placeholder="请输入联系电话"
        placeholder-class="field-placeholder"
        value="{{phone}}"
        data-field="phone"
        bindinput="onInput"
      />
    </view>

    <view class="lux-field">
      <text class="lux-field-label">联系人姓名</text>
      <input
        class="field-input"
        placeholder="选填"
        placeholder-class="field-placeholder"
        value="{{contactName}}"
        data-field="contactName"
        bindinput="onInput"
      />
    </view>

    <view class="lux-field lux-field--textarea">
      <text class="lux-field-label">备注信息</text>
      <textarea
        class="field-textarea"
        placeholder="选填"
        placeholder-class="field-placeholder"
        value="{{notes}}"
        data-field="notes"
        bindinput="onInput"
      />
    </view>

    <!-- ═══ 02 COMPANIONS · 好友信息 ═══ -->
    <view class="lux-chapter chapter-gap">
      <text class="lux-chapter-no">02</text>
      <text class="lux-chapter-eyebrow">COMPANIONS</text>
      <view class="lux-chapter-rule"></view>
    </view>
    <text class="lux-section-title">添加好友信息（代报名）</text>

    <view class="friends-list">
      <view
        wx:for="{{friends}}"
        wx:key="index"
        class="friend-row"
      >
        <view class="friend-main">
          <view class="friend-line1">
            <text class="friend-name">{{item.petName}}</text>
            <text class="friend-gender">{{item.petGender === 'male' ? '弟弟' : '妹妹'}}</text>
          </view>
          <text class="friend-sub">{{item.petBreed}} · {{item.phone}}</text>
          <text class="friend-sub" wx:if="{{item.notes}}">备注：{{item.notes}}</text>
        </view>
        <view class="friend-ops">
          <text class="op-link" bindtap="onEditFriend" data-index="{{index}}">编辑</text>
          <text class="op-link op-link--danger" bindtap="onDeleteFriend" data-index="{{index}}">删除</text>
        </view>
      </view>
      <view wx:if="{{friends.length === 0}}" class="empty-friends">
        <image class="empty-icon" src="/images/icons/users-luxury-line.svg" mode="aspectFit"></image>
        <text>暂无好友信息</text>
        <text class="empty-hint">点击下方按钮添加好友信息</text>
      </view>
    </view>

    <view class="row-actions">
      <button class="text-btn" bindtap="goToAddFriend" hover-class="text-btn--pressed" hover-stay-time="80">
        <text class="add-icon">+</text>
        <text>添加好友</text>
      </button>
    </view>

    <!-- ═══ 03 COUPON · 优惠券 ═══ -->
    <view class="lux-chapter chapter-gap" wx:if="{{isPaid && totalAmount > 0}}">
      <text class="lux-chapter-no">03</text>
      <text class="lux-chapter-eyebrow">COUPON</text>
      <view class="lux-chapter-rule"></view>
    </view>
    <view class="coupon-head" wx:if="{{isPaid && totalAmount > 0}}" bindtap="onToggleCouponSelector">
      <text class="lux-section-title">优惠券</text>
      <text class="coupon-hint" wx:if="{{availableCoupons.length > 0 && !selectedCoupon}}">{{availableCoupons.length}}张可用</text>
    </view>

    <view class="coupon-current" wx:if="{{selectedCoupon}}">
      <text class="coupon-name">{{selectedCoupon.templateName}}</text>
      <view class="coupon-current-right">
        <text class="coupon-discount">-¥{{couponDiscount}}</text>
        <image class="remove-coupon" src="/images/icons/close-luxury-line.svg" mode="aspectFit" bindtap="onRemoveCoupon"></image>
      </view>
    </view>
    <view class="coupon-current coupon-current--link" wx:elif="{{availableCoupons.length > 0}}" bindtap="onToggleCouponSelector">
      <text class="coupon-name">{{availableCoupons.length}}张可用优惠券，点击选择</text>
      <text class="pet-picker-arrow">›</text>
    </view>

    <view class="coupon-list" wx:if="{{showCouponSelector}}">
      <view class="coupon-row" wx:for="{{availableCoupons}}" wx:key="_id" bindtap="onSelectCoupon" data-id="{{item._id}}" data-amount="{{item.discountAmount}}" hover-class="coupon-row--pressed" hover-stay-time="80">
        <view class="coupon-row-amount">
          <text class="coupon-row-symbol">¥</text>
          <text class="coupon-row-num">{{item.discountAmount}}</text>
        </view>
        <view class="coupon-row-info">
          <text class="coupon-row-name">{{item.templateName}}</text>
          <text class="coupon-row-rule" wx:if="{{item.rules.threshold > 0}}">满{{item.rules.threshold}}元可用</text>
        </view>
        <text class="pet-picker-arrow">›</text>
      </view>
      <view wx:if="{{availableCoupons.length === 0}}" class="empty-friends"><text>暂无可用优惠券</text></view>
    </view>

    <!-- ═══ 04 BILLING · 费用明细 ═══ -->
    <block wx:if="{{isPaid}}">
      <view class="lux-chapter chapter-gap">
        <text class="lux-chapter-no">04</text>
        <text class="lux-chapter-eyebrow">BILLING</text>
        <view class="lux-chapter-rule"></view>
      </view>
      <view class="bill-rows">
        <view class="bill-row" wx:if="{{activity.pricePerPerson > 0}}">
          <text class="bill-key">每人费用</text>
          <text class="bill-val">¥{{activity.pricePerPerson}} × {{participantCount}}人 = ¥{{activity.pricePerPerson * participantCount}}</text>
        </view>
        <view class="bill-row" wx:if="{{activity.pricePerPet > 0}}">
          <text class="bill-key">每只宠物费用</text>
          <text class="bill-val">¥{{activity.pricePerPet}} × {{validPetCount}}只 = ¥{{activity.pricePerPet * validPetCount}}</text>
        </view>
        <view class="bill-row bill-row--total">
          <text class="bill-key bill-key--total">合计</text>
          <text class="bill-val bill-val--total">¥{{totalAmount}}</text>
        </view>
        <view class="bill-note" wx:if="{{selectedCouponId && finalAmount === 0.1 && couponDiscount > 0}}">优惠券金额已超出应付</view>
      </view>
    </block>

    <!-- 提交按钮区域 -->
    <view class="submit-section">
      <button
        class="submit-btn"
        bindtap="onSubmit"
        hover-class="submit-btn--pressed"
        hover-stay-time="80"
      >
        <text class="submit-text">{{isPaid ? '支付并报名' : '立即报名'}}</text>
      </button>
    </view>
  </block>
</view>
</scroll-view>
