@import '../../styles/components.wxss';
/* ================================================================
   activity/register.wxss · AROORO 活动报名页 — Haute-Luxury Editorial
   板块色：深林绿 --activity-primary + 暖金点缀 --accent-color
   Skyline 兼容：无 :active / text-transform / backdrop-filter / sticky
   ================================================================ */

/* ===== 全局容器 ===== */
.container {
  padding: 0;
  min-height: 100vh;
  position: relative;
  overflow: hidden;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

/* ===== 背景装饰 ===== */
.container::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(circle at 20% 80%, var(--activity-tint) 0%, transparent 50%),
              radial-gradient(circle at 80% 20%, var(--activity-tint) 0%, transparent 50%);
  z-index: 0;
}

/* ===== 活动信息头部 ===== */
.activity-header {
  position: relative;
  padding: var(--zy-space-xl) var(--page-padding);
  margin-bottom: var(--zy-space-lg);
  overflow: hidden;
  border-radius: 0 0 var(--zy-radius-3xl) var(--zy-radius-3xl);
  border-bottom: 1rpx solid var(--hairline);
  z-index: 1;
  animation-name: zy-fade-in-up;
  animation-duration: 480ms;
  animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  animation-fill-mode: forwards;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, var(--activity-primary), var(--primary-deep));
  z-index: -1;
}

.header-bg::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(circle at 30% 20%, var(--border-inverse-20, rgba(255,255,255,0.20)) 0%, transparent 40%),
              radial-gradient(circle at 70% 80%, var(--accent-glow, rgba(201,162,75,0.20)) 0%, transparent 40%);
  opacity: 0.6;
}

.header-content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  min-height: 200rpx;
}

.activity-title {
  font-family: var(--font-serif);
  font-size: 36rpx;
  font-weight: 500;
  color: var(--text-on-primary);
  margin-bottom: 24rpx;
  display: block;
  letter-spacing: 0.08em;
}

.activity-meta {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  color: rgba(247,245,239,0.88);
  background: var(--border-inverse-20, rgba(255,255,255,0.20));
  padding: 12rpx 16rpx;
  border-radius: var(--zy-radius-md);
  width: auto;
  border: 1rpx solid var(--border-inverse-20, rgba(255,255,255,0.20));
}

.meta-icon {
  width: 28rpx;
  height: 28rpx;
  line-height: 1;
}

.meta-text {
  line-height: 1.4;
  letter-spacing: 0.02em;
}

/* ===== 价格标签 ===== */
.price-tag {
  position: static;
  align-self: flex-end;
  margin-top: 8rpx;
  background: var(--border-inverse-20, rgba(255,255,255,0.20));
  padding: 16rpx 24rpx;
  border-radius: var(--zy-radius-lg);
  display: flex;
  align-items: baseline;
  border: 1rpx solid var(--border-inverse-20, rgba(255,255,255,0.20));
}

.free-tag .price-value {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-on-primary);
}

.price-symbol {
  font-size: 22rpx;
  font-weight: 400;
  margin-right: 4rpx;
  color: var(--text-on-primary);
}

.price-value {
  font-size: 36rpx;
  font-weight: 500;
  /* REV.4 B′：价格芯片浮在 20% 白玻璃 + 深绿渐变上，金字仅 2.2:1（AA fail），
     与同排 .price-symbol / .price-unit 统一用奶油白（4.9:1 pass） */
  color: var(--text-on-primary);
  margin-right: 4rpx;
  letter-spacing: 0.02em;
}

.price-unit {
  font-size: 22rpx;
  font-weight: 400;
  color: rgba(247,245,239,0.8);
  letter-spacing: 0.02em;
}

/* ===== 表单区域 ===== */
.form-section {
  position: relative;
  background-color: var(--card-color);
  border-radius: var(--zy-radius-lg);
  padding: var(--zy-space-lg);
  margin: 0 var(--page-padding) var(--zy-space-lg);
  border: 1rpx solid var(--hairline);
  z-index: 1;
  overflow: hidden;
  animation-name: zy-fade-in-up;
  animation-duration: 480ms;
  animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  animation-delay: 100ms;
  animation-fill-mode: forwards;
}

.section-decoration {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 3rpx;
  background: linear-gradient(90deg, var(--activity-primary), var(--accent-color));
}

.section-title {
  font-family: var(--font-sans);
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: var(--zy-space-lg);
  position: relative;
  display: flex;
  align-items: center;
  letter-spacing: 0.06em;
}

.section-title::before {
  content: '';
  display: inline-block;
  width: 6rpx;
  height: 28rpx;
  background: var(--activity-primary);
  border-radius: 3rpx;
  margin-right: 16rpx;
}

.add-friend-container {
  margin-top: var(--zy-space-lg);
  display: flex;
  justify-content: center;
  padding-top: 24rpx;
  border-top: 1rpx dashed var(--divider-color);
}

/* ===== 添加更多宠物按钮 ===== */
.add-more-pet-container {
  margin: 24rpx 0;
  display: flex;
  justify-content: center;
}

.add-more-pet-btn {
  background: var(--activity-accent);
  color: var(--activity-primary);
  border: 1rpx solid var(--activity-primary);
  padding: 20rpx 48rpx;
  border-radius: var(--zy-radius-lg);
  font-size: 24rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-weight: 400;
  letter-spacing: 0.04em;
  transition: transform var(--transition-fast), opacity var(--transition-fast);
}

.add-more-pet-btn--pressed {
  transform: scale(0.97);
  opacity: 0.85;
}

/* ===== 快速选择按钮 ===== */
.quick-select-container {
  margin: 24rpx 0;
  display: flex;
  justify-content: center;
}

.quick-select-btn {
  background: var(--gradient-primary);
  color: var(--text-on-primary);
  border: none;
  padding: 20rpx 48rpx;
  border-radius: var(--zy-radius-lg);
  font-size: 24rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: var(--shadow-glow-primary-btn);
  font-weight: 400;
  letter-spacing: 0.06em;
  transition: transform var(--transition-fast), opacity var(--transition-fast);
}

.quick-select-btn--pressed {
  transform: scale(0.97);
  opacity: 0.9;
}

.my-pets-btn {
  background: var(--gradient-secondary);
  box-shadow: var(--shadow-glow-mall);
}

/* ===== 宠物档案选择弹窗 ===== */
.pet-picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--overlay-color, rgba(26,26,23,0.5));
  z-index: 100;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.pet-picker-panel {
  width: 100%;
  max-height: 70vh;
  background: var(--card-color);
  border-radius: var(--zy-radius-3xl) var(--zy-radius-3xl) 0 0;
  display: flex;
  flex-direction: column;
  animation-name: zy-fade-in-up;
  animation-duration: 480ms;
  animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  animation-fill-mode: forwards;
}

.pet-picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--zy-space-lg);
  border-bottom: 1rpx solid var(--hairline);
}

.pet-picker-title {
  font-family: var(--font-sans);
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.04em;
}

.pet-picker-close {
  font-size: 44rpx;
  color: var(--text-tertiary);
  line-height: 1;
  padding: 0 8rpx;
  font-weight: 300;
}

.pet-picker-body {
  /* Skyline 下 scroll-view 不能用 flex:1 撑高度（父级 max-height 时算成 0），必须给明确高度 */
  height: calc(70vh - 120rpx);
  padding: 0;
  overflow: hidden;
}

.pet-picker-empty {
  text-align: center;
  padding: 80rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.pet-picker-empty .empty-icon {
  animation: zy-breathe-glow 4000ms ease-in-out infinite;
  font-size: 80rpx;
  line-height: 1;
  color: var(--text-tertiary);
}

.pet-picker-empty .empty-text {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
  letter-spacing: 0.04em;
}

.pet-picker-empty .empty-hint {
  font-size: 24rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.02em;
}

.add-pet-btn {
  margin-top: 24rpx;
  background: var(--gradient-primary);
  color: var(--text-on-primary);
  border: none;
  padding: 20rpx 48rpx;
  border-radius: var(--zy-radius-lg);
  font-size: 26rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-glow-primary-btn);
  font-weight: 400;
  letter-spacing: 0.06em;
}

.pet-picker-list {
  padding: 16rpx 24rpx 32rpx;
}

.pet-picker-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-radius: var(--zy-radius-lg);
  background: var(--card-cream);
  margin-bottom: 16rpx;
  border: 1rpx solid var(--hairline);
  transition: transform var(--transition-fast), background-color var(--transition-fast);
}

.pet-picker-item--pressed {
  transform: scale(0.98);
  background: var(--primary-wash);
}

.pet-picker-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.pet-picker-avatar-placeholder {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--gradient-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.pet-picker-avatar-text {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-on-primary);
  letter-spacing: 0.02em;
}

.pet-picker-info {
  flex: 1;
  min-width: 0;
}

.pet-picker-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  display: block;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  letter-spacing: 0.02em;
}

.pet-picker-detail {
  font-size: 22rpx;
  color: var(--text-tertiary);
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  letter-spacing: 0.02em;
}

.pet-picker-arrow {
  font-size: 36rpx;
  color: var(--text-tertiary);
  margin-left: 16rpx;
  flex-shrink: 0;
  font-weight: 300;
}

/* ===== 宠物信息区域 ===== */
.pet-section {
  margin-bottom: var(--zy-space-lg);
  padding-bottom: var(--zy-space-lg);
  border-bottom: 1rpx dashed var(--divider-color);
}

.pet-section:last-child {
  border-bottom: none;
  margin-bottom: 0;
  padding-bottom: 0;
}

.pet-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.pet-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  position: relative;
  display: flex;
  align-items: center;
  letter-spacing: 0.04em;
}

.pet-title::before {
  content: '';
  display: inline-block;
  width: 4rpx;
  height: 24rpx;
  background: var(--activity-primary);
  border-radius: 2rpx;
  margin-right: 12rpx;
}

/* ===== 移除宠物按钮 ===== */
.remove-pet-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  border-radius: var(--zy-radius-lg);
  background-color: rgba(184,92,60,0.06);
  color: var(--error-color);
  font-size: 20rpx;
  border: 1rpx solid rgba(184,92,60,0.15);
  transition: transform var(--transition-fast), opacity var(--transition-fast);
}

.remove-pet-btn--pressed {
  transform: scale(0.95);
  opacity: 0.8;
}

.remove-icon {
  font-size: 22rpx;
  font-weight: 400;
  line-height: 1;
}

/* ===== 表单项目 ===== */
.form-item {
  margin-bottom: var(--zy-space-lg);
  position: relative;
}

.label {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
  font-weight: 400;
  letter-spacing: 0.04em;
}

.input-container {
  position: relative;
  border-radius: var(--zy-radius-md);
  overflow: hidden;
  border: 1rpx solid var(--hairline);
  width: 100%;
  box-sizing: border-box;
  background: var(--card-cream);
}

.input {
  width: 100%;
  padding: 24rpx 28rpx;
  border: none;
  font-size: 28rpx;
  background-color: transparent;
  z-index: 2;
  position: relative;
  line-height: 1.5;
  min-height: 84rpx;
  box-sizing: border-box;
  color: var(--text-primary);
  font-weight: 400;
}

.textarea-container {
  position: relative;
  border-radius: var(--zy-radius-md);
  overflow: hidden;
  border: 1rpx solid var(--hairline);
  width: 100%;
  box-sizing: border-box;
  background: var(--card-cream);
}

.textarea {
  width: 100%;
  padding: 24rpx 28rpx;
  border: none;
  font-size: 28rpx;
  background-color: transparent;
  z-index: 2;
  position: relative;
  line-height: 1.6;
  min-height: 160rpx;
  box-sizing: border-box;
  color: var(--text-primary);
  font-weight: 400;
}

/* ===== 性别选择 ===== */
.gender-options {
  display: flex;
  gap: 24rpx;
}

.gender-option {
  flex: 1;
  padding: 22rpx;
  border: 1rpx solid var(--border-color);
  border-radius: var(--zy-radius-md);
  text-align: center;
  font-size: 24rpx;
  color: var(--text-secondary);
  position: relative;
  overflow: hidden;
  background: var(--card-cream);
  font-weight: 400;
  letter-spacing: 0.04em;
  transition: transform var(--transition-fast), border-color var(--transition-fast), color var(--transition-fast), background-color var(--transition-fast);
}

.gender-option--pressed {
  transform: scale(0.97);
}

.gender-option.active {
  border-color: var(--activity-primary);
  color: var(--activity-primary);
  background: var(--activity-tint);
}

/* ===== 好友信息区域 ===== */
.friends-section {
  margin-top: 16rpx;
}

.add-friend-btn {
  background: var(--activity-accent);
  color: var(--activity-primary);
  border: 1rpx solid var(--activity-primary);
  padding: 20rpx 48rpx;
  border-radius: var(--zy-radius-lg);
  font-size: 24rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-weight: 400;
  letter-spacing: 0.04em;
  transition: transform var(--transition-fast), opacity var(--transition-fast);
}

.add-friend-btn--pressed {
  transform: scale(0.97);
  opacity: 0.85;
}

.add-icon {
  font-size: 26rpx;
  font-weight: 300;
  line-height: 1;
}

.friends-list {
  margin-top: 24rpx;
}

.friend-item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 28rpx;
  border-radius: var(--zy-radius-lg);
  margin-bottom: 20rpx;
  position: relative;
  overflow: hidden;
  border: 1rpx solid var(--hairline);
  background-color: var(--card-color);
  transition: transform var(--transition-fast);
}

.friend-item--pressed {
  transform: scale(0.99);
}

.friend-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--activity-tint);
  z-index: 1;
  opacity: 0.5;
}

.friend-info {
  flex: 1;
  margin-right: 20rpx;
  position: relative;
  z-index: 2;
}

.friend-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
  flex-shrink: 1;
  min-width: 0;
}

.friend-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  flex: 0 1 auto;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  letter-spacing: 0.02em;
}

.friend-gender {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--zy-radius-sm);
  background-color: var(--activity-tint);
  color: var(--activity-primary);
  font-weight: 400;
  flex-shrink: 0;
  letter-spacing: 0.04em;
}

.friend-details {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.friend-breed, .friend-phone {
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.4;
  letter-spacing: 0.02em;
}

.friend-notes {
  display: flex;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--hairline);
  font-size: 20rpx;
  color: var(--text-tertiary);
  line-height: 1.4;
}

.notes-label {
  font-weight: 400;
  margin-right: 8rpx;
  color: var(--text-secondary);
}

.notes-content {
  flex: 1;
  overflow-wrap: break-word;
}

.friend-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  position: relative;
  z-index: 2;
  flex-shrink: 0;
  max-width: 120rpx;
}

.action-btn {
  padding: 10rpx 16rpx;
  border: 1rpx solid var(--border-color);
  border-radius: var(--zy-radius-lg);
  font-size: 18rpx;
  height: 52rpx;
  line-height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 120rpx;
  max-width: 120rpx;
  flex-shrink: 0;
  background: var(--card-color);
  font-weight: 400;
  letter-spacing: 0.02em;
  transition: transform var(--transition-fast), opacity var(--transition-fast);
}

.action-btn--pressed {
  transform: scale(0.95);
  opacity: 0.8;
}

.action-btn::after {
  border: none;
}

.edit-btn {
  color: var(--activity-primary);
  border-color: var(--activity-primary);
  background-color: var(--activity-tint);
}

.delete-btn {
  color: var(--error-color);
  border-color: rgba(184,92,60,0.3);
  background-color: rgba(184,92,60,0.04);
}

.empty-friends {
  text-align: center;
  color: var(--text-tertiary);
  padding: 80rpx 0;
  font-size: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.empty-icon {
  width: 64rpx;
  height: 64rpx;
  line-height: 1;
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 20rpx;
  color: var(--text-tertiary);
  margin-top: 8rpx;
  letter-spacing: 0.02em;
}

/* ===== 优惠券区域 ===== */
.coupon-section {
  padding: var(--zy-space-lg);
}

.section-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.coupon-hint {
  font-size: 22rpx;
  color: var(--error-color);
  letter-spacing: 0.02em;
}

.selected-coupon {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background: var(--accent-wash);
  border-radius: var(--zy-radius-md);
  margin-top: 12rpx;
  border: 1rpx solid var(--accent-glow, rgba(201,162,75,0.20));
}

.coupon-info {
  display: flex;
  flex-direction: column;
}

.coupon-name {
  font-size: 24rpx;
  color: var(--text-primary);
  font-weight: 400;
  letter-spacing: 0.02em;
}

.coupon-discount {
  font-size: 30rpx;
  color: #1F3A1F;
  font-weight: 500;
  letter-spacing: 0.02em;
}

.remove-coupon {
  width: 26rpx;
  height: 26rpx;
  padding: 8rpx;
}

.coupon-list {
  margin-top: 12rpx;
}

.coupon-item {
  display: flex;
  align-items: center;
  padding: 16rpx 12rpx;
  background: var(--card-cream);
  border-radius: var(--zy-radius-sm);
  margin-bottom: 12rpx;
  border: 1rpx solid var(--hairline);
}

.coupon-item-left {
  width: 120rpx;
  text-align: center;
  color: #1F3A1F;
  font-size: 22rpx;
  font-weight: 400;
}

.coupon-item-left .big {
  font-size: 40rpx;
  font-weight: 500;
  letter-spacing: -0.02em;
}

.coupon-item-right {
  flex: 1;
  margin-left: 12rpx;
}

.coupon-item-name {
  font-size: 24rpx;
  color: var(--text-primary);
  font-weight: 500;
  letter-spacing: 0.02em;
}

.coupon-item-rule {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-top: 4rpx;
  letter-spacing: 0.02em;
}

/* ===== 费用明细 ===== */
.fee-detail {
  background: var(--card-cream);
  border-radius: var(--zy-radius-lg);
  padding: var(--zy-space-lg);
  margin-bottom: var(--zy-space-lg);
  border: 1rpx solid var(--hairline);
}

.fee-detail-title {
  font-family: var(--font-sans);
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  letter-spacing: 0.04em;
}

.fee-detail-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--hairline);
}

.fee-detail-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 0.02em;
}

.fee-detail-value {
  font-size: 24rpx;
  color: var(--text-primary);
  font-weight: 400;
}

.fee-detail-total {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0 0;
  margin-top: 8rpx;
  border-top: 2rpx solid var(--activity-primary);
}

.fee-detail-total .fee-detail-label {
  font-weight: 500;
  color: var(--text-primary);
}

.fee-detail-total .fee-detail-value {
  font-weight: 500;
  color: var(--error-color);
  font-size: 30rpx;
  letter-spacing: 0.02em;
}

.min-amount-tip {
  text-align: right;
  font-size: 22rpx;
  color: var(--text-tertiary);
}

/* ===== 已报名状态 ===== */
.registered-status {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx var(--zy-space-lg);
  margin: 0 var(--page-padding) var(--zy-space-lg);
  background: var(--card-color);
  border-radius: var(--zy-radius-lg);
  border: 1rpx solid var(--hairline);
  animation-name: zy-fade-in-up;
  animation-duration: 480ms;
  animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  animation-fill-mode: forwards;
}

.registered-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--gradient-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--zy-space-lg);
  box-shadow: var(--shadow-glow-primary-btn);
}

.registered-text {
  font-family: var(--font-serif);
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  letter-spacing: 0.06em;
}

.registered-hint {
  font-size: 24rpx;
  color: var(--text-tertiary);
  text-align: center;
  letter-spacing: 0.02em;
}

/* ===== 提交按钮区域 ===== */
.submit-section {
  margin: var(--zy-space-lg) var(--page-padding) var(--zy-space-lg);
  position: relative;
  z-index: 1;
  animation-name: zy-fade-in-up;
  animation-duration: 480ms;
  animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  animation-delay: 200ms;
  animation-fill-mode: forwards;
}

.submit-btn {
  position: relative;
  background: var(--gradient-primary);
  color: var(--text-on-primary);
  border: none;
  padding: 24rpx;
  border-radius: var(--zy-radius-lg);
  font-size: 30rpx;
  font-weight: 500;
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-glow-primary-btn);
  overflow: hidden;
  letter-spacing: 0.12em;
  transition: transform var(--transition-fast), opacity var(--transition-fast);
}

.submit-btn--pressed {
  transform: scale(0.98);
  opacity: 0.9;
}

.submit-btn::after {
  border: none;
}

.submit-text {
  position: relative;
  z-index: 2;
}
