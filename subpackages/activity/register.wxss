@import '../../styles/components.wxss';
/* ================================================================
   activity/register.wxss · A+B 奢侈品级版式（2026-09-09 全站升级）
   B1 深绿标题版 hero（全局 .lux-* 类）+ A 纸面流：
   章节行 01/02 + A-表单行（label 左 value 右）+ 14% 墨行线。
   ⚠ 纸面行线一律 rgba(26,26,23,0.14)；纸面金字一律 --lux-gold-ink。
   Skyline 兼容：无 :active / text-transform / backdrop-filter / sticky
   ================================================================ */

/* ===== 纸面容器 ===== */
.paper {
  padding: 48rpx var(--page-padding) calc(48rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}

.chapter-gap {
  margin-top: 56rpx;
}

/* ===== 已报名状态（纸面态，非白卡） ===== */
.registered-status {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 96rpx 0;
  border-top: 1rpx solid rgba(26, 26, 23, 0.14);
  border-bottom: 1rpx solid rgba(26, 26, 23, 0.14);
}

.registered-icon {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 32rpx;
}

.registered-text {
  font-family: var(--font-serif);
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  letter-spacing: 0.06em;
}

.registered-hint {
  font-size: 24rpx;
  color: var(--text-tertiary);
  text-align: center;
  letter-spacing: 0.02em;
}

/* ===== 宠物块：PET 0N 编号头 + 表单行 ===== */
.pet-block {
  margin-top: 8rpx;
}

.pet-block + .pet-block {
  margin-top: 24rpx;
  padding-top: 8rpx;
  border-top: 1rpx solid rgba(26, 26, 23, 0.14);
}

.pet-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0 8rpx;
}

.pet-no {
  font-size: 20rpx;
  color: var(--lux-gold-ink);
  letter-spacing: 0.24em;
  font-weight: 500;
}

.remove-pet-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background-color: transparent;
  color: var(--error-color);
  font-size: 20rpx;
  border: 1rpx solid rgba(184, 92, 60, 0.24);
  transition: transform var(--transition-fast), opacity var(--transition-fast);
}

.remove-pet-btn--pressed {
  transform: scale(0.95);
  opacity: 0.8;
}

.remove-icon {
  font-size: 22rpx;
  font-weight: 400;
  line-height: 1;
}

/* ===== A-表单行补充（骨架来自全局 .lux-field） ===== */
.field-input {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  padding: 0 24rpx;
  border: none;
  font-size: 28rpx;
  background-color: transparent;
  color: var(--text-primary);
  text-align: right;
  box-sizing: border-box;
  font-weight: 400;
}

.field-placeholder {
  color: var(--text-tertiary);
}

.field-textarea {
  flex: 1;
  min-width: 0;
  min-height: 128rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid rgba(26, 26, 23, 0.16);
  border-radius: var(--zy-radius-sm, 4rpx);
  background: transparent;
  font-size: 28rpx;
  color: var(--text-primary);
  box-sizing: border-box;
  font-weight: 400;
}

.lux-field--textarea {
  align-items: flex-start;
  padding-top: 28rpx;
  padding-bottom: 28rpx;
}

.lux-field--textarea .lux-field-label {
  padding-top: 20rpx;
}

/* 性别 chip：透明底 + 16% 墨边；选中 = 深绿 */
.field-chips {
  flex: 1;
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}

.field-chip {
  min-width: 128rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(26, 26, 23, 0.16);
  border-radius: var(--zy-radius-sm, 4rpx);
  background: transparent;
  font-size: 26rpx;
  color: var(--text-secondary);
  letter-spacing: 0.04em;
  transition: transform var(--transition-fast), border-color var(--transition-fast), color var(--transition-fast), background-color var(--transition-fast);
}

.field-chip--pressed {
  transform: scale(0.97);
}

.field-chip--on {
  border-color: var(--activity-primary);
  color: var(--activity-primary);
  background: var(--activity-tint);
}

/* ===== 纸面文字按钮（档案快选 / 加宠 / 加好友） ===== */
.row-actions {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  padding: 32rpx 0;
}

.text-btn {
  background: transparent;
  color: var(--activity-primary);
  border: 1rpx solid rgba(26, 26, 23, 0.16);
  padding: 0 44rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-weight: 400;
  letter-spacing: 0.06em;
  transition: transform var(--transition-fast), opacity var(--transition-fast);
}

.text-btn--primary {
  background: var(--gradient-primary);
  color: var(--text-on-primary);
  border: none;
  box-shadow: var(--shadow-glow-primary-btn);
}

.text-btn--pressed {
  transform: scale(0.97);
  opacity: 0.88;
}

.add-icon {
  font-size: 26rpx;
  font-weight: 300;
  line-height: 1;
}

/* ===== 宠物档案选择弹窗（底部面板，保留面板样式） ===== */
.pet-picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--overlay-color, rgba(26,26,23,0.5));
  z-index: 100;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.pet-picker-panel {
  width: 100%;
  max-height: 70vh;
  background: var(--card-color);
  border-radius: var(--zy-radius-3xl) var(--zy-radius-3xl) 0 0;
  display: flex;
  flex-direction: column;
  animation-name: zy-fade-in-up;
  animation-duration: 480ms;
  animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  animation-fill-mode: forwards;
}

.pet-picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--zy-space-lg);
  border-bottom: 1rpx solid rgba(26, 26, 23, 0.14);
}

.pet-picker-title {
  font-family: var(--font-sans);
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.04em;
}

.pet-picker-close {
  font-size: 44rpx;
  color: var(--text-tertiary);
  line-height: 1;
  padding: 0 8rpx;
  font-weight: 300;
}

.pet-picker-body {
  /* Skyline 下 scroll-view 不能用 flex:1 撑高度（父级 max-height 时算成 0），必须给明确高度 */
  height: calc(70vh - 120rpx);
  padding: 0;
  overflow: hidden;
}

.pet-picker-empty {
  text-align: center;
  padding: 80rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.pet-picker-empty .empty-text {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
  letter-spacing: 0.04em;
}

.pet-picker-empty .empty-hint {
  font-size: 24rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.02em;
}

.add-pet-btn {
  margin-top: 24rpx;
  background: var(--gradient-primary);
  color: var(--text-on-primary);
  border: none;
  padding: 20rpx 48rpx;
  border-radius: var(--zy-radius-lg);
  font-size: 26rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-glow-primary-btn);
  font-weight: 400;
  letter-spacing: 0.06em;
}

.pet-picker-list {
  padding: 16rpx 24rpx 32rpx;
}

.pet-picker-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-radius: var(--zy-radius-lg);
  background: var(--card-cream);
  margin-bottom: 16rpx;
  border: 1rpx solid rgba(26, 26, 23, 0.14);
  transition: transform var(--transition-fast), background-color var(--transition-fast);
}

.pet-picker-item--pressed {
  transform: scale(0.98);
  background: var(--primary-wash);
}

.pet-picker-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.pet-picker-avatar-placeholder {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--gradient-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.pet-picker-avatar-text {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-on-primary);
  letter-spacing: 0.02em;
}

.pet-picker-info {
  flex: 1;
  min-width: 0;
}

.pet-picker-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  display: block;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  letter-spacing: 0.02em;
}

.pet-picker-detail {
  font-size: 22rpx;
  color: var(--text-tertiary);
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  letter-spacing: 0.02em;
}

.pet-picker-arrow {
  font-size: 36rpx;
  color: var(--text-tertiary);
  margin-left: 16rpx;
  flex-shrink: 0;
  font-weight: 300;
}

/* ===== 02 COMPANIONS · 好友行（纸面行 + 14% 墨行线） ===== */
.friends-list {
  margin-top: 8rpx;
}

.friend-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid rgba(26, 26, 23, 0.14);
}

.friend-row:last-child {
  border-bottom: none;
}

.friend-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.friend-line1 {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.friend-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.02em;
}

.friend-gender {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--zy-radius-sm);
  background-color: var(--activity-tint);
  color: var(--activity-primary);
  font-weight: 400;
  flex-shrink: 0;
  letter-spacing: 0.04em;
}

.friend-sub {
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.4;
  letter-spacing: 0.02em;
}

.friend-ops {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  flex-shrink: 0;
}

.op-link {
  font-size: 24rpx;
  color: var(--activity-primary);
  letter-spacing: 0.06em;
  padding: 8rpx 0;
  text-align: center;
}

.op-link--danger {
  color: var(--error-color);
}

.empty-friends {
  text-align: center;
  color: var(--text-tertiary);
  padding: 64rpx 0;
  font-size: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.empty-icon {
  width: 64rpx;
  height: 64rpx;
  line-height: 1;
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 20rpx;
  color: var(--text-tertiary);
  margin-top: 4rpx;
  letter-spacing: 0.02em;
}

/* ===== 03 COUPON · 优惠券（纸面行） ===== */
.coupon-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.coupon-hint {
  font-size: 22rpx;
  color: var(--lux-gold-ink);
  letter-spacing: 0.02em;
}

.coupon-current {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid rgba(26, 26, 23, 0.14);
}

.coupon-current--link .coupon-name {
  color: var(--text-secondary);
}

.coupon-name {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 400;
  letter-spacing: 0.02em;
}

.coupon-current-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.coupon-discount {
  font-size: 30rpx;
  color: var(--lux-gold-ink);
  font-weight: 500;
  letter-spacing: 0.02em;
}

.remove-coupon {
  width: 26rpx;
  height: 26rpx;
  padding: 8rpx;
}

.coupon-list {
  border-bottom: 1rpx solid rgba(26, 26, 23, 0.14);
}

.coupon-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(26, 26, 23, 0.14);
}

.coupon-row:last-child {
  border-bottom: none;
}

.coupon-row--pressed {
  background-color: rgba(26, 26, 23, 0.04);
}

.coupon-row-amount {
  display: flex;
  align-items: baseline;
  color: var(--lux-gold-ink);
  flex-shrink: 0;
}

.coupon-row-symbol {
  font-size: 22rpx;
  font-weight: 400;
}

.coupon-row-num {
  font-size: 40rpx;
  font-weight: 500;
  letter-spacing: 0.01em;
}

.coupon-row-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.coupon-row-name {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 500;
  letter-spacing: 0.02em;
}

.coupon-row-rule {
  font-size: 22rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.02em;
}

/* ===== 04 BILLING · 账单行（票据语法） ===== */
.bill-rows {
  display: flex;
  flex-direction: column;
}

.bill-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(26, 26, 23, 0.14);
}

.bill-key {
  font-size: 26rpx;
  color: var(--text-secondary);
  letter-spacing: 0.04em;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.bill-val {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 400;
  text-align: right;
}

.bill-row--total {
  border-bottom: none;
  margin-top: 8rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid rgba(26, 26, 23, 0.14);
}

.bill-key--total {
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.08em;
}

.bill-val--total {
  font-size: 40rpx;
  font-weight: 500;
  letter-spacing: 0.01em;
}

.bill-note {
  text-align: right;
  font-size: 22rpx;
  color: var(--text-tertiary);
  padding-top: 8rpx;
}

/* ===== 提交按钮区域 ===== */
.submit-section {
  margin-top: 48rpx;
}

.submit-btn {
  position: relative;
  background: var(--gradient-primary);
  color: var(--text-on-primary);
  border: none;
  padding: 24rpx;
  border-radius: var(--zy-radius-lg);
  font-size: 30rpx;
  font-weight: 500;
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-glow-primary-btn);
  overflow: hidden;
  letter-spacing: 0.12em;
  transition: transform var(--transition-fast), opacity var(--transition-fast);
}

.submit-btn--pressed {
  transform: scale(0.98);
  opacity: 0.9;
}

.submit-btn::after {
  border: none;
}

.submit-text {
  position: relative;
  z-index: 2;
}
