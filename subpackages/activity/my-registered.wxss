/* ================================================================
   activity/my-registered.wxss · AROORO 我报名的活动页 — Haute-Luxury Editorial
   板块色：深林绿家族 --activity-primary + 状态徽章
   Skyline 兼容：无 :active / text-transform / backdrop-filter / sticky
   ================================================================ */
/* 令牌由 app.wxss 全局注入到 page，页面不得再 import variables.wxss —
   页面 wxss 在 app.wxss 之后加载，同为 page 选择器会反向覆盖 theme-teal，
   把旧橄榄坐标系带回来（详见 #10）。 */

/* ===== 页面级 ===== */
page {
  background-color: var(--background-color);
}

/* ===== 入场动画 ===== */
@keyframes fadeInUp {
  0% {
    opacity: 0;
    transform: translateY(28rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeIn {
  0% { opacity: 0; }
  100% { opacity: 1; }
}

/* ===== 容器 ===== */
.page-container {
  min-height: 100vh;
  background-color: var(--background-color);
  position: relative;
  overflow-x: hidden;
  padding: calc(var(--zy-space-xl) + env(safe-area-inset-top)) 0 calc(48rpx + env(safe-area-inset-bottom));
}

/* ===== 活动列表 ===== */
.activity-list {
  padding: 0 var(--page-padding);
  display: flex;
  flex-direction: column;
  gap: var(--zy-space-lg);
}

/* ===== 活动卡片（发丝边 + 白底 + 无阴影） ===== */
.activity-card {
  position: relative;
  border-radius: var(--zy-radius-lg);
  overflow: hidden;
  background-color: var(--card-color);
  border: 1rpx solid var(--hairline);
  transition: transform 280ms cubic-bezier(0.25,0.1,0.25,1),
              border-color 280ms cubic-bezier(0.25,0.1,0.25,1);
  animation-name: fadeInUp;
  animation-duration: 500ms;
  animation-timing-function: cubic-bezier(0.16,1,0.3,1);
  animation-fill-mode: forwards;
}

.activity-card:nth-child(1) { animation-delay: 80ms; }
.activity-card:nth-child(2) { animation-delay: 160ms; }
.activity-card:nth-child(3) { animation-delay: 240ms; }
.activity-card:nth-child(4) { animation-delay: 320ms; }
.activity-card:nth-child(5) { animation-delay: 400ms; }
.activity-card:nth-child(n+6) { animation-delay: 480ms; }

.activity-card--pressed {
  transform: scale(0.985);
  border-color: rgba(45, 79, 45, 0.15);
}

.activity-card-background {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: var(--activity-tint);
  opacity: 0.4;
  z-index: 1;
  pointer-events: none;
}

.activity-card-content {
  position: relative;
  z-index: 2;
  display: flex;
  gap: var(--zy-space-sm2);
  padding: var(--zy-space-lg);
}

/* ===== 封面 ===== */
.activity-cover-wrapper {
  flex-shrink: 0;
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--zy-radius-md);
  overflow: hidden;
  background: var(--activity-tint);
  border: 1rpx solid var(--hairline);
}

.activity-cover {
  width: 100%;
  height: 100%;
}

/* ===== 活动信息区 ===== */
.activity-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.activity-header-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: var(--zy-space-sm2);
  margin-bottom: 10rpx;
}

.activity-title {
  font-family: var(--font-sans);
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  flex: 1;
  min-width: 0;
  letter-spacing: 0.02em;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.activity-price {
  font-family: var(--font-sans);
  font-size: 26rpx;
  font-weight: 500;
  color: var(--activity-primary);
  flex-shrink: 0;
  letter-spacing: 0.02em;
}

.activity-price.free {
  color: var(--success-color);
}

.activity-meta {
  margin-bottom: var(--zy-space-sm2);
}

.meta-item {
  display: flex;
  align-items: center;
  margin-bottom: 6rpx;
}

.meta-item:last-child {
  margin-bottom: 0;
}

.meta-icon {
  width: 22rpx;
  height: 22rpx;
  margin-right: 8rpx;
  opacity: 0.5;
  flex-shrink: 0;
}

.meta-text {
  font-family: var(--font-sans);
  font-size: 22rpx;
  color: var(--text-secondary);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-weight: 400;
  letter-spacing: 0.02em;
  line-height: 1.4;
}

.meta-item-right {
  display: flex;
  align-items: center;
}

/* ===== 主办方行 ===== */
.activity-organizer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.organizer-info {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 1;
  min-width: 0;
}

.organizer-avatar {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  flex-shrink: 0;
  border: 1rpx solid var(--hairline);
}

.organizer-name {
  font-family: var(--font-sans);
  font-size: 22rpx;
  color: var(--text-tertiary);
  font-weight: 400;
  letter-spacing: 0.02em;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ===== 状态徽章 ===== */
.joined-badge {
  padding: 8rpx 20rpx;
  border-radius: var(--zy-radius-pill);
  background-color: var(--success-color);
  flex-shrink: 0;
}

.joined-badge-text {
  font-family: var(--font-sans);
  font-size: 20rpx;
  font-weight: 500;
  color: var(--text-on-primary);
  letter-spacing: 0.06em;
}

/* 已结束 — 灰色 */
.ended-badge {
  background-color: var(--text-tertiary);
}

/* ===== 卡片底部发丝线 ===== */
.activity-accent {
  position: absolute;
  bottom: 0;
  left: var(--zy-space-lg);
  right: var(--zy-space-lg);
  height: 1rpx;
  background: var(--activity-primary);
  opacity: 0.2;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx var(--page-padding);
  text-align: center;
  animation-name: fadeIn;
  animation-duration: 600ms;
  animation-timing-function: cubic-bezier(0.16,1,0.3,1);
  animation-fill-mode: forwards;
}

.empty-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: var(--zy-space-lg);
  opacity: 0.4;
}

.empty-title {
  font-family: var(--font-sans);
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: var(--zy-space-sm);
  display: block;
  letter-spacing: 0.08em;
}

.empty-text {
  font-family: var(--font-sans);
  font-size: 24rpx;
  color: var(--text-tertiary);
  line-height: 1.6;
  letter-spacing: 0.06em;
  font-weight: 400;
}

/* ===== 加载态 ===== */
.loading-more {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--zy-space-xl) 0;
  gap: var(--zy-space-sm2);
}

.loading-dots {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.loading-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--activity-primary);
  opacity: 0.3;
  animation-name: dotPulse;
  animation-duration: 1200ms;
  animation-timing-function: cubic-bezier(0.42, 0, 0.58, 1);
  animation-fill-mode: forwards;
  animation-iteration-count: infinite;
}

.loading-dot:nth-child(2) {
  animation-delay: 200ms;
}

.loading-dot:nth-child(3) {
  animation-delay: 400ms;
}

@keyframes dotPulse {
  0%, 80%, 100% { opacity: 0.3; transform: scale(0.8); }
  40% { opacity: 1; transform: scale(1); }
}

.loading-more-text {
  font-family: var(--font-sans);
  font-size: 22rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.12em;
  font-weight: 400;
}

/* ===== 底部提示 ===== */
.joined-hint {
  padding: var(--zy-space-lg);
  text-align: center;
  margin: var(--zy-space-sm2) var(--page-padding) 0;
}

.hint-text {
  font-family: var(--font-sans);
  font-size: 22rpx;
  color: var(--text-tertiary);
  line-height: 1.5;
  letter-spacing: 0.06em;
  font-weight: 400;
}
