@import '../../styles/variables.wxss';

.page-container {
  min-height: 100vh;
  background-color: var(--background-color);
  padding: 120rpx 24rpx 40rpx;
}

.activity-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.activity-card {
  background: var(--card-color);
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  position: relative;
}

.activity-card:active {
  transform: scale(0.99);
}

.activity-card-background {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 160rpx;
  background: linear-gradient(135deg, rgba(78, 205, 196, 0.05), rgba(38, 166, 154, 0.05));
  z-index: 0;
}

.activity-card-content {
  position: relative;
  z-index: 1;
  display: flex;
  gap: 20rpx;
  padding: 24rpx;
}

.activity-cover-wrapper {
  flex-shrink: 0;
  width: 180rpx;
  height: 180rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.activity-cover {
  width: 100%;
  height: 100%;
}

.activity-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.activity-header-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.activity-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.activity-price {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-primary);
  flex-shrink: 0;
  margin-left: 16rpx;
}

.activity-price.free {
  color: var(--activity-primary);
}

.activity-meta {
  margin-bottom: 16rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  margin-bottom: 6rpx;
}

.meta-item:last-child {
  margin-bottom: 0;
}

.meta-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 8rpx;
  opacity: 0.6;
}

.meta-text {
  font-size: 22rpx;
  color: var(--text-secondary);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meta-item-right {
  display: flex;
  justify-content: flex-end;
}

.activity-organizer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.organizer-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.organizer-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
}

.organizer-name {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.joined-badge {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
}

.joined-badge-text {
  color: var(--card-color);
}

.ended-badge {
  background: var(--gray-500);
}

.activity-accent {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, var(--activity-primary), var(--activity-secondary));
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 48rpx;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 32rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.empty-text {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.loading-more {
  text-align: center;
  padding: 32rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.loading-dots {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.loading-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--activity-primary);
  animation: dotBounce 1.4s ease-in-out infinite;
}

.loading-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.loading-dot:nth-child(3) {
  animation-delay: 0.4s;
}

.loading-more-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 4rpx;
}

@keyframes dotBounce {
  0%, 80%, 100% { opacity: 0.3; transform: translateY(0); }
  40% { opacity: 1; transform: translateY(-12rpx); }
}

.joined-hint {
  text-align: center;
  padding: 32rpx;
}

.hint-text {
  font-size: 22rpx;
  color: var(--gray-500);
}
