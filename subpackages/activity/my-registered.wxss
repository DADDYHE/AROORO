@import '../../styles/variables.wxss';

.page-container {
  min-height: 100vh;
  background-color: #F5F5F7;
  padding: 120rpx 24rpx 40rpx;
}

.activity-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.activity-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  position: relative;
}

.activity-card:active {
  transform: scale(0.99);
}

.activity-card-background {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 160rpx;
  background: linear-gradient(135deg, rgba(78, 205, 196, 0.05), rgba(38, 166, 154, 0.05));
  z-index: 0;
}

.activity-card-content {
  position: relative;
  z-index: 1;
  display: flex;
  gap: 20rpx;
  padding: 24rpx;
}

.activity-cover-wrapper {
  flex-shrink: 0;
  width: 180rpx;
  height: 180rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.activity-cover {
  width: 100%;
  height: 100%;
}

.activity-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.activity-header-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.activity-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D1D1F;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.activity-price {
  font-size: 26rpx;
  font-weight: 700;
  color: #1D1D1F;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.activity-price.free {
  color: #4ECDC4;
}

.activity-meta {
  margin-bottom: 16rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  margin-bottom: 6rpx;
}

.meta-item:last-child {
  margin-bottom: 0;
}

.meta-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 8rpx;
  opacity: 0.6;
}

.meta-text {
  font-size: 22rpx;
  color: #86868B;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meta-item-right {
  display: flex;
  justify-content: flex-end;
}

.activity-organizer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.organizer-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.organizer-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
}

.organizer-name {
  font-size: 22rpx;
  color: #86868B;
}

.joined-badge {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
}

.joined-badge-text {
  color: #FFFFFF;
}

.ended-badge {
  background: #AEAEB2;
}

.activity-accent {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, #4ECDC4, #26A69A);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 48rpx;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 32rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1D1D1F;
  margin-bottom: 12rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #86868B;
}

.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.loading-spinner {
  width: 36rpx;
  height: 36rpx;
  border: 3rpx solid #E5E5EA;
  border-top: 3rpx solid #4ECDC4;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-right: 16rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #86868B;
}

.joined-hint {
  text-align: center;
  padding: 32rpx;
}

.hint-text {
  font-size: 22rpx;
  color: #AEAEB2;
}
