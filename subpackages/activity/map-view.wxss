/* ================================================================
   activity/map-view.wxss · AROORO 活动地图页 — Haute-Luxury Editorial
   全屏地图 + 底部浮层卡片（全出血，无页面边距）
   Skyline 兼容：无 :active / text-transform / backdrop-filter / sticky
   ================================================================ */

/* ===== 页面容器（全出血） ===== */
.map-page {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
}

/* ===== 地图（全屏） ===== */
.map {
  width: 100%;
  height: 100%;
}

/* ===== 底部浮层卡片（白底 + 发丝边 + 顶部圆角） ===== */
.location-card {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--card-color);
  border-radius: var(--zy-radius-lg) var(--zy-radius-lg) 0 0;
  padding: var(--zy-space-lg) var(--page-padding) calc(var(--zy-space-lg) + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--hairline);
  border-left: 1rpx solid var(--hairline);
  border-right: 1rpx solid var(--hairline);
  animation-name: zy-footer-rise;
  animation-duration: 480ms;
  animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  animation-fill-mode: forwards;
  animation-delay: 200ms;
  z-index: 10;
}

.location-name {
  font-family: var(--font-sans);
  font-size: 34rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 8rpx;
  letter-spacing: 0.04em;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.location-address {
  font-family: var(--font-sans);
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: var(--zy-space-lg);
  letter-spacing: 0.02em;
  font-weight: 400;
  display: block;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ===== 导航主按钮 ===== */
.nav-btn {
  width: 100%;
  background: var(--gradient-primary);
  border: none;
  border-radius: var(--zy-radius-lg);
  padding: 26rpx 0;
  box-shadow: var(--shadow-glow-primary-btn);
  transition: transform 280ms cubic-bezier(0.25,0.1,0.25,1),
              box-shadow 280ms cubic-bezier(0.25,0.1,0.25,1),
              opacity 280ms cubic-bezier(0.25,0.1,0.25,1);
}

.nav-btn::after {
  border: none;
}

.nav-btn--pressed {
  transform: scale(0.98);
  box-shadow: var(--shadow-glow-primary-xs);
}

.nav-btn-text {
  font-family: var(--font-sans);
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-on-primary);
  letter-spacing: 0.10em;
}

/* ===== 返回按钮（透明圆形 + 发丝边，供 zy-navbar 覆盖或自定义浮层使用） ===== */
.back-btn {
  position: absolute;
  top: calc(var(--zy-space-lg) + env(safe-area-inset-top));
  left: var(--page-padding);
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--card-color);
  border: 1rpx solid var(--hairline);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 20;
  animation-name: zy-fade-in;
  animation-duration: 420ms;
  animation-timing-function: cubic-bezier(0.19, 1, 0.22, 1);
  animation-fill-mode: forwards;
  animation-delay: 400ms;
  transition: transform 240ms cubic-bezier(0.25,0.1,0.25,1),
              opacity 240ms cubic-bezier(0.25,0.1,0.25,1);
}

.back-btn--pressed {
  transform: scale(0.92);
  opacity: 0.8;
}
