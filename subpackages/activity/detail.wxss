/* ================================================================
   activity/detail.wxss · AROORO 活动详情页 — Haute-Luxury Editorial
   板块色：深林绿家族 --activity-primary / --activity-secondary
   Hero 全出血大图 + 发丝描边卡片 + 克制动效
   Skyline 兼容：无 :active / text-transform / backdrop-filter / sticky
   ================================================================ */
/* ===== 入场动画 ===== */
@keyframes fadeInUp {
  0% {
    opacity: 0;
    transform: translateY(32rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeIn {
  0% { opacity: 0; }
  100% { opacity: 1; }
}

@keyframes heroFadeIn {
  0% { opacity: 0; transform: scale(1.04); }
  100% { opacity: 1; transform: scale(1); }
}

/* ===== 页面容器 ===== */
.page-container {
  min-height: 100vh;
  position: relative;
}

.scroll-container {
  height: 100vh;
}

.page-content {
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

/* ==================== Hero Section（全出血大图 + 渐变遮罩） ==================== */
.hero-section {
  position: relative;
  width: 100%;
  padding-top: 62.5%;
  overflow: hidden;
  background-color: var(--activity-tint);
  animation-name: heroFadeIn;
  animation-duration: 800ms;
  animation-timing-function: cubic-bezier(0.16,1,0.3,1);
  animation-fill-mode: forwards;
}

.hero-cover {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.hero-cover-share {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.hero-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 75%;
  background: linear-gradient(
    to top,
    rgba(15, 36, 16, 0.82) 0%,
    rgba(15, 36, 16, 0.50) 35%,
    rgba(15, 36, 16, 0.15) 65%,
    transparent 100%
  );
  pointer-events: none;
}

.hero-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: var(--zy-space-xl) var(--page-padding);
  z-index: 10;
  animation-name: fadeInUp;
  animation-duration: 700ms;
  animation-timing-function: cubic-bezier(0.16,1,0.3,1);
  animation-delay: 200ms;
  animation-fill-mode: forwards;
}

.hero-badge-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: var(--zy-space-lg);
}

.status-badge {
  padding: 8rpx 20rpx;
  border-radius: var(--zy-radius-pill);
  font-size: 22rpx;
  font-weight: 500;
  letter-spacing: 0.08em;
}

.status-badge.upcoming {
  background-color: var(--activity-primary);
  color: var(--text-on-primary);
}

.status-badge.ongoing {
  background-color: var(--success-color);
  color: var(--text-on-primary);
}

.status-badge.ended {
  background-color: var(--text-tertiary);
  color: var(--text-on-primary);
}

.status-text {
  font-size: 22rpx;
  letter-spacing: 0.08em;
  font-weight: 400;
}

.category-badge {
  padding: 8rpx 20rpx;
  border-radius: var(--zy-radius-pill);
  background-color: rgba(247, 245, 239, 0.18);
  border: 1rpx solid rgba(247, 245, 239, 0.25);
}

.category-text {
  font-size: 22rpx;
  color: var(--text-on-primary);
  font-weight: 400;
  letter-spacing: 0.10em;
}

.hero-title {
  display: block;
  font-size: 44rpx;
  font-weight: 500;
  color: var(--text-on-primary);
  line-height: 1.3;
  letter-spacing: 0.04em;
  margin-bottom: var(--zy-space-lg);
  font-family: var(--font-sans);
}

.hero-meta {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.hero-meta-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.hero-meta-icon {
  width: 22rpx;
  height: 22rpx;
  opacity: 0.75;
}

.hero-meta-text {
  font-size: 24rpx;
  color: rgba(247, 245, 239, 0.88);
  font-weight: 400;
  letter-spacing: 0.04em;
}

.hero-accent-line {
  position: absolute;
  bottom: 0;
  left: var(--page-padding);
  right: var(--page-padding);
  height: 2rpx;
  background: linear-gradient(90deg, var(--accent-color), transparent 70%);
  opacity: 0.6;
}

/* ==================== Info Card ==================== */
.info-card {
  margin: var(--zy-space-lg) var(--page-padding) var(--zy-space-lg);
  background-color: var(--card-color);
  border-radius: var(--zy-radius-lg);
  border: 1rpx solid var(--hairline);
  overflow: hidden;
  animation-name: fadeInUp;
  animation-duration: 600ms;
  animation-timing-function: cubic-bezier(0.16,1,0.3,1);
  animation-delay: 300ms;
  animation-fill-mode: forwards;
}

.info-row {
  display: flex;
  align-items: stretch;
}

.info-cell-divider {
  width: 1rpx;
  background-color: var(--hairline);
  flex-shrink: 0;
}

.info-row-divider {
  height: 1rpx;
  background-color: var(--hairline);
}

.info-cell {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  text-align: left;
  padding: var(--zy-space-lg) var(--zy-space-lg);
  background-color: transparent;
}

.info-cell--full {
  flex: 1 1 100%;
}

.info-cell.multi-day {
  align-items: flex-start;
}

.info-value-multi {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 8rpx;
  width: 100%;
}

.time-row-group {
  display: flex;
  align-items: baseline;
  gap: 32rpx;
}

.time-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  flex-shrink: 0;
}

.time-prefix {
  font-size: 20rpx;
  color: var(--text-tertiary);
  font-weight: 400;
  letter-spacing: 0.10em;
  flex-shrink: 0;
}

.time-main {
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 500;
  letter-spacing: 0.02em;
  white-space: nowrap;
}

.info-value {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-top: 8rpx;
  max-width: 100%;
  white-space: nowrap;
  letter-spacing: 0.02em;
  font-family: var(--font-sans);
}

.info-value.multi-line {
  white-space: pre-line;
  line-height: 1.6;
  overflow: visible;
  font-weight: 400;
  font-size: 26rpx;
}

.location-link {
  color: var(--activity-primary);
  font-weight: 500;
}

.price-value {
  color: var(--activity-primary);
  font-weight: 500;
}

.info-label {
  font-size: 20rpx;
  color: var(--text-tertiary);
  font-weight: 400;
  letter-spacing: 0.12em;
}

/* ==================== Highlight Section（亮点标签） ==================== */
.highlight-section {
  margin: var(--zy-space-lg) var(--page-padding) var(--zy-space-lg);
  animation-name: fadeInUp;
  animation-duration: 600ms;
  animation-timing-function: cubic-bezier(0.16,1,0.3,1);
  animation-delay: 380ms;
  animation-fill-mode: forwards;
}

.highlight-scroll {
  width: 100%;
  height: 72rpx;
}

.highlight-tags {
  display: flex;
  gap: 12rpx;
  padding: 4rpx 0;
}

.highlight-tag {
  display: flex;
  align-items: center;
  padding: 14rpx 28rpx;
  background-color: var(--activity-tint);
  border-radius: var(--zy-radius-pill);
  border: 1rpx solid rgba(45, 79, 45, 0.12);
  transition-property: transform;
  transition-duration: 280ms;
  transition-timing-function: cubic-bezier(0.25,0.1,0.25,1);
}

.highlight-tag--pressed {
  transform: scale(0.97);
}

.highlight-tag-text {
  font-size: 24rpx;
  color: var(--activity-primary);
  font-weight: 500;
  white-space: nowrap;
  letter-spacing: 0.04em;
}

/* ==================== Section Card（通用内容卡） ==================== */
.section-card {
  margin: var(--zy-space-lg) var(--page-padding) var(--zy-space-lg);
  background-color: var(--card-color);
  border-radius: var(--zy-radius-lg);
  padding: var(--zy-space-lg);
  border: 1rpx solid var(--hairline);
  animation-name: fadeInUp;
  animation-duration: 600ms;
  animation-timing-function: cubic-bezier(0.16,1,0.3,1);
  animation-delay: 460ms;
  animation-fill-mode: forwards;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--zy-space-lg);
}

.section-title-wrapper {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.section-title-accent {
  width: 3rpx;
  height: 28rpx;
  background: var(--activity-primary);
  border-radius: 2rpx;
  flex-shrink: 0;
}

.section-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.06em;
  font-family: var(--font-sans);
  white-space: nowrap;
}

.section-count {
  font-size: 22rpx;
  color: var(--text-tertiary);
  font-weight: 400;
  letter-spacing: 0.08em;
  flex-shrink: 0;
}

.description {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.85;
  letter-spacing: 0.03em;
  font-weight: 400;
  font-family: var(--font-sans);
}

/* ==================== Image Gallery Large ==================== */
.image-gallery-large {
  display: flex;
  flex-direction: column;
  gap: var(--zy-space-lg);
}

.gallery-item-large {
  width: 100%;
  border-radius: var(--zy-radius-md);
  overflow: hidden;
  background-color: var(--activity-tint);
}

.gallery-image-large {
  width: 100%;
  display: block;
  border-radius: var(--zy-radius-md);
}

/* ==================== Organizer Card ==================== */
.organizer-card {
  margin: var(--zy-space-lg) var(--page-padding) var(--zy-space-lg);
  background-color: var(--card-color);
  border-radius: var(--zy-radius-lg);
  padding: var(--zy-space-lg);
  border: 1rpx solid var(--hairline);
  animation-name: fadeInUp;
  animation-duration: 600ms;
  animation-timing-function: cubic-bezier(0.16,1,0.3,1);
  animation-delay: 540ms;
  animation-fill-mode: forwards;
}

.organizer-content {
  display: flex;
  align-items: center;
  gap: var(--zy-space-lg);
}

.organizer-avatar-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  background-color: var(--activity-tint);
  border: 1rpx solid var(--hairline);
}

.organizer-avatar-wrap.has-avatar {
  background-color: transparent;
}

.organizer-avatar-img {
  width: 100%;
  height: 100%;
}

.organizer-avatar-fallback {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--activity-primary);
}

.organizer-avatar-letter {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-on-primary);
  line-height: 1;
}

.organizer-info {
  flex: 1;
  min-width: 0;
}

.organizer-name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 6rpx;
  letter-spacing: 0.03em;
}

.organizer-desc {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 400;
  letter-spacing: 0.02em;
}

.organizer-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 24rpx;
  background-color: var(--activity-tint);
  border-radius: var(--zy-radius-lg);
  border: 1rpx solid rgba(45, 79, 45, 0.12);
  transition-property: transform;
  transition-duration: 280ms;
  transition-timing-function: cubic-bezier(0.25,0.1,0.25,1);
}

.organizer-action--pressed {
  transform: scale(0.97);
}

.organizer-action-icon {
  font-size: 28rpx;
  margin-bottom: 4rpx;
}

/* 发丝线联系图标（image 替代 emoji） */
.organizer-action-icon--svg {
  width: 32rpx;
  height: 32rpx;
  margin-bottom: 4rpx;
}

.organizer-action-text {
  font-size: 22rpx;
  color: var(--activity-primary);
  font-weight: 500;
  letter-spacing: 0.06em;
}

/* ==================== Bottom Spacer ==================== */
.bottom-spacer {
  height: 48rpx;
}

/* ==================== Action Bar（固定底栏 + 安全区） ==================== */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: var(--zy-space-sm2) var(--page-padding);
  padding-bottom: calc(var(--zy-space-sm2) + env(safe-area-inset-bottom));
  background-color: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid var(--hairline);
  z-index: 100;
}

.action-icons {
  display: flex;
  gap: 8rpx;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 12rpx;
  min-width: 64rpx;
  flex-shrink: 0;
  transition-property: transform;
  transition-duration: 280ms;
  transition-timing-function: cubic-bezier(0.25,0.1,0.25,1);
}

.action-share-wrap {
  position: relative;
}

.action-share-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  background: transparent;
  border: none;
  margin: 0;
  padding: 0;
  line-height: normal;
}

.action-share-overlay::after {
  border: none;
}

.action-btn--pressed {
  transform: scale(0.92);
}

.action-btn.favorited .action-btn-text {
  color: var(--brand-red);
}

.action-btn-icon {
  font-size: 32rpx;
  margin-bottom: 4rpx;
}

/* 方案 A 发丝线分享图标（image 替代 emoji） */
.action-btn-icon--svg {
  width: 36rpx;
  height: 36rpx;
  margin-bottom: 4rpx;
}

.action-btn-text {
  font-size: 18rpx;
  color: var(--text-secondary);
  font-weight: 400;
  letter-spacing: 0.02em;
  white-space: nowrap;
}

.action-primary {
  flex: 1;
  min-width: 0;
  margin-left: var(--zy-space-sm2);
}

.primary-btn {
  background: var(--gradient-primary);
  border-radius: var(--zy-radius-lg);
  padding: 24rpx 24rpx;
  text-align: center;
  box-shadow: var(--shadow-glow-primary-btn);
  transition: transform 280ms cubic-bezier(0.25,0.1,0.25,1),
              box-shadow 280ms cubic-bezier(0.25,0.1,0.25,1),
              opacity 280ms cubic-bezier(0.25,0.1,0.25,1);
}

.primary-btn--pressed {
  transform: scale(0.98);
  box-shadow: var(--shadow-glow-primary-xs);
}

.primary-btn.registered {
  background: var(--success-color);
  box-shadow: 0 6rpx 18rpx rgba(61, 122, 69, 0.25);
}

.primary-btn.ended {
  background: var(--text-tertiary);
  box-shadow: none;
}

.primary-btn.stopped {
  background: var(--warning-color);
  box-shadow: 0 6rpx 18rpx rgba(201,162,75, 0.25);
}

.primary-btn.signed-btn {
  background: var(--success-color);
  box-shadow: 0 6rpx 18rpx rgba(61, 122, 69, 0.25);
}

.primary-btn-text {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-on-primary);
  letter-spacing: 0.06em;
  white-space: nowrap;
  font-family: var(--font-sans);
}

/* ==================== Loading State ==================== */
.loading-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  pointer-events: none;
  background-color: rgba(236, 228, 212, 0.72);
}

.loading-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--zy-space-lg);
}

.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 3rpx solid var(--activity-tint);
  border-top-color: var(--activity-primary);
  border-radius: 50%;
  animation-name: spin;
  animation-duration: 800ms;
  animation-timing-function: linear;
  animation-fill-mode: forwards;
  animation-iteration-count: infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 24rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.12em;
  font-weight: 400;
}

/* ==================== Error State ==================== */
.error-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  pointer-events: none;
}

.error-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: var(--zy-space-xl);
}

.error-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: var(--zy-space-lg);
  opacity: 0.4;
}

.error-title {
  font-size: 34rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: var(--zy-space-sm);
  letter-spacing: 0.06em;
}

.error-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: var(--zy-space-lg);
  font-weight: 400;
  letter-spacing: 0.04em;
}

.error-btn {
  padding: 22rpx 56rpx;
  background: var(--gradient-primary);
  border-radius: var(--zy-radius-lg);
  box-shadow: var(--shadow-glow-primary-btn);
  transition-property: transform;
  transition-duration: 280ms;
  transition-timing-function: cubic-bezier(0.25,0.1,0.25,1);
}

.error-btn--pressed {
  transform: scale(0.97);
}

.error-btn-text {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-on-primary);
  letter-spacing: 0.08em;
}

/* ==================== Skyline 兼容说明 ==================== */
/* rpx 自适应屏幕宽度，无媒体查询断点（除 DarkMode） */
