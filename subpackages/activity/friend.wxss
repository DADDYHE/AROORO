/* ================================================================
   activity/friend.wxss · AROORO 代好友报名页 — Haute-Luxury Editorial
   板块色：深林绿 --activity-primary + 暖金点缀 --accent-color
   Skyline 兼容：无 :active / text-transform / backdrop-filter / sticky
   ================================================================ */

/* ===== 页面容器 ===== */
.container {
  min-height: 100vh;
  background-color: var(--background-color);
  position: relative;
  overflow-x: hidden;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

/* ===== 入场动画 ===== */
@keyframes fadeInUp {
  0% {
    opacity: 0;
    transform: translateY(28rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeIn {
  0% { opacity: 0; }
  100% { opacity: 1; }
}

/* ===== 表单卡片 ===== */
.form-section {
  position: relative;
  background-color: var(--card-color);
  border-radius: var(--zy-radius-lg);
  padding: var(--zy-space-lg);
  margin: var(--zy-space-lg) var(--page-padding) var(--zy-space-lg);
  border: 1rpx solid var(--hairline);
  z-index: 1;
  overflow: hidden;
  animation-name: fadeInUp;
  animation-duration: 500ms;
  animation-timing-function: cubic-bezier(0.16,1,0.3,1);
  animation-fill-mode: forwards;
  animation-delay: 120ms;
}

.section-title {
  font-family: var(--font-sans);
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: var(--zy-space-lg);
  position: relative;
  display: flex;
  align-items: center;
  letter-spacing: 0.06em;
  padding-bottom: var(--zy-space-sm2);
  border-bottom: 1rpx solid var(--hairline);
}

/* ===== 表单项 ===== */
.form-item {
  margin-bottom: var(--zy-space-lg);
  position: relative;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  display: block;
  font-family: var(--font-sans);
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
  font-weight: 400;
  letter-spacing: 0.04em;
}

/* ===== 输入框（奶油底 + 发丝边框） ===== */
.input-container {
  position: relative;
  border-radius: var(--zy-radius-md);
  overflow: hidden;
  width: 100%;
  box-sizing: border-box;
  background: var(--card-cream);
  border: 1rpx solid var(--hairline);
}

.input {
  width: 100%;
  padding: 24rpx var(--zy-space-lg);
  border: none;
  font-family: var(--font-sans);
  font-size: 28rpx;
  background-color: transparent;
  z-index: 2;
  position: relative;
  line-height: 1.5;
  min-height: 88rpx;
  box-sizing: border-box;
  color: var(--text-primary);
}

.input-decoration {
  display: none;
}

/* ===== 文本域 ===== */
.textarea-container {
  position: relative;
  border-radius: var(--zy-radius-md);
  overflow: hidden;
  width: 100%;
  box-sizing: border-box;
  background: var(--card-cream);
  border: 1rpx solid var(--hairline);
}

.textarea {
  width: 100%;
  padding: 24rpx var(--zy-space-lg);
  border: none;
  font-family: var(--font-sans);
  font-size: 28rpx;
  background-color: transparent;
  z-index: 2;
  position: relative;
  line-height: 1.6;
  min-height: 160rpx;
  box-sizing: border-box;
  color: var(--text-primary);
}

/* ===== 性别选择（男蓝女粉 语义色 + 淡底） ===== */
.gender-options {
  display: flex;
  gap: var(--zy-space-sm2);
}

.gender-option {
  flex: 1;
  padding: 22rpx;
  border: 1rpx solid var(--hairline);
  border-radius: var(--zy-radius-md);
  text-align: center;
  font-family: var(--font-sans);
  font-size: 26rpx;
  color: var(--text-secondary);
  position: relative;
  overflow: hidden;
  background: var(--card-cream);
  font-weight: 400;
  letter-spacing: 0.04em;
  transition: transform 240ms cubic-bezier(0.25,0.1,0.25,1),
              background-color 240ms cubic-bezier(0.25,0.1,0.25,1),
              border-color 240ms cubic-bezier(0.25,0.1,0.25,1),
              color 240ms cubic-bezier(0.25,0.1,0.25,1);
}

.gender-option--pressed {
  transform: scale(0.97);
}

.gender-option.active {
  border-color: transparent;
  font-weight: 500;
}

.gender-option.active[data-gender="male"] {
  background: var(--gender-male-tint, rgba(91, 184, 214, 0.10));
  color: var(--gender-male, #5BB8D6);
  border-color: var(--gender-male-border, rgba(91, 184, 214, 0.25));
}

.gender-option.active[data-gender="female"] {
  background: var(--gender-female-tint, rgba(255, 166, 201, 0.10));
  color: var(--gender-female, #FFA6C9);
  border-color: var(--gender-female-border, rgba(255, 166, 201, 0.25));
}

.gender-decoration {
  display: none;
}

/* ===== 底部按钮组 ===== */
.button-section {
  display: flex;
  gap: var(--zy-space-sm2);
  margin: var(--zy-space-lg) var(--page-padding) var(--zy-space-lg);
  position: relative;
  z-index: 1;
  animation-name: fadeInUp;
  animation-duration: 500ms;
  animation-timing-function: cubic-bezier(0.16,1,0.3,1);
  animation-fill-mode: forwards;
  animation-delay: 240ms;
}

.cancel-btn {
  flex: 1;
  padding: 0;
  border: 1rpx solid var(--hairline);
  border-radius: var(--zy-radius-lg);
  font-family: var(--font-sans);
  font-size: 28rpx;
  font-weight: 400;
  background-color: var(--card-color);
  color: var(--text-secondary);
  height: 96rpx;
  line-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 0.08em;
  transition: transform 240ms cubic-bezier(0.25,0.1,0.25,1),
              opacity 240ms cubic-bezier(0.25,0.1,0.25,1);
}

.cancel-btn::after {
  border: none;
}

.cancel-btn--pressed {
  transform: scale(0.97);
  opacity: 0.8;
}

.confirm-btn {
  flex: 2;
  background: var(--gradient-primary);
  color: var(--text-on-primary);
  border: none;
  padding: 0;
  border-radius: var(--zy-radius-lg);
  font-family: var(--font-sans);
  font-size: 28rpx;
  font-weight: 500;
  height: 96rpx;
  line-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-glow-primary-btn);
  overflow: hidden;
  position: relative;
  letter-spacing: 0.10em;
  transition: transform 240ms cubic-bezier(0.25,0.1,0.25,1),
              box-shadow 240ms cubic-bezier(0.25,0.1,0.25,1),
              opacity 240ms cubic-bezier(0.25,0.1,0.25,1);
}

.confirm-btn::after {
  border: none;
}

.confirm-btn--pressed {
  transform: scale(0.98);
  box-shadow: var(--shadow-glow-primary-xs);
}

.confirm-decoration {
  display: none;
}

.confirm-text {
  position: relative;
  z-index: 2;
  letter-spacing: 0.10em;
}
