<view class="page-container">
  <view class="activity-list" wx:if="{{activities.length > 0}}">
    <view
      wx:for="{{activities}}"
      wx:key="_id"
      class="activity-card"
      data-id="{{item._id}}"
      bindtap="onActivityTap"
    >
      <view class="activity-card-background"></view>
      <view class="activity-card-content">
        <view class="activity-cover-wrapper">
          <image lazy-load class="activity-cover" src="{{item.coverUrl || '/images/default-activity.svg'}}" mode="aspectFill" binderror="onCloudImageError" data-src="{{item.coverUrl || '/images/default-activity.svg'}}" data-path="activities[{{index}}].coverUrl" />
        </view>
        <view class="activity-info">
          <view class="activity-header-row">
            <text class="activity-title">{{item.title}}</text>
            <text class="activity-price {{(item.pricePerPerson > 0 || item.pricePerPet > 0) ? '' : 'free'}}">{{item.priceText}}</text>
          </view>
          <view class="activity-meta">
            <view class="meta-item">
              <text class="meta-text">{{item.timeText}}</text>
            </view>
            <view class="meta-item meta-item-right">
              <text class="meta-text">{{item.location}}</text>
            </view>
          </view>
          <view class="activity-organizer">
            <view class="organizer-info">
              <image lazy-load class="organizer-avatar" src="{{item.organizer.avatar}}" mode="aspectFill" binderror="onCloudImageError" data-src="{{item.organizer.avatar}}" data-path="activities[{{index}}].organizer.avatar" />
              <text class="organizer-name">{{item.organizer.name}}</text>
            </view>
            <view wx:if="{{item.activityStatus === 'ended'}}" class="joined-badge ended-badge">
              <text class="joined-badge-text">已结束</text>
            </view>
            <view wx:else class="joined-badge">
              <text class="joined-badge-text">已报名</text>
            </view>
          </view>
        </view>
        <view class="activity-accent"></view>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:if="{{activities.length === 0 && !isLoading}}">
    <view class="empty-icon">🎉</view>
    <text class="empty-title">暂无报名</text>
    <text class="empty-text">快去报名心仪的活动吧</text>
  </view>

  <view class="loading-more" wx:if="{{isLoading}}">
    <view class="loading-dots">
      <view class="loading-dot"></view>
      <view class="loading-dot"></view>
      <view class="loading-dot"></view>
    </view>
    <text class="loading-more-text">加载中</text>
  </view>

  <view class="joined-hint" wx:if="{{activities.length > 0}}">
    <text class="hint-text">仅能显示最近6个月我报名的活动</text>
  </view>
</view>
