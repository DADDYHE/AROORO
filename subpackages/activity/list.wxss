/* ================================================================
   activity/list.wxss · AROORO 活动列表页 — Haute-Luxury Editorial
   板块色：深林绿家族 --activity-primary / --activity-secondary
   Skyline 兼容：无 :active / text-transform / backdrop-filter / sticky
   ================================================================ */

/* ===== 页面级变量覆盖（板块锚定深林绿） ===== */
/* ===== 容器 ===== */
.page-container {
  min-height: 100vh;
  position: relative;
  overflow-x: hidden;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

/* ===== 入场动画 ===== */
@keyframes fadeInUp {
  0% {
    opacity: 0;
    transform: translateY(28rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeIn {
  0% { opacity: 0; }
  100% { opacity: 1; }
}

/* ===== 顶部品牌栏 ===== */
.page-header {
  padding: calc(var(--zy-space-xl) + env(safe-area-inset-top)) var(--page-padding) var(--zy-space-lg);
  text-align: center;
  position: relative;
  z-index: 2;
  animation-name: fadeIn;
  animation-duration: 600ms;
  animation-timing-function: cubic-bezier(0.16,1,0.3,1);
  animation-fill-mode: forwards;
}

.page-title {
  font-family: var(--font-sans);
  font-size: 40rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 8rpx;
  letter-spacing: 0.08em;
  display: block;
}

.page-subtitle {
  font-size: 22rpx;
  color: var(--text-tertiary);
  font-weight: 400;
  letter-spacing: 0.12em;
  display: block;
}

/* ===== 分类标签栏 ===== */
.category-tabs {
  display: flex;
  padding: var(--zy-space-sm2) var(--page-padding) var(--zy-space-sm2);
  gap: 12rpx;
  flex-wrap: wrap;
  justify-content: flex-start;
  position: relative;
  z-index: 10;
  border-bottom: 1rpx solid var(--hairline);
}

.category-tab {
  padding: 12rpx 28rpx;
  border-radius: var(--zy-radius-pill);
  font-size: 24rpx;
  color: var(--text-secondary);
  background-color: transparent;
  border: 1rpx solid var(--hairline);
  position: relative;
  overflow: hidden;
  z-index: 1;
  flex: 0 1 auto;
  min-width: auto;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-sans);
  font-weight: 400;
  letter-spacing: 0.04em;
  transition: transform 280ms cubic-bezier(0.25,0.1,0.25,1),
              background-color 280ms cubic-bezier(0.25,0.1,0.25,1),
              border-color 280ms cubic-bezier(0.25,0.1,0.25,1);
}

.category-tab--pressed {
  transform: scale(0.96);
}

.category-tab.active {
  background: var(--activity-primary);
  color: var(--text-on-primary);
  font-weight: 500;
  border-color: var(--activity-primary);
}

.category-tab.active .category-tab-text {
  color: var(--text-on-primary);
  font-weight: 500;
  letter-spacing: 0.06em;
}

.category-tab-text {
  position: relative;
  z-index: 10;
  display: flex;
  align-items: center;
}

/* ===== 活动列表 ===== */
.activity-list {
  padding: var(--zy-space-lg) var(--page-padding);
  display: flex;
  flex-direction: column;
  gap: var(--zy-space-lg);
}

/* ===== 活动卡片 ===== */
.activity-card {
  position: relative;
  border-radius: var(--zy-radius-lg);
  overflow: hidden;
  background-color: var(--card-color);
  border: 1rpx solid var(--hairline);
  transition: transform 280ms cubic-bezier(0.25,0.1,0.25,1),
              border-color 280ms cubic-bezier(0.25,0.1,0.25,1);
  animation-name: fadeInUp;
  animation-duration: 500ms;
  animation-timing-function: cubic-bezier(0.16,1,0.3,1);
  animation-fill-mode: forwards;
}

.activity-card:nth-child(1) { animation-delay: 80ms; }
.activity-card:nth-child(2) { animation-delay: 160ms; }
.activity-card:nth-child(3) { animation-delay: 240ms; }
.activity-card:nth-child(4) { animation-delay: 320ms; }
.activity-card:nth-child(5) { animation-delay: 400ms; }
.activity-card:nth-child(n+6)  { animation-delay: 480ms; }

.activity-card--pressed {
  transform: scale(0.985);
  border-color: rgba(45, 79, 45, 0.15);
}

.activity-card-background {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: var(--activity-tint);
  opacity: 0.5;
  z-index: 1;
  pointer-events: none;
}

.activity-card-content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  width: 100%;
}

/* ===== 封面 ===== */
.activity-cover-wrapper {
  position: relative;
  width: 100%;
  padding-top: 56.25%;
  overflow: hidden;
  background-color: var(--activity-tint);
}

.activity-cover {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

/* ===== 活动信息区 ===== */
.activity-info {
  padding: var(--zy-space-lg);
  flex: 1;
  display: flex;
  flex-direction: column;
}

.activity-header-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: var(--zy-space-lg);
  margin-bottom: var(--zy-space-lg);
}

.activity-title {
  font-family: var(--font-sans);
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-primary);
  line-height: 1.45;
  flex: 1;
  min-width: 0;
  letter-spacing: 0.02em;
}

.activity-meta {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: var(--zy-space-lg);
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  flex-wrap: wrap;
  font-weight: 400;
  letter-spacing: 0.02em;
}

.meta-item-right {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--zy-space-lg);
}

.meta-item-right .meta-text {
  flex: 1;
  min-width: 0;
}

.meta-text {
  flex: 1;
  line-height: 1.5;
  white-space: normal;
  overflow-wrap: break-word;
}

.meta-icon {
  width: 24rpx;
  height: 24rpx;
  flex-shrink: 0;
  display: block;
  align-self: center;
  opacity: 0.7;
}

/* ===== 价格（活动用深林绿） ===== */
.activity-price {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--activity-primary);
  line-height: 1.2;
  letter-spacing: 0.02em;
  font-family: var(--font-sans);
}

.activity-price.free {
  color: var(--success-color);
}

/* ===== 参与人数 ===== */
.activity-participants {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
}

.participants-text {
  font-size: 20rpx;
  color: var(--text-tertiary);
  font-weight: 400;
  white-space: nowrap;
  letter-spacing: 0.04em;
}

.participants-progress {
  width: 64rpx;
  height: 4rpx;
  background-color: var(--activity-tint);
  border-radius: 2rpx;
  overflow: hidden;
  position: relative;
}

.progress-bar {
  height: 100%;
  background: var(--activity-primary);
  border-radius: 2rpx;
  position: relative;
}

/* ===== 主办方行 ===== */
.activity-organizer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: var(--zy-space-lg);
  padding-top: var(--zy-space-lg);
  border-top: 1rpx solid var(--hairline);
}

.organizer-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.organizer-avatar-wrap {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  background-color: var(--activity-tint);
  border: 1rpx solid var(--hairline);
}

.organizer-avatar-wrap.has-avatar {
  background-color: transparent;
}

.organizer-avatar {
  width: 100%;
  height: 100%;
}

.organizer-avatar-fallback {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--activity-primary);
}

.organizer-avatar-letter {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--text-on-primary);
  line-height: 1;
  letter-spacing: 0;
}

.organizer-name {
  font-size: 24rpx;
  color: var(--text-secondary);
  max-width: 200rpx;
  flex: 1;
  font-weight: 400;
  letter-spacing: 0.02em;
}

/* ===== 报名按钮 ===== */
.join-button {
  padding: 14rpx 32rpx;
  background: var(--gradient-primary);
  border-radius: var(--zy-radius-pill);
  min-width: 132rpx;
  text-align: center;
  transition: transform 280ms cubic-bezier(0.25,0.1,0.25,1),
              box-shadow 280ms cubic-bezier(0.25,0.1,0.25,1),
              opacity 280ms cubic-bezier(0.25,0.1,0.25,1);
  box-shadow: var(--shadow-glow-primary-btn);
}

.join-button--pressed {
  transform: scale(0.97);
  box-shadow: var(--shadow-glow-primary-xs);
}

.join-button-text {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-on-primary);
  letter-spacing: 0.08em;
}

/* ===== 已参加徽章 ===== */
.joined-badge {
  padding: 14rpx 32rpx;
  background-color: var(--success-color);
  border-radius: var(--zy-radius-pill);
  min-width: 132rpx;
  text-align: center;
}

.ended-badge {
  background-color: var(--text-tertiary);
}

.stopped-badge {
  background-color: var(--brand-red);
}

.joined-badge-text {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-on-primary);
  letter-spacing: 0.08em;
}

/* ===== 卡片底部装饰线 ===== */
.activity-accent {
  position: absolute;
  bottom: 0;
  left: var(--zy-space-lg);
  right: var(--zy-space-lg);
  height: 2rpx;
  background: var(--activity-primary);
  opacity: 0.3;
}

/* ===== 空状态（居中、奶油底、宽字距标签） ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx var(--page-padding);
  text-align: center;
  background-color: var(--card-cream);
  margin: var(--zy-space-lg);
  border-radius: var(--zy-radius-lg);
  border: 1rpx solid var(--hairline);
  animation-name: fadeIn;
  animation-duration: 600ms;
  animation-timing-function: cubic-bezier(0.16,1,0.3,1);
  animation-fill-mode: forwards;
}

.empty-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: var(--zy-space-lg);
  opacity: 0.4;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: var(--zy-space-sm);
  display: block;
  letter-spacing: 0.08em;
}

.empty-text {
  font-size: 24rpx;
  color: var(--text-tertiary);
  line-height: 1.6;
  max-width: 480rpx;
  letter-spacing: 0.06em;
  font-weight: 400;
}

/* ===== 加载状态 ===== */
.loading-more {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--zy-space-2xl) 0;
  gap: var(--zy-space-sm2);
}

.loading-spinner {
  width: 44rpx;
  height: 44rpx;
  border: 3rpx solid var(--activity-tint);
  border-top-color: var(--activity-primary);
  border-radius: 50%;
  animation-name: spin;
  animation-duration: 800ms;
  animation-timing-function: linear;
  animation-fill-mode: forwards;
  animation-iteration-count: infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 22rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.12em;
  font-weight: 400;
}

/* ===== 我报名的活动提示 ===== */
.joined-hint {
  padding: var(--zy-space-lg);
  text-align: center;
  background-color: var(--card-cream);
  margin: var(--zy-space-sm2) var(--page-padding);
  border-radius: var(--zy-radius-lg);
  border: 1rpx solid var(--hairline);
}

.hint-text {
  font-size: 22rpx;
  color: var(--text-tertiary);
  line-height: 1.5;
  letter-spacing: 0.06em;
  font-weight: 400;
}
