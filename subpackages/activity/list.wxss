/* 响应式设计 */
@media (max-width: 768px) {
  .page-header {
    padding: 32rpx 16rpx 24rpx;
  }
  
  .page-title {
    font-size: 36rpx;
  }
  
  .page-subtitle {
    font-size: 22rpx;
  }
  
  .category-tabs {
    padding: 16rpx;
    gap: 12rpx;
  }
  
  .category-tab {
    padding: 12rpx 24rpx;
    font-size: 24rpx;
  }
  
  .activity-list {
    padding: 16rpx;
    gap: 20rpx;
  }

  .activity-cover-wrapper {
    padding-top: 56.25%;
  }

  .activity-info {
    padding: 24rpx;
  }
  
  .activity-title {
    font-size: 28rpx;
    margin-bottom: 16rpx;
  }
  
  .activity-meta {
    gap: 8rpx;
    margin-bottom: 16rpx;
  }
  
  .meta-item {
    font-size: 20rpx;
  }
  
  .activity-price {
    font-size: 26rpx;
  }
  
  .participants-progress {
    width: 100rpx;
  }
  
  .empty-state {
    padding: 120rpx 0;
  }
  
  .empty-icon {
    font-size: 100rpx;
  }
  
  .empty-title {
    font-size: 28rpx;
  }
  
  .empty-text {
    font-size: 22rpx;
  }
}

@media (min-width: 769px) {
  .activity-list {
    padding: 32rpx;
    gap: 32rpx;
  }

  .activity-cover-wrapper {
    padding-top: 56.25%;
  }

  .activity-info {
    padding: 36rpx;
  }
  
  .activity-title {
    font-size: 34rpx;
  }
  
  .activity-meta {
    gap: 16rpx;
  }
  
  .meta-item {
    font-size: 24rpx;
  }
  
  .activity-price {
    font-size: 32rpx;
  }
  
  .participants-progress {
    width: 140rpx;
  }
}

/* 我报名的活动提示 */
.joined-hint {
  padding: 24rpx;
  text-align: center;
  background-color: #f8f9fa;
  margin: 20rpx 24rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.hint-text {
  font-size: 22rpx;
  color: var(--text-tertiary);
  line-height: 1.4;
}

