/* 全局样式 */
:root {
  --primary-color: var(--activity-primary);
  --primary-dark: var(--activity-secondary);
  --text-primary: var(--text-primary);
  --text-secondary: var(--text-secondary);
  --text-light: var(--gray-500);
  --background-light: var(--background-color);
  --background-white: var(--card-color);
  --accent-color: var(--tuan-primary);
  --success-color: #4CAF50;
  --border-radius: 20rpx;
  --shadow-sm: 0 2rpx 8rpx rgba(0,0,0,0.04);
  --shadow-md: 0 4rpx 16rpx rgba(0,0,0,0.08);
  --shadow-lg: 0 8rpx 32rpx rgba(79, 94, 53, 0.15);
}

.page-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #f8f9fa 0%, var(--background-color) 100%);
  position: relative;
  overflow-x: hidden;
}

.page-container::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4px;
  background: linear-gradient(90deg, var(--primary-color) 0%, var(--primary-dark) 100%);
  border-radius: 2px;
}

/* 顶部品牌栏 */
.page-header {
  padding: 48rpx 24rpx 32rpx;
  text-align: center;
  position: relative;
  z-index: 2;
}

.page-title {
  font-family: 'PingFang SC', 'Helvetica Neue', Arial, sans-serif;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 8rpx;
  letter-spacing: 2rpx;
  display: block;
}

.page-subtitle {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 400;
  letter-spacing: 1rpx;
  display: block;
}

/* 分类标签栏 */
.category-tabs {
  display: flex;
  padding: 20rpx 20rpx 12rpx;
  gap: 12rpx;
  flex-wrap: wrap;
  justify-content: flex-start;
  background: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(10rpx);
  position: sticky;
  top: 0;
  z-index: 10;
  border-bottom: 1rpx solid rgba(79, 94, 53, 0.1);
}

.category-tab {
  padding: 14rpx 24rpx;
  border-radius: 36rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  background: rgba(245, 245, 247, 0.8);
  border: 1rpx solid rgba(79, 94, 53, 0.1);
  position: relative;
  overflow: hidden;
  z-index: 1;
  flex: 0 1 auto;
  min-width: fit-content;
  box-sizing: border-box;
  display: inline-block;
}

.category-tab::before {
  content: '';
  position: absolute;
  top: 0;
  left: -120rpx;
  width: 120rpx;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(79, 94, 53, 0.3), transparent);
  opacity: 0;
  z-index: -1;
  pointer-events: none;
  border-radius: 36rpx;
}

.category-tab.active {
  background: linear-gradient(135deg, var(--activity-secondary), #00796B);
  color: var(--card-color) !important;
  font-weight: 600;
  box-shadow: var(--shadow-md);
  border-color: var(--activity-secondary);
  position: relative;
  z-index: 10;
  overflow: visible;
}

.category-tab.active .category-tab-text {
  position: relative;
  z-index: 20;
  color: var(--card-color) !important;
  display: inline-block;
  text-shadow: 0 1rpx 2rpx rgba(0,0,0,0.3);
  font-weight: 600;
  letter-spacing: 1rpx;
}

.category-tab-text {
  position: relative;
  z-index: 10;
  display: inline-block;
}

/* 活动列表 */
.activity-list {
  padding: 24rpx;
  display: grid;
  grid-template-columns: 1fr;
  gap: 28rpx;
}

/* 活动卡片 */
.activity-card {
  position: relative;
  border-radius: var(--border-radius);
  overflow: hidden;
  background: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(10rpx);
  box-shadow: var(--shadow-sm);
  border: 1rpx solid rgba(79, 94, 53, 0.1);
}

.activity-card:nth-child(1) {
}

.activity-card:nth-child(2) {
}

.activity-card:nth-child(3) {
}

.activity-card-background {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: radial-gradient(circle at 30% 30%, rgba(79, 94, 53, 0.1) 0%, transparent 70%);
  z-index: 1;
}

.activity-card-content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  width: 100%;
}

.activity-cover-wrapper {
  position: relative;
  width: 100%;
  padding-top: 56.25%; /* 16:9 比例 = 9/16 * 100% */
  overflow: hidden;
}

.activity-cover {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: var(--border-radius) var(--border-radius) 0 0;
  object-fit: cover;
}

.activity-info {
  padding: 32rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: visible;
}

.activity-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.activity-title {
  font-family: 'PingFang SC', 'Helvetica Neue', Arial, sans-serif;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.4;
  flex: 1;
  min-width: 0;
}

.activity-meta {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
  flex-wrap: wrap;
}

.meta-item-right {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.meta-item-right .meta-text {
  flex: 1;
  min-width: 0;
}

.meta-text {
  flex: 1;
  line-height: 1.4;
  white-space: normal;
  word-break: break-word;
}

.meta-icon {
  width: 24rpx;
  height: 24rpx;
  flex-shrink: 0;
  display: block;
  align-self: center;
  fill: currentColor;
}

.meta-icon {
  width: 24rpx;
  height: 24rpx;
  flex-shrink: 0;
  display: block;
  align-self: center;
  fill: currentColor;
}

.meta-text {
  flex: 1;
  line-height: 1.4;
}

.activity-price {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--accent-color);
  line-height: 1.2;
}

.activity-price.free {
  color: var(--success-color);
}

.activity-participants {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
  flex-shrink: 0;
}

.participants-text {
  font-size: 20rpx;
  color: var(--text-secondary);
  font-weight: 500;
  white-space: nowrap;
}

.participants-progress {
  width: 60rpx;
  height: 5rpx;
  background: rgba(79, 94, 53, 0.1);
  border-radius: 2.5rpx;
  overflow: hidden;
  position: relative;
}

.progress-bar {
  height: 100%;
  background: linear-gradient(90deg, var(--primary-color), var(--primary-dark));
  border-radius: 4rpx;
  position: relative;
}

.progress-bar::after {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 20rpx;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.6));
}

.activity-organizer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(79, 94, 53, 0.1);
}

.organizer-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.organizer-avatar-wrap {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  background: linear-gradient(135deg, #e0e0e0, #bdbdbd);
}

.organizer-avatar-wrap.has-avatar {
  background: transparent;
}

.organizer-avatar {
  width: 100%;
  height: 100%;
}

.organizer-avatar-fallback {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--activity-primary), var(--activity-primary-mid));
}

.organizer-avatar-letter {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--card-color);
  line-height: 1;
}

.organizer-name {
  font-size: 26rpx;
  color: var(--text-secondary);
  max-width: 200rpx;
  flex: 1;
}

.join-button {
  padding: 12rpx 32rpx;
  background: linear-gradient(135deg, var(--activity-primary), var(--activity-secondary));
  border-radius: 24rpx;
  box-shadow: var(--shadow-sm);
  min-width: 120rpx;
  text-align: center;
}

.join-button-text {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--card-color) !important;
  text-shadow: 0 1rpx 2rpx rgba(0,0,0,0.2);
}

/* 已参加徽章 */
.joined-badge {
  padding: 12rpx 32rpx;
  background: linear-gradient(135deg, #4CAF50, #2E7D32);
  border-radius: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(76, 175, 80, 0.3);
  min-width: 120rpx;
  text-align: center;
}

.ended-badge {
  background: linear-gradient(135deg, #9E9E9E, #616161);
  box-shadow: 0 2rpx 8rpx rgba(158, 158, 158, 0.3);
}

.stopped-badge {
  background: linear-gradient(135deg, #FF9800, #F57C00);
  box-shadow: 0 2rpx 8rpx rgba(255, 152, 0, 0.3);
}

.joined-badge-text {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--card-color) !important;
  text-shadow: 0 1rpx 2rpx rgba(0,0,0,0.2);
}

.activity-accent {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, var(--primary-color), var(--primary-dark));
  border-radius: 0 0 var(--border-radius) var(--border-radius);
  opacity: 0.6;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0;
  text-align: center;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
  display: block;
}

.empty-text {
  font-size: 24rpx;
  color: var(--text-light);
  line-height: 1.5;
  max-width: 600rpx;
}

/* 加载状态 */
.loading-more {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 64rpx 0;
  gap: 16rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(79, 94, 53, 0.2);
  border-top: 4rpx solid var(--primary-color);
  border-radius: 50%;
}

.loading-text {
  font-size: 24rpx;
  color: var(--text-light);
}

