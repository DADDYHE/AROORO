@import '../../styles/loading-animation.wxss';

.payment-page {
  min-height: 100vh;
  background: var(--background-color);
  padding-bottom: 100rpx;
}

.loading-dot:nth-child(2) {
}

.loading-dot:nth-child(3) {
}

.status-header {
  padding: 48rpx 32rpx 32rpx;
  background: var(--card-color);
  text-align: center;
}

.status-header.status-pending_payment {
  background: linear-gradient(180deg, #fff8e1 0%, #fff 100%);
}

.status-header.status-confirmed {
  background: linear-gradient(180deg, #e0f5f3 0%, #fff 100%);
}

.status-header.status-cancelled {
  background: linear-gradient(180deg, #fce4ec 0%, #fff 100%);
}

.status-icon {
  font-size: 64rpx;
  display: block;
  margin-bottom: 16rpx;
}

.status-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 8rpx;
}

.status-subtitle {
  font-size: 26rpx;
  color: var(--text-secondary);
  display: block;
}

.payment-header {
  padding: 32rpx;
  background: var(--card-color);
}

.payment-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.order-card {
  margin: 24rpx 32rpx;
  background: var(--card-color);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.activity-info {
  display: flex;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.activity-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  margin-right: 24rpx;
  background: linear-gradient(135deg, #e0f2f1 0%, #EAEDDF 100%);
}

.activity-details {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.activity-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.activity-time {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 4rpx;
}

.activity-location {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.order-details {
  padding: 24rpx;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.detail-label {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.detail-value {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
  max-width: 400rpx;
  text-align: right;
  word-break: break-all;
}

.detail-value.discount {
  color: var(--activity-primary);
}

.price-card {
  margin: 24rpx 32rpx;
  background: var(--card-color);
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.price-row.total {
  border-top: 1rpx solid #f0f0f0;
  padding-top: 20rpx;
  margin-top: 8rpx;
}

.price-label {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.price-value {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.price-value.discount {
  color: var(--activity-primary);
}

.price-value.final {
  font-size: 40rpx;
  color: var(--activity-primary);
}

.expired-tip {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: var(--card-color);
  box-shadow: 0 -2rpx 16rpx rgba(0, 0, 0, 0.05);
  text-align: center;
}

.expired-text {
  font-size: 28rpx;
  color: var(--text-tertiary);
}

.pay-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: var(--card-color);
  box-shadow: 0 -2rpx 16rpx rgba(0, 0, 0, 0.05);
}

.pay-btn {
  background: linear-gradient(135deg, var(--activity-primary) 0%, var(--activity-primary-mid) 100%);
  border: none;
  border-radius: 16rpx;
  padding: 24rpx 0;
  box-shadow: 0 4rpx 12rpx rgba(79, 94, 53, 0.3);
}

.pay-btn::after {
  border: none;
}

.pay-btn[disabled] {
  background: var(--border-color);
  box-shadow: none;
}

.pay-btn-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #FAFAF6;
}
