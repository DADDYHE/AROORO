<zy-navbar title="" transparent color="#F7F5EF" />
<scroll-view
  scroll-y
  enhanced
  refresher-enabled="{{true}}"
  refresher-triggered="{{_refresherTriggered}}"
  bindrefresherrefresh="_onRefresherRefresh"
  bindscrolltolower="_onScrollToLower"
  bindscroll="_onScroll"
  lower-threshold="100"
  style="height: 100vh;"
>
<view class="page-container" wx:if="{{product}}">
  <login-prompt visible="{{showLoginPrompt}}" bind:close="onLoginPromptClose" />
  <!-- 深绿沉浸画廊（B · 精品橱窗式） -->
  <view class="image-gallery">
    <swiper class="gallery-swiper" current="{{currentImageIndex}}" bindchange="onImageChange">
      <swiper-item wx:for="{{product.images || [product.coverUrl || product.coverImage]}}" wx:key="index">
        <view wx:if="{{index === 0}}" class="gallery-image-share">
          <image class="gallery-image" src="{{item}}" mode="aspectFill" lazy-load data-url="{{item}}" bindtap="onPreviewGalleryImage" binderror="onCloudImageError" data-src="{{item}}" data-path="product.images[{{index}}]" />
        </view>
        <image wx:else class="gallery-image" src="{{item}}" mode="aspectFill" lazy-load data-url="{{item}}" bindtap="onPreviewGalleryImage" binderror="onCloudImageError" data-src="{{item}}" data-path="product.images[{{index}}]" />
      </swiper-item>
    </swiper>
    <!-- 顶部 scrim（沉浸白箭头在浅色商品图上保持可读） -->
    <view class="gallery-top-scrim"></view>
    <!-- 纸牌徽章 -->
    <view class="gallery-badge" style="top: {{_navbarHeight + 16}}px;">
      <text class="badge-tag featured" wx:if="{{product.isFeatured}}">推荐</text>
    </view>
    <!-- 分享 -->
    <view class="gallery-actions" style="top: {{_navbarHeight + 16}}px;">
      <view class="gallery-action-btn" hover-class="gallery-action-btn--pressed" hover-stay-time="120" bindtap="onShare">
        <image class="gallery-action-icon" src="{{iconShare}}" mode="aspectFit" binderror="onCloudImageError" data-src="{{iconShare}}" data-path="iconShare" />
      </view>
    </view>
    <!-- 品牌字标层 -->
    <view class="gallery-brand">
      <text class="gallery-brand-eyebrow">AROORO ATELIER</text>
      <view class="gallery-brand-line"></view>
    </view>
    <!-- 页码 -->
    <view class="gallery-page">{{currentImageIndex + 1 < 10 ? '0' + (currentImageIndex + 1) : currentImageIndex + 1}} / {{product.images.length < 10 ? '0' + product.images.length : product.images.length}}</view>
    <!-- 指示器 -->
    <view class="gallery-indicator" wx:if="{{product.images.length > 1}}">
      <view wx:for="{{product.images}}" wx:key="index"
        class="indicator-dot {{currentImageIndex === index ? 'active' : ''}}"></view>
    </view>
  </view>

  <!-- 纸面流内容区（A · 编辑杂志式） -->
  <view class="page-content">
    <!-- 商品信息区（纸面 · 孤品价签） -->
    <view class="product-info-section">
      <view class="section-label">
        <view class="label-accent"></view>
        <text>AROORO · MALL</text>
      </view>
      <text class="info-name">{{product.name}}</text>
      <text class="info-subtitle" wx:if="{{product.subTitle}}">{{product.subTitle}}</text>
      <view class="info-divider"></view>
      <view class="info-price-row">
        <text class="info-price">{{displayPrice}}</text>
        <text class="info-original" wx:if="{{displayOriginalPrice}}">{{displayOriginalPrice}}</text>
      </view>
    </view>

    <!-- 商品详情分节 -->
    <view class="details-section">
      <view class="section-label">
        <view class="label-accent"></view>
        <text>商品详情</text>
      </view>
      <text class="description-text" wx:if="{{product.description}}">{{product.description}}</text>
      <view class="detail-images" wx:if="{{product.detailImages && product.detailImages.length > 0}}">
        <image wx:for="{{product.detailImages}}" wx:key="index"
          class="detail-image" src="{{item}}" mode="widthFix" lazy-load data-url="{{item}}" bindtap="onPreviewDetailImage" binderror="onCloudImageError" data-src="{{item}}" data-path="product.detailImages[{{index}}]" />
      </view>
    </view>

    <!-- 品牌页脚 -->
    <view class="brand-footer">
      <view class="footer-gold-line"></view>
      <text class="footer-brand">AROORO</text>
      <text class="footer-tagline">安心呼噜 · 放心托付</text>
    </view>
  </view>

  <!-- 底部操作栏（纸感条） -->
  <root-portal>
  <view class="bottom-bar">
    <view class="bar-actions">
      <view class="bar-action-item contact-wrap">
        <image class="bar-action-icon-img" src="{{iconService}}" mode="aspectFit" />
        <text class="bar-action-text">客服</text>
        <button class="contact-overlay" open-type="contact"></button>
      </view>
      <view class="bar-action-item" bindtap="onOpenCart">
        <image class="bar-action-icon-img" src="{{iconShoppingCart}}" mode="aspectFit" binderror="onCloudImageError" data-src="{{iconShoppingCart}}" data-path="iconShoppingCart" />
        <text class="bar-action-text">购物车</text>
        <view class="cart-badge" wx:if="{{cartCount > 0}}">{{cartCount > 99 ? '99+' : cartCount}}</view>
      </view>
    </view>
    <view class="buy-buttons">
      <view class="cart-btn" hover-class="cart-btn--pressed" hover-stay-time="120" bindtap="onAddToCart">加入购物车</view>
      <view class="buy-btn" hover-class="buy-btn--pressed" hover-stay-time="120" bindtap="onBuyNow">立即购买</view>
    </view>
  </view>
  </root-portal>
</view>

<!-- 规格选择弹窗（选品台） -->
<root-portal>
<view class="sku-popup-mask {{skuPopupVisible ? 'show' : ''}}" bindtap="onCloseSkuPopup"></view>
<view class="sku-popup {{skuPopupVisible ? 'show' : ''}}">
  <view class="sku-popup-close-btn popup-stagger" hover-class="sku-popup-close-btn--pressed" hover-stay-time="120" bindtap="onCloseSkuPopup"><image class="sku-popup-close-icon" src="/images/icons/close-luxury-line.svg" mode="aspectFit"></image></view>

  <view class="sku-popup-image-wrap popup-stagger">
    <image class="sku-popup-image" src="{{skuPopupImage || product.coverUrl || product.coverImage}}" mode="aspectFill" binderror="onCloudImageError" data-src="{{skuPopupImage || product.coverUrl || product.coverImage}}" data-path="product.coverUrl" lazy-load />
  </view>

  <scroll-view class="sku-popup-body popup-stagger" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="sku-popup-body-inner">
      <view class="sku-product-info">
        <text class="sku-product-name">{{product.name}}</text>
        <view class="sku-product-meta">
          <text class="sku-product-price">{{skuPopupPrice}}</text>
          <text class="sku-product-stock">库存 {{skuPopupStock}}件</text>
        </view>
        <text class="sku-product-selected" wx:if="{{selectedSkuText}}">已选: {{selectedSkuText}}</text>
      </view>

      <view class="sku-spec-section" wx:for="{{popupSpecGroups}}" wx:key="specId">
        <view class="sku-spec-label">
          <view class="label-accent"></view>
          <text>{{item.name}}</text>
        </view>
        <view class="sku-spec-options">
          <view wx:for="{{item.values}}" wx:for-item="val" wx:key="*this"
            class="sku-spec-option {{item.selectedValue === val ? 'selected' : ''}} {{item.disabledValues && item.disabledValues[val] ? 'disabled' : ''}}"
            hover-class="sku-spec-option--pressed" hover-stay-time="80"
            data-spec-id="{{item.specId}}" data-value="{{val}}" bindtap="onPopupSelectSpec">
            <text class="sku-spec-option-text">{{val}}</text>
          </view>
        </view>
      </view>

      <view class="sku-quantity-section">
        <view class="sku-spec-label">
          <view class="label-accent"></view>
          <text>数量</text>
        </view>
        <view class="sku-quantity-row">
          <view class="sku-qty-btn {{quantity <= 1 ? 'disabled' : ''}}" hover-class="sku-qty-btn--pressed" hover-stay-time="80" bindtap="onChangeQuantity" data-type="minus">−</view>
          <text class="sku-qty-value">{{quantity}}</text>
          <view class="sku-qty-btn" hover-class="sku-qty-btn--pressed" hover-stay-time="80" bindtap="onChangeQuantity" data-type="plus">+</view>
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="sku-popup-footer popup-stagger">
    <view class="sku-confirm-btn {{!allSpecsSelected ? 'disabled' : ''}}" hover-class="sku-confirm-btn--pressed" hover-stay-time="120" bindtap="onSkuConfirm">
      {{!allSpecsSelected ? '请选择完整规格' : (skuPopupMode === 'cart' ? '加入购物车' : '立即购买')}}
    </view>
  </view>
</view>
</root-portal>

<!-- 加载状态 -->
<view wx:if="{{isLoading}}" class="loading-container">
  <view class="loading-content">
    <view class="lux-cascade">
  <view class="lux-cascade-dot" style="left: 20rpx; background: #C9A24B; animation-delay: 0ms;"></view>
  <view class="lux-cascade-dot" style="left: 36rpx; background: #A8894A; animation-delay: 150ms;"></view>
  <view class="lux-cascade-dot" style="left: 52rpx; background: #C9A24B; animation-delay: 300ms;"></view>
  <view class="lux-cascade-dot" style="left: 68rpx; background: #A8894A; animation-delay: 450ms;"></view>
  <view class="lux-cascade-dot" style="left: 84rpx; background: #C9A24B; animation-delay: 600ms;"></view>
  <view class="lux-cascade-dot" style="left: 100rpx; background: #A8894A; animation-delay: 750ms;"></view>
  <view class="lux-cascade-dot" style="left: 48rpx; background: #C9A24B; animation-delay: 900ms;"></view>

    </view>
    <text class="loading-text">加载中</text>
  </view>
</view>

<!-- 错误状态 -->
<view class="error-container" wx:if="{{error}}">
  <image class="error-icon" src="/images/icons/error-luxury-line.svg" mode="aspectFit"></image>
  <text class="error-text">{{error}}</text>
  <view class="retry-btn" hover-class="retry-btn--pressed" hover-stay-time="120" bindtap="onRetry">RETRY</view>
</view>
</scroll-view>
