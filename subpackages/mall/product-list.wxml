<zy-navbar title="" transparent color="#F7F5EF" />
<!-- ⚠ 双栏购物页：hero 固定在双栏之外不随内容滚动，导航栏恒在深绿上，无需 solid 实底切换 -->
<view class="page-container">
  <login-prompt visible="{{showLoginPrompt}}" bind:close="onLoginPromptClose" />
  <!-- B · 深绿沉浸标题版（双栏购物页紧凑 hero） -->
  <view class="lux-hero lux-hero--compact" style="padding-top: calc({{_navbarHeight}}px + 16rpx);">
    <text class="lux-hero-eyebrow">MALL</text>
    <text class="lux-hero-title">商品列表</text>
    <view class="lux-hero-sealline"></view>
  </view>
  <view class="main-body">
    <scroll-view class="category-sidebar" scroll-y="true" show-scrollbar="false">
      <block wx:for="{{categories}}" wx:key="key">
        <view class="cat-group">
          <view class="cat-item {{currentCategory === item.key ? 'active' : ''}}" data-key="{{item.key}}" hover-class="cat-item--pressed" hover-stay-time="80" bindtap="onCategoryTap">
            <text>{{item.label}}</text>
            <image class="cat-arrow {{expandedCategory === item.key ? 'expanded' : ''}}" src="/images/icons/chevron-down-luxury-line.svg" mode="aspectFit"></image>
          </view>
          <view wx:if="{{expandedCategory === item.key && item.subcats && item.subcats.length > 0}}" class="subcat-list">
            <view wx:for="{{item.subcats}}" wx:for-item="sub" wx:key="key" class="subcat-item {{currentSubCategory === sub.key ? 'active' : ''}}" data-key="{{sub.key}}" hover-class="subcat-item--pressed" hover-stay-time="80" bindtap="onSubCategoryTap">
              <text>{{sub.label}}</text>
            </view>
          </view>
        </view>
      </block>
    </scroll-view>
    <scroll-view
      class="content-area"
      scroll-y
      enhanced
      refresher-enabled="{{true}}"
      refresher-triggered="{{_refresherTriggered}}"
      bindrefresherrefresh="_onRefresherRefresh"
      bindscrolltolower="_onScrollToLower"
      lower-threshold="100"
    >
      <view class="category-header">
        <view class="category-header-inner">
          <view class="label-accent"></view>
          <text class="category-name">{{currentCategoryLabel}}</text>
          <view class="label-accent"></view>
          <text wx:if="{{currentSubCategoryLabel}}" class="subcat-label">{{currentSubCategoryLabel}}</text>
        </view>
      </view>
      <view class="content-divider"></view>
      <zy-skeleton wx:if="{{isLoading && currentProducts.length === 0}}" type="grid" count="{{6}}" />
      <view class="product-grid">
        <view wx:for="{{currentProducts}}" wx:key="_id" class="product-card" data-id="{{item._id}}" hover-class="product-card--pressed" hover-stay-time="80" bindtap="onProductTap">
          <view class="product-img-wrap">
            <image lazy-load class="product-img" src="{{item.coverUrl}}" mode="aspectFit" binderror="onCloudImageError" data-src="{{item.coverUrl}}" data-path="currentProducts[{{index}}].coverUrl" />
          </view>
          <view class="product-label">{{item.name}}</view>
          <view class="product-price-row">
            <text class="product-price">¥{{item.minPrice || item.price}}</text>
            <text wx:if="{{item.priceFrom}}" class="product-price-from">起</text>
          </view>
        </view>
      </view>
      <view class="view-more" hover-class="view-more--pressed" hover-stay-time="120" bindtap="onViewMore">
        <view class="view-more-inner">
          <text class="view-more-inner-text">查看更多</text>
        </view>
      </view>
    </scroll-view>
  </view>
</view>

<!-- 可拖动悬浮购物车：页面根级 fixed，不依赖 root-portal（避免页面返回时 portal 独立 webview 已被销毁导致的 routeDone / navigateBack webviewId 报错） -->
<view class="floating-cart {{cartPosReady ? 'is-ready' : ''}} {{cartDragging ? 'is-dragging' : ''}}"
      style="transform: translate({{cartPos.x}}px, {{cartPos.y}}px);"
      hover-class="floating-cart--pressed" hover-stay-time="120"
      bindtouchstart="onCartTouchStart"
      bindtouchmove="onCartTouchMove"
      bindtouchend="onCartTouchEnd">
  <image class="floating-cart-icon" src="/images/icons/cart-ink.svg" mode="aspectFit"></image>
  <view wx:if="{{cartCount > 0}}" class="floating-cart-badge">
    <text class="floating-cart-badge-text">{{cartCount > 99 ? '99+' : cartCount}}</text>
  </view>
</view>
