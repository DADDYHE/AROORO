.page-container {
  min-height: 100vh;
  background-color: #ffffff;
  display: flex;
  flex-direction: column;
}

.page-divider {
  height: 2rpx;
  background-color: #333333;
  flex-shrink: 0;
}

.top-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 30rpx;
  background-color: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
  position: sticky;
  top: 0;
  z-index: 100;
}

.nav-left, .nav-right {
  display: flex;
  align-items: center;
  gap: 24rpx;
  width: 120rpx;
}

.nav-left {
  justify-content: flex-start;
}

.nav-right {
  justify-content: flex-end;
}

.nav-icon {
  width: 36rpx;
  height: 36rpx;
  opacity: 0.8;
  transition: opacity 0.2s ease;
}

.nav-icon:active {
  opacity: 0.6;
}

.nav-bell {
  position: relative;
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bell-dot {
  width: 8rpx;
  height: 8rpx;
  background-color: #4ECDC4;
  border-radius: 50%;
  position: absolute;
  top: 0;
  right: 0;
}

.nav-more {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3rpx;
  opacity: 0.8;
  transition: opacity 0.2s ease;
}

.nav-more:active {
  opacity: 0.6;
}

.nav-more::before,
.nav-more::after {
  content: '';
  display: block;
  width: 4rpx;
  height: 4rpx;
  background-color: #1d1d1f;
  border-radius: 50%;
}

.nav-user {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #4ECDC4;
  border-radius: 50%;
  opacity: 0.8;
  transition: opacity 0.2s ease;
}

.nav-user:active {
  opacity: 0.6;
}

.brand-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1d1d1f;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}

.main-body {
  flex: 1;
  display: flex;
  overflow: hidden;
}

.category-sidebar {
  width: 200rpx;
  background-color: #f5f5f5;
  flex-shrink: 0;
  height: 100%;
  border-right: 1rpx solid #e0e0e0;
}

.cat-group {
  border-bottom: 1rpx solid #e0e0e0;
}

.cat-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 94rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: #333333;
  background-color: #f5f5f5;
  box-sizing: border-box;
  transition: all 0.2s ease;
  border-left: 4rpx solid transparent;
}

.cat-item:active {
  background-color: #e8e8e8;
}

.cat-item.active {
  background-color: #333333;
  color: #ffffff;
  font-weight: 600;
  border-left-color: #333333;
}

.cat-arrow {
  font-size: 20rpx;
  transition: transform 0.2s ease;
  margin-left: 8rpx;
  color: #666666;
}

.subcat-list {
  background-color: #e8e8e8;
}

.subcat-item {
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 0 30rpx 0 40rpx;
  font-size: 22rpx;
  color: #666666;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.subcat-item:active {
  background-color: #d8d8d8;
}

.subcat-item.active {
  background-color: #333333;
  color: #ffffff;
  font-weight: 500;
}

.content-area {
  flex: 1;
  overflow-y: auto;
  background-color: #f5f5f7;
  padding-bottom: 40rpx;
}

.category-header {
  padding: 30rpx 0;
  text-align: center;
  background-color: #ffffff;
  margin-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.category-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #1d1d1f;
  letter-spacing: 2rpx;
}

.subcat-label {
  font-size: 24rpx;
  color: #999999;
  font-weight: normal;
}

.content-divider {
  height: 2rpx;
  background-color: #333333;
}

.product-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  padding: 0 16rpx;
}

.product-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx;
  background-color: #ffffff;
  border-radius: 12rpx;
  box-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.05);
  transition: all 0.2s ease;
  margin-bottom: 0;
  border: none;
  overflow: hidden;
}

.product-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.product-img {
  width: 100%;
  height: 240rpx;
  margin-bottom: 8rpx;
  border-radius: 8rpx;
  background-color: #f8f8f8;
}

.product-label {
  font-size: 24rpx;
  color: #1d1d1f;
  text-align: center;
  line-height: 1.4;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  width: 100%;
}

.product-price-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 8rpx;
  margin-top: 4rpx;
}

.product-price {
  font-size: 28rpx;
  color: #ff3b30;
  font-weight: 600;
}

.product-original-price {
  font-size: 20rpx;
  color: #999;
  text-decoration: line-through;
}

.view-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx 0;
  margin-top: 24rpx;
  margin-bottom: 24rpx;
}

.view-more text {
  font-size: 26rpx;
  color: #4ECDC4;
  font-weight: 500;
  letter-spacing: 2rpx;
  transition: opacity 0.2s ease;
}

.view-more:active {
  opacity: 0.6;
}

.floating-cart {
  position: fixed;
  right: 32rpx;
  bottom: 180rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4ECDC4 0%, #2AB7A9 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(78, 205, 196, 0.4);
  z-index: 999;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.floating-cart:active {
  transform: scale(0.92);
  box-shadow: 0 4rpx 12rpx rgba(78, 205, 196, 0.3);
}

.floating-cart-icon {
  font-size: 40rpx;
  line-height: 1;
}

.floating-cart-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 32rpx;
  height: 32rpx;
  border-radius: 16rpx;
  background-color: #ff3b30;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
}

.floating-cart-badge-text {
  font-size: 20rpx;
  color: #ffffff;
  font-weight: 600;
  line-height: 1;
}
