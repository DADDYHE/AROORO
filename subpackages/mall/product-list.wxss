.page-container {
  min-height: 100vh;
  background-color: var(--card-color);
  display: flex;
  flex-direction: column;
}

.page-divider {
  height: 2rpx;
  background-color: var(--text-primary);
  flex-shrink: 0;
}

.top-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 30rpx;
  background-color: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
  position: sticky;
  top: 0;
  z-index: 100;
}

.nav-left, .nav-right {
  display: flex;
  align-items: center;
  gap: 24rpx;
  width: 120rpx;
}

.nav-left {
  justify-content: flex-start;
}

.nav-right {
  justify-content: flex-end;
}

.nav-icon {
  width: 36rpx;
  height: 36rpx;
  opacity: 0.8;
}

.nav-bell {
  position: relative;
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bell-dot {
  width: 8rpx;
  height: 8rpx;
  background-color: var(--activity-primary);
  border-radius: 50%;
  position: absolute;
  top: 0;
  right: 0;
}

.nav-more {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3rpx;
  opacity: 0.8;
}

.nav-more::before,
.nav-more::after {
  content: '';
  display: block;
  width: 4rpx;
  height: 4rpx;
  background-color: var(--text-primary);
  border-radius: 50%;
}

.nav-user {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid var(--activity-primary);
  border-radius: 50%;
  opacity: 0.8;
}

.brand-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: 4rpx;
  text-transform: uppercase;
}

.main-body {
  flex: 1;
  display: flex;
  overflow: hidden;
}

.category-sidebar {
  width: 200rpx;
  background-color: var(--background-color);
  flex-shrink: 0;
  height: 100%;
  border-right: 1rpx solid #e0e0e0;
}

.cat-group {
  border-bottom: 1rpx solid #e0e0e0;
}

.cat-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 94rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: var(--text-primary);
  background-color: var(--background-color);
  box-sizing: border-box;
  border-left: 4rpx solid transparent;
}

.cat-item.active {
  background-color: var(--text-primary);
  color: var(--card-color);
  font-weight: 600;
  border-left-color: var(--text-primary);
}

.cat-arrow {
  font-size: 20rpx;
  margin-left: 8rpx;
  color: var(--gray-700);
}

.subcat-list {
  background-color: var(--border-color);
}

.subcat-item {
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 0 30rpx 0 40rpx;
  font-size: 22rpx;
  color: var(--gray-700);
  box-sizing: border-box;
}

.subcat-item.active {
  background-color: var(--text-primary);
  color: var(--card-color);
  font-weight: 500;
}

.content-area {
  flex: 1;
  overflow-y: auto;
  background-color: var(--background-color);
  padding-bottom: 40rpx;
}

.category-header {
  padding: 30rpx 0;
  text-align: center;
  background-color: var(--card-color);
  margin-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.category-name {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: 2rpx;
}

.subcat-label {
  font-size: 24rpx;
  color: var(--text-tertiary);
  font-weight: normal;
}

.content-divider {
  height: 2rpx;
  background-color: var(--text-primary);
}

.product-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  padding: 0 16rpx;
}

.product-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx;
  background-color: var(--card-color);
  border-radius: 12rpx;
  box-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 0;
  border: none;
  overflow: hidden;
}

.product-img {
  width: 100%;
  height: 240rpx;
  margin-bottom: 8rpx;
  border-radius: 8rpx;
  background-color: var(--divider-color);
}

.product-label {
  font-size: 24rpx;
  color: var(--text-primary);
  text-align: center;
  line-height: 1.4;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  width: 100%;
}

.product-price-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 8rpx;
  margin-top: 4rpx;
}

.product-price {
  font-size: 28rpx;
  color: var(--error-color);
  font-weight: 600;
}

.product-original-price {
  font-size: 20rpx;
  color: var(--text-tertiary);
  text-decoration: line-through;
}

.view-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx 0;
  margin-top: 24rpx;
  margin-bottom: 24rpx;
}

.view-more text {
  font-size: 26rpx;
  color: var(--activity-primary);
  font-weight: 500;
  letter-spacing: 2rpx;
}

.floating-cart {
  position: fixed;
  right: 32rpx;
  bottom: 180rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--activity-primary) 0%, var(--activity-primary-mid) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(79, 94, 53, 0.4);
  z-index: 999;
}

.floating-cart-icon {
  font-size: 40rpx;
  line-height: 1;
}

.floating-cart-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 32rpx;
  height: 32rpx;
  border-radius: 16rpx;
  background-color: var(--error-color);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
}

.floating-cart-badge-text {
  font-size: 20rpx;
  color: var(--card-color);
  font-weight: 600;
  line-height: 1;
}
