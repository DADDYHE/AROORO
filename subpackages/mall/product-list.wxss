/* ================================================================
   mall/product-list.wxss · AROORO 商城商品列表 — Haute-Luxury Editorial v2
   板块色：香槟金家族 --mall-primary / --accent-color
   衬线分类标题 + 发丝描边卡片 + 金色价签 + 编辑式双栏
   Skyline 兼容：无 :active / text-transform / backdrop-filter / sticky / 伪元素
   ================================================================ */

/* ===== 入场动画 ===== */
@keyframes fadeInUp {
  0% {
    opacity: 0;
    transform: translateY(24rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeIn {
  0% { opacity: 0; }
  100% { opacity: 1; }
}

/* ===== 页面容器 ===== */
.page-container {
  min-height: 100vh;
  background-color: var(--background-color);
  display: flex;
  flex-direction: column;
}

.page-divider {
  height: 1rpx;
  background-color: var(--hairline);
  flex-shrink: 0;
}

/* ===== 主体双栏布局 ===== */
.main-body {
  flex: 1;
  display: flex;
  overflow: hidden;
}

/* ===== 左侧分类栏（编辑式：奶油底 + 金色竖线高亮） ===== */
.category-sidebar {
  width: 200rpx;
  background-color: var(--card-cream);
  flex-shrink: 0;
  height: 100%;
  border-right: 1rpx solid var(--hairline);
}

.cat-group {
  border-bottom: 1rpx solid var(--hairline);
}

.cat-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 104rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  background-color: transparent;
  box-sizing: border-box;
  border-left: 3rpx solid transparent;
  font-weight: 400;
  letter-spacing: 0.04em;
  font-family: var(--font-sans);
  transition: background-color var(--dur-fast) var(--ease-refined),
              color var(--dur-fast) var(--ease-refined),
              border-color var(--dur-fast) var(--ease-refined);
}

.cat-item--pressed {
  background-color: var(--accent-wash);
}

.cat-item.active {
  background-color: var(--card-color);
  color: var(--text-primary);
  font-weight: 500;
  border-left-color: var(--mall-primary);
}

.cat-arrow {
  width: 20rpx;
  height: 20rpx;
  margin-left: 8rpx;
  flex-shrink: 0;
  transition: transform var(--dur-fast) var(--ease-refined);
}

.cat-arrow.expanded {
  transform: rotate(180deg);
}

.subcat-list {
  background-color: var(--background-color);
}

.subcat-item {
  display: flex;
  align-items: center;
  height: 76rpx;
  padding: 0 30rpx 0 44rpx;
  font-size: 24rpx;
  color: var(--text-tertiary);
  box-sizing: border-box;
  font-weight: 400;
  letter-spacing: 0.04em;
  font-family: var(--font-sans);
  transition: color var(--dur-fast) var(--ease-refined),
              background-color var(--dur-fast) var(--ease-refined);
}

.subcat-item--pressed {
  background-color: var(--accent-wash);
}

.subcat-item.active {
  color: var(--text-primary);
  font-weight: 500;
}

/* ===== 右侧内容区 ===== */
.content-area {
  flex: 1;
  overflow-y: auto;
  background-color: var(--background-color);
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

/* ===== 分类标题（编辑式：衬线大标 + 金色发丝线） ===== */
.category-header {
  padding: 40rpx var(--page-padding) 32rpx;
  text-align: center;
  background-color: var(--card-color);
  margin-bottom: 0;
  border-bottom: 1rpx solid var(--hairline);
  animation-name: fadeInUp;
  animation-duration: 420ms;
  animation-timing-function: cubic-bezier(0.16,1,0.3,1);
  animation-fill-mode: forwards;
}

.category-header-inner {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.label-accent {
  width: 32rpx;
  height: 2rpx;
  background: var(--accent-color);
  flex-shrink: 0;
}

.category-name {
  font-size: 34rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.02em;
  font-family: var(--font-serif);
}

.subcat-label {
  font-size: 24rpx;
  color: var(--text-tertiary);
  font-weight: 400;
  letter-spacing: 0.04em;
  font-family: var(--font-sans);
  margin-left: 8rpx;
}

.content-divider {
  height: 1rpx;
  background-color: var(--hairline);
}

/* ===== 商品网格（编辑式：紧凑两栏 + 交错入场） ===== */
.product-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 0;
  padding: 24rpx 20rpx;
}

.product-grid > .product-card {
  flex: 0 0 50%;
  width: 50%;
  box-sizing: border-box;
  padding: 8rpx;
}

.product-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx;
  background-color: var(--card-color);
  border-radius: var(--lux-radius-card);
  margin-bottom: 0;
  border: 1rpx solid var(--hairline);
  overflow: visible;
  transition: transform var(--dur-fast) var(--ease-refined),
              border-color var(--dur-fast) var(--ease-refined);
  animation-name: fadeInUp;
  animation-duration: 420ms;
  animation-timing-function: cubic-bezier(0.19,1,0.22,1);
  animation-fill-mode: forwards;
}

/* 交错入场延迟 */
.product-card:nth-child(1) { animation-delay: 40ms; }
.product-card:nth-child(2) { animation-delay: 70ms; }
.product-card:nth-child(3) { animation-delay: 110ms; }
.product-card:nth-child(4) { animation-delay: 160ms; }
.product-card:nth-child(5) { animation-delay: 220ms; }
.product-card:nth-child(6) { animation-delay: 110ms; }

.product-card--pressed {
  transform: scale(0.98);
  border-color: rgba(201,162,75,0.30);
}

.product-img-wrap {
  width: 100%;
  height: 200rpx;
  margin-bottom: 16rpx;
  border-radius: var(--zy-radius-md);
  background-color: var(--card-cream);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.product-img {
  width: 100%;
  height: 100%;
}

.product-label {
  font-size: 24rpx;
  color: var(--text-primary);
  text-align: center;
  line-height: 1.4;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  width: 100%;
  letter-spacing: 0.02em;
  font-family: var(--font-serif);
}

.product-price-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 10rpx;
  margin-top: 8rpx;
}

.product-price {
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 500;
  letter-spacing: 0.01em;
  font-family: var(--font-sans);
}

.product-original-price {
  font-size: 20rpx;
  color: var(--text-tertiary);
  text-decoration: line-through;
  font-weight: 400;
}

/* ===== 查看更多（编辑式：发丝描边胶囊 + 金色字距） ===== */
.view-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0 16rpx;
  margin-top: 16rpx;
  animation-name: fadeIn;
  animation-duration: 420ms;
  animation-timing-function: cubic-bezier(0.16,1,0.3,1);
  animation-fill-mode: forwards;
  animation-delay: 220ms;
}

.view-more-inner {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 48rpx;
  border: 1rpx solid var(--hairline);
  border-radius: var(--zy-radius-xs);
  background-color: var(--card-color);
  transition: transform var(--dur-fast) var(--ease-refined),
              background-color var(--dur-fast) var(--ease-refined);
}

.view-more--pressed .view-more-inner {
  transform: scale(0.97);
  background-color: var(--accent-wash);
}

.view-more-inner-text {
  font-size: 24rpx;
  color: var(--text-primary);
  font-weight: 500;
  letter-spacing: 0.15em;
  font-family: var(--font-sans);
}

/* ===== 悬浮购物车（珠宝式金色浮钮 · 可拖动） ===== */
.floating-cart {
  position: fixed;
  left: 0;
  top: 0;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--gradient-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-glow-mall);
  z-index: 999;
  border: 1rpx solid var(--border-inverse-20);
  will-change: transform;
  opacity: 0;
  transition: opacity var(--dur-fast) var(--ease-refined),
              box-shadow var(--dur-fast) var(--ease-refined);
}

.floating-cart.is-ready {
  opacity: 1;
}

.floating-cart--pressed {
  box-shadow: 0 4rpx 14rpx rgba(26,26,23,0.20), 0 0 0 2rpx rgba(201,162,75,0.40);
}

/* 拖动抓取态：珠宝被托起(lift) + 金边收紧 + 金晕增强 —— 不碰 transform 避免与 translate 冲突 */
.floating-cart.is-dragging {
  box-shadow: 0 14rpx 30rpx rgba(26,26,23,0.22),
              0 0 0 1rpx rgba(201,162,75,0.55),
              0 0 38rpx rgba(201,162,75,0.45);
}

.floating-cart-icon {
  width: 40rpx;
  height: 40rpx;
  line-height: 1;
}

.floating-cart-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 32rpx;
  height: 32rpx;
  border-radius: 16rpx;
  background-color: var(--brand-red);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
}

.floating-cart-badge-text {
  font-size: 20rpx;
  color: var(--text-inverse);
  font-weight: 500;
  line-height: 1;
}
