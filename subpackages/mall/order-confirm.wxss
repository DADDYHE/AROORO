page {
  background: #F5F5F7;
}

.page-container {
  min-height: 100vh;
  background: #F5F5F7;
  padding-bottom: 160rpx;
}

/* ── 通用卡片 ── */
.info-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(134, 134, 139, 0.1);
  position: relative;
  overflow: hidden;
}

.info-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: linear-gradient(90deg, #9C27B0 0%, #7B1FA2 50%, transparent 100%);
  border-radius: 24rpx 24rpx 0 0;
}

/* ── 收货地址 ── */
.address-card {
  margin: 24rpx 32rpx;
  margin-bottom: 0;
}

.address-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.address-left {
  flex: 1;
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
}

.address-location-icon {
  font-size: 36rpx;
  margin-top: 2rpx;
  flex-shrink: 0;
}

.address-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.address-user {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.address-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1D1D1F;
}

.address-phone {
  font-size: 26rpx;
  color: #8E8E93;
}

.address-text {
  font-size: 24rpx;
  color: #8E8E93;
  line-height: 1.5;
}

.address-arrow {
  font-size: 36rpx;
  color: #C7C7CC;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.address-empty {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.address-empty-text {
  font-size: 28rpx;
  color: #9C27B0;
  font-weight: 500;
}

/* ── 页面内容区 ── */
.page-content {
  padding: 0 32rpx 24rpx;
}

/* ── 商品信息 ── */
.product-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.product-row + .product-row {
  padding-top: 20rpx;
  border-top: 1rpx solid #F2F2F7;
}

.product-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  background: #E5E5EA;
  flex-shrink: 0;
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 160rpx;
}

.product-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D1D1F;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.product-sku {
  font-size: 22rpx;
  color: #8E8E93;
  margin-top: 4rpx;
}

.product-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.product-price {
  font-size: 32rpx;
  font-weight: 700;
  color: #9C27B0;
}

.product-qty {
  font-size: 24rpx;
  color: #8E8E93;
}

/* ── 数量选择器 ── */
.quantity-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 20rpx;
  border-top: 1rpx solid #F2F2F7;
}

.quantity-label {
  font-size: 28rpx;
  color: #1D1D1F;
  font-weight: 500;
}

.quantity-stepper {
  display: flex;
  align-items: center;
  gap: 0;
  border: 1rpx solid rgba(134, 134, 139, 0.2);
  border-radius: 12rpx;
  overflow: hidden;
}

.stepper-btn {
  width: 64rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #1D1D1F;
  background: #FAFAFA;
  transition: all 0.2s ease;
}

.stepper-btn:active {
  background: rgba(156, 39, 176, 0.08);
}

.stepper-btn.disabled {
  color: #C7C7CC;
}

.stepper-input {
  width: 72rpx;
  height: 56rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #1D1D1F;
  border-left: 1rpx solid rgba(134, 134, 139, 0.2);
  border-right: 1rpx solid rgba(134, 134, 139, 0.2);
}

/* ── 备注 ── */
.remark-row {
  display: flex;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #F2F2F7;
}

.remark-label {
  font-size: 28rpx;
  color: #1D1D1F;
  font-weight: 500;
  width: 80rpx;
  flex-shrink: 0;
}

.remark-input {
  flex: 1;
  font-size: 26rpx;
  color: #1D1D1F;
  text-align: right;
}

/* ── 区块标题 ── */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D1D1F;
  letter-spacing: 1rpx;
}

.section-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.coupon-hint {
  font-size: 24rpx;
  color: #9C27B0;
  font-weight: 500;
}

.section-arrow {
  font-size: 20rpx;
  color: #8E8E93;
}

/* ── 优惠券 ── */
.selected-coupon {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background: linear-gradient(135deg, rgba(156, 39, 176, 0.06) 0%, rgba(123, 31, 162, 0.03) 100%);
  border-radius: 16rpx;
  border: 1rpx solid rgba(156, 39, 176, 0.15);
}

.coupon-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.coupon-name {
  font-size: 26rpx;
  color: #1D1D1F;
  font-weight: 500;
}

.coupon-desc {
  font-size: 28rpx;
  color: #9C27B0;
  font-weight: 700;
}

.remove-coupon {
  font-size: 28rpx;
  color: #C7C7CC;
  padding: 8rpx 16rpx;
}

.coupon-list {
  margin-top: 8rpx;
}

.coupon-item {
  display: flex;
  align-items: center;
  padding: 20rpx 16rpx;
  background: linear-gradient(135deg, #FFFFFF 0%, #FAFAFA 100%);
  border-radius: 16rpx;
  margin-bottom: 12rpx;
  border: 1rpx solid rgba(134, 134, 139, 0.1);
  position: relative;
  transition: all 0.2s ease;
}

.coupon-item:active {
  transform: scale(0.98);
}

.coupon-item-left {
  width: 120rpx;
  display: flex;
  align-items: baseline;
  justify-content: center;
  color: #9C27B0;
  flex-shrink: 0;
}

.coupon-item-symbol {
  font-size: 22rpx;
  font-weight: 500;
}

.coupon-item-value {
  font-size: 44rpx;
  font-weight: 700;
}

.coupon-item-right {
  flex: 1;
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.coupon-item-name {
  font-size: 26rpx;
  color: #1D1D1F;
  font-weight: 500;
}

.coupon-item-rule {
  font-size: 22rpx;
  color: #8E8E93;
}

.coupon-item-time {
  font-size: 20rpx;
  color: #AEAEB2;
}

.coupon-item-check {
  font-size: 28rpx;
  color: #9C27B0;
  font-weight: 700;
  padding: 8rpx;
  flex-shrink: 0;
}

.no-data {
  text-align: center;
  padding: 32rpx;
  color: #AEAEB2;
  font-size: 26rpx;
}

/* ── 价格明细 ── */
.price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.price-label {
  font-size: 26rpx;
  color: #8E8E93;
}

.price-value {
  font-size: 26rpx;
  color: #1D1D1F;
  font-weight: 500;
}

.price-label.discount,
.price-value.discount {
  color: #9C27B0;
}

.price-row.final {
  padding-top: 20rpx;
  margin-top: 8rpx;
  border-top: 1rpx solid #F2F2F7;
}

.price-label.final {
  font-size: 28rpx;
  color: #1D1D1F;
  font-weight: 600;
}

.price-value.final {
  font-size: 36rpx;
  color: #9C27B0;
  font-weight: 700;
}

/* ── 底部提交栏 ── */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-top: 1rpx solid rgba(134, 134, 139, 0.1);
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 100;
}

.bottom-left {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.bottom-total-label {
  font-size: 26rpx;
  color: #8E8E93;
}

.bottom-total-price {
  font-size: 40rpx;
  font-weight: 700;
  color: #9C27B0;
}

.submit-btn {
  padding: 22rpx 64rpx;
  background: linear-gradient(135deg, #9C27B0 0%, #7B1FA2 100%);
  border-radius: 48rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 2rpx;
  box-shadow: 0 6rpx 16rpx rgba(156, 39, 176, 0.3);
  transition: all 0.3s ease;
}

.submit-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(156, 39, 176, 0.3);
}

.submit-btn.disabled {
  opacity: 0.6;
}

/* ── 加载状态 ── */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  background: #F5F5F7;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 3rpx solid #E5E5EA;
  border-top: 3rpx solid #9C27B0;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-container text {
  font-size: 22rpx;
  color: #AEAEB2;
  letter-spacing: 2rpx;
}

/* ── 错误状态 ── */
.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  background: #F5F5F7;
  padding: 0 40rpx;
}

.error-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  color: #C7C7CC;
}

.error-text {
  font-size: 28rpx;
  color: #8E8E93;
  text-align: center;
  margin-bottom: 40rpx;
}

.retry-btn {
  padding: 18rpx 56rpx;
  background: linear-gradient(135deg, #9C27B0 0%, #7B1FA2 100%);
  border-radius: 48rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 2rpx;
  box-shadow: 0 6rpx 16rpx rgba(156, 39, 176, 0.3);
}

.retry-btn:active {
  transform: scale(0.98);
}

/* ── 动画 ── */
@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(24rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.card-animate {
  animation: fadeUp 0.5s ease-out both;
}

.card-animate-1 { animation-delay: 0.1s; }
.card-animate-2 { animation-delay: 0.2s; }
.card-animate-3 { animation-delay: 0.3s; }
.card-animate-4 { animation-delay: 0.4s; }
