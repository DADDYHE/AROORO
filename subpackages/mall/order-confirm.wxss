/* ================================================================
   mall/order-confirm.wxss · AROORO 商城订单确认 — Haute-Luxury Editorial
   板块色：香槟金家族 --mall-primary / --mall-secondary
   白卡奶油底 + 发丝描边 + 金色总价/CTA
   Skyline 兼容：无 :active / text-transform / backdrop-filter / sticky
   ================================================================ */
@import '../../styles/loading-animation.wxss';
@import '../../styles/components.wxss';
/* ===== 入场动画 ===== */
@keyframes fadeInUp {
  0% {
    opacity: 0;
    transform: translateY(24rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeIn {
  0% { opacity: 0; }
  100% { opacity: 1; }
}

/* ===== 页面容器 ===== */
.page-container {
  min-height: 100vh;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* ── 通用卡片 ── */
.info-card {
  background: var(--card-color);
  border-radius: var(--lux-radius-card);
  padding: var(--zy-space-lg);
  margin-bottom: var(--zy-space-lg);
  border: 1rpx solid var(--hairline);
  position: relative;
  overflow: hidden;
  animation-name: fadeInUp;
  animation-duration: 500ms;
  animation-timing-function: cubic-bezier(0.16,1,0.3,1);
  animation-fill-mode: forwards;
}

/* ── 收货地址 ── */
.address-card {
  margin: var(--zy-space-lg) var(--page-padding);
  margin-bottom: 0;
}

.address-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.address-left {
  flex: 1;
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
}

.address-location-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: var(--mall-tint);
  border-radius: var(--zy-radius-md);
  border: 1rpx solid var(--hairline);
}

.address-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.address-user {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.address-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.02em;
}

.address-phone {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 400;
}

.address-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  font-weight: 400;
  letter-spacing: 0.02em;
}

.address-arrow {
  font-size: 36rpx;
  color: var(--text-tertiary);
  margin-left: 16rpx;
  flex-shrink: 0;
}

.address-empty {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.address-empty-text {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
  letter-spacing: 0.06em;
}

/* ── 页面内容区 ── */
.page-content {
  padding: var(--zy-space-lg) var(--page-padding) 24rpx;
}

/* ── 商品信息 ── */
.product-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.product-row + .product-row {
  padding-top: 20rpx;
  border-top: 1rpx solid var(--hairline);
}

.product-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--zy-radius-md);
  background: var(--card-cream);
  flex-shrink: 0;
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 160rpx;
}

.product-name {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-primary);
  line-height: 1.4;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  letter-spacing: 0.02em;
  font-family: var(--font-sans);
}

.product-sku {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-top: 6rpx;
  background: var(--accent-wash);
  padding: 4rpx 12rpx;
  border-radius: var(--zy-radius-sm);
  align-self: flex-start;
  font-weight: 400;
  letter-spacing: 0.04em;
}

.product-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.product-price {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.02em;
  font-family: var(--font-sans);
}

.product-qty {
  font-size: 24rpx;
  color: var(--text-tertiary);
  font-weight: 400;
}

/* ── 数量选择器 ── */
.quantity-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--hairline);
}

.quantity-label {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 500;
  letter-spacing: 0.06em;
}

.quantity-stepper {
  display: flex;
  align-items: center;
  gap: 0;
  border: 1rpx solid var(--hairline);
  border-radius: var(--zy-radius-md);
  overflow: hidden;
  background: var(--card-cream);
}

.stepper-btn {
  width: 64rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--text-primary);
  background: transparent;
  font-weight: 400;
  transition: transform 280ms cubic-bezier(0.25,0.1,0.25,1),
              background-color 280ms cubic-bezier(0.25,0.1,0.25,1);
}

.stepper-btn.disabled {
  color: var(--text-tertiary);
  opacity: 0.4;
}

.stepper-btn--pressed {
  transform: scale(0.9);
  background: var(--mall-accent);
}

.stepper-input {
  width: 72rpx;
  height: 56rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-primary);
  border-left: 1rpx solid var(--hairline);
  border-right: 1rpx solid var(--hairline);
  background: var(--card-color);
}

/* ── 备注 ── */
.remark-row {
  display: flex;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--hairline);
}

.remark-label {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 500;
  width: 80rpx;
  flex-shrink: 0;
  letter-spacing: 0.06em;
}

.remark-input {
  flex: 1;
  font-size: 24rpx;
  color: var(--text-primary);
  text-align: right;
  font-weight: 400;
}

/* ── 区块标题 ── */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-label {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.10em;
}

.section-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.coupon-hint {
  font-size: 24rpx;
  color: var(--text-primary);
  font-weight: 500;
  letter-spacing: 0.04em;
}

.section-arrow {
  width: 20rpx;
  height: 20rpx;
  flex-shrink: 0;
}

/* ── 优惠券 ── */
.selected-coupon {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background: var(--mall-tint);
  border-radius: var(--zy-radius-md);
  border: 1rpx solid rgba(201,162,75,0.15);
}

.coupon-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.coupon-name {
  font-size: 24rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.coupon-desc {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
  letter-spacing: 0.02em;
}

.remove-coupon {
  width: 26rpx;
  height: 26rpx;
  padding: 8rpx 16rpx;
  transition: transform 280ms cubic-bezier(0.25,0.1,0.25,1),
              color 280ms cubic-bezier(0.25,0.1,0.25,1);
}

.remove-coupon--pressed {
  transform: scale(0.9);
  color: var(--brand-red);
}

.coupon-list {
  margin-top: 8rpx;
}

.coupon-item {
  display: flex;
  align-items: center;
  padding: 20rpx 16rpx;
  background: var(--card-cream);
  border-radius: var(--zy-radius-md);
  margin-bottom: 12rpx;
  border: 1rpx solid var(--hairline);
  position: relative;
  transition: transform 280ms cubic-bezier(0.25,0.1,0.25,1),
              border-color 280ms cubic-bezier(0.25,0.1,0.25,1);
}

.coupon-item--pressed {
  transform: scale(0.99);
  border-color: rgba(201,162,75,0.3);
}

.coupon-item-left {
  width: 120rpx;
  display: flex;
  align-items: baseline;
  justify-content: center;
  color: var(--text-primary);
  flex-shrink: 0;
}

.coupon-item-symbol {
  font-size: 22rpx;
  font-weight: 500;
}

.coupon-item-value {
  font-size: 40rpx;
  font-weight: 500;
  letter-spacing: 0.02em;
  font-family: var(--font-sans);
}

.coupon-item-right {
  flex: 1;
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.coupon-item-name {
  font-size: 24rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.coupon-item-rule {
  font-size: 22rpx;
  color: var(--text-secondary);
  font-weight: 400;
}

.coupon-item-time {
  font-size: 20rpx;
  color: var(--text-tertiary);
  font-weight: 400;
}

.coupon-item-check {
  width: 28rpx;
  height: 28rpx;
  font-weight: 500;
  padding: 8rpx;
  flex-shrink: 0;
}

.no-data {
  text-align: center;
  padding: 32rpx;
  color: var(--text-tertiary);
  font-size: 24rpx;
  font-weight: 400;
  letter-spacing: 0.06em;
}

/* ── 价格明细 ── */
.price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.price-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 400;
}

.price-value {
  font-size: 24rpx;
  color: var(--text-primary);
  font-weight: 400;
}

.price-label.discount,
.price-value.discount {
  color: var(--text-primary);
}

.price-row.final {
  padding-top: 20rpx;
  margin-top: 8rpx;
  border-top: 1rpx solid var(--hairline);
}

.price-label.final {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 500;
  letter-spacing: 0.06em;
}

.price-value.final {
  font-size: 34rpx;
  color: var(--text-primary);
  font-weight: 500;
  letter-spacing: 0.02em;
  font-family: var(--font-sans);
}

.min-amount-tip {
  text-align: right;
  font-size: 22rpx;
  color: var(--text-tertiary);
  font-weight: 400;
}

/* ── 底部提交栏 ── */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx var(--page-padding);
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255,255,255,0.96);
  border-top: 1rpx solid var(--hairline);
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 100;
}

.bottom-left {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.bottom-total-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 400;
  letter-spacing: 0.04em;
}

.bottom-total-price {
  font-size: 38rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.02em;
  font-family: var(--font-sans);
}

.submit-btn {
  padding: 22rpx 56rpx;
  background: var(--gradient-secondary);
  border-radius: var(--zy-radius-lg);
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-on-accent);  /* 原 var(--text-inverse) */
  letter-spacing: 0.10em;
  box-shadow: var(--shadow-glow-mall);
  transition: transform 280ms cubic-bezier(0.25,0.1,0.25,1),
              box-shadow 280ms cubic-bezier(0.25,0.1,0.25,1),
              opacity 280ms cubic-bezier(0.25,0.1,0.25,1);
}

.submit-btn--pressed {
  transform: scale(0.97);
}

.submit-btn.disabled {
  background: var(--text-tertiary);
  box-shadow: none;
  opacity: 0.6;
}

/* ── 加载状态（由 loading-animation.wxss 提供） ── */

/* ── 错误状态 ── */
.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 0 40rpx;
  animation-name: fadeIn;
  animation-duration: 600ms;
  animation-timing-function: cubic-bezier(0.16,1,0.3,1);
  animation-fill-mode: forwards;
}

.error-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.4;
}

.error-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  text-align: center;
  margin-bottom: 40rpx;
  letter-spacing: 0.06em;
  font-weight: 400;
}

.retry-btn {
  padding: 18rpx 56rpx;
  background: var(--gradient-secondary);
  border-radius: var(--zy-radius-lg);
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-on-accent);  /* 原 var(--text-inverse) */
  letter-spacing: 0.12em;
  box-shadow: var(--shadow-glow-mall);
  transition-property: transform;
  transition-duration: 280ms;
  transition-timing-function: cubic-bezier(0.25,0.1,0.25,1);
}

.retry-btn--pressed {
  transform: scale(0.97);
}
