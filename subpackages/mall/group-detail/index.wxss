@import '../../../styles/loading-animation.wxss';

.tuan-detail {
  padding-bottom: 120rpx;
  background: var(--background-color);
  min-height: 100vh;
}

.loading-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.loading-dot:nth-child(3) {
  animation-delay: 0.4s;
}

.empty-page {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100vh;
  color: var(--text-secondary);
  font-size: 28rpx;
  letter-spacing: 2rpx;
}

.detail-title-area {
  background: var(--card-color);
  padding: 32rpx 32rpx 24rpx;
  animation: fadeUp var(--duration-elegant) var(--ease-velvet);
}

.detail-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  letter-spacing: 1rpx;
  line-height: 1.4;
}

.detail-desc-area {
  background: var(--card-color);
  padding: 24rpx 32rpx;
  margin-top: 16rpx;
  animation: fadeUp var(--duration-elegant) var(--ease-velvet) 0.2s both;
}

.detail-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  display: block;
  line-height: 1.8;
  letter-spacing: 1rpx;
}

.detail-section {
  padding: 32rpx 32rpx 16rpx;
  animation: fadeUp var(--duration-elegant) var(--ease-velvet) 0.1s both;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: 2rpx;
}

.product-list {
  padding: 0 32rpx;
}

.product-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: var(--card-color);
  border-radius: 24rpx;
  margin-bottom: 20rpx;
  gap: 20rpx;
  box-shadow: var(--shadow-md);
  border: 1rpx solid rgba(74, 69, 67, 0.1);
  transition: all var(--transition-normal);
  animation: fadeUp var(--duration-elegant) var(--ease-velvet) both;
}

.product-card:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-lg);
}

.product-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  background: linear-gradient(135deg, var(--background-color) 0%, var(--gray-400) 100%);
}

.product-info {
  flex: 1;
  min-width: 0;
}

.product-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  letter-spacing: 1rpx;
}

.product-price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.product-price-wrap {
  display: flex;
  align-items: baseline;
}

.product-price-symbol {
  font-size: 22rpx;
  color: var(--groupbuy-primary);
  font-weight: 600;
}

.product-price {
  font-size: 36rpx;
  color: var(--groupbuy-primary);
  font-weight: 700;
}

.product-original {
  font-size: 22rpx;
  color: var(--text-tertiary);
  text-decoration: line-through;
  margin-left: 8rpx;
}

.product-buy-btn {
  background: var(--groupbuy-gradient);
  border: 2rpx solid var(--border-inverse-35);
  color: var(--text-inverse);
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  box-shadow: var(--shadow-glow-groupbuy), var(--shadow-emboss);
  transition: all var(--transition-fast);
  position: relative;
  overflow: hidden;
}

/* 顶部玻璃高光 */
.product-buy-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 50%;
  background: var(--gradient-white-fade);
  border-radius: 24rpx 24rpx 0 0;
  pointer-events: none;
  z-index: 1;
}

/* 光泽扫过动画 */
.product-buy-btn::after {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 60%;
  height: 100%;
  background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.3) 50%, transparent 100%);
  transform: skewX(-20deg);
  animation: btn-sheen var(--transition-shimmer) infinite;
  pointer-events: none;
  z-index: 1;
}

.product-buy-btn:active {
  background: var(--groupbuy-gradient-dark);
  box-shadow: var(--shadow-glow-groupbuy-dark), var(--shadow-emboss);
  transform: scale(0.96);
}

.product-stock {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
  display: block;
}

.product-library-link {
  font-size: 22rpx;
  color: var(--groupbuy-primary);
  margin-top: 4rpx;
  display: block;
}

.detail-images {
  padding: 24rpx 32rpx;
  animation: fadeUp var(--duration-elegant) var(--ease-velvet) 0.2s both;
}

.detail-img {
  width: 100%;
  display: block;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  background: linear-gradient(135deg, var(--background-color) 0%, var(--gray-400) 100%);
}

.detail-img:last-child {
  margin-bottom: 0;
}

.detail-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--card-color);
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: var(--shadow-top-lg);
  z-index: 10;
  border-top: 1rpx solid rgba(74, 69, 67, 0.08);
}

.bar-actions {
  display: flex;
  gap: 24rpx;
  flex-shrink: 0;
}

.bar-action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  position: relative;
}

.contact-btn {
  display: flex !important;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  position: relative;
  padding: 0 !important;
  margin: 0 !important;
  background: transparent !important;
  border: none !important;
  line-height: normal !important;
  min-width: 0 !important;
  width: auto !important;
  font-size: inherit !important;
  box-sizing: border-box;
}

.contact-btn::after {
  border: none !important;
}

.bar-action-icon-img {
  width: 40rpx;
  height: 40rpx;
}

.bar-action-text {
  font-size: 18rpx;
  color: var(--text-tertiary);
  letter-spacing: 1rpx;
}

.cart-badge {
  position: absolute;
  top: -8rpx;
  right: -16rpx;
  min-width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  text-align: center;
  background: var(--error-color);
  color: var(--text-inverse);
  font-size: 18rpx;
  border-radius: 14rpx;
  padding: 0 6rpx;
}

.footer-btn {
  flex: 1;
  min-width: 0;
  background: var(--groupbuy-gradient);
  border: 2rpx solid var(--border-inverse-35);
  color: var(--text-inverse);
  font-size: 30rpx;
  padding: 20rpx 0;
  border-radius: 48rpx;
  font-weight: 700;
  text-align: center;
  letter-spacing: 3rpx;
  box-shadow: var(--shadow-glow-groupbuy-dark), var(--shadow-emboss);
  position: relative;
  overflow: hidden;
  transition: all var(--transition-fast);
}

/* 顶部玻璃高光 */
.footer-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 50%;
  background: var(--gradient-white-fade);
  border-radius: 48rpx 48rpx 0 0;
  pointer-events: none;
  z-index: 1;
}

/* 光泽扫过动画 */
.footer-btn::after {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 60%;
  height: 100%;
  background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.3) 50%, transparent 100%);
  transform: skewX(-20deg);
  animation: btn-sheen var(--transition-shimmer) infinite;
  pointer-events: none;
  z-index: 1;
}

.footer-btn:active {
  background: var(--groupbuy-gradient-dark);
  box-shadow: var(--shadow-glow-groupbuy-dark), var(--shadow-emboss);
  transform: scale(0.98);
}

.sku-popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(74, 69, 67, 0.5);
  z-index: 200;
  opacity: 0;
  visibility: hidden;
  transition: all var(--transition-normal);
}

.sku-popup-mask.show {
  opacity: 1;
  visibility: visible;
}

.sku-popup {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 201;
  background: var(--glass-border);
  border-top: 1rpx solid var(--border-inverse-35);
  border-radius: 32rpx 32rpx 0 0;
  transform: translateY(100%);
  transition: transform var(--transition-normal);
  max-height: 75vh;
  display: flex;
  flex-direction: column;
  box-shadow: var(--shadow-sku-popup-groupbuy);
}

.sku-popup.show {
  transform: translateY(0);
}

.sku-popup-inner {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin: 28rpx;
  border-radius: 24rpx;
  background: var(--glass-bg-95);
  overflow: hidden;
  border: 1rpx solid var(--border-inverse-20);
  box-shadow: var(--shadow-md), var(--shadow-emboss);
}

.sku-popup-header {
  display: flex;
  gap: 20rpx;
  padding: 32rpx;
  border-bottom: 1rpx solid rgba(74, 69, 67, 0.08);
  position: relative;
  flex-shrink: 0;
}

.sku-popup-thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  background: linear-gradient(135deg, var(--background-color) 0%, var(--gray-400) 100%);
}

.sku-popup-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.sku-popup-price {
  font-size: 40rpx;
  color: var(--groupbuy-primary);
  font-weight: 700;
  letter-spacing: 1rpx;
}

.sku-popup-stock {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

.sku-popup-selected {
  font-size: 24rpx;
  color: var(--groupbuy-primary);
  margin-top: 6rpx;
}

.sku-popup-close {
  position: absolute;
  top: 32rpx;
  right: 32rpx;
  font-size: 36rpx;
  color: var(--text-tertiary);
  padding: 10rpx;
  line-height: 1;
}

.sku-popup-body {
  flex: 1;
  overflow-y: auto;
  min-width: 0;
  -webkit-overflow-scrolling: touch;
}

.sku-popup-body-inner {
  padding: 24rpx 32rpx;
}

.sku-group {
  margin-bottom: 28rpx;
}

.sku-group-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  display: block;
  letter-spacing: 1rpx;
}

.sku-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.sku-option {
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
  background: var(--divider-color);
  border: 2rpx solid transparent;
  transition: all var(--transition-fast);
}

.sku-option.selected {
  background: var(--groupbuy-light);
  border-color: var(--groupbuy-primary);
}

.sku-option.disabled {
  opacity: 0.35;
  pointer-events: none;
}

.sku-option.selected .sku-option-name {
  color: var(--groupbuy-primary);
  font-weight: 600;
}

.sku-option-name {
  font-size: 26rpx;
  color: var(--text-primary);
}

.sku-quantity {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-top: 1rpx solid rgba(74, 69, 67, 0.08);
  overflow: hidden;
}

.sku-quantity .sku-group-label {
  margin-bottom: 0;
  flex-shrink: 0;
}

.quantity-control {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

.quantity-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--divider-color);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--text-primary);
  transition: all var(--transition-fast);
}

.quantity-btn.disabled {
  opacity: 0.35;
}

.quantity-value {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 600;
  min-width: 48rpx;
  text-align: center;
}

.sku-popup-footer {
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(74, 69, 67, 0.08);
  flex-shrink: 0;
}

.sku-confirm-btn {
  width: 100%;
  padding: 26rpx 0;
  background: var(--groupbuy-gradient);
  border: 2rpx solid var(--border-inverse-35);
  border-radius: 48rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-inverse);
  letter-spacing: 3rpx;
  box-shadow: var(--shadow-glow-groupbuy-dark), var(--shadow-emboss);
  transition: all var(--transition-fast);
  position: relative;
  overflow: hidden;
}

/* 顶部玻璃高光 */
.sku-confirm-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 50%;
  background: var(--gradient-white-fade-soft);
  border-radius: 48rpx 48rpx 0 0;
  pointer-events: none;
  z-index: 1;
}

/* 光泽扫过动画 */
.sku-confirm-btn::after {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 60%;
  height: 100%;
  background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.25) 50%, transparent 100%);
  transform: skewX(-20deg);
  animation: btn-sheen var(--transition-shimmer) infinite;
  pointer-events: none;
  z-index: 1;
}

.sku-confirm-btn.disabled {
  background: var(--text-tertiary);
  box-shadow: none;
  pointer-events: none;
}

.sku-confirm-btn:active {
  background: var(--groupbuy-gradient-dark);
  box-shadow: var(--shadow-glow-groupbuy-dark), var(--shadow-emboss);
  transform: scale(0.98);
}

/* ── Sakura 光泽扫过动画 ── */
@keyframes btn-sheen {
  0% {
    left: -100%;
  }
  35% {
    left: 200%;
  }
  100% {
    left: 200%;
  }
}
