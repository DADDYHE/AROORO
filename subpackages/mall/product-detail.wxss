/* ================================================================
   mall/product-detail.wxss · AROORO 商城商品详情 — Haute-Luxury Editorial
   混搭方案（2026-08-27 拍板）：B 深绿沉浸画廊（压图信息板）+ A 整版纸面流
   色彩纪律：金 #C9A24B 仅做"点"（眉题线/页码/指示条/chip 选中点/页脚线，<5%）
             CTA 深绿实色无发光（--primary-color），去 --gradient-secondary / --shadow-glow-mall
   Skyline 兼容：无 :active / text-transform / backdrop-filter / sticky / line-clamp
   ================================================================ */
@import '../../styles/loading-animation.wxss';
/* ===== 页面容器 ===== */
.page-container {
  min-height: 100vh;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

/* ── 深绿沉浸画廊（B · 精品橱窗式） ── */
.image-gallery {
  position: relative;
  width: 100%;
  height: 820rpx;
  background: var(--lux-green-700);
}

/* 顶部 scrim：保证沉浸白箭头在浅色商品图上保持可读（单层渐变，Skyline 兼容） */
.gallery-top-scrim {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 280rpx;
  background: linear-gradient(to bottom, rgba(15, 36, 16, 0.62) 0%, rgba(15, 36, 16, 0) 100%);
  z-index: 1;
  pointer-events: none;
}

.gallery-swiper {
  width: 100%;
  height: 100%;
}

.gallery-image {
  width: 100%;
  height: 100%;
}

/* share-element 包装器继承 image 尺寸 */
.gallery-image-share {
  width: 100%;
  height: 100%;
}

/* 纸牌徽章（cream 底 + 发丝边，替代玻璃 chip） */
.gallery-badge {
  position: absolute;
  left: 32rpx;
  display: flex;
  gap: 12rpx;
  z-index: 2;
}

.badge-tag {
  padding: 8rpx 20rpx;
  border-radius: var(--zy-radius-xs);
  font-size: 20rpx;
  font-weight: 400;
  letter-spacing: 0.12em;
  background: var(--card-cream);
  border: 1rpx solid var(--hairline);
  font-family: var(--font-sans);
}

.badge-tag.on_sale {
  color: var(--text-primary);
}

.badge-tag.featured {
  color: var(--tuan-primary);
}

/* 分享（纸牌圆钮） */
.gallery-actions {
  position: absolute;
  right: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  z-index: 2;
}

.gallery-action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: var(--card-cream);
  border: 1rpx solid var(--hairline);
  transition: transform var(--dur-fast) var(--ease-refined);
}

.gallery-action-btn--pressed {
  transform: scale(0.9);
}

.gallery-action-icon {
  width: 34rpx;
  height: 34rpx;
}

/* 品牌字标层（左下 eyebrow + 金线） */
.gallery-brand {
  position: absolute;
  left: 32rpx;
  bottom: 56rpx;
  z-index: 2;
}

.gallery-brand-eyebrow {
  display: block;
  font-size: 20rpx;
  font-weight: 300;
  color: var(--text-on-dark-70);
  letter-spacing: 0.28em;
  line-height: 1;
  font-family: var(--font-sans);
}

.gallery-brand-line {
  width: 48rpx;
  height: 1rpx;
  background: var(--mall-primary);
  margin-top: 10rpx;
}

/* 页码（编辑感） */
.gallery-page {
  position: absolute;
  right: 32rpx;
  bottom: 60rpx;
  font-size: 20rpx;
  color: var(--text-on-dark-70);
  letter-spacing: 0.2em;
  font-weight: 400;
  font-family: var(--font-sans);
}

/* 指示器（active 金条） */
.gallery-indicator {
  position: absolute;
  bottom: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 12rpx;
  z-index: 2;
}

.indicator-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(247, 245, 239, 0.35);
  transition: transform var(--dur-fast) var(--ease-refined),
              width var(--dur-fast) var(--ease-refined),
              background-color var(--dur-fast) var(--ease-refined);
}

.indicator-dot.active {
  background: var(--mall-primary);
  width: 32rpx;
  border-radius: var(--zy-radius-xs);
}

/* ── 纸面流内容区（A · 编辑杂志式） ── */
.page-content {
  padding: 0;
}

/* 商品信息区（纸面 · 孤品价签：深绿粗体大价格抓眼球） */
.product-info-section {
  padding: 48rpx var(--page-padding) 0;
}

.info-name {
  display: block;
  font-size: 46rpx;
  font-weight: 500;
  color: var(--text-primary);
  line-height: 1.3;
  margin-top: 24rpx;
  letter-spacing: 0.01em;
  font-family: var(--font-serif);
}

.info-subtitle {
  display: block;
  font-size: 26rpx;
  color: var(--text-tertiary);
  margin-top: 10rpx;
  font-weight: 400;
  letter-spacing: 0.06em;
  font-family: var(--font-sans);
}

.info-divider {
  height: 1rpx;
  background: var(--hairline);
  margin: 32rpx 0 28rpx;
}

.info-price-row {
  display: flex;
  align-items: baseline;
  gap: 18rpx;
}

.info-price {
  font-size: 56rpx;
  font-weight: 500;
  color: var(--primary-color);
  letter-spacing: 0.01em;
  font-family: var(--font-sans);
  line-height: 1;
}

.info-original {
  font-size: 24rpx;
  color: var(--text-tertiary);
  text-decoration: line-through;
  font-weight: 400;
}

/* 商品详情分节（整版纸面，去卡片） */
.details-section {
  padding: 40rpx var(--page-padding) 0;
}

.section-label {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-tertiary);
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 28rpx;
  letter-spacing: 0.20em;
  font-family: var(--font-sans);
}

.label-accent {
  width: 32rpx;
  height: 2rpx;
  background: var(--accent-color);
  flex-shrink: 0;
}

.description-text {
  font-size: 30rpx;
  color: var(--text-secondary);
  line-height: 1.85;
  margin-bottom: 28rpx;
  font-weight: 400;
  letter-spacing: 0.02em;
  font-family: var(--font-sans);
}

.detail-images {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  /* 突破分节左右 48rpx 内边距，详情图真正左右全出血 */
  margin-left: calc(-1 * var(--page-padding));
  margin-right: calc(-1 * var(--page-padding));
}

/* 全出血（无圆角，杂志版式） */
.detail-image {
  width: 100%;
  border-radius: 4rpx;
}

/* 品牌页脚 */
.brand-footer {
  text-align: center;
  padding: 64rpx var(--page-padding) 24rpx;
}

.footer-gold-line {
  width: 120rpx;
  height: 1rpx;
  background: var(--lux-gold-line);
  margin: 0 auto 20rpx;
}

.footer-brand {
  display: block;
  font-size: 20rpx;
  font-weight: 400;
  color: var(--primary-color);
  letter-spacing: 0.32em;
  font-family: var(--font-sans);
}

.footer-tagline {
  display: block;
  font-size: 20rpx;
  color: var(--text-tertiary);
  margin-top: 8rpx;
  font-weight: 400;
  letter-spacing: 0.08em;
  font-family: var(--font-sans);
}

/* ── 底部操作栏（纸感条） ── */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx var(--page-padding);
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: var(--card-satin);
  border-top: 1rpx solid var(--hairline);
  display: flex;
  align-items: center;
  gap: 24rpx;
  z-index: 100;
}

.bar-actions {
  display: flex;
  gap: 32rpx;
  flex-shrink: 0;
}

.bar-action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  position: relative;
}

.contact-wrap {
  position: relative;
}

.contact-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  background: transparent;
  border: none;
  margin: 0;
  padding: 0;
  line-height: normal;
}

.contact-overlay::after {
  border: none;
}

.bar-action-icon-img {
  width: 36rpx;
  height: 36rpx;
}

.bar-action-text {
  font-size: 18rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.12em;
  font-weight: 400;
  font-family: var(--font-sans);
}

.cart-badge {
  position: absolute;
  top: -8rpx;
  right: -16rpx;
  min-width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  text-align: center;
  background: var(--brand-red);
  color: var(--text-inverse);
  font-size: 18rpx;
  font-weight: 500;
  border-radius: 14rpx;
  padding: 0 6rpx;
}

.buy-buttons {
  flex: 1;
  display: flex;
  gap: 16rpx;
}

/* 深绿描边（加入购物车） */
.cart-btn {
  flex: 1;
  padding: 24rpx 0;
  border: 1rpx solid var(--primary-color);
  border-radius: var(--zy-radius-xs);
  text-align: center;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.15em;
  background: transparent;
  font-family: var(--font-sans);
  transition: transform var(--dur-fast) var(--ease-refined),
              background-color var(--dur-fast) var(--ease-refined);
}

.cart-btn--pressed {
  transform: scale(0.97);
  background: var(--primary-tint-04);
}

/* 深绿实色（立即购买）· 无发光 */
.buy-btn {
  flex: 1;
  padding: 24rpx 0;
  background: var(--primary-color);
  border-radius: var(--zy-radius-xs);
  text-align: center;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-on-primary);
  letter-spacing: 0.15em;
  font-family: var(--font-sans);
  transition: transform var(--dur-fast) var(--ease-refined),
              background-color var(--dur-fast) var(--ease-refined);
}

.buy-btn--pressed {
  transform: scale(0.97);
  background: var(--primary-deep);
}

/* ── 规格选择弹窗（选品台） ── */
.sku-popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--overlay-color);
  z-index: 200;
  opacity: 0;
  visibility: hidden;
  transition: opacity var(--dur-base) var(--ease-luxury);
}

.sku-popup-mask.show {
  opacity: 1;
  visibility: visible;
}

.sku-popup {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 201;
  background: var(--card-cream);
  border-radius: 24rpx 24rpx 0 0;
  height: 78vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding-top: 0;
  transform: translateY(100vh);
  transition: transform var(--dur-slow) var(--ease-silk);
  border-top: 1rpx solid var(--hairline);
  pointer-events: none;
}

.sku-popup.show {
  transform: translateY(0);
  pointer-events: auto;
}

.sku-popup-close-btn {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  z-index: 10;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--card-color);
  border-radius: 50%;
  border: 1rpx solid var(--hairline);
  transition: transform var(--dur-fast) var(--ease-refined);
}

.sku-popup-close-icon {
  width: 32rpx;
  height: 32rpx;
}

.sku-popup-close-btn--pressed {
  transform: scale(0.9);
}

.sku-popup-image-wrap {
  width: 100%;
  height: 520rpx;
  flex-shrink: 0;
  overflow: hidden;
  background: var(--card-cream);
}

.sku-popup-image {
  width: 100%;
  height: 100%;
}

.sku-popup-body {
  flex: 1;
  min-height: 0;
}

.sku-popup-body-inner {
  padding: 32rpx var(--page-padding) 16rpx;
}

/* 商品信息 */
.sku-product-info {
  margin-bottom: 32rpx;
}

.sku-product-name {
  font-size: 34rpx;
  font-weight: 500;
  color: var(--text-primary);
  display: block;
  line-height: 1.35;
  margin-bottom: 16rpx;
  letter-spacing: 0.01em;
  font-family: var(--font-serif);
}

.sku-product-meta {
  display: flex;
  align-items: baseline;
  gap: 20rpx;
  margin-bottom: 8rpx;
}

.sku-product-price {
  font-size: 44rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.01em;
  font-family: var(--font-sans);
  line-height: 1;
}

.sku-product-stock {
  font-size: 24rpx;
  color: var(--text-tertiary);
  font-weight: 400;
  letter-spacing: 0.04em;
  font-family: var(--font-sans);
}

.sku-product-selected {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 400;
  letter-spacing: 0.06em;
  font-family: var(--font-sans);
}

/* 规格分组 */
.sku-spec-section {
  margin-bottom: 32rpx;
}

.sku-spec-label {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-tertiary);
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
  letter-spacing: 0.15em;
  font-family: var(--font-sans);
}

.sku-spec-label .label-accent {
  width: 24rpx;
}

.sku-spec-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

/* 纸牌 chips：白底 + 发丝边；选中 = 深绿描边 + 左侧金点 */
.sku-spec-option {
  padding: 14rpx 32rpx;
  border-radius: var(--zy-radius-xs);
  background: var(--card-color);
  border: 1rpx solid var(--hairline);
  box-sizing: border-box;
  transition: transform var(--dur-fast) var(--ease-refined),
              background-color var(--dur-fast) var(--ease-refined),
              border-color var(--dur-fast) var(--ease-refined);
}

.sku-spec-option.selected {
  background: var(--primary-tint-04);
  border-color: var(--primary-color);
  border-left: 3rpx solid var(--mall-primary);
}

.sku-spec-option.disabled {
  opacity: 0.35;
  pointer-events: none;
}

.sku-spec-option--pressed {
  transform: scale(0.95);
}

.sku-spec-option-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 400;
  letter-spacing: 0.02em;
  font-family: var(--font-sans);
}

.sku-spec-option.selected .sku-spec-option-text {
  color: var(--text-primary);
  font-weight: 500;
}

/* 数量（方形发丝边） */
.sku-quantity-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-top: 1rpx solid var(--hairline);
}

.sku-quantity-section .sku-spec-label {
  margin-bottom: 0;
}

.sku-quantity-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.sku-qty-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--zy-radius-xs);
  background: var(--card-color);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 400;
  border: 1rpx solid var(--hairline);
  transition: transform var(--dur-fast) var(--ease-refined),
              background-color var(--dur-fast) var(--ease-refined);
}

.sku-qty-btn.disabled {
  opacity: 0.3;
}

.sku-qty-btn--pressed {
  transform: scale(0.9);
  background: var(--primary-tint-08);
}

.sku-qty-value {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  min-width: 56rpx;
  text-align: center;
  font-family: var(--font-sans);
}

/* 底部按钮（深绿实色） */
.sku-popup-footer {
  padding: 20rpx var(--page-padding);
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
  border-top: 1rpx solid var(--hairline);
  background: var(--card-cream);
}

.sku-confirm-btn {
  width: 100%;
  padding: 26rpx 0;
  background: var(--primary-color);
  border-radius: var(--zy-radius-xs);
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-on-primary);
  letter-spacing: 0.20em;
  font-family: var(--font-sans);
  transition: transform var(--dur-fast) var(--ease-refined),
              background-color var(--dur-fast) var(--ease-refined);
}

.sku-confirm-btn--pressed {
  transform: scale(0.98);
  background: var(--primary-deep);
}

.sku-confirm-btn.disabled {
  background: var(--text-tertiary);
  opacity: 0.5;
}

/* ── 加载状态（由 loading-animation.wxss 提供） ── */

/* ── 错误状态 ── */
.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 0 40rpx;
  animation-name: zy-fade-in;
  animation-duration: 420ms;
  animation-timing-function: cubic-bezier(0.19, 1, 0.22, 1);
  animation-fill-mode: forwards;
}

.error-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.4;
}

.error-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  text-align: center;
  margin-bottom: 40rpx;
  letter-spacing: 0.08em;
  font-weight: 400;
  font-family: var(--font-sans);
}

.retry-btn {
  padding: 20rpx 64rpx;
  background: var(--primary-color);
  border-radius: var(--zy-radius-xs);
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-on-primary);
  letter-spacing: 0.20em;
  font-family: var(--font-sans);
  transition: transform var(--dur-fast) var(--ease-refined);
}

.retry-btn--pressed {
  transform: scale(0.97);
}
