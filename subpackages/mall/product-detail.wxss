/* ================================================================
   mall/product-detail.wxss · AROORO 商城商品详情 — Haute-Luxury Editorial v2
   板块色：香槟金家族 --mall-primary / --accent-color
   全出血画廊 + 衬线大标题 + 发丝描边分节 + 金色价签 + 奶油 SKU 选择
   Skyline 兼容：无 :active / text-transform / backdrop-filter / sticky
   ================================================================ */
@import '../../styles/loading-animation.wxss';

page {
  background-color: var(--background-color);
}

/* ===== 入场动画 ===== */
@keyframes fadeInUp {
  0% {
    opacity: 0;
    transform: translateY(28rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeIn {
  0% { opacity: 0; }
  100% { opacity: 1; }
}

/* ===== 页面容器 ===== */
.page-container {
  min-height: 100vh;
  background: var(--background-color);
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

/* ── 全出血图片画廊 ── */
.image-gallery {
  position: relative;
  width: 100%;
  height: 750rpx;
  background: var(--card-cream);
}

.gallery-swiper {
  width: 100%;
  height: 100%;
}

.gallery-image {
  width: 100%;
  height: 100%;
}

/* share-element 包装器继承 image 尺寸 */
.gallery-image-share {
  width: 100%;
  height: 100%;
}

/* 画廊底部渐变遮罩，提升指示器可读性 */
.image-gallery::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 200rpx;
  background: linear-gradient(to top, rgba(0,0,0,0.35), transparent);
  pointer-events: none;
}

.gallery-indicator {
  position: absolute;
  bottom: 36rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 12rpx;
  z-index: 2;
}

.indicator-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.35);
  transition: transform var(--dur-fast) var(--ease-refined),
              width var(--dur-fast) var(--ease-refined),
              background-color var(--dur-fast) var(--ease-refined);
}

.indicator-dot.active {
  background: var(--text-inverse);
  width: 32rpx;
  border-radius: var(--zy-radius-xs);
}

.gallery-badge {
  position: absolute;
  top: 32rpx;
  left: 32rpx;
  display: flex;
  gap: 12rpx;
  z-index: 2;
}

.badge-tag {
  padding: 10rpx 24rpx;
  border-radius: var(--zy-radius-xs);
  font-size: 20rpx;
  font-weight: 500;
  letter-spacing: 0.12em;
  background: var(--glass-bg-95);
  border: 1rpx solid var(--hairline);
  font-family: var(--font-sans);
}

.badge-tag.on_sale {
  color: var(--text-primary);
}

.badge-tag.featured {
  color: var(--tuan-primary);
}

.gallery-actions {
  position: absolute;
  top: 32rpx;
  right: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  z-index: 2;
}

.gallery-action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: var(--glass-bg-95);
  border: 1rpx solid var(--hairline);
  transition: transform var(--dur-fast) var(--ease-refined);
}

.gallery-action-btn--pressed {
  transform: scale(0.9);
}

.gallery-action-icon {
  width: 34rpx;
  height: 34rpx;
}

/* ── 页面内容区（上浮覆盖画廊底部） ── */
.page-content {
  padding: 0 var(--page-padding) 0;
  margin-top: -48rpx;
  position: relative;
  z-index: 3;
}

/* ── 通用卡片（编辑式分节） ── */
.info-card {
  background: var(--card-color);
  border-radius: var(--lux-radius-card);
  padding: var(--card-padding);
  margin-bottom: var(--zy-space-lg);
  border: 1rpx solid var(--hairline);
  position: relative;
  overflow: hidden;
  animation-name: fadeInUp;
  animation-duration: 600ms;
  animation-timing-function: cubic-bezier(0.16,1,0.3,1);
  animation-fill-mode: forwards;
}

/* 第二张卡片延迟入场 */
.info-card:nth-child(2) {
  animation-delay: 110ms;
}

/* ── 商品信息 ── */
.product-name {
  font-size: 42rpx;
  font-weight: 500;
  color: var(--text-primary);
  display: block;
  line-height: 1.3;
  margin-bottom: 10rpx;
  letter-spacing: 0.01em;
  font-family: var(--font-serif);
}

.product-subtitle {
  font-size: 26rpx;
  color: var(--text-tertiary);
  display: block;
  margin-bottom: 32rpx;
  font-weight: 400;
  letter-spacing: 0.06em;
  font-family: var(--font-sans);
}

.price-section {
  display: flex;
  align-items: baseline;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.current-price {
  font-size: 48rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.01em;
  font-family: var(--font-sans);
  line-height: 1;
}

.original-price {
  font-size: 24rpx;
  color: var(--text-tertiary);
  text-decoration: line-through;
  font-weight: 400;
}

.discount-tag {
  font-size: 20rpx;
  font-weight: 500;
  padding: 6rpx 16rpx;
  border-radius: var(--zy-radius-xs);
  background: var(--accent-wash);
  color: var(--text-primary);
  letter-spacing: 0.12em;
  font-family: var(--font-sans);
}

.meta-row {
  display: flex;
  gap: 40rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--hairline);
}

.meta-item {
  font-size: 22rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.08em;
  font-weight: 400;
  font-family: var(--font-sans);
}

.meta-item .value {
  color: var(--text-secondary);
  font-weight: 500;
}

/* ── 区块标题（编辑式：金色发丝线 + 宽字距） ── */
.section-label {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-tertiary);
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 32rpx;
  letter-spacing: 0.20em;
  font-family: var(--font-sans);
}

.label-accent {
  width: 32rpx;
  height: 2rpx;
  background: var(--accent-color);
  flex-shrink: 0;
}

/* ── 商品详情 ── */
.description-text {
  font-size: 30rpx;
  color: var(--text-secondary);
  line-height: 1.85;
  margin-bottom: 32rpx;
  font-weight: 400;
  letter-spacing: 0.02em;
  font-family: var(--font-sans);
}

.detail-images {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.detail-image {
  width: 100%;
  border-radius: var(--zy-radius-md);
}

/* ── 底部操作栏 ── */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx var(--page-padding);
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: var(--glass-bg-95);
  border-top: 1rpx solid var(--hairline);
  display: flex;
  align-items: center;
  gap: 24rpx;
  z-index: 100;
}

.bar-actions {
  display: flex;
  gap: 32rpx;
  flex-shrink: 0;
}

.bar-action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  position: relative;
}

.contact-wrap {
  position: relative;
}

.contact-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  background: transparent;
  border: none;
  margin: 0;
  padding: 0;
  line-height: normal;
}

.contact-overlay::after {
  border: none;
}

.bar-action-icon-img {
  width: 42rpx;
  height: 42rpx;
}

.bar-action-text {
  font-size: 18rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.12em;
  font-weight: 400;
  font-family: var(--font-sans);
}

.cart-badge {
  position: absolute;
  top: -8rpx;
  right: -16rpx;
  min-width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  text-align: center;
  background: var(--brand-red);
  color: var(--text-inverse);
  font-size: 18rpx;
  font-weight: 500;
  border-radius: 14rpx;
  padding: 0 6rpx;
}

.buy-buttons {
  flex: 1;
  display: flex;
  gap: 16rpx;
}

.cart-btn {
  flex: 1;
  padding: 24rpx 0;
  border: 1rpx solid var(--mall-primary);
  border-radius: var(--zy-radius-xs);
  text-align: center;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.15em;
  background: var(--card-color);
  font-family: var(--font-sans);
  transition: transform var(--dur-fast) var(--ease-refined),
              background-color var(--dur-fast) var(--ease-refined),
              opacity var(--dur-fast) var(--ease-refined);
}

.cart-btn--pressed {
  transform: scale(0.97);
  background: var(--accent-wash);
}

.buy-btn {
  flex: 1;
  padding: 24rpx 0;
  background: var(--gradient-secondary);
  border-radius: var(--zy-radius-xs);
  text-align: center;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-on-accent);  /* 原 var(--text-inverse) */
  letter-spacing: 0.15em;
  box-shadow: var(--shadow-glow-mall);
  font-family: var(--font-sans);
  transition: transform var(--dur-fast) var(--ease-refined),
              opacity var(--dur-fast) var(--ease-refined);
}

.buy-btn--pressed {
  transform: scale(0.97);
}

/* ── 规格选择弹窗 ── */
.sku-popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--overlay-color);
  z-index: 200;
  opacity: 0;
  visibility: hidden;
  transition: opacity var(--dur-base) var(--ease-luxury);
}

.sku-popup-mask.show {
  opacity: 1;
  visibility: visible;
}

.sku-popup {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 201;
  background: var(--card-color);
  border-radius: 32rpx 32rpx 0 0;
  height: 85vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding-top: 0;
  transform: translateY(100vh);
  transition: transform var(--dur-slow) var(--ease-silk);
  border-top: 1rpx solid var(--hairline);
  pointer-events: none;
}

.sku-popup.show {
  transform: translateY(0);
  pointer-events: auto;
}

/* 顶部品牌条：留白 · 精炼字体 · 植物线描 */
.sku-popup-brand-bar {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: var(--card-cream);
  flex-shrink: 0;
  padding: 26rpx 40rpx 22rpx;
  gap: 14rpx;
}

.brand-gold-thread {
  width: 48rpx;
  height: 1rpx;
  background: var(--mall-primary);
  opacity: 0.3;
  flex-shrink: 0;
}

.sku-popup-brand-text {
  font-size: 19rpx;
  font-weight: 300;
  color: var(--text-primary);
  letter-spacing: 0.32em;
  line-height: 1;
  font-family: var(--font-sans);
  white-space: nowrap;
  opacity: 0.85;
}

.brand-separator {
  width: 240rpx;
  height: 16rpx;
}

.sku-popup-close-btn {
  position: absolute;
  top: 96rpx;
  right: 24rpx;
  z-index: 10;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--card-cream);
  border-radius: 50%;
  border: 1rpx solid var(--hairline);
  transition: transform var(--dur-fast) var(--ease-refined);
}

.sku-popup-close-icon {
  width: 32rpx;
  height: 32rpx;
}

.sku-popup-close-btn--pressed {
  transform: scale(0.9);
}

.sku-popup-image-wrap {
  width: 100%;
  height: 400rpx;
  flex-shrink: 0;
  overflow: hidden;
  background: var(--card-cream);
}

.sku-popup-image {
  width: 100%;
  height: 100%;
}

.sku-popup-body {
  flex: 1;
  min-height: 0;
}

.sku-popup-body-inner {
  padding: 32rpx var(--page-padding) 16rpx;
}

/* 商品信息 */
.sku-product-info {
  margin-bottom: 32rpx;
}

.sku-product-name {
  font-size: 34rpx;
  font-weight: 500;
  color: var(--text-primary);
  display: block;
  line-height: 1.35;
  margin-bottom: 16rpx;
  letter-spacing: 0.01em;
  font-family: var(--font-serif);
}

.sku-product-meta {
  display: flex;
  align-items: baseline;
  gap: 20rpx;
  margin-bottom: 8rpx;
}

.sku-product-price {
  font-size: 44rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.01em;
  font-family: var(--font-sans);
  line-height: 1;
}

.sku-product-stock {
  font-size: 24rpx;
  color: var(--text-tertiary);
  font-weight: 400;
  letter-spacing: 0.04em;
  font-family: var(--font-sans);
}

.sku-product-selected {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 400;
  letter-spacing: 0.06em;
  font-family: var(--font-sans);
}

/* 规格分组 */
.sku-spec-section {
  margin-bottom: 32rpx;
}

.sku-spec-label {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-tertiary);
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
  letter-spacing: 0.15em;
  font-family: var(--font-sans);
}

.sku-spec-label .label-accent {
  width: 24rpx;
}

.sku-spec-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.sku-spec-option {
  padding: 16rpx 36rpx;
  border-radius: var(--zy-radius-xs);
  background: var(--accent-wash);
  border: 1rpx solid transparent;
  transition: transform var(--dur-fast) var(--ease-refined),
              background-color var(--dur-fast) var(--ease-refined),
              border-color var(--dur-fast) var(--ease-refined);
}

.sku-spec-option.selected {
  background: var(--card-color);
  border-color: var(--mall-primary);
}

.sku-spec-option.disabled {
  opacity: 0.35;
  pointer-events: none;
}

.sku-spec-option--pressed {
  transform: scale(0.95);
}

.sku-spec-option-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 400;
  letter-spacing: 0.02em;
  font-family: var(--font-sans);
}

.sku-spec-option.selected .sku-spec-option-text {
  color: var(--text-primary);
  font-weight: 500;
}

/* 数量 */
.sku-quantity-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-top: 1rpx solid var(--hairline);
}

.sku-quantity-section .sku-spec-label {
  margin-bottom: 0;
}

.sku-quantity-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.sku-qty-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--accent-wash);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 400;
  border: 1rpx solid var(--hairline);
  transition: transform var(--dur-fast) var(--ease-refined),
              background-color var(--dur-fast) var(--ease-refined);
}

.sku-qty-btn.disabled {
  opacity: 0.3;
}

.sku-qty-btn--pressed {
  transform: scale(0.9);
  background: var(--mall-accent);
}

.sku-qty-value {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  min-width: 56rpx;
  text-align: center;
  font-family: var(--font-sans);
}

/* 底部按钮 */
.sku-popup-footer {
  padding: 20rpx var(--page-padding);
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
  border-top: 1rpx solid var(--hairline);
  background: var(--card-color);
}

.sku-confirm-btn {
  width: 100%;
  padding: 26rpx 0;
  background: var(--gradient-secondary);
  border-radius: var(--zy-radius-xs);
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-on-accent);  /* 原 var(--text-inverse) */
  letter-spacing: 0.20em;
  box-shadow: var(--shadow-glow-mall);
  font-family: var(--font-sans);
  transition: transform var(--dur-fast) var(--ease-refined),
              opacity var(--dur-fast) var(--ease-refined);
}

.sku-confirm-btn--pressed {
  transform: scale(0.98);
}

.sku-confirm-btn.disabled {
  background: var(--text-tertiary);
  box-shadow: none;
  opacity: 0.5;
}

/* ── 加载状态（由 loading-animation.wxss 提供） ── */

/* ── 错误状态 ── */
.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  background: var(--background-color);
  padding: 0 40rpx;
  animation-name: fadeIn;
  animation-duration: 600ms;
  animation-timing-function: cubic-bezier(0.16,1,0.3,1);
  animation-fill-mode: forwards;
}

.error-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.4;
}

.error-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  text-align: center;
  margin-bottom: 40rpx;
  letter-spacing: 0.08em;
  font-weight: 400;
  font-family: var(--font-sans);
}

.retry-btn {
  padding: 20rpx 64rpx;
  background: var(--gradient-secondary);
  border-radius: var(--zy-radius-xs);
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-on-accent);  /* 原 var(--text-inverse) */
  letter-spacing: 0.20em;
  box-shadow: var(--shadow-glow-mall);
  font-family: var(--font-sans);
  transition: transform var(--dur-fast) var(--ease-refined);
}

.retry-btn--pressed {
  transform: scale(0.97);
}
