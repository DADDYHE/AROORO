@import '../../styles/loading-animation.wxss';

page {
  background: var(--background-color);
}

.page-container {
  min-height: 100vh;
  background: var(--background-color);
  padding-bottom: 160rpx;
}

/* ── 图片画廊 ── */
.image-gallery {
  position: relative;
  width: 100%;
  height: 600rpx;
  background: var(--gray-200);
}

.gallery-swiper {
  width: 100%;
  height: 100%;
}

.gallery-image {
  width: 100%;
  height: 100%;
}

.gallery-indicator {
  position: absolute;
  bottom: 28rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 10rpx;
}

.indicator-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.4);
}

.indicator-dot.active {
  background: var(--card-color);
  width: 24rpx;
  border-radius: 5rpx;
}

.gallery-badge {
  position: absolute;
  top: 28rpx;
  left: 28rpx;
  display: flex;
  gap: 10rpx;
}

.badge-tag {
  padding: 8rpx 20rpx;
  border-radius: 32rpx;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.badge-tag.on_sale {
  color: var(--mall-primary);
}

.badge-tag.featured {
  color: var(--tuan-primary);
}

.gallery-actions {
  position: absolute;
  top: 28rpx;
  right: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.gallery-action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.gallery-action-icon {
  width: 36rpx;
  height: 36rpx;
}

/* ── 页面内容区 ── */
.page-content {
  padding: 24rpx 32rpx;
}

/* ── 通用卡片 ── */
.info-card {
  background: var(--card-color);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(134, 134, 139, 0.1);
  position: relative;
  overflow: hidden;
}

.info-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: linear-gradient(90deg, var(--mall-primary) 0%, var(--mall-secondary) 50%, transparent 100%);
  border-radius: 24rpx 24rpx 0 0;
}

/* ── 商品信息 ── */
.product-name {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  line-height: 1.3;
  margin-bottom: 8rpx;
}

.product-subtitle {
  font-size: 26rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 24rpx;
}

.price-section {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.current-price {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--mall-primary);
}

.original-price {
  font-size: 24rpx;
  color: var(--text-tertiary);
  text-decoration: line-through;
}

.discount-tag {
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(156, 39, 176, 0.1);
  color: var(--mall-primary);
}

.meta-row {
  display: flex;
  gap: 32rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--divider-color);
}

.meta-item {
  font-size: 22rpx;
  color: var(--text-secondary);
  letter-spacing: 0.5rpx;
}

.meta-item .value {
  color: var(--text-primary);
  font-weight: 600;
}

/* ── 区块标题 ── */
.section-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  margin-bottom: 24rpx;
  letter-spacing: 1rpx;
}

/* ── 商品详情 ── */
.description-text {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.8;
  margin-bottom: 28rpx;
}

.detail-images {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.detail-image {
  width: 100%;
  border-radius: 16rpx;
}

/* ── 底部操作栏 ── */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-top: 1rpx solid rgba(134, 134, 139, 0.1);
  display: flex;
  align-items: center;
  gap: 24rpx;
  z-index: 100;
}

.bar-actions {
  display: flex;
  gap: 24rpx;
}

.bar-action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  position: relative;
}

.contact-btn {
  display: flex !important;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  position: relative;
  padding: 0 !important;
  margin: 0 !important;
  background: transparent !important;
  border: none !important;
  line-height: normal !important;
  min-width: 0 !important;
  width: auto !important;
  font-size: inherit !important;
  box-sizing: border-box;
}

.contact-btn::after {
  border: none !important;
}

.bar-action-icon-img {
  width: 40rpx;
  height: 40rpx;
}

.bar-action-text {
  font-size: 18rpx;
  color: var(--gray-500);
  letter-spacing: 1rpx;
}

.cart-badge {
  position: absolute;
  top: -8rpx;
  right: -16rpx;
  min-width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  text-align: center;
  background: var(--error-color);
  color: #FAFAF6;
  font-size: 18rpx;
  border-radius: 14rpx;
  padding: 0 6rpx;
}

.buy-buttons {
  flex: 1;
  display: flex;
  gap: 16rpx;
}

.cart-btn {
  flex: 1;
  padding: 22rpx 0;
  border: 2rpx solid rgba(156, 39, 176, 0.3);
  border-radius: 48rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--mall-primary);
  letter-spacing: 2rpx;
  background: linear-gradient(135deg, var(--card-color) 0%, #FAF5FC 100%);
}

.buy-btn {
  flex: 1;
  padding: 22rpx 0;
  background: linear-gradient(135deg, var(--mall-primary) 0%, var(--mall-secondary) 100%);
  border-radius: 48rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--card-color);
  letter-spacing: 2rpx;
  box-shadow: 0 6rpx 16rpx rgba(156, 39, 176, 0.3);
}

/* ── 规格选择弹窗（参考设计稿风格） ── */
.sku-popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
  opacity: 0;
  visibility: hidden;
}

.sku-popup-mask.show {
  opacity: 1;
  visibility: visible;
}

.sku-popup {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 201;
  background: var(--card-color);
  border-radius: 48rpx 48rpx 0 0;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
  overflow: visible;
  padding-top: 28rpx;
}

.sku-popup::before {
  content: '';
  position: absolute;
  top: -28rpx;
  left: 0;
  right: 0;
  height: 76rpx;
  background: #9ED44A;
  border-radius: 48rpx 48rpx 0 0;
  z-index: -1;
}

.sku-popup.show {
}

.sku-popup-brand-bar {
  position: absolute;
  top: -28rpx;
  left: 0;
  right: 0;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
}

.sku-popup-brand-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: 1rpx;
  line-height: 1;
  position: relative;
  top: -7rpx;
}

.sku-popup-close-btn {
  position: absolute;
  top: 20rpx;
  right: 24rpx;
  z-index: 10;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.35);
  border-radius: 50%;
  backdrop-filter: blur(4px);
}

.sku-popup-image-wrap {
  width: 100%;
  height: 420rpx;
  flex-shrink: 0;
  overflow: hidden;
}

.sku-popup-image {
  width: 100%;
  height: 100%;
}

.sku-popup-body {
  flex: 1;
  min-height: 0;
}

.sku-popup-body-inner {
  padding: 28rpx 32rpx 16rpx;
}

/* 商品信息 */
.sku-product-info {
  margin-bottom: 28rpx;
}

.sku-product-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  line-height: 1.3;
  margin-bottom: 12rpx;
}

.sku-product-meta {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.sku-product-price {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--mall-primary);
}

.sku-product-stock {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.sku-product-selected {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 规格分组 */
.sku-spec-section {
  margin-bottom: 28rpx;
}

.sku-spec-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  margin-bottom: 16rpx;
  letter-spacing: 1rpx;
}

.sku-spec-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.sku-spec-option {
  padding: 14rpx 36rpx;
  border-radius: 40rpx;
  background: var(--divider-color);
  border: 2rpx solid transparent;
}

.sku-spec-option.selected {
  background: rgba(79, 94, 53, 0.1);
  border-color: var(--primary-color);
}

.sku-spec-option.disabled {
  opacity: 0.35;
  pointer-events: none;
}

.sku-spec-option-text {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.sku-spec-option.selected .sku-spec-option-text {
  color: var(--primary-color);
  font-weight: 600;
}

/* 数量 */
.sku-quantity-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-top: 1rpx solid var(--divider-color);
}

.sku-quantity-section .sku-spec-label {
  margin-bottom: 0;
}

.sku-quantity-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.sku-qty-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--divider-color);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.sku-qty-btn.disabled {
  opacity: 0.35;
}

.sku-qty-value {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  min-width: 48rpx;
  text-align: center;
}

/* 底部按钮 */
.sku-popup-footer {
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
}

.sku-confirm-btn {
  width: 100%;
  padding: 26rpx 0;
  background: linear-gradient(135deg, var(--primary-color) 0%, #3d4a29 100%);
  border-radius: 48rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: 2rpx;
  box-shadow: 0 8rpx 24rpx rgba(79, 94, 53, 0.3);
}

.sku-confirm-btn.disabled {
  background: var(--text-tertiary);
  box-shadow: none;
  pointer-events: none;
}

/* ── 加载状态 ── */

.loading-dot:nth-child(2) {
}

.loading-dot:nth-child(3) {
}

/* ── 错误状态 ── */
.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  background: var(--background-color);
  padding: 0 40rpx;
}

.error-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  color: var(--text-tertiary);
}

.error-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  text-align: center;
  margin-bottom: 40rpx;
}

.retry-btn {
  padding: 18rpx 56rpx;
  background: linear-gradient(135deg, var(--mall-primary) 0%, var(--mall-secondary) 100%);
  border-radius: 48rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--card-color);
  letter-spacing: 2rpx;
  box-shadow: 0 6rpx 16rpx rgba(156, 39, 176, 0.3);
}


