<view class="container">
  <!-- 步骤指示器 -->
  <custom-steps 
    currentActive="{{currentActive}}" 
    stepsData="{{stepsData}}"
    height="80rpx"
  />

  <!-- 表单内容 -->
  <view class="form-container">
    <!-- 身份证正面 -->
    <view class="form-item">
      <view class="label">身份证正面</view>
      <view class="upload-area" bind:tap="chooseIdCardFront">
        <image 
          wx:if="{{formData.idCardFront}}" 
          class="preview-image" 
          src="{{formData.idCardFront}}" 
          mode="aspectFill"
          bind:tap="previewImage"
          data-src="{{formData.idCardFront}}"
        />
        <view wx:else class="upload-text">点击上传身份证正面</view>
      </view>
    </view>

    <!-- 身份证反面 -->
    <view class="form-item">
      <view class="label">身份证反面</view>
      <view class="upload-area" bind:tap="chooseIdCardBack">
        <image 
          wx:if="{{formData.idCardBack}}" 
          class="preview-image" 
          src="{{formData.idCardBack}}" 
          mode="aspectFill"
          bind:tap="previewImage"
          data-src="{{formData.idCardBack}}"
        />
        <view wx:else class="upload-text">点击上传身份证反面</view>
      </view>
    </view>



    <!-- 紧急联系人姓名 -->
    <van-field
      label="紧急联系人姓名"
      value="{{formData.emergencyContactName}}"
      placeholder="请输入紧急联系人姓名"
      bind:input="onEmergencyContactNameInput"
      extra-event-params="{{ true }}"
    />

    <!-- 紧急联系人电话 -->
    <van-field
      label="紧急联系人电话"
      value="{{formData.emergencyContactPhone}}"
      placeholder="请输入紧急联系人电话"
      type="tel"
      bind:input="onEmergencyContactPhoneInput"
      extra-event-params="{{ true }}"
    />
  </view>

  <!-- 底部按钮 -->
  <view class="bottom-button">
    <button class="prev-button" bindtap="prevStep">上一步</button>
    <button class="next-button" bindtap="submit" loading="{{isLoading}}">提交注册</button>
  </view>
</view>
