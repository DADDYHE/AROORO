<view class="container">
  <!-- 步骤指示器 -->
  <custom-steps 
    active="{{currentActive}}" 
    steps="{{steps}}"
  />

  <!-- 授权提示弹窗 -->
  <view wx:if="{{showPrivacyAuthorization}}" class="privacy-auth-overlay">
    <view class="privacy-auth-content">
      <view class="privacy-auth-title">隐私信息收集授权</view>
      <view class="privacy-auth-desc">
        <view class="privacy-auth-item">
          <text class="privacy-auth-item-title">真实姓名、身份证号码：</text>
          <text class="privacy-auth-item-content">用于寄养家庭资质审核和实名认证，确保服务提供者身份真实可靠</text>
        </view>
        <view class="privacy-auth-item">
          <text class="privacy-auth-item-title">手机号码：</text>
          <text class="privacy-auth-item-content">用于订单联系、服务通知和紧急情况联系</text>
        </view>
        <view class="privacy-auth-item">
          <text class="privacy-auth-item-title">收集目的：</text>
          <text class="privacy-auth-item-content">为了提供安全、可靠的寄养服务，保护宠物和用户权益</text>
        </view>
        <view class="privacy-auth-item">
          <text class="privacy-auth-item-title">信息保护：</text>
          <text class="privacy-auth-item-content">我们将严格保护您的个人信息，仅用于必要的服务场景，不会泄露给第三方</text>
        </view>
      </view>
      <view class="privacy-auth-agree">
        <view class="privacy-auth-agree-text">
          点击"同意"，即表示您同意我们按照
          <text class="privacy-policy-link" bindtap="openPrivacyPolicy">《隐私政策》</text>
          处理您的个人信息，并授权我们收集和使用上述信息用于寄养家庭注册和服务提供
        </view>
      </view>
      <view class="privacy-auth-buttons">
        <button class="privacy-auth-cancel" bindtap="cancelPrivacyAuthorization">
          取消
        </button>
        <button class="privacy-auth-confirm" bindtap="confirmPrivacyAuthorization">
          同意并继续
        </button>
      </view>
    </view>
  </view>

  <!-- 表单内容 -->
  <view class="form-container">
    <!-- 家庭头像 -->
    <view class="avatar-section">
      <view class="avatar-label">家庭头像</view>
      <view class="avatar-uploader">
        <view class="avatar-preview" bindtap="chooseAvatar">
          <image wx:if="{{formData.avatarUrl}}" src="{{formData.avatarUrl}}" mode="aspectFill" class="avatar-image"></image>
          <view wx:else class="avatar-placeholder">
            <view class="avatar-hint">点击上传家庭头像</view>
          </view>
          <view class="avatar-overlay">
            <van-icon name="camera" size="32rpx" color="#ffffff"></van-icon>
          </view>
        </view>
      </view>
    </view>

  <!-- 自定义头像预览弹窗 -->
  <view wx:if="{{showAvatarPreview}}" class="avatar-preview-overlay">
    <view class="avatar-preview-container">
      <view class="avatar-preview-content">
        <image src="{{previewAvatarUrl}}" mode="widthFix" class="avatar-preview-image"></image>
      </view>
      <view class="avatar-preview-actions">
        <button class="avatar-preview-cancel" bindtap="cancelAvatarPreview">取消</button>
        <button class="avatar-preview-confirm" bindtap="confirmAvatarPreview">确定</button>
      </view>
    </view>
  </view>

    <!-- 家庭名称 -->
    <van-field
      label="家庭名称"
      value="{{formData.hostName}}"
      placeholder="请输入家庭名称"
      bind:input="onHostNameInput"
      extra-event-params="{{ true }}"
    />

    <!-- 真实姓名 -->
    <van-field
      label="真实姓名"
      value="{{formData.realName}}"
      placeholder="请输入真实姓名"
      bind:input="onRealNameInput"
      extra-event-params="{{ true }}"
    />

    <!-- 手机号码 -->
    <van-field
      label="手机号码"
      value="{{formData.phone}}"
      placeholder="请输入手机号码"
      type="tel"
      bind:input="onPhoneInput"
      bind:blur="onPhoneBlur"
      error-message="{{phoneError}}"
      extra-event-params="{{ true }}"
    />

    <!-- 身份证号 -->
    <van-field
      label="身份证号"
      value="{{formData.idCard}}"
      placeholder="请输入身份证号"
      bind:input="onIdCardInput"
      bind:blur="onIdCardBlur"
      error-message="{{idCardError}}"
      extra-event-params="{{ true }}"
    />

    <!-- 详细地址 - 位置服务选择 -->
    <view class="address-section">
      <view class="address-label">详细地址</view>
      
      <!-- 城市选择 -->
      <view class="city-selector">
        <view class="city-label">城            市</view>
        <picker
          mode="selector"
          range="{{['成都市']}}"
          value="{{0}}"
          bindchange="confirmCitySelection"
          class="city-picker"
        >
          <view class="city-picker-display">
            <text wx:if="{{cityName}}" class="city-picker-text">{{cityName}}</text>
            <text wx:else class="city-picker-text">请选择城市</text>
          </view>
        </picker>
      </view>
      
      <!-- 详细地址选择（接入位置服务） -->
      <view class="location-selector">
        <view class="location-label">详细地址</view>
        <view class="location-picker" bindtap="chooseLocation">
          <view class="location-picker-content">
            <view class="location-picker-display">
              <text wx:if="{{formData.address}}" class="location-picker-text">{{formData.address}}</text>
              <text wx:else class="location-picker-placeholder">点击选择地址</text>
            </view>
            <view class="location-picker-icon">
              <van-icon name="location" size="24rpx" color="#666666"></van-icon>
            </view>
          </view>
        </view>
      </view>
      
      <!-- 楼栋单元门牌号 -->
      <van-field
        label="门牌号"
        value="{{formData.addressDetail}}"
        placeholder="请输入楼栋、单元、门牌号"
        bind:input="onAddressDetailInput"
        extra-event-params="{{ true }}"
      />
    </view>
  </view>

  <!-- 底部按钮 -->
  <view class="bottom-button">
    <button 
      class="next-button"
      bindtap="nextStep"
      loading="{{isLoading}}"
    >
      下一步
    </button>
  </view>

</view>
