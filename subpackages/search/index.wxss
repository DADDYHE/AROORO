.search-page {
  min-height: 100vh;
  background: var(--background-color, #F8FAF3);
  font-family: -apple-system, "PingFang SC", "HarmonyOS Sans SC", "Helvetica Neue", sans-serif;
}

/* ===== 搜索栏 ===== */
.search-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 16rpx 32rpx;
  background: #FFFFFF;
  position: sticky;
  top: 0;
  z-index: 10;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  background: var(--background-color, #F8FAF3);
  border-radius: var(--border-radius-pill, 999rpx);
  padding: 16rpx 28rpx;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid var(--text-tertiary, #999);
  border-radius: 50%;
  position: relative;
  flex-shrink: 0;
}

.search-icon::after {
  content: '';
  position: absolute;
  right: -7rpx;
  bottom: -7rpx;
  width: 14rpx;
  height: 3rpx;
  background: var(--text-tertiary, #999);
  border-radius: 2rpx;
  transform: rotate(45deg);
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary, #333);
}

.clear-btn {
  font-size: 36rpx;
  color: var(--text-tertiary, #999);
  line-height: 1;
  padding: 0 8rpx;
}

.cancel-btn {
  font-size: 28rpx;
  color: var(--text-secondary, #666);
  flex-shrink: 0;
}

/* ===== 历史 & 热门 ===== */
.suggest-section {
  padding: 32rpx;
}

.suggest-block {
  margin-bottom: 40rpx;
}

.suggest-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.suggest-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary, #333);
}

.suggest-clear {
  font-size: 24rpx;
  color: var(--text-tertiary, #999);
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.tag-item {
  font-size: 26rpx;
  color: var(--text-secondary, #666);
  background: #FFFFFF;
  padding: 14rpx 32rpx;
  border-radius: var(--border-radius-pill, 999rpx);
}

.tag-hot {
  color: var(--primary-color, #4F5E35);
  background: rgba(79, 94, 53, 0.08);
}

/* ===== 分类 Tab ===== */
.result-section {
  padding-top: 16rpx;
}

.tab-bar {
  white-space: nowrap;
  padding: 0 32rpx 24rpx;
  background: #FFFFFF;
}

.tab-item {
  display: inline-block;
  font-size: 28rpx;
  color: var(--text-secondary, #666);
  padding: 12rpx 32rpx;
  margin-right: 16rpx;
  border-radius: var(--border-radius-pill, 999rpx);
  background: var(--background-color, #F8FAF3);
}

.tab-active {
  color: #FFFFFF;
  background: var(--primary-color, #4F5E35);
  font-weight: 500;
}

/* ===== 加载 & 空状态 ===== */
.loading-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 80rpx 0;
  font-size: 28rpx;
  color: var(--text-tertiary, #999);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0 80rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: var(--text-secondary, #666);
  margin-bottom: 8rpx;
}

.empty-sub {
  font-size: 26rpx;
  color: var(--text-tertiary, #999);
}

/* ===== 结果列表 ===== */
.result-list {
  padding: 24rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.result-card {
  display: flex;
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.result-img {
  width: 200rpx;
  height: 200rpx;
  object-fit: cover;
  flex-shrink: 0;
}

.result-img-ph {
  background: var(--primary-light, #F0F2E8);
  display: flex;
  align-items: center;
  justify-content: center;
}

.result-img-ph-text {
  font-size: 32rpx;
  color: var(--text-tertiary, #999);
}

.result-body {
  flex: 1;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
  min-width: 0;
}

.result-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.result-type-badge {
  font-size: 20rpx;
  color: var(--primary-color, #4F5E35);
  background: rgba(79, 94, 53, 0.1);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  line-height: 1.4;
}

.result-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary, #333);
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  min-width: 0;
}

.result-sub {
  font-size: 24rpx;
  color: var(--text-tertiary, #999);
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-price {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--primary-color, #4F5E35);
  line-height: 1.2;
  margin-top: 4rpx;
}
