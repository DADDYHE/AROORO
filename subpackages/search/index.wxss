/* subpackages/search/index.wxss */
/* AROORO 轻奢宠物 - 搜索页面（primary 中性色调，热门搜索金色 tint） */

/* ===== 入场动画 ===== */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ===== 页面容器 ===== */
.search-page {
  min-height: 100vh;
}

/* ===== 搜索栏 ===== */
.search-header {
  display: flex;
  align-items: center;
  gap: var(--zy-space-lg);
  padding: 16rpx var(--page-padding);
  background: var(--card-color);
  position: relative;
  z-index: 10;
  border-bottom: 1rpx solid var(--hairline);
}

.search-input-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  background: var(--card-cream);
  border-radius: var(--zy-radius-pill);
  padding: 16rpx 28rpx;
  border: 1rpx solid var(--hairline);
}

.search-icon {
  width: 28rpx;
  height: 28rpx;
  border: 2rpx solid var(--text-tertiary);
  border-radius: 50%;
  position: relative;
  flex-shrink: 0;
}

.search-icon::after {
  content: '';
  position: absolute;
  right: -6rpx;
  bottom: -6rpx;
  width: 12rpx;
  height: 2rpx;
  background: var(--text-tertiary);
  border-radius: 2rpx;
  transform: rotate(45deg);
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
  letter-spacing: 0.02em;
}

.clear-btn {
  font-size: 32rpx;
  color: var(--text-tertiary);
  line-height: 1;
  padding: 0 8rpx;
  font-weight: 300;
  transition: transform var(--transition-fast), opacity var(--transition-fast);
}

.clear-btn.pressed {
  transform: scale(0.92);
  opacity: 0.7;
}

.cancel-btn {
  font-size: 28rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
  letter-spacing: 0.02em;
  padding: 8rpx 0;
  transition: transform var(--transition-fast), opacity var(--transition-fast);
}

.cancel-btn.pressed {
  transform: scale(0.96);
  opacity: 0.7;
}

/* ===== 历史 & 热门推荐 ===== */
.suggest-section {
  padding: var(--zy-space-lg) var(--page-padding);
  animation-name: fadeInUp;
  animation-duration: 500ms;
  animation-timing-function: cubic-bezier(0.19,1,0.22,1);
  animation-fill-mode: forwards;
}

.suggest-block {
  margin-bottom: var(--zy-space-lg);
}

.suggest-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--zy-space-lg);
}

.suggest-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.04em;
}

.suggest-clear {
  font-size: 24rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.02em;
  padding: 8rpx;
  transition: transform var(--transition-fast), opacity var(--transition-fast);
}

.suggest-clear.pressed {
  transform: scale(0.96);
  opacity: 0.7;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-item {
  font-size: 24rpx;
  color: var(--text-secondary);
  background: var(--card-color);
  padding: 12rpx 28rpx;
  border-radius: var(--zy-radius-pill);
  border: 1rpx solid var(--hairline);
  letter-spacing: 0.02em;
  transition: transform var(--transition-fast), opacity var(--transition-fast);
}

.tag-item.pressed {
  transform: scale(0.96);
  opacity: 0.85;
}

/* 热门搜索 - 金色 tint */
.tag-hot {
  color: #1F3A1F;
  background: var(--accent-wash);
  border-color: rgba(201,162,75,0.2);
}

/* ===== 分类 Tab ===== */
.result-section {
  padding-top: 16rpx;
}

/* ===== 加载 & 空状态 ===== */
.loading-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 80rpx 0;
  font-size: 26rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.04em;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0 80rpx;
  animation-name: fadeInUp;
  animation-duration: 500ms;
  animation-timing-function: cubic-bezier(0.19,1,0.22,1);
  animation-fill-mode: forwards;
}

.empty-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.3;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
  letter-spacing: 0.04em;
}

.empty-sub {
  font-size: 24rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.02em;
}

/* ===== 结果列表 ===== */
.result-list {
  padding: var(--zy-space-lg) var(--page-padding);
  display: flex;
  flex-direction: column;
  gap: var(--zy-space-lg);
  animation-name: fadeInUp;
  animation-duration: 500ms;
  animation-timing-function: cubic-bezier(0.19,1,0.22,1);
  animation-fill-mode: forwards;
}

.result-card {
  display: flex;
  background: var(--card-color);
  border-radius: var(--zy-radius-lg);
  overflow: hidden;
  border: 1rpx solid var(--hairline);
  transition: transform var(--transition-fast), opacity var(--transition-fast);
}

.result-card.pressed {
  transform: scale(0.98);
  opacity: 0.92;
}

.result-img {
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
}

.result-img-ph {
  background: var(--primary-tint);
  display: flex;
  align-items: center;
  justify-content: center;
}

.result-img-ph-text {
  font-size: 28rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.04em;
}

.result-body {
  flex: 1;
  padding: var(--zy-space-lg);
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
  min-width: 0;
}

.result-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.result-type-badge {
  font-size: 20rpx;
  color: var(--primary-color);
  background: var(--primary-tint);
  padding: 4rpx 14rpx;
  border-radius: var(--zy-radius-sm);
  flex-shrink: 0;
  line-height: 1.4;
  letter-spacing: 0.02em;
  font-weight: 400;
}

.result-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  min-width: 0;
  letter-spacing: 0.02em;
}

.result-sub {
  font-size: 22rpx;
  color: var(--text-tertiary);
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  letter-spacing: 0.02em;
}

.result-price {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--primary-color);
  line-height: 1.2;
  margin-top: 4rpx;
  letter-spacing: 0.02em;
}
