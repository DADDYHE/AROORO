/* subpackages/coupon/claim-center.wxss */
/* AROORO 轻奢宠物 - 领券中心（豪华礼券风格） */

/* ===== 入场动画 ===== */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(32rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ===== 容器 ===== */
.container {
  padding: 20rpx var(--page-padding);
  background: var(--background-color);
  min-height: 100vh;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

/* ===== 优惠券卡片（豪华礼券） ===== */
.coupon-card {
  position: relative;
  background: var(--coupon-gradient);
  border-radius: var(--zy-radius-lg);
  margin-bottom: 24rpx;
  overflow: hidden;
  border: 1rpx solid var(--border-gold-on-dark, rgba(201,162,75,0.30));
  animation-name: fadeInUp;
  animation-duration: 600ms;
  animation-timing-function: cubic-bezier(0.19,1,0.22,1);
  animation-fill-mode: forwards;
}

/* 顶部金色细边 */
.card-ribbon {
  height: 2rpx;
  background: linear-gradient(90deg, transparent 0%, var(--accent-color) 20%, var(--accent-color) 80%, transparent 100%);
  opacity: 0.6;
}

/* 齿孔装饰（左右半圆缺口） */
.coupon-card::before,
.coupon-card::after {
  content: '';
  position: absolute;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: var(--background-color);
  z-index: 2;
  top: 50%;
  transform: translateY(-50%);
}

.coupon-card::before {
  left: -10rpx;
}

.coupon-card::after {
  right: -10rpx;
}

/* ===== 卡片主体 ===== */
.card-body {
  position: relative;
  display: flex;
  padding: 32rpx 28rpx 24rpx;
  gap: 24rpx;
}

/* 暗纹装饰 */
.card-body::before {
  content: '';
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, var(--bg-gold-on-dark, rgba(201,162,75,0.15)) 0%, transparent 70%);
  pointer-events: none;
}

/* ===== 金额区 ===== */
.card-main {
  flex-shrink: 0;
  width: 180rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  border-right: 1rpx dashed var(--border-gold-on-dark, rgba(201,162,75,0.30));
  padding-right: 24rpx;
}

.card-value {
  display: flex;
  align-items: baseline;
  color: var(--text-gold-on-dark);
}

.card-value .num {
  font-size: 64rpx;
  font-weight: 300;
  line-height: 1;
  letter-spacing: -0.02em;
}

.card-value .unit {
  font-size: 26rpx;
  margin-right: 4rpx;
  color: var(--accent-soft);
  font-weight: 400;
  letter-spacing: 0.02em;
}

.card-threshold {
  font-size: 22rpx;
  color: var(--text-on-dark-50, rgba(247,245,239,0.50));
  margin-top: 8rpx;
  letter-spacing: 0.02em;
  font-weight: 300;
}

/* ===== 信息区 ===== */
.card-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}

.card-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-on-primary);
  margin-bottom: 12rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  letter-spacing: 0.04em;
}

.card-scopes {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  align-items: center;
}

.scope-label {
  font-size: 20rpx;
  color: var(--text-on-dark-50, rgba(247,245,239,0.50));
  font-weight: 300;
  letter-spacing: 0.02em;
}

.scope-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  background: var(--bg-gold-on-dark, rgba(201,162,75,0.15));
  color: var(--accent-soft);
  border-radius: var(--zy-radius-sm);
  border: 1rpx solid var(--border-gold-on-dark, rgba(201,162,75,0.30));
  font-weight: 300;
  letter-spacing: 0.02em;
}

/* ===== 底部操作栏 ===== */
.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 28rpx 24rpx;
  border-top: 1rpx dashed var(--bg-gold-on-dark, rgba(201,162,75,0.15));
}

.card-stock {
  font-size: 22rpx;
  color: var(--text-on-dark-50, rgba(247,245,239,0.50));
  letter-spacing: 0.02em;
  font-weight: 300;
}

.card-claim-btn {
  font-size: 24rpx;
  padding: 14rpx 36rpx;
  background: var(--gradient-secondary);
  color: var(--text-on-accent);  /* 原 var(--primary-deep) */
  border-radius: var(--zy-radius-pill);
  font-weight: 500;
  letter-spacing: 0.08em;
  border: none;
  box-shadow: var(--shadow-glow-mall);
  transition: transform var(--transition-fast), opacity var(--transition-fast);
}

.card-claim-btn.pressed {
  transform: scale(0.95);
  opacity: 0.9;
}

.card-claim-btn.disabled {
  background: var(--text-on-dark-50, rgba(247,245,239,0.50));
  color: var(--text-on-dark-50, rgba(247,245,239,0.50));
  box-shadow: none;
  border: 1rpx solid var(--text-on-dark-50, rgba(247,245,239,0.50));
}

/* ===== 空状态 & 加载更多 ===== */
.empty {
  text-align: center;
  padding: 120rpx 0;
  color: var(--text-tertiary);
  font-size: 26rpx;
  letter-spacing: 0.06em;
  font-weight: 300;
}

.load-more {
  text-align: center;
  padding: 24rpx 0 60rpx;
  color: var(--text-tertiary);
  font-size: 24rpx;
  letter-spacing: 0.04em;
  font-weight: 300;
}

.bottom-tip {
  text-align: center;
  padding: 40rpx 0 20rpx;
  color: var(--text-tertiary);
  font-size: 22rpx;
  letter-spacing: 0.06em;
  font-weight: 300;
}
