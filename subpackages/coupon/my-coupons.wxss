/* subpackages/coupon/my-coupons.wxss */
/* AROORO 轻奢宠物 - 我的优惠券（豪华礼券风格） */

/* ===== 入场动画 ===== */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(32rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ===== 容器 ===== */
.container {
  padding: 20rpx var(--page-padding);
  background: var(--background-color);
  min-height: 100vh;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* ===== 领券中心入口（悬浮胶囊） ===== */
.claim-entry-fab {
  position: fixed;
  left: var(--page-padding);
  right: var(--page-padding);
  bottom: 40rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--coupon-gradient);
  border-radius: var(--zy-radius-pill);
  padding: 20rpx 28rpx;
  box-shadow: var(--shadow-glow-coupon);
  z-index: 99;
  border: 1rpx solid var(--border-gold-on-dark, rgba(201,162,75,0.30));
  transition: transform var(--transition-fast), opacity var(--transition-fast);
}

.claim-entry-fab.pressed {
  transform: scale(0.98);
  opacity: 0.92;
}

.claim-entry-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--gradient-secondary);
  color: var(--text-on-accent);  /* 原 var(--primary-deep) */
  font-size: 30rpx;
  line-height: 56rpx;
  text-align: center;
  font-weight: 300;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.claim-entry-text {
  flex: 1;
}

.claim-entry-title {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-gold-on-dark);
  letter-spacing: 0.06em;
}

.claim-entry-desc {
  font-size: 20rpx;
  color: var(--text-on-dark-70, rgba(247,245,239,0.70));
  margin-top: 4rpx;
  letter-spacing: 0.02em;
  font-weight: 300;
}

.claim-entry-arrow {
  font-size: 32rpx;
  color: var(--text-gold-on-dark);
  line-height: 1;
  font-weight: 300;
}

/* ===== 底部提示 ===== */
.bottom-tip {
  text-align: center;
  padding: 40rpx 0 20rpx;
  color: var(--text-tertiary);
  font-size: 22rpx;
  letter-spacing: 0.06em;
  font-weight: 300;
}

/* ===== Tab 栏 ===== */
.tabs {
  display: flex;
  gap: 12rpx;
  padding: 10rpx 0 28rpx;
  animation-name: fadeInUp;
  animation-duration: 500ms;
  animation-timing-function: cubic-bezier(0.19,1,0.22,1);
  animation-fill-mode: forwards;
}

.tab {
  padding: 14rpx 32rpx;
  background: var(--card-color);
  border-radius: var(--zy-radius-pill);
  font-size: 24rpx;
  color: var(--text-secondary);
  border: 1rpx solid var(--hairline);
  font-weight: 400;
  letter-spacing: 0.04em;
  transition: transform var(--transition-fast), opacity var(--transition-fast);
}

.tab.pressed {
  transform: scale(0.96);
}

.tab-active {
  background: var(--primary-deep);
  color: var(--text-gold-on-dark);
  border-color: var(--accent-deep);
}

/* ===== 优惠券卡片（豪华礼券） ===== */
.coupon-card {
  position: relative;
  background: var(--coupon-gradient);
  border-radius: var(--zy-radius-lg);
  margin-bottom: 24rpx;
  overflow: hidden;
  border: 1rpx solid var(--border-gold-on-dark, rgba(201,162,75,0.30));
  animation-name: fadeInUp;
  animation-duration: 600ms;
  animation-timing-function: cubic-bezier(0.19,1,0.22,1);
  animation-fill-mode: forwards;
}

/* 顶部金色细边 */
.card-ribbon {
  height: 2rpx;
  background: linear-gradient(90deg, transparent 0%, var(--accent-color) 20%, var(--accent-color) 80%, transparent 100%);
  opacity: 0.6;
}

/* 齿孔装饰（左右半圆缺口） */
.coupon-card::before,
.coupon-card::after {
  content: '';
  position: absolute;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: var(--background-color);
  z-index: 2;
  top: 50%;
  transform: translateY(-50%);
}

.coupon-card::before {
  left: -10rpx;
}

.coupon-card::after {
  right: -10rpx;
}

/* 暗纹装饰 */
.coupon-card .card-body::before {
  content: '';
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, var(--bg-gold-on-dark, rgba(201,162,75,0.15)) 0%, transparent 70%);
  pointer-events: none;
}

/* ===== 卡片主体 ===== */
.card-body {
  position: relative;
  padding: 36rpx 36rpx 28rpx;
  display: flex;
  gap: 28rpx;
}

/* ===== 金额区（金色视觉锚点） ===== */
.card-main {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-right: 28rpx;
  border-right: 1rpx dashed var(--border-gold-on-dark, rgba(201,162,75,0.30));
  min-width: 180rpx;
}

.card-value {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  color: var(--text-gold-on-dark);
}

.card-value .num {
  font-size: 72rpx;
  font-weight: 300;
  letter-spacing: -0.02em;
  line-height: 1;
}

.card-value .unit {
  font-size: 26rpx;
  font-weight: 400;
  color: var(--accent-soft);
  letter-spacing: 0.02em;
}

.card-threshold {
  font-size: 22rpx;
  color: var(--text-on-dark-50, rgba(247,245,239,0.50));
  margin-top: 10rpx;
  letter-spacing: 0.04em;
  font-weight: 300;
}

/* ===== 信息区 ===== */
.card-info {
  flex: 1;
  padding-top: 6rpx;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.card-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-on-primary);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  letter-spacing: 0.04em;
}

.card-scopes {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
  margin-top: 14rpx;
}

.scope-label {
  font-size: 20rpx;
  color: var(--text-on-dark-50, rgba(247,245,239,0.50));
  margin-right: 2rpx;
  font-weight: 300;
  letter-spacing: 0.02em;
}

.scope-tag {
  padding: 4rpx 12rpx;
  border: 1rpx solid var(--border-gold-on-dark, rgba(201,162,75,0.30));
  border-radius: var(--zy-radius-sm);
  font-size: 20rpx;
  color: var(--accent-soft);
  background: var(--bg-gold-on-dark, rgba(201,162,75,0.15));
  font-weight: 300;
  letter-spacing: 0.02em;
}

/* ===== 底部操作栏 ===== */
.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 36rpx 28rpx;
  border-top: 1rpx dashed var(--bg-gold-on-dark, rgba(201,162,75,0.15));
}

.card-stock {
  font-size: 22rpx;
  color: var(--text-on-dark-50, rgba(247,245,239,0.50));
  letter-spacing: 0.02em;
  font-weight: 300;
}

.card-time {
  font-size: 22rpx;
  color: var(--text-on-dark-50, rgba(247,245,239,0.50));
  letter-spacing: 0.02em;
  font-weight: 300;
}

/* ===== 操作按钮 — 金色描边 ===== */
.card-claim-btn,
.card-use-btn {
  padding: 12rpx 32rpx;
  border: 1rpx solid var(--accent-color);
  border-radius: var(--zy-radius-pill);
  font-size: 22rpx;
  color: var(--text-gold-on-dark);
  background: transparent;
  font-weight: 400;
  letter-spacing: 0.08em;
  transition: transform var(--transition-fast), background-color var(--transition-fast), color var(--transition-fast);
}

.card-claim-btn.pressed,
.card-use-btn.pressed {
  transform: scale(0.95);
  background: var(--accent-color);
  color: var(--text-on-accent);  /* 原 var(--primary-deep) */
}

.card-use-btn {
  background: var(--gradient-secondary);
  color: var(--text-on-accent);  /* 原 var(--primary-deep) */
  border-color: transparent;
  box-shadow: var(--shadow-glow-mall);
  font-weight: 500;
}

.card-claim-btn.disabled {
  border-color: var(--text-on-dark-50, rgba(247,245,239,0.50));
  color: var(--text-on-dark-50, rgba(247,245,239,0.50));
}

/* ===== 状态印章 ===== */
.card-stamp {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  letter-spacing: 0.08em;
  font-weight: 400;
  z-index: 3;
}

.card-stamp.status-unused {
  border: 1rpx solid var(--accent-color);
  color: var(--text-gold-on-dark);
}

.card-stamp.status-used {
  border: 1rpx solid var(--text-on-dark-50, rgba(247,245,239,0.50));
  color: var(--text-on-dark-50, rgba(247,245,239,0.50));
}

.card-stamp.status-expired {
  border: 1rpx solid var(--text-on-dark-50, rgba(247,245,239,0.50));
  color: var(--text-on-dark-50, rgba(247,245,239,0.50));
}

/* ===== 已使用 / 已过期状态 ===== */
.coupon-card.used,
.coupon-card.expired {
  opacity: 0.4;
}

.coupon-card.used .card-value,
.coupon-card.expired .card-value {
  color: var(--text-on-dark-50, rgba(247,245,239,0.50));
}

.coupon-card.used .card-name,
.coupon-card.expired .card-name {
  color: var(--text-on-dark-50, rgba(247,245,239,0.50));
}

.coupon-card.used .card-use-btn,
.coupon-card.expired .card-use-btn,
.coupon-card.used .card-claim-btn,
.coupon-card.expired .card-claim-btn {
  border-color: var(--text-on-dark-50, rgba(247,245,239,0.50));
  color: var(--text-on-dark-50, rgba(247,245,239,0.50));
  background: transparent;
  box-shadow: none;
}

/* ===== 空状态 & 加载更多 ===== */
.empty {
  text-align: center;
  padding: 120rpx var(--page-padding);
  color: var(--text-tertiary);
  font-size: 26rpx;
  letter-spacing: 0.06em;
  font-weight: 300;
}

.load-more {
  text-align: center;
  padding: 40rpx;
  color: var(--text-primary);
  font-size: 24rpx;
  letter-spacing: 0.06em;
  font-weight: 300;
}
