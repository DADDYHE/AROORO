/* Gallery Voucher — 画廊展陈风格 */

/* 容器 */
.container { padding: 20rpx; background: #F7F6F3; min-height: 100vh; }

/* 领券中心入口（固定底部，窄一点） */
.claim-entry-fab {
  position: fixed; left: 60rpx; right: 60rpx; bottom: 40rpx;
  display: flex; align-items: center; gap: 16rpx;
  background: linear-gradient(135deg, #FFF7E6 0%, #FFEDD5 100%);
  border-radius: 50rpx; padding: 16rpx 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(212, 168, 83, 0.25);
  z-index: 99;
}
.claim-entry-fab:active { transform: scale(0.985); }
.claim-entry-icon {
  width: 48rpx; height: 48rpx; border-radius: 50%;
  background: #D4A853; color: #FFF; font-size: 32rpx; line-height: 44rpx;
  text-align: center; font-weight: 300; flex-shrink: 0;
}
.claim-entry-text { flex: 1; }
.claim-entry-title { font-size: 26rpx; font-weight: 600; color: #1D1D1F; }
.claim-entry-desc { font-size: 20rpx; color: #8E8E93; margin-top: 2rpx; }
.claim-entry-arrow { font-size: 32rpx; color: #C7C5BF; line-height: 1; }

/* 底部提示 */
.bottom-tip {
  text-align: center; padding: 40rpx 0 20rpx;
  color: #B0B0B0; font-size: 22rpx;
}

/* Tab 栏 */
.tabs { display: flex; gap: 12rpx; padding: 10rpx 0 28rpx; }
.tab { padding: 14rpx 32rpx; background: #EDECEA; border-radius: 30rpx; font-size: 26rpx; color: #8E8E93; transition: all 0.25s; }
.tab-active { background: #1D1D1F; color: #FAFAF8; }

/* 卡片基础 */
.coupon-card {
  position: relative;
  background: #FFFFFF;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.05);
  transition: transform 0.2s;
}
.coupon-card:active { transform: scale(0.985); }

/* 顶部色带 */
.card-ribbon {
  height: 6rpx;
  background: var(--accent, #C4956A);
}

/* 卡片主体 */
.card-body {
  padding: 36rpx 36rpx 0;
  display: flex;
  gap: 28rpx;
}

/* 金额区（视觉锚点） */
.card-main { flex-shrink: 0; }
.card-value {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  color: #1D1D1F;
}
.card-value .num {
  font-size: 72rpx;
  font-weight: 300;
  letter-spacing: -2rpx;
  line-height: 1;
}
.card-value .unit {
  font-size: 28rpx;
  font-weight: 400;
  color: #1D1D1F;
}
.card-threshold {
  font-size: 22rpx;
  color: #8E8E93;
  margin-top: 10rpx;
  letter-spacing: 1rpx;
}

/* 信息区 */
.card-info {
  flex: 1;
  padding-top: 6rpx;
  min-width: 0;
}
.card-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #1D1D1F;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.card-scopes {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
  margin-top: 14rpx;
}
.scope-label {
  font-size: 20rpx;
  color: #8E8E93;
  margin-right: 2rpx;
}
.scope-tag {
  padding: 4rpx 14rpx;
  border: 1rpx solid rgba(0,0,0,0.1);
  border-radius: 6rpx;
  font-size: 20rpx;
  color: #8E8E93;
  background: rgba(0,0,0,0.02);
}

/* 底部操作栏 */
.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 36rpx 28rpx;
}
.card-stock {
  font-size: 22rpx;
  color: #C7C7CC;
}
.card-time {
  font-size: 22rpx;
  color: #C7C7CC;
}

/* 操作按钮 — 描边风格 */
.card-claim-btn,
.card-use-btn {
  padding: 10rpx 32rpx;
  border: 1rpx solid var(--accent, #C4956A);
  border-radius: 28rpx;
  font-size: 24rpx;
  color: var(--accent, #C4956A);
  background: transparent;
  transition: all 0.2s;
}
.card-claim-btn:active,
.card-use-btn:active {
  background: var(--accent, #C4956A);
  color: #FFFFFF;
}
.card-claim-btn.disabled {
  border-color: #D1D1D6;
  color: #C7C7CC;
}

/* 状态印章 */
.card-stamp {
  position: absolute;
  top: 28rpx;
  right: 28rpx;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  letter-spacing: 1rpx;
}
.card-stamp.status-unused {
  border: 1rpx solid var(--accent, #C4956A);
  color: var(--accent, #C4956A);
}
.card-stamp.status-used {
  border: 1rpx solid #C7C7CC;
  color: #C7C7CC;
}
.card-stamp.status-expired {
  border: 1rpx solid #C7C7CC;
  color: #C7C7CC;
}

/* 已使用 / 已过期遮罩 — 斜线纹理 */
.coupon-card.used,
.coupon-card.expired {
  position: relative;
}
.coupon-card.used::after,
.coupon-card.expired::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background:
    repeating-linear-gradient(
      -45deg,
      transparent,
      transparent 14rpx,
      rgba(0,0,0,0.03) 14rpx,
      rgba(0,0,0,0.03) 16rpx
    );
  pointer-events: none;
  z-index: 1;
}
.coupon-card.used .card-body,
.coupon-card.expired .card-body,
.coupon-card.used .card-footer,
.coupon-card.expired .card-footer {
  filter: grayscale(0.6);
  opacity: 0.65;
}

/* 空状态 & 加载更多 */
.empty { text-align: center; padding: 120rpx; color: #8E8E93; font-size: 28rpx; }
.load-more { text-align: center; padding: 40rpx; color: var(--accent, #C4956A); font-size: 28rpx; }
