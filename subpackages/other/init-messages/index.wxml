<view class="container">
  <view class="header">
    <text class="title">初始化消息集合</text>
  </view>

  <view class="content">
    <text class="description">点击下方按钮初始化消息集合，设置必要的索引。</text>
    
    <view class="info">
      <text class="info-text">初始化内容：</text>
      <text class="info-detail">1. 创建消息集合</text>
      <text class="info-detail">2. 设置 senderId 索引</text>
      <text class="info-detail">3. 设置 receiverId 索引</text>
      <text class="info-detail">4. 设置 conversationType 索引</text>
      <text class="info-detail">5. 设置复合查询索引</text>
      <text class="info-detail">6. 测试消息插入</text>
    </view>

    <view class="message">
      <text>{{message}}</text>
    </view>

    <button 
      class="primary-button" 
      bindtap="initMessagesCollection"
      loading="{{isLoading}}"
      disabled="{{isLoading}}"
    >
      初始化消息集合
    </button>

    <button 
      class="secondary-button" 
      bindtap="goBack"
      disabled="{{isLoading}}"
    >
      返回
    </button>
  </view>
</view>