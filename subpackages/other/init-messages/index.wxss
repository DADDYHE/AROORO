.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 20rpx;
}

.header {
  padding: 40rpx 0;
  text-align: center;
}

.title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.content {
  background-color: white;
  border-radius: 16rpx;
  padding: 40rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.1);
}

.description {
  font-size: 28rpx;
  color: #666;
  line-height: 40rpx;
  margin-bottom: 30rpx;
}

.info {
  background-color: #f9f9f9;
  border-radius: 8rpx;
  padding: 20rpx;
  margin-bottom: 30rpx;
}

.info-text {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.info-detail {
  font-size: 24rpx;
  color: #666;
  display: block;
  margin-left: 20rpx;
  margin-bottom: 8rpx;
}

.message {
  min-height: 60rpx;
  margin-bottom: 30rpx;
  font-size: 24rpx;
  color: #333;
  line-height: 32rpx;
}

.primary-button {
  width: 100%;
  height: 80rpx;
  background-color: #07c160;
  color: white;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.secondary-button {
  width: 100%;
  height: 80rpx;
  background-color: white;
  color: #666;
  font-size: 28rpx;
  border: 1rpx solid #ddd;
  border-radius: 12rpx;
}