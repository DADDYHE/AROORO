@import '../../../styles/loading-animation.wxss';

/* pages/favorites/index.wxss */
/* 收藏页面样式 - 渐变主题风格 */
.page-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f8f9fa;
  position: relative;
}

/* 背景纹理 */
.page-container::before {
  display: none;
}

/* 头部区域 */
.page-header {
  padding: 60rpx 40rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  position: relative;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  z-index: 1;
}

.header-content {
  max-width: 100%;
  display: flex;
  flex-direction: column;
  position: relative;
  z-index: 2;
}

/* 品牌标识 */
.brand-logo {
  font-size: 52rpx;
  font-weight: 900;
  letter-spacing: 14rpx;
  text-align: left;
  margin-bottom: 50rpx;
  color: #000000;
  text-transform: uppercase;
  font-family: 'Arial Black', 'Arial Bold', sans-serif;
  line-height: 1;
  text-shadow: 2rpx 2rpx 4rpx rgba(0, 0, 0, 0.1);
  animation: fade-in 0.8s ease-out;
}

/* 页面标题 */
.page-title {
  display: flex;
  align-items: baseline;
  font-size: 40rpx;
  font-weight: 800;
  color: #323233;
  letter-spacing: 6rpx;
  line-height: 1.2;
  text-transform: uppercase;
  text-shadow: 1rpx 1rpx 2rpx rgba(0, 0, 0, 0.1);
  animation: slide-up 0.8s ease-out 0.2s both;
}

.title-text {
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: 6rpx;
  color: #323233;
  text-transform: uppercase;
  line-height: 1.2;
}

.count {
  font-size: 32rpx;
  font-weight: normal;
  letter-spacing: 4rpx;
  margin-left: 12rpx;
  opacity: 0.8;
  color: var(--boarding-primary);
}

.page-content {
  flex: 1;
  padding: 40rpx;
  padding-bottom: 160rpx;
  position: relative;
  z-index: 1;
}

/* 加载状态 */

.loading-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.loading-dot:nth-child(3) {
  animation-delay: 0.4s;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  text-align: center;
  animation: emptyFadeIn 0.8s ease-out;
}

@keyframes emptyFadeIn {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.empty-icon {
  margin-bottom: 30rpx;
  animation: heartBeat 2s infinite ease-in-out;
}

@keyframes heartBeat {
  0%, 100% {
    transform: scale(1);
  }
  14% {
    transform: scale(1.1);
  }
  28% {
    transform: scale(1);
  }
  42% {
    transform: scale(1.1);
  }
  70% {
    transform: scale(1);
  }
}

.empty-title {
  font-size: 36rpx;
  font-weight: 900;
  color: #000000;
  margin-bottom: 16rpx;
  text-transform: uppercase;
  letter-spacing: 4rpx;
}

.empty-subtitle {
  font-size: 26rpx;
  color: var(--gray-700);
  line-height: 1.6;
  text-transform: uppercase;
  letter-spacing: 2rpx;
  margin-bottom: 30rpx;
  max-width: 80%;
}

/* 列表区域 */
.favorites-list, .host-list {
  margin-bottom: 40rpx;
}

.section-header {
  position: relative;
  margin-bottom: 40rpx;
  animation: sectionSlideIn 0.8s ease-out;
}

@keyframes sectionSlideIn {
  from {
    opacity: 0;
    transform: translateX(-20rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

.section-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #323233;
  text-transform: uppercase;
  letter-spacing: 6rpx;
  line-height: 1;
  text-shadow: 1rpx 1rpx 2rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 20rpx;
}

/* 卡片样式 */
.card {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  border: 1rpx solid rgba(0, 0, 0, 0.05);
  border-radius: 28rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
  animation: cardFadeIn 0.6s ease-out;
}

.card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, #ff9a9e, #fecfef, #a8edea, #fed6e3);
}

.card:active {
  transform: translateY(3rpx);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

@keyframes cardFadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 寄养家庭项 */
.host-item {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 已暂停接待的寄养家庭 */
.host-item.disabled {
  opacity: 0.7;
  cursor: not-allowed;
}

.host-item.disabled:active {
  transform: none;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
}

/* 寄养家庭主体区域 */
.host-main {
  display: flex;
  align-items: flex-start;
  gap: 28rpx;
}

/* 寄养家庭头像 */
.host-avatar-wrapper {
  width: 160rpx;
  height: 160rpx;
  border-radius: 24rpx;
  overflow: hidden;
  flex-shrink: 0;
  border: 3rpx solid #f0f0f0;
  background-color: #f5f5f5;
  box-shadow: 0 8rpx 25rpx rgba(0, 0, 0, 0.1);
  position: relative;
  transition: all 0.3s ease;
}

.host-avatar-wrapper:hover {
  transform: scale(1.02);
  box-shadow: 0 12rpx 35rpx rgba(0, 0, 0, 0.15);
}

.host-avatar {
  width: 100%;
  height: 100%;
  display: block;
  transition: transform 0.5s ease;
}

.host-avatar-wrapper:hover .host-avatar {
  transform: scale(1.05);
}

/* 寄养家庭详情区域 */
.host-details {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  min-width: 0;
}

.host-name {
  font-size: 36rpx;
  font-weight: 900;
  color: #000000;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  line-height: 1.2;
}

/* 标签区域 */
.host-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  background-color: #f5f7fa;
  color: #606266;
  border-radius: 16rpx;
  padding: 10rpx 20rpx;
  font-size: 22rpx;
  letter-spacing: 1rpx;
  text-transform: uppercase;
  font-weight: 500;
  transition: all 0.3s ease;
}

.tag:hover {
  background-color: #e6e8eb;
  transform: translateY(-2rpx);
}

/* 位置信息 */
.host-location {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  color: var(--gray-700);
  letter-spacing: 1rpx;
  text-transform: uppercase;
}

.location-icon {
  font-size: 24rpx;
}

/* 底部操作区域 */
.host-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #f5f5f5;
}

.host-footer-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

/* 暂停接待标签 */
.pause-tag {
  background-color: #ffebee;
  color: #ef5350;
  border-radius: 16rpx;
  padding: 10rpx 24rpx;
  font-size: 22rpx;
  letter-spacing: 1rpx;
  text-transform: uppercase;
  font-weight: bold;
}

/* 寄养家庭价格 */
.host-price {
  display: inline-block;
}

.price {
  font-size: 44rpx;
  color: var(--boarding-primary);
  font-weight: 900;
  letter-spacing: 2rpx;
  white-space: nowrap;
  text-transform: uppercase;
}

.price-unit {
  font-size: 24rpx;
  color: var(--gray-700);
  letter-spacing: 1rpx;
  margin-left: 6rpx;
  text-transform: uppercase;
}

/* 预约按钮 */
.host-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.book-button {
  background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 50%, #a8edea 100%);
  color: var(--card-color);
  font-size: 24rpx;
  font-weight: 900;
  padding: 20rpx 56rpx;
  border-radius: 16rpx;
  text-transform: uppercase;
  letter-spacing: 3rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 154, 158, 0.3);
  transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
  position: relative;
  overflow: hidden;
  border: none;
}

.book-button::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
  transition: left 0.6s;
}

.book-button:hover::before {
  left: 100%;
}

.book-button:active {
  transform: translateY(4rpx);
  box-shadow: 0 4rpx 12rpx rgba(255, 154, 158, 0.4);
}

/* 错误提示 */
.error-message {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  font-size: 26rpx;
  color: #000000;
  text-transform: uppercase;
  letter-spacing: 3rpx;
  animation: errorFadeIn 0.5s ease-out;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  border: 1rpx solid rgba(0, 0, 0, 0.05);
  border-radius: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  margin: 40rpx 0;
  position: relative;
  overflow: hidden;
}

.error-message::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, #ff9a9e, #fecfef, #a8edea, #fed6e3);
}

@keyframes errorFadeIn {
  from {
    opacity: 0;
    transform: translateY(10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.error-message van-icon {
  margin-right: 12rpx;
}

/* 显示全部寄养家庭按钮 */
.show-all-container {
  margin-top: 40rpx;
  text-align: center;
}

.show-all-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 50%, #a8edea 100%);
  color: var(--card-color);
  font-size: 30rpx;
  font-weight: 900;
  letter-spacing: 6rpx;
  padding: 30rpx;
  border-radius: 28rpx;
  text-transform: uppercase;
  box-shadow: 0 10rpx 30rpx rgba(255, 154, 158, 0.3);
  transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
  position: relative;
  overflow: hidden;
  animation: buttonSlideIn 1s ease-out;
  border: none;
}

@keyframes buttonSlideIn {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.show-all-button::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
  transition: left 0.6s;
}

.show-all-button:hover::before {
  left: 100%;
}

.show-all-button:active {
  transform: translateY(6rpx);
  box-shadow: 0 5rpx 15rpx rgba(255, 154, 158, 0.4);
}

.button-arrow {
  font-size: 28rpx;
  transition: transform 0.3s ease;
}

.show-all-button:active .button-arrow {
  transform: translateX(10rpx);
}

/* 响应式设计 */
@media screen and (max-width: 750rpx) {
  .page-header {
    padding: 50rpx 30rpx;
  }
  
  .brand-logo {
    font-size: 48rpx;
    letter-spacing: 12rpx;
    margin-bottom: 40rpx;
  }
  
  .page-title {
    font-size: 36rpx;
    letter-spacing: 5rpx;
  }
  
  .title-text {
    font-size: 36rpx;
    letter-spacing: 5rpx;
  }
  
  .count {
    font-size: 28rpx;
    margin-left: 10rpx;
  }
  
  .page-content {
    padding: 30rpx;
    padding-bottom: 140rpx;
  }
  
  .section-title {
    font-size: 36rpx;
    letter-spacing: 5rpx;
    margin-bottom: 30rpx;
  }
  
  .card {
    padding: 30rpx;
    margin-bottom: 20rpx;
  }
  
  .host-avatar-wrapper {
    width: 140rpx;
    height: 140rpx;
  }
  
  .host-name {
    font-size: 32rpx;
  }
  
  .host-location {
    font-size: 22rpx;
  }
  
  .price {
    font-size: 38rpx;
  }
  
  .book-button {
    padding: 16rpx 48rpx;
    font-size: 22rpx;
  }
  
  .show-all-button {
    padding: 24rpx;
    font-size: 26rpx;
    letter-spacing: 5rpx;
  }
  
  .empty-state {
    padding: 100rpx 30rpx;
  }
  
  .empty-title {
    font-size: 32rpx;
    letter-spacing: 3rpx;
  }
  
  .empty-subtitle {
    font-size: 24rpx;
    letter-spacing: 1.5rpx;
  }
  
  .error-message {
    padding: 30rpx;
    font-size: 24rpx;
    letter-spacing: 2rpx;
  }
}

/* 动画效果 */
@keyframes fade-in {
  from {
    opacity: 0;
    transform: translateY(-20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes slide-up {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 滚动条样式 */
::-webkit-scrollbar {
  width: 8rpx;
}

::-webkit-scrollbar-track {
  background: #f1f1f1;
  border-radius: 4rpx;
}

::-webkit-scrollbar-thumb {
  background: #000000;
  border-radius: 4rpx;
}

::-webkit-scrollbar-thumb:hover {
  background: #333333;
}
