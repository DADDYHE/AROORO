/* pages/favorites/index.wxss */
/* 收藏页面样式 - 巴黎世家风格 */
.container {
  min-height: 100vh;
  background-color: #fafafa;
  font-family: 'Arial Black', 'Arial Bold', sans-serif;
  padding-bottom: 20rpx;
}

/* 页面头部 */
.header {
  padding: 60rpx 40rpx 40rpx;
  background-color: #fafafa;
  position: relative;
  border-bottom: 1rpx solid #f0f0f0;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
}

.title {
  font-size: 52rpx;
  font-weight: 900;
  letter-spacing: 14rpx;
  text-align: left;
  margin-bottom: 20rpx;
  color: #000000;
  text-transform: uppercase;
  line-height: 1;
}

.title .count {
  font-size: 40rpx;
  font-weight: normal;
  letter-spacing: 4rpx;
  margin-left: 10rpx;
  opacity: 0.7;
}

.subtitle {
  font-size: 26rpx;
  color: #666666;
  text-transform: uppercase;
  letter-spacing: 3rpx;
  opacity: 0.8;
}

/* 加载状态 */
.loading-container {
  padding: 80rpx 0;
  text-align: center;
}

.loading-container .van-loading {
  font-size: 28rpx;
  color: #666666;
  text-transform: uppercase;
  letter-spacing: 3rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
  text-align: center;
}

.empty-icon {
  margin-bottom: 20rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 900;
  color: #000000;
  margin-bottom: 10rpx;
  text-transform: uppercase;
  letter-spacing: 4rpx;
}

.empty-subtitle {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.5;
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

/* 列表区域 */
.favorites-list, .host-list {
  padding: 40rpx 30rpx;
}

.section-title {
  font-size: 40rpx;
  font-weight: 900;
  color: #000000;
  margin-bottom: 40rpx;
  text-transform: uppercase;
  letter-spacing: 6rpx;
  padding-left: 10rpx;
  border-left: 6rpx solid #000000;
}

/* 寄养家庭项 */
.host-item {
  display: flex;
  background-color: white;
  border: 1rpx solid #f0f0f0;
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.06);
  transition: all 0.4s ease;
}

.host-item:active {
  transform: translateY(3rpx);
  box-shadow: 0 3rpx 15rpx rgba(0, 0, 0, 0.04);
}

/* 寄养家庭头像 */
.host-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 30rpx;
  border: 1rpx solid #e0e0e0;
  background-color: #f0f0f0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  flex-shrink: 0;
}

.host-avatar image {
  width: 100%;
  height: 100%;
  background-color: #f0f0f0;
}

/* 寄养家庭信息 */
.host-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.host-name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  margin-bottom: 15rpx;
}

.host-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #323233;
  letter-spacing: 2rpx;
  flex: 1;
  margin-right: 15rpx;
}

.host-location {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #909399;
  margin-bottom: 10rpx;
  letter-spacing: 2rpx;
}

.host-location van-icon {
  margin-right: 8rpx;
}

.host-rating {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 10rpx;
  letter-spacing: 2rpx;
}

.host-rating van-rate {
  margin-right: 8rpx;
}

.host-price {
  font-size: 36rpx;
  font-weight: 900;
  color: #000000;
  text-transform: uppercase;
  letter-spacing: 4rpx;
}

/* 寄养家庭操作 */
.host-actions {
  display: flex;
  align-items: center;
  justify-content: center;
}

.host-actions .van-button {
  border-radius: 50%;
  font-size: 26rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
  background-color: #ffffff;
  color: #999999;
  border: 2rpx solid #e0e0e0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
  text-transform: uppercase;
}

.host-actions .van-button:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.icon-container {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}

.icon-container svg {
  width: 32rpx;
  height: 32rpx;
  display: block;
  fill: currentColor;
}

.host-actions .van-button svg {
  width: 32rpx;
  height: 32rpx;
  display: block;
  fill: currentColor;
}

.host-actions .van-button[type="danger"] {
  background-color: #ff6b35;
  border-color: #ff6b35;
  color: white;
  box-shadow: 0 4rpx 15rpx rgba(255, 107, 53, 0.3);
}

.host-actions .van-button[type="primary"] {
  background-color: #ffffff;
  border-color: #e0e0e0;
  color: #999999;
}

.host-actions .van-button[type="primary"] svg {
  fill: #999999;
}

/* 错误提示 */
.error-message {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  font-size: 26rpx;
  color: #000000;
  text-transform: uppercase;
  letter-spacing: 3rpx;
}

.error-message van-icon {
  margin-right: 10rpx;
}

/* 显示全部寄养家庭按钮 */
.show-all-container {
  padding: 0 40rpx 40rpx;
  text-align: center;
}

.show-all-container van-button {
  width: 100%;
  border-radius: 20rpx;
  height: 100rpx;
  font-size: 30rpx;
  font-weight: 900;
  letter-spacing: 6rpx;
  background-color: #000000;
  color: white;
  border: none;
  box-shadow: 0 8rpx 25rpx rgba(0, 0, 0, 0.1);
  transition: all 0.4s ease;
  text-transform: uppercase;
}

.show-all-container van-button:active {
  transform: translateY(3rpx);
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.08);
  background-color: #333333;
}

.show-all-container van-button::after {
  border: none;
}

/* 响应式设计 */
@media screen and (max-width: 750rpx) {
  .header {
    padding: 50rpx 30rpx 30rpx;
  }
  
  .title {
    font-size: 48rpx;
    letter-spacing: 12rpx;
  }
  
  .subtitle {
    font-size: 24rpx;
    letter-spacing: 2rpx;
  }
  
  .favorites-list, .host-list {
    padding: 30rpx 20rpx;
  }
  
  .section-title {
    font-size: 36rpx;
    letter-spacing: 5rpx;
    margin-bottom: 30rpx;
  }
  
  .host-item {
    padding: 30rpx;
    margin-bottom: 15rpx;
  }
  
  .host-avatar {
    width: 100rpx;
    height: 100rpx;
    margin-right: 20rpx;
  }
  
  .host-name {
    font-size: 32rpx;
    margin-bottom: 10rpx;
  }
  
  .host-location {
    font-size: 24rpx;
    margin-bottom: 8rpx;
  }
  
  .host-rating {
    font-size: 24rpx;
    margin-bottom: 8rpx;
  }
  
  .host-price {
    font-size: 32rpx;
    letter-spacing: 3rpx;
  }
  
  .host-actions .van-button {
    font-size: 24rpx;
    letter-spacing: 3rpx;
  }
  
  .show-all-container {
    padding: 0 30rpx 30rpx;
  }
  
  .show-all-container van-button {
    height: 90rpx;
    font-size: 28rpx;
    letter-spacing: 5rpx;
  }
  
  .empty-state {
    padding: 80rpx 30rpx;
  }
  
  .empty-title {
    font-size: 32rpx;
    letter-spacing: 3rpx;
  }
  
  .empty-subtitle {
    font-size: 24rpx;
    letter-spacing: 1.5rpx;
  }
  
  .error-message {
    padding: 30rpx;
    font-size: 24rpx;
    letter-spacing: 2rpx;
  }
}
