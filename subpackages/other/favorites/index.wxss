@import '../../../styles/loading-animation.wxss';

/* ================================================================
   subpackages/other/favorites/index · AROORO 我的收藏 — Haute-Luxury Editorial
   板块色：通用中性 + 暖金点缀 --accent-color
   Skyline 兼容：无 :active / text-transform / backdrop-filter / sticky
   ================================================================ */

/* ===== 入场动画 ===== */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(32rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes pulse {
  0%, 100% {
    opacity: 0.4;
  }
  50% {
    opacity: 1;
  }
}

/* ===== 页面容器 ===== */
.page-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--background-color);
  position: relative;
}

/* ===== 头部区域 ===== */
.page-header {
  padding: 60rpx var(--page-padding);
  background: var(--card-color);
  position: relative;
  border-bottom: 1rpx solid var(--hairline);
  z-index: 1;
}

.header-content {
  max-width: 100%;
  display: flex;
  flex-direction: column;
  position: relative;
  z-index: 2;
}

/* ===== 品牌标识 ===== */
.brand-logo {
  font-size: 48rpx;
  font-weight: 300;
  letter-spacing: 0.12em;
  text-align: left;
  margin-bottom: 32rpx;
  color: var(--text-primary);
  line-height: 1;
  font-family: var(--font-serif);
}

/* ===== 页面标题 ===== */
.page-title {
  display: flex;
  align-items: baseline;
  font-size: 36rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.06em;
  line-height: 1.2;
}

.title-text {
  font-size: 36rpx;
  font-weight: 500;
  letter-spacing: 0.06em;
  color: var(--text-primary);
  line-height: 1.2;
  font-family: var(--font-serif);
}

.count {
  font-size: 26rpx;
  font-weight: 400;
  letter-spacing: 0.04em;
  margin-left: 12rpx;
  color: var(--text-tertiary);
  font-family: var(--font-sans);
}

.page-content {
  flex: 1;
  padding: var(--zy-space-lg) var(--page-padding);
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  position: relative;
  z-index: 1;
}

/* ===== 加载状态 ===== */
.loading-dot:nth-child(2) {
  animation-delay: 200ms;
}

.loading-dot:nth-child(3) {
  animation-delay: 400ms;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  text-align: center;
  animation-name: fadeInUp;
  animation-duration: 600ms;
  animation-timing-function: cubic-bezier(0.19,1,0.22,1);
  animation-fill-mode: forwards;
}

.empty-icon {
  margin-bottom: 30rpx;
  color: var(--brand-red);
  opacity: 0.4;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  letter-spacing: 0.04em;
  font-family: var(--font-serif);
}

.empty-subtitle {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  letter-spacing: 0.02em;
  margin-bottom: 30rpx;
  max-width: 80%;
  font-family: var(--font-sans);
}

/* ===== 列表区域 ===== */
.favorites-list, .host-list {
  margin-bottom: var(--zy-space-lg);
  animation-name: fadeInUp;
  animation-duration: 600ms;
  animation-timing-function: cubic-bezier(0.19,1,0.22,1);
  animation-fill-mode: forwards;
}

.section-header {
  position: relative;
  margin-bottom: var(--zy-space-lg);
}

.section-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.06em;
  line-height: 1;
  margin-bottom: 20rpx;
  font-family: var(--font-serif);
}

/* ===== 卡片样式 ===== */
.card {
  background: var(--card-color);
  border: 1rpx solid var(--hairline);
  border-radius: var(--zy-radius-lg);
  padding: var(--zy-space-lg);
  margin-bottom: 24rpx;
  position: relative;
  overflow: hidden;
  transition: transform var(--transition-fast), opacity var(--transition-fast);
}

.card--pressed {
  transform: scale(0.98);
  opacity: 0.92;
}

/* ===== 寄养家庭项 ===== */
.host-item {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.host-item.disabled {
  opacity: 0.6;
}

.host-main {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
}

.host-avatar-wrapper {
  width: 140rpx;
  height: 140rpx;
  border-radius: var(--zy-radius-lg);
  overflow: hidden;
  flex-shrink: 0;
  border: 1rpx solid var(--hairline);
  background-color: var(--background-color);
  position: relative;
}

.host-avatar {
  width: 100%;
  height: 100%;
  display: block;
}

.host-details {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  min-width: 0;
}

.host-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.02em;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-family: var(--font-serif);
}

/* ===== 标签区域 ===== */
.host-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.tag {
  background-color: var(--primary-tint);
  color: var(--primary-color);
  border-radius: var(--zy-radius-sm);
  padding: 6rpx 16rpx;
  font-size: 20rpx;
  letter-spacing: 0.02em;
  font-weight: 400;
  font-family: var(--font-sans);
}

/* ===== 位置信息 ===== */
.host-location {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
  letter-spacing: 0.02em;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-family: var(--font-sans);
}

.location-icon {
  width: 22rpx;
  height: 22rpx;
  flex-shrink: 0;
}

/* ===== 底部操作区域 ===== */
.host-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--hairline);
}

.host-footer-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

/* ===== 暂停接待标签 ===== */
.pause-tag {
  background-color: rgba(184, 92, 60, 0.08);
  color: var(--brand-red);
  border-radius: var(--zy-radius-sm);
  padding: 6rpx 16rpx;
  font-size: 20rpx;
  letter-spacing: 0.02em;
  font-weight: 400;
  font-family: var(--font-sans);
}

/* ===== 寄养家庭价格 ===== */
.host-price {
  display: flex;
  align-items: baseline;
}

.price {
  font-size: 36rpx;
  color: var(--primary-color);
  font-weight: 500;
  letter-spacing: 0.02em;
  white-space: nowrap;
  font-family: var(--font-serif);
}

.price-unit {
  font-size: 22rpx;
  color: var(--text-secondary);
  letter-spacing: 0.02em;
  margin-left: 4rpx;
  font-family: var(--font-sans);
}

/* ===== 预约按钮 ===== */
.host-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.book-button {
  background: var(--gradient-primary);
  color: var(--text-on-primary);
  font-size: 24rpx;
  font-weight: 500;
  padding: 16rpx 40rpx;
  border-radius: var(--zy-radius-pill);
  letter-spacing: 0.06em;
  box-shadow: var(--shadow-glow-primary-btn);
  border: none;
  margin: 0;
  line-height: 1;
  transition: transform var(--transition-fast), opacity var(--transition-fast);
  font-family: var(--font-serif);
}

.book-button--pressed {
  transform: scale(0.96);
  opacity: 0.85;
}

.book-button::after {
  border: none;
}

/* ===== 错误提示 ===== */
.error-message {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: var(--zy-space-lg);
  font-size: 24rpx;
  color: var(--text-primary);
  letter-spacing: 0.02em;
  background: var(--card-color);
  border: 1rpx solid var(--hairline);
  border-radius: var(--zy-radius-lg);
  margin: var(--zy-space-lg) 0;
  position: relative;
  overflow: hidden;
  font-family: var(--font-sans);
}

.error-message zy-icon {
  margin-right: 12rpx;
}

/* ===== 显示全部寄养家庭按钮 ===== */
.show-all-container {
  margin-top: var(--zy-space-lg);
  text-align: center;
}

.show-all-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: var(--card-color);
  color: var(--primary-color);
  font-size: 26rpx;
  font-weight: 500;
  letter-spacing: 0.06em;
  padding: 24rpx;
  border-radius: var(--zy-radius-lg);
  border: 1rpx solid var(--hairline);
  transition: transform var(--transition-fast), opacity var(--transition-fast);
  font-family: var(--font-serif);
}

.show-all-button--pressed {
  transform: scale(0.98);
  opacity: 0.85;
}

.button-arrow {
  width: 24rpx;
  height: 24rpx;
  flex-shrink: 0;
}
