/* 视频列表页面样式 */
.container {
  min-height: 100vh;
  background-color: #f5f7fa;
  position: relative;
}

/* 内容区域 */
.content-area {
  padding: 24rpx;
  padding-top: 40rpx; /* 为小程序默认导航栏留出空间 */
}

/* 视频列表 */
.video-list {
  min-height: calc(100vh - 200rpx); /* 调整高度，去掉顶部栏后的计算 */
}

/* 大图 */
.main-video {
  width: 100%;
  aspect-ratio: 16/9;
  background-color: white;
  border-radius: 18rpx;
  overflow: hidden;
  margin-bottom: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  position: relative;
}

.main-video-player {
  width: 100%;
  height: 100%;
  object-fit: cover;
  background-color: var(--overlay-color);
}

/* 缩略图网格 */
.thumbnail-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.thumbnail-item {
  aspect-ratio: 1/1;
  background-color: white;
  border-radius: 14rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  position: relative;
}

.thumbnail-video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  background-color: var(--overlay-color);
}

/* 播放按钮覆盖层 */
.play-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(0, 0, 0, 0.3);
}

.play-icon {
  font-size: 48rpx;
  color: white;
  font-weight: bold;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.5);
}

/* 空状态 */
.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 400rpx;
  color: var(--text-tertiary);
  font-size: 32rpx;
  background-color: white;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.empty-text {
  font-size: 32rpx;
  color: var(--text-tertiary);
}

/* 响应式设计 */
@media screen and (max-width: 750rpx) {
  .content-area {
    padding: 16rpx;
    padding-top: 30rpx; /* 调整顶部内边距 */
  }
  
  .main-video {
    margin-bottom: 20rpx;
    border-radius: 16rpx;
  }
  
  .thumbnail-grid {
    gap: 16rpx;
  }
  
  .thumbnail-item {
    border-radius: 12rpx;
  }
  
  .empty-text {
    font-size: 30rpx;
  }
}

/* 小屏幕设备优化 */
@media screen and (max-width: 375rpx) {
  .content-area {
    padding: 12rpx;
    padding-top: 24rpx; /* 调整顶部内边距 */
  }
  
  .main-video {
    margin-bottom: 16rpx;
    border-radius: 14rpx;
  }
  
  .thumbnail-grid {
    gap: 12rpx;
  }
  
  .thumbnail-item {
    border-radius: 10rpx;
  }
  
  .empty-text {
    font-size: 28rpx;
  }
}

