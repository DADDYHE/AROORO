/* ================================================================
   subpackages/other/video-list/index · AROORO 视频列表 — Haute-Luxury Editorial
   板块色：通用中性 + 暖金点缀 --accent-color
   Skyline 兼容：无 :active / text-transform / backdrop-filter / sticky
   ================================================================ */

/* ===== 页面容器 ===== */
.container {
  min-height: 100vh;
  position: relative;
}

/* ===== 内容区域 ===== */
.content-area {
  padding: var(--page-padding);
  padding-top: var(--zy-space-lg);
  animation-name: zy-fade-in-up;
  animation-duration: 480ms;
  animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  animation-fill-mode: forwards;
}

/* ===== 视频列表 ===== */
.video-list {
  min-height: calc(100vh - 200rpx);
}

/* ===== 主视频大图 ===== */
.main-video {
  width: 100%;
  aspect-ratio: 16/9;
  background-color: var(--card-color);
  border-radius: var(--zy-radius-lg);
  overflow: hidden;
  margin-bottom: var(--zy-space-lg);
  border: 1rpx solid var(--hairline);
  position: relative;
}

.main-video-player {
  width: 100%;
  height: 100%;
  background-color: var(--primary-deep);
}

/* ===== 缩略图网格 ===== */
.thumbnail-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--zy-space-lg);
}

.thumbnail-grid > .thumbnail-item {
  flex: 0 0 calc((100% - var(--zy-space-lg)) / 2);
}

.thumbnail-item {
  aspect-ratio: 1/1;
  background-color: var(--card-color);
  border-radius: var(--zy-radius-lg);
  overflow: hidden;
  border: 1rpx solid var(--hairline);
  position: relative;
  transition: transform var(--transition-fast), opacity var(--transition-fast);
}

.thumbnail-item--pressed {
  transform: scale(0.97);
  opacity: 0.9;
}

.thumbnail-video {
  width: 100%;
  height: 100%;
  background-color: var(--primary-deep);
}

/* ===== 播放按钮覆盖层（金色圆形半透明） ===== */
.play-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--overlay-color, rgba(26,26,23,0.5));
}

.play-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(201,162,75, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--border-inverse-35, rgba(255,255,255,0.35));
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 400rpx;
  color: var(--text-tertiary);
  font-size: 26rpx;
  background-color: var(--card-color);
  border-radius: var(--zy-radius-lg);
  border: 1rpx solid var(--hairline);
  letter-spacing: 0.04em;
  font-family: var(--font-sans);
}

.empty-text {
  font-size: 26rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.04em;
  font-family: var(--font-sans);
}
