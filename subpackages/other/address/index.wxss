/* ================================================================
   subpackages/other/address/index · AROORO 地址管理 — Haute-Luxury Editorial
   板块色：通用中性 + 暖金点缀 --accent-color
   Skyline 兼容：无 :active / text-transform / backdrop-filter / sticky
   ================================================================ */

.page-container {
  min-height: 100vh;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}

.address-list {
  flex: 1;
  padding: var(--zy-space-lg) var(--page-padding);
}

/* ===== 地址卡片 ===== */
.address-item {
  background: var(--card-color);
  border-radius: var(--zy-radius-lg);
  padding: var(--zy-space-lg);
  margin-bottom: 20rpx;
  border: 1rpx solid var(--hairline);
  position: relative;
  overflow: hidden;
  animation-name: zy-fade-in-up;
  animation-duration: 480ms;
  animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  animation-fill-mode: forwards;
  transition: transform var(--transition-fast), opacity var(--transition-fast);
}

.address-item--pressed {
  transform: scale(0.98);
  opacity: 0.92;
}

.address-item-default {
  border-color: rgba(31,58,31,0.15);
  background: var(--primary-wash);
}

.address-item-default::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2rpx;
  background: linear-gradient(90deg, var(--primary-color) 0%, var(--primary-soft) 50%, transparent 100%);
  border-radius: var(--zy-radius-lg) var(--zy-radius-lg) 0 0;
}

.address-item-selected {
  border-color: var(--primary-color);
  background: var(--primary-tint);
}

.address-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.address-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-right: 16rpx;
  letter-spacing: 0.02em;
  font-family: var(--font-serif);
}

.address-phone {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--text-secondary);
  margin-right: 16rpx;
  letter-spacing: 0.02em;
  font-family: var(--font-sans);
}

.address-default {
  font-size: 20rpx;
  font-weight: 500;
  color: var(--text-on-primary);
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-soft) 100%);
  padding: 4rpx 16rpx;
  border-radius: var(--zy-radius-pill);
  letter-spacing: 0.04em;
  font-family: var(--font-serif);
}

.address-detail {
  font-size: 26rpx;
  font-weight: 400;
  color: var(--text-secondary);
  line-height: 1.5;
  margin-bottom: 20rpx;
  letter-spacing: 0.02em;
  font-family: var(--font-sans);
}

.address-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  border-top: 1rpx solid var(--hairline);
  padding-top: 16rpx;
  gap: 0;
}

.address-action-edit {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--text-secondary);
  margin-right: 32rpx;
  padding: 4rpx 0;
  letter-spacing: 0.02em;
  transition: transform var(--transition-fast), opacity var(--transition-fast);
  font-family: var(--font-sans);
}

.address-action-edit--pressed {
  transform: scale(0.96);
  opacity: 0.7;
}

.address-action-set-default {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--primary-color);
  margin-right: 32rpx;
  padding: 4rpx 0;
  letter-spacing: 0.02em;
  transition: transform var(--transition-fast), opacity var(--transition-fast);
  font-family: var(--font-sans);
}

.address-action-set-default--pressed {
  transform: scale(0.96);
  opacity: 0.7;
}

.address-action-delete {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--error-color);
  padding: 4rpx 0;
  letter-spacing: 0.02em;
  transition: transform var(--transition-fast), opacity var(--transition-fast);
  font-family: var(--font-sans);
}

.address-action-delete--pressed {
  transform: scale(0.96);
  opacity: 0.7;
}

/* ===== 空状态 ===== */
.address-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 400rpx;
  background: var(--card-color);
  border-radius: var(--zy-radius-lg);
  border: 1rpx solid var(--hairline);
  animation-name: zy-fade-in-up;
  animation-duration: 480ms;
  animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  animation-fill-mode: forwards;
}

.address-empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
  opacity: 0.3;
}

.address-empty-text {
  font-size: 26rpx;
  font-weight: 400;
  color: var(--text-secondary);
  letter-spacing: 0.04em;
  font-family: var(--font-sans);
}

/* ===== 底部新增按钮 ===== */
.add-buttons-container {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx var(--page-padding);
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: var(--card-color);
  border-top: 1rpx solid var(--hairline);
  z-index: 50;
}

.add-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-deep) 100%);
  color: var(--text-on-primary);
  font-size: 28rpx;
  font-weight: 500;
  border-radius: var(--zy-radius-lg);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 0.06em;
  box-shadow: var(--shadow-glow-primary-btn);
  padding: 0;
  margin: 0;
  line-height: 1;
  transition: transform var(--transition-fast), opacity var(--transition-fast);
  font-family: var(--font-serif);
}

.add-btn--pressed {
  transform: scale(0.98);
  opacity: 0.9;
}

.add-btn::after {
  border: none;
}

.add-btn-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
  font-weight: 400;
}

/* ===== 地址编辑弹窗 ===== */
.address-popup {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.address-popup-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--overlay-color, rgba(26,26,23,0.5));
}

.address-popup-content {
  width: 100%;
  background: var(--card-color);
  border-radius: var(--zy-radius-2xl) var(--zy-radius-2xl) 0 0;
  padding: var(--zy-space-lg);
  box-sizing: border-box;
  max-height: 85vh;
  overflow-y: auto;
  position: relative;
  z-index: 210;
}

.address-popup-content::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2rpx;
  background: linear-gradient(90deg, var(--primary-color) 0%, var(--primary-soft) 50%, transparent 100%);
  border-radius: var(--zy-radius-2xl) var(--zy-radius-2xl) 0 0;
}

.address-popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--zy-space-lg);
}

.address-popup-title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.04em;
  font-family: var(--font-serif);
}

.address-popup-close {
  font-size: 36rpx;
  font-weight: 300;
  color: var(--text-tertiary);
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: transform var(--transition-fast), opacity var(--transition-fast);
}

.address-popup-close--pressed {
  transform: scale(0.92);
  opacity: 0.7;
}

.address-popup-form {
  margin-bottom: var(--zy-space-lg);
}

.form-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.form-label {
  width: 140rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-primary);
  padding-top: 20rpx;
  flex-shrink: 0;
  letter-spacing: 0.02em;
  font-family: var(--font-sans);
}

.form-input {
  flex: 1;
  height: 80rpx;
  font-size: 26rpx;
  font-weight: 400;
  color: var(--text-primary);
  border: 1rpx solid var(--hairline);
  border-radius: var(--zy-radius-md);
  padding: 0 20rpx;
  box-sizing: border-box;
  background: var(--card-cream);
  letter-spacing: 0.02em;
  font-family: var(--font-sans);
}

.form-region-picker-wrapper {
  flex: 1;
}

.form-region-picker {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 26rpx;
  font-weight: 400;
  color: var(--text-primary);
  border: 1rpx solid var(--hairline);
  border-radius: var(--zy-radius-md);
  padding: 0 20rpx;
  box-sizing: border-box;
  background: var(--card-cream);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  letter-spacing: 0.02em;
  font-family: var(--font-sans);
}

.form-region-picker.placeholder {
  color: var(--text-tertiary);
}

.form-textarea {
  flex: 1;
  min-height: 140rpx;
  font-size: 26rpx;
  font-weight: 400;
  color: var(--text-primary);
  border: 1rpx solid var(--hairline);
  border-radius: var(--zy-radius-md);
  padding: 20rpx;
  box-sizing: border-box;
  line-height: 1.5;
  background: var(--card-cream);
  letter-spacing: 0.02em;
  font-family: var(--font-sans);
}

.form-switch {
  margin-top: 16rpx;
  transform: scale(0.9);
}

.address-popup-footer {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--hairline);
}

.address-popup-button {
  flex: 1;
  height: 88rpx;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: var(--zy-radius-lg);
  letter-spacing: 0.06em;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  line-height: 1;
  transition: transform var(--transition-fast), opacity var(--transition-fast);
  font-family: var(--font-serif);
}

.address-popup-button--pressed {
  transform: scale(0.98);
  opacity: 0.9;
}

.address-popup-button::after {
  border: none;
}

.address-popup-button-cancel {
  background: var(--divider-color);
  color: var(--text-secondary);
  border: none;
}

.address-popup-button-save {
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-deep) 100%);
  color: var(--text-on-primary);
  border: none;
  box-shadow: var(--shadow-glow-primary-btn);
}
