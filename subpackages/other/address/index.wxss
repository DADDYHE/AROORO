page {
  background: var(--background-color);
}

.page-container {
  min-height: 100vh;
  background: var(--background-color);
  padding-bottom: 180rpx;
  display: flex;
  flex-direction: column;
}

.address-list {
  flex: 1;
  padding: 24rpx 32rpx;
}

.address-item {
  background: var(--card-color);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(134, 134, 139, 0.1);
  position: relative;
  overflow: hidden;
}

.address-item-default {
  border-color: rgba(156, 39, 176, 0.2);
}

.address-item-default::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: linear-gradient(90deg, var(--mall-primary) 0%, var(--mall-secondary) 50%, transparent 100%);
  border-radius: 24rpx 24rpx 0 0;
}

.address-item-selected {
  border-color: var(--mall-primary);
  background: linear-gradient(135deg, rgba(156, 39, 176, 0.02) 0%, var(--card-color) 100%);
}

.address-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.address-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-right: 16rpx;
}

.address-phone {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-secondary);
  margin-right: 16rpx;
}

.address-default {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--card-color);
  background: linear-gradient(135deg, var(--mall-primary) 0%, var(--mall-secondary) 100%);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  letter-spacing: 1rpx;
}

.address-detail {
  font-size: 26rpx;
  font-weight: 400;
  color: var(--text-secondary);
  line-height: 1.5;
  margin-bottom: 20rpx;
}

.address-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  border-top: 1rpx solid var(--divider-color);
  padding-top: 16rpx;
  gap: 0;
}

.address-action-edit {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-secondary);
  margin-right: 32rpx;
  padding: 4rpx 0;
}

.address-action-set-default {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--mall-primary);
  margin-right: 32rpx;
  padding: 4rpx 0;
}

.address-action-delete {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--error-color);
  padding: 4rpx 0;
}

.address-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 400rpx;
  background: var(--card-color);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.address-empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
  opacity: 0.3;
}

.address-empty-text {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-secondary);
  letter-spacing: 2rpx;
}

.add-buttons-container {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-top: 1rpx solid rgba(134, 134, 139, 0.1);
  z-index: 50;
}

.add-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, var(--mall-primary) 0%, var(--mall-secondary) 100%);
  color: var(--card-color);
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 24rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 2rpx;
  box-shadow: 0 6rpx 16rpx rgba(156, 39, 176, 0.3);
}

.add-btn-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
  font-weight: 600;
}

.address-popup {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.address-popup-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.address-popup-content {
  width: 100%;
  background: var(--card-color);
  border-radius: 30rpx 30rpx 0 0;
  padding: 32rpx;
  box-sizing: border-box;
  max-height: 85vh;
  overflow-y: auto;
  position: relative;
  z-index: 210;
}

.address-popup-content::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: linear-gradient(90deg, var(--mall-primary) 0%, var(--mall-secondary) 50%, transparent 100%);
  border-radius: 30rpx 30rpx 0 0;
}

.address-popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.address-popup-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: 1rpx;
}

.address-popup-close {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-secondary);
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.address-popup-form {
  margin-bottom: 32rpx;
}

.form-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 28rpx;
}

.form-label {
  width: 140rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  padding-top: 20rpx;
  flex-shrink: 0;
  letter-spacing: 1rpx;
}

.form-input {
  flex: 1;
  height: 80rpx;
  font-size: 26rpx;
  font-weight: 400;
  color: var(--text-primary);
  border: 1rpx solid var(--divider-color);
  border-radius: 16rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  background: var(--surface-tint);
}

.form-region-picker-wrapper {
  flex: 1;
}

.form-region-picker {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 26rpx;
  font-weight: 400;
  color: var(--text-primary);
  border: 1rpx solid var(--divider-color);
  border-radius: 16rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  background: var(--surface-tint);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.form-region-picker.placeholder {
  color: var(--text-tertiary);
}

.form-textarea {
  flex: 1;
  min-height: 140rpx;
  font-size: 26rpx;
  font-weight: 400;
  color: var(--text-primary);
  border: 1rpx solid var(--divider-color);
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
  line-height: 1.5;
  background: var(--surface-tint);
}

.form-switch {
  margin-top: 16rpx;
  transform: scale(1.1);
}

.address-popup-footer {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--divider-color);
}

.address-popup-button {
  flex: 1;
  height: 88rpx;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 20rpx;
  letter-spacing: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  line-height: 1;
}

.address-popup-button-cancel {
  background: var(--divider-color);
  color: var(--text-secondary);
  border: none;
}

.address-popup-button-save {
  background: linear-gradient(135deg, var(--mall-primary) 0%, var(--mall-secondary) 100%);
  color: var(--card-color);
  border: none;
  box-shadow: 0 6rpx 16rpx rgba(156, 39, 176, 0.3);
}

