<zy-navbar title="地址管理" />
<scroll-view
  scroll-y
  enhanced
  refresher-enabled="{{true}}"
  refresher-triggered="{{_refresherTriggered}}"
  bindrefresherrefresh="_onRefresherRefresh"
  bindscrolltolower="_onScrollToLower"
  bindscroll="_onScroll"
  lower-threshold="100"
  style="height: calc(100vh - {{_navbarHeight}}px);"
>
<view class="page-container">
  <view class="address-list">
    <block wx:if="{{ addresses.length > 0 }}">
      <view
        class="address-item {{ item.isDefault ? 'address-item-default' : '' }} {{ selectedAddressId === item._id ? 'address-item-selected' : '' }}"
        wx:for="{{ addresses }}"
        wx:key="_id"
        bindtap="selectAddress"
        hover-class="address-item--pressed"
        data-id="{{ item._id }}"
      >
        <view class="address-header">
          <view class="address-name">{{ item.name }}</view>
          <view class="address-phone">{{ item.phone }}</view>
          <view class="address-default" wx:if="{{ item.isDefault }}">默认</view>
        </view>
        <view class="address-detail">{{ item.fullAddress }}</view>
        <view class="address-actions">
          <text class="address-action-edit" bindtap="editAddress" data-id="{{ item._id }}">编辑</text>
          <text class="address-action-set-default" wx:if="{{ !item.isDefault }}" bindtap="setDefault" data-id="{{ item._id }}">设为默认</text>
          <text class="address-action-delete" bindtap="deleteAddress" data-id="{{ item._id }}">删除</text>
        </view>
      </view>
    </block>
    <block wx:else>
      <view class="address-empty">
        <text class="address-empty-text">暂无地址</text>
      </view>
    </block>
  </view>

  <root-portal>
  <view class="add-buttons-container">
    <button class="add-btn add-btn-primary" hover-class="add-btn--pressed" bindtap="addManual">
      <text class="add-btn-icon">+</text>
      <text class="add-btn-text">新增地址</text>
    </button>
  </view>
  </root-portal>

  <root-portal>
  <view class="address-popup" wx:if="{{ showEditPopup }}">
    <view class="address-popup-mask" bindtap="closeEditPopup"></view>
    <view class="address-popup-content">
      <view class="address-popup-header">
        <view class="address-popup-title">{{ editingAddress._id ? '编辑地址' : '新增地址' }}</view>
        <view class="address-popup-close" hover-class="address-popup-close--pressed" bindtap="closeEditPopup">×</view>
      </view>
      <view class="address-popup-form">
        <view class="form-item">
          <view class="form-label">姓名</view>
          <input
            class="form-input"
            placeholder="请输入姓名"
            value="{{ editingAddress.name || '' }}"
            bindinput="onNameChange"
          />
        </view>
        <view class="form-item">
          <view class="form-label">手机号</view>
          <input
            class="form-input"
            placeholder="请输入手机号"
            value="{{ editingAddress.phone || '' }}"
            bindinput="onPhoneChange"
            type="number"
          />
        </view>
        <view class="form-item">
          <view class="form-label">所在地区</view>
          <picker class="form-region-picker-wrapper" mode="region" value="{{ regionValue }}" bindchange="onRegionChange">
            <view class="form-region-picker {{ editingAddress.province ? '' : 'placeholder' }}">
              {{ editingAddress.province ? editingAddress.province + editingAddress.city + editingAddress.district : '请选择省/市/区' }}
            </view>
          </picker>
        </view>
        <view class="form-item">
          <view class="form-label">详细地址</view>
          <textarea
            class="form-textarea"
            placeholder="街道、楼牌号等"
            value="{{ editingAddress.detail || '' }}"
            bindinput="onDetailChange"
          ></textarea>
        </view>
        <view class="form-item">
          <view class="form-label">默认地址</view>
          <switch
            class="form-switch"
            checked="{{ editingAddress.isDefault || false }}"
            bindchange="onDefaultChange"
          />
        </view>
      </view>
      <view class="address-popup-footer">
        <button class="address-popup-button address-popup-button-cancel" hover-class="address-popup-button--pressed" bindtap="closeEditPopup">取消</button>
        <button class="address-popup-button address-popup-button-save" hover-class="address-popup-button--pressed" bindtap="saveAddress">保存</button>
      </view>
    </view>
  </view>
  </root-portal>
</view>
</scroll-view>
