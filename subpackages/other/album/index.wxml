<zy-navbar title="相册" />
<scroll-view
  scroll-y
  enhanced
  refresher-enabled="{{true}}"
  refresher-triggered="{{_refresherTriggered}}"
  bindrefresherrefresh="_onRefresherRefresh"
  bindscrolltolower="_onScrollToLower"
  bindscroll="_onScroll"
  lower-threshold="100"
  style="height: calc(100vh - {{_navbarHeight}}px);"
>
<view class="container">

  <!-- 功能按钮 -->
  <view class="function-tabs">
    <view
      class="tab-button {{currentTab === 'video' ? 'active' : ''}}"
      catchtap="switchTab"
      hover-class="tab-button--pressed"
      data-tab="video"
    >
      视频
    </view>
    <view
      class="tab-button {{currentTab === 'album' ? 'active' : ''}}"
      catchtap="switchTab"
      hover-class="tab-button--pressed"
      data-tab="album"
    >
      相册
    </view>
  </view>

  <!-- 视频功能区 -->
  <view class="content-area video-section {{currentTab === 'video' ? 'active' : 'hidden'}}">
    <!-- 垂直指示器和视频数量指示器（root-portal：Skyline 下保证 fixed 相对 viewport） -->
    <root-portal wx:if="{{videos.length > 0}}">
      <view class="vertical-indicator-container">
        <!-- 视频数量指示器 -->
        <view class="video-count-indicator">
          {{currentVideoIndex + 1}} / {{videos.length}}
        </view>
      </view>
    </root-portal>
    
    <swiper 
      class="video-swiper" 
      vertical="{{true}}" 
      circular="{{false}}" 
      autoplay="{{false}}" 
      interval="{{4000}}" 
      duration="{{500}}"
      current="{{currentVideoIndex}}"
      bindchange="onVideoSwiperChange"
      style="height: {{videoHeight}}px;"
      indicator-dots="{{true}}"
      indicator-active-color="#FF6B00"
      indicator-color="rgba(255, 255, 255, 0.3)"
    >
      <!-- 视频列表 -->
      <swiper-item 
        wx:for="{{videos}}" 
        wx:key="id"
        data-index="{{index}}"
      >
        <view class="video-item">
          <video 
            id="video-{{index}}"
            class="video-player"
            src="{{item.url}}"
            poster="{{item.poster}}"
            controls="{{true}}"
            show-fullscreen-btn="{{false}}"
            show-play-btn="{{true}}"
            show-center-play-btn="{{true}}"
            enable-play-gesture="{{true}}"
            object-fit="cover"
            loop="{{true}}"
            autoplay="{{currentVideoIndex === index}}"
            bindplay="onVideoPlay"
            bindpause="onVideoPause"
            bindended="onVideoEnded"
            bindtimeupdate="onVideoTimeUpdate"
            data-index="{{index}}"
          ></video>

          <!-- 播放进度条 -->
          <view class="progress-container">
            <view 
              class="progress-bar"
              bindtouchstart="onProgressTouchStart"
              bindtouchmove="onProgressTouchMove"
              bindtouchend="onProgressTouchEnd"
              data-index="{{index}}"
            >
              <view class="progress-track" style="width: {{item.playProgress || 0}}%"></view>
              <view class="progress-thumb" wx:if="{{item.isDragging}}" style="left: {{item.playProgress || 0}}%"></view>
            </view>
            <view class="progress-time">
              <text class="current-time">{{formatTime(item.currentTime || 0)}}</text>
              <text class="total-time">{{formatTime(item.duration || 0)}}</text>
            </view>
          </view>

          <!-- 寄养家庭信息栏 -->
          <view class="host-info">
            <image lazy-load class="host-avatar" src="{{item.hostInfo.avatarUrl}}" mode="aspectFill" binderror="onCloudImageError" data-src="{{item.hostInfo.avatarUrl}}" data-path="videos[{{index}}].hostInfo.avatarUrl"></image>
            <view class="host-details">
              <text class="host-name">{{item.hostInfo.name}}</text>
              <text class="video-description">{{item.description}}</text>
            </view>
          </view>
        </view>
      </swiper-item>
      
      <!-- 空状态 -->
      <swiper-item wx:if="{{videos.length === 0}}">
        <view class="empty-state">
          <text class="empty-text">暂无视频内容</text>
        </view>
      </swiper-item>
    </swiper>
    
    <!-- 右下角6个方块按钮（root-portal：Skyline 下保证 fixed 相对 viewport） -->
    <root-portal>
      <view class="grid-button" hover-class="grid-button--pressed" catchtap="goToVideoList">
        <view class="grid-container">
          <view class="grid-item"></view>
          <view class="grid-item"></view>
          <view class="grid-item"></view>
          <view class="grid-item"></view>
          <view class="grid-item"></view>
          <view class="grid-item"></view>
        </view>
      </view>
    </root-portal>
  </view>

  <!-- 相册功能区 -->
  <view class="content-area album-section {{currentTab === 'album' ? 'active' : 'hidden'}}">
    <!-- 相册内容 -->
    <view class="album-content">
      <!-- 大图 -->
      <view wx:if="{{photos.length > 0}}" class="main-photo">
        <image lazy-load 
          class="main-image" 
          src="{{photos[0].url}}" 
          mode="aspectFill"
          bindtap="previewPhoto"
          data-index="0"
          binderror="onCloudImageError" data-src="{{photos[0].url}}" data-path="photos[0].url"
        ></image>
      </view>
      
      <!-- 缩略图网格 -->
      <view wx:if="{{photos.length > 1}}" class="thumbnail-grid">
        <view
          class="thumbnail-item"
          wx:for="{{photos}}"
          wx:key="id"
          wx:if="{{index > 0}}"
          bindtap="previewPhoto"
          hover-class="thumbnail-item--pressed"
          data-index="{{index}}"
        >
          <image lazy-load 
            class="thumbnail-image" 
            src="{{item.url}}" 
            mode="aspectFill"
            binderror="onCloudImageError" data-src="{{item.url}}" data-path="photos[{{index}}].url"
          ></image>
        </view>
      </view>
      
      <!-- 空状态 -->
      <view wx:if="{{photos.length === 0}}" class="empty-state">
        <text class="empty-text">暂无照片内容</text>
      </view>
    </view>
  </view>
</view>
</scroll-view>
