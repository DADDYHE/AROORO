/* ================================================================
   subpackages/other/album/index · AROORO 相册 — Haute-Luxury Editorial
   板块色：通用中性 + 暖金点缀 --accent-color
   Skyline 兼容：无 :active / text-transform / backdrop-filter / sticky
   ================================================================ */

/* ===== 入场动画 ===== */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(24rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ===== 页面容器 ===== */
.container {
  min-height: 100vh;
  background-color: var(--background-color);
  position: relative;
}

/* ===== 功能切换栏 ===== */
.function-tabs {
  display: flex;
  background: var(--card-color);
  border-bottom: 1rpx solid var(--hairline);
  position: relative;
  z-index: 99;
}

.tab-button {
  flex: 1;
  padding: 28rpx 32rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 400;
  color: var(--text-tertiary);
  position: relative;
  letter-spacing: 0.06em;
  transition: transform var(--transition-fast), opacity var(--transition-fast);
  font-family: var(--font-sans);
}

.tab-button--pressed {
  transform: scale(0.98);
  opacity: 0.85;
}

.tab-button.active {
  color: var(--primary-color);
  font-weight: 500;
}

.tab-button.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: var(--primary-color);
  border-radius: 2rpx;
}

/* ===== 内容区域 ===== */
.content-area {
  min-height: calc(100vh - 100rpx);
  position: relative;
  overflow: hidden;
}

.content-area.hidden {
  display: none;
}

.scroll-container {
  height: 100%;
  width: 100%;
}

/* ===== 视频功能区 ===== */
.video-section {
  padding: 0;
  background-color: var(--card-cream);
  position: relative;
}

/* ===== 垂直指示器容器 ===== */
.vertical-indicator-container {
  position: fixed;
  right: 48rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 100;
  gap: 12rpx;
}

/* ===== 视频数量指示器 ===== */
.video-count-indicator {
  color: var(--card-color);
  font-size: 24rpx;
  font-weight: 500;
  background: var(--overlay-color, rgba(26,26,23,0.5));
  padding: 8rpx 20rpx;
  border-radius: var(--zy-radius-pill);
  letter-spacing: 0.04em;
  font-family: var(--font-sans);
}

.video-swiper {
  width: 100%;
  height: 100%;
}

/* ===== 视频项 ===== */
.video-item {
  width: 100%;
  height: 100%;
  background-color: var(--primary-deep);
  position: relative;
  overflow: hidden;
}

.video-list {
  min-height: 100%;
}

.video-player {
  width: 100%;
  height: 100%;
  background-color: var(--primary-deep);
  position: absolute;
  top: 0;
  left: 0;
}

/* ===== 播放进度条容器 ===== */
.progress-container {
  position: absolute;
  bottom: 120rpx;
  left: 0;
  right: 0;
  padding: 0 var(--page-padding) 20rpx;
  z-index: 90;
  background: linear-gradient(to top, var(--overlay-color, rgba(26,26,23,0.5)), transparent);
}

/* ===== 进度条 ===== */
.progress-bar {
  height: 4rpx;
  background-color: var(--border-inverse-35, rgba(255,255,255,0.35));
  border-radius: 2rpx;
  margin-bottom: 12rpx;
  position: relative;
  overflow: hidden;
}

/* ===== 进度条填充 ===== */
.progress-track {
  height: 100%;
  background-color: var(--accent-color);
  border-radius: 2rpx;
  position: absolute;
  left: 0;
  top: 0;
}

/* ===== 进度条滑块 ===== */
.progress-thumb {
  position: absolute;
  top: 50%;
  left: 0;
  transform: translate(-50%, -50%);
  width: 16rpx;
  height: 16rpx;
  background-color: var(--accent-color);
  border-radius: 50%;
}

/* ===== 播放时间显示 ===== */
.progress-time {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: var(--card-color);
  letter-spacing: 0.02em;
  font-family: var(--font-sans);
}

.current-time {
  font-weight: 400;
}

.total-time {
  color: rgba(255, 255, 255, 0.7);
}

/* ===== 寄养家庭信息栏 ===== */
.host-info {
  position: absolute;
  bottom: 160rpx;
  left: 0;
  right: 0;
  display: flex;
  align-items: flex-start;
  background-color: transparent;
  padding: 20rpx var(--page-padding);
  width: 100%;
  box-sizing: border-box;
}

.host-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  flex-shrink: 0;
}

.host-details {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}

.host-name {
  font-size: 28rpx;
  color: var(--card-color);
  font-weight: 500;
  margin-bottom: 8rpx;
  letter-spacing: 0.02em;
  font-family: var(--font-serif);
}

.video-description {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.5;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  letter-spacing: 0.02em;
  font-family: var(--font-sans);
}

/* ===== 右下角网格按钮 ===== */
.grid-button {
  position: fixed;
  bottom: 160rpx;
  right: var(--page-padding);
  width: 80rpx;
  height: 80rpx;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--glass-bg-95, rgba(255,255,255,0.95));
  border-radius: var(--zy-radius-lg);
  border: 1rpx solid var(--hairline);
  transition: transform var(--transition-fast), opacity var(--transition-fast);
}

.grid-button--pressed {
  transform: scale(0.92);
  opacity: 0.85;
}

.grid-container {
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx;
  width: 48rpx;
  height: 32rpx;
}

.grid-container > .grid-item {
  flex: 0 0 calc((100% - 8rpx) / 3);
  height: calc((100% - 4rpx) / 2);
}

.grid-item {
  width: 100%;
  height: 100%;
  background-color: var(--primary-color);
  border-radius: 2rpx;
}

/* ===== 相册功能区 ===== */
.album-section {
  padding: var(--page-padding);
  position: relative;
  z-index: 1;
  animation-name: fadeInUp;
  animation-duration: 500ms;
  animation-timing-function: cubic-bezier(0.19,1,0.22,1);
  animation-fill-mode: forwards;
}

.album-content {
  min-height: calc(100vh - 200rpx);
  padding-bottom: 40rpx;
}

/* ===== 大图 ===== */
.main-photo {
  width: 100%;
  aspect-ratio: 16/9;
  background-color: var(--card-color);
  border-radius: var(--zy-radius-lg);
  overflow: hidden;
  margin-bottom: var(--zy-space-lg);
  border: 1rpx solid var(--hairline);
  position: relative;
  z-index: 2;
}

.main-image {
  width: 100%;
  height: 100%;
}

/* ===== 缩略图网格 ===== */
.thumbnail-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--zy-space-lg);
}

.thumbnail-grid > .thumbnail-item {
  flex: 0 0 calc((100% - var(--zy-space-lg)) / 2);
}

.thumbnail-item {
  aspect-ratio: 1/1;
  background-color: var(--card-color);
  border-radius: var(--zy-radius-lg);
  overflow: hidden;
  border: 1rpx solid var(--hairline);
  position: relative;
  z-index: 2;
  transition: transform var(--transition-fast), opacity var(--transition-fast);
}

.thumbnail-item--pressed {
  transform: scale(0.97);
  opacity: 0.9;
}

.thumbnail-image {
  width: 100%;
  height: 100%;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 400rpx;
  color: var(--text-tertiary);
  font-size: 26rpx;
  background-color: var(--card-color);
  border-radius: var(--zy-radius-lg);
  border: 1rpx solid var(--hairline);
  letter-spacing: 0.04em;
  font-family: var(--font-sans);
}

.empty-text {
  font-size: 26rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.04em;
  font-family: var(--font-sans);
}
