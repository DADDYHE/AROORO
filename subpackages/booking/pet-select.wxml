<zy-navbar title="" transparent color="#F7F5EF" solid="{{_navbarSolid}}" />
<scroll-view
  scroll-y
  enhanced
  refresher-enabled="{{true}}"
  refresher-triggered="{{_refresherTriggered}}"
  bindrefresherrefresh="_onRefresherRefresh"
  bindscrolltolower="_onScrollToLower"
  bindscroll="_onScroll"
  lower-threshold="100"
  style="height: 100vh;"
>
<login-prompt visible="{{showLoginPrompt}}" bind:close="onLoginPromptClose" />
<view class="gallery-container">
  <view class="lux-hero" style="padding-top: calc({{_navbarHeight}}px + 24rpx);">
    <text class="lux-hero-eyebrow">PETS</text>
    <text class="lux-hero-title">{{t.BIZ_IKY2TL}}</text>
    <text class="lux-hero-sub">选择需要服务的宠物</text>
    <view class="lux-hero-sealline"></view>
  </view>

  <view class="loading-container" wx:if="{{isLoading}}">
    <view class="loading-content">
      <view class="lux-cascade">
  <view class="lux-cascade-dot" style="left: 20rpx; background: #C9A24B; animation-delay: 0ms;"></view>
  <view class="lux-cascade-dot" style="left: 36rpx; background: #A8894A; animation-delay: 150ms;"></view>
  <view class="lux-cascade-dot" style="left: 52rpx; background: #C9A24B; animation-delay: 300ms;"></view>
  <view class="lux-cascade-dot" style="left: 68rpx; background: #A8894A; animation-delay: 450ms;"></view>
  <view class="lux-cascade-dot" style="left: 84rpx; background: #C9A24B; animation-delay: 600ms;"></view>
  <view class="lux-cascade-dot" style="left: 100rpx; background: #A8894A; animation-delay: 750ms;"></view>
  <view class="lux-cascade-dot" style="left: 48rpx; background: #C9A24B; animation-delay: 900ms;"></view>

      </view>
      <text class="loading-text">{{t.BIZ_CSIK0}}</text>
    </view>
  </view>

  <view class="gallery-hall" wx:elif="{{pets.length > 0}}">
    <view class="gallery-entrance">
      <view class="entrance-line"></view>
      <text class="entrance-label">宠物档案</text>
      <text class="entrance-count">{{pets.length}}</text>
    </view>

    <view class="gallery-collection">
      <view class="wall-col wall-col-l">
        <block wx:for="{{pets}}" wx:key="id">
          <view wx:if="{{index % 2 === 0}}" class="wall-piece {{item.checked ? 'piece-selected' : ''}}" bindtap="openSelectPopup" data-id="{{item.id}}">
            <view class="portrait-frame" catchtap="viewPetDetail" data-id="{{item.id}}">
              <image lazy-load class="portrait-image" src="{{item.avatarUrl || '/images/default-avatar.svg'}}" mode="aspectFill" binderror="onCloudImageError" data-src="{{item.avatarUrl}}" data-path="pets[{{index}}].avatarUrl" data-index="{{index}}" />
              <view class="portrait-selected-ring" wx:if="{{item.checked}}"></view>
              <view class="tag-no {{item.checked ? 'tag-picked' : ''}}">{{item.checked ? '已选' : 'No.' + ((index + 1) < 10 ? '0' : '') + (index + 1)}}</view>
            </view>
            <view class="piece-label">
              <text class="piece-name">{{item.name}}</text>
              <view class="piece-caption">
                <text class="piece-bd">{{item.breed || item.type}}</text>
                <text class="piece-bd" wx:if="{{item.birthday}}"> · {{item.birthday}}</text>
              </view>
              <view class="piece-dates" wx:if="{{item.checked && item.serviceDatesText}}">
                <view class="dates-line"></view>
                <text class="dates-text">{{item.serviceDatesText}}</text>
              </view>
            </view>
          </view>
        </block>
      </view>
      <view class="wall-col wall-col-r">
        <block wx:for="{{pets}}" wx:key="id">
          <view wx:if="{{index % 2 === 1}}" class="wall-piece {{item.checked ? 'piece-selected' : ''}}" bindtap="openSelectPopup" data-id="{{item.id}}">
            <view class="portrait-frame" catchtap="viewPetDetail" data-id="{{item.id}}">
              <image lazy-load class="portrait-image" src="{{item.avatarUrl || '/images/default-avatar.svg'}}" mode="aspectFill" binderror="onCloudImageError" data-src="{{item.avatarUrl}}" data-path="pets[{{index}}].avatarUrl" data-index="{{index}}" />
              <view class="portrait-selected-ring" wx:if="{{item.checked}}"></view>
              <view class="tag-no {{item.checked ? 'tag-picked' : ''}}">{{item.checked ? '已选' : 'No.' + ((index + 1) < 10 ? '0' : '') + (index + 1)}}</view>
            </view>
            <view class="piece-label">
              <text class="piece-name">{{item.name}}</text>
              <view class="piece-caption">
                <text class="piece-bd">{{item.breed || item.type}}</text>
                <text class="piece-bd" wx:if="{{item.birthday}}"> · {{item.birthday}}</text>
              </view>
              <view class="piece-dates" wx:if="{{item.checked && item.serviceDatesText}}">
                <view class="dates-line"></view>
                <text class="dates-text">{{item.serviceDatesText}}</text>
              </view>
            </view>
          </view>
        </block>
      </view>
    </view>

    <view class="gallery-add" bindtap="addNewPet">
      <view class="add-line"></view>
      <text class="add-label">创建新的宠物档案</text>
    </view>
  </view>

  <view class="gallery-hall" wx:else>
    <view class="empty-exhibition">
      <view class="empty-frame">
        <view class="frame-corner frame-tl"></view>
        <view class="frame-corner frame-tr"></view>
        <view class="frame-corner frame-bl"></view>
        <view class="frame-corner frame-br"></view>
        <view class="frame-inner">
          <text class="empty-title">即将布展</text>
          <text class="empty-subtitle">添加您的第一只宠物</text>
        </view>
      </view>
      <view class="gallery-add" bindtap="addNewPet">
        <view class="add-line"></view>
        <text class="add-label">创建新的宠物档案</text>
      </view>
    </view>
  </view>

  <root-portal>
  <view class="gallery-footer" wx:if="{{pets.length > 0}}">
    <view class="footer-status">
      <view class="status-dot {{selectedPets.length > 0 ? 'dot-active' : 'dot-idle'}}"></view>
      <text class="status-text">已选 {{selectedPets.length}} 只宠物</text>
    </view>
    <view class="footer-bottom">
      <view class="bar-action-item contact-wrap" hover-class="contact-wrap--pressed" hover-stay-time="120">
        <image class="bar-action-icon-img" src="{{iconService}}" mode="aspectFit" />
        <text class="bar-action-text">客服</text>
        <button class="contact-overlay" open-type="contact"></button>
      </view>
      <view bindtap="nextStep" class="footer-action {{selectedPets.length === 0 ? 'action-disabled' : 'action-active'}}">
        <text>确定选择</text>
      </view>
    </view>
  </view>
  </root-portal>

  <zy-popup
    visible="{{ showSelectPopup }}"
    position="bottom"
    round="{{ true }}"
    bind:close="closeSelectPopup"
    z-index="{{ 2000 }}"
  >
    <view class="bottom-popup">
      <view class="popup-handle-bar"></view>

      <view class="popup-header">
        <view class="popup-header-accent"></view>
        <view class="popup-header-content">
          <text class="popup-title">选择服务</text>
          <view class="popup-cancel-btn" catchtap="closeSelectPopup">
            <text class="popup-cancel-text">取消</text>
          </view>
        </view>
      </view>

      <view class="popup-services">
        <view class="service-row service-row-checked" bindtap="toggleFeeding">
          <view class="service-check {{serviceFeeding ? 'check-on' : 'check-off'}}">
            <view class="check-icon" wx:if="{{serviceFeeding}}"></view>
          </view>
          <view class="service-info">
            <text class="service-name">宠物喂养</text>
            <text class="service-desc">基础服务</text>
          </view>
        </view>

        <view class="service-row">
          <view class="service-check {{walkMinutes > 0 ? 'check-on' : 'check-off'}}">
            <view class="check-icon" wx:if="{{walkMinutes > 0}}"></view>
          </view>
          <view class="service-info">
            <text class="service-name">上门遛狗</text>
          </view>
          <view class="service-stepper">
            <view class="stepper-btn {{walkMinutes <= 0 ? 'stepper-disabled' : ''}}" catchtap="decreaseWalk">−</view>
            <text class="stepper-value">{{walkMinutes}}分钟</text>
            <view class="stepper-btn" catchtap="increaseWalk">+</view>
          </view>
        </view>
      </view>

      <view class="popup-section">
        <view class="popup-section-label">
          <view class="section-label-line"></view>
          <text class="section-label-text">服务日期</text>
          <text class="section-label-hint" wx:if="{{selectedServiceDates.length > 0}}">已选{{selectedServiceDates.length}}天</text>
        </view>
      </view>

      <scroll-view
        class="popup-calendar-area"
        scroll-y
        enhanced
        show-scrollbar="{{false}}"
        wx:key="{{calendarKey}}"
      >
        <zy-calendar
          title=""
          show-mark="{{false}}"
          type="multiple"
          min-date="{{ minServiceDate }}"
          max-date="{{ maxServiceDate }}"
          selectable-min-date="{{ selectableMinDate }}"
          selectable-max-date="{{ selectableMaxDate }}"
          color="#1F3A1F"
          bind:select="onCalendarSelect"
          default-date="{{defaultCalendarDates}}"
          poppable="{{false}}"
          show-confirm="{{false}}"
          formatter="{{ calendarFormatter }}"
        />
      </scroll-view>

      <view class="popup-confirm-area">
        <view class="popup-confirm-btn {{selectedServiceDates.length > 0 ? 'btn-enabled' : 'btn-disabled'}}" catchtap="confirmSelectPet">
          <text class="confirm-btn-text">确定选择</text>
        </view>
      </view>
    </view>
  </zy-popup>
</view>
</scroll-view>
