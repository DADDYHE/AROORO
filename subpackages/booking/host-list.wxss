/* 寄养家庭列表页面 - 艺术化设计 */
.page-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f8f9fa;
  position: relative;
}

/* 头部区域 */
.page-header {
  padding: 60rpx 40rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  position: relative;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  z-index: 1;
}

.header-content {
  max-width: 100%;
  display: flex;
  flex-direction: column;
  position: relative;
  z-index: 2;
}

/* 品牌标识 */
.brand-logo {
  font-size: 52rpx;
  font-weight: 900;
  letter-spacing: 14rpx;
  text-align: left;
  margin-bottom: 40rpx;
  color: #000000;
  text-transform: uppercase;
  font-family: 'Arial Black', 'Arial Bold', sans-serif;
  line-height: 1;
  text-shadow: 2rpx 2rpx 4rpx rgba(0, 0, 0, 0.1);
  animation: fade-in 0.8s ease-out;
}

/* 页面标题 */
.page-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #323233;
  letter-spacing: 6rpx;
  line-height: 1.2;
  text-transform: uppercase;
  text-shadow: 1rpx 1rpx 2rpx rgba(0, 0, 0, 0.1);
  animation: slide-up 0.8s ease-out 0.2s both;
}

.page-content {
  flex: 1;
  padding: 40rpx;
  position: relative;
  z-index: 1;
}

/* 寄养家庭列表区域 */
.host-list-section {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  border: 1rpx solid rgba(0, 0, 0, 0.05);
  border-radius: 28rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
  animation: sectionSlideIn 0.8s ease-out 0.2s both;
}

.host-list-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, #ff9a9e, #fecfef, #a8edea, #fed6e3);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #323233;
  text-transform: uppercase;
  letter-spacing: 6rpx;
  line-height: 1;
  text-shadow: 1rpx 1rpx 2rpx rgba(0, 0, 0, 0.1);
}

.host-count {
  font-size: 26rpx;
  color: #666666;
  background-color: #f5f7fa;
  padding: 10rpx 20rpx;
  border-radius: 16rpx;
  letter-spacing: 3rpx;
  font-weight: 500;
  text-transform: uppercase;
}

.host-list {
  overflow: hidden;
}

/* 寄养家庭项 */
.host-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f5f7fa;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  cursor: pointer;
  position: relative;
  animation: cardFadeIn 0.6s ease-out both;
}

.host-item:last-child {
  border-bottom: none;
}

.host-item:active {
  transform: translateX(20rpx);
  opacity: 0.8;
}

/* 暂停接单状态样式 */
.host-item.disabled {
  opacity: 0.5;
  cursor: not-allowed;
  pointer-events: none;
  background-color: #f5f5f5;
}

.host-item.disabled .host-name,
.host-item.disabled .price {
  color: #999;
}

.detail-area {
  flex: 1;
  display: flex;
  align-items: center;
  transition: all 0.3s ease;
  padding-right: 20rpx;
  box-sizing: border-box;
}

/* 头像容器 */
.avatar-container {
  width: 120rpx;
  height: 120rpx;
  border-radius: 24rpx;
  overflow: hidden;
  flex-shrink: 0;
  border: 3rpx solid #f0f0f0;
  background-color: #f5f5f5;
  box-shadow: 0 8rpx 25rpx rgba(0, 0, 0, 0.1);
  position: relative;
  transition: all 0.3s ease;
  margin-right: 28rpx;
}

.avatar-container:hover {
  transform: scale(1.02);
  box-shadow: 0 12rpx 35rpx rgba(0, 0, 0, 0.15);
}

.host-avatar {
  width: 100%;
  height: 100%;
  display: block;
  transition: transform 0.5s ease;
}

.avatar-container:hover .host-avatar {
  transform: scale(1.05);
}

/* 信息区域 */
.host-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

/* 姓名 */
.host-name {
  font-size: 36rpx;
  font-weight: 900;
  color: #000000;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  line-height: 1.2;
}

/* 标签 */
.host-tags {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.tag {
  padding: 5rpx 15rpx;
  background-color: #f0f0f0;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #666;
}

/* 位置 */
.host-location {
  display: flex;
  align-items: center;
  gap: 5rpx;
  font-size: 24rpx;
  color: #666;
}

.location-icon {
  font-size: 24rpx;
}

/* 暂停接单标识 */
.pause-tag {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background-color: rgba(0, 0, 0, 0.6);
  color: white;
  padding: 20rpx 40rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
  font-weight: bold;
  z-index: 10;
  backdrop-filter: blur(5rpx);
}

/* 价格和操作 */
.host-price-action {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
  min-width: 120rpx;
}

/* 价格 */
.host-price {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.price {
  font-size: 36rpx;
  font-weight: 700;
  color: #000;
}

.price-unit {
  font-size: 24rpx;
  color: #999;
}

/* 预约按钮 */
.book-btn {
  background: linear-gradient(135deg, #ff9a9e, #fecfef, #a8edea, #fed6e3);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  padding: 10rpx 28rpx;
  border-radius: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 154, 158, 0.3);
  transition: all 0.3s ease;
  cursor: pointer;
  user-select: none;
}

.book-btn:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(255, 154, 158, 0.2);
}

.book-btn-disabled {
  background: #ccc;
  box-shadow: none;
  color: #fff;
  cursor: not-allowed;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  text-align: center;
  animation: emptyFadeIn 0.8s ease-out;
}

@keyframes emptyFadeIn {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.empty-icon {
  margin-bottom: 40rpx;
  animation: heartBeat 2s infinite ease-in-out;
}

@keyframes heartBeat {
  0%, 100% {
    transform: scale(1);
  }
  14% {
    transform: scale(1.1);
  }
  28% {
    transform: scale(1);
  }
  42% {
    transform: scale(1.1);
  }
  70% {
    transform: scale(1);
  }
}

.empty-title {
  font-size: 36rpx;
  font-weight: 900;
  color: #000000;
  margin-bottom: 16rpx;
  text-transform: uppercase;
  letter-spacing: 4rpx;
}

.empty-subtitle {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.6;
  text-transform: uppercase;
  letter-spacing: 2rpx;
  margin-bottom: 40rpx;
  max-width: 80%;
}

/* 加载动画 */
.loading-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  z-index: 9999;
}

.loading-spinner {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.spinner-outer {
  position: absolute;
  width: 100%;
  height: 100%;
  border: 8rpx solid transparent;
  border-top: 8rpx solid #ff9a9e;
  border-right: 8rpx solid #fecfef;
  border-bottom: 8rpx solid #a8edea;
  border-left: 8rpx solid #fed6e3;
  border-radius: 50%;
  animation: spin 1.5s linear infinite;
  background-color: transparent;
}

.spinner-inner {
  position: absolute;
  width: 70%;
  height: 70%;
  border: 6rpx solid transparent;
  border-top: 6rpx solid #a8edea;
  border-right: 6rpx solid #fed6e3;
  border-bottom: 6rpx solid #ff9a9e;
  border-left: 6rpx solid #fecfef;
  border-radius: 50%;
  animation: spin-reverse 1s linear infinite;
  background-color: transparent;
}

.spinner-dot {
  position: absolute;
  width: 20rpx;
  height: 20rpx;
  background: linear-gradient(135deg, #ff9a9e, #fecfef, #a8edea, #fed6e3);
  border-radius: 50%;
  animation: pulse 2s infinite;
  box-shadow: 0 0 20rpx rgba(255, 154, 158, 0.6);
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

@keyframes spin-reverse {
  0% { transform: rotate(360deg); }
  100% { transform: rotate(0deg); }
}

@keyframes pulse {
  0% {
    transform: scale(1);
    opacity: 1;
  }
  50% {
    transform: scale(1.3);
    opacity: 0.7;
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

/* 动画效果 */
@keyframes fade-in {
  from {
    opacity: 0;
    transform: translateY(-20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes slide-up {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes sectionSlideIn {
  from {
    opacity: 0;
    transform: translateX(-20rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes cardFadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 响应式设计 */
@media screen and (max-width: 750rpx) {
  .page-header {
    padding: 50rpx 30rpx;
  }
  
  .brand-logo {
    font-size: 48rpx;
    letter-spacing: 12rpx;
    margin-bottom: 30rpx;
  }
  
  .page-title {
    font-size: 36rpx;
    letter-spacing: 5rpx;
  }
  
  .page-content {
    padding: 30rpx;
  }
  
  .host-list-section {
    padding: 30rpx;
    margin-bottom: 20rpx;
  }
  
  .section-title {
    font-size: 36rpx;
    letter-spacing: 5rpx;
  }
  
  .host-count {
    font-size: 24rpx;
    letter-spacing: 2rpx;
    padding: 8rpx 16rpx;
  }
  
  .host-item {
    padding: 24rpx 0;
  }
  
  .avatar-container {
    width: 100rpx;
    height: 100rpx;
    margin-right: 24rpx;
  }
  
  .host-name {
    font-size: 32rpx;
  }

  .tag {
    font-size: 20rpx;
    padding: 4rpx 12rpx;
  }
  
  .host-location {
    font-size: 22rpx;
  }
  
  .price {
    font-size: 32rpx;
  }
  
  .price-unit {
    font-size: 22rpx;
  }
  
  .book-btn {
    font-size: 22rpx;
    padding: 8rpx 24rpx;
  }
  
  .empty-state {
    padding: 100rpx 30rpx;
  }
  
  .empty-title {
    font-size: 32rpx;
    letter-spacing: 3rpx;
  }
  
  .empty-subtitle {
    font-size: 22rpx;
    letter-spacing: 1.5rpx;
  }
}