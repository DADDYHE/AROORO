<!-- 寄养家庭列表页面 - 艺术化设计 -->
<view class="page-container">
  <!-- 头部区域 -->
  <view class="page-header">
    <view class="header-content">
      <!-- 品牌标识 -->
      <view class="brand-logo">Arooro</view>
      <view class="page-title">可选寄养家庭</view>
    </view>
  </view>

  <!-- 主要内容 -->
  <view class="page-content">
    <!-- 加载动画 -->
    <view class="loading-container" wx:if="{{isLoading}}">
      <view class="loading-spinner">
        <view class="spinner-outer"></view>
        <view class="spinner-inner"></view>
        <view class="spinner-dot"></view>
      </view>
    </view>
    
    <!-- 寄养家庭列表 -->
    <view class="host-list-section" wx:if="{{hosts.length > 0}}">
      <view class="section-header">
        <text class="section-title">可选寄养家庭</text>
        <text class="host-count">{{hosts.length}} 个</text>
      </view>
      
      <view class="host-list">
        <view 
          wx:for="{{hosts}}" 
          wx:key="id" 
          class="host-item {{item.isAcceptingOrders === false ? 'disabled' : ''}}"
          bindtap="{{item.isAcceptingOrders === false ? '' : 'selectHost'}}"
          data-id="{{item.id}}"
        >
          <!-- 详情入口区域：包含头像、信息和价格操作 -->
          <view class="detail-area" catchtap="{{item.isAcceptingOrders === false ? '' : 'selectHost'}}" data-id="{{item.id}}">
            <view class="avatar-container">
              <image lazy-load class="host-avatar" src="{{item.avatarUrl || '/images/default-avatar.svg'}}" mode="aspectFill" binderror="onCloudImageError" data-src="{{item.avatarUrl}}" data-path="hosts[{{index}}].avatarUrl" />
            </view>
            <view class="host-info">
              <text class="host-name">{{item.name}}</text>
              <view class="host-tags">
                <text 
                  wx:for="{{item.tags}}" 
                  wx:key="index" 
                  class="tag"
                >{{item}}</text>
              </view>
              <view class="host-location">
                <text class="location-icon">📍</text>
                <text>{{item.location}}</text>
              </view>
              <!-- 暂停接单标识 -->
              <text wx:if="{{item.isAcceptingOrders === false}}" class="pause-tag">已暂停接待</text>
            </view>
          </view>
          
          <!-- 价格和操作区域 -->
          <view class="host-price-action">
            <view class="host-price">
              <text class="price">¥{{item.price}}</text>
              <text class="price-unit">/天</text>
            </view>
            <view 
              class="book-btn {{item.isAcceptingOrders === false ? 'book-btn-disabled' : ''}}" 
              catchtap="bookHost" 
              data-id="{{item.id}}"
            >
              预约
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:else>
      <view class="empty-icon">
        <van-icon name="home" size="120" color="#e0e0e0" />
      </view>
      <text class="empty-title">暂无可选寄养家庭</text>
      <text class="empty-subtitle">请尝试调整搜索条件或稍后再试</text>
    </view>
  </view>
</view>