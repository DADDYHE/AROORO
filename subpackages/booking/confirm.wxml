<view class="page-container">
  <!-- 头部区域 -->
  <view class="page-header">
    <view class="header-content">
      <!-- 品牌标识 -->
      <view class="brand-logo">Arooro</view>
      <!-- 顶部导航栏 -->
      <view class="top-nav">
        <view class="back-btn" bindtap="goBack">
          <van-icon name="arrow-left" size="32rpx" color="#333" />
        </view>
        <view class="nav-title">确认订单</view>
        <view class="empty"></view>
      </view>
    </view>
  </view>

  <!-- 订单信息卡片 -->
  <view class="info-card">
    <view class="card-header">
      <van-icon name="info-o" size="28rpx" color="#ff5050" />
      <text class="card-title">订单信息</text>
    </view>
    
    <view class="info-item">
      <text class="label">入住日期</text>
      <text class="value">{{ selectedDates.start }}</text>
    </view>
    
    <view class="info-item">
      <text class="label">退房日期</text>
      <text class="value">{{ selectedDates.end }}</text>
    </view>
    
    <view class="info-item">
      <text class="label">寄养天数</text>
      <text class="value">{{ selectedDates.days }}天</text>
    </view>
  </view>

  <!-- 宠物信息卡片 -->
  <view class="info-card">
    <view class="card-header">
      <van-icon name="friends-o" size="28rpx" color="#ff5050" />
      <text class="card-title">宠物信息</text>
    </view>
    
    <view class="info-item">
      <text class="label">宠物数量</text>
      <text class="value">{{ selectedPets.length }}只</text>
    </view>
    
    <block wx:for="{{ selectedPetsDetails }}" wx:key="_id">
      <view class="pet-item">
        <view class="pet-avatar">
          <image src="{{ item.avatarUrl || 'https://picsum.photos/200/200?random=9' }}" mode="aspectFill" binderror="onPetAvatarLoadError" data-index="{{index}}" />
        </view>
        <view class="pet-info">
          <text class="pet-name">{{ item.name }}</text>
          <text class="pet-details">{{ item.type === 'dog' ? '狗狗' : '猫咪' }} • {{ item.age }}岁</text>
        </view>
      </view>
    </block>
  </view>

  <!-- 价格详情卡片 -->
  <view class="info-card">
    <view class="card-header">
      <van-icon name="rmb" size="28rpx" color="#ff5050" />
      <text class="card-title">价格详情</text>
    </view>
    
    <view class="price-item">
      <text class="label">基础费用</text>
      <text class="value">¥{{ basicPrice }}/天</text>
    </view>
    
    <view class="price-item">
      <text class="label">宠物数量折扣</text>
      <text class="value">-¥{{ discount }}</text>
    </view>
    
    <view class="price-item total">
      <text class="label">总费用</text>
      <text class="value">¥{{ totalPrice }}</text>
    </view>
  </view>

  <!-- 支付方式卡片 -->
  <view class="info-card">
    <view class="card-header">
      <van-icon name="pay-circle-o" size="28rpx" color="#ff5050" />
      <text class="card-title">支付方式</text>
    </view>
    
    <view class="info-item">
      <text class="label">支付方式</text>
      <text class="value">微信支付</text>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <view class="price-info">
      <text class="price-label">实付金额</text>
      <text class="price-value">¥{{ totalPrice }}</text>
    </view>
    <view class="confirm-btn" bindtap="confirmBooking" loading="{{ loading }}">
      <text wx:if="{{ !loading }}">确认预订</text>
      <van-loading wx:if="{{ loading }}" type="spinner" size="20rpx" color="#ffffff" />
    </view>
  </view>

  <!-- 页面底部预留空间 -->
  <view class="content-bottom-space"></view>
</view>