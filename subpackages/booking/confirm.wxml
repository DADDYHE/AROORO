<zy-navbar title="确认订单" />
<scroll-view
  scroll-y
  enhanced
  show-scrollbar="{{false}}"
  refresher-enabled="{{true}}"
  refresher-triggered="{{_refresherTriggered}}"
  bindrefresherrefresh="_onRefresherRefresh"
  bindscrolltolower="_onScrollToLower"
  bindscroll="_onScroll"
  lower-threshold="100"
  style="height: calc(100vh - {{_navbarHeight}}px);"
>
<view class="page-container">
  <!-- 加载动画 -->
  <view wx:if="{{ loading }}" class="loading-container">
    <view class="loading-content">
      <view class="lux-cascade">
  <view class="lux-cascade-dot" style="left: 20rpx; background: #C9A24B; animation-delay: 0ms;"></view>
  <view class="lux-cascade-dot" style="left: 36rpx; background: #A8894A; animation-delay: 150ms;"></view>
  <view class="lux-cascade-dot" style="left: 52rpx; background: #C9A24B; animation-delay: 300ms;"></view>
  <view class="lux-cascade-dot" style="left: 68rpx; background: #A8894A; animation-delay: 450ms;"></view>
  <view class="lux-cascade-dot" style="left: 84rpx; background: #C9A24B; animation-delay: 600ms;"></view>
  <view class="lux-cascade-dot" style="left: 100rpx; background: #A8894A; animation-delay: 750ms;"></view>
  <view class="lux-cascade-dot" style="left: 48rpx; background: #C9A24B; animation-delay: 900ms;"></view>

      </view>
      <text class="loading-text">{{t.BIZ_CSIK0}}</text>
    </view>
  </view>

  <block wx:else>
  <!-- ════════ 卷宗头部：金 eyebrow + 大标题 ════════ -->
  <view class="ds-head">
    <text class="ds-eyebrow">AROORO · BOOKING</text>
    <view class="ds-head-title">确认订单</view>
  </view>

  <!-- ════════ 01 STAY · 入住安排 ════════ -->
  <view class="ds-section">
    <view class="ds-chapter">
      <view class="ds-chapter-meta">
        <text class="ds-chapter-no">01</text>
        <text class="ds-chapter-eyebrow">STAY</text>
        <view class="ds-chapter-rule"></view>
      </view>
      <text class="ds-section-title">入住安排</text>
    </view>

    <!-- 单行起止：日期(相对日) - 天数 - 日期，整行点击弹日历 -->
    <view class="ds-stay" bindtap="openCalendar" data-type="start" hover-class="ds-row--pressed" hover-stay-time="80">
      <view class="ds-stay-cell">
        <view class="ds-stay-date-row">
          <text class="ds-stay-date {{selectedDates.start.text ? '' : 'ds-stay-date--ph'}}">{{ selectedDates.start.text || '选择' }}</text>
          <text class="ds-stay-relative" wx:if="{{selectedDates.start.relativeTag}}">{{ selectedDates.start.relativeTag }}</text>
        </view>
        <text class="ds-stay-tag">入住</text>
      </view>

      <view class="ds-stay-mid">
        <view class="ds-stay-line"></view>
        <view class="ds-stay-days">
          <block wx:if="{{chargeBreakdown}}">
            <text class="ds-stay-days-num">{{ chargeBreakdown.mode === 'hotel' ? chargeBreakdown.nights : chargeBreakdown.days }}</text>
            <text class="ds-stay-days-unit">{{ chargeBreakdown.mode === 'hotel' ? '晚' : '天' }}</text>
          </block>
          <block wx:elif="{{selectedDates.days}}">
            <text class="ds-stay-days-num">{{ selectedDates.days }}</text>
            <text class="ds-stay-days-unit">天</text>
          </block>
          <text class="ds-stay-days-num ds-stay-days-num--ph" wx:else>—</text>
        </view>
        <view class="ds-stay-line"></view>
      </view>

      <view class="ds-stay-cell ds-stay-cell--right">
        <view class="ds-stay-date-row">
          <text class="ds-stay-date {{selectedDates.end.text ? '' : 'ds-stay-date--ph'}}">{{ selectedDates.end.text || '选择' }}</text>
          <text class="ds-stay-relative" wx:if="{{selectedDates.end.relativeTag}}">{{ selectedDates.end.relativeTag }}</text>
        </view>
        <text class="ds-stay-tag">结束</text>
      </view>
    </view>

    <!-- 时刻行（必填）：hotel 超时判定 / hourly24 计费的依据 -->
    <view class="ds-time-row">
      <picker mode="time" value="{{startTime}}" bindchange="onStartTimeChange" class="ds-time-picker">
        <view class="ds-time-cell">
          <text class="ds-time-label">入住时刻</text>
          <text class="ds-time-value {{startTime ? '' : 'ds-time-value--ph'}}">{{ startTime || '选择' }}</text>
        </view>
      </picker>
      <view class="ds-time-rule"></view>
      <picker mode="time" value="{{endTime}}" bindchange="onEndTimeChange" class="ds-time-picker">
        <view class="ds-time-cell ds-time-cell--right">
          <text class="ds-time-label">离开时刻</text>
          <text class="ds-time-value {{endTime ? '' : 'ds-time-value--ph'}}">{{ endTime || '选择' }}</text>
        </view>
      </picker>
    </view>

    <!-- 计费提示：hotel 超时加收 / hourly24 时长拆分（JS 预计算） -->
    <view class="ds-charge-note" wx:if="{{chargeNote}}">
      <text class="ds-charge-note-text">{{ chargeNote }}</text>
    </view>
  </view>

  <!-- ════════ 02 GUESTS · 寄养宠物 ════════ -->
  <view class="ds-section">
    <view class="ds-chapter">
      <view class="ds-chapter-meta">
        <text class="ds-chapter-no">02</text>
        <text class="ds-chapter-eyebrow">GUESTS</text>
        <view class="ds-chapter-rule"></view>
      </view>
      <text class="ds-section-title">寄养宠物</text>
    </view>

    <view class="ds-row" bindtap="selectPets" hover-class="ds-row--pressed" hover-stay-time="80">
      <text class="ds-row-key">宠物数量</text>
      <view class="ds-row-val">
        <text class="ds-row-text {{selectedPets.length ? '' : 'ds-row-text--ph'}}">{{ selectedPets.length ? selectedPets.length + ' 只' : '请选择宠物' }}</text>
        <view class="ds-chev"></view>
      </view>
    </view>

    <view class="ds-pet" wx:for="{{ selectedPetsDetails }}" wx:key="id">
      <view class="ds-pet-avatar">
        <image lazy-load class="ds-pet-img" src="{{ item.avatarUrl || '/images/default-avatar.svg' }}" mode="aspectFill" binderror="onCloudImageError" data-src="{{item.avatarUrl}}" data-path="selectedPetsDetails[{{index}}].avatarUrl" data-index="{{index}}" />
      </view>
      <view class="ds-pet-info">
        <text class="ds-pet-name">{{ item.name || '未知' }}</text>
        <text class="ds-pet-meta">
          <text wx:if="{{item.breed}}">{{ item.breed }}</text>
          <text wx:else>{{ (item.type === 'dog' || item.type === '狗狗') ? '狗狗' : (item.type === 'exotic' || item.type === '异宠') ? '异宠' : '猫咪' }}</text>
          <text wx:if="{{item.birthday}}"> · {{ item.birthday }}</text>
        </text>
        <view class="ds-pet-tags" wx:if="{{petServices[item.id]}}">
          <text class="ds-pet-tag" wx:if="{{petServices[item.id].feeding}}">{{t.BIZ_EZP5}}</text>
          <text class="ds-pet-tag" wx:if="{{petServices[item.id].walkMinutes > 0}}">遛狗{{petServices[item.id].walkMinutes}}分钟</text>
        </view>
        <text class="ds-pet-dates" wx:if="{{petServices[item.id].serviceDatesText}}">{{petServices[item.id].serviceDatesText}}</text>
      </view>
    </view>

    <view class="ds-empty" wx:if="{{!selectedPetsDetails || selectedPetsDetails.length === 0}}">
      <text>暂无宠物信息</text>
    </view>
  </view>

  <!-- ════════ 03 STATEMENT · 费用明细 ════════ -->
  <view class="ds-section">
    <view class="ds-chapter">
      <view class="ds-chapter-meta">
        <text class="ds-chapter-no">03</text>
        <text class="ds-chapter-eyebrow">STATEMENT</text>
        <view class="ds-chapter-rule"></view>
      </view>
      <text class="ds-section-title">费用明细</text>
    </view>

    <block wx:for="{{ serviceBreakdown }}" wx:key="name">
      <view class="ds-fee">
        <text class="ds-fee-key">{{ item.name }}</text>
        <text class="ds-fee-val">¥{{ item.subtotal }}</text>
      </view>
      <view class="ds-fee ds-fee--sub">
        <text class="ds-fee-key">寄养 {{item.serviceDaysLabel}}</text>
        <text class="ds-fee-val">¥{{ item.baseAmount }}</text>
      </view>
      <view class="ds-fee ds-fee--sub" wx:if="{{ item.walkMinutes > 0 }}">
        <text class="ds-fee-key">遛狗 {{item.walkMinutes}}分钟</text>
        <text class="ds-fee-val">¥{{ item.walkAmount }}</text>
      </view>
    </block>

    <view class="ds-fee" wx:if="{{serviceBreakdown.length === 0}}">
      <text class="ds-fee-key">基础费用</text>
      <text class="ds-fee-val">¥{{ basicPrice }}</text>
    </view>

    <view class="ds-fee" wx:if="{{discount > 0}}">
      <text class="ds-fee-key">优惠减免</text>
      <text class="ds-fee-val ds-fee-val--gold">-¥{{ discount }}</text>
    </view>

    <view class="ds-total">
      <text class="ds-total-key">总费用</text>
      <view class="ds-total-val">
        <text class="ds-total-symbol">¥</text>
        <text class="ds-total-num">{{ totalPrice }}</text>
      </view>
    </view>
  </view>

  <!-- ════════ 04 PAYMENT · 支付与优惠 ════════ -->
  <view class="ds-section" wx:if="{{totalPrice > 0}}">
    <view class="ds-chapter">
      <view class="ds-chapter-meta">
        <text class="ds-chapter-no">04</text>
        <text class="ds-chapter-eyebrow">PAYMENT</text>
        <view class="ds-chapter-rule"></view>
      </view>
      <text class="ds-section-title">支付与优惠</text>
    </view>

    <view class="ds-row">
      <text class="ds-row-key">支付方式</text>
      <view class="ds-row-val"><text class="ds-row-text">微信支付</text></view>
    </view>

    <view class="ds-row" bindtap="onToggleCouponSelector" hover-class="ds-row--pressed" hover-stay-time="80">
      <text class="ds-row-key">优惠券</text>
      <view class="ds-row-val">
        <text class="ds-row-text ds-row-text--gold" wx:if="{{selectedCoupon}}">{{selectedCoupon.templateName}} -¥{{couponDiscount}}</text>
        <text class="ds-row-text" wx:elif="{{availableCoupons.length > 0}}">{{availableCoupons.length}} 张可用</text>
        <text class="ds-row-text ds-row-text--ph" wx:else>暂无可用</text>
        <view class="ds-chev {{showCouponSelector ? 'ds-chev--open' : ''}}"></view>
      </view>
    </view>

    <view class="ds-coupons" wx:if="{{showCouponSelector}}">
      <view class="ds-coupon" wx:for="{{availableCoupons}}" wx:key="_id" bindtap="onSelectCoupon" data-id="{{item._id}}" data-amount="{{item.discountAmount}}" hover-class="ds-row--pressed" hover-stay-time="80">
        <view class="ds-coupon-amt"><text>¥</text><text class="ds-coupon-num">{{item.discountAmount}}</text></view>
        <view class="ds-coupon-info">
          <text class="ds-coupon-name">{{item.templateName}}</text>
          <text class="ds-coupon-rule" wx:if="{{item.rules.threshold > 0}}">满{{item.rules.threshold}}元可用</text>
        </view>
      </view>
    </view>
    <view class="ds-coupon-remove" wx:if="{{selectedCoupon && !showCouponSelector}}" bindtap="onRemoveCoupon">不使用优惠券</view>
  </view>

  <!-- 卷宗落款 -->
  <view class="ds-foot">
    <view class="ds-foot-line"></view>
    <text class="ds-foot-text">AROORO · 家庭寄养</text>
    <view class="ds-foot-line"></view>
  </view>

  <view class="content-bottom-space"></view>
  </block>
</view>

<!-- 底部操作栏 -->
<root-portal>
<view class="bottom-bar">
  <view class="price-info">
    <text class="price-label">订单总额</text>
    <view class="price-value-row">
      <text class="price-symbol">¥</text>
      <text class="price-value">{{ totalPrice }}</text>
    </view>
    <text class="coupon-sub" wx:if="{{couponDiscount > 0}}">已优惠 ¥{{couponDiscount}}</text>
    <text class="min-amount-tip">请提交后选择支付全款或预付定金。</text>
    <text class="min-amount-tip">（定金为全款金额的30%，定金不退）</text>
  </view>
  <view class="confirm-btn" bindtap="confirmBooking" loading="{{ loading }}">
    <text wx:if="{{ !loading }}">确认预订</text>
    <zy-loading wx:if="{{ loading }}" type="circular" size="20" color="#F7F5EF" />
  </view>
</view>
</root-portal>

<!-- 日历弹窗 -->
  <zy-calendar
    show="{{ showCalendar }}"
    bind:confirm="onConfirmCalendar"
    bind:close="onCloseCalendar"
    type="range"
    min-date="{{ minDate }}"
    max-date="{{ maxDate }}"
    default-date="{{ defaultDate }}"
    color="#1F3A1F"
    show-confirm="{{ false }}"
    confirm-text="确认"
    show-mark="{{ true }}"
    bind:change="onCalendarChange"
    poppable="{{ true }}"
    position="bottom"
    round="{{ true }}"
  />
</scroll-view>
