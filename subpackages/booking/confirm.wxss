@import '../../styles/loading-animation.wxss';

@import '../../styles/components.wxss';
/* 确认订单页面 - 艺术化设计 */

.page-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f8f9fa;
  position: relative;
}

/* 头部区域 */
.page-header {
  padding: 60rpx 40rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  position: relative;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  z-index: 1;
}

.header-content {
  max-width: 100%;
  display: flex;
  flex-direction: column;
  position: relative;
  z-index: 2;
}

/* 品牌标识 */
.brand-logo {
  font-size: 52rpx;
  font-weight: 900;
  letter-spacing: 14rpx;
  text-align: left;
  margin-bottom: 40rpx;
  color: #000000;
  text-transform: uppercase;
  font-family: 'Arial Black', 'Arial Bold', sans-serif;
  line-height: 1;
  text-shadow: 2rpx 2rpx 4rpx rgba(0, 0, 0, 0.1);
  animation: fade-in 0.8s ease-out;
}

/* 页面标题 */
.page-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #323233;
  letter-spacing: 6rpx;
  line-height: 1.2;
  text-transform: uppercase;
  text-shadow: 1rpx 1rpx 2rpx rgba(0, 0, 0, 0.1);
  animation: slide-up 0.8s ease-out 0.2s both;
}

.page-content {
  flex: 1;
  padding: 40rpx;
  position: relative;
  z-index: 1;
  padding-bottom: 140rpx;
}

/* 信息卡片 */
.info-card {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  border: 1rpx solid rgba(0, 0, 0, 0.05);
  border-radius: 28rpx;
  padding: 0;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
  animation: sectionSlideIn 0.8s ease-out both;
}

.info-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, #ff9a9e, #fecfef, #a8edea, #fed6e3);
}

/* 卡片头部 */
.card-header {
  padding: 32rpx 32rpx 24rpx;
  background: rgba(255, 255, 255, 0.8);
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.card-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #323233;
  text-transform: uppercase;
  letter-spacing: 4rpx;
  line-height: 1;
  text-shadow: 1rpx 1rpx 2rpx rgba(0, 0, 0, 0.1);
}

/* 信息项 */
.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 36rpx 32rpx;
  border-bottom: 1rpx solid #f5f7fa;
  transition: all 0.3s ease;
  cursor: pointer;
}

.info-item:active {
  background-color: rgba(0, 0, 0, 0.02);
  transform: translateX(10rpx);
}

.info-item:last-child {
  border-bottom: none;
}

.info-item .label {
  font-size: 30rpx;
  font-weight: 500;
  color: #666666;
  letter-spacing: 1rpx;
}

.info-item .value {
  font-size: 30rpx;
  color: #000000;
  font-weight: 600;
  letter-spacing: 1rpx;
}

/* 交互项 */
.interaction-item {
  position: relative;
}

.interaction-item::after {
  content: '';
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 40rpx;
  height: 40rpx;
  background: linear-gradient(135deg, #ff9a9e, #fecfef, #a8edea, #fed6e3);
  border-radius: 50%;
  opacity: 0;
  transition: all 0.3s ease;
}

.interaction-item:active::after {
  opacity: 0.1;
  transform: translateY(-50%) scale(1.2);
}

/* 带箭头的值 */
.value-with-arrow {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 16rpx;
  background-color: #f5f7fa;
  border-radius: 12rpx;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.value-with-arrow:active {
  background-color: #e6e8eb;
  transform: scale(0.98);
}

.value-with-arrow .arrow {
  font-size: 40rpx;
  color: #c8c9cc;
  margin-left: 8rpx;
  font-weight: 300;
  transition: transform 0.3s ease;
}

.value-with-arrow:active .arrow {
  transform: translateX(4rpx);
}

.value-weekday {
  font-size: 26rpx;
  color: #999999;
  margin-left: 4rpx;
  font-weight: 400;
}

.value-empty {
  font-size: 30rpx;
  color: #cccccc;
  font-weight: 400;
}

/* 空提示 */
.empty-tip {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 60rpx 32rpx;
  color: #999999;
  font-size: 28rpx;
  background-color: #f5f7fa;
  border-radius: 16rpx;
  margin: 24rpx 32rpx 32rpx;
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

/* 宠物项 */
.pet-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f5f7fa;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.pet-item:active {
  background-color: #f5f7fa;
  transform: translateX(10rpx);
}

.pet-item:last-child {
  border-bottom: none;
}

/* 头像容器 */
.avatar-container {
  width: 100rpx;
  height: 100rpx;
  border-radius: 24rpx;
  overflow: hidden;
  flex-shrink: 0;
  border: 3rpx solid #f0f0f0;
  background-color: #f5f5f5;
  box-shadow: 0 8rpx 25rpx rgba(0, 0, 0, 0.1);
  position: relative;
  transition: all 0.3s ease;
  margin-right: 28rpx;
}

.avatar-container:hover {
  transform: scale(1.02);
  box-shadow: 0 12rpx 35rpx rgba(0, 0, 0, 0.15);
}

.pet-image {
  width: 100%;
  height: 100%;
  display: block;
  transition: transform 0.5s ease;
}

.avatar-container:hover .pet-image {
  transform: scale(1.05);
}

.pet-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.pet-name {
  font-size: 36rpx;
  font-weight: 900;
  color: #000000;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  line-height: 1.2;
}

.pet-details {
  font-size: 24rpx;
  color: #666666;
  font-weight: 400;
  letter-spacing: 1rpx;
  text-transform: uppercase;
}

/* 价格项 */
.price-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f5f7fa;
  transition: all 0.3s ease;
}

.price-item:active {
  background-color: #f5f7fa;
}

.price-item:last-child {
  border-bottom: none;
}

/* 价格行布局 */
.value-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

/* 天数提示 */
.days-hint {
  font-size: 24rpx;
  color: #999999;
  font-weight: 400;
  letter-spacing: 1rpx;
}

.price-item.total {
  background: linear-gradient(135deg, #fff5f0 0%, #fff9f5 100%);
  border-radius: 16rpx;
  margin: 16rpx 32rpx 24rpx;
  padding: 40rpx 32rpx;
  border: 1rpx solid rgba(255, 154, 158, 0.1);
  transition: all 0.3s ease;
}

.price-item.total:active {
  transform: scale(0.98);
}

.price-item.total .label {
  font-size: 34rpx;
  font-weight: 600;
  color: #ff9a9e;
  letter-spacing: 1rpx;
  text-transform: uppercase;
}

.price-item.total .value {
  font-size: 40rpx;
  font-weight: 700;
  color: #ff9a9e;
  letter-spacing: 2rpx;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
  padding: 32rpx 40rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 100;
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.08);
  animation: slide-up 0.8s ease-out 0.4s both;
}

.price-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.price-label {
  font-size: 26rpx;
  color: #666666;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

.price-value {
  font-size: 44rpx;
  font-weight: 700;
  color: #ff9a9e;
  letter-spacing: 2rpx;
  text-shadow: 1rpx 1rpx 2rpx rgba(255, 154, 158, 0.3);
}

.price-value .symbol {
  font-size: 32rpx;
  margin-right: 4rpx;
  font-weight: 600;
}

/* 确认按钮 */
.confirm-btn {
  min-width: 280rpx;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  background: linear-gradient(135deg, #ff9a9e, #fecfef, #a8edea, #fed6e3);
  color: #ffffff;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 154, 158, 0.3);
  transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
  position: relative;
  overflow: hidden;
  text-transform: uppercase;
  cursor: pointer;
  user-select: none;
}

.confirm-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
  transition: left 0.6s;
}

.confirm-btn:hover::before {
  left: 100%;
}

.confirm-btn:hover {
  transform: translateY(-2rpx);
  box-shadow: 0 12rpx 32rpx rgba(255, 154, 158, 0.4);
}

.confirm-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(255, 154, 158, 0.4);
}

/* 页面内容底部预留空间 */
.content-bottom-space {
  height: 140rpx;
}

/* 加载动画 */

.loading-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.loading-dot:nth-child(3) {
  animation-delay: 0.4s;
}

.loading-more {
  text-align: center;
  padding: 32rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.loading-more-text {
  font-size: 24rpx;
  color: #8E8E93;
  letter-spacing: 4rpx;
}

/* 动画效果 */
@keyframes fade-in {
  from {
    opacity: 0;
    transform: translateY(-20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes slide-up {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes sectionSlideIn {
  from {
    opacity: 0;
    transform: translateX(-20rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

/* 响应式设计 */
@media screen and (max-width: 750rpx) {
  .page-header {
    padding: 50rpx 30rpx;
  }
  
  .brand-logo {
    font-size: 48rpx;
    letter-spacing: 12rpx;
    margin-bottom: 30rpx;
  }
  
  .page-title {
    font-size: 36rpx;
    letter-spacing: 5rpx;
  }
  
  .page-content {
    padding: 30rpx;
    padding-bottom: 120rpx;
  }
  
  .info-card {
    margin-bottom: 20rpx;
  }
  
  .card-header {
    padding: 28rpx 28rpx 20rpx;
  }
  
  .card-title {
    font-size: 32rpx;
    letter-spacing: 3rpx;
  }
  
  .info-item {
    padding: 30rpx 28rpx;
  }
  
  .info-item .label {
    font-size: 28rpx;
  }
  
  .info-item .value {
    font-size: 28rpx;
  }
  
  .avatar-container {
    width: 90rpx;
    height: 90rpx;
    margin-right: 24rpx;
  }
  
  .pet-name {
    font-size: 32rpx;
  }
  
  .pet-details {
    font-size: 22rpx;
  }
  
  .price-item {
    padding: 28rpx;
  }
  
  .price-item.total {
    margin: 12rpx 28rpx 20rpx;
    padding: 32rpx 28rpx;
  }
  
  .price-item.total .label {
    font-size: 32rpx;
  }
  
  .price-item.total .value {
    font-size: 36rpx;
  }
  
  .bottom-bar {
    padding: 28rpx 30rpx;
  }
  
  .price-label {
    font-size: 24rpx;
  }
  
  .price-value {
    font-size: 40rpx;
  }
  
  .confirm-btn {
    min-width: 240rpx;
    height: 88rpx;
    line-height: 88rpx;
    font-size: 32rpx;
  }
  
  .content-bottom-space {
    height: 120rpx;
  }
}

/* 日历弹窗样式 */
.van-calendar__popup--bottom {
  z-index: 2000 !important;
}

.van-calendar__header {
  background: linear-gradient(135deg, #ff9a9e, #fecfef, #a8edea, #fed6e3) !important;
}

.van-calendar__confirm {
  color: #ff9a9e !important;
  font-weight: 600 !important;
}

.van-calendar__day--selected {
  background: linear-gradient(135deg, #ff9a9e, #fecfef) !important;
}

.van-calendar__day--start,
.van-calendar__day--end {
  background: linear-gradient(135deg, #ff9a9e, #fecfef) !important;
}

.pet-service-tags {
  display: flex;
  gap: 8rpx;
  margin-top: 8rpx;
}

.service-tag {
  font-size: 22rpx;
  color: #4ECDC4;
  background: rgba(78, 205, 196, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.pet-service-dates {
  font-size: 22rpx;
  color: #999999;
  margin-top: 4rpx;
  line-height: 1.4;
}

.price-pet-group {
  padding-bottom: 16rpx;
}

.price-sub-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 32rpx 12rpx 48rpx;
}

.sub-label {
  font-size: 26rpx;
  color: #999999;
}

.sub-value {
  font-size: 26rpx;
  color: #666666;
}
