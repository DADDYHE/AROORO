@import '../../styles/loading-animation.wxss';

@import '../../styles/components.wxss';
/* 寄养确认订单 - AROORO 豪华宠物寄养 */

/* ========== 页面容器 ========== */
.page-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
}

/* ========== 头部区域 ========== */
.page-header {
  padding: 60rpx var(--page-padding);
  background: var(--card-color);
  position: relative;
  border-bottom: 1rpx solid var(--hairline);
  z-index: 1;
  animation-name: zy-fade-in-up;
  animation-duration: 480ms;
  animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  animation-fill-mode: forwards;
}

.header-content {
  max-width: 100%;
  display: flex;
  flex-direction: column;
  position: relative;
  z-index: 2;
}

/* ========== 品牌标识 ========== */
.brand-logo {
  font-size: 44rpx;
  font-weight: 300;
  letter-spacing: 0.12em;
  text-align: left;
  margin-bottom: 32rpx;
  color: var(--primary-color);
  font-family: var(--font-sans);
  line-height: 1;
}

/* ========== 页面标题 ========== */
.page-title {
  font-size: 36rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.04em;
  line-height: 1.3;
}

/* ========== 页面内容区 ========== */
.page-content {
  flex: 1;
  padding: var(--zy-space-lg) var(--page-padding);
  position: relative;
  z-index: 1;
  padding-bottom: 200rpx;
}

/* ========== 信息卡片 ========== */
.info-card {
  background: var(--card-color);
  border: 1rpx solid var(--hairline);
  border-radius: var(--zy-radius-lg);
  padding: 0;
  margin-bottom: var(--zy-space-lg);
  position: relative;
  overflow: hidden;
  animation-name: zy-fade-in-up;
  animation-duration: 480ms;
  animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  animation-fill-mode: forwards;
}

.info-card:nth-child(1) { animation-delay: 80ms; }
.info-card:nth-child(2) { animation-delay: 140ms; }
.info-card:nth-child(3) { animation-delay: 200ms; }
.info-card:nth-child(4) { animation-delay: 260ms; }

/* 香槟金顶部装饰线 - 替代彩虹渐变 */
.info-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 48rpx;
  height: 2rpx;
  background: var(--accent-color);
  opacity: 0.6;
}

/* 卡片按压态（仅 transform/opacity） */
.info-card--pressed {
  opacity: 0.85;
  transform: scale(0.995);
  transition: opacity var(--transition-fast), transform var(--transition-fast);
}

/* ========== 卡片头部 ========== */
.card-header {
  padding: var(--zy-space-lg) var(--zy-space-lg) var(--zy-space-sm2);
  background: var(--card-color);
  border-bottom: 1rpx solid var(--hairline);
}

.card-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.04em;
  line-height: 1;
}

/* ========== 信息项 ========== */
.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--zy-space-lg) var(--zy-space-lg);
  border-bottom: 1rpx solid var(--divider-color);
}

.info-item:last-child {
  border-bottom: none;
}

.info-item .label {
  font-size: 28rpx;
  font-weight: 400;
  color: var(--text-secondary);
  letter-spacing: 0.02em;
}

.info-item .value {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
  letter-spacing: 0.02em;
  text-align: right;
}

/* ========== 交互项 ========== */
.interaction-item {
  position: relative;
}

/* ========== 带箭头的值 ========== */
.value-with-arrow {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 0;
  color: var(--text-primary);
  border-bottom: 1rpx solid var(--hairline);
}

.value-with-arrow .arrow {
  font-size: 32rpx;
  color: var(--text-tertiary);
  margin-left: 4rpx;
  font-weight: 300;
}

.value-weekday {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-left: 4rpx;
  font-weight: 400;
}

.value-empty {
  font-size: 28rpx;
  color: var(--text-tertiary);
  font-weight: 400;
}

/* ========== 空提示 ========== */
.empty-tip {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 56rpx var(--zy-space-lg);
  color: var(--text-tertiary);
  font-size: 26rpx;
  background-color: var(--primary-wash);
  border-radius: var(--zy-radius-md);
  margin: var(--zy-space-sm2) var(--zy-space-lg) var(--zy-space-lg);
  letter-spacing: 0.08em;
  font-weight: 400;
}

/* ========== 宠物项 ========== */
.pet-item {
  display: flex;
  align-items: center;
  padding: var(--zy-space-lg);
  border-bottom: 1rpx solid var(--divider-color);
}

.pet-item:last-child {
  border-bottom: none;
}

/* ========== 头像容器 ========== */
.avatar-container {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  border: 1rpx solid var(--hairline);
  position: relative;
  margin-right: var(--zy-space-lg);
}

.pet-image {
  width: 100%;
  height: 100%;
  display: block;
}

.pet-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.pet-name {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.02em;
  line-height: 1.3;
}

.pet-details {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 400;
  letter-spacing: 0.02em;
}

/* ========== 服务标签 ========== */
.pet-service-tags {
  display: flex;
  gap: 8rpx;
  margin-top: 8rpx;
  flex-wrap: wrap;
}

.service-tag {
  font-size: 22rpx;
  color: var(--boarding-primary);
  background: var(--boarding-tint);
  padding: 4rpx 12rpx;
  border-radius: var(--zy-radius-xs);
  font-weight: 400;
  letter-spacing: 0.02em;
}

.pet-service-dates {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-top: 4rpx;
  line-height: 1.5;
  font-weight: 400;
}

/* ========== 价格项 ========== */
.price-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--zy-space-lg);
  border-bottom: 1rpx solid var(--divider-color);
}

.price-item:last-child {
  border-bottom: none;
}

/* ========== 价格行布局 ========== */
.value-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

/* ========== 天数提示 ========== */
.days-hint {
  font-size: 24rpx;
  color: var(--text-tertiary);
  font-weight: 400;
  letter-spacing: 0.02em;
}

/* ========== 价格总计区 - 暖陶土色 ========== */
.price-pet-group {
  padding-bottom: 12rpx;
}

.price-sub-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx var(--zy-space-lg) 10rpx 48rpx;
}

.sub-label {
  font-size: 26rpx;
  color: var(--text-tertiary);
  font-weight: 400;
}

.sub-value {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 400;
}

.price-item.total {
  background: var(--boarding-accent);
  border-radius: var(--zy-radius-md);
  margin: var(--zy-space-sm2) var(--zy-space-lg) var(--zy-space-lg);
  padding: 36rpx var(--zy-space-lg);
  border: 1rpx solid rgba(139, 99, 80, 0.12);
}

.price-item.total .label {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--boarding-primary);
  letter-spacing: 0.04em;
}

.price-item.total .value {
  font-size: 36rpx;
  font-weight: 500;
  color: var(--boarding-primary);
  letter-spacing: 0.02em;
}

/* ========== 底部操作栏 ========== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--card-color);
  border-top: 1rpx solid var(--hairline);
  padding: var(--zy-space-lg) var(--page-padding);
  padding-bottom: calc(var(--zy-space-lg) + env(safe-area-inset-bottom));
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 100;
  box-shadow: 0 -2rpx 12rpx rgba(26, 26, 23, 0.04);
}

.price-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.price-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 400;
  letter-spacing: 0.04em;
}

.price-value {
  font-size: 40rpx;
  font-weight: 500;
  color: var(--boarding-primary);
  letter-spacing: 0.02em;
  line-height: 1.2;
}

.price-value .symbol {
  font-size: 26rpx;
  margin-right: 4rpx;
  font-weight: 400;
}

/* ========== 确认按钮 - 深林绿渐变 ========== */
.confirm-btn {
  min-width: 280rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 0.08em;
  background: var(--gradient-primary);
  color: var(--text-on-primary);
  border-radius: var(--zy-radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-glow-primary-btn);
  position: relative;
  overflow: hidden;
  transition: transform var(--transition-fast), opacity var(--transition-fast);
}

/* 微妙光泽扫过（仅 transform，无 background-clip） */
.confirm-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 40%;
  height: 100%;
  background: rgba(255, 255, 255, 0.08);
  transform: translateX(-100%);
  animation-name: zy-shimmer-sweep;
  animation-duration: 3000ms;
  animation-timing-function: linear;
  animation-fill-mode: forwards;
  animation-iteration-count: infinite;
  animation-delay: 2000ms;
}

/* 按钮按压态 */
.confirm-btn--pressed {
  transform: scale(0.98);
  opacity: 0.9;
}

/* ========== 页面内容底部预留空间 ========== */
.content-bottom-space {
  height: 200rpx;
}

/* ========== 加载动画 ========== */
.loading-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--primary-color);
  display: inline-block;
  animation-name: zy-pulse-soft;
  animation-duration: 1400ms;
  animation-timing-function: ease-in-out;
  animation-fill-mode: forwards;
  animation-iteration-count: infinite;
}

.loading-dot:nth-child(1) {
  animation-delay: 0ms;
}

.loading-dot:nth-child(2) {
  animation-delay: 200ms;
}

.loading-dot:nth-child(3) {
  animation-delay: 400ms;
}

.loading-more {
  text-align: center;
  padding: var(--zy-space-lg) 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.loading-more-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 0.08em;
  font-weight: 400;
}
