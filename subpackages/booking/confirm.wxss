/* 页面容器 */
.page-container {
  min-height: 100vh;
  background-color: #fafafa;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Helvetica Neue", Helvetica, Arial, sans-serif;
}

/* 头部区域 */
.page-header {
  padding: 60rpx 40rpx;
  background-color: #fafafa;
  position: relative;
  border-bottom: 1rpx solid #f0f0f0;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
}

.header-content {
  max-width: 100%;
  display: flex;
  flex-direction: column;
}

/* 品牌标识 */
.brand-logo {
  font-size: 52rpx;
  font-weight: 900;
  letter-spacing: 14rpx;
  text-align: left;
  margin-bottom: 50rpx;
  color: #000000;
  text-transform: uppercase;
  font-family: 'Arial Black', 'Arial Bold', sans-serif;
  line-height: 1;
}

/* 顶部导航栏 */
.top-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  background-color: #ffffff;
  position: relative;
}

.top-nav::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 1rpx;
  background-color: #f0f0f0;
}

.top-nav .back-btn {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.top-nav .nav-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
}

.top-nav .empty {
  width: 44rpx;
}

/* 信息卡片 */
.info-card {
  background-color: #ffffff;
  margin: 20rpx;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.card-header {
  display: flex;
  align-items: center;
  padding: 30rpx;
  background-color: #fafafa;
  border-bottom: 1rpx solid #f0f0f0;
}

.card-header .card-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-left: 10rpx;
}

/* 信息项 */
.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-item:last-child {
  border-bottom: none;
}

.info-item .label {
  font-size: 32rpx;
  color: #666;
}

.info-item .value {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}

/* 宠物项 */
.pet-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.pet-item:last-child {
  border-bottom: none;
}

.pet-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 20rpx;
  background-color: #f0f0f0;
}

.pet-avatar image {
  width: 100%;
  height: 100%;
}

.pet-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.pet-name {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 5rpx;
}

.pet-details {
  font-size: 28rpx;
  color: #666;
}

/* 价格项 */
.price-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.price-item:last-child {
  border-bottom: none;
}

.price-item.total {
  background-color: #fff9f9;
}

.price-item.total .label {
  font-size: 36rpx;
  font-weight: bold;
  color: #ff5050;
}

.price-item.total .value {
  font-size: 36rpx;
  font-weight: bold;
  color: #ff5050;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #ffffff;
  padding: 20rpx 30rpx;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  z-index: 1000;
}

.price-info {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  margin-bottom: 20rpx;
}

.price-label {
  font-size: 28rpx;
  color: #999;
  margin-right: 10rpx;
}

.price-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #ff5050;
}

.confirm-btn {
  width: 100%;
  height: 88rpx;
  background-color: #333;
  color: #ffffff;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 页面内容底部预留空间 */
.content-bottom-space {
  height: 200rpx;
}