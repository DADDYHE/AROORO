/* 选择宠物页面样式 - 与我的宠物页面风格一致 */
.page-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f7f8fa;
}

/* 头部区域 */
.page-header {
  padding: 60rpx 40rpx;
  background-color: #f7f8fa;
  position: relative;
  border-bottom: 1rpx solid #f0f0f0;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
}

.header-content {
  max-width: 100%;
  display: flex;
  flex-direction: column;
}

/* 品牌标识 */
.brand-logo {
  font-size: 52rpx;
  font-weight: bold;
  letter-spacing: 14rpx;
  text-align: left;
  margin-bottom: 50rpx;
  color: #000000;
  text-transform: uppercase;
  font-family: 'Arial Black', 'Arial Bold', sans-serif;
  line-height: 1;
}

.page-title-container {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #323233;
  letter-spacing: 6rpx;
  line-height: 1.2;
  text-transform: uppercase;
}

.page-content {
  flex: 1;
  padding: 40rpx;
  padding-bottom: 300rpx; /* 增加底部间距，确保内容不被固定按钮栏遮挡 */
}

/* 创建新宠物档案按钮区域 */
.update-profile-section {
  margin: 0 30rpx 40rpx;
  position: relative;
  z-index: 1000;
}

.update-profile-section .van-button {
  margin-bottom: 0 !important;
  border-radius: 16rpx !important;
  font-size: 32rpx;
  font-weight: bold !important;
  padding: 30rpx 0 !important;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  position: relative;
  z-index: 1000;
}

/* 宠物列表区域 */
.pet-list-section {
  background-color: #ffffff;
  border: 1rpx solid #f0f0f0;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  transition: all 0.4s ease;
}

.pet-list-section:active {
  transform: translateY(3rpx);
  box-shadow: 0 3rpx 15rpx rgba(0, 0, 0, 0.04);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
  padding-bottom: 15rpx;
  border-bottom: 1rpx solid #f2f3f5;
}

.title-group {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.section-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #323233;
  letter-spacing: 6rpx;
  line-height: 1;
  text-transform: uppercase;
}

.pet-count {
  font-size: 26rpx;
  color: #666666;
  background-color: #f5f5f5;
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
  letter-spacing: 3rpx;
  font-weight: 500;
  text-transform: uppercase;
}

.pet-list {
  overflow: hidden;
}

.pet-item {
  display: flex;
  align-items: center;
  padding: 40rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  transition: all 0.3s ease;
  cursor: pointer;
}

.detail-area {
  flex: 1;
  display: flex;
  align-items: center;
  transition: all 0.3s ease;
  padding-right: 20rpx;
  box-sizing: border-box;
}

.detail-area:active {
  background-color: #f5f5f5;
}

.detail-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 40rpx;
  height: 40rpx;
  margin-left: 20rpx;
  padding: 10rpx;
  border-radius: 8rpx;
  transition: all 0.3s ease;
}

.detail-button:active {
  background-color: #f5f5f5;
  transform: scale(0.95);
}

.pet-item:last-child {
  border-bottom: none;
}

.pet-item:active {
  transform: translateX(20rpx);
  opacity: 0.8;
}

.pet-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 30rpx;
  border: 1rpx solid #e0e0e0;
  background-color: #f0f0f0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  display: block;
  overflow: hidden;
  min-width: 120rpx;
  min-height: 120rpx;
  vertical-align: middle;
  position: relative;
}

.pet-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.pet-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #323233;
  margin-bottom: 15rpx;
  letter-spacing: 2rpx;
}

.pet-details {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.pet-type {
  font-size: 26rpx;
  color: #666666;
  letter-spacing: 2rpx;
}

.pet-age {
  font-size: 26rpx;
  color: #909399;
  letter-spacing: 2rpx;
}

/* 选择按钮样式 */
.pet-selector {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 80rpx;
  height: 80rpx;
  z-index: 10;
}

.selector-circle {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 2rpx solid #dcdfe6;
  background-color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.selector-circle.selected {
  background-color: #07c160;
  border-color: #07c160;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  text-align: center;
}

.empty-desc {
  font-size: 26rpx;
  color: #909399;
  line-height: 1.5;
  max-width: 500rpx;
  margin-top: 20rpx;
  letter-spacing: 3rpx;
  text-transform: uppercase;
}

/* 底部操作栏 */
.bottom-action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 30rpx 40rpx 40rpx;
  background-color: #ffffff;
  border-top: 1rpx solid #f0f0f0;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  z-index: 1000;
}

.selected-info {
  margin-bottom: 20rpx;
}

.selected-label {
  font-size: 28rpx;
  color: #666666;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

/* 按钮样式优化 */
.van-button {
  margin-bottom: 15rpx !important;
  border-radius: 12rpx !important;
  font-weight: 500 !important;
}

.van-button--primary {
  background-color: #000000 !important;
  border: none !important;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
}

.van-button--primary:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

.van-button--default {
  border: 1rpx solid #e5e7eb !important;
  background-color: #f8f9fa !important;
  color: #666 !important;
}

/* 确认按钮 */
.confirm-btn {
  background-color: #000000 !important;
  border-radius: 12rpx !important;
  font-size: 32rpx !important;
  font-weight: bold !important;
  text-transform: uppercase;
  letter-spacing: 4rpx;
  padding: 25rpx 0 !important;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
  transition: all 0.3s ease;
}

.confirm-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

.van-button--disabled {
  background-color: #cccccc !important;
  color: #999999 !important;
  box-shadow: none !important;
}

/* 响应式设计 */
@media (max-width: 750rpx) {
  .page-header {
    padding: 50rpx 30rpx;
  }
  
  .brand-logo {
    font-size: 48rpx;
    letter-spacing: 12rpx;
    margin-bottom: 40rpx;
  }
  
  .page-title {
    font-size: 36rpx;
    letter-spacing: 4rpx;
  }
  
  .page-content {
    padding: 30rpx;
    padding-bottom: 300rpx;
  }
  
  .pet-list-section {
    padding: 40rpx 30rpx;
    margin-bottom: 20rpx;
  }
  
  .section-title {
    font-size: 36rpx;
    letter-spacing: 4rpx;
  }
  
  .pet-count {
    font-size: 24rpx;
    letter-spacing: 2rpx;
    padding: 6rpx 16rpx;
  }
  
  .pet-item {
    padding: 30rpx 0;
  }
  
  .pet-avatar {
    width: 100rpx;
    height: 100rpx;
    margin-right: 25rpx;
    display: block;
    overflow: hidden;
    min-width: 100rpx;
    min-height: 100rpx;
  }
  
  .pet-name {
    font-size: 32rpx;
    margin-bottom: 12rpx;
    letter-spacing: 2rpx;
  }
  
  .pet-type {
    font-size: 24rpx;
    letter-spacing: 2rpx;
  }
  
  .pet-age {
    font-size: 24rpx;
    letter-spacing: 2rpx;
  }
  
  .empty-state {
    padding: 60rpx 30rpx;
  }
  
  .empty-desc {
    font-size: 24rpx;
    margin-top: 15rpx;
    letter-spacing: 2rpx;
  }
}