/* subpackages/booking/pet-select.wxss */
/* AROORO 轻奢宠物 - 宠物选择页（画廊展陈风格） */

/* ===== 入场动画 ===== */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(32rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* ===== 容器 ===== */
.gallery-container {
  min-height: 100vh;
  padding: 0 0 calc(200rpx + env(safe-area-inset-bottom));
}

/* ===== 头部画廊区 ===== */
.gallery-header {
  padding: 0;
  position: relative;
  overflow: hidden;
  background: var(--card-color);
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--hairline);
}

.brand-block {
  padding: 80rpx var(--page-padding) 64rpx;
  position: relative;
  animation-name: fadeInUp;
  animation-duration: 600ms;
  animation-timing-function: cubic-bezier(0.19,1,0.22,1);
  animation-fill-mode: forwards;
}

.brand-block::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, var(--primary-tint) 0%, transparent 70%);
  pointer-events: none;
}

.brand-accent-bar {
  position: absolute;
  top: 0;
  left: var(--page-padding);
  width: 48rpx;
  height: 6rpx;
  background: var(--gradient-primary);
  border-radius: 0 0 4rpx 4rpx;
}

.brand-main {
  position: relative;
  margin-bottom: 24rpx;
}

.brand-text {
  font-size: 60rpx;
  font-weight: 300;
  color: var(--text-primary);
  letter-spacing: 0.12em;
  display: block;
  line-height: 1;
  position: relative;
}

.brand-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.brand-meta-line {
  width: 40rpx;
  height: 2rpx;
  background: var(--divider-color);
  position: relative;
}

.brand-meta-line::after {
  content: '';
  position: absolute;
  top: 50%;
  right: -4rpx;
  transform: translateY(-50%);
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: var(--primary-color);
}

.brand-subtitle {
  font-size: 22rpx;
  color: var(--text-secondary);
  letter-spacing: 0.08em;
  font-weight: 400;
}

/* ===== 展区 ===== */
.gallery-hall {
  padding: var(--zy-space-lg);
}

.gallery-entrance {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: var(--zy-space-lg);
  padding: 0 8rpx;
}

.entrance-line {
  width: 32rpx;
  height: 4rpx;
  background: var(--gradient-primary);
  border-radius: 2rpx;
}

.entrance-label {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 500;
  letter-spacing: 0.08em;
}

.entrance-count {
  font-size: 22rpx;
  color: var(--text-secondary);
  letter-spacing: 0.04em;
  margin-left: auto;
  font-weight: 300;
}

/* ===== 宠物列表容器 ===== */
.gallery-collection {
  background: var(--card-color);
  border-radius: var(--zy-radius-lg);
  overflow: hidden;
  border: 1rpx solid var(--hairline);
  animation-name: fadeInUp;
  animation-duration: 600ms;
  animation-timing-function: cubic-bezier(0.19,1,0.22,1);
  animation-delay: 100ms;
  animation-fill-mode: forwards;
}

.gallery-card {
  position: relative;
  transition: transform var(--transition-fast), background-color var(--transition-fast);
}

.gallery-card.pressed {
  transform: scale(0.99);
}

.gallery-card.card-selected {
  background: linear-gradient(135deg, var(--primary-tint) 0%, var(--primary-wash) 100%);
}

.gallery-card.card-selected .card-frame {
  border-left: 4rpx solid var(--primary-color);
}

.card-selected-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: var(--gradient-primary);
  padding: 6rpx 16rpx 6rpx 12rpx;
  border-radius: var(--zy-radius-pill);
  box-shadow: var(--shadow-glow-primary-btn);
}

.badge-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--card-color);
}

.badge-text {
  font-size: 20rpx;
  color: var(--text-on-primary);
  font-weight: 400;
  letter-spacing: 0.06em;
}

/* ===== 卡片框架 ===== */
.card-frame {
  display: flex;
  align-items: center;
  padding: var(--zy-space-lg);
  border-left: 4rpx solid transparent;
}

.card-portrait {
  width: 112rpx;
  height: 112rpx;
  border-radius: 20rpx;
  overflow: hidden;
  flex-shrink: 0;
  border: 1rpx solid var(--hairline);
  position: relative;
}

.portrait-image {
  width: 100%;
  height: 100%;
  display: block;
}

.portrait-selected-ring {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  bottom: -4rpx;
  left: -4rpx;
  border-radius: 22rpx;
  border: 2rpx solid var(--primary-color);
  z-index: 1;
  opacity: 0.8;
}

.card-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 0 24rpx;
  min-width: 0;
}

.card-name {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.04em;
  line-height: 1.2;
}

.card-caption {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.caption-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 0.02em;
  font-weight: 400;
}

.caption-sep {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

/* ===== 选择指示器 ===== */
.card-select {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
}

.select-indicator {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform var(--transition-fast), opacity var(--transition-fast);
}

.indicator-idle {
  border: 2rpx solid var(--border-color);
  background: var(--card-color);
}

.indicator-active {
  background: var(--gradient-primary);
  border: none;
  box-shadow: var(--shadow-glow-primary-btn);
}

.indicator-checkmark {
  width: 16rpx;
  height: 10rpx;
  border-left: 3rpx solid var(--card-color);
  border-bottom: 3rpx solid var(--card-color);
  transform: rotate(-45deg);
  margin-top: -4rpx;
}

/* ===== 分割线 ===== */
.card-divider {
  height: 1rpx;
  background: var(--divider-color);
  margin-left: 168rpx;
  margin-right: var(--zy-space-lg);
}

/* ===== 添加宠物按钮 ===== */
.gallery-add {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 36rpx var(--zy-space-lg);
  margin-top: 24rpx;
  background: var(--card-color);
  border-radius: var(--zy-radius-lg);
  border: 1rpx dashed var(--border-color);
  transition: transform var(--transition-fast), background-color var(--transition-fast);
}

.gallery-add.pressed {
  transform: scale(0.99);
  background: var(--card-cream);
}

.add-line {
  width: 32rpx;
  height: 2rpx;
  background: var(--primary-color);
  position: relative;
}

.add-line::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 2rpx;
  height: 32rpx;
  background: var(--primary-color);
}

.add-label {
  font-size: 26rpx;
  color: var(--primary-color);
  font-weight: 400;
  letter-spacing: 0.08em;
}

/* ===== 空状态 ===== */
.empty-exhibition {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx var(--page-padding);
}

.empty-frame {
  position: relative;
  width: 400rpx;
  height: 320rpx;
  margin-bottom: 48rpx;
}

.frame-corner {
  position: absolute;
  width: 40rpx;
  height: 40rpx;
  border-color: var(--border-color);
  border-style: solid;
  border-width: 0;
}

.frame-tl {
  top: 0;
  left: 0;
  border-top-width: 2rpx;
  border-left-width: 2rpx;
}

.frame-tr {
  top: 0;
  right: 0;
  border-top-width: 2rpx;
  border-right-width: 2rpx;
}

.frame-bl {
  bottom: 0;
  left: 0;
  border-bottom-width: 2rpx;
  border-left-width: 2rpx;
}

.frame-br {
  bottom: 0;
  right: 0;
  border-bottom-width: 2rpx;
  border-right-width: 2rpx;
}

.frame-inner {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 300;
  color: var(--text-primary);
  letter-spacing: 0.08em;
}

.empty-subtitle {
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 0.04em;
  font-weight: 400;
}

/* ===== 底部操作栏（固定） ===== */
.gallery-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx var(--page-padding);
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: var(--card-color);
  border-top: 1rpx solid var(--hairline);
  z-index: 1000;
}

.footer-status {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
  padding-left: 4rpx;
}

.footer-bottom {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.bar-action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  position: relative;
}

.contact-wrap {
  position: relative;
  transition: opacity var(--dur-fast) var(--ease-refined);
}

.contact-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  background: transparent;
  border: none;
  margin: 0;
  padding: 0;
  line-height: normal;
}

.contact-overlay::after {
  border: none;
}

.contact-wrap--pressed {
  opacity: 0.6;
}

.bar-action-icon-img {
  width: 40rpx;
  height: 40rpx;
}

.bar-action-text {
  font-size: 18rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.02em;
  font-weight: 400;
}

.status-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
}

.dot-idle {
  background: var(--border-color);
}

.dot-active {
  background: var(--primary-color);
}

.status-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 0.04em;
  font-weight: 400;
}

.footer-action {
  flex: 1;
  min-width: 0;
  border-radius: var(--zy-radius-pill);
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 0.08em;
  padding: 26rpx 0;
  text-align: center;
  border: none;
  transition: transform var(--transition-fast), opacity var(--transition-fast);
}

.footer-action.pressed {
  transform: scale(0.98);
  opacity: 0.9;
}

.action-active {
  background: var(--gradient-primary);
  color: var(--text-on-primary);
  box-shadow: var(--shadow-glow-primary-btn);
}

.action-disabled {
  background: var(--divider-color);
  color: var(--text-tertiary);
}

/* ===== 加载状态 ===== */
.loading-spinner {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.spinner-ring {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid var(--divider-color);
  border-top-color: var(--primary-color);
  border-radius: 50%;
  animation-name: spin;
  animation-duration: 800ms;
  animation-timing-function: linear;
  animation-fill-mode: forwards;
  animation-iteration-count: infinite;
}

/* ===== 服务日期标识 ===== */
.card-service-date {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 4rpx;
}

.service-date-line {
  width: 24rpx;
  height: 2rpx;
  background: var(--primary-color);
  border-radius: 1rpx;
}

.service-date-text {
  font-size: 22rpx;
  color: var(--primary-color);
  letter-spacing: 0.02em;
  font-weight: 400;
}

/* ===== 底部弹窗（服务选择） ===== */
.bottom-popup {
  padding: 0;
  display: flex;
  flex-direction: column;
  height: 85vh;
  max-height: 85vh;
  box-sizing: border-box;
}

.popup-handle-bar {
  width: 64rpx;
  height: 8rpx;
  background: var(--border-color);
  border-radius: 4rpx;
  margin: 16rpx auto 0;
}

.popup-header {
  padding: 28rpx 40rpx 24rpx;
  position: relative;
}

.popup-header-accent {
  position: absolute;
  top: 0;
  left: 0;
  width: 80rpx;
  height: 4rpx;
  background: var(--gradient-primary);
  border-radius: 0 0 2rpx 2rpx;
}

.popup-header-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.popup-title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.04em;
}

.popup-cancel-btn {
  padding: 12rpx 24rpx;
  border-radius: var(--zy-radius-pill);
  transition: transform var(--transition-fast);
}

.popup-cancel-btn.pressed {
  transform: scale(0.96);
}

.popup-cancel-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 0.04em;
  font-weight: 400;
}

.popup-services {
  padding: 0 40rpx 8rpx;
}

.service-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  gap: 16rpx;
}

.service-row + .service-row {
  border-top: 1rpx solid var(--hairline);
}

.service-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: transform var(--transition-fast), opacity var(--transition-fast);
}

.check-on {
  background: var(--gradient-primary);
  box-shadow: var(--shadow-glow-primary-btn);
}

.check-off {
  border: 2rpx solid var(--border-color);
  background: var(--card-color);
}

.check-icon {
  width: 14rpx;
  height: 9rpx;
  border-left: 3rpx solid var(--card-color);
  border-bottom: 3rpx solid var(--card-color);
  transform: rotate(-45deg);
  margin-top: -3rpx;
}

.service-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.service-name {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
  letter-spacing: 0.02em;
}

.service-desc {
  font-size: 22rpx;
  color: var(--text-secondary);
  letter-spacing: 0.02em;
  font-weight: 400;
}

.service-stepper {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

.stepper-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 400;
  border: 1rpx solid var(--hairline);
  transition: transform var(--transition-fast), opacity var(--transition-fast);
}

.stepper-btn.pressed {
  transform: scale(0.92);
  opacity: 0.8;
}

.stepper-disabled {
  opacity: 0.3;
}

.stepper-value {
  font-size: 24rpx;
  color: var(--text-primary);
  font-weight: 500;
  letter-spacing: 0.02em;
  min-width: 60rpx;
  text-align: center;
}

.popup-section {
  padding: 0 40rpx;
  margin-bottom: 24rpx;
}

.popup-section-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.section-label-line {
  width: 28rpx;
  height: 2rpx;
  background: var(--primary-color);
  border-radius: 1rpx;
}

.section-label-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 0.08em;
  font-weight: 400;
}

.section-label-hint {
  font-size: 22rpx;
  color: var(--primary-color);
  letter-spacing: 0.02em;
  margin-left: auto;
  font-weight: 400;
}

.popup-calendar-area {
  flex: 1;
  min-height: 0;
  width: 100%;
}

.popup-confirm-area {
  padding: 16rpx 40rpx 40rpx;
  flex-shrink: 0;
  background: var(--card-color);
}

.popup-confirm-btn {
  padding: 28rpx 0;
  border-radius: var(--zy-radius-pill);
  text-align: center;
  border: none;
  transition: transform var(--transition-fast), opacity var(--transition-fast);
}

.popup-confirm-btn.pressed {
  transform: scale(0.98);
  opacity: 0.9;
}

.btn-enabled {
  background: var(--gradient-primary);
  box-shadow: var(--shadow-glow-primary-btn);
}

.btn-disabled {
  background: var(--divider-color);
}

.confirm-btn-text {
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 0.08em;
}

.btn-enabled .confirm-btn-text {
  color: var(--text-on-primary);
}

.btn-disabled .confirm-btn-text {
  color: var(--text-tertiary);
}
