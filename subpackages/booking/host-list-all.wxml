<view class="hosts-container">
  <!-- 顶部品牌标识栏 -->
  <view class="home-header {{isHeaderScrolled ? 'scrolled' : ''}}">
    <view class="header-gradient-bg"></view>
    <view class="header-content">
      <view class="brand-section">
        <view class="brand-main">
          <view class="brand-text">
            <text class="brand-title">AROORO</text>
            <text class="brand-slogan">安心呼噜，放心托付</text>
          </view>
        </view>
      </view>

    </view>
  </view>

  <!-- 搜索栏 -->
  <view class="search-header">
    <view class="search-bar">
      <view class="search-icon">🔍</view>
      <input class="search-input" placeholder="搜索寄养家庭、位置、服务..." value="{{searchKeyword}}" bindinput="handleSearchInput" bindconfirm="handleSearch" confirm-type="search" />
    </view>
  </view>

  <!-- 筛选栏 -->
  <view class="filter-bar">
    <view class="filter-section">
      <view class="filter-options">
        <view class="filter-option" bindtap="showFilterModal">
          <text>筛选</text>
          <text class="filter-arrow">▾</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 寄养家庭列表 -->
  <view class="hosts-list">
    <view class="host-card" wx:for="{{hosts}}" wx:key="id" data-id="{{item.id}}" bindtap="selectHost">
      <!-- 封面图片轮播 -->
      <view class="host-cover-container">
        <swiper class="host-swiper" autoplay interval="3000" circular indicator-dots indicator-color="rgba(255,255,255,0.5)" indicator-active-color="#ffffff">
          <swiper-item wx:for="{{item.photos || [item.avatarUrl, item.avatarUrl, item.avatarUrl]}}" wx:for-item="photo" wx:for-index="photoIndex" wx:key="*this">
            <image lazy-load class="host-cover-image" src="{{photo}}" mode="aspectFill" binderror="onCloudImageError" data-src="{{photo}}" data-path="hosts[{{index}}].photos[{{photoIndex}}]"></image>
          </swiper-item>
        </swiper>
        <view class="host-badge" wx:if="{{item.isRecommended}}">
          <text class="host-badge-text">推荐</text>
        </view>
      </view>
      
      <!-- 寄养家庭信息 -->
      <view class="host-info">
        <view class="host-header">
          <image lazy-load class="host-avatar" src="{{item.avatarUrl}}" mode="aspectFill" binderror="onCloudImageError" data-src="{{item.avatarUrl}}" data-path="hosts[{{index}}].avatarUrl"></image>
          <text class="host-name">{{item.name}}</text>
        </view>
        
        <text class="host-description">{{item.description}}</text>
        
        <view class="host-tags">
          <text class="host-tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
        </view>
        
        <view class="host-features">
          <view class="feature-item">
            <text class="feature-icon">🏠</text>
            <text class="feature-text">{{item.roomType || '独立房间'}}</text>
          </view>
          <view class="feature-item">
            <text class="feature-icon">🐶</text>
            <text class="feature-text">{{item.petLimit || 3}}只宠物</text>
          </view>
          <view class="feature-item">
            <text class="feature-icon">📍</text>
            <text class="feature-text">{{item.distance || 2.5}}km</text>
          </view>
        </view>
        
        <view class="host-bottom">
          <view class="price-info">
            <text class="price">¥{{item.price}}</text>
            <text class="price-unit">/{{item.priceUnit || '天'}}</text>
          </view>
          <button class="book-btn" bindtap="bookHost" data-id="{{item.id}}">
            <text>立即预约</text>
          </button>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{isLoading}}" class="loading-more">
    <view class="loading-dots">
      <view class="loading-dot"></view>
      <view class="loading-dot"></view>
      <view class="loading-dot"></view>
    </view>
    <text class="loading-more-text">加载中</text>
  </view>
  <view class="no-more" wx:if="{{!hasMore && hosts.length > 0}}">
    <text class="no-more-text">— 没有更多了 —</text>
  </view>
  <view class="empty-state" wx:if="{{errorMsg}}">
    <text class="empty-icon">⚠️</text>
    <text class="empty-title">{{errorMsg}}</text>
    <text class="empty-subtitle">请检查网络后重试</text>
  </view>
  <view class="empty-state" wx:if="{{showEmptyState && !errorMsg}}">
    <text class="empty-icon">🏠</text>
    <text class="empty-title">暂无寄养家庭</text>
    <text class="empty-subtitle">请尝试调整搜索条件</text>
  </view>
</view>

<!-- 筛选弹窗 -->
<view class="modal-overlay {{showFilterModal ? 'visible' : ''}}" bindtap="closeFilterModal">
  <view class="modal-content {{showFilterModal ? 'visible' : ''}}" catchtap="">
    <view class="modal-header">
      <text class="modal-title">筛选条件</text>
      <view class="modal-close-btn" bindtap="closeFilterModal">
        <text class="modal-close">✕</text>
      </view>
    </view>
    
    <view class="filter-content">
      <view class="filter-group">
        <text class="filter-group-title">宠物类型</text>
        <view class="filter-checkboxes">
          <view class="checkbox-item {{filters.petTypes.dog ? 'checked' : ''}}" bindtap="toggleFilter('petTypes', 'dog')">
            <view class="checkbox"></view>
            <text>狗狗</text>
          </view>
          <view class="checkbox-item {{filters.petTypes.cat ? 'checked' : ''}}" bindtap="toggleFilter('petTypes', 'cat')">
            <view class="checkbox"></view>
            <text>猫咪</text>
          </view>
          <view class="checkbox-item {{filters.petTypes.other ? 'checked' : ''}}" bindtap="toggleFilter('petTypes', 'other')">
            <view class="checkbox"></view>
            <text>其他</text>
          </view>
        </view>
      </view>
      
      <view class="filter-group">
        <text class="filter-group-title">服务类型</text>
        <view class="filter-checkboxes">
          <view class="checkbox-item {{filters.services.board ? 'checked' : ''}}" bindtap="toggleFilter('services', 'board')">
            <view class="checkbox"></view>
            <text>寄养</text>
          </view>
          <view class="checkbox-item {{filters.services.walk ? 'checked' : ''}}" bindtap="toggleFilter('services', 'walk')">
            <view class="checkbox"></view>
            <text>遛狗</text>
          </view>
          <view class="checkbox-item {{filters.services.feed ? 'checked' : ''}}" bindtap="toggleFilter('services', 'feed')">
            <view class="checkbox"></view>
            <text>喂食</text>
          </view>
        </view>
      </view>
      
      <view class="filter-group">
        <text class="filter-group-title">价格范围</text>
        <view class="price-range">
          <input class="price-input" placeholder="最低" value="{{filters.price.min}}" bindinput="handlePriceInput" data-type="min" />
          <text class="price-separator">-</text>
          <input class="price-input" placeholder="最高" value="{{filters.price.max}}" bindinput="handlePriceInput" data-type="max" />
        </view>
      </view>
    </view>
    
    <view class="modal-footer">
      <button class="reset-btn" bindtap="resetFilters">重置</button>
      <button class="apply-btn" bindtap="applyFilters">应用</button>
    </view>
  </view>
</view>