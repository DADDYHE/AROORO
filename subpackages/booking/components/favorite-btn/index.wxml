<view class="favorite-btn {{ isActive ? 'active' : '' }}" bindtap="handleToggle">
  <view wx:if="{{ loading }}" class="loading-container">
    <view class="loading-dots-container">
      <view class="loading-dot"></view>
      <view class="loading-dot"></view>
      <view class="loading-dot"></view>
    </view>
  </view>
  <view wx:else>
    <text class="heart-icon" style="color: {{ iconColor }}">{{ isActive ? '♥' : '♡' }}</text>
    <text wx:if="{{ !isActive }}" class="plus-icon">+</text>
  </view>
</view>
