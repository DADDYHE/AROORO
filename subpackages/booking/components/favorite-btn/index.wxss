/* ================================================================
   favorite-btn · AROORO 收藏/爱心按钮
   极简圆形图标按钮：描边 ↔ 品牌红填充
   Skyline 合规：无 :active / backdrop-filter / !important / text-shadow
   按压态通过 --pressed class 实现 transform/opacity
   ================================================================ */

.favorite-btn {
  width: 80rpx;
  height: 80rpx;
  min-width: auto;
  min-height: auto;
  border-radius: 50%;
  background-color: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-tertiary);
  box-shadow: none;
  border: none;
  position: relative;
  z-index: 99;
  flex-shrink: 0;
  padding: 0;
  margin: 0;
  line-height: 1;
}

.favorite-btn::after {
  border: none;
}

.favorite-btn.pressed {
  transform: scale(0.88);
  opacity: 0.7;
}

.favorite-btn.active {
  background-color: transparent;
  color: var(--brand-red);
}

.favorite-btn .heart-icon {
  width: 56rpx;
  height: 56rpx;
  display: block;
}

.favorite-btn .heart-icon.active {
}

.unfavorited-icon {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
}

.plus-icon {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  background-color: var(--card-color);
  border-radius: 50%;
  width: 28rpx;
  height: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 400;
  font-size: 22rpx;
  color: var(--text-tertiary);
  border: 1rpx solid var(--hairline);
}

.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: auto;
}

.loading-dots {
  display: flex;
  gap: 8rpx;
  align-items: center;
}

.loading-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--text-tertiary);
}

.loading-dot:nth-child(2) {
}

.loading-dot:nth-child(3) {
}
