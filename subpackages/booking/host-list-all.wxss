/* 寄养家庭页面样式
   设计系统：AROORO Haute-Luxury v2
   token 来源：styles/variables.wxss → styles/design-tokens.wxss → styles/theme-teal.wxss（app.wxss 按序注入）
   P1-B 改造：清除旧 teal / 外来暖橙 / 通用灰阶硬编码，统一为语义 token */

/* 容器 */
.hosts-container {
  min-height: 100vh;
  background: linear-gradient(135deg, var(--background-color) 0%, var(--card-color) 100%);
  position: relative;
  overflow-x: hidden;
}

/* 顶部品牌标识栏 */
.home-header {
  position: relative;
  z-index: 999;
  padding: var(--zy-space-lg) var(--zy-space-lg);
  border-bottom: none;
  background-color: transparent;
  overflow: hidden;
}

.header-gradient-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, var(--activity-tint) 0%, var(--primary-tint) 100%);
  backdrop-filter: blur(10px);
  opacity: 0;
  z-index: -1;
}

.home-header.scrolled .header-gradient-bg {
  opacity: 1;
}

.home-header.scrolled {
  background-color: var(--zy-surface-glass);
  box-shadow: var(--shadow-lg);
  position: sticky;
  top: 0;
  border-bottom: 1rpx solid var(--lux-hairline-green);
}

.header-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  max-width: var(--container-max-width);
  margin: 0 auto;
  position: relative;
  z-index: 1;
}

.brand-section {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.brand-main {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  background: transparent;
  backdrop-filter: blur(8px);
}

.home-header.scrolled .brand-main {
  background: var(--zy-surface-glass);
  box-shadow: var(--shadow-md);
}

.brand-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

/* 品牌标题：Skyline 不支持 background-clip:text，按 app.wxss .text-gradient 约定用纯色兜底 */
.brand-title {
  font-family: 'PingFang SC', 'Helvetica Neue', Arial, sans-serif;
  font-size: 32px;
  font-weight: 700;
  color: var(--primary-color);
  letter-spacing: 1px;
}

.home-header.scrolled .brand-title {
  font-size: 28px;
}

/* 未滚动态与滚动态统一为「奶油底 + 暖炭文字」，取消原白字/黑底芯片的体系分裂 */
.brand-slogan {
  font-size: 12px;
  color: var(--text-tertiary);
  letter-spacing: 2px;
  font-weight: 500;
  background: var(--surface-tint);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  backdrop-filter: blur(4px);
}

.home-header.scrolled .brand-slogan {
  color: var(--gray-700);
  background: var(--activity-tint);
}

/* 头部操作区域已移除搜索按钮 */

/* 搜索栏 */
.search-header {
  margin-top: 20rpx;
  padding: 0 24rpx 20rpx;
  position: sticky;
  top: 0;
  z-index: 100;
  background: linear-gradient(135deg, var(--background-color) 0%, var(--card-color) 100%);
  backdrop-filter: blur(5px);
  -webkit-backdrop-filter: blur(5px);
  border-bottom: 1rpx solid var(--hairline);
}

.search-bar {
  display: flex;
  align-items: center;
  background: var(--card-color);
  border-radius: 24rpx;
  padding: 16rpx 20rpx;
  box-shadow: var(--shadow-md);
  border: 1rpx solid var(--hairline);
}

.search-bar .search-icon {
  font-size: 20rpx;
  color: var(--text-tertiary);
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 24rpx;
  color: var(--text-primary);
  background: transparent;
  border: none;
  padding: 0;
}

.search-input::placeholder {
  color: var(--text-tertiary);
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  padding: 16rpx 24rpx;
  background: var(--card-color);
  border-bottom: 1rpx solid var(--hairline);
  position: sticky;
  top: 180rpx;
  z-index: 90;
  backdrop-filter: blur(5px);
  -webkit-backdrop-filter: blur(5px);
}

.filter-section {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.filter-label {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--text-primary);
  white-space: nowrap;
}

.filter-options {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.filter-option {
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  background: var(--surface-tint);
  border: 1rpx solid var(--hairline);
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.filter-option text {
  font-size: 20rpx;
  color: var(--gray-700);
}

.filter-option.active {
  background: var(--activity-tint);
  border-color: var(--activity-primary);
}

.filter-option.active text {
  color: var(--activity-primary);
  font-weight: 500;
}

.filter-arrow {
  font-size: 16rpx;
  color: var(--text-tertiary);
}

/* 寄养家庭列表 */
.hosts-list {
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.host-card {
  background: var(--card-color);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: var(--lux-shadow-card);
  border: 1rpx solid var(--hairline);
  position: relative;
  backdrop-filter: blur(5px);
  -webkit-backdrop-filter: blur(5px);
}

.host-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, var(--activity-primary), var(--activity-primary-mid));
  opacity: 0;
}

.host-cover-container {
  position: relative;
  height: 240rpx;
  overflow: hidden;
  background: linear-gradient(135deg, var(--gray-100) 0%, var(--gray-200) 100%);
}

.host-swiper {
  width: 100%;
  height: 100%;
}

.host-cover-image {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, var(--activity-primary) 0%, var(--activity-primary-mid) 100%);
}

/* 轮播指示器样式 */
.host-swiper .wx-swiper-dots {
  bottom: 16rpx;
}

.host-swiper .wx-swiper-dot {
  width: 8rpx;
  height: 8rpx;
  margin: 0 4rpx;
}

.host-swiper .wx-swiper-dot-active {
  width: 24rpx;
  border-radius: 4rpx;
}

.host-badge {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  background: linear-gradient(135deg, var(--activity-primary), var(--activity-primary-mid));
  color: var(--text-on-primary);
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
  box-shadow: var(--shadow-glow-primary-soft);
  backdrop-filter: blur(5px);
  -webkit-backdrop-filter: blur(5px);
}

.host-badge-text {
  font-size: 16rpx;
  font-weight: 600;
}

.host-info {
  padding: 20rpx 24rpx;
}

.host-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.host-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 2rpx solid var(--primary-tint);
  box-shadow: var(--shadow-md);
  background: linear-gradient(135deg, var(--gray-100) 0%, var(--gray-200) 100%);
}

.host-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  flex: 1;
}

/* 评分样式已移除 */

.host-description {
  font-size: 20rpx;
  color: var(--gray-700);
  line-height: 1.4;
  margin-bottom: 16rpx;
  display: block;
  overflow: hidden;
}

.host-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.host-tag {
  font-size: 16rpx;
  color: var(--activity-primary);
  background: var(--activity-tint);
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--lux-hairline-green);
}

.host-features {
  display: flex;
  gap: 24rpx;
  margin-bottom: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--hairline);
}

.feature-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.feature-icon {
  font-size: 20rpx;
}

.feature-text {
  font-size: 18rpx;
  color: var(--gray-700);
}

.host-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--hairline);
}

.price-info {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

/* 价格：移除无 background-clip 的渐变底（Skyline 会渲染成色块），用深森林绿纯色 */
.price {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--activity-primary);
}

.price-unit {
  font-size: 20rpx;
  color: var(--text-tertiary);
}

.book-btn {
  padding: 12rpx 24rpx;
  background: linear-gradient(135deg, var(--activity-primary), var(--activity-primary-mid));
  color: var(--text-on-primary);
  border: none;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 600;
  box-shadow: var(--shadow-glow-primary-btn);
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 140rpx;
}

/* 加载状态 */
.loading-more {
  text-align: center;
  padding: 32rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.loading-dots {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.loading-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--activity-primary);
}

.loading-dot:nth-child(2) {
}

.loading-dot:nth-child(3) {
}

.loading-more-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 4rpx;
}

.no-more {
  padding: 40rpx 0;
  display: flex;
  justify-content: center;
  align-items: center;
}

.no-more-text {
  font-size: 18rpx;
  color: var(--text-tertiary);
}

.empty-state {
  padding: 120rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.empty-subtitle {
  font-size: 20rpx;
  color: var(--text-tertiary);
  text-align: center;
}

/* 筛选弹窗 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--overlay-color);
  z-index: 2000;
  opacity: 0;
  visibility: hidden;
  backdrop-filter: blur(5px);
  -webkit-backdrop-filter: blur(5px);
}

.modal-overlay.visible {
  opacity: 1;
  visibility: visible;
}

.modal-content {
  position: fixed;
  bottom: -100%;
  left: 0;
  right: 0;
  background: var(--card-color);
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: var(--shadow-top-lg);
  max-height: 80vh;
  overflow-y: auto;
  z-index: 2001;
}

.modal-content.visible {
  bottom: 0;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid var(--hairline);
  position: sticky;
  top: 0;
  background: var(--card-color);
  z-index: 10;
}

.modal-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.modal-close-btn {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--surface-tint);
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-close {
  font-size: 24rpx;
  color: var(--gray-700);
}

.filter-content {
  padding: 24rpx;
}

.filter-group {
  margin-bottom: 32rpx;
}

.filter-group-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.filter-checkboxes {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.checkbox-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  border-radius: 16rpx;
  background: var(--surface-tint);
  border: 1rpx solid var(--hairline);
}

.checkbox-item.checked {
  background: var(--activity-tint);
  border-color: var(--activity-primary);
}

.checkbox {
  width: 20rpx;
  height: 20rpx;
  border-radius: 4rpx;
  border: 2rpx solid var(--border-color);
  position: relative;
}

.checkbox-item.checked .checkbox {
  background: var(--activity-primary);
  border-color: var(--activity-primary);
}

.checkbox-item.checked .checkbox::after {
  content: '✓';
  position: absolute;
  top: -2rpx;
  left: 2rpx;
  font-size: 16rpx;
  color: var(--text-on-primary);
  font-weight: 600;
}

.checkbox-item text {
  font-size: 20rpx;
  color: var(--gray-700);
}

.checkbox-item.checked text {
  color: var(--activity-primary);
  font-weight: 500;
}

.price-range {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.price-input {
  flex: 1;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--border-color);
  font-size: 20rpx;
  color: var(--text-primary);
  text-align: center;
}

.price-input::placeholder {
  color: var(--text-tertiary);
}

.price-separator {
  font-size: 20rpx;
  color: var(--text-tertiary);
}

.modal-footer {
  display: flex;
  gap: 16rpx;
  padding: 24rpx;
  border-top: 1rpx solid var(--hairline);
  position: sticky;
  bottom: 0;
  background: var(--card-color);
  z-index: 10;
}

.reset-btn {
  flex: 1;
  padding: 16rpx;
  background: transparent;
  color: var(--gray-700);
  border: 1rpx solid var(--border-color);
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.apply-btn {
  flex: 1;
  padding: 16rpx;
  background: linear-gradient(135deg, var(--activity-primary), var(--activity-primary-mid));
  color: var(--text-on-primary);
  border: none;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 600;
  box-shadow: var(--shadow-glow-primary-btn);
}

/* 响应式设计 */
@media (max-width: 375px) {
  .brand-title {
    font-size: 28rpx;
  }
  
  .host-card {
    margin-bottom: 20rpx;
  }
  
  .host-features {
    flex-direction: column;
    gap: 8rpx;
    align-items: flex-start;
  }
  
  .feature-item {
    font-size: 16rpx;
  }
}
