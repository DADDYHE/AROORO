<zy-navbar title="" transparent color="#F7F5EF" solid="{{_navbarSolid}}" />
<login-prompt visible="{{showLoginPrompt}}" bind:close="onLoginPromptClose" />
  <view class="fill-root">
    <scroll-view
  bindscroll="_onScroll"
      scroll-y
      enhanced
      style="height: 100vh;"
    >
      <!-- B · 深绿沉浸信函板（顶天，家庭头像作火漆印） -->
      <view wx:if="{{ !isLoading && !loadError && invitation }}" class="fill-hero" style="padding-top: calc({{_navbarHeight}}px + 24rpx);">
        <view class="fill-hero-text">
          <text class="fill-hero-eyebrow">INVITATION</text>
          <text class="fill-hero-title">寄养邀请</text>
          <text class="fill-hero-sub">{{ invitation.hostSnapshot.hostName || '寄养家庭' }} 邀您入住</text>
        </view>
        <view class="fill-hero-seal">
          <image class="fill-hero-seal-img" src="{{ invitation.hostSnapshot.avatarUrl || '/images/default-avatar.svg' }}" mode="aspectFill" />
        </view>
        <view class="fill-hero-sealline"></view>
      </view>

      <view class="fill-container">
        <!-- 加载中 -->
        <view wx:if="{{ isLoading }}" class="fill-loading">
          <text class="fill-loading-text">正在加载邀请…</text>
        </view>

        <!-- 加载失败 / 邀请失效 -->
        <view wx:elif="{{ loadError }}" class="fill-state-card">
          <text class="fill-state-title">{{ loadError }}</text>
          <text class="fill-state-desc">请联系寄养家庭重新分享，或返回首页看看其他寄养家庭</text>
          <button class="fill-btn fill-btn--primary" bindtap="goHome">返回首页</button>
        </view>

        <!-- 邀请已结束（filled / cancelled） -->
        <block wx:elif="{{ invitation.status !== 'active' }}">
          <view class="fill-inv-rows">
            <view class="fill-inv-row"><text class="fill-inv-key">寄养日期</text><text class="fill-inv-val">{{ invitation.startDate }} 至 {{ invitation.endDate }}</text></view>
            <view class="fill-inv-row"><text class="fill-inv-key">订单总价</text><text class="fill-inv-val fill-inv-val--price">¥{{ invitation.totalPrice }}</text></view>
          </view>
          <view class="fill-state-card">
            <text class="fill-state-title">{{ invitation.status === 'filled' ? '该邀请已被填写' : '该邀请已被取消' }}</text>
            <text class="fill-state-desc" wx:if="{{ invitation.status === 'filled' && invitation.orderId }}">宠物信息已提交，可查看关联订单</text>
            <text class="fill-state-desc" wx:elif="{{ invitation.status === 'filled' && !invitation.orderId }}">订单状态正在同步，请稍后在订单列表查看</text>
            <text class="fill-state-desc" wx:else>请联系寄养家庭重新开单</text>
            <button wx:if="{{ invitation.status === 'filled' && invitation.orderId }}" class="fill-btn fill-btn--primary" bindtap="goOrder">查看订单</button>
            <button wx:elif="{{ invitation.status === 'filled' && !invitation.orderId }}" class="fill-btn fill-btn--primary" bindtap="goMyOrders">查看我的订单</button>
            <button class="fill-btn fill-btn--ghost" bindtap="goHome">返回首页</button>
          </view>
        </block>

        <!-- 正常填写流程 -->
        <block wx:else>
          <!-- 01 行程与寄养安排 -->
          <view class="fill-section">
            <view class="fill-chapter">
              <text class="fill-chapter-no">01</text>
              <text class="fill-chapter-eyebrow">THE STAY</text>
              <view class="fill-chapter-rule"></view>
            </view>
            <text class="fill-section-title">行程安排</text>

            <!-- 票据双联：入住 / 退房 -->
            <view class="fill-stay">
              <view class="fill-stay-cols">
                <view class="fill-stay-col">
                  <text class="fill-stay-cap">入住 CHECK-IN</text>
                  <text class="fill-stay-date">{{ invitation.startDate }}</text>
                  <text class="fill-stay-time">{{ invitation.startAt }}</text>
                </view>
                <view class="fill-stay-vrule"></view>
                <view class="fill-stay-col">
                  <text class="fill-stay-cap">退房 CHECK-OUT</text>
                  <text class="fill-stay-date">{{ invitation.endDate }}</text>
                  <text class="fill-stay-time">{{ invitation.endAt }}</text>
                </view>
              </view>
              <view class="fill-stay-meta">
                <view class="fill-stay-meta-item">
                  <text class="fill-stay-cap">寄养时长</text>
                  <text class="fill-stay-meta-val">{{ days }} 晚</text>
                </view>
                <view class="fill-stay-vrule fill-stay-vrule--short"></view>
                <view class="fill-stay-meta-item">
                  <text class="fill-stay-cap">宾客</text>
                  <text class="fill-stay-meta-val">{{ invitation.petCount }} 位</text>
                </view>
              </view>
              <!-- 第三联：地点 LOCATION（收编进票据，与入住/退房同构）
                   家庭名常驻 —— 即使未公开地址，滚到 02/03 仍知是谁家 -->
              <view class="fill-stay-loc">
                <text class="fill-stay-cap">地点 LOCATION</text>
                <text class="fill-stay-loc-host">{{ invitation.hostSnapshot.hostName || '寄养家庭' }}</text>
                <text wx:if="{{ invitation.hostSnapshot.addressPublic }}" class="fill-stay-loc-addr">{{ invitation.hostSnapshot.addressPublic }}</text>
              </view>
            </view>
            <view wx:if="{{ invitation.note }}" class="fill-quote">
              <text class="fill-quote-text">{{ invitation.note }}</text>
            </view>

            <!-- 过期横幅 -->
            <view wx:if="{{ invitation.expired }}" class="fill-inv-expired">
              <text class="fill-inv-expired-text">此邀请已过期，请联系寄养家庭重新开单</text>
            </view>
          </view>

          <!-- 02 宠物信息 -->
          <view class="fill-section">
            <view class="fill-chapter">
              <text class="fill-chapter-no">02</text>
              <text class="fill-chapter-eyebrow">GUESTS</text>
              <view class="fill-chapter-rule"></view>
            </view>
            <text class="fill-section-title">宠物信息（{{ invitation.petCount }} 只）</text>
            <text class="fill-section-sub">请为每只宠物确认基础信息与健康情况</text>

            <view wx:for="{{ slots }}" wx:key="key" class="fill-slot">
              <view class="fill-slot-head">
                <text class="fill-slot-no">席位 {{ index + 1 }}</text>
                <view class="fill-slot-reset" wx:if="{{ item.mode !== 'empty' }}" bindtap="onSlotReset" data-index="{{ index }}">
                  <text class="fill-slot-reset-text">清除</text>
                </view>
              </view>

              <!-- 空席位：金虚线席位卡 -->
              <view wx:if="{{ item.mode === 'empty' }}" class="fill-seat">
                <text class="fill-seat-cap">待确认</text>
                <view class="fill-seat-actions">
                  <view class="fill-chip" bindtap="onPickExisting" data-index="{{ index }}" hover-class="fill-chip--pressed" hover-stay-time="80">
                    <text class="fill-chip-text">选择已有宠物</text>
                  </view>
                  <view class="fill-chip fill-chip--strong" bindtap="onCreateNew" data-index="{{ index }}" hover-class="fill-chip--pressed" hover-stay-time="80">
                    <text class="fill-chip-text fill-chip-text--strong">新建宠物档案</text>
                  </view>
                </view>
              </view>

              <!-- 已选已有宠物 -->
              <view wx:elif="{{ item.mode === 'existing' }}" class="fill-guest">
                <image class="fill-guest-avatar" src="{{ item.pet.avatarUrl || '/images/default-avatar.svg' }}" mode="aspectFill" />
                <view class="fill-guest-info">
                  <text class="fill-guest-name">{{ item.pet.name }}</text>
                  <text class="fill-guest-meta">{{ item.pet.breed || '' }}{{ item.pet.birthday ? ' · ' + item.pet.birthday : '' }}</text>
                </view>
                <text class="fill-guest-swap" hover-class="fill-guest-swap--pressed" hover-stay-time="80" bindtap="onSlotReset" data-index="{{ index }}">更换</text>
              </view>

              <!-- 新建宠物：就地画廊式建档表单（贴近 create-step1 视觉） -->
              <view wx:elif="{{ item.mode === 'new' }}" class="fill-newpet">
                <view class="gallery-portrait" bindtap="onSlotAvatar" data-index="{{ index }}" hover-class="fill-ava--pressed" hover-stay-time="80">
                  <view class="portrait-frame">
                    <image wx:if="{{ item.newPet.avatarUrl }}" class="portrait-image" src="{{ item.newPet.avatarUrl }}" mode="aspectFill" />
                    <view wx:else class="portrait-canvas">
                      <view class="canvas-crosshair-h"></view>
                      <view class="canvas-crosshair-v"></view>
                      <view class="canvas-corner canvas-tl"></view>
                      <view class="canvas-corner canvas-tr"></view>
                      <view class="canvas-corner canvas-bl"></view>
                      <view class="canvas-corner canvas-br"></view>
                    </view>
                  </view>
                  <view class="portrait-label">
                    <view class="label-line"></view>
                    <text class="label-text">{{ item.newPet.avatarUrl ? '点击更换头像' : '点击上传宠物头像' }}</text>
                  </view>
                </view>

                <view class="gallery-entrance">
                  <view class="entrance-line"></view>
                  <text class="entrance-label">基本信息</text>
                </view>

                <view class="gallery-collection">
                  <view class="gallery-card">
                    <view class="card-accent"></view>
                    <view class="card-body">
                      <view class="form-group">
                        <view class="form-row">
                          <view class="field-label"><text>宠物昵称</text><text class="label-required">（必填）</text></view>
                          <input class="form-input" value="{{ item.newPet.name }}" maxlength="30" placeholder="请输入宠物昵称" placeholder-class="form-placeholder" bindinput="onNewPetInput" data-index="{{ index }}" data-field="name" />
                        </view>
                        <view class="field-divider"></view>
                        <view class="form-row form-row--select" bindtap="selectSlotType" data-index="{{ index }}">
                          <view class="field-label"><text>宠物类型</text><text class="label-required">（必填）</text></view>
                          <view class="form-value {{ item.newPet.type ? '' : 'form-value--ph' }}"><text class="form-value-text">{{ item.newPet.type === 'dog' ? '狗狗' : (item.newPet.type === 'cat' ? '猫咪' : (item.newPet.type === 'exotic' ? '异宠' : '请选择宠物类型')) }}</text></view>
                          <view class="field-arrow"><view class="arrow-line"></view></view>
                        </view>
                        <view class="field-divider"></view>
                        <view class="form-row">
                          <view class="field-label"><text>品种</text><text class="label-required">（必填）</text></view>
                          <input class="form-input" value="{{ item.newPet.breed }}" maxlength="50" placeholder="请输入品种" placeholder-class="form-placeholder" bindinput="onNewPetInput" data-index="{{ index }}" data-field="breed" />
                        </view>
                        <view class="field-divider"></view>
                        <view class="form-row form-row--select" bindtap="selectSlotGender" data-index="{{ index }}">
                          <view class="field-label"><text>性别</text><text class="label-required">（必填）</text></view>
                          <view class="form-value {{ item.newPet.gender ? '' : 'form-value--ph' }}"><text class="form-value-text">{{ item.newPet.gender === 'male' ? '弟弟' : (item.newPet.gender === 'female' ? '妹妹' : (item.newPet.gender === 'unknown' ? '不确定' : '请选择性别')) }}</text></view>
                          <view class="field-arrow"><view class="arrow-line"></view></view>
                        </view>
                        <view class="field-divider"></view>
                        <picker mode="date" value="{{ item.newPet.birthday }}" start="2000-01-01" end="{{ todayStr }}" bindchange="onNewPetBirthday" data-index="{{ index }}">
                          <view class="form-row form-row--select">
                            <view class="field-label"><text>出生日期</text></view>
                            <view class="form-value"><text class="form-value-text {{ item.newPet.birthday ? '' : 'form-value--ph' }}">{{ item.newPet.birthday || '请选择出生日期' }}</text></view>
                            <view class="field-arrow"><view class="arrow-line"></view></view>
                          </view>
                        </picker>
                        <view class="field-divider"></view>
                        <view class="form-row">
                          <view class="field-label"><text>体重</text></view>
                          <input class="form-input" type="digit" value="{{ item.newPet.weight }}" placeholder="请输入体重（kg）" placeholder-class="form-placeholder" bindinput="onNewPetInput" data-index="{{ index }}" data-field="weight" />
                        </view>
                        <view class="field-divider"></view>
                        <view class="form-row form-row--textarea">
                          <view class="field-label"><text>备注</text></view>
                          <textarea class="form-textarea" value="{{ item.newPet.note }}" placeholder="性格傲娇还是可爱？还有生活习惯和饮食习惯描述一下吧" placeholder-class="form-placeholder" auto-height maxlength="-1" bindinput="onNewPetNote" data-index="{{ index }}" />
                        </view>
                      </view>
                    </view>
                  </view>
                </view>
              </view>

              <!-- 健康信息（所有模式，除空槽位）
                   ⚠ health-form 是 styleIsolation:isolated，页面 wxss 穿透不进去；
                   故用 CSS 变量继承（.fill-health 重定义 --card-color / --lux-radius-inner）
                   把它从白卡改成纸面分区，不动组件源文件（update-profile 共用） -->
              <view wx:if="{{ item.mode !== 'empty' }}" class="fill-health">
                <health-form
                  value="{{ item.healthInfo }}"
                  bindchange="onHealthChange"
                  data-index="{{ index }}"
                />
              </view>

              <!-- 新建宠物：保存建档 → 档案直接显示在本槽位，并进入"选择已有宠物"列表 -->
              <button wx:if="{{ item.mode === 'new' }}" class="fill-newpet-submit {{ submitting ? 'is-disabled' : '' }}" disabled="{{ submitting }}" bindtap="onSaveNewPet" data-index="{{ index }}">
                {{ submitting ? '保存中…' : '保存宠物档案' }}
              </button>
            </view>

          </view>

          <!-- 03 费用与提交 -->
          <view class="fill-section">
            <view class="fill-chapter">
              <text class="fill-chapter-no">03</text>
              <text class="fill-chapter-eyebrow">STATEMENT</text>
              <view class="fill-chapter-rule"></view>
            </view>
            <text class="fill-section-title">费用确认</text>

            <view class="fill-price-card">
              <view class="fill-price-row">
                <text class="fill-price-key">订单总价</text>
                <text class="fill-price-val">¥{{ invitation.totalPrice }}</text>
              </view>
              <text class="fill-price-hint">提交后可选择支付定金（30%）或全款；支付成功后寄养家庭将自动确认订单</text>
            </view>

            <button class="fill-submit-btn {{ submitting || invitation.expired ? 'is-disabled' : '' }}" disabled="{{ submitting || invitation.expired }}" bindtap="onSubmit">
              {{ submitting ? '提交中…' : (invitation.expired ? '邀请已过期' : '提交并支付') }}
            </button>
            <text class="fill-submit-hint">30 分钟内未支付订单将自动取消</text>
          </view>
        </block>
      </view>
    </scroll-view>

    <!-- 未登录遮罩 -->
    <view wx:if="{{ !isLoading && !loadError && invitation.status === 'active' && !invitation.expired && !isLoggedIn }}" class="fill-login-mask">
      <view class="fill-login-card">
        <text class="fill-login-title">登录后填写宠物信息</text>
        <text class="fill-login-desc">登录后可复用已有宠物档案，健康信息也会保存到档案中方便下次使用</text>
        <button class="fill-btn fill-btn--primary" bindtap="onLoginTap">微信一键登录</button>
      </view>
    </view>

    <!-- 选择已有宠物弹层 -->
    <view wx:if="{{ petPickerVisible }}" class="fill-picker-mask" bindtap="onPetPickerClose">
      <view class="fill-picker-panel" catchtap="stopBubble">
        <text class="fill-picker-title">选择宠物</text>
        <view wx:if="{{ myPetsLoading }}" class="fill-picker-loading">
          <text class="fill-loading-text">加载中…</text>
        </view>
        <scroll-view wx:else scroll-y enhanced class="fill-picker-scroll">
          <view wx:if="{{ myPets.length === 0 }}" class="fill-picker-empty">
            <text class="fill-picker-empty-text">暂无宠物档案，请返回选择「新建宠物档案」</text>
          </view>
          <view wx:for="{{ myPets }}" wx:key="_id" class="fill-picker-item" bindtap="onPetSelect" data-id="{{ item._id }}" hover-class="fill-picker-item--pressed" hover-stay-time="80">
            <image class="fill-pet-avatar" src="{{ item.avatarUrl || '/images/default-avatar.svg' }}" mode="aspectFill" />
            <view class="fill-pet-info">
              <text class="fill-pet-name">{{ item.name }}</text>
              <text class="fill-pet-meta">{{ item.breed || '' }}{{ item.birthday ? ' · ' + item.birthday : '' }}</text>
            </view>
            <view class="fill-picker-check"></view>
          </view>
        </scroll-view>
      </view>
    </view>

    <!-- 支付方式弹层（奢侈品信笺风：金线菱形饰 + 衬线标题 + 行式选项；点遮罩/文字链接=稍后支付） -->
    <view wx:if="{{ paySheetVisible }}" class="fill-picker-mask" bindtap="onPaySheetClose">
      <view class="paysheet" catchtap="stopBubble">
        <view class="paysheet-ornament">
          <view class="ornament-line"></view>
          <view class="ornament-diamond"></view>
          <view class="ornament-line"></view>
        </view>
        <text class="paysheet-eyebrow">SELECT PAYMENT</text>
        <text class="paysheet-title">选择支付方式</text>
        <view class="paysheet-amount">
          <text class="paysheet-amount-label">订单金额</text>
          <text class="paysheet-amount-value">¥{{ paySheetOrder.totalPrice }}</text>
        </view>
        <view class="paysheet-option" bindtap="onPay" data-type="deposit" hover-class="paysheet-option--pressed" hover-stay-time="80">
          <view class="option-info">
            <text class="option-title">支付定金</text>
            <text class="option-sub">总价 30% · 定金不退</text>
          </view>
          <view class="option-right">
            <text class="option-amount">¥{{ depositAmount }}</text>
            <view class="option-arrow"></view>
          </view>
        </view>
        <view class="paysheet-option" bindtap="onPay" data-type="full" hover-class="paysheet-option--pressed" hover-stay-time="80">
          <view class="option-info">
            <text class="option-title">支付全款</text>
            <text class="option-sub">一次付清 · 家庭自动确认</text>
          </view>
          <view class="option-right">
            <text class="option-amount">¥{{ paySheetOrder.totalPrice }}</text>
            <view class="option-arrow"></view>
          </view>
        </view>
        <text class="paysheet-later" bindtap="onPaySheetClose">稍后支付 · 30 分钟内有效</text>
      </view>
    </view>

    <!-- 新建宠物：类型 / 性别 action-sheet（与 create-step1 一致） -->
    <zy-action-sheet show="{{ showTypeSheet }}" actions="{{ petTypes }}" cancel-text="取消" bind:select="onSelectSlotType" bind:close="onCloseTypeSheet" />
    <zy-action-sheet show="{{ showGenderSheet }}" actions="{{ petGenders }}" cancel-text="取消" bind:select="onSelectSlotGender" bind:close="onCloseGenderSheet" />
  </view>
