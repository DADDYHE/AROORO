<!--pages/hosting-services/edit.wxml-->
<view class="container">
  <!-- 页面标题 -->
  <view class="page-title">
    <text class="title-text">编辑家庭介绍</text>
  </view>

  <!-- 表单区域 -->
  <view class="form-section">
    <view class="form-item">
      <view class="label">家庭介绍</view>
      <textarea 
        class="input-box" 
        placeholder="请输入您的家庭介绍（最多500字）"
        value="{{hostDescription}}"
        bindinput="onInput"
        maxlength="500"
        auto-height
        placeholder-class="placeholder"
      ></textarea>
      <view class="char-count">{{charCount}}/500</view>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-buttons">
    <button class="cancel-btn" bindtap="cancel">取消</button>
    <button class="save-btn" bindtap="save" disabled="{{isSaving}}">
      {{isSaving ? '保存中...' : '保存'}}
    </button>
  </view>
</view>