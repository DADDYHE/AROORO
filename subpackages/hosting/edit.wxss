/* pages/hosting-services/edit.wxss */

/* 页面整体样式 */
.container {
  min-height: 100vh;
  background-color: #F5F5F5;
  padding: 20rpx;
  box-sizing: border-box;
}

/* 页面标题 */
.page-title {
  text-align: center;
  margin-bottom: 40rpx;
}

.title-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
}

/* 表单区域 */
.form-section {
  background-color: #FFFFFF;
  border-radius: 12rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.form-item {
  margin-bottom: 30rpx;
}

/* 标签样式 */
.label {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 16rpx;
  font-weight: 500;
}

/* 输入框样式 */
.input-box {
  width: 100%;
  min-height: 300rpx;
  padding: 20rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: #333333;
  background-color: #F8F8F8;
  border-radius: 8rpx;
  box-sizing: border-box;
  border: 1rpx solid #E5E5E5;
}

/* 占位符样式 */
.placeholder {
  color: #CCCCCC;
}

/* 字符计数 */
.char-count {
  text-align: right;
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  justify-content: space-between;
  margin-top: 60rpx;
  padding: 0 20rpx;
}

.cancel-btn, .save-btn {
  width: 48%;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

/* 取消按钮样式 */
.cancel-btn {
  background-color: #F8F8F8;
  color: #666666;
  border: 1rpx solid #E5E5E5;
}

/* 保存按钮样式 */
.save-btn {
  background-color: #007AFF;
  color: #FFFFFF;
  border: none;
}

.save-btn:disabled {
  background-color: #CCCCCC;
  color: #FFFFFF;
}

/* 按钮点击反馈 */
.cancel-btn:active, .save-btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}