<!-- 编辑基本信息页面 -->
<view class="container">
  <view class="header">
    <text class="title">编辑基本信息</text>
  </view>

  <view class="form-container">

    <!-- 寄养家庭名称 -->
    <view class="form-item">
      <text class="label">寄养家庭名称</text>
      <input 
        class="input {{ errors.hostName ? 'input-error' : '' }}" 
        placeholder="请输入寄养家庭名称" 
        value="{{ formData.hostName }}" 
        data-field="hostName"
        bindinput="handleInput"
      />
      <text class="error-message" wx:if="{{ errors.hostName }}">{{ errors.hostName }}</text>
    </view>

    <!-- 真实姓名 -->
    <view class="form-item">
      <text class="label">真实姓名</text>
      <input 
        class="input {{ errors.realName ? 'input-error' : '' }}" 
        placeholder="请输入真实姓名" 
        value="{{ formData.realName }}" 
        data-field="realName"
        bindinput="handleInput"
      />
      <text class="error-message" wx:if="{{ errors.realName }}">{{ errors.realName }}</text>
    </view>

    <!-- 手机号码 -->
    <view class="form-item">
      <text class="label">手机号码</text>
      <input 
        class="input {{ errors.phone ? 'input-error' : '' }}" 
        placeholder="请输入手机号码" 
        value="{{ formData.phone }}" 
        data-field="phone"
        bindinput="handleInput"
        type="tel"
      />
      <text class="error-message" wx:if="{{ errors.phone }}">{{ errors.phone }}</text>
    </view>

    <!-- 身份证号 -->
    <view class="form-item">
      <text class="label">身份证号</text>
      <input 
        class="input {{ errors.idCard ? 'input-error' : '' }}" 
        placeholder="请输入身份证号" 
        value="{{ formData.idCard }}" 
        data-field="idCard"
        bindinput="handleInput"
      />
      <text class="error-message" wx:if="{{ errors.idCard }}">{{ errors.idCard }}</text>
    </view>

    <!-- 详细地址 -->
    <view class="form-item">
      <text class="label">详细地址</text>
      <input 
        class="input {{ errors.address ? 'input-error' : '' }}" 
        placeholder="请输入详细地址" 
        value="{{ formData.address }}" 
        data-field="address"
        bindinput="handleInput"
      />
      <text class="error-message" wx:if="{{ errors.address }}">{{ errors.address }}</text>
    </view>

    <!-- 房屋类型 -->
    <view class="form-item">
      <text class="label">房屋类型</text>
      <view class="selector {{ errors.housingType ? 'selector-error' : '' }}" bindtap="selectHousingType">
        <text class="selector-text">{{ formData.housingType || '请选择房屋类型' }}</text>
      </view>
      <text class="error-message" wx:if="{{ errors.housingType }}">{{ errors.housingType }}</text>
    </view>

    <!-- 是否有庭院 -->
    <view class="form-item">
      <text class="label">是否有庭院</text>
      <view class="selector {{ errors.hasYard ? 'selector-error' : '' }}" bindtap="selectHasYard">
        <text class="selector-text">{{ formData.hasYard || '请选择是否有庭院' }}</text>
      </view>
      <text class="error-message" wx:if="{{ errors.hasYard }}">{{ errors.hasYard }}</text>
    </view>

    <!-- 最大可寄养数量 -->
    <view class="form-item">
      <text class="label">最大可寄养数量</text>
      <view class="selector {{ errors.maxPets ? 'selector-error' : '' }}" bindtap="selectMaxPets">
        <text class="selector-text">{{ formData.maxPets || '请选择最大可寄养数量' }}</text>
      </view>
      <text class="error-message" wx:if="{{ errors.maxPets }}">{{ errors.maxPets }}</text>
    </view>

    <!-- 是否有原住民 -->
    <view class="form-item">
      <text class="label">是否有原住民</text>
      <view class="selector {{ errors.hasOtherPets ? 'selector-error' : '' }}" bindtap="selectHasOtherPets">
        <text class="selector-text">{{ formData.hasOtherPets || '请选择是否有原住民' }}</text>
      </view>
      <text class="error-message" wx:if="{{ errors.hasOtherPets }}">{{ errors.hasOtherPets }}</text>
    </view>

    <!-- 原住民品种和数量 -->
    <view class="form-item" wx:if="{{formData.hasOtherPets === '有'}}">
      <text class="label">原住民品种和数量</text>
      <input 
        class="input {{ errors.nativePetInfo ? 'input-error' : '' }}" 
        placeholder="请输入原住民品种和数量（如：金毛1只）" 
        value="{{ formData.nativePetInfo }}" 
        data-field="nativePetInfo"
        bindinput="handleInput"
      />
      <text class="error-message" wx:if="{{ errors.nativePetInfo }}">{{ errors.nativePetInfo }}</text>
    </view>

    <!-- 可寄养宠物类型 -->
    <view class="form-item">
      <text class="label">可寄养宠物类型</text>
      <view class="selector {{ errors.petTypes ? 'selector-error' : '' }}" bindtap="selectPetType">
        <text class="selector-text">{{ formData.petTypes || '请选择可寄养宠物类型' }}</text>
      </view>
      <text class="error-message" wx:if="{{ errors.petTypes }}">{{ errors.petTypes }}</text>
    </view>

    <!-- 每日价格 -->
    <view class="form-item">
      <text class="label">每日价格</text>
      <input 
        class="input {{ errors.pricePerDay ? 'input-error' : '' }}" 
        placeholder="请输入每日价格" 
        value="{{ formData.pricePerDay }}" 
        data-field="pricePerDay"
        bindinput="handleInput"
        type="digit"
      />
      <text class="error-message" wx:if="{{ errors.pricePerDay }}">{{ errors.pricePerDay }}</text>
    </view>

    <!-- 紧急联系人姓名 -->
    <view class="form-item">
      <text class="label">紧急联系人姓名</text>
      <input 
        class="input {{ errors.emergencyContactName ? 'input-error' : '' }}" 
        placeholder="请输入紧急联系人姓名" 
        value="{{ formData.emergencyContactName }}" 
        data-field="emergencyContactName"
        bindinput="handleInput"
      />
      <text class="error-message" wx:if="{{ errors.emergencyContactName }}">{{ errors.emergencyContactName }}</text>
    </view>

    <!-- 紧急联系人电话 -->
    <view class="form-item">
      <text class="label">紧急联系人电话</text>
      <input 
        class="input {{ errors.emergencyContactPhone ? 'input-error' : '' }}" 
        placeholder="请输入紧急联系人电话" 
        value="{{ formData.emergencyContactPhone }}" 
        data-field="emergencyContactPhone"
        bindinput="handleInput"
        type="tel"
      />
      <text class="error-message" wx:if="{{ errors.emergencyContactPhone }}">{{ errors.emergencyContactPhone }}</text>
    </view>
  </view>

  <!-- 底部按钮 -->
  <view class="button-container">
    <button 
      bindtap="cancel"
      class="cancel-button"
    >
      取消
    </button>
    <button 
      bindtap="saveBasicInfo"
      class="save-button"
    >
      保存
    </button>
  </view>

  <!-- 房屋类型选择面板 -->
  <van-action-sheet
    show="{{showHousingTypeSheet}}"
    title="选择房屋类型"
    cancel-text="取消"
    bind:cancel="onCloseHousingTypeSheet"
  >
    <van-cell-group>
      <van-cell
        wx:for="{{housingTypes}}"
        wx:key="value"
        title="{{item.name}}"
        bind:tap="onSelectHousingType"
        data-value="{{item.value}}"
      />
    </van-cell-group>
  </van-action-sheet>

  <!-- 是否有庭院选择面板 -->
  <van-action-sheet
    show="{{showHasYardSheet}}"
    title="是否有庭院"
    cancel-text="取消"
    bind:cancel="onCloseHasYardSheet"
  >
    <van-cell-group>
      <van-cell
        title="有"
        bind:tap="onSelectHasYard"
        data-value="有"
      />
      <van-cell
        title="无"
        bind:tap="onSelectHasYard"
        data-value="无"
      />
    </van-cell-group>
  </van-action-sheet>

  <!-- 最大可寄养数量选择面板 -->
  <van-action-sheet
    show="{{showMaxPetsSheet}}"
    title="选择最大可寄养数量"
    cancel-text="取消"
    bind:cancel="onCloseMaxPetsSheet"
  >
    <van-cell-group>
      <van-cell
        wx:for="{{['3-5只', '6-8只', '10+只']}}"
        wx:key="*this"
        title="{{item}}"
        bind:tap="onSelectMaxPets"
        data-value="{{item}}"
      />
    </van-cell-group>
  </van-action-sheet>

  <!-- 是否有原住民选择面板 -->
  <van-action-sheet
    show="{{showHasOtherPetsSheet}}"
    title="是否有原住民"
    cancel-text="取消"
    bind:cancel="onCloseHasOtherPetsSheet"
  >
    <van-cell-group>
      <van-cell
        title="有"
        bind:tap="onSelectHasOtherPets"
        data-value="有"
      />
      <van-cell
        title="无"
        bind:tap="onSelectHasOtherPets"
        data-value="无"
      />
    </van-cell-group>
  </van-action-sheet>

  <!-- 可寄养宠物类型选择面板 -->
  <van-action-sheet
    show="{{showPetTypeSheet}}"
    title="选择可寄养宠物类型"
    cancel-text="取消"
    bind:cancel="onClosePetTypeSheet"
  >
    <van-cell-group>
      <van-cell
        title="狗狗"
        bind:tap="onSelectPetType"
        data-value="狗狗"
      />
      <van-cell
        title="猫咪"
        bind:tap="onSelectPetType"
        data-value="猫咪"
      />
      <van-cell
        title="其他"
        bind:tap="onSelectPetType"
        data-value="其他"
      />
    </van-cell-group>
  </van-action-sheet>
</view>
