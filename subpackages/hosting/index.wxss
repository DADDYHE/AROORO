/* 寄养服务页面样式 - 巴黎世家风格 */
.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #fafafa;
  font-family: 'Arial Black', 'Arial Bold', sans-serif;
  padding-bottom: 160rpx;
}

.header {
  padding: 60rpx 40rpx;
  background-color: #fafafa;
  border-bottom: 1rpx solid #f0f0f0;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
  margin-bottom: 40rpx;
  position: relative;
}

.header-content {
  display: flex;
  flex-direction: column;
  max-width: 100%;
}

/* 品牌标识样式 */
.brand-logo {
  font-size: 52rpx;
  font-weight: 900;
  letter-spacing: 14rpx;
  text-align: left;
  margin-bottom: 50rpx;
  color: #000000;
  text-transform: uppercase;
  font-family: 'Arial Black', 'Arial Bold', sans-serif;
  line-height: 1;
}

/* 页面标题和按钮区域 */
.page-header-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
}

.title {
  font-size: 40rpx;
  font-weight: 900;
  color: #000000;
  text-transform: uppercase;
  letter-spacing: 6rpx;
  line-height: 1;
}

/* 暂停接单按钮样式 - 优化触控区域 */
.pause-button {
  background: transparent !important;
  color: black !important;
  border: 1rpx solid black !important;
  border-radius: 8rpx !important;
  padding: 16rpx 40rpx !important;
  font-size: 24rpx !important;
  font-weight: 700 !important;
  text-transform: uppercase !important;
  letter-spacing: 1rpx !important;
  box-shadow: none !important;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1) !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 3rpx !important;
  line-height: 1.1 !important;
  width: auto !important;
  height: auto !important;
  min-width: 170rpx !important;
  min-height: 72rpx !important;
}

.pause-button:active {
  transform: scale(0.95) !important;
  opacity: 0.85 !important;
}

/* 恢复接单按钮样式 - 优化触控区域 */
.resume-button {
  background: black !important;
  color: white !important;
  border: none !important;
  border-radius: 8rpx !important;
  padding: 16rpx 40rpx !important;
  font-size: 24rpx !important;
  font-weight: 700 !important;
  text-transform: uppercase !important;
  letter-spacing: 1rpx !important;
  box-shadow: none !important;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1) !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 3rpx !important;
  line-height: 1.1 !important;
  width: auto !important;
  height: auto !important;
  min-width: 170rpx !important;
  min-height: 72rpx !important;
}

.resume-button:active {
  transform: scale(0.95) !important;
  opacity: 0.85 !important;
}

/* 强制覆盖微信小程序原生按钮样式 */
.pause-button::after,
.resume-button::after {
  border: none !important;
}

/* 强制覆盖 Vant Weapp 按钮组件的默认样式 */
.pause-button .van-button__content,
.resume-button .van-button__content {
  width: 100% !important;
  height: 100% !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  padding: 0 !important;
  min-width: 0 !important;
}

/* 确保按钮容器不会影响尺寸 */
.pause-button,
.resume-button {
  margin: 0 !important;
  overflow: visible !important;
  min-width: auto !important;
  max-width: none !important;
}

/* 页面内容区域 */
.page-content {
  flex: 1;
  padding: 40rpx;
  padding-bottom: 160rpx;
}

.profile-section {
  margin-bottom: 40rpx;
}

/* 服务卡片样式 */
.service-item {
  background-color: #ffffff;
  border: 1rpx solid #f0f0f0;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.06);
  transition: all 0.4s ease;
}

.service-item:active {
  transform: translateY(3rpx);
  box-shadow: 0 3rpx 15rpx rgba(0, 0, 0, 0.04);
}

.service-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

/* 卡片标题和操作按钮布局 */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

/* 圆形编辑按钮样式 */
/* 圆形编辑按钮 - 增大触控区域 */
.round-edit-button {
  position: absolute;
  top: 0;
  right: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background-color: #fff;
  color: #666666;
  border: 1rpx solid #e0e0e0;
  padding: 0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  display: flex;
  align-items: center;
  justify-content: center;
  transform: translate(25%, -25%);
  z-index: 10;
  transform: translate(35%, -35%);
  box-sizing: border-box;
  cursor: pointer;
}

.round-edit-button:active {
  transform: translate(35%, -35%) scale(0.95);
  color: #000000;
  background-color: #e0e0e0;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.1);
}

/* 确保卡片容器可以定位 */
.service-item {
  position: relative !important;
}

/* 编辑按钮样式优化（保留旧样式以防万一） */
.edit-button {
  background: transparent !important;
  color: #999999 !important;
  border: none !important;
  border-radius: 0 !important;
  padding: 0 !important;
  font-size: 24rpx !important;
  font-weight: 700 !important;
  text-transform: uppercase !important;
  letter-spacing: 1rpx !important;
  box-shadow: none !important;
  transition: all 0.3s ease !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 4rpx !important;
  line-height: 1.1 !important;
  height: auto !important;
  min-width: auto !important;
  background-color: transparent !important;
}

.edit-button:hover {
  color: #666666 !important;
}

.edit-button:active {
  transform: translateY(1rpx) !important;
  color: #333333 !important;
}

/* 强制覆盖微信小程序原生按钮样式 */
.edit-button::after {
  border: none !important;
}

/* 强制覆盖 Vant Weapp 按钮组件的默认样式 */
.edit-button .van-button__content {
  width: 100% !important;
  height: 100% !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  padding: 0 !important;
  min-width: 0 !important;
}

/* 头像样式 */
.avatar-container {
  margin-bottom: 30rpx;
  display: flex;
  justify-content: center;
  position: relative;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 2rpx solid #e0e0e0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
  background-color: #f0f0f0;
}

.avatar-overlay {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 160rpx;
  height: 50%;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0));
  border-radius: 0 0 80rpx 80rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: 10rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.avatar-text {
  color: white;
  font-size: 24rpx;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1rpx;
  text-align: center;
}

/* 头像编辑覆盖层 */
.avatar-edit {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 160rpx;
  height: 50%;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0));
  border-radius: 0 0 80rpx 80rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: 10rpx;
  box-sizing: border-box;
  overflow: hidden;
  cursor: pointer;
  transition: all 0.3s ease;
}

.avatar-edit:active {
  background: linear-gradient(to top, rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0));
}

.avatar-edit-text {
  color: white;
  font-size: 24rpx;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1rpx;
  text-align: center;
}

/* 编辑描述容器 */
.edit-description-container {
  margin-top: 20rpx;
}

/* 描述输入框 */
.description-input {
  width: 100%;
  min-height: 200rpx;
  padding: 30rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
  background-color: #fafafa;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  box-sizing: border-box;
  margin-bottom: 20rpx;
}

/* 描述操作区域 */
.description-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 字符计数 */
.char-count {
  text-align: right;
  font-size: 24rpx;
  color: #999999;
  letter-spacing: 1rpx;
}

/* 操作按钮 */
.description-actions .action-buttons {
  display: flex;
  gap: 20rpx;
  margin-top: 10rpx;
}

.description-actions .cancel-btn {
  flex: 1;
  background: transparent;
  color: #666666;
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 3rpx;
  transition: all 0.3s ease;
}

.description-actions .cancel-btn:active {
  transform: scale(0.95);
  background-color: #f0f0f0;
}

.description-actions .save-btn {
  flex: 1;
  background: black;
  color: white;
  border: none;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 3rpx;
  transition: all 0.3s ease;
}

.description-actions .save-btn:active {
  transform: scale(0.95);
  opacity: 0.8;
}

.description-actions .save-btn:disabled {
  background-color: #cccccc;
  color: #ffffff;
  opacity: 0.6;
}

/* 认证图片样式 */
.cert-image {
  width: 100%;
  height: 120rpx;
  border-radius: 8rpx;
  border: 1rpx solid #e0e0e0;
  background-color: #f0f0f0;
}

.service-name {
  font-size: 40rpx;
  font-weight: 900;
  color: #000000;
  text-transform: uppercase;
  letter-spacing: 6rpx;
  line-height: 1.2;
}

.description {
  display: block;
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 40rpx;
  line-height: 1.6;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

/* 基本信息卡片样式 */
.info-card {
  background: linear-gradient(135deg, #ffffff 0%, #fafafa 100%);
  border: 1rpx solid #f0f0f0;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.06);
  transition: all 0.4s ease;
}

.info-card:active {
  transform: translateY(3rpx);
  box-shadow: 0 3rpx 15rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 900;
  color: #000000;
  margin-bottom: 40rpx;
  text-transform: uppercase;
  letter-spacing: 3rpx;
  position: relative;
  padding-left: 20rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 32rpx;
  background: linear-gradient(180deg, #000000 0%, #666666 100%);
  border-radius: 3rpx;
}

/* 基本信息网格布局 */
.info-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.info-card-item {
  background: #f8f8f8;
  border-radius: 16rpx;
  padding: 30rpx 25rpx;
  border: 1rpx solid #e8e8e8;
  transition: all 0.3s ease;
}

.info-card-item:active {
  transform: scale(0.98);
  background: #f0f0f0;
}

.info-card-label {
  display: block;
  font-size: 24rpx;
  font-weight: 900;
  color: #333333;
  margin-bottom: 10rpx;
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

.info-card-value {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.4;
  word-break: break-all;
  letter-spacing: 1rpx;
}

/* 状态卡片样式 */
