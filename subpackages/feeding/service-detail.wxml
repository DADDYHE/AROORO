<zy-navbar title="" transparent color="#F7F5EF" />
<scroll-view
  scroll-y
  enhanced
  refresher-enabled="{{true}}"
  refresher-triggered="{{_refresherTriggered}}"
  bindrefresherrefresh="_onRefresherRefresh"
  bindscrolltolower="_onScrollToLower"
  bindscroll="_onScroll"
  lower-threshold="100"
  style="height: 100vh;"
>
<view class="page">
  <login-prompt visible="{{showLoginPrompt}}" bind:close="onLoginPromptClose" />

  <view class="gallery-header">
    <view class="brand-block">
      <view class="brand-accent-bar"></view>
      <view class="brand-main">
        <text class="brand-text">服务详情</text>
      </view>
      <view class="brand-meta">
        <view class="brand-meta-line"></view>
        <text class="brand-subtitle">上门喂养 · 专属守护</text>
      </view>
    </view>
  </view>

  <view class="tab-bar">
    <view class="tab-item {{activeTab === 0 ? 'active' : ''}}" bindtap="handleTabTap" data-tab="0">
      <text class="tab-text">服务收费</text>
    </view>
    <view class="tab-item {{activeTab === 1 ? 'active' : ''}}" bindtap="handleTabTap" data-tab="1">
      <text class="tab-text">预约指引</text>
    </view>
    <view class="tab-item {{activeTab === 2 ? 'active' : ''}}" bindtap="handleTabTap" data-tab="2">
      <text class="tab-text">常见问题</text>
    </view>
    <!-- Worklet 驱动的丝滑滑动指示器 -->
    <!-- track 固定在 tab-bar 底部，slider 为 1/3 宽度，通过 translateX 滑动 -->
    <!-- worklet 未启用时用 pos-N class 兜底 -->
    <view class="tab-indicator-track">
      <view class="tab-indicator-slider pos-{{activeTab}} {{_workletTabEnabled ? 'worklet-driven' : ''}}">
        <view class="tab-indicator-bar"></view>
      </view>
    </view>
  </view>

  <view class="tab-content" wx:if="{{activeTab === 0}}">
    <view class="service-tabs">
      <view class="service-tab {{serviceType === 'feeding' ? 'active' : ''}}" bindtap="switchServiceType" data-type="feeding">
        <text class="service-tab-text">宠物喂养</text>
      </view>
      <view class="service-tab {{serviceType === 'walking' ? 'active' : ''}}" bindtap="switchServiceType" data-type="walking">
        <text class="service-tab-text">上门遛狗</text>
      </view>
    </view>

    <!-- 宠物喂养内容 -->
    <view wx:if="{{serviceType === 'feeding'}}">
      <view class="section-card section-card-0">
        <view class="section-header">
          <view class="section-accent"></view>
          <text class="section-title">宠物喂养基础服务</text>
        </view>
        
        <view class="service-grid">
          <view class="service-item">
            <view class="service-icon-wrap blue">
              <view class="service-icon bowl">
                <view class="bowl-top"></view>
                <view class="bowl-base"></view>
                <view class="water-wave"></view>
              </view>
            </view>
            <text class="service-name">添新粮换水</text>
          </view>
          <view class="service-item">
            <view class="service-icon-wrap purple">
              <view class="service-icon clean">
                <view class="trash-bin-new">
                  <view class="bin-lid-new"></view>
                  <view class="bin-body-new"></view>
                </view>
              </view>
            </view>
            <text class="service-name">整理宠物区域</text>
          </view>
          <view class="service-item">
            <view class="service-icon-wrap yellow">
              <view class="service-icon sand">
                <view class="litter-box"></view>
                <view class="paw-print"></view>
                <view class="litter-grain"></view>
              </view>
            </view>
            <text class="service-name">清洁砂盆尿垫</text>
          </view>
          <view class="service-item">
            <view class="service-icon-wrap orange">
              <view class="service-icon heart">
                <view class="heart-main"></view>
                <view class="heart-accent"></view>
                <view class="pet-nose"></view>
              </view>
            </view>
            <text class="service-name">反馈宠物状态</text>
          </view>
          <view class="service-item">
            <view class="service-icon-wrap purple-light">
              <view class="service-icon door">
                <view class="door-frame"></view>
                <view class="door-knob"></view>
                <view class="check-mark"></view>
              </view>
            </view>
            <text class="service-name">检查关闭门窗</text>
          </view>
          <view class="service-item">
            <view class="service-icon-wrap blue-light">
              <view class="service-icon video">
                <view class="camera-body"></view>
                <view class="camera-lens"></view>
                <view class="play-button"></view>
              </view>
            </view>
            <text class="service-name">服务全程录像</text>
          </view>
        </view>
        
        <view class="service-note">
          <text class="note-text">单个宠物基础服务时长约为<text class="highlight">20分钟</text>，每增加一个宠物约增加<text class="highlight">5-10分钟</text></text>
        </view>
      </view>

      <view class="section-card section-card-1">
        <view class="section-header">
          <view class="section-accent"></view>
          <text class="section-title">宠物喂养服务费用标准</text>
        </view>
        
        <view class="price-table">
          <view class="table-header">
            <text class="table-cell">宠物喂养</text>
            <text class="table-cell">日常价格</text>
            <text class="table-cell">法定节假日</text>
          </view>
          <view class="table-row">
            <view class="table-cell">
              <text class="provider-name">基础服务</text>
              <text class="provider-note">5公里外每公里+4元</text>
            </view>
            <text class="table-cell price">50元</text>
            <text class="table-cell price">60元</text>
          </view>
        </view>
      </view>

      <view class="section-card section-card-2">
        <view class="section-header">
          <view class="section-accent"></view>
          <text class="section-title">宠物喂养更多服务</text>
        </view>
        
        <view class="extra-services">
          <view class="extra-service-item">
            <view class="extra-info">
              <text class="extra-name">一天多次</text>
              <text class="extra-desc">喂养员在服务日期当天额外上门一次</text>
            </view>
            <text class="extra-price">80%*服务费</text>
          </view>
          
          <view class="extra-service-item">
            <view class="extra-info">
              <text class="extra-name">提前熟悉</text>
              <text class="extra-desc">喂养员在服务日期前上门熟悉宠物</text>
            </view>
            <text class="extra-price">70%*服务费</text>
          </view>
          
          <view class="extra-service-item">
            <view class="extra-info">
              <text class="extra-name">多宠</text>
              <text class="extra-desc">单次增加一只服务宠物</text>
            </view>
            <text class="extra-price">10元</text>
          </view>
          
          <view class="extra-service-item">
            <view class="extra-info">
              <text class="extra-name">陪玩/遛狗</text>
              <text class="extra-desc">增加10分钟服务服务时长，可陪玩/遛狗</text>
            </view>
            <text class="extra-price">10元</text>
          </view>
          
          <view class="extra-service-item">
            <view class="extra-info">
              <text class="extra-name">清洁</text>
              <text class="extra-desc">清洗猫砂盆或小范围区域卫生</text>
            </view>
            <text class="extra-price">40元</text>
          </view>
          
          <view class="extra-service-item">
            <view class="extra-info">
              <text class="extra-name">护理</text>
              <text class="extra-desc">清洁宠物耳道、眼部、鼻部</text>
            </view>
            <text class="extra-price">20元</text>
          </view>
          
          <view class="extra-service-item">
            <view class="extra-info">
              <text class="extra-name">喂药</text>
              <text class="extra-desc">给宠物喂保健品、医疗药物</text>
            </view>
            <text class="extra-price">20元</text>
          </view>
        </view>
        
        <view class="ps-note">
          <text class="ps-text">ps：如您需<text class="highlight">多次服务</text>，下单时可多次选择，服务时长和费用根据次数叠加</text>
        </view>
      </view>

      <view class="section-card section-card-3">
        <view class="section-header">
          <view class="section-accent"></view>
          <text class="section-title">宠物喂养服务流程</text>
        </view>
        
        <view class="flow-list">
          <view class="flow-item">
            <view class="flow-number"><text></text></view>
            <view class="flow-content">
              <view class="flow-header">
                <view class="flow-icon order"></view>
                <text class="flow-title">宠主下单</text>
              </view>
              <text class="flow-desc">宠主预约下单后，平台通知喂养员接单；</text>
              <view class="flow-tip">
                <text class="flow-tip-text">建议提前预约，临时下单喂养员可能无法安排时间进行上门服务服务哦~</text>
              </view>
            </view>
          </view>
          
          <view class="flow-item">
            <view class="flow-number"><text></text></view>
            <view class="flow-content">
              <view class="flow-header">
                <view class="flow-icon accept"></view>
                <text class="flow-title">喂养员接单</text>
              </view>
              <text class="flow-desc">喂养员会先与宠主<text class="highlight">沟通服务事项</text>（如宠物性格、生活习性等），确认无误后接单；</text>
            </view>
          </view>
          
          <view class="flow-item">
            <view class="flow-number"><text></text></view>
            <view class="flow-content">
              <view class="flow-header">
                <view class="flow-icon key"></view>
                <text class="flow-title">钥匙交接</text>
              </view>
              <text class="flow-desc">喂养员在服务前根据服务服务信息及宠物主要求交接钥匙；</text>
              <view class="flow-tip">
                <text class="flow-tip-text">可根据双方情况选择同城快递、面交、放于指定位置等方式</text>
              </view>
            </view>
          </view>
          
          <view class="flow-item">
            <view class="flow-number"><text></text></view>
            <view class="flow-content">
              <view class="flow-header">
                <view class="flow-icon prepare"></view>
                <text class="flow-title">上门服务准备</text>
              </view>
              <text class="flow-desc">喂养员在服务前沟通预计上门时间，并提前备好录像支架，宠物消毒喷雾，消毒纸巾，手套，鞋套，垃圾袋等物品；</text>
              <view class="flow-tip">
                <text class="flow-tip-text">若喂养员在上门前违约取消订单，可视情况赔付您订单金额的10%-100%</text>
              </view>
            </view>
          </view>
          
          <view class="flow-item">
            <view class="flow-number"><text></text></view>
            <view class="flow-content">
              <view class="flow-header">
                <view class="flow-icon checkin"></view>
                <text class="flow-title">服务打卡</text>
              </view>
              <text class="flow-desc">喂养员在预计上门时间前抵达<text class="highlight">服务地点并打卡</text>，需进行<text class="highlight">身份认证及位置定位</text>，均通过后才可打卡成功；</text>
              <view class="flow-tip">
                <text class="flow-tip-text">若喂养员迟到15分钟以上，可视情况赔付您订单金额的10%-100%</text>
              </view>
            </view>
          </view>
          
          <view class="flow-item">
            <view class="flow-number"><text></text></view>
            <view class="flow-content">
              <view class="flow-header">
                <view class="flow-icon disinfection"></view>
                <text class="flow-title">消毒&录像</text>
              </view>
              <text class="flow-desc">喂养员在进门前穿戴手套鞋套并消毒，开始以第一视角进行录像；</text>
            </view>
          </view>
          
          <view class="flow-item">
            <view class="flow-number"><text></text></view>
            <view class="flow-content">
              <view class="flow-header">
                <view class="flow-icon comfort"></view>
                <text class="flow-title">安抚宠物</text>
              </view>
              <text class="flow-desc">喂养员视情况与宠物友好接触，待宠物情绪稳定后开始服务；</text>
              <view class="flow-tip">
                <text class="flow-tip-text">若宠物胆小或者铲屎官要求不接触，则不会进行任何接触</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

