.page-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #F5F5F7;
  position: relative;
}

.gallery-header {
  padding: 0;
  position: relative;
  overflow: hidden;
  background: #FFFFFF;
  animation: fadeUp 0.6s ease-out;
  padding-bottom: 20rpx;
}

.brand-block {
  padding: 80rpx 48rpx 64rpx;
  position: relative;
}

.brand-block::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, rgba(33, 150, 243, 0.12) 0%, transparent 70%);
  pointer-events: none;
}

.brand-accent-bar {
  position: absolute;
  top: 0;
  left: 48rpx;
  width: 48rpx;
  height: 6rpx;
  background: linear-gradient(90deg, #2196F3 0%, #1976D2 100%);
  border-radius: 0 0 4rpx 4rpx;
  animation: slideDown 0.5s ease-out;
}

.brand-main {
  position: relative;
  margin-bottom: 24rpx;
}

.brand-text {
  font-size: 64rpx;
  font-weight: 300;
  color: #1D1D1F;
  letter-spacing: 12rpx;
  display: block;
  line-height: 1;
  position: relative;
}

.brand-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.brand-meta-line {
  width: 40rpx;
  height: 2rpx;
  background: #E5E5EA;
  position: relative;
}

.brand-meta-line::after {
  content: '';
  position: absolute;
  top: 50%;
  right: -4rpx;
  transform: translateY(-50%);
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #2196F3;
}

.brand-subtitle {
  font-size: 22rpx;
  color: #8E8E93;
  letter-spacing: 8rpx;
  font-weight: 400;
}

.page-content {
  flex: 1;
  padding: 0 32rpx 24rpx;
  position: relative;
  z-index: 1;
  padding-bottom: 160rpx;
}

.info-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 0;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(134, 134, 139, 0.1);
  position: relative;
  overflow: hidden;
  animation: sectionSlideIn 0.5s ease-out both;
}

.info-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: linear-gradient(90deg, #2196F3 0%, #1976D2 50%, transparent 100%);
  border-radius: 24rpx 24rpx 0 0;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx 20rpx;
  border-bottom: 1rpx solid #F2F2F7;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D1D1F;
}

.card-header-link {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.link-text {
  font-size: 24rpx;
  color: #2196F3;
  font-weight: 500;
}

.link-arrow {
  font-size: 28rpx;
  color: #2196F3;
  font-weight: 300;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #F2F2F7;
  transition: all 0.2s ease;
}

.info-item:active {
  background-color: #F5F5F7;
}

.info-item:last-child {
  border-bottom: none;
}

.info-item .label {
  font-size: 28rpx;
  font-weight: 500;
  color: #1D1D1F;
  flex-shrink: 0;
}

.info-item .value {
  font-size: 26rpx;
  color: #8E8E93;
  font-weight: 400;
}

.interaction-item {
  position: relative;
}

.brand-action-item {
  background: linear-gradient(135deg, rgba(78, 205, 196, 0.06) 0%, rgba(38, 166, 154, 0.03) 100%);
  border-bottom: 1rpx solid rgba(78, 205, 196, 0.12);
}

.brand-action-item:active {
  background: linear-gradient(135deg, rgba(78, 205, 196, 0.12) 0%, rgba(38, 166, 154, 0.06) 100%);
}

.brand-action-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #4ECDC4;
  flex-shrink: 0;
}

.brand-action-value {
  display: flex;
  align-items: center;
}

.brand-action-placeholder {
  font-size: 24rpx;
  color: #4ECDC4;
  font-weight: 500;
  opacity: 0.7;
}

.brand-action-text {
  font-size: 26rpx;
  color: #4ECDC4;
  font-weight: 600;
}

.address-item {
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
}

.address-value {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  width: 100%;
}

.address-text {
  flex: 1;
  font-size: 26rpx;
  color: #1D1D1F;
  font-weight: 500;
  word-wrap: break-word;
  word-break: break-all;
  line-height: 1.5;
}

.address-value .placeholder {
  color: #C7C7CC;
  font-weight: 400;
}

.address-value .arrow {
  font-size: 28rpx;
  color: #C7C7CC;
  font-weight: 300;
  flex-shrink: 0;
  padding-top: 4rpx;
}

.value-with-arrow {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #1D1D1F;
  font-weight: 500;
}

.value-with-arrow .placeholder {
  color: #C7C7CC;
  font-weight: 400;
}

.value-with-arrow .arrow {
  font-size: 28rpx;
  color: #C7C7CC;
  font-weight: 300;
}

.notes-input {
  font-size: 26rpx;
  color: #1D1D1F;
  text-align: left;
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx 24rpx;
  background-color: #F5F7FA;
  border-radius: 12rpx;
  min-height: 120rpx;
  line-height: 1.6;
}

.notes-item {
  flex-direction: column;
  align-items: stretch;
  gap: 12rpx;
  overflow: hidden;
}

.notes-item .label {
  flex-shrink: 0;
}

.notes-item .notes-input {
  width: 100%;
}

.picker-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  display: flex;
  align-items: flex-end;
}

.picker-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
}

.picker-content {
  position: relative;
  width: 100%;
  background: #FFFFFF;
  border-radius: 28rpx 28rpx 0 0;
  overflow: hidden;
  animation: fadeUp 0.3s ease-out;
}

.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #F2F2F7;
}

.picker-cancel {
  font-size: 28rpx;
  color: #8E8E93;
  padding: 8rpx 16rpx;
}

.picker-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1D1D1F;
}

.picker-confirm {
  font-size: 28rpx;
  color: #2196F3;
  font-weight: 600;
  padding: 8rpx 16rpx;
}

.picker-view {
  width: 100%;
  height: 480rpx;
}

.picker-view-double {
  height: 480rpx;
}

.picker-column-item {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #1D1D1F;
  height: 80rpx;
  line-height: 80rpx;
}

.empty-tip {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 60rpx 32rpx;
  color: #AEAEB2;
  font-size: 26rpx;
  background-color: #F5F5F7;
  border-radius: 16rpx;
  margin: 24rpx 32rpx 32rpx;
}

.pet-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #F2F2F7;
}

.pet-item:last-child {
  border-bottom: none;
}

.pet-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.avatar-container {
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
  overflow: hidden;
  flex-shrink: 0;
  border: 1rpx solid #E5E5EA;
  background-color: #F5F5F7;
  margin-right: 24rpx;
}

.pet-image {
  width: 100%;
  height: 100%;
  display: block;
}

.pet-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.pet-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1D1D1F;
  line-height: 1.2;
}

.pet-details {
  font-size: 22rpx;
  color: #8E8E93;
}

.pet-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
  margin-left: 24rpx;
}

.pet-service-tags {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 8rpx;
}

.service-tag {
  font-size: 20rpx;
  color: #2196F3;
  background: rgba(33, 150, 243, 0.06);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-weight: 500;
  white-space: nowrap;
}

.walk-tag {
  color: #4ECDC4;
  background: rgba(78, 205, 196, 0.06);
}

.pet-service-dates {
  font-size: 20rpx;
  color: #AEAEB2;
  line-height: 1.5;
  text-align: right;
  word-wrap: break-word;
  word-break: break-all;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.price-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid #F2F2F7;
}

.price-item:last-child {
  border-bottom: none;
}

.price-item .label {
  font-size: 26rpx;
  color: #8E8E93;
}

.price-item .value {
  font-size: 26rpx;
  color: #1D1D1F;
  font-weight: 500;
}

.price-item.total {
  background: linear-gradient(135deg, rgba(33, 150, 243, 0.04) 0%, rgba(25, 118, 210, 0.02) 100%);
  border-radius: 16rpx;
  margin: 12rpx 32rpx 20rpx;
  padding: 28rpx 32rpx;
  border: 1rpx solid rgba(33, 150, 243, 0.1);
}

.price-item.total .label {
  font-size: 28rpx;
  color: #1D1D1F;
  font-weight: 600;
}

.price-item.total .value {
  font-size: 36rpx;
  color: #2196F3;
  font-weight: 700;
}

.price-pet-group {
  padding-bottom: 8rpx;
}

.price-sub-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 32rpx 8rpx 48rpx;
}

.sub-label {
  font-size: 24rpx;
  color: #AEAEB2;
}

.sub-value {
  font-size: 24rpx;
  color: #8E8E93;
}

.info-section.coupon-section {
  background: #FFFFFF;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(134, 134, 139, 0.1);
  position: relative;
}

.info-section.coupon-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: linear-gradient(90deg, #2196F3 0%, #1976D2 50%, transparent 100%);
  border-radius: 24rpx 24rpx 0 0;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #F2F2F7;
}

.section-header-left {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D1D1F;
}

.section-header-right {
  font-size: 24rpx;
  color: #2196F3;
  font-weight: 500;
}

.coupon-list {
  padding: 16rpx 32rpx 24rpx;
}

.coupon-option {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F2F2F7;
}

.coupon-option:last-child {
  border-bottom: none;
}

.coupon-option-left {
  width: 120rpx;
  display: flex;
  align-items: baseline;
  justify-content: center;
  color: #2196F3;
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 500;
}

.coupon-option-left .big {
  font-size: 44rpx;
  font-weight: 700;
}

.coupon-option-right {
  flex: 1;
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.coupon-option-right .coupon-name {
  font-size: 26rpx;
  color: #1D1D1F;
  font-weight: 500;
}

.coupon-rule {
  font-size: 22rpx;
  color: #8E8E93;
}

.remove-coupon {
  text-align: center;
  padding: 20rpx;
  font-size: 26rpx;
  color: #2196F3;
  border-top: 1rpx solid #F2F2F7;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-top: 1rpx solid rgba(134, 134, 139, 0.1);
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 100;
}

.bottom-left {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.price-label {
  font-size: 26rpx;
  color: #8E8E93;
}

.price-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #2196F3;
}

.price-value .symbol {
  font-size: 28rpx;
  margin-right: 2rpx;
  font-weight: 600;
}

.coupon-sub {
  font-size: 22rpx;
  color: #AEAEB2;
}

.confirm-btn {
  padding: 22rpx 64rpx;
  background: linear-gradient(135deg, #2196F3 0%, #1976D2 100%);
  border-radius: 48rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 2rpx;
  box-shadow: 0 6rpx 16rpx rgba(33, 150, 243, 0.3);
  transition: all 0.3s ease;
}

.confirm-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(33, 150, 243, 0.3);
}

.confirm-btn-disabled {
  opacity: 0.6;
  pointer-events: none;
}

.content-bottom-space {
  height: 140rpx;
}

.loading-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #F5F5F7;
  z-index: 9999;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 3rpx solid #E5E5EA;
  border-top: 3rpx solid #2196F3;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

.loading-container .loading-text {
  font-size: 22rpx;
  color: #AEAEB2;
}

.gallery-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  display: flex;
  align-items: flex-end;
}

.gallery-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
}

.gallery-sheet {
  position: relative;
  width: 100%;
  background: #FFFFFF;
  border-radius: 28rpx 28rpx 0 0;
  animation: fadeUp 0.3s ease-out;
  padding: 40rpx 32rpx 48rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.gallery-sheet-close {
  position: absolute;
  top: 32rpx;
  right: 32rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.close-icon {
  font-size: 40rpx;
  color: #C7C7CC;
  font-weight: 300;
  line-height: 1;
}

.gallery-sheet-header {
  margin-bottom: 32rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #F2F2F7;
}

.gallery-sheet-header.center-header {
  text-align: center;
  padding-top: 8rpx;
}

.gallery-sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1D1D1F;
  display: block;
  margin-bottom: 8rpx;
}

.gallery-sheet-subtitle {
  font-size: 24rpx;
  color: #8E8E93;
  line-height: 1.5;
  display: block;
}

.gallery-options {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.gallery-option {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-radius: 20rpx;
  border: 2rpx solid #F2F2F7;
  background: #FAFAFA;
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
}

.gallery-option:active {
  transform: scale(0.98);
}

.gallery-option-selected {
  border-color: #2196F3;
  background: rgba(33, 150, 243, 0.04);
  box-shadow: 0 4rpx 16rpx rgba(33, 150, 243, 0.1);
}

.gallery-option-icon {
  font-size: 40rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F5F5F7;
  border-radius: 16rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.gallery-option-selected .gallery-option-icon {
  background: rgba(33, 150, 243, 0.1);
}

.gallery-option-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.gallery-option-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D1D1F;
}

.gallery-option-desc {
  font-size: 22rpx;
  color: #8E8E93;
  line-height: 1.4;
}

.gallery-option-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #2196F3;
  color: #FFFFFF;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.gallery-sheet-footer {
  display: flex;
  justify-content: center;
}

.gallery-confirm-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: linear-gradient(135deg, #4ECDC4, #26A69A);
  border-radius: 48rpx;
  letter-spacing: 2rpx;
  box-shadow: 0 8rpx 24rpx rgba(78, 205, 196, 0.35);
}

.gallery-confirm-btn:active {
  transform: scale(0.98);
}

.picker-date-scroll {
  margin-bottom: 48rpx;
  white-space: nowrap;
}

.picker-date-list {
  display: inline-flex;
  gap: 20rpx;
  padding: 8rpx 4rpx;
}

.picker-date-pill {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 120rpx;
  height: 120rpx;
  padding: 16rpx 24rpx;
  border-radius: 24rpx;
  background: #F5F5F7;
  border: 2rpx solid #F5F5F7;
  transition: all 0.25s ease;
  position: relative;
}

.picker-date-pill-active {
  background: rgba(78, 205, 196, 0.1);
  border-color: #4ECDC4;
  box-shadow: 0 4rpx 16rpx rgba(78, 205, 196, 0.15);
}

.picker-date-pill-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D1D1F;
  line-height: 1.2;
}

.picker-date-pill-count {
  font-size: 20rpx;
  color: #4ECDC4;
  font-weight: 600;
  margin-top: 4rpx;
}

.picker-stepper-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 0;
  margin-bottom: 48rpx;
}

.picker-stepper-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D1D1F;
  flex-shrink: 0;
}

.picker-stepper-bar {
  display: flex;
  align-items: center;
  gap: 32rpx;
  flex: 1;
  justify-content: center;
}

.picker-stepper-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 500;
  transition: all 0.2s ease;
}

.picker-stepper-minus {
  background: #F5F5F7;
  color: #8E8E93;
  border: 2rpx solid #E5E5EA;
}

.picker-stepper-minus:active {
  background: #E5E5EA;
}

.picker-stepper-plus {
  background: linear-gradient(135deg, #4ECDC4, #26A69A);
  color: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(78, 205, 196, 0.35);
}

.picker-stepper-plus:active {
  transform: scale(0.95);
}

.picker-stepper-disabled {
  opacity: 0.35;
  pointer-events: none;
}

.picker-stepper-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #1D1D1F;
  min-width: 60rpx;
  text-align: center;
}

.picker-stepper-unit {
  font-size: 28rpx;
  color: #8E8E93;
  font-weight: 500;
  flex-shrink: 0;
}

.picker-stepper-price {
  text-align: center;
  margin-bottom: 32rpx;
}

.picker-stepper-price-text {
  font-size: 24rpx;
  color: #4ECDC4;
  font-weight: 500;
}

.payment-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
}

.modal-content {
  position: relative;
  width: 580rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1D1D1F;
  margin-bottom: 32rpx;
}

.modal-total {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: #8E8E93;
  margin-bottom: 40rpx;
}

.final-price {
  font-size: 40rpx;
  font-weight: 700;
  color: #2196F3;
}

.pay-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: linear-gradient(135deg, #2196F3, #1976D2);
  border-radius: 48rpx;
  margin-bottom: 24rpx;
  text-align: center;
  padding: 0;
  border: none;
  outline: none;
}

.pay-btn::after {
  border: none;
}

.cancel-btn {
  font-size: 26rpx;
  color: #8E8E93;
  padding: 16rpx;
}

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes slideDown {
  from { opacity: 0; transform: translateY(-20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes sectionSlideIn {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}
