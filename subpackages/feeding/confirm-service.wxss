@import '../../styles/loading-animation.wxss';

@import '../../styles/components.wxss';

/* ================================================================
   subpackages/feeding/confirm-service · AROORO 确认服务 — Haute-Luxury Editorial
   板块色：喂养绿 + 暖金点缀 --accent-color
   Skyline 兼容：无 :active / text-transform / backdrop-filter / sticky
   ================================================================ */

/* ===== 页面容器 ===== */
.page-container {
  display: flex;
  flex-direction: column;
  position: relative;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

/* ---------- 顶部品牌区域 ----------
   gallery-header/brand-* 系已由全局 .lux-hero（styles/lux-page.wxss）替代（2026-09-09 A+B 升级）。 */

/* ===== 内容区 ===== */
.page-content {
  flex: 1;
  padding: 0 var(--page-padding) 24rpx;
  position: relative;
  z-index: 1;
}

/* ===== 信息卡片 ===== */
.info-card {
  background: transparent;
  padding: 0;
  margin-bottom: var(--zy-space-lg);
  position: relative;
  animation-name: zy-fade-in-up;
  animation-duration: 480ms;
  animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  animation-fill-mode: forwards;
}

.info-card:nth-child(2) {
  animation-delay: 140ms;
}

.info-card:nth-child(3) {
  animation-delay: 200ms;
}

.info-card:nth-child(4) {
  animation-delay: 260ms;
}

/* 展陈式段头（01-04 编号 + serif 标题 + 金墨规则线） */
.exhibit-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx var(--zy-space-lg) 20rpx;
  border-bottom: 1rpx solid rgba(26, 26, 23, 0.14);
}

.exhibit-number {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--lux-gold-ink);
  font-family: var(--font-serif);
  letter-spacing: 0.06em;
  line-height: 1;
}

.exhibit-title-block {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  min-width: 0;
}

.exhibit-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: 0.08em;
  font-family: var(--font-serif);
}

.exhibit-line {
  width: 68rpx;
  height: 2rpx;
  background: var(--lux-gold-ink);
}

.card-header-link {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.link-text {
  font-size: 24rpx;
  color: var(--lux-gold-ink);
  font-weight: 500;
  letter-spacing: 0.02em;
  font-family: var(--font-sans);
}

.link-arrow {
  font-size: 28rpx;
  color: var(--lux-gold-ink);
  font-weight: 300;
  font-family: var(--font-sans);
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx var(--zy-space-lg);
  border-bottom: 1rpx solid rgba(26, 26, 23, 0.14);
}

.info-item:last-child {
  border-bottom: none;
}

.info-item .label {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  flex-shrink: 0;
  letter-spacing: 0.02em;
  font-family: var(--font-sans);
}

.info-item .value {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 400;
  letter-spacing: 0.02em;
  font-family: var(--font-sans);
}

/* ===== 交互项 ===== */
.interaction-item {
  position: relative;
}

.brand-action-item {
  background: transparent;
  border-bottom: 1rpx solid rgba(26, 26, 23, 0.14);
}

.brand-action-label {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--feeding-primary);
  flex-shrink: 0;
  letter-spacing: 0.02em;
  font-family: var(--font-sans);
}

.brand-action-value {
  display: flex;
  align-items: center;
}

.brand-action-placeholder {
  font-size: 24rpx;
  color: var(--feeding-primary);
  font-weight: 400;
  opacity: 0.6;
  letter-spacing: 0.02em;
}

.brand-action-text {
  font-size: 26rpx;
  color: var(--feeding-primary);
  font-weight: 500;
  letter-spacing: 0.02em;
  font-family: var(--font-sans);
}

/* ===== 地址项 ===== */
.address-item {
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
}

.address-value {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  width: 100%;
}

.address-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 500;
  overflow-wrap: break-word;
  word-break: break-all;
  line-height: 1.5;
  letter-spacing: 0.02em;
  font-family: var(--font-sans);
}

.address-value .placeholder {
  color: var(--text-tertiary);
  font-weight: 400;
}

.address-value .arrow {
  font-size: 28rpx;
  color: var(--text-tertiary);
  font-weight: 300;
  flex-shrink: 0;
  padding-top: 4rpx;
}

.value-with-arrow {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.value-with-arrow .placeholder {
  color: var(--text-tertiary);
  font-weight: 400;
}

.value-with-arrow .arrow {
  font-size: 28rpx;
  color: var(--text-tertiary);
  font-weight: 300;
}

/* ===== 备注输入 ===== */
.notes-input {
  font-size: 26rpx;
  color: var(--text-primary);
  text-align: left;
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx 0;
  background-color: transparent;
  min-height: 120rpx;
  line-height: 1.6;
  border: none;
  letter-spacing: 0.02em;
  font-family: var(--font-sans);
}

.notes-item {
  flex-direction: column;
  align-items: stretch;
  gap: 12rpx;
  overflow: hidden;
}

.notes-item .label {
  flex-shrink: 0;
}

.notes-item .notes-input {
  width: 100%;
}

.phone-input {
  font-size: 26rpx;
  color: var(--text-primary);
  text-align: right;
  flex: 1;
  min-width: 0;
  letter-spacing: 0.02em;
  font-family: var(--font-sans);
}

.required-star {
  color: var(--error-color);
  margin-left: 4rpx;
}

/* ===== 选择器弹窗 ===== */
.picker-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  display: flex;
  align-items: flex-end;
}

.picker-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--overlay-color, rgba(26,26,23,0.5));
}

.picker-content {
  position: relative;
  width: 100%;
  background: var(--zy-paper-fallback);
  border-radius: var(--zy-radius-2xl) var(--zy-radius-2xl) 0 0;
  overflow: hidden;
}

.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx var(--zy-space-lg);
  border-bottom: 1rpx solid rgba(26, 26, 23, 0.14);
}

.picker-cancel {
  font-size: 28rpx;
  color: var(--text-secondary);
  padding: 8rpx 16rpx;
  letter-spacing: 0.02em;
  font-family: var(--font-sans);
}

.picker-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.04em;
  font-family: var(--font-serif);
}

.picker-confirm {
  font-size: 28rpx;
  color: var(--feeding-primary);
  font-weight: 500;
  padding: 8rpx 16rpx;
  letter-spacing: 0.02em;
  font-family: var(--font-sans);
}

.picker-view {
  width: 100%;
  height: 480rpx;
}

.picker-view-double {
  height: 480rpx;
}

.picker-column-item {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: var(--text-primary);
  height: 80rpx;
  line-height: 80rpx;
  letter-spacing: 0.02em;
  font-family: var(--font-sans);
}

/* ===== 空提示 ===== */
.empty-tip {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 60rpx var(--zy-space-lg);
  color: var(--text-tertiary);
  font-size: 26rpx;
  background-color: transparent;
  margin: 24rpx var(--zy-space-lg) 32rpx;
  letter-spacing: 0.02em;
  font-family: var(--font-sans);
}

/* ===== 宠物项 ===== */
.pet-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx var(--zy-space-lg);
  border-bottom: 1rpx solid rgba(26, 26, 23, 0.14);
}

.pet-item:last-child {
  border-bottom: none;
}

.pet-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.avatar-container {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  border: 1rpx solid rgba(26, 26, 23, 0.22);
  margin-right: 24rpx;
}

.pet-image {
  width: 100%;
  height: 100%;
  display: block;
}

.pet-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.pet-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  line-height: 1.2;
  letter-spacing: 0.02em;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-family: var(--font-serif);
}

.pet-details {
  font-size: 22rpx;
  color: var(--text-secondary);
  letter-spacing: 0.02em;
  font-family: var(--font-sans);
}

.pet-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
  margin-left: 24rpx;
}

.pet-service-tags {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 8rpx;
}

.service-tag {
  font-size: 20rpx;
  color: var(--lux-gold-ink);
  background: transparent;
  padding: 4rpx 12rpx;
  border: 1rpx solid rgba(122, 95, 42, 0.35);
  border-radius: var(--zy-radius-sm);
  font-weight: 400;
  white-space: nowrap;
  letter-spacing: 0.02em;
  font-family: var(--font-sans);
}

.walk-tag {
  color: var(--lux-gold-ink);
  background: transparent;
}

.pet-service-dates {
  font-size: 20rpx;
  color: var(--text-tertiary);
  line-height: 1.5;
  text-align: right;
  overflow-wrap: break-word;
  word-break: break-all;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-family: var(--font-sans);
}

/* ===== 价格项 ===== */
.price-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx var(--zy-space-lg);
  border-bottom: 1rpx solid rgba(26, 26, 23, 0.14);
}

.price-item:last-child {
  border-bottom: none;
}

.price-item .label {
  font-size: 26rpx;
  color: var(--text-secondary);
  letter-spacing: 0.02em;
  font-family: var(--font-sans);
}

.price-item .value {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 500;
  letter-spacing: 0.02em;
  font-family: var(--font-sans);
}

.price-item.total {
  background: transparent;
  margin: 12rpx 0 0;
  padding: 28rpx var(--zy-space-lg) 4rpx;
  border-top: 1rpx solid rgba(26, 26, 23, 0.14);
}

.price-item.total .label {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.price-item.total .value {
  font-size: 48rpx;
  color: var(--lux-gold-ink);
  font-weight: 600;
  font-family: var(--font-serif);
}

.price-pet-group {
  padding-bottom: 8rpx;
}

.price-sub-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx var(--zy-space-lg) 8rpx 48rpx;
}

.sub-label {
  font-size: 24rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.02em;
  font-family: var(--font-sans);
}

.sub-value {
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 0.02em;
  font-family: var(--font-sans);
}

/* ===== 优惠券区块 ===== */
.info-section.coupon-section {
  background: transparent;
  margin-bottom: 0;
  overflow: hidden;
  border: 1rpx solid rgba(26, 26, 23, 0.14);
  position: relative;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx var(--zy-space-lg);
  border-bottom: 1rpx solid rgba(26, 26, 23, 0.14);
  background: transparent;
}

.section-header-left {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.04em;
  font-family: var(--font-serif);
}

.section-header-right {
  font-size: 24rpx;
  color: var(--feeding-primary);
  font-weight: 500;
  letter-spacing: 0.02em;
  font-family: var(--font-sans);
}

.coupon-list {
  padding: 16rpx var(--zy-space-lg) 24rpx;
}

.coupon-option {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(26, 26, 23, 0.14);
}

.coupon-option--active {
  border-left: 3rpx solid var(--lux-gold-ink);
  padding-left: 12rpx;
  background: rgba(122, 95, 42, 0.04);
}

.coupon-option:last-child {
  border-bottom: none;
}

.coupon-option-left {
  width: 120rpx;
  display: flex;
  align-items: baseline;
  justify-content: center;
  color: var(--lux-gold-ink);
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 500;
}

.coupon-option-left .big {
  font-size: 44rpx;
  font-weight: 500;
}

.coupon-option-right {
  flex: 1;
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.coupon-option-right .coupon-name {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 500;
  letter-spacing: 0.02em;
  font-family: var(--font-sans);
}

.coupon-rule {
  font-size: 22rpx;
  color: var(--text-secondary);
  letter-spacing: 0.02em;
  font-family: var(--font-sans);
}

.remove-coupon {
  text-align: center;
  padding: 20rpx;
  font-size: 26rpx;
  color: var(--feeding-primary);
  border-top: 1rpx solid rgba(26, 26, 23, 0.14);
  letter-spacing: 0.02em;
  font-family: var(--font-sans);
}

/* ===== 底部操作栏 ===== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 12rpx var(--page-padding);
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
  background: var(--zy-paper-fallback);
  border-top: 1rpx solid rgba(26, 26, 23, 0.14);
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  z-index: 100;
}

.bar-action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  position: relative;
}

.contact-wrap {
  position: relative;
  flex-shrink: 0;
  transition: opacity var(--dur-fast) var(--ease-refined);
}

.contact-wrap--pressed {
  opacity: 0.6;
}

.contact-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  background: transparent;
  border: none;
  margin: 0;
  padding: 0;
  line-height: normal;
}

.contact-overlay::after {
  border: none;
}

.bar-action-icon-img {
  width: 40rpx;
  height: 40rpx;
}

.bar-action-text {
  font-size: 18rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.02em;
  font-family: var(--font-sans);
}

.price-info {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  overflow: hidden;
}

.action-row {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.bottom-left {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.price-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 0.02em;
  font-family: var(--font-sans);
  line-height: 1.2;
}

.price-symbol {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--lux-gold-ink);
  font-family: var(--font-serif);
  line-height: 1.2;
}

.price-value {
  font-size: 48rpx;
  font-weight: 600;
  color: var(--lux-gold-ink);
  letter-spacing: 0.02em;
  font-family: var(--font-serif);
  line-height: 1.2;
}

.coupon-sub {
  font-size: 22rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.02em;
  font-family: var(--font-sans);
}

.confirm-btn {
  flex: 1;
  padding: 20rpx 0;
  background: var(--lux-green-grad);
  border-radius: 999rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-on-primary);
  letter-spacing: 0.06em;
  box-shadow: var(--lux-shadow-green);
  border: none;
  margin: 0;
  line-height: 1;
  transition: transform var(--transition-fast), opacity var(--transition-fast);
  font-family: var(--font-serif);
}

.confirm-btn--pressed {
  transform: scale(0.98);
  opacity: 0.9;
}

.confirm-btn::after {
  border: none;
}

.confirm-btn-disabled {
  opacity: 0.6;
  pointer-events: none;
}

.content-bottom-space {
  height: 140rpx;
}

.loading-dot:nth-child(2) {
}

.loading-dot:nth-child(3) {
}

/* ===== 服务选择弹窗 ===== */
.gallery-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  display: flex;
  align-items: flex-end;
}

.gallery-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--overlay-color, rgba(26,26,23,0.5));
}

.gallery-sheet {
  position: relative;
  width: 100%;
  max-height: 85vh;
  background: var(--zy-paper-fallback);
  border-radius: var(--zy-radius-2xl) var(--zy-radius-2xl) 0 0;
  padding: 40rpx var(--zy-space-lg) 48rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.gallery-sheet-body {
  /* Skyline: view 元素自然流动，由父容器 .gallery-sheet 的 max-height 约束整体高度 */
}

.gallery-sheet-close {
  position: absolute;
  top: 32rpx;
  right: var(--zy-space-lg);
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.close-icon {
  font-size: 40rpx;
  color: var(--text-tertiary);
  font-weight: 300;
  line-height: 1;
  font-family: var(--font-sans);
}

.gallery-sheet-header {
  margin-bottom: 32rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid rgba(26, 26, 23, 0.14);
  padding-right: 72rpx;
}

.gallery-sheet-header.center-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 8rpx;
  padding-right: 72rpx;
}

.gallery-sheet-title {
  font-size: 34rpx;
  font-weight: 500;
  color: var(--text-primary);
  display: block;
  margin-bottom: 8rpx;
  letter-spacing: 0.04em;
  font-family: var(--font-serif);
  text-align: center;
}

.gallery-sheet-subtitle {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.5;
  display: block;
  letter-spacing: 0.02em;
  font-family: var(--font-sans);
  text-align: center;
}

.gallery-options {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.gallery-option {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-radius: 0;
  border: none;
  border-bottom: 1rpx solid rgba(26, 26, 23, 0.14);
  background: transparent;
  position: relative;
  transition: transform var(--transition-fast), opacity var(--transition-fast);
}

.gallery-option--pressed {
  transform: scale(0.98);
  opacity: 0.9;
}

.gallery-option-selected {
  border-left: 3rpx solid var(--lux-gold-ink);
  background: rgba(122, 95, 42, 0.04);
}

.gallery-option-icon {
  font-size: 40rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--zy-radius-md);
  flex-shrink: 0;
  margin-right: 20rpx;
}

.gallery-option-selected .gallery-option-icon {
  background: rgba(74,107,74,0.1);
}

.gallery-option-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.gallery-option-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.02em;
  font-family: var(--font-sans);
}

.gallery-option-desc {
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.4;
  letter-spacing: 0.02em;
  font-family: var(--font-sans);
}

.gallery-option-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--lux-gold-ink);
  color: var(--zy-paper-fallback);
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.gallery-sheet-footer {
  display: flex;
  justify-content: center;
  padding-top: 8rpx;
}

.gallery-confirm-btn {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-on-primary);
  background: var(--lux-green-grad);
  border-radius: 999rpx;
  letter-spacing: 0.06em;
  box-shadow: var(--lux-shadow-green);
  border: none;
  padding: 0;
  margin: 0;
  transition: transform var(--transition-fast), opacity var(--transition-fast);
  font-family: var(--font-serif);
}

.gallery-confirm-btn--pressed {
  transform: scale(0.98);
  opacity: 0.9;
}

.gallery-confirm-btn::after {
  border: none;
}

/* ===== 日期选择器 ===== */
.picker-date-scroll {
  margin-bottom: 24rpx;
  white-space: nowrap;
  /* Skyline: scroll-view 是原生组件，不会自动撑开高度，需显式设置 */
  height: 140rpx;
}

.picker-date-list {
  display: flex;
  gap: 20rpx;
  padding: 8rpx 4rpx;
}

.picker-date-pill {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 120rpx;
  height: 120rpx;
  padding: 16rpx 24rpx;
  border-radius: var(--zy-radius-lg);
  background: transparent;
  border: 1rpx solid rgba(26, 26, 23, 0.14);
  position: relative;
  transition: transform var(--transition-fast), opacity var(--transition-fast);
}

.picker-date-pill--pressed {
  transform: scale(0.96);
  opacity: 0.85;
}

.picker-date-pill-active {
  background: transparent;
  border-color: var(--lux-gold-ink);
  box-shadow: inset 0 0 0 1rpx rgba(122, 95, 42, 0.25);
}

.picker-date-pill-text {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  line-height: 1.2;
  letter-spacing: 0.02em;
  font-family: var(--font-sans);
}

.picker-date-pill-count {
  font-size: 20rpx;
  color: var(--feeding-primary);
  font-weight: 500;
  margin-top: 4rpx;
  font-family: var(--font-sans);
}

/* ===== 时间数量步进器 ===== */
.picker-stepper-row {
  display: flex;
  align-items: center;
  padding: 32rpx 0;
  margin-bottom: 24rpx;
  background: transparent;
  border-top: 1rpx solid rgba(26, 26, 23, 0.14);
  border-bottom: 1rpx solid rgba(26, 26, 23, 0.14);
}

.picker-stepper-label {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  flex-shrink: 0;
  letter-spacing: 0.02em;
  font-family: var(--font-sans);
  margin-right: 24rpx;
}

.picker-stepper-bar {
  display: flex;
  align-items: center;
  margin-left: auto;
}

.picker-stepper-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition-property: transform, opacity;
  transition-duration: 160ms;
  transition-timing-function: cubic-bezier(0.25, 0.1, 0.25, 1);
}

.picker-stepper-btn-text {
  font-size: 40rpx;
  font-weight: 300;
  line-height: 1;
  font-family: var(--font-sans);
}

.picker-stepper-btn--pressed {
  transform: scale(0.92);
  opacity: 0.85;
}

.picker-stepper-minus {
  background: var(--background-color, #F7F5EF);
  color: var(--text-secondary);
  border: 1rpx solid rgba(26, 26, 23, 0.14);
}

.picker-stepper-plus {
  background: var(--lux-green-grad);
  color: var(--text-on-primary);
  box-shadow: var(--lux-shadow-green);
}

.picker-stepper-disabled {
  opacity: 0.35;
  pointer-events: none;
}

.picker-stepper-value {
  font-size: 44rpx;
  font-weight: 500;
  color: var(--text-primary);
  min-width: 80rpx;
  text-align: center;
  font-family: var(--font-sans);
  margin: 0 24rpx;
}

.picker-stepper-unit {
  font-size: 28rpx;
  color: var(--text-secondary);
  font-weight: 400;
  flex-shrink: 0;
  letter-spacing: 0.02em;
  font-family: var(--font-sans);
  margin-left: 16rpx;
}

.picker-stepper-price {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 8rpx;
  margin-bottom: 32rpx;
  padding: 20rpx 0;
}

.picker-stepper-price-label {
  font-size: 26rpx;
  color: var(--text-tertiary);
  font-weight: 400;
  font-family: var(--font-sans);
  letter-spacing: 0.04em;
}

.picker-stepper-price-text {
  font-size: 36rpx;
  color: var(--feeding-primary);
  font-weight: 600;
  letter-spacing: 0.02em;
  font-family: var(--font-sans);
}

.picker-stepper-price-unit {
  font-size: 26rpx;
  color: var(--text-tertiary);
  font-weight: 400;
  font-family: var(--font-sans);
}

/* ===== 支付弹窗 ===== */
.payment-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--overlay-color, rgba(26,26,23,0.5));
}

.modal-content {
  position: relative;
  width: 580rpx;
  background: var(--card-color);
  border-radius: var(--zy-radius-2xl);
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 1rpx solid rgba(26, 26, 23, 0.14);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 32rpx;
  letter-spacing: 0.04em;
  font-family: var(--font-serif);
}

.modal-total {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 40rpx;
}

.final-price {
  font-size: 40rpx;
  font-weight: 500;
  color: var(--feeding-primary);
  font-family: var(--font-serif);
}

.pay-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-on-primary);
  background: var(--lux-green-grad);
  border-radius: var(--zy-radius-lg);
  margin-bottom: 24rpx;
  text-align: center;
  padding: 0;
  border: none;
  letter-spacing: 0.06em;
  box-shadow: var(--lux-shadow-green);
  transition: transform var(--transition-fast), opacity var(--transition-fast);
  font-family: var(--font-serif);
}

.pay-btn--pressed {
  transform: scale(0.98);
  opacity: 0.9;
}

.pay-btn::after {
  border: none;
}

.cancel-btn {
  font-size: 26rpx;
  color: var(--text-secondary);
  padding: 16rpx;
  letter-spacing: 0.02em;
  font-family: var(--font-sans);
}
