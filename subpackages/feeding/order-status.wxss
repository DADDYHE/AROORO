/* 上门喂养 · 订单状态页样式
   设计系统：AROORO Haute-Luxury v2
   token 来源：styles/variables.wxss → styles/design-tokens.wxss → styles/theme-teal.wxss（app.wxss 按序注入）
   P1-B 改造：清除 Material 蓝系、Ant 红、冷调蓝灰等外来色硬编码，
             统一为森林绿 + 香槟金 + 奶油中性语义 token。
   UI 统一改造：状态横幅 / 内容卡片 / 底部操作栏交予共享组件（order-status-banner /
             order-card / order-action-bar），本页仅保留卡片内部内容行样式。 */

@import '../../styles/loading-animation.wxss';

.page-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  opacity: 0;
  animation: zy-fade-in 420ms cubic-bezier(0.19, 1, 0.22, 1) forwards;
}

.page-content {
  flex: 1;
  padding: 0 0 24rpx;
  position: relative;
  z-index: 1;
  padding-bottom: 60rpx;
  opacity: 0;
  animation: zy-fade-in-up 480ms cubic-bezier(0.16, 1, 0.3, 1) 80ms forwards;
}

/* ===== 内容行（order-card 插槽内使用，横向留白交给 order-card 的 32rpx padding） ===== */
.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--divider-color);
}

.info-item:last-child {
  border-bottom: none;
}

.info-item .label {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  flex-shrink: 0;
}

.info-item .value {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 400;
  text-align: right;
  max-width: 460rpx;
}

.address-display {
  flex-direction: row;
  align-items: flex-start;
}

.service-date-display {
  flex-direction: row;
  align-items: flex-start;
}

.service-date-value {
  overflow-wrap: break-word;
  word-break: break-all;
  line-height: 1.5;
}

.address-text {
  overflow-wrap: break-word;
  word-break: break-all;
  line-height: 1.5;
}

.notes-display {
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
}

/* 备注底：原冷调蓝灰硬编码 → 奶油中性面 */
.notes-text {
  width: 100%;
  text-align: left;
  background: var(--surface-tint);
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  line-height: 1.6;
  max-width: 100%;
  overflow-wrap: break-word;
  word-break: break-all;
}

.order-no {
  font-size: 24rpx;
  color: var(--gray-500);
  font-weight: 400;
}

.brand-item {
  background: linear-gradient(135deg, var(--activity-tint) 0%, transparent 100%);
  border-bottom: 1rpx solid var(--lux-hairline-green);
}

.brand-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--activity-primary);
  flex-shrink: 0;
}

.brand-value {
  font-size: 26rpx;
  color: var(--activity-primary);
  font-weight: 500;
}

.pet-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--divider-color);
}

.pet-item:last-child {
  border-bottom: none;
}

.pet-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.avatar-container {
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
  overflow: hidden;
  flex-shrink: 0;
  border: 1rpx solid var(--gray-200);
  margin-right: 24rpx;
}

.pet-image {
  width: 100%;
  height: 100%;
  display: block;
}

.pet-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.pet-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.2;
}

.pet-details {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.pet-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
  margin-left: 24rpx;
}

.pet-service-tags {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 8rpx;
}

/* 服务标签底：原 Material 蓝洗底 → 喂养板块绿洗底 */
.service-tag {
  font-size: 20rpx;
  color: var(--feeding-primary);
  background: var(--feeding-tint);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-weight: 500;
  white-space: nowrap;
}

.walk-tag {
  color: var(--activity-primary);
  background: var(--activity-tint);
}

.pet-service-dates {
  font-size: 20rpx;
  color: var(--gray-500);
  line-height: 1.5;
  text-align: right;
  overflow-wrap: break-word;
  word-break: break-all;
  display: block;
  overflow: hidden;
}

.empty-tip {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 60rpx 0;
  color: var(--gray-500);
  font-size: 26rpx;
  border-radius: 16rpx;
  margin: 24rpx 0 32rpx;
}

.price-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--divider-color);
}

.price-item:last-child {
  border-bottom: none;
}

.price-item .label {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.price-item .value {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 500;
}

/* 合计行：原 Material 蓝洗底 → 喂养板块绿洗底 + 绿发丝描边 */
.price-item.total {
  background: linear-gradient(135deg, var(--feeding-tint) 0%, transparent 100%);
  border-radius: 16rpx;
  margin: 12rpx 0 20rpx;
  padding: 28rpx 24rpx;
  border: 1rpx solid var(--lux-hairline-green);
}

.price-item.total .label {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 600;
}

.price-item.total .value {
  font-size: 36rpx;
  color: var(--feeding-primary);
  font-weight: 700;
}

.price-pet-group {
  padding-bottom: 8rpx;
}

.price-sub-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0 8rpx 48rpx;
}

.sub-label {
  font-size: 24rpx;
  color: var(--gray-500);
}

.sub-value {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 优惠金额：原 Ant 红硬编码 → 品牌陶土暖红 */
.sub-value.discount {
  color: var(--brand-red);
}

.paid-status {
  color: var(--activity-primary);
  font-weight: 600;
}

.unpaid-status {
  color: var(--text-primary);  /* B′ 金在浅底不作文字色：原 --warning-color → 炭墨（与 paid 深绿区分） */
  font-weight: 600;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
}

.empty-icon {
  animation: zy-breathe-glow 4000ms ease-in-out infinite;
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--gray-500);
  margin-bottom: 40rpx;
}

/* 重试按钮：原 绿→Material 蓝 → 喂养绿→深森林绿 */
.retry-btn {
  transition: transform 160ms ease, opacity 160ms ease;
  padding: 20rpx 64rpx;
  background: linear-gradient(135deg, var(--feeding-primary) 0%, var(--primary-color) 100%);
  border-radius: var(--zy-radius-lg);
  color: var(--text-on-primary);
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}
/* ── 微交互：按压态（hover-class 复用，详见 app.wxss 约定）── */
.retry-btn--pressed { transform: scale(0.97); opacity: 0.92; }
