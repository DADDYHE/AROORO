@import '../../styles/loading-animation.wxss';

.page-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--background-color);
  position: relative;
}

.gallery-header {
  padding: 0;
  position: relative;
  overflow: hidden;
  background: var(--card-color);
  animation: fadeUp 0.6s ease-out;
  padding-bottom: 20rpx;
}

.brand-block {
  padding: 80rpx 48rpx 64rpx;
  position: relative;
}

.brand-block::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, rgba(33, 150, 243, 0.12) 0%, transparent 70%);
  pointer-events: none;
}

.brand-accent-bar {
  position: absolute;
  top: 0;
  left: 48rpx;
  width: 48rpx;
  height: 6rpx;
  background: linear-gradient(90deg, var(--feeding-primary) 0%, #1976D2 100%);
  border-radius: 0 0 4rpx 4rpx;
  animation: slideDown 0.5s ease-out;
}

.brand-main {
  position: relative;
  margin-bottom: 24rpx;
}

.brand-text {
  font-size: 64rpx;
  font-weight: 300;
  color: var(--text-primary);
  letter-spacing: 12rpx;
  display: block;
  line-height: 1;
  position: relative;
}

.brand-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.brand-meta-line {
  width: 40rpx;
  height: 2rpx;
  background: var(--gray-200);
  position: relative;
}

.brand-meta-line::after {
  content: '';
  position: absolute;
  top: 50%;
  right: -4rpx;
  transform: translateY(-50%);
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: var(--feeding-primary);
}

.brand-subtitle {
  font-size: 22rpx;
  color: var(--text-secondary);
  letter-spacing: 8rpx;
  font-weight: 400;
}

.page-content {
  flex: 1;
  padding: 0 32rpx 24rpx;
  position: relative;
  z-index: 1;
  padding-bottom: 60rpx;
}

.status-card {
  display: flex;
  align-items: center;
  background: var(--card-color);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(134, 134, 139, 0.1);
  position: relative;
  overflow: hidden;
  animation: sectionSlideIn 0.5s ease-out both;
}

.status-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: linear-gradient(90deg, var(--activity-primary) 0%, var(--activity-secondary) 50%, transparent 100%);
  border-radius: 24rpx 24rpx 0 0;
}

.status-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(78, 205, 196, 0.1) 0%, rgba(38, 166, 154, 0.05) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 28rpx;
  flex-shrink: 0;
}

.status-icon {
  font-size: 48rpx;
}

.status-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.status-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.status-subtitle {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.info-card {
  background: var(--card-color);
  border-radius: 24rpx;
  padding: 0;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(134, 134, 139, 0.1);
  position: relative;
  overflow: hidden;
  animation: sectionSlideIn 0.5s ease-out both;
}

.info-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: linear-gradient(90deg, var(--feeding-primary) 0%, #1976D2 50%, transparent 100%);
  border-radius: 24rpx 24rpx 0 0;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx 20rpx;
  border-bottom: 1rpx solid var(--divider-color);
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--divider-color);
}

.info-item:last-child {
  border-bottom: none;
}

.info-item .label {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  flex-shrink: 0;
}

.info-item .value {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 400;
  text-align: right;
  max-width: 460rpx;
}

.address-display {
  flex-direction: row;
  align-items: flex-start;
}

.service-date-display {
  flex-direction: row;
  align-items: flex-start;
}

.service-date-value {
  word-wrap: break-word;
  word-break: break-all;
  line-height: 1.5;
}

.address-text {
  word-wrap: break-word;
  word-break: break-all;
  line-height: 1.5;
}

.notes-display {
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
}

.notes-text {
  width: 100%;
  text-align: left;
  background: #F5F7FA;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  line-height: 1.6;
  max-width: 100%;
  word-wrap: break-word;
  word-break: break-all;
}

.order-no {
  font-size: 24rpx;
  color: var(--gray-500);
  font-weight: 400;
}

.brand-item {
  background: linear-gradient(135deg, rgba(78, 205, 196, 0.06) 0%, rgba(38, 166, 154, 0.03) 100%);
  border-bottom: 1rpx solid rgba(78, 205, 196, 0.12);
}

.brand-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--activity-primary);
  flex-shrink: 0;
}

.brand-value {
  font-size: 26rpx;
  color: var(--activity-primary);
  font-weight: 500;
}

.pet-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--divider-color);
}

.pet-item:last-child {
  border-bottom: none;
}

.pet-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.avatar-container {
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
  overflow: hidden;
  flex-shrink: 0;
  border: 1rpx solid var(--gray-200);
  background-color: var(--background-color);
  margin-right: 24rpx;
}

.pet-image {
  width: 100%;
  height: 100%;
  display: block;
}

.pet-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.pet-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.2;
}

.pet-details {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.pet-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
  margin-left: 24rpx;
}

.pet-service-tags {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 8rpx;
}

.service-tag {
  font-size: 20rpx;
  color: var(--feeding-primary);
  background: rgba(33, 150, 243, 0.06);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-weight: 500;
  white-space: nowrap;
}

.walk-tag {
  color: var(--activity-primary);
  background: rgba(78, 205, 196, 0.06);
}

.pet-service-dates {
  font-size: 20rpx;
  color: var(--gray-500);
  line-height: 1.5;
  text-align: right;
  word-wrap: break-word;
  word-break: break-all;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.empty-tip {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 60rpx 32rpx;
  color: var(--gray-500);
  font-size: 26rpx;
  background-color: var(--background-color);
  border-radius: 16rpx;
  margin: 24rpx 32rpx 32rpx;
}

.price-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid var(--divider-color);
}

.price-item:last-child {
  border-bottom: none;
}

.price-item .label {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.price-item .value {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.price-item.total {
  background: linear-gradient(135deg, rgba(33, 150, 243, 0.04) 0%, rgba(25, 118, 210, 0.02) 100%);
  border-radius: 16rpx;
  margin: 12rpx 32rpx 20rpx;
  padding: 28rpx 32rpx;
  border: 1rpx solid rgba(33, 150, 243, 0.1);
}

.price-item.total .label {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 600;
}

.price-item.total .value {
  font-size: 36rpx;
  color: var(--feeding-primary);
  font-weight: 700;
}

.price-pet-group {
  padding-bottom: 8rpx;
}

.price-sub-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 32rpx 8rpx 48rpx;
}

.sub-label {
  font-size: 24rpx;
  color: var(--gray-500);
}

.sub-value {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.sub-value.discount {
  color: #ff4d4f;
}

.paid-status {
  color: var(--activity-primary);
  font-weight: 600;
}

.unpaid-status {
  color: var(--warning-color);
  font-weight: 600;
}

.action-area {
  display: flex;
  justify-content: center;
  margin-top: 40rpx;
  padding-bottom: 40rpx;
}

.action-btn {
  padding: 24rpx 80rpx;
  border-radius: 48rpx;
  font-size: 30rpx;
}

.cancel-btn {
  background: var(--card-color);
  color: var(--text-secondary);
  border: 2rpx solid var(--gray-200);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.cancel-btn:active {
  background: var(--background-color);
}

.pay-btn {
  background: linear-gradient(135deg, var(--activity-primary) 0%, var(--activity-secondary) 100%);
  color: var(--card-color);
  border: none;
  box-shadow: 0 6rpx 16rpx rgba(78, 205, 196, 0.35);
  font-weight: 600;
  letter-spacing: 2rpx;
}

.pay-btn:active {
  transform: scale(0.98);
}

.pay-btn-disabled {
  opacity: 0.6;
  pointer-events: none;
}

.loading-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.loading-dot:nth-child(3) {
  animation-delay: 0.4s;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--gray-500);
  margin-bottom: 40rpx;
}

.retry-btn {
  padding: 20rpx 64rpx;
  background: linear-gradient(135deg, var(--feeding-primary) 0%, #1976D2 100%);
  border-radius: 48rpx;
  color: var(--card-color);
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.content-bottom-space {
  height: 60rpx;
}

@keyframes sectionSlideIn {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}
