/* 上门喂养 · 订单状态页样式
   设计系统：AROORO Haute-Luxury v2
   token 来源：styles/variables.wxss → styles/design-tokens.wxss → styles/theme-teal.wxss（app.wxss 按序注入）
   P1-B 改造：清除 Material 蓝系、Ant 红、冷调蓝灰等外来色硬编码，
             统一为森林绿 + 香槟金 + 奶油中性语义 token */

@import '../../styles/loading-animation.wxss';

.page-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
}

.gallery-header {
  padding: 0;
  position: relative;
  overflow: hidden;
  background: var(--card-color);
  padding-bottom: 20rpx;
}

.brand-block {
  padding: 80rpx 48rpx 64rpx;
  position: relative;
}

.brand-block::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, var(--feeding-tint) 0%, transparent 70%);
  pointer-events: none;
}

/* 品牌装饰条：原 绿→Material 蓝 → 绿→香槟金（点缀金，<5% 面积） */
.brand-accent-bar {
  position: absolute;
  top: 0;
  left: 48rpx;
  width: 48rpx;
  height: 6rpx;
  background: linear-gradient(90deg, var(--feeding-primary) 0%, var(--accent-color) 100%);
  border-radius: 0 0 4rpx 4rpx;
}

.brand-main {
  position: relative;
  margin-bottom: 24rpx;
}

.brand-text {
  font-size: 64rpx;
  font-weight: 300;
  color: var(--text-primary);
  letter-spacing: 12rpx;
  display: block;
  line-height: 1;
  position: relative;
}

.brand-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.brand-meta-line {
  width: 40rpx;
  height: 2rpx;
  background: var(--gray-200);
  position: relative;
}

.brand-meta-line::after {
  content: '';
  position: absolute;
  top: 50%;
  right: -4rpx;
  transform: translateY(-50%);
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: var(--feeding-primary);
}

.brand-subtitle {
  font-size: 22rpx;
  color: var(--text-secondary);
  letter-spacing: 8rpx;
  font-weight: 400;
}

.page-content {
  flex: 1;
  padding: 0 32rpx 24rpx;
  position: relative;
  z-index: 1;
  padding-bottom: 60rpx;
}

.status-card {
  display: flex;
  align-items: center;
  background: var(--card-color);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--lux-shadow-card);
  border: 1rpx solid var(--hairline);
  position: relative;
  overflow: hidden;
}

.status-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: linear-gradient(90deg, var(--activity-primary) 0%, var(--activity-secondary) 50%, transparent 100%);
  border-radius: 24rpx 24rpx 0 0;
}

.status-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, var(--activity-tint) 0%, var(--primary-tint) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 28rpx;
  flex-shrink: 0;
}

/* 支付倒计时（待支付订单，与后端 ORDER_TIMEOUT_MINUTES=30 超时取消对齐）
   保留金色：属 warning/紧迫语义，B′「浅底金文字→深绿」规则对 warning 语义豁免；
   取 --accent-deep 而非 --accent-color，保证白卡上的对比度。 */
.pay-countdown {
  margin-top: 10rpx;
  display: flex;
  align-items: baseline;
  font-size: 24rpx;
  color: var(--accent-deep);
}

.pay-countdown-label {
  opacity: 0.85;
  margin-right: 10rpx;
  letter-spacing: 0.04em;
}

.pay-countdown-time {
  font-weight: 600;
  font-size: 34rpx;
  font-variant-numeric: tabular-nums;
  letter-spacing: 1rpx;
}

.status-icon {
  font-size: 48rpx;
}

.status-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.status-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.status-subtitle {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.info-card {
  background: var(--card-color);
  border-radius: 24rpx;
  padding: 0;
  margin-bottom: 24rpx;
  box-shadow: var(--lux-shadow-card);
  border: 1rpx solid var(--hairline);
  position: relative;
  overflow: hidden;
}

/* 卡片顶饰线：原 绿→Material 蓝 → 绿→香槟金 */
.info-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: linear-gradient(90deg, var(--feeding-primary) 0%, var(--accent-color) 50%, transparent 100%);
  border-radius: 24rpx 24rpx 0 0;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx 20rpx;
  border-bottom: 1rpx solid var(--divider-color);
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--divider-color);
}

.info-item:last-child {
  border-bottom: none;
}

.info-item .label {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  flex-shrink: 0;
}

.info-item .value {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 400;
  text-align: right;
  max-width: 460rpx;
}

.address-display {
  flex-direction: row;
  align-items: flex-start;
}

.service-date-display {
  flex-direction: row;
  align-items: flex-start;
}

.service-date-value {
  overflow-wrap: break-word;
  word-break: break-all;
  line-height: 1.5;
}

.address-text {
  overflow-wrap: break-word;
  word-break: break-all;
  line-height: 1.5;
}

.notes-display {
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
}

/* 备注底：原冷调蓝灰硬编码 → 奶油中性面 */
.notes-text {
  width: 100%;
  text-align: left;
  background: var(--surface-tint);
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  line-height: 1.6;
  max-width: 100%;
  overflow-wrap: break-word;
  word-break: break-all;
}

.order-no {
  font-size: 24rpx;
  color: var(--gray-500);
  font-weight: 400;
}

.brand-item {
  background: linear-gradient(135deg, var(--activity-tint) 0%, transparent 100%);
  border-bottom: 1rpx solid var(--lux-hairline-green);
}

.brand-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--activity-primary);
  flex-shrink: 0;
}

.brand-value {
  font-size: 26rpx;
  color: var(--activity-primary);
  font-weight: 500;
}

.pet-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--divider-color);
}

.pet-item:last-child {
  border-bottom: none;
}

.pet-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.avatar-container {
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
  overflow: hidden;
  flex-shrink: 0;
  border: 1rpx solid var(--gray-200);
  margin-right: 24rpx;
}

.pet-image {
  width: 100%;
  height: 100%;
  display: block;
}

.pet-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.pet-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.2;
}

.pet-details {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.pet-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
  margin-left: 24rpx;
}

.pet-service-tags {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 8rpx;
}

/* 服务标签底：原 Material 蓝洗底 → 喂养板块绿洗底 */
.service-tag {
  font-size: 20rpx;
  color: var(--feeding-primary);
  background: var(--feeding-tint);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-weight: 500;
  white-space: nowrap;
}

.walk-tag {
  color: var(--activity-primary);
  background: var(--activity-tint);
}

.pet-service-dates {
  font-size: 20rpx;
  color: var(--gray-500);
  line-height: 1.5;
  text-align: right;
  overflow-wrap: break-word;
  word-break: break-all;
  display: block;
  overflow: hidden;
}

.empty-tip {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 60rpx 32rpx;
  color: var(--gray-500);
  font-size: 26rpx;
  border-radius: 16rpx;
  margin: 24rpx 32rpx 32rpx;
}

.price-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid var(--divider-color);
}

.price-item:last-child {
  border-bottom: none;
}

.price-item .label {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.price-item .value {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 500;
}

/* 合计行：原 Material 蓝洗底 → 喂养板块绿洗底 + 绿发丝描边 */
.price-item.total {
  background: linear-gradient(135deg, var(--feeding-tint) 0%, transparent 100%);
  border-radius: 16rpx;
  margin: 12rpx 32rpx 20rpx;
  padding: 28rpx 32rpx;
  border: 1rpx solid var(--lux-hairline-green);
}

.price-item.total .label {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 600;
}

.price-item.total .value {
  font-size: 36rpx;
  color: var(--feeding-primary);
  font-weight: 700;
}

.price-pet-group {
  padding-bottom: 8rpx;
}

.price-sub-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 32rpx 8rpx 48rpx;
}

.sub-label {
  font-size: 24rpx;
  color: var(--gray-500);
}

.sub-value {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 优惠金额：原 Ant 红硬编码 → 品牌陶土暖红 */
.sub-value.discount {
  color: var(--brand-red);
}

.paid-status {
  color: var(--activity-primary);
  font-weight: 600;
}

.unpaid-status {
  color: var(--text-primary);  /* B′ 金在浅底不作文字色：原 --warning-color → 炭墨（与 paid 深绿区分） */
  font-weight: 600;
}

.action-area {
  display: flex;
  justify-content: center;
  margin-top: 40rpx;
  padding-bottom: 40rpx;
}

.action-btn {
  padding: 24rpx 80rpx;
  border-radius: var(--zy-radius-lg);
  font-size: 30rpx;
}

.cancel-btn {
  background: var(--card-color);
  color: var(--text-secondary);
  border: 2rpx solid var(--gray-200);
  box-shadow: var(--shadow-md);
}

.pay-btn {
  background: linear-gradient(135deg, var(--activity-primary) 0%, var(--activity-secondary) 100%);
  color: var(--text-on-primary);
  border: none;
  box-shadow: var(--shadow-glow-primary-btn);
  font-weight: 600;
  letter-spacing: 2rpx;
}

.pay-btn-disabled {
  opacity: 0.6;
  pointer-events: none;
}

.loading-dot:nth-child(2) {
}

.loading-dot:nth-child(3) {
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--gray-500);
  margin-bottom: 40rpx;
}

/* 重试按钮：原 绿→Material 蓝 → 喂养绿→深森林绿 */
.retry-btn {
  padding: 20rpx 64rpx;
  background: linear-gradient(135deg, var(--feeding-primary) 0%, var(--primary-color) 100%);
  border-radius: var(--zy-radius-lg);
  color: var(--text-on-primary);
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.content-bottom-space {
  height: 60rpx;
}
