<view class="page-container" wx:if="{{feeder}}">
  <!-- 顶部图片区 -->
  <view class="hero-section">
    <image class="hero-image" src="{{feeder.avatarUrl || '/images/default-avatar.svg'}}" mode="aspectFill" binderror="onCloudImageError" data-src="{{feeder.avatarUrl}}" data-path="feeder.avatarUrl" />
    <view class="hero-gradient"></view>
  </view>

  <!-- 内容区 -->
  <view class="content-section">
    <!-- 基本信息 -->
    <view class="info-card">
      <view class="info-header">
        <view class="name-section">
          <text class="feeder-name">{{feeder.displayName}}</text>
          <view class="meta-row">
            <text class="meta-item" wx:if="{{feeder.gender}}">{{feeder.gender}}</text>
            <text class="meta-item" wx:if="{{feeder.experience}}">{{feeder.experience}}年经验</text>
          </view>
        </view>
        <view class="price-section">
          <text class="price-number">{{feeder.priceText}}</text>
          <text class="price-unit-large">/次</text>
        </view>
      </view>

      <!-- 服务区域 -->
      <view class="address-section" wx:if="{{feeder.address}}">
        <text class="section-label">服务区域</text>
        <text class="address-text">{{feeder.address}}</text>
      </view>
    </view>

    <!-- 服务标签 -->
    <view class="info-card" wx:if="{{feeder.serviceTags && feeder.serviceTags.length > 0}}">
      <text class="section-label">服务项目</text>
      <view class="tag-list">
        <text wx:for="{{feeder.serviceTags}}" wx:key="*this" class="tag-item">{{item}}</text>
      </view>
    </view>

    <!-- 可美容品种 -->
    <view class="info-card" wx:if="{{source === 'beauty' && feeder.beautyBreeds}}">
      <text class="section-label">可美容品种</text>
      <text class="desc-text">{{feeder.beautyBreeds}}</text>
    </view>

    <!-- 服务介绍 -->
    <view class="info-card" wx:if="{{feeder.description}}">
      <text class="section-label">服务介绍</text>
      <text class="desc-text">{{feeder.description}}</text>
    </view>

    <!-- 联系电话 -->
    <view class="info-card" wx:if="{{feeder.phone}}">
      <text class="section-label">联系电话</text>
      <view class="phone-row">
        <text class="phone-text">{{feeder.phone}}</text>
        <button class="phone-btn" open-type="makePhoneCall" phoneNumber="{{feeder.phone}}">拨打</button>
      </view>
    </view>

    <!-- 底部占位 -->
    <view class="bottom-placeholder"></view>
  </view>

  <!-- 底部按钮 -->
  <view class="footer-bar">
    <button class="btn-book" catchtap="onBookService">立即预约</button>
  </view>
</view>

<!-- 加载中 -->
<view class="page-container" wx:if="{{isLoading}}">
  <view class="loading-state">
    <view class="loading-dots">
      <view class="dot"></view>
      <view class="dot"></view>
      <view class="dot"></view>
    </view>
    <text class="loading-text">加载中...</text>
  </view>
</view>
