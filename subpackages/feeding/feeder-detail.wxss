@import '../../styles/loading-animation.wxss';

.page-container {
  min-height: 100vh;
  background: #f5f5f7;
  padding-bottom: 160rpx;
}

/* 顶部图片区 */
.hero-section {
  position: relative;
  width: 100%;
  aspect-ratio: 3 / 4;
  overflow: hidden;
}

.hero-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.hero-gradient {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 200rpx;
  background: linear-gradient(to top, #f5f5f7 0%, transparent 100%);
}

/* 内容区 */
.content-section {
  padding: 0 32rpx;
  margin-top: -40rpx;
  position: relative;
  z-index: 1;
}

/* 信息卡片 */
.info-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

/* 信息头部 */
.info-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.name-section {
  flex: 1;
}

.feeder-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #1D1D1F;
  display: block;
  margin-bottom: 8rpx;
}

.meta-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.meta-item {
  font-size: 24rpx;
  color: #86868B;
  background: #F5F5F7;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.price-section {
  text-align: right;
  flex-shrink: 0;
}

.price-number {
  font-size: 36rpx;
  font-weight: 700;
  color: #4ECDC4;
}

.price-unit-large {
  font-size: 22rpx;
  color: #4ECDC4;
  font-weight: 500;
}

/* 服务区域 */
.address-section {
  padding-top: 20rpx;
  border-top: 1rpx solid #F0F0F0;
}

.address-text {
  font-size: 28rpx;
  color: #1D1D1F;
  display: block;
  margin-top: 8rpx;
}

/* 通用标签 */
.section-label {
  font-size: 24rpx;
  color: #86868B;
  font-weight: 500;
  display: block;
  margin-bottom: 16rpx;
}

/* 标签列表 */
.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag-item {
  font-size: 24rpx;
  color: #2D8A84;
  background: linear-gradient(135deg, #E8FAF8 0%, #F0FAF9 100%);
  border: 1rpx solid rgba(78, 205, 196, 0.3);
  padding: 12rpx 20rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

/* 服务描述 */
.desc-text {
  font-size: 28rpx;
  color: #1D1D1F;
  line-height: 1.6;
  display: block;
}

/* 联系电话 */
.phone-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.phone-text {
  font-size: 28rpx;
  color: #1D1D1F;
}

.phone-btn {
  background: linear-gradient(135deg, #4ECDC4 0%, #44B5AD 100%);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
  padding: 12rpx 28rpx;
  border-radius: 16rpx;
  border: none;
  margin: 0;
}

/* 底部占位 */
.bottom-placeholder {
  height: 40rpx;
}

/* 底部按钮 */
.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.04);
  padding: 5rpx 32rpx;
  padding-bottom: calc(5rpx + env(safe-area-inset-bottom));
  z-index: 10;
}

.btn-book {
  background: linear-gradient(135deg, #4ECDC4 0%, #44B5AD 100%);
  color: #FFFFFF;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(78, 205, 196, 0.3);
  width: 100%;
}

.btn-book:active {
  transform: scale(0.98);
}

/* 加载状态 */

.loading-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.loading-dot:nth-child(3) {
  animation-delay: 0.4s;
}
