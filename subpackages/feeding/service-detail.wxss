/* ================================================================
   subpackages/feeding/service-detail · AROORO 服务详情
   Haute-Luxury Editorial · Gallery Exhibition Aesthetic
   ----------------------------------------------------------------
   设计参考：Hermès / Dior / The Row 服务手册级排版
   板块色：鼠尾草绿 --feeding-primary + 香槟金 --accent-color 点缀
   Skyline 兼容：无 :active / sticky / clip-path / backdrop-filter
   ================================================================ */

/* ===== 页面容器 ===== */
.page {
  padding-bottom: calc(80rpx + env(safe-area-inset-bottom));
}

/* ---------- 顶部品牌区域 ----------
   gallery-header/brand-* 旧深绿沉浸版已由全局 .lux-hero（styles/lux-page.wxss）替代（2026-09-09 A+B 升级）。 */

/* ===== 主 Tab 栏 ===== */
.tab-bar {
  display: flex;
  background: transparent;
  padding: 0 var(--page-padding);
  position: relative;
  border-bottom: 1rpx solid rgba(26, 26, 23, 0.14);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0 20rpx;
  position: relative;
}

.tab-text {
  font-size: 26rpx;
  color: var(--text-tertiary);
  font-weight: 400;
  letter-spacing: 0.08em;
  font-family: var(--font-sans);
  transition: color var(--transition-fast);
}

.tab-item.active .tab-text {
  color: var(--text-primary);
  font-weight: 500;
}

/* Tab 滑动指示器 */
.tab-indicator-track {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 3rpx;
}

.tab-indicator-slider {
  width: 33.333%;
  height: 100%;
  display: flex;
  justify-content: center;
  transition: transform 500ms cubic-bezier(0.19, 1, 0.22, 1);
}

.tab-indicator-slider.pos-0 { transform: translateX(0%); }
.tab-indicator-slider.pos-1 { transform: translateX(100%); }
.tab-indicator-slider.pos-2 { transform: translateX(200%); }

.tab-indicator-slider.worklet-driven {
  transition: none;
}

.tab-indicator-bar {
  width: 48rpx;
  height: 3rpx;
  background: var(--lux-gold-ink);
  border-radius: 2rpx;
}

/* ===== Tab 内容区 ===== */
.tab-content {
  padding: var(--zy-space-lg) 0 0;
}

/* ===== 子 Tab（服务类型切换） ===== */
.service-tabs {
  display: flex;
  background: transparent;
  margin: 0 var(--page-padding) var(--zy-space-lg);
  border-radius: var(--zy-radius-sm);
  padding: 6rpx;
  border: 1rpx solid rgba(26, 26, 23, 0.14);
}

.service-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 18rpx;
  border-radius: 6rpx;
  transition: background var(--transition-fast);
}

.service-tab.active {
  background: transparent;
  position: relative;
}

.service-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  width: 40rpx;
  height: 2rpx;
  margin-left: -20rpx;
  background: var(--lux-gold-ink);
}

.service-tab-text {
  font-size: 26rpx;
  font-weight: 400;
  color: var(--text-secondary);
  letter-spacing: 0.04em;
  font-family: var(--font-sans);
  transition: color var(--transition-fast);
}

.service-tab.active .service-tab-text {
  color: var(--lux-gold-ink);
  font-weight: 500;
}

/* ===== 区块（A · 整版纸面流，拆白卡） ===== */
.section-card {
  background: transparent;
  border-radius: 0;
  padding: var(--zy-space-lg) var(--page-padding) var(--zy-space-xl);
  margin: 0;
  border-bottom: 1rpx solid rgba(26, 26, 23, 0.14);
  position: relative;
  animation-name: zy-fade-in-up;
  animation-duration: 480ms;
  animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  animation-fill-mode: forwards;
}

.section-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: var(--zy-space-lg);
}

.section-accent {
  width: 4rpx;
  height: 32rpx;
  background: var(--lux-gold-ink);
  flex-shrink: 0;
}

.section-title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.06em;
  font-family: var(--font-serif);
}

/* ===== 服务网格 ===== */
.service-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--zy-space-lg) var(--zy-space-sm2);
  margin-bottom: var(--zy-space-lg);
}

.service-item {
  width: calc(33.333% - 16rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

/* 服务项图标：88rpx 刻印章牌（双环 22%/8% 墨）+ 金墨线稿 SVG */
.service-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(26, 26, 23, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  flex-shrink: 0;
}

.service-icon-wrap::before {
  content: '';
  position: absolute;
  top: 7rpx;
  left: 7rpx;
  right: 7rpx;
  bottom: 7rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(26, 26, 23, 0.08);
}

.medallion-img {
  width: 46rpx;
  height: 46rpx;
}


.service-name {
  font-size: 24rpx;
  color: var(--text-primary);
  text-align: center;
  font-weight: 400;
  letter-spacing: 0.04em;
  font-family: var(--font-sans);
  line-height: 1.3;
}

/* ===== 服务说明 ===== */
.service-note {
  background: transparent;
  padding: 0 0 0 24rpx;
  border-left: 2rpx solid var(--lux-gold-ink);
}

.note-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.7;
  font-family: var(--font-sans);
}

.note-text .highlight {
  color: var(--lux-gold-ink);
  font-weight: 600;
}

/* ===== 狗体型列表 ===== */
.dog-size-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: var(--zy-space-lg);
}

.dog-size-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  background: transparent;
  border-top: 1rpx solid rgba(26, 26, 23, 0.14);
  border-bottom: 1rpx solid rgba(26, 26, 23, 0.14);
}

.dog-size-item:last-child {
  border-bottom: none;
}

.dog-size-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

/* 犬型：金墨剪影三档（尺寸即语义） */
.dog-icon-img { flex-shrink: 0; }
.dog-icon-small { width: 40rpx; height: 40rpx; }
.dog-icon-medium { width: 48rpx; height: 48rpx; }
.dog-icon-large { width: 56rpx; height: 56rpx; }

.dog-details {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.dog-type {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  font-family: var(--font-serif);
  letter-spacing: 0.04em;
}

.dog-condition {
  font-size: 22rpx;
  color: var(--text-tertiary);
  font-family: var(--font-sans);
}

.dog-duration {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--lux-gold-ink);
  white-space: nowrap;
  font-family: var(--font-serif);
  letter-spacing: 0.04em;
}

/* ===== 价格表格 ===== */
.price-table {
  background: transparent;
  border-top: 1rpx solid rgba(26, 26, 23, 0.14);
  border-bottom: 1rpx solid rgba(26, 26, 23, 0.14);
}

.table-header {
  display: flex;
  background: transparent;
  border-bottom: 1rpx solid rgba(26, 26, 23, 0.14);
}

.table-header .table-cell {
  font-weight: 500;
  color: var(--text-primary);
  font-family: var(--font-serif);
  letter-spacing: 0.04em;
}

.table-cell {
  flex: 1;
  padding: 24rpx 16rpx;
  font-size: 26rpx;
  color: var(--text-primary);
  text-align: center;
  font-family: var(--font-sans);
}

.table-row {
  display: flex;
  border-bottom: 1rpx solid rgba(26, 26, 23, 0.14);
}

.table-row:last-child {
  border-bottom: none;
}

.table-row .table-cell:first-child {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.provider-name {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-primary);
  font-family: var(--font-sans);
}

.provider-note {
  font-size: 20rpx;
  color: var(--text-tertiary);
  font-family: var(--font-sans);
}

.table-cell.price {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--primary-color);
  font-family: var(--font-serif);
  letter-spacing: 0.02em;
}

/* ===== 额外服务 ===== */
.extra-services {
  display: flex;
  flex-direction: column;
  margin-bottom: var(--zy-space-lg);
}

.extra-service-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(26, 26, 23, 0.14);
}

.extra-service-item:last-child {
  border-bottom: none;
}

.extra-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding-right: 24rpx;
}

.extra-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  font-family: var(--font-sans);
  letter-spacing: 0.02em;
}

.extra-desc {
  font-size: 22rpx;
  color: var(--text-tertiary);
  font-family: var(--font-sans);
  line-height: 1.5;
}

.extra-price {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--primary-color);
  white-space: nowrap;
  font-family: var(--font-serif);
  letter-spacing: 0.02em;
}

/* ===== PS 说明 ===== */
.ps-note {
  padding-top: 24rpx;
  margin-top: 8rpx;
  border-top: 1rpx solid rgba(26, 26, 23, 0.14);
}

.ps-text {
  font-size: 24rpx;
  color: var(--text-tertiary);
  line-height: 1.7;
  font-family: var(--font-sans);
}

.ps-text .highlight {
  color: var(--lux-gold-ink);
  font-weight: 500;
}

/* ===== 服务流程时间线 ===== */
.flow-list {
  position: relative;
  padding-left: 44rpx;
}

.flow-list::before {
  content: '';
  position: absolute;
  left: 19rpx;
  top: 48rpx;
  bottom: 48rpx;
  width: 2rpx;
  background: linear-gradient(180deg, rgba(122, 95, 42, 0.6) 0%, rgba(122, 95, 42, 0.3) 50%, rgba(122, 95, 42, 0) 100%);
}

.flow-item {
  display: flex;
  gap: 24rpx;
  position: relative;
  margin-bottom: 32rpx;
}

.flow-item:last-child {
  margin-bottom: 0;
}

.flow-number {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: transparent;
  border: 2rpx solid var(--feeding-primary);
  color: var(--lux-gold-ink);
  font-size: 22rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
  margin-left: -44rpx;
  font-family: var(--font-serif);
}

.flow-content {
  flex: 1;
  background: transparent;
  padding: 0 0 0 24rpx;
  border-left: 1rpx solid rgba(26, 26, 23, 0.14);
}

.flow-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}


/* 流程节点：36rpx 金墨线稿（原 8rpx 彩色圆点） */
.flow-icon-img {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

.flow-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  font-family: var(--font-serif);
  letter-spacing: 0.04em;
}

.flow-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.7;
  margin-bottom: 16rpx;
  font-family: var(--font-sans);
}

.flow-desc .highlight {
  color: var(--lux-gold-ink);
  font-weight: 500;
}

.flow-tip {
  background: transparent;
  padding: 0 0 0 20rpx;
  border-left: 2rpx solid var(--lux-gold-ink);
}

.flow-tip-text {
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  font-family: var(--font-sans);
}

/* ===== 预约指引 · 画廊展陈风格 ===== */
.highlight-orange {
  color: var(--primary-color);
  font-weight: 500;
  font-family: var(--font-serif);
}

.highlight-red {
  color: var(--lux-gold-ink);
  font-weight: 500;
  font-family: var(--font-serif);
}

/* 画廊入口 */
.gallery-entrance {
  background: transparent;
  padding: 56rpx var(--page-padding) 44rpx;
  position: relative;
  display: flex;
  align-items: flex-start;
  border-bottom: 1rpx solid rgba(26, 26, 23, 0.14);
}

.gallery-entrance-rail {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 4rpx;
  background: var(--lux-gold-ink);
}

.gallery-entrance-content {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding-left: 16rpx;
}

.gallery-entrance-title {
  font-size: 36rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.1em;
  font-family: var(--font-serif);
}

.gallery-entrance-subtitle {
  font-size: 24rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.12em;
  font-family: var(--font-sans);
}

.gallery-entrance-floor {
  position: absolute;
  bottom: 0;
  left: var(--page-padding);
  right: var(--page-padding);
  height: 1rpx;
  background: rgba(26, 26, 23, 0.14);
}

/* 画廊展厅 */
.gallery-hall {
  padding: var(--zy-space-xl) var(--page-padding) var(--zy-space-lg);
}

.gallery-hall-title {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin-bottom: 8rpx;
}

.gallery-hall-line {
  width: 48rpx;
  height: 1rpx;
  background: rgba(26, 26, 23, 0.14);
}

.gallery-hall-text {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.12em;
  font-family: var(--font-serif);
}

.gallery-hall-divider {
  width: 48rpx;
  height: 2rpx;
  background: var(--lux-gold-ink);
  margin: 0 auto 32rpx;
  border-radius: 1rpx;
}

.gallery-hall-divider-full {
  display: flex;
  justify-content: center;
  padding: 32rpx 0;
}

.gallery-hall-divider-full::before {
  content: '';
  width: 48rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent 0%, var(--lux-gold-ink) 50%, transparent 100%);
}

/* 画廊卡片 */
.gallery-card {
  display: flex;
  background: transparent;
  border-radius: 0;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.gallery-card-rail {
  width: 4rpx;
  flex-shrink: 0;
}

.gallery-card-rail-blue { background: var(--feeding-primary); }
.gallery-card-rail-light-blue { background: var(--feeding-secondary); }
.gallery-card-rail-dark-blue { background: var(--primary-deep); }

.gallery-card-body {
  flex: 1;
  padding: 28rpx 24rpx;
}

.gallery-card-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  display: block;
  margin-bottom: 16rpx;
  letter-spacing: 0.04em;
  font-family: var(--font-serif);
}

.gallery-card-content {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.gallery-card-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.8;
  font-family: var(--font-sans);
}

.gallery-card-note {
  font-size: 22rpx;
  color: var(--text-tertiary);
  line-height: 1.7;
  display: block;
  margin-bottom: 8rpx;
  font-family: var(--font-sans);
}

.gallery-card-note-wrap {
  margin-bottom: 16rpx;
}

/* 画廊表格 */
.gallery-table {
  background: transparent;
  border-top: 1rpx solid rgba(26, 26, 23, 0.14);
  border-bottom: 1rpx solid rgba(26, 26, 23, 0.14);
  margin-top: 16rpx;
}

.gallery-table-header {
  display: flex;
  background: transparent;
}

.gallery-table-subheader {
  display: flex;
  background: transparent;
}

.gallery-table-cell {
  flex: 1;
  padding: 18rpx 12rpx;
  font-size: 22rpx;
  color: var(--text-primary);
  text-align: center;
  border-bottom: 1rpx solid rgba(26, 26, 23, 0.14);
  line-height: 1.6;
  font-family: var(--font-sans);
}

.gallery-table-header .gallery-table-cell {
  color: var(--lux-gold-ink);
  font-weight: 500;
  font-family: var(--font-serif);
  letter-spacing: 0.04em;
}

.gallery-table-subheader .gallery-table-cell {
  color: var(--lux-gold-ink);
  font-weight: 500;
  font-size: 20rpx;
}

.gallery-table-row {
  display: flex;
}

.gallery-table-row-alt {
  background: rgba(26, 26, 23, 0.035);
}

.gallery-table-row:last-child .gallery-table-cell {
  border-bottom: none;
}

.gallery-table-cell-age {
  display: flex;
  align-items: center;
  justify-content: center;
}

.gallery-table-age-text {
  font-size: 22rpx;
  color: var(--lux-gold-ink);
  font-weight: 500;
  font-family: var(--font-serif);
}

.gallery-table-cell-stack {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  align-items: center;
}

.gallery-table-stack-text {
  font-size: 22rpx;
  color: var(--text-primary);
  line-height: 1.5;
  font-family: var(--font-sans);
}

.gallery-table-cell-wide { flex: 2; }
.gallery-table-cell-narrow { flex: 0.6; }
.gallery-table-cell-wide-freq { flex: 2.4; }

.gallery-table-cell-group {
  display: flex;
  align-items: center;
  justify-content: center;
}

.gallery-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 4rpx 16rpx;
  background: transparent;
  color: var(--lux-gold-ink);
  font-size: 20rpx;
  font-weight: 500;
  border: 1rpx solid rgba(122, 95, 42, 0.35);
  border-radius: var(--zy-radius-xs);
  font-family: var(--font-sans);
  letter-spacing: 0.02em;
}

.gallery-tag-multi {
  white-space: nowrap;
}

/* ===== 六大服务保障 ===== */
.gallery-guarantee-visual {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 40rpx;
  padding: 48rpx 0;
  margin-bottom: 32rpx;
  background: transparent;
  border-top: 1rpx solid rgba(26, 26, 23, 0.14);
  border-bottom: 1rpx solid rgba(26, 26, 23, 0.14);
}

.gallery-hexagon {
  width: 120rpx;
  height: 120rpx;
  background: var(--lux-green-grad-rich);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--lux-shadow-green);
  position: relative;
}

.gallery-hexagon::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 50%;
  border: 1rpx solid rgba(201, 162, 75, 0.55);
}

.gallery-hexagon-inner {
  width: 90rpx;
  height: 90rpx;
  background: transparent;
  border-radius: var(--zy-radius-sm);
}

.gallery-guarantee-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  width: 100%;
  padding: 0 16rpx;
}

.gallery-guarantee-badge {
  width: calc(33.333% - 8rpx);
  background: transparent;
  border: 1rpx solid rgba(26, 26, 23, 0.14);
  border-radius: var(--zy-radius-xs);
  padding: 16rpx 8rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-primary);
  font-weight: 400;
  line-height: 1.4;
  font-family: var(--font-sans);
  letter-spacing: 0.02em;
}

.gallery-guarantee-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.gallery-guarantee-item {
  display: flex;
  background: transparent;
  border-radius: 0;
  overflow: hidden;
}

.gallery-guarantee-rail {
  width: 4rpx;
  flex-shrink: 0;
  background: rgba(122, 95, 42, 0.45);
}

.gallery-guarantee-body {
  flex: 1;
  padding: 24rpx 24rpx;
}

.gallery-guarantee-title {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-primary);
  display: block;
  margin-bottom: 8rpx;
  letter-spacing: 0.04em;
  font-family: var(--font-serif);
}

.gallery-guarantee-desc {
  font-size: 22rpx;
  color: var(--text-tertiary);
  line-height: 1.7;
  font-family: var(--font-sans);
}

/* ===== 常见问题 ===== */
.faq-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: var(--zy-space-lg) var(--page-padding);
}

.faq-item {
  background: transparent;
  border-radius: 0;
  overflow: hidden;
  border-bottom: 1rpx solid rgba(26, 26, 23, 0.14);
}

.faq-q {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  gap: 16rpx;
}

.faq-q-text {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.02em;
  flex: 1;
  font-family: var(--font-sans);
}

.faq-toggle {
  width: 16rpx;
  height: 16rpx;
  border-top: 3rpx solid var(--lux-gold-ink);
  border-right: 3rpx solid var(--lux-gold-ink);
  transform: rotate(45deg);
  flex-shrink: 0;
  margin-right: 8rpx;
  transition: transform var(--transition-fast);
}

.faq-toggle.open {
  transform: rotate(135deg);
}

.faq-a {
  padding: 0 24rpx 28rpx;
  background: transparent;
  border-top: 1rpx solid rgba(26, 26, 23, 0.14);
}

.faq-a-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  letter-spacing: 0.02em;
  line-height: 1.8;
  font-family: var(--font-sans);
  display: block;
  padding-top: 20rpx;
}
