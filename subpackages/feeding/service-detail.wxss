/* ================================================================
   subpackages/feeding/service-detail · AROORO 服务详情
   Haute-Luxury Editorial · Gallery Exhibition Aesthetic
   ----------------------------------------------------------------
   设计参考：Hermès / Dior / The Row 服务手册级排版
   板块色：鼠尾草绿 --feeding-primary + 香槟金 --accent-color 点缀
   Skyline 兼容：无 :active / sticky / clip-path / backdrop-filter
   ================================================================ */

/* ===== 入场动画 ===== */
@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(32rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ===== 页面容器 ===== */
.page {
  min-height: 100vh;
  padding-bottom: calc(80rpx + env(safe-area-inset-bottom));
}

/* ===== 顶部品牌头部 ===== */
.gallery-header {
  padding: 0;
  position: relative;
  overflow: hidden;
  background: var(--card-color);
  padding-bottom: 8rpx;
}

.brand-block {
  padding: 72rpx var(--page-padding) 48rpx;
  position: relative;
}

.brand-block::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 320rpx;
  height: 320rpx;
  background: radial-gradient(circle, var(--feeding-tint) 0%, transparent 70%);
  pointer-events: none;
}

.brand-accent-bar {
  position: absolute;
  top: 0;
  left: var(--page-padding);
  width: 48rpx;
  height: 6rpx;
  background: linear-gradient(90deg, var(--feeding-primary) 0%, var(--feeding-secondary) 100%);
  border-radius: 0 0 4rpx 4rpx;
}

.brand-main {
  position: relative;
  margin-bottom: 24rpx;
}

.brand-text {
  font-size: 56rpx;
  font-weight: 300;
  color: var(--text-primary);
  letter-spacing: 0.12em;
  display: block;
  line-height: 1;
  font-family: var(--font-serif);
}

.brand-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.brand-meta-line {
  width: 40rpx;
  height: 2rpx;
  background: var(--border-color);
  position: relative;
}

.brand-meta-line::after {
  content: '';
  position: absolute;
  top: 50%;
  right: -4rpx;
  transform: translateY(-50%);
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: var(--feeding-primary);
}

.brand-subtitle {
  font-size: 22rpx;
  color: var(--text-secondary);
  letter-spacing: 0.08em;
  font-weight: 400;
  font-family: var(--font-sans);
}

/* ===== 主 Tab 栏 ===== */
.tab-bar {
  display: flex;
  background: var(--card-color);
  padding: 0 var(--page-padding);
  position: relative;
  border-bottom: 1rpx solid var(--hairline);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0 20rpx;
  position: relative;
}

.tab-text {
  font-size: 26rpx;
  color: var(--text-tertiary);
  font-weight: 400;
  letter-spacing: 0.08em;
  font-family: var(--font-sans);
  transition: color var(--transition-fast);
}

.tab-item.active .tab-text {
  color: var(--text-primary);
  font-weight: 500;
}

/* Tab 滑动指示器 */
.tab-indicator-track {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 3rpx;
}

.tab-indicator-slider {
  width: 33.333%;
  height: 100%;
  display: flex;
  justify-content: center;
  transition: transform 500ms cubic-bezier(0.19, 1, 0.22, 1);
}

.tab-indicator-slider.pos-0 { transform: translateX(0%); }
.tab-indicator-slider.pos-1 { transform: translateX(100%); }
.tab-indicator-slider.pos-2 { transform: translateX(200%); }

.tab-indicator-slider.worklet-driven {
  transition: none;
}

.tab-indicator-bar {
  width: 48rpx;
  height: 3rpx;
  background: linear-gradient(90deg, var(--feeding-primary) 0%, var(--feeding-secondary) 100%);
  border-radius: 2rpx;
}

/* ===== Tab 内容区 ===== */
.tab-content {
  padding: var(--zy-space-lg) 0 0;
}

/* ===== 子 Tab（服务类型切换） ===== */
.service-tabs {
  display: flex;
  background: var(--card-color);
  margin: 0 var(--page-padding) var(--zy-space-lg);
  border-radius: var(--zy-radius-sm);
  padding: 6rpx;
  border: 1rpx solid var(--hairline);
}

.service-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 18rpx;
  border-radius: 6rpx;
  transition: background var(--transition-fast);
}

.service-tab.active {
  background: linear-gradient(135deg, var(--feeding-primary) 0%, var(--feeding-secondary) 100%);
}

.service-tab-text {
  font-size: 26rpx;
  font-weight: 400;
  color: var(--text-secondary);
  letter-spacing: 0.04em;
  font-family: var(--font-sans);
  transition: color var(--transition-fast);
}

.service-tab.active .service-tab-text {
  color: var(--text-on-primary);
  font-weight: 500;
}

/* ===== 区块卡片 ===== */
.section-card {
  background: var(--card-color);
  border-radius: var(--zy-radius-lg);
  padding: var(--zy-space-lg) var(--page-padding) var(--zy-space-xl);
  margin: 0 var(--page-padding) var(--zy-space-lg);
  border: 1rpx solid var(--hairline);
  position: relative;
  overflow: hidden;
  animation-name: fadeInUp;
  animation-duration: 600ms;
  animation-timing-function: cubic-bezier(0.19, 1, 0.22, 1);
  animation-fill-mode: forwards;
}

.section-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2rpx;
  background: linear-gradient(90deg, var(--feeding-primary) 0%, var(--feeding-secondary) 50%, transparent 100%);
}

.section-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: var(--zy-space-lg);
}

.section-accent {
  width: 6rpx;
  height: 32rpx;
  background: linear-gradient(180deg, var(--feeding-primary) 0%, var(--feeding-secondary) 100%);
  border-radius: 3rpx;
  flex-shrink: 0;
}

.section-title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.06em;
  font-family: var(--font-serif);
}

/* ===== 服务网格 ===== */
.service-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--zy-space-lg) var(--zy-space-sm2);
  margin-bottom: var(--zy-space-lg);
}

.service-item {
  width: calc(33.333% - 16rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.service-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--zy-radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--feeding-tint);
  border: 1rpx solid var(--hairline);
}

/* 所有图标统一为鼠尾草绿单色系 */
.service-icon-wrap.blue,
.service-icon-wrap.purple,
.service-icon-wrap.yellow,
.service-icon-wrap.orange,
.service-icon-wrap.purple-light,
.service-icon-wrap.blue-light {
  background: var(--feeding-tint);
}

.service-icon {
  width: 52rpx;
  height: 52rpx;
  position: relative;
}

/* ===== CSS 图标重绘为单色鼠尾草绿系 ===== */
/* 1. 添新粮换水 */
.bowl-top {
  position: absolute;
  width: 48rpx;
  height: 24rpx;
  background: linear-gradient(180deg, var(--feeding-primary) 0%, var(--primary-deep) 100%);
  border-radius: 0 0 24rpx 24rpx;
  top: 16rpx;
  left: 2rpx;
}
.bowl-base {
  position: absolute;
  width: 20rpx;
  height: 8rpx;
  background: var(--primary-deep);
  border-radius: 0 0 10rpx 10rpx;
  bottom: 8rpx;
  left: 16rpx;
}
.water-wave {
  position: absolute;
  width: 40rpx;
  height: 12rpx;
  top: 10rpx;
  left: 6rpx;
}
.water-wave::before,
.water-wave::after {
  content: '';
  position: absolute;
  width: 60%;
  height: 70%;
  background: rgba(255, 255, 255, 0.5);
  bottom: 0;
  border-radius: 50% 50% 0 0;
}
.water-wave::before { left: -10%; }
.water-wave::after { right: -10%; }

/* 2. 整理宠物区域 */
.trash-bin-new {
  position: absolute;
  width: 36rpx;
  height: 40rpx;
  top: 6rpx;
  left: 8rpx;
}
.bin-body-new {
  width: 32rpx;
  height: 30rpx;
  background: linear-gradient(180deg, var(--feeding-secondary) 0%, var(--feeding-primary) 100%);
  border-radius: 4rpx 4rpx 8rpx 8rpx;
  border: 2rpx solid var(--feeding-primary);
  position: relative;
}
.bin-body-new::before {
  content: '';
  position: absolute;
  width: 18rpx;
  height: 3rpx;
  background: var(--feeding-primary);
  top: 8rpx;
  left: 5rpx;
  border-radius: 2rpx;
  box-shadow: 0 8rpx 0 var(--feeding-primary), 0 16rpx 0 var(--feeding-primary);
}
.bin-lid-new {
  width: 34rpx;
  height: 8rpx;
  background: linear-gradient(180deg, var(--feeding-secondary) 0%, var(--feeding-primary) 100%);
  border-radius: 4rpx 4rpx 0 0;
  border: 2rpx solid var(--feeding-primary);
  border-bottom: none;
}
.bin-lid-new::before {
  content: '';
  position: absolute;
  width: 10rpx;
  height: 4rpx;
  background: var(--feeding-primary);
  top: -4rpx;
  left: 10rpx;
  border-radius: 2rpx 2rpx 0 0;
}

/* 3. 清洁砂盆 */
.litter-box {
  position: absolute;
  width: 44rpx;
  height: 28rpx;
  background: linear-gradient(180deg, var(--feeding-secondary) 0%, var(--feeding-primary) 100%);
  border-radius: 4rpx 4rpx 12rpx 12rpx;
  bottom: 8rpx;
  left: 4rpx;
  border: 2rpx solid var(--feeding-primary);
}
.litter-box::before {
  content: '';
  position: absolute;
  width: 36rpx;
  height: 10rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 4rpx;
  top: 8rpx;
  left: 4rpx;
}
.paw-print {
  position: absolute;
  width: 16rpx;
  height: 16rpx;
  top: 4rpx;
  right: 8rpx;
}
.paw-print::before {
  content: '';
  position: absolute;
  width: 10rpx;
  height: 10rpx;
  background: var(--feeding-primary);
  border-radius: 50%;
  bottom: 0;
  left: 3rpx;
}
.paw-print::after {
  content: '';
  position: absolute;
  width: 4rpx;
  height: 6rpx;
  background: var(--feeding-primary);
  border-radius: 50%;
  top: 0;
  left: 1rpx;
  box-shadow: 6rpx 0 0 var(--feeding-primary), 10rpx 2rpx 0 var(--feeding-primary);
}
.litter-grain {
  position: absolute;
  width: 4rpx;
  height: 4rpx;
  background: var(--feeding-secondary);
  border-radius: 50%;
  top: 20rpx;
  left: 12rpx;
  box-shadow: 8rpx -2rpx 0 var(--feeding-primary), -2rpx 6rpx 0 var(--feeding-primary), 10rpx 4rpx 0 var(--feeding-secondary);
}

/* 4. 反馈宠物状态 */
.heart-main {
  position: absolute;
  width: 28rpx;
  height: 28rpx;
  background: linear-gradient(135deg, var(--feeding-secondary) 0%, var(--feeding-primary) 100%);
  top: 10rpx;
  left: 12rpx;
  border-radius: 50%;
  transform: rotate(-45deg);
}
.heart-accent {
  position: absolute;
  width: 12rpx;
  height: 12rpx;
  background: rgba(255, 255, 255, 0.35);
  border-radius: 50%;
  top: 12rpx;
  left: 16rpx;
}
.pet-nose {
  position: absolute;
  width: 12rpx;
  height: 8rpx;
  background: var(--primary-deep);
  border-radius: 50%;
  bottom: 10rpx;
  left: 20rpx;
}
.pet-nose::before {
  content: '';
  position: absolute;
  width: 4rpx;
  height: 4rpx;
  background: rgba(255, 255, 255, 0.4);
  border-radius: 50%;
  top: 1rpx;
  left: 2rpx;
}

/* 5. 检查关闭门窗 */
.door-frame {
  position: absolute;
  width: 32rpx;
  height: 40rpx;
  background: linear-gradient(135deg, var(--feeding-secondary) 0%, var(--feeding-primary) 100%);
  border-radius: 4rpx 4rpx 0 0;
  bottom: 4rpx;
  left: 10rpx;
  border: 2rpx solid var(--feeding-primary);
}
.door-frame::before {
  content: '';
  position: absolute;
  width: 20rpx;
  height: 24rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 2rpx;
  top: 6rpx;
  left: 4rpx;
}
.door-knob {
  position: absolute;
  width: 6rpx;
  height: 6rpx;
  background: var(--accent-color);
  border-radius: 50%;
  bottom: 20rpx;
  right: 14rpx;
  box-shadow: 0 0 0 2rpx var(--accent-deep);
}
.check-mark {
  position: absolute;
  width: 16rpx;
  height: 12rpx;
  top: 6rpx;
  right: 6rpx;
  border: 3rpx solid var(--success-color);
  border-left: none;
  border-top: none;
  transform: rotate(45deg);
  border-radius: 0 0 2rpx 0;
}

/* 6. 服务全程录像 */
.camera-body {
  position: absolute;
  width: 40rpx;
  height: 28rpx;
  background: linear-gradient(135deg, var(--feeding-primary) 0%, var(--primary-deep) 100%);
  border-radius: 6rpx;
  bottom: 8rpx;
  left: 6rpx;
}
.camera-body::before {
  content: '';
  position: absolute;
  width: 12rpx;
  height: 8rpx;
  background: var(--primary-deep);
  border-radius: 4rpx 4rpx 0 0;
  top: -6rpx;
  left: 14rpx;
}
.camera-lens {
  position: absolute;
  width: 18rpx;
  height: 18rpx;
  background: linear-gradient(135deg, var(--feeding-secondary) 0%, var(--feeding-primary) 100%);
  border-radius: 50%;
  bottom: 13rpx;
  left: 17rpx;
  border: 3rpx solid var(--feeding-primary);
}
.camera-lens::before {
  content: '';
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  top: 2rpx;
  left: 2rpx;
}
.play-button {
  position: absolute;
  width: 0;
  height: 0;
  border-left: 10rpx solid var(--text-on-primary);
  border-top: 6rpx solid transparent;
  border-bottom: 6rpx solid transparent;
  top: 20rpx;
  right: 10rpx;
}

.service-name {
  font-size: 24rpx;
  color: var(--text-primary);
  text-align: center;
  font-weight: 400;
  letter-spacing: 0.04em;
  font-family: var(--font-sans);
  line-height: 1.3;
}

/* ===== 服务说明 ===== */
.service-note {
  background: var(--feeding-tint);
  border-radius: var(--zy-radius-sm);
  padding: 24rpx;
  border-left: 4rpx solid var(--feeding-primary);
}

.note-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.7;
  font-family: var(--font-sans);
}

.note-text .highlight {
  color: var(--feeding-primary);
  font-weight: 600;
}

/* ===== 狗体型列表 ===== */
.dog-size-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: var(--zy-space-lg);
}

.dog-size-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: var(--card-cream);
  border-radius: var(--zy-radius-sm);
  border: 1rpx solid var(--hairline);
}

.dog-size-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.dog-icon {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
}

.dog-icon.small { background: var(--feeding-secondary); border-radius: 8rpx; }
.dog-icon.medium { background: var(--feeding-primary); border-radius: 10rpx; }
.dog-icon.large { background: var(--primary-deep); border-radius: 12rpx; }

.dog-details {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.dog-type {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  font-family: var(--font-serif);
  letter-spacing: 0.04em;
}

.dog-condition {
  font-size: 22rpx;
  color: var(--text-tertiary);
  font-family: var(--font-sans);
}

.dog-duration {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--feeding-primary);
  white-space: nowrap;
  font-family: var(--font-serif);
  letter-spacing: 0.04em;
}

/* ===== 价格表格 ===== */
.price-table {
  background: var(--card-cream);
  border-radius: var(--zy-radius-sm);
  overflow: hidden;
  border: 1rpx solid var(--hairline);
}

.table-header {
  display: flex;
  background: var(--feeding-tint);
  border-bottom: 1rpx solid var(--hairline);
}

.table-header .table-cell {
  font-weight: 500;
  color: var(--text-primary);
  font-family: var(--font-serif);
  letter-spacing: 0.04em;
}

.table-cell {
  flex: 1;
  padding: 24rpx 16rpx;
  font-size: 26rpx;
  color: var(--text-primary);
  text-align: center;
  font-family: var(--font-sans);
}

.table-row {
  display: flex;
  border-bottom: 1rpx solid var(--divider-color);
}

.table-row:last-child {
  border-bottom: none;
}

.table-row .table-cell:first-child {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.provider-name {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-primary);
  font-family: var(--font-sans);
}

.provider-note {
  font-size: 20rpx;
  color: var(--text-tertiary);
  font-family: var(--font-sans);
}

.table-cell.price {
  font-size: 32rpx;
  font-weight: 500;
  color: #1F3A1F;
  font-family: var(--font-serif);
  letter-spacing: 0.02em;
}

/* ===== 额外服务 ===== */
.extra-services {
  display: flex;
  flex-direction: column;
  margin-bottom: var(--zy-space-lg);
}

.extra-service-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--divider-color);
}

.extra-service-item:last-child {
  border-bottom: none;
}

.extra-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding-right: 24rpx;
}

.extra-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  font-family: var(--font-sans);
  letter-spacing: 0.02em;
}

.extra-desc {
  font-size: 22rpx;
  color: var(--text-tertiary);
  font-family: var(--font-sans);
  line-height: 1.5;
}

.extra-price {
  font-size: 28rpx;
  font-weight: 500;
  color: #1F3A1F;
  white-space: nowrap;
  font-family: var(--font-serif);
  letter-spacing: 0.02em;
}

/* ===== PS 说明 ===== */
.ps-note {
  padding-top: 24rpx;
  margin-top: 8rpx;
  border-top: 1rpx solid var(--divider-color);
}

.ps-text {
  font-size: 24rpx;
  color: var(--text-tertiary);
  line-height: 1.7;
  font-family: var(--font-sans);
}

.ps-text .highlight {
  color: var(--feeding-primary);
  font-weight: 500;
}

/* ===== 服务流程时间线 ===== */
.flow-list {
  position: relative;
  padding-left: 44rpx;
}

.flow-list::before {
  content: '';
  position: absolute;
  left: 19rpx;
  top: 48rpx;
  bottom: 48rpx;
  width: 2rpx;
  background: linear-gradient(180deg, var(--feeding-primary) 0%, var(--feeding-secondary) 50%, var(--divider-color) 100%);
}

.flow-item {
  display: flex;
  gap: 24rpx;
  position: relative;
  margin-bottom: 32rpx;
}

.flow-item:last-child {
  margin-bottom: 0;
}

.flow-number {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--card-color);
  border: 2rpx solid var(--feeding-primary);
  color: var(--feeding-primary);
  font-size: 22rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
  margin-left: -44rpx;
  font-family: var(--font-serif);
}

.flow-content {
  flex: 1;
  background: var(--card-cream);
  border-radius: var(--zy-radius-sm);
  padding: 24rpx;
  border: 1rpx solid var(--hairline);
}

.flow-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.flow-icon {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--feeding-primary);
  flex-shrink: 0;
}

.flow-icon.order { background: var(--feeding-primary); }
.flow-icon.accept { background: var(--success-color); }
.flow-icon.key { background: var(--accent-color); }
.flow-icon.prepare { background: var(--feeding-secondary); }
.flow-icon.checkin { background: var(--success-color); }
.flow-icon.disinfection { background: var(--info-color); }
.flow-icon.comfort { background: var(--feeding-primary); }
.flow-icon.start { background: var(--success-color); }
.flow-icon.complete { background: var(--info-color); }

.flow-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  font-family: var(--font-serif);
  letter-spacing: 0.04em;
}

.flow-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.7;
  margin-bottom: 16rpx;
  font-family: var(--font-sans);
}

.flow-desc .highlight {
  color: var(--feeding-primary);
  font-weight: 500;
}

.flow-tip {
  background: var(--feeding-tint);
  border-radius: var(--zy-radius-xs);
  padding: 16rpx 20rpx;
  border-left: 3rpx solid var(--feeding-primary);
}

.flow-tip-text {
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  font-family: var(--font-sans);
}

/* ===== 预约指引 · 画廊展陈风格 ===== */
.highlight-orange {
  color: #1F3A1F;
  font-weight: 500;
  font-family: var(--font-serif);
}

.highlight-red {
  color: var(--feeding-primary);
  font-weight: 500;
  font-family: var(--font-serif);
}

/* 画廊入口 */
.gallery-entrance {
  background: var(--card-color);
  padding: 56rpx var(--page-padding) 44rpx;
  position: relative;
  display: flex;
  align-items: flex-start;
  border-bottom: 1rpx solid var(--hairline);
}

.gallery-entrance-rail {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 4rpx;
  background: linear-gradient(180deg, var(--feeding-primary) 0%, var(--feeding-secondary) 50%, transparent 100%);
}

.gallery-entrance-content {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding-left: 16rpx;
}

.gallery-entrance-title {
  font-size: 36rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.1em;
  font-family: var(--font-serif);
}

.gallery-entrance-subtitle {
  font-size: 24rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.12em;
  font-family: var(--font-sans);
}

.gallery-entrance-floor {
  position: absolute;
  bottom: 0;
  left: var(--page-padding);
  right: var(--page-padding);
  height: 1rpx;
  background: var(--divider-color);
}

/* 画廊展厅 */
.gallery-hall {
  padding: var(--zy-space-xl) var(--page-padding) var(--zy-space-lg);
}

.gallery-hall-title {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin-bottom: 8rpx;
}

.gallery-hall-line {
  width: 48rpx;
  height: 1rpx;
  background: var(--border-color);
}

.gallery-hall-text {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.12em;
  font-family: var(--font-serif);
}

.gallery-hall-divider {
  width: 48rpx;
  height: 2rpx;
  background: linear-gradient(90deg, var(--feeding-primary) 0%, var(--feeding-secondary) 100%);
  margin: 0 auto 32rpx;
  border-radius: 1rpx;
}

.gallery-hall-divider-full {
  display: flex;
  justify-content: center;
  padding: 32rpx 0;
}

.gallery-hall-divider-full::before {
  content: '';
  width: 48rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent 0%, var(--feeding-primary) 50%, transparent 100%);
}

/* 画廊卡片 */
.gallery-card {
  display: flex;
  background: var(--card-color);
  border-radius: var(--zy-radius-sm);
  overflow: hidden;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--hairline);
}

.gallery-card-rail {
  width: 4rpx;
  flex-shrink: 0;
}

.gallery-card-rail-blue { background: var(--feeding-primary); }
.gallery-card-rail-light-blue { background: var(--feeding-secondary); }
.gallery-card-rail-dark-blue { background: var(--primary-deep); }

.gallery-card-body {
  flex: 1;
  padding: 28rpx 24rpx;
}

.gallery-card-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  display: block;
  margin-bottom: 16rpx;
  letter-spacing: 0.04em;
  font-family: var(--font-serif);
}

.gallery-card-content {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.gallery-card-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.8;
  font-family: var(--font-sans);
}

.gallery-card-note {
  font-size: 22rpx;
  color: var(--text-tertiary);
  line-height: 1.7;
  display: block;
  margin-bottom: 8rpx;
  font-family: var(--font-sans);
}

.gallery-card-note-wrap {
  margin-bottom: 16rpx;
}

/* 画廊表格 */
.gallery-table {
  background: var(--card-cream);
  border-radius: var(--zy-radius-xs);
  overflow: hidden;
  border: 1rpx solid var(--hairline);
  margin-top: 16rpx;
}

.gallery-table-header {
  display: flex;
  background: var(--feeding-tint);
}

.gallery-table-subheader {
  display: flex;
  background: var(--card-color);
}

.gallery-table-cell {
  flex: 1;
  padding: 18rpx 12rpx;
  font-size: 22rpx;
  color: var(--text-primary);
  text-align: center;
  border-bottom: 1rpx solid var(--divider-color);
  line-height: 1.6;
  font-family: var(--font-sans);
}

.gallery-table-header .gallery-table-cell {
  color: var(--feeding-primary);
  font-weight: 500;
  font-family: var(--font-serif);
  letter-spacing: 0.04em;
}

.gallery-table-subheader .gallery-table-cell {
  color: var(--feeding-primary);
  font-weight: 500;
  font-size: 20rpx;
}

.gallery-table-row {
  display: flex;
}

.gallery-table-row-alt {
  background: var(--card-cream);
}

.gallery-table-row:last-child .gallery-table-cell {
  border-bottom: none;
}

.gallery-table-cell-age {
  display: flex;
  align-items: center;
  justify-content: center;
}

.gallery-table-age-text {
  font-size: 22rpx;
  color: var(--feeding-primary);
  font-weight: 500;
  font-family: var(--font-serif);
}

.gallery-table-cell-stack {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  align-items: center;
}

.gallery-table-stack-text {
  font-size: 22rpx;
  color: var(--text-primary);
  line-height: 1.5;
  font-family: var(--font-sans);
}

.gallery-table-cell-wide { flex: 2; }
.gallery-table-cell-narrow { flex: 0.6; }
.gallery-table-cell-wide-freq { flex: 2.4; }

.gallery-table-cell-group {
  display: flex;
  align-items: center;
  justify-content: center;
}

.gallery-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 4rpx 16rpx;
  background: var(--feeding-tint);
  color: var(--feeding-primary);
  font-size: 20rpx;
  font-weight: 500;
  border-radius: var(--zy-radius-xs);
  font-family: var(--font-sans);
  letter-spacing: 0.02em;
}

.gallery-tag-multi {
  white-space: nowrap;
}

/* ===== 六大服务保障 ===== */
.gallery-guarantee-visual {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 40rpx;
  padding: 48rpx 0;
  margin-bottom: 32rpx;
  background: var(--card-cream);
  border-radius: var(--zy-radius-sm);
  border: 1rpx solid var(--hairline);
}

.gallery-hexagon {
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, var(--feeding-primary) 0%, var(--feeding-secondary) 100%);
  border-radius: var(--zy-radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-glow-primary-soft);
}

.gallery-hexagon-inner {
  width: 90rpx;
  height: 90rpx;
  background: var(--card-color);
  border-radius: var(--zy-radius-sm);
}

.gallery-guarantee-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  width: 100%;
  padding: 0 16rpx;
}

.gallery-guarantee-badge {
  width: calc(33.333% - 8rpx);
  background: var(--card-color);
  border: 1rpx solid var(--hairline);
  border-radius: var(--zy-radius-xs);
  padding: 16rpx 8rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-primary);
  font-weight: 400;
  line-height: 1.4;
  font-family: var(--font-sans);
  letter-spacing: 0.02em;
}

.gallery-guarantee-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.gallery-guarantee-item {
  display: flex;
  background: var(--card-color);
  border-radius: var(--zy-radius-sm);
  overflow: hidden;
  border: 1rpx solid var(--hairline);
}

.gallery-guarantee-rail {
  width: 4rpx;
  flex-shrink: 0;
  background: linear-gradient(180deg, var(--feeding-primary) 0%, var(--feeding-secondary) 100%);
}

.gallery-guarantee-body {
  flex: 1;
  padding: 24rpx 24rpx;
}

.gallery-guarantee-title {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-primary);
  display: block;
  margin-bottom: 8rpx;
  letter-spacing: 0.04em;
  font-family: var(--font-serif);
}

.gallery-guarantee-desc {
  font-size: 22rpx;
  color: var(--text-tertiary);
  line-height: 1.7;
  font-family: var(--font-sans);
}

/* ===== 常见问题 ===== */
.faq-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: var(--zy-space-lg) var(--page-padding);
}

.faq-item {
  background: var(--card-color);
  border-radius: var(--zy-radius-sm);
  overflow: hidden;
  border: 1rpx solid var(--hairline);
}

.faq-q {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  gap: 16rpx;
}

.faq-q-text {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.02em;
  flex: 1;
  font-family: var(--font-sans);
}

.faq-toggle {
  width: 16rpx;
  height: 16rpx;
  border-top: 3rpx solid var(--text-tertiary);
  border-right: 3rpx solid var(--text-tertiary);
  transform: rotate(45deg);
  flex-shrink: 0;
  margin-right: 8rpx;
  transition: transform var(--transition-fast);
}

.faq-toggle.open {
  transform: rotate(135deg);
  border-color: var(--feeding-primary);
}

.faq-a {
  padding: 0 24rpx 28rpx;
  background: var(--card-cream);
  border-top: 1rpx solid var(--divider-color);
}

.faq-a-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  letter-spacing: 0.02em;
  line-height: 1.8;
  font-family: var(--font-sans);
  display: block;
  padding-top: 20rpx;
}
