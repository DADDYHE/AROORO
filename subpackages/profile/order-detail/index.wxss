/* ================================================================
   订单详情 ·「纸上卷宗」— AROORO Haute-Luxury v2
   对齐 host-detail 定稿语言：暖石纸面 + hairline 分区 + 金 eyebrow 章节
   + 编辑式大日期/大总额 + 卷宗落款。去白卡，信息以章节与留白组织。
   token 来源：styles/variables.wxss → theme-teal.wxss（app.wxss 注入）
   ================================================================ */
@import '../../../styles/loading-animation.wxss';
/* 令牌由 app.wxss 全局注入到 page，页面不得再 import variables.wxss ——
   页面 wxss 在 app.wxss 之后加载，同为 page 选择器会反向覆盖 theme-teal，
   把旧橄榄坐标系带回来（详见 #10）。 */

.page {
  min-height: 100vh;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* ================================================================
   状态横幅（order-status-banner 页面级样式，保留既有对比度结论）
   ================================================================ */
.status-banner {
  padding: 48rpx var(--page-padding) 40rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  --banner-ink: var(--card-color);
}

/* 待付款 - 金。例外档：金对白仅 2.40:1，故金底文字一律炭黑（5.27:1） */
.status-banner.status-pending,
.status-banner.status-pending_payment {
  background: linear-gradient(135deg, var(--status-pending) 0%, var(--accent-deep) 100%);
  --banner-ink: var(--text-primary);
}

/* 已付款/待确认 - 钢蓝，白字 4.56:1 */
.status-banner.status-paid {
  background: linear-gradient(135deg, var(--status-active) 0%, var(--status-active-deep) 100%);
}

/* 已确认/进行中 - 状态绿，白字 6.23:1 */
.status-banner.status-confirmed,
.status-banner.status-in_progress,
.status-banner.status-ongoing {
  background: linear-gradient(135deg, var(--status-progress) 0%, var(--status-progress-deep) 100%);
}

/* 已完成 - 绿，白字 5.16:1 */
.status-banner.status-completed {
  background: linear-gradient(135deg, var(--status-completed) 0%, var(--status-completed-deep) 100%);
}

/* 已取消 - 暖灰，白字 4.59:1 */
.status-banner.status-cancelled {
  background: linear-gradient(135deg, var(--status-cancelled) 0%, var(--status-cancelled-deep) 100%);
}

.status-text {
  font-size: 36rpx;
  font-weight: 400;
  color: var(--banner-ink);
  letter-spacing: 0.06em;
}

.status-desc {
  font-size: 24rpx;
  color: var(--banner-ink);
  line-height: 1.5;
  letter-spacing: 0.02em;
}

/* 支付倒计时（金底必然炭黑 5.27:1，见上方注释） */
.pay-countdown {
  margin-top: 14rpx;
  display: flex;
  align-items: baseline;
  font-size: 24rpx;
  color: var(--banner-ink);
}

.pay-countdown-label {
  margin-right: 10rpx;
  letter-spacing: 0.04em;
}

.pay-countdown-time {
  font-weight: 600;
  font-size: 34rpx;
  letter-spacing: 1rpx;
}

/* ================================================================
   顶部取消入口（状态横幅下右对齐胶囊）
   ================================================================ */
.top-cancel-row {
  display: flex;
  justify-content: flex-end;
  padding: 16rpx var(--page-padding, 48rpx) 0;
}

.top-cancel-btn {
  padding: 10rpx 28rpx;
  border: 1rpx solid var(--border-color, #E2DED3);
  border-radius: 999rpx;
  background-color: var(--card-color);
}

.top-cancel-btn text {
  font-size: 24rpx;
  letter-spacing: 0.06em;
  color: var(--text-secondary);
}

/* ================================================================
   卷宗头：金 accent bar + eyebrow + 家庭名大字 + 订单号
   ================================================================ */
.dossier-head {
  padding: 40rpx var(--page-padding) 32rpx;
  border-bottom: 1rpx solid var(--hairline);
}

.brand-accent-bar {
  width: 48rpx;
  height: 2rpx;
  background: var(--accent-color);
  margin-bottom: 18rpx;
}

.dossier-eyebrow {
  display: block;
  font-size: 20rpx;
  font-weight: 400;
  letter-spacing: 0.32em;
  color: var(--accent-color);
  margin-bottom: 14rpx;
}

.dossier-title {
  display: block;
  font-size: 52rpx;
  font-weight: 300;
  letter-spacing: 0.02em;
  line-height: 1.2;
  color: var(--text-primary);
  margin-bottom: 18rpx;
}

.dossier-no-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.dossier-no-label {
  font-size: 20rpx;
  letter-spacing: 0.2em;
  color: var(--text-tertiary);
}

.dossier-no {
  font-size: 22rpx;
  letter-spacing: 0.06em;
  color: var(--text-secondary);
}

.copy-btn {
  transition: transform 160ms ease, opacity 160ms ease;
  font-size: 20rpx;
  color: var(--accent-color);
  padding: 2rpx 14rpx;
  border: 1rpx solid var(--lux-hairline-gold);
  border-radius: 999rpx;
}

.copy-btn.pressed {
  opacity: 0.7;
}

/* ================================================================
   章节：双行 eyebrow（01 HOST …）+ hairline 分区，无卡片
   ================================================================ */
.chapter {
  padding: 36rpx var(--page-padding) 8rpx;
}

.chapter-eyebrow-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 26rpx;
}

.chapter-no {
  font-size: 20rpx;
  letter-spacing: 0.12em;
  color: var(--accent-color);
}

.chapter-name {
  font-size: 20rpx;
  font-weight: 500;
  letter-spacing: 0.28em;
  color: var(--text-secondary);
}

.chapter-rule {
  flex: 1;
  height: 1rpx;
  background: var(--hairline);
}

.chapter-side {
  font-size: 20rpx;
  letter-spacing: 0.08em;
  color: var(--text-tertiary);
}

.chapter-body {
  padding-bottom: 28rpx;
  border-bottom: 1rpx solid var(--hairline);
}

.chapter--meta .chapter-body {
  border-bottom: none;
}

/* ── 01 HOST ── */
.host-row {
  display: flex;
  gap: 22rpx;
  align-items: center;
}

/* 金环头像（对齐 host-detail 语法） */
.host-avatar-ring {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  border: 1rpx solid var(--lux-hairline-gold);
  padding: 4rpx;
  flex-shrink: 0;
  box-sizing: border-box;
}

.host-avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: var(--card-cream, #FBF9F4);
}

.host-avatar-placeholder {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: var(--accent-soft, #F0E6D0);
}

.host-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.host-name {
  font-size: 32rpx;
  font-weight: 400;
  letter-spacing: 0.04em;
  color: var(--text-primary);
}

.host-contact {
  transition: transform 160ms ease, opacity 160ms ease;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.host-phone {
  font-size: 24rpx;
  letter-spacing: 0.04em;
  color: var(--text-secondary);
}

.call-btn {
  font-size: 22rpx;
  color: var(--accent-color);
  padding: 4rpx 20rpx;
  border: 1rpx solid var(--lux-hairline-gold);
  border-radius: 999rpx;
}

.host-contact--pressed { transform: scale(0.97); opacity: 0.92; }

/* ── 02 GUESTS ── */
.pet-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.pet-item {
  display: flex;
  gap: 18rpx;
  align-items: center;
}

.pet-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: var(--card-cream, #FBF9F4);
  border: 1rpx solid var(--hairline);
}

.pet-avatar-placeholder {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: var(--accent-soft, #F0E6D0);
}

.pet-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.pet-name {
  font-size: 28rpx;
  font-weight: 400;
  color: var(--text-primary);
}

.pet-breed {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.pet-summary {
  padding: 4rpx 0;
}

.pet-names {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 400;
}

/* ── 03 SCHEDULE：编辑式大日期 ── */
.schedule-dates {
  display: flex;
  align-items: flex-start;
}

.schedule-date-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.schedule-date-col--end {
  align-items: flex-end;
  text-align: right;
}

.schedule-date-big {
  font-size: 56rpx;
  font-weight: 300;
  letter-spacing: 0.04em;
  line-height: 1.1;
  color: var(--text-primary);
}

.schedule-time {
  font-size: 22rpx;
  letter-spacing: 0.08em;
  color: var(--text-tertiary);
}

.schedule-arrow {
  width: 48rpx;
  height: 1rpx;
  background: var(--accent-color);
  margin-top: 30rpx;
  margin-left: 16rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.schedule-meta {
  display: flex;
  gap: 24rpx;
  margin-top: 22rpx;
}

.schedule-meta-text {
  font-size: 22rpx;
  letter-spacing: 0.06em;
  color: var(--text-tertiary);
}

/* ── 04 BILLING：费用明细行 ── */
.fee-rows {
  display: flex;
  flex-direction: column;
}

.fee-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 15rpx 0;
}

.fee-key {
  font-size: 25rpx;
  letter-spacing: 0.04em;
  color: var(--text-secondary);
}

.fee-val {
  font-size: 25rpx;
  color: var(--text-primary);
  font-weight: 400;
  max-width: 420rpx;
  text-align: right;
  word-break: break-all;
}

.fee-val--gold {
  color: var(--accent-color);
}

.fee-note {
  padding: 6rpx 0 10rpx;
}

.fee-note-text {
  font-size: 20rpx;
  letter-spacing: 0.03em;
  line-height: 1.6;
  color: var(--text-tertiary);
}

/* 编辑式大总额（对齐 host-detail 价格语法） */
.total-block {
  margin-top: 18rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid var(--hairline);
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.total-key {
  font-size: 25rpx;
  letter-spacing: 0.08em;
  color: var(--text-secondary);
}

.total-val-row {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.total-symbol {
  font-size: 26rpx;
  color: var(--text-primary);
}

.total-num {
  font-size: 52rpx;
  font-weight: 300;
  letter-spacing: 0.02em;
  line-height: 1.1;
  color: var(--text-primary);
}

/* ── 05 META：小字元信息 ── */
.meta-rows {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.meta-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.meta-key {
  font-size: 22rpx;
  letter-spacing: 0.06em;
  color: var(--text-tertiary);
  flex-shrink: 0;
  margin-right: 24rpx;
}

.meta-val {
  font-size: 22rpx;
  color: var(--text-secondary);
  text-align: right;
  word-break: break-all;
}

/* ================================================================
   卷宗落款
   ================================================================ */
.dossier-foot {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  padding: 48rpx var(--page-padding) 24rpx;
}

.dossier-foot-line {
  width: 64rpx;
  height: 1rpx;
  background: var(--hairline);
}

.dossier-foot-text {
  font-size: 20rpx;
  letter-spacing: 0.3em;
  color: var(--text-tertiary);
}

/* ================================================================
   入场动画（保留原节奏）
   ================================================================ */
.status-banner {
  animation-name: zy-fade-in-down;
  animation-duration: 480ms;
  animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  animation-fill-mode: forwards;
}

.chapter {
  animation-name: zy-fade-in-up;
  animation-duration: 480ms;
  animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  animation-fill-mode: forwards;
}

.chapter:nth-of-type(1) { animation-delay: 100ms; }
.chapter:nth-of-type(2) { animation-delay: 160ms; }
.chapter:nth-of-type(3) { animation-delay: 220ms; }
.chapter:nth-of-type(4) { animation-delay: 280ms; }
.chapter:nth-of-type(5) { animation-delay: 340ms; }
