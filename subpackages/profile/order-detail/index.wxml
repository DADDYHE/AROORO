<zy-navbar title="订单详情" />
<scroll-view
  scroll-y
  enhanced
  refresher-enabled="{{true}}"
  refresher-triggered="{{_refresherTriggered}}"
  bindrefresherrefresh="_onRefresherRefresh"
  bindscrolltolower="_onScrollToLower"
  bindscroll="_onScroll"
  lower-threshold="100"
  style="height: calc(100vh - {{_navbarHeight}}px);"
>
<view class="page">
  <view wx:if="{{isLoading}}" class="loading-container">
    <view class="loading-content">
      <view class="lux-cascade">
  <view class="lux-cascade-dot" style="left: 20rpx; background: #C9A24B; animation-delay: 0ms;"></view>
  <view class="lux-cascade-dot" style="left: 36rpx; background: #A8894A; animation-delay: 150ms;"></view>
  <view class="lux-cascade-dot" style="left: 52rpx; background: #C9A24B; animation-delay: 300ms;"></view>
  <view class="lux-cascade-dot" style="left: 68rpx; background: #A8894A; animation-delay: 450ms;"></view>
  <view class="lux-cascade-dot" style="left: 84rpx; background: #C9A24B; animation-delay: 600ms;"></view>
  <view class="lux-cascade-dot" style="left: 100rpx; background: #A8894A; animation-delay: 750ms;"></view>
  <view class="lux-cascade-dot" style="left: 48rpx; background: #C9A24B; animation-delay: 900ms;"></view>

      </view>
      <text class="loading-text">加载中</text>
    </view>
  </view>

  <block wx:elif="{{order}}">
    <order-status-banner
      status="{{order.status}}"
      status-text="{{order.statusText}}"
      status-desc="{{order.statusDesc}}"
      pay-countdown="{{payCountdown}}"
    />

    <view class="section host-section">
      <view class="section-title">寄养家庭</view>
      <view class="host-row">
        <image class="host-avatar" wx:if="{{order.hostAvatar}}" src="{{order.hostAvatar}}" mode="aspectFill" binderror="onCloudImageError" data-src="{{order.hostAvatar}}" data-path="order.hostAvatar" />
        <view class="host-avatar-placeholder" wx:else></view>
        <view class="host-info">
          <text class="host-name">{{order.hostName || '寄养家庭'}}</text>
          <view class="host-contact" bindtap="onContactHost" wx:if="{{order.hostPhone}}">
            <text class="host-phone">{{order.hostPhone}}</text>
            <view class="call-btn">联系</view>
          </view>
        </view>
      </view>
    </view>

    <view class="section pet-section">
      <view class="section-title">寄养宠物</view>
      <view class="pet-list">
        <view class="pet-item" wx:for="{{order.petList}}" wx:key="_id">
          <image class="pet-avatar" wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" mode="aspectFill" />
          <view class="pet-avatar-placeholder" wx:else></view>
          <view class="pet-info">
            <text class="pet-name">{{item.name}}</text>
            <text class="pet-breed" wx:if="{{item.breed}}">{{item.breed}}</text>
          </view>
        </view>
      </view>
      <view class="pet-summary" wx:if="{{!order.petList || order.petList.length === 0}}">
        <text class="pet-names">{{order.petNames}}</text>
      </view>
    </view>

    <view class="section date-section">
      <view class="section-title">寄养时间</view>
      <view class="date-row" wx:if="{{order.startDate && order.endDate}}">
        <image class="row-icon" src="{{iconTimeLine}}" mode="aspectFit" binderror="onCloudImageError" data-src="{{iconTimeLine}}" data-path="iconTimeLine" />
        <text class="date-text">{{order.startDate}} 至 {{order.endDate}}</text>
        <text class="date-days">共{{order.days}}天</text>
      </view>
    </view>

    <order-card title="订单信息">
      <view slot="content">
      <view class="info-row">
        <text class="info-label">订单编号</text>
        <view class="info-value-row">
          <text class="info-value">{{order.orderNo}}</text>
          <view class="copy-btn" bindtap="onCopyOrderNo">复制</view>
        </view>
      </view>
      <view class="info-row">
        <text class="info-label">下单时间</text>
        <text class="info-value">{{order.createdAt}}</text>
      </view>
      <view class="info-row" wx:if="{{order.paidAt}}">
        <text class="info-label">支付时间</text>
        <text class="info-value">{{order.paidAt}}</text>
      </view>
      <view class="info-row" wx:if="{{order.note}}">
        <text class="info-label">备注</text>
        <text class="info-value">{{order.note}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">每日价格</text>
        <text class="info-value">¥{{order.pricePerDay}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">宠物数量</text>
        <text class="info-value">{{order.petCount}}只</text>
      </view>
      <view class="info-row">
        <text class="info-label">寄养天数</text>
        <text class="info-value">{{order.days}}天</text>
      </view>
      <view class="info-row">
        <text class="info-label">基础价格</text>
        <text class="info-value">¥{{order.basicPrice}}</text>
      </view>
      <view class="info-row" wx:if="{{order.couponDiscount > 0}}">
        <text class="info-label">优惠金额</text>
        <text class="info-value discount">-¥{{order.couponDiscount}}</text>
      </view>
      <view class="info-row total-row">
        <text class="info-label">订单总额</text>
        <text class="total-value">¥{{order.totalPrice}}</text>
      </view>
      </view>
    </order-card>

    <root-portal>
      <order-action-bar
        actions="{{actions}}"
        bindaction="onAction"
      />
    </root-portal>
  </block>
</view>
</scroll-view>