/* 邀请/推荐 - AROORO 奢华宠物 */

.page-container {
  min-height: 100vh;
  background: var(--background-color);
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

/* 统计卡片 */
.stats-card {
  display: flex;
  align-items: center;
  margin: 24rpx var(--page-padding, 48rpx);
  padding: 40rpx 32rpx;
  background: var(--card-color);
  border-radius: var(--zy-radius-lg);
  border: 1rpx solid var(--hairline, rgba(26,26,23,0.08));
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 300;
  color: var(--text-primary);
  letter-spacing: 0.02em;
}

.stat-label {
  font-size: 22rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.06em;
}

.stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: var(--divider-color, #ECE8DE);
}

/* 区块标题 */
.section-title {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-primary);
  padding: 0 var(--page-padding, 48rpx) 16rpx;
  letter-spacing: 0.04em;
}

/* 分享卡片 */
.share-card {
  margin: 0 var(--page-padding, 48rpx) 24rpx;
  background: var(--card-color);
  border-radius: var(--zy-radius-lg);
  overflow: hidden;
  border: 1rpx solid var(--hairline, rgba(26,26,23,0.08));
}

.share-row-btn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  width: 100%;
  background: transparent;
  border: none;
  margin: 0;
  border-radius: 0;
  line-height: normal;
  font-size: inherit;
}

.share-row-btn::after {
  border: none;
}

.share-row-btn.pressed {
  background: var(--primary-wash, #F2F5EC);
}

.share-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.share-icon {
  font-size: 36rpx;
  color: var(--text-primary);
}

/* 方案 A 发丝线分享图标（image 替代 emoji） */
.share-icon--svg {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}

.share-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.share-label {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 400;
}

.share-desc {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.share-arrow {
  font-size: 28rpx;
  color: var(--text-tertiary);
  font-weight: 300;
}

/* 发丝线右箭头（image 替代 › 符号） */
.share-arrow--svg {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

/* 推荐用户卡片 */
.user-card {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  margin: 0 var(--page-padding, 48rpx) 12rpx;
  background: var(--card-color);
  border-radius: var(--zy-radius-lg);
  border: 1rpx solid var(--hairline, rgba(26,26,23,0.08));
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
  background: var(--card-cream, #FBF9F4);
  border: 1rpx solid var(--hairline, rgba(26,26,23,0.08));
}

.user-info {
  flex: 1;
  min-width: 0;
}

.user-name {
  font-size: 28rpx;
  font-weight: 400;
  color: var(--text-primary);
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.user-date {
  font-size: 22rpx;
  color: var(--text-tertiary);
  display: block;
  margin-top: 4rpx;
}

.user-stats {
  text-align: right;
  flex-shrink: 0;
}

.user-orders {
  font-size: 22rpx;
  color: var(--text-tertiary);
  display: block;
}

.user-spent {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 400;
  display: block;
  margin-top: 4rpx;
}

/* 加载更多 */
.loading-more {
  text-align: center;
  padding: 32rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.loading-more-text {
  font-size: 24rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.12em;
}

.loading-dots {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.loading-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--accent-color, #C9A24B);
  opacity: 0.4;
}

.loading-dot:nth-child(2) {
  opacity: 0.7;
}

.loading-dot:nth-child(3) {
  opacity: 1;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
  color: var(--text-tertiary);
}

/* 发丝线空状态图标（image 替代 emoji） */
.empty-icon--svg {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  letter-spacing: 0.04em;
}

.empty-desc {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-top: 8rpx;
  text-align: center;
}

.no-more {
  text-align: center;
  padding: 32rpx;
  font-size: 22rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.06em;
}

/* 底部分享按钮 */
.share-bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx var(--page-padding, 48rpx);
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: var(--card-color);
  border-top: 1rpx solid var(--hairline, rgba(26,26,23,0.08));
  z-index: 100;
}

.share-btn {
  width: 100%;
  padding: 24rpx;
  border-radius: var(--zy-radius-pill);
  background: var(--gradient-primary);
  color: var(--text-on-primary, #F7F5EF);
  font-size: 30rpx;
  font-weight: 400;
  text-align: center;
  border: none;
  letter-spacing: 0.12em;
  box-shadow: var(--shadow-glow-primary-btn);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}

.share-btn-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.share-btn::after {
  border: none;
}

.share-btn.pressed {
  opacity: 0.85;
  transform: scale(0.98);
}

/* 入场动画 */
.stats-card {
  animation-name: fadeInUp;
  animation-duration: 480ms;
  animation-timing-function: cubic-bezier(0.19, 1, 0.22, 1);
  animation-fill-mode: forwards;
}

.share-card {
  animation-name: fadeInUp;
  animation-duration: 480ms;
  animation-timing-function: cubic-bezier(0.19, 1, 0.22, 1);
  animation-delay: 80ms;
  animation-fill-mode: forwards;
}

.section-title {
  animation-name: fadeInUp;
  animation-duration: 480ms;
  animation-timing-function: cubic-bezier(0.19, 1, 0.22, 1);
  animation-delay: 160ms;
  animation-fill-mode: forwards;
}

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}
