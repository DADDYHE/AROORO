<zy-navbar title="编辑资料" />
<scroll-view
  scroll-y
  enhanced
  refresher-enabled="{{true}}"
  refresher-triggered="{{_refresherTriggered}}"
  bindrefresherrefresh="_onRefresherRefresh"
  bindscrolltolower="_onScrollToLower"
  bindscroll="_onScroll"
  lower-threshold="100"
  style="height: calc(100vh - {{_navbarHeight}}px);"
>
<view class="page-container">
  <view class="page-content">
    <!-- 个人信息编辑 -->
    <view class="card">
      <!-- 昵称 -->
      <view class="form-item">
        <view class="form-label">昵称</view>
        <view class="form-value">
          <input
            class="form-input"
            value="{{ userInfo.nickName }}"
            placeholder="请输入昵称"
            maxlength="20"
            bindinput="onNickNameChange"
          />
        </view>
      </view>
      
      <!-- 性别 -->
      <view class="form-item">
        <view class="form-label">性别</view>
        <view class="form-value">
          <picker
            mode="selector"
            range="{{ genderOptions }}"
            range-key="text"
            value="{{ genderIndex }}"
            bindchange="onGenderChange"
            bindcancel="hideGenderPicker"
          >
            <view class="picker-trigger">
              <text class="picker-value">{{ userInfo.gender === 'male' ? '男' : userInfo.gender === 'female' ? '女' : userInfo.gender === 'secret' ? '保密' : '未设置' }}</text>
              <text class="picker-arrow">></text>
            </view>
          </picker>
        </view>
      </view>
      
      <!-- 手机号 -->
      <view class="form-item">
        <view class="form-label">手机号</view>
        <view class="form-value">
          <input
            class="form-input"
            value="{{ userInfo.phone }}"
            placeholder="请输入手机号"
            maxlength="11"
            type="number"
            bindinput="onPhoneChange"
          />
        </view>
      </view>
      
      <!-- 生日 -->
      <view class="form-item">
        <view class="form-label">生日</view>
        <view class="form-value">
          <picker
            mode="date"
            value="{{ birthdayValue }}"
            start="1900-01-01"
            end="2026-12-31"
            bindchange="onBirthdayChange"
            bindcancel="hideBirthdayPicker"
          >
            <view class="picker-trigger">
              <text class="picker-value">{{ userInfo.birthday || '未设置' }}</text>
              <text class="picker-arrow">></text>
            </view>
          </picker>
        </view>
      </view>
      
      <!-- 邮箱 -->
      <view class="form-item">
        <view class="form-label">邮箱</view>
        <view class="form-value">
          <input
            class="form-input"
            value="{{ userInfo.email }}"
            placeholder="请输入邮箱"
            bindinput="onEmailChange"
          />
        </view>
      </view>
      
      <!-- 收货地址 -->
      <view class="form-item address-item" bindtap="goToAddress">
        <view class="form-label">收货地址</view>
        <view class="form-value">
          <view class="picker-trigger">
            <text class="picker-value address-link">管理收货地址</text>
            <text class="picker-arrow">></text>
          </view>
        </view>
      </view>
    </view>
    
    <!-- 保存按钮 -->
    <view class="quick-actions">
      <button class="save-button" bindtap="saveAll">
        保存信息
      </button>
    </view>
  </view>
  

</view>
</scroll-view>