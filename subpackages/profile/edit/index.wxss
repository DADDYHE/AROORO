/* 编辑个人资料 - AROORO 奢华宠物 */

.page-container {
  min-height: 100vh;
  background-color: var(--background-color);
  display: flex;
  flex-direction: column;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.page-content {
  padding: var(--page-padding, 48rpx);
  flex: 1;
}

/* 头像区域 */
.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 0 48rpx;
}

.avatar-wrap {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.avatar-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 1rpx solid var(--hairline, rgba(26,26,23,0.08));
  background: var(--card-cream, #FBF9F4);
}

.avatar-edit-hint {
  font-size: 22rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.04em;
  margin-top: 16rpx;
}

/* 卡片样式 */
.card {
  background-color: var(--card-color);
  border: 1rpx solid var(--hairline, rgba(26,26,23,0.08));
  border-radius: var(--zy-radius-lg);
  padding: 0 32rpx;
  margin-bottom: 24rpx;
}

/* 表单项样式 */
.form-item {
  display: flex;
  align-items: center;
  padding: 32rpx 0;
  border-bottom: 1rpx solid var(--hairline, rgba(26,26,23,0.08));
}

.form-item:last-child {
  border-bottom: none;
}

/* 表单标签 */
.form-label {
  width: 180rpx;
  font-size: 28rpx;
  font-weight: 400;
  color: var(--text-secondary);
  letter-spacing: 0.04em;
  line-height: 1;
  flex-shrink: 0;
}

/* 表单值区域 */
.form-value {
  flex: 1;
  text-align: right;
  min-width: 0;
}

/* 输入框样式 */
.form-input {
  width: 100%;
  font-size: 28rpx;
  font-weight: 400;
  color: var(--text-primary);
  text-align: right;
  padding: 8rpx 0;
  border: none;
  background-color: transparent;
  letter-spacing: 0.02em;
  line-height: 1.3;
}

.form-input.placeholder {
  color: var(--text-tertiary);
}

/* 选择器触发器 */
.picker-trigger {
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

/* 选择器值 */
.picker-value {
  font-size: 28rpx;
  font-weight: 400;
  color: var(--text-primary);
  margin-right: 12rpx;
  letter-spacing: 0.02em;
}

.picker-value.placeholder {
  color: var(--text-tertiary);
}

/* 选择器箭头 */
.picker-arrow {
  font-size: 22rpx;
  color: var(--text-tertiary);
  font-weight: 300;
}

/* 地址项特殊样式 */
.address-item .address-arrow-group {
  display: flex;
  gap: 8rpx;
}

/* 保存按钮 */
.save-button {
  width: 100%;
  height: 96rpx;
  background: var(--gradient-primary);
  color: var(--text-on-primary, #F7F5EF);
  font-size: 30rpx;
  font-weight: 400;
  border-radius: var(--zy-radius-pill);
  border: none;
  margin-top: 48rpx;
  letter-spacing: 0.12em;
  box-shadow: var(--shadow-glow-primary-btn);
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.save-button.pressed {
  opacity: 0.85;
  transform: scale(0.98);
}

/* 快速操作按钮区域 */
.quick-actions {
  padding: 0;
  margin-bottom: 40rpx;
}

/* 选择器样式 */
.picker-cancel,
.picker-confirm {
  font-size: 30rpx;
  font-weight: 400;
  letter-spacing: 0.06em;
}

.picker-confirm {
  color: var(--primary-color);
}

.picker-cancel {
  color: var(--text-tertiary);
}

/* 入场动画 */
.page-content {
  animation-name: fadeInUp;
  animation-duration: 480ms;
  animation-timing-function: cubic-bezier(0.19, 1, 0.22, 1);
  animation-fill-mode: forwards;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(24rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
