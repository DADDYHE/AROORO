/* 个人信息编辑页面样式 - 巴黎世家风格 */
.page-container {
  min-height: 100vh;
  background-color: var(--surface-tint);
  display: flex;
  flex-direction: column;
}

.page-content {
  padding: 40rpx;
  flex: 1;
}

/* 卡片样式 */
.card {
  background-color: var(--card-color);
  border: 1rpx solid #f0f0f0;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.06);
}

/* 表单项样式 */
.form-item {
  display: flex;
  align-items: center;
  padding: 40rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-item:last-child {
  border-bottom: none;
}

/* 表单标签 */
.form-label {
  width: 180rpx;
  font-size: 28rpx;
  font-weight: 900;
  color: #000000;
  text-transform: uppercase;
  letter-spacing: 3rpx;
  line-height: 1;
}

/* 表单值区域 */
.form-value {
  flex: 1;
  text-align: right;
}

/* 输入框样式 */
.form-input {
  width: 100%;
  font-size: 28rpx;
  font-weight: 500;
  color: #000000;
  text-align: right;
  padding: 10rpx 0;
  border: none;
  background-color: transparent;
  letter-spacing: 1rpx;
  line-height: 1.2;
}

.form-input::placeholder {
  color: var(--text-tertiary);
  font-weight: 500;
  letter-spacing: 1rpx;
}

/* 选择器触发器 */
.picker-trigger {
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

/* 选择器值 */
.picker-value {
  font-size: 28rpx;
  font-weight: 500;
  color: #000000;
  margin-right: 20rpx;
  letter-spacing: 1rpx;
}

/* 选择器箭头 */
.picker-arrow {
  font-size: 24rpx;
  color: #000000;
  font-weight: 900;
  text-transform: uppercase;
}

/* 地址项特殊样式 */
.address-item .address-arrow-group {
  display: flex;
  gap: 8rpx;
}

/* 保存按钮 */
.save-button {
  width: 100%;
  height: 88rpx;
  background-color: var(--overlay-color);
  color: var(--card-color);
  font-size: 32rpx;
  font-weight: 900;
  border-radius: 20rpx;
  border: none;
  margin-top: 40rpx;
  text-transform: uppercase;
  letter-spacing: 4rpx;
  box-shadow: 0 8rpx 25rpx rgba(0, 0, 0, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

/* 快速操作按钮区域 */
.quick-actions {
  padding: 0;
  margin-bottom: 40rpx;
}

/* 选择器样式 - 保持与原生一致 */
.picker-cancel,
.picker-confirm {
  font-size: 32rpx;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 4rpx;
}

.picker-confirm {
  color: #000000;
}

.picker-cancel {
  color: var(--gray-700);
}