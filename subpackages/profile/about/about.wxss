/* 关于页 - AROORO 奢华宠物 */

.page-container {
  min-height: 100vh;
  background-color: var(--card-cream, #FBF9F4);
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.page-content {
  padding: var(--page-padding, 48rpx);
}

/* Logo 区域 */
.logo-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 64rpx;
  padding-top: 32rpx;
}

.logo {
  width: 180rpx;
  height: 180rpx;
  margin-bottom: 24rpx;
  border-radius: var(--zy-radius-lg);
}

.app-name {
  font-size: 36rpx;
  font-weight: 300;
  color: var(--text-primary);
  letter-spacing: 0.12em;
}

/* 信息区块 */
.info-section {
  background-color: var(--card-color);
  border-radius: var(--zy-radius-lg);
  padding: 0 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--hairline);
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--hairline);
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: var(--text-secondary);
  font-weight: 400;
}

.info-value {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 400;
  letter-spacing: 0.02em;
}

/* 描述区块 */
.description {
  background-color: var(--card-color);
  border-radius: var(--zy-radius-lg);
  padding: 40rpx 32rpx;
  border: 1rpx solid var(--hairline);
}

.description-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.75;
  letter-spacing: 0.02em;
}

/* 入场动画 */
.logo-container {
  animation-name: fadeInDown;
  animation-duration: 600ms;
  animation-timing-function: cubic-bezier(0.19, 1, 0.22, 1);
  animation-fill-mode: forwards;
}

.info-section {
  animation-name: fadeInUp;
  animation-duration: 520ms;
  animation-timing-function: cubic-bezier(0.19, 1, 0.22, 1);
  animation-delay: 120ms;
  animation-fill-mode: forwards;
}

.description {
  animation-name: fadeInUp;
  animation-duration: 520ms;
  animation-timing-function: cubic-bezier(0.19, 1, 0.22, 1);
  animation-delay: 200ms;
  animation-fill-mode: forwards;
}

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes fadeInDown {
  from { opacity: 0; transform: translateY(-20rpx); }
  to { opacity: 1; transform: translateY(0); }
}
