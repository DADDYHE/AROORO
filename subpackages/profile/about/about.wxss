.page-container {
  min-height: 100vh;
  background-color: var(--background-color);
}

.page-content {
  padding: 40rpx;
}

.logo-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.logo {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 20rpx;
}

.app-name {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.info-section {
  background-color: #FAFAF6;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.info-value {
  font-size: 28rpx;
  color: var(--text-primary);
}

.description {
  background-color: #FAFAF6;
  border-radius: 16rpx;
  padding: 30rpx;
}

.description-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 40rpx;
}
