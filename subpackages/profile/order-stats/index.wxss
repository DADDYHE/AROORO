/* 订单统计 - AROORO 奢华宠物 */
/* 令牌由 app.wxss 全局注入到 page，页面不得再 import variables.wxss —
   页面 wxss 在 app.wxss 之后加载，同为 page 选择器会反向覆盖 theme-teal，
   把旧橄榄坐标系带回来（详见 #10）。 */

.page {
  min-height: 100vh;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

/* 统计摘要 */
.stats-summary {
  margin: 24rpx var(--page-padding, 48rpx);
  background: var(--card-color);
  border-radius: var(--zy-radius-lg);
  padding: 40rpx 0;
  display: flex;
  align-items: center;
  justify-content: space-around;
  border: 1rpx solid var(--hairline, rgba(26,26,23,0.08));
}

.summary-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.summary-num {
  font-size: 44rpx;
  font-weight: 300;
  color: var(--text-primary);
  line-height: 1;
  letter-spacing: 0.02em;
}

.summary-label {
  font-size: 22rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.06em;
}

.summary-divider {
  width: 1rpx;
  height: 56rpx;
  background: var(--divider-color, #ECE8DE);
}

/* 状态筛选标签 */
.status-tabs {
  margin: 0 var(--page-padding, 48rpx) 24rpx;
  display: flex;
  gap: 12rpx;
}

.status-tab {
  flex: 1;
  padding: 16rpx 0;
  text-align: center;
  background: var(--card-color);
  border-radius: var(--zy-radius-pill);
  border: 1rpx solid var(--hairline, rgba(26,26,23,0.08));
}

.status-tab.pressed {
  opacity: 0.7;
}

.status-tab.active {
  background: var(--primary-color);
  border-color: var(--primary-color);
}

.status-tab.active .status-tab-text {
  color: var(--card-color);
}

.status-tab-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 400;
  letter-spacing: 0.04em;
}

/* 订单列表 */
.orders-list {
  margin: 0 var(--page-padding, 48rpx);
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.order-card {
  background: var(--card-color);
  border-radius: var(--zy-radius-lg);
  padding: 28rpx;
  border: 1rpx solid var(--hairline, rgba(26,26,23,0.08));
}

.order-card.pressed {
  opacity: 0.7;
}

.order-title {
  font-size: 28rpx;
  font-weight: 400;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  line-height: 1.4;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.order-cover-row {
  margin-bottom: 16rpx;
  border-radius: var(--zy-radius-md);
  overflow: hidden;
}

.order-cover {
  width: 100%;
  height: 240rpx;
  display: block;
  background: var(--card-cream, #FBF9F4);
}

.order-info {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
  gap: 8rpx;
}

.order-info-icon-img {
  width: 26rpx;
  height: 26rpx;
  flex-shrink: 0;
}

.order-info-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.4;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.order-status {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 400;
  letter-spacing: 0.04em;
}

.order-price {
  font-size: 30rpx;
  font-weight: 400;
  color: var(--text-primary);
}

.order-body {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.order-time {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

/* 喂养标签 */
.feeding-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.feeding-tag {
  font-size: 20rpx;
  color: var(--activity-primary);
  background: var(--activity-tint);
  padding: 4rpx 14rpx;
  border-radius: var(--zy-radius-sm);
  font-weight: 400;
  letter-spacing: 0.02em;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 120rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.04em;
}

/* 加载更多 */
.loading-more {
  text-align: center;
  padding: 32rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.loading-more-text {
  font-size: 24rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.12em;
}

.loading-dots {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.loading-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--primary-color);
  opacity: 0.4;
}

.loading-dot:nth-child(2) {
  opacity: 0.7;
}

.loading-dot:nth-child(3) {
  opacity: 1;
}

/* 商城订单卡片 */
.mall-card {
  border-left: 3rpx solid var(--mall-primary, #C9A24B);
}

.mall-product-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.mall-product-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: var(--zy-radius-md);
  flex-shrink: 0;
  background: var(--card-cream, #FBF9F4);
}

.mall-product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
  padding: 4rpx 0;
}

.mall-product-name {
  font-size: 28rpx;
  font-weight: 400;
  color: var(--text-primary);
  line-height: 1.4;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.mall-product-sku {
  font-size: 22rpx;
  color: var(--text-tertiary);
  line-height: 1.4;
}

.mall-product-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mall-product-price {
  font-size: 28rpx;
  font-weight: 400;
  color: var(--text-primary);
}

.mall-product-qty {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.mall-receiver {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.mall-status {
  color: var(--text-primary);
}

.mall-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--hairline, rgba(26,26,23,0.08));
}

.mall-cancel-btn {
  font-size: 24rpx;
  color: var(--error-color);
  padding: 8rpx 24rpx;
  border: 1rpx solid rgba(184, 92, 60, 0.2);
  border-radius: var(--zy-radius-pill);
  background: rgba(184, 92, 60, 0.06);
}

.mall-cancel-btn.pressed {
  opacity: 0.7;
}

/* 团购卡片 */
.group-card {
  border-left: 3rpx solid var(--tuan-primary);
}

.group-status {
  color: var(--tuan-primary);
}

.group-price {
  color: var(--tuan-primary);
}

/* 入场动画 */
.stats-summary {
  animation-name: fadeInUp;
  animation-duration: 480ms;
  animation-timing-function: cubic-bezier(0.19, 1, 0.22, 1);
  animation-fill-mode: forwards;
}

.status-tabs {
  animation-name: fadeInUp;
  animation-duration: 480ms;
  animation-timing-function: cubic-bezier(0.19, 1, 0.22, 1);
  animation-delay: 80ms;
  animation-fill-mode: forwards;
}

.orders-list {
  animation-name: fadeInUp;
  animation-duration: 480ms;
  animation-timing-function: cubic-bezier(0.19, 1, 0.22, 1);
  animation-delay: 160ms;
  animation-fill-mode: forwards;
}

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}
