@import '../../../styles/variables.wxss';

.page {
  background: var(--background-color);
  min-height: 100vh;
  padding-bottom: 48rpx;
}

.stats-summary {
  margin: 120rpx 32rpx 24rpx;
  background: var(--card-color);
  border-radius: 36rpx;
  padding: 32rpx 0;
  display: flex;
  align-items: center;
  justify-content: space-around;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.summary-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.summary-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1;
}

.summary-label {
  font-size: 22rpx;
  color: var(--gray-500);
  letter-spacing: 1rpx;
}

.summary-divider {
  width: 1rpx;
  height: 60rpx;
  background: var(--divider-color);
}

.status-tabs {
  margin: 0 32rpx 24rpx;
  display: flex;
  gap: 16rpx;
}

.status-tab {
  flex: 1;
  padding: 16rpx 0;
  text-align: center;
  background: var(--card-color);
  border-radius: 20rpx;
  transition: all 0.2s ease;
}

.status-tab.active {
  background: var(--text-primary);
}

.status-tab.active .status-tab-text {
  color: var(--card-color);
}

.status-tab-text {
  font-size: 26rpx;
  color: var(--gray-700);
  font-weight: 500;
}

.orders-list {
  margin: 0 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.order-card {
  background: var(--card-color);
  border-radius: 28rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.order-card:active {
  transform: scale(0.99);
}

.order-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.order-cover-row {
  margin-bottom: 16rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.order-cover {
  width: 100%;
  height: 240rpx;
  display: block;
  background: var(--background-color);
}

.order-info {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
  gap: 8rpx;
}

.order-info-icon-img {
  width: 26rpx;
  height: 26rpx;
  flex-shrink: 0;
}

.order-info-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.4;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.order-status {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.order-price {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.order-body {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.order-time {
  font-size: 22rpx;
  color: var(--gray-500);
}

.feeding-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.feeding-tag {
  font-size: 20rpx;
  color: var(--activity-primary);
  background: rgba(78, 205, 196, 0.1);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.empty-state {
  text-align: center;
  padding: 120rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: var(--gray-500);
}

.loading-more {
  text-align: center;
  padding: 32rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.loading-more-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 4rpx;
}

.loading-dots {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.loading-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--activity-primary);
  animation: dotBounce 1.4s ease-in-out infinite;
}

.loading-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.loading-dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes dotBounce {
  0%, 80%, 100% { opacity: 0.3; transform: translateY(0); }
  40% { opacity: 1; transform: translateY(-12rpx); }
}

.mall-card {
  border-left: 4rpx solid var(--mall-primary);
}

.mall-product-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.mall-product-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: var(--background-color);
}

.mall-product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
  padding: 4rpx 0;
}

.mall-product-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.mall-product-sku {
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.4;
}

.mall-product-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mall-product-price {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.mall-product-qty {
  font-size: 22rpx;
  color: var(--gray-500);
}

.mall-receiver {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.mall-status {
  color: var(--mall-primary);
}

.mall-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--divider-color);
}

.mall-cancel-btn {
  font-size: 24rpx;
  color: var(--error-color);
  padding: 8rpx 24rpx;
  border: 1rpx solid rgba(255, 59, 48, 0.3);
  border-radius: 24rpx;
  background: rgba(255, 59, 48, 0.05);
}

.mall-cancel-btn:active {
  background: rgba(255, 59, 48, 0.12);
}

.group-card {
  border-left: 4rpx solid #FF6B35;
}

.group-status {
  color: #FF6B35;
}

.group-price {
  color: #FF6B35;
}
