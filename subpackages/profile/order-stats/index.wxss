/* ================================================================
   订单统计 ·「订单台账」— AROORO Haute-Luxury v2
   对齐 order-detail「纸上卷宗」语言：暖石纸面 + hairline 台账行
   + 编辑式汇总数字 + 金线目录 tab + 台账落款。去白卡。
   token 来源：styles/variables.wxss → theme-teal.wxss（app.wxss 注入）
   ================================================================ */

.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* ================================================================
   卷宗头：金 accent bar + eyebrow + 编辑式汇总三列
   ================================================================ */
.ledger-head {
  padding: 40rpx var(--page-padding, 48rpx) 28rpx;
  border-bottom: 1rpx solid var(--hairline);
}

.brand-accent-bar {
  width: 48rpx;
  height: 2rpx;
  background: var(--accent-color);
  margin-bottom: 18rpx;
}

.ledger-eyebrow {
  display: block;
  font-size: 20rpx;
  font-weight: 400;
  letter-spacing: 0.32em;
  color: var(--accent-color);
  margin-bottom: 24rpx;
}

.ledger-summary {
  display: flex;
  align-items: flex-end;
}

.ledger-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.ledger-divider {
  width: 1rpx;
  height: 56rpx;
  background: var(--hairline);
  margin: 0 28rpx;
  align-self: flex-end;
  margin-bottom: 6rpx;
}

.ledger-num {
  font-size: 48rpx;
  font-weight: 300;
  letter-spacing: 0.02em;
  line-height: 1.1;
  color: var(--text-primary);
}

.ledger-amount-row {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
}

.ledger-symbol {
  font-size: 24rpx;
  color: var(--text-primary);
}

.ledger-label {
  font-size: 20rpx;
  letter-spacing: 0.14em;
  color: var(--text-tertiary);
}

/* ================================================================
   状态筛选：金线目录 tab（文字 + 选中金下划线）
   ================================================================ */
/* 节头：金 eyebrow 式小节标题 */
.section-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 28rpx 0 20rpx;
  padding: 26rpx 28rpx;
  background-color: var(--card-cream, #FBF9F4);
  border: 1rpx solid var(--hairline);
  border-radius: 16rpx;
  transition: background-color 160ms ease, opacity 160ms ease;
}

.section-head.pressed {
  background-color: var(--accent-soft, #F0E6D0);
  opacity: 0.9;
}

.section-name {
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 0.06em;
  color: var(--text-primary);
}

.section-count {
  font-size: 22rpx;
  letter-spacing: 0.08em;
  color: var(--accent-color);
}

.section-rule {
  flex: 1;
  height: 1rpx;
  background: var(--hairline);
}

/* 展开/收起箭头（css chevron，展开朝下、收起朝右） */
.section-chevron-ring {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 1rpx solid var(--lux-hairline-gold);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.section-chevron {
  width: 12rpx;
  height: 12rpx;
  border-right: 2rpx solid var(--text-tertiary);
  border-bottom: 2rpx solid var(--text-tertiary);
  transform: rotate(45deg);
  transition: transform 200ms ease;
  flex-shrink: 0;
}

.section-chevron--collapsed {
  transform: rotate(-45deg);
}

.ledger-row {
  display: flex;
  gap: 20rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--hairline);
  transition: opacity 160ms ease;
}

.ledger-row.pressed {
  opacity: 0.75;
}

/* 行首缩略图（商城商品/活动封面） */
.ledger-thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: var(--card-cream, #FBF9F4);
  border: 1rpx solid var(--hairline);
}

.ledger-row-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

/* 标题 + 状态章 */
.ledger-row-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.ledger-title {
  flex: 1;
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 0.02em;
  color: var(--text-primary);
  line-height: 1.4;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.ledger-status {
  flex-shrink: 0;
  font-size: 20rpx;
  letter-spacing: 0.1em;
  color: var(--accent-color);
  border: 1rpx solid var(--lux-hairline-gold);
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

/* 元信息行 */
.ledger-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 8rpx;
}

.ledger-icon {
  width: 22rpx;
  height: 22rpx;
  flex-shrink: 0;
  opacity: 0.6;
}

.ledger-meta-text {
  font-size: 22rpx;
  letter-spacing: 0.03em;
  color: var(--text-tertiary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 底部：时间 + 编辑式价格 */
.ledger-row-bottom {
  margin-top: 16rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.ledger-time {
  font-size: 20rpx;
  letter-spacing: 0.04em;
  color: var(--text-tertiary);
}

.ledger-price-row {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
}

.ledger-price-symbol {
  font-size: 20rpx;
  color: var(--text-primary);
}

.ledger-price {
  font-size: 34rpx;
  font-weight: 300;
  letter-spacing: 0.02em;
  color: var(--text-primary);
}

.ledger-price-unit {
  font-size: 20rpx;
  color: var(--text-tertiary);
}

/* 取消入口 */
.ledger-cancel {
  margin-top: 14rpx;
  display: flex;
  justify-content: flex-end;
}

.ledger-cancel-btn {
  font-size: 22rpx;
  letter-spacing: 0.06em;
  color: var(--text-secondary);
  border: 1rpx solid var(--border-color, #E2DED3);
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
}

.ledger-cancel-btn.pressed {
  opacity: 0.7;
}

/* ================================================================
   空态：金 hairline 圆环
   ================================================================ */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  padding: 120rpx 0 80rpx;
}

.empty-ring {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 1rpx solid var(--lux-hairline-gold);
}

.empty-text {
  font-size: 24rpx;
  letter-spacing: 0.2em;
  color: var(--text-tertiary);
}

/* ================================================================
   台账落款
   ================================================================ */
.ledger-foot {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  padding: 48rpx var(--page-padding, 48rpx) 24rpx;
}

.ledger-foot-line {
  width: 64rpx;
  height: 1rpx;
  background: var(--hairline);
}

.ledger-foot-text {
  font-size: 20rpx;
  letter-spacing: 0.3em;
  color: var(--text-tertiary);
}

/* ================================================================
   加载更多（lux-silk 全局样式）+ 入场动画
   ================================================================ */
.loading-more {
  padding: 32rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.loading-more-text {
  font-size: 22rpx;
  letter-spacing: 0.2em;
  color: var(--text-tertiary);
}

/* 入场动画已移除（2026-09-06）：opacity:0 起始动画在折叠显隐/分页 setData 时重放或中断，
   造成节内容闪烁与「消失」——内容稳定性优先于入场动效 */
