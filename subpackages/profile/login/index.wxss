.gallery-page {
  min-height: 100vh;
  background: var(--background-color);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx;
  box-sizing: border-box;
}

.gallery-space {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0;
}

.brand-exhibit {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.brand-cn {
  font-size: 56rpx;
  font-weight: 300;
  color: var(--text-primary);
  letter-spacing: 0.15em;
  line-height: 1.2;
}

.brand-en {
  font-size: 20rpx;
  font-weight: 400;
  color: rgba(59, 191, 181, 0.5);
  letter-spacing: 0.4em;
  margin-top: 12rpx;
  line-height: 1;
}

.brand-line {
  width: 80rpx;
  height: 3rpx;
  background: linear-gradient(90deg, #3BBFB5 0%, #35A99C 100%);
  margin-top: 32rpx;
  border-radius: 2rpx;
}

.exhibit-card {
  width: 100%;
  background: var(--card-color);
  border-radius: 24rpx;
  padding: 56rpx 48rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(134, 134, 139, 0.08);
  position: relative;
  overflow: hidden;
}

.exhibit-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: linear-gradient(90deg, #3BBFB5 0%, #25A89B 50%, transparent 100%);
}

.exhibit-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 48rpx;
  align-self: flex-start;
}

.label-text {
  font-size: 22rpx;
  font-weight: 400;
  color: rgba(59, 191, 181, 0.6);
  letter-spacing: 0.1em;
}

.label-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #3BBFB5;
  opacity: 0.4;
}

.form-avatar-row {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 48rpx;
}

.avatar-frame {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-glow {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(59, 191, 181, 0.12) 0%, rgba(59, 191, 181, 0) 70%);
}

.avatar-picker-wrap {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 2rpx solid rgba(59, 191, 181, 0.25);
  position: relative;
  z-index: 2;
  background: var(--surface-tint);
}

.avatar-picker-btn-transparent {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 160rpx;
  height: 200rpx;
  opacity: 0;
  padding: 0;
  margin: 0;
  z-index: 3;
}

.avatar-picker-btn-transparent::after {
  border: none;
}

.avatar-preview {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
}

.avatar-placeholder {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--surface-tint);
  box-sizing: border-box;
}

.avatar-placeholder-icon {
  font-size: 48rpx;
  color: var(--text-tertiary);
  line-height: 1;
  font-weight: 200;
}

.avatar-caption {
  font-size: 20rpx;
  color: rgba(59, 191, 181, 0.5);
  letter-spacing: 0.08em;
  margin-top: 20rpx;
}

.form-nickname-row {
  width: 100%;
}

.nickname-label {
  font-size: 20rpx;
  font-weight: 400;
  color: rgba(59, 191, 181, 0.5);
  letter-spacing: 0.08em;
  margin-bottom: 16rpx;
  display: block;
}

.nickname-input-wrap {
  position: relative;
  width: 100%;
}

.nickname-input {
  width: 100%;
  height: 80rpx;
  background: transparent;
  padding: 0 0 16rpx 0;
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 400;
  letter-spacing: 0.02em;
  box-sizing: border-box;
}

.nickname-line {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 1rpx;
  background: rgba(59, 191, 181, 0.2);
}

.nickname-line::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 2rpx;
  background: linear-gradient(90deg, #3BBFB5 0%, #35A99C 100%);
}

.action-exhibit {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 64rpx;
}

.confirm-btn {
  width: 320rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #3BBFB5 0%, #35A99C 100%);
  color: var(--card-color);
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 0.15em;
  border-radius: 48rpx;
  border: none;
  padding: 0;
  box-shadow: 0 8rpx 24rpx rgba(59, 191, 181, 0.25);
  position: relative;
  overflow: hidden;
}

.confirm-btn::after {
  border: none;
}

.confirm-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
}

.confirm-btn.disabled {
  background: rgba(59, 191, 181, 0.25);
  color: rgba(255, 255, 255, 0.6);
  box-shadow: none;
}

.cancel-link {
  margin-top: 32rpx;
  padding: 16rpx 0;
}

.cancel-text {
  font-size: 24rpx;
  color: var(--gray-500);
  letter-spacing: 0.05em;
}
