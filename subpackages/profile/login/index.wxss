/* 登录页 - AROORO 奢华宠物 */

.gallery-page {
  min-height: 100vh;
  background: var(--card-cream, #FBF9F4);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 var(--page-padding, 48rpx);
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.gallery-space {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0;
}

.brand-exhibit {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.brand-cn {
  font-size: 56rpx;
  font-weight: 300;
  color: var(--text-primary);
  letter-spacing: 0.08em;
  line-height: 1.2;
}

.brand-en {
  font-size: 20rpx;
  font-weight: 400;
  color: var(--text-tertiary);
  letter-spacing: 0.3em;
  margin-top: 12rpx;
  line-height: 1;
}

.brand-line {
  width: 64rpx;
  height: 1rpx;
  background: var(--accent-color, #C9A24B);
  margin-top: 32rpx;
}

.exhibit-card {
  width: 100%;
  background: var(--card-color);
  border-radius: var(--zy-radius-lg);
  padding: 56rpx 48rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 1rpx solid var(--hairline, rgba(26,26,23,0.08));
  position: relative;
  overflow: hidden;
}

.exhibit-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 48rpx;
  align-self: flex-start;
}

.label-text {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--text-tertiary);
  letter-spacing: 0.1em;
}

.label-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: var(--accent-color, #C9A24B);
  opacity: 0.5;
}

/* 头像区域 */
.form-avatar-row {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 48rpx;
}

.avatar-frame {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-glow {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(201,162,75,0.08) 0%, rgba(201,162,75,0) 70%);
}

.avatar-picker-wrap {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 1rpx solid var(--hairline);
  position: relative;
  z-index: 2;
  background: var(--card-cream, #FBF9F4);
}

.avatar-picker-btn-transparent {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 160rpx;
  height: 200rpx;
  opacity: 0;
  padding: 0;
  margin: 0;
  z-index: 3;
}

.avatar-picker-btn-transparent::after {
  border: none;
}

.avatar-preview {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
}

.avatar-placeholder {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--card-cream, #FBF9F4);
  box-sizing: border-box;
}

.avatar-placeholder-icon {
  font-size: 48rpx;
  color: var(--text-tertiary);
  line-height: 1;
  font-weight: 300;
}

.avatar-caption {
  font-size: 20rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.06em;
  margin-top: 20rpx;
}

/* 昵称输入 */
.form-nickname-row {
  width: 100%;
}

.nickname-label {
  font-size: 20rpx;
  font-weight: 400;
  color: var(--text-tertiary);
  letter-spacing: 0.08em;
  margin-bottom: 16rpx;
  display: block;
}

.nickname-input-wrap {
  position: relative;
  width: 100%;
}

.nickname-input {
  width: 100%;
  height: 80rpx;
  background: transparent;
  padding: 0 0 16rpx 0;
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 300;
  letter-spacing: 0.02em;
  box-sizing: border-box;
}

.nickname-line {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 1rpx;
  background: var(--hairline);
}

/* 操作按钮 */
.action-exhibit {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 64rpx;
}

.confirm-btn {
  width: 320rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: var(--gradient-primary);
  color: var(--text-on-primary, #F7F5EF);
  font-size: 28rpx;
  font-weight: 400;
  letter-spacing: 0.12em;
  border-radius: var(--zy-radius-pill);
  border: none;
  padding: 0;
  box-shadow: var(--shadow-glow-primary-btn);
  position: relative;
  overflow: hidden;
}

.confirm-btn::after {
  border: none;
}

.confirm-btn.pressed {
  opacity: 0.85;
  transform: scale(0.98);
}

.confirm-btn.disabled {
  background: var(--primary-tint, #E8ECE2);
  color: var(--text-tertiary);
  box-shadow: none;
}

.cancel-link {
  margin-top: 32rpx;
  padding: 16rpx 0;
}

.cancel-text {
  font-size: 24rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.06em;
}

/* 入场动画 */
.brand-exhibit {
  animation-name: fadeInDown;
  animation-duration: 600ms;
  animation-timing-function: cubic-bezier(0.19, 1, 0.22, 1);
  animation-fill-mode: forwards;
}

.exhibit-card {
  animation-name: fadeInUp;
  animation-duration: 600ms;
  animation-timing-function: cubic-bezier(0.19, 1, 0.22, 1);
  animation-delay: 120ms;
  animation-fill-mode: forwards;
}

.action-exhibit {
  animation-name: fadeInUp;
  animation-duration: 600ms;
  animation-timing-function: cubic-bezier(0.19, 1, 0.22, 1);
  animation-delay: 240ms;
  animation-fill-mode: forwards;
}

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes fadeInDown {
  from { opacity: 0; transform: translateY(-24rpx); }
  to { opacity: 1; transform: translateY(0); }
}
