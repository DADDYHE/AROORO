<zy-navbar title="登录" transparent="{{true}}" />
<scroll-view
  scroll-y
  enhanced
  refresher-enabled="{{true}}"
  refresher-triggered="{{_refresherTriggered}}"
  bindrefresherrefresh="_onRefresherRefresh"
  bindscrolltolower="_onScrollToLower"
  bindscroll="_onScroll"
  lower-threshold="100"
  style="height: calc(100vh - {{_navbarHeight}}px);"
>
<view class="gallery-page">
  <view class="gallery-space">
    <view class="brand-exhibit">
      <text class="brand-cn">AROORO</text>
      <text class="brand-slogan">安心呼噜，放心托付</text>
      <view class="brand-line"></view>
    </view>

    <view class="exhibit-card">
      <view class="exhibit-label">
        <text class="label-text">身份</text>
        <view class="label-dot"></view>
      </view>

      <view class="form-avatar-row">
        <view class="avatar-frame">
          <view class="avatar-glow"></view>
          <view class="avatar-picker-wrap">
            <image
              wx:if="{{avatarUrl}}"
              class="avatar-preview"
              src="{{avatarUrl}}"
              mode="aspectFill"
             lazy-load
            />
            <view wx:else class="avatar-placeholder">
              <text class="avatar-placeholder-icon">+</text>
            </view>
          </view>
        </view>
        <button
          class="avatar-picker-btn-transparent"
          open-type="chooseAvatar"
          bindchooseavatar="onChooseAvatar"
        />
        <text class="avatar-caption">选择头像</text>
      </view>

      <view class="form-nickname-row">
        <text class="nickname-label">你的名字</text>
        <view class="nickname-input-wrap">
          <input
            class="nickname-input"
            type="nickname"
            placeholder="点击获取微信昵称"
            value="{{nickName}}"
            bindinput="onNicknameInput"
            bindblur="onNicknameBlur"
          />
          <view class="nickname-line"></view>
        </view>
      </view>
    </view>

    <view class="action-exhibit">
      <button
        class="confirm-btn {{canSubmit ? '' : 'disabled'}}"
        bindtap="onConfirm"
        disabled="{{!canSubmit}}"
       hover-class="confirm-btn pressed" hover-stay-time="80">
        开始呼噜
      </button>
      <view class="cancel-link" bindtap="onCancel">
        <text class="cancel-text">{{t.BIZ_FQWK14}}</text>
      </view>
    </view>
  </view>
</view>
</scroll-view>
