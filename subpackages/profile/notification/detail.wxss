/* 通知详情 - AROORO 奢华宠物 · B1 hero + A 纸面流 */

.page-container {
  padding: 0 var(--page-padding, 48rpx);
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

/* 正文：纸面段落，不用白卡 */
.detail-body {
  padding: 32rpx 0;
}

.notification-body {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.75;
  letter-spacing: 0.02em;
}

/* 入场动画 */
.detail-body {
  animation-name: zy-fade-in-up;
  animation-duration: 480ms;
  animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  animation-fill-mode: forwards;
}
