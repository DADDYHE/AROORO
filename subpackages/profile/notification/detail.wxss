.page-container { min-height: 100vh; background: #f5f5f7; padding: 24rpx; }
.detail-card { background: #ffffff; border-radius: 20rpx; padding: 24rpx; margin-bottom: 16rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04); }
.notification-title { font-size: 34rpx; font-weight: 700; color: #1d1d1f; display: block; margin-bottom: 8rpx; }
.notification-date { font-size: 22rpx; color: #aeaeb2; display: block; }
.notification-body { font-size: 28rpx; color: #424245; line-height: 1.8; }
