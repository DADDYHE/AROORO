/* 通知列表 - AROORO 奢华宠物 · B1 hero + A 纸面流 */

.page-container {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

/* 顶部栏 */
.header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx var(--page-padding, 48rpx);
  border-bottom: 1rpx solid rgba(26, 26, 23, 0.14);
}

.unread-text {
  font-size: 24rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.04em;
}

.mark-read-btn {
  transition: transform 160ms ease, opacity 160ms ease;
  padding: 10rpx 24rpx;
  background: var(--primary-wash, #F2F5EC);
  border-radius: var(--zy-radius-lg);
  font-size: 22rpx;
  color: var(--primary-color);
  letter-spacing: 0.04em;
  font-weight: 400;
}

.mark-read-btn.pressed {
  opacity: 0.7;
}

/* 通知列表 */
.notification-list {
  padding: 16rpx var(--page-padding, 48rpx);
}

/* 通知行：拆白卡，纸面行线流式列表 */
.notification-card {
  transition: transform 160ms ease, opacity 160ms ease;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  background: transparent;
  padding: 28rpx 0;
  margin-bottom: 0;
  border: none;
  border-bottom: 1rpx solid rgba(26, 26, 23, 0.14);
  position: relative;
}

.notification-card.pressed {
  opacity: 0.7;
}

/* 未读：浅绿底 + 左侧金条（信息承载，非装饰） */
.notification-card.unread {
  background: var(--primary-wash, #F2F5EC);
  padding-left: 20rpx;
  border-left: 4rpx solid var(--lux-gold-500);
}

.notification-icon {
  font-size: 32rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
  color: var(--primary-color);
}

.notification-content {
  flex: 1;
  min-width: 0;
}

.notification-title {
  font-size: 28rpx;
  font-weight: 400;
  color: var(--text-primary);
  display: block;
  margin-bottom: 6rpx;
  letter-spacing: 0.02em;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.notification-card:not(.unread) .notification-title {
  color: var(--text-secondary);
}

.notification-body {
  font-size: 24rpx;
  color: var(--text-tertiary);
  display: block;
  margin-bottom: 8rpx;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.notification-date {
  font-size: 20rpx;
  color: var(--text-tertiary);
  display: block;
  letter-spacing: 0.02em;
}

/* 未读指示器 */
.unread-dot {
  position: absolute;
  top: 28rpx;
  right: 28rpx;
  width: 12rpx;
  height: 12rpx;
  background: var(--accent-color);
  border-radius: 50%;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  animation: zy-breathe-glow 4000ms ease-in-out infinite;
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.04em;
}

/* 入场动画 */
.header-bar {
  animation-name: zy-fade-in-down;
  animation-duration: 480ms;
  animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  animation-fill-mode: forwards;
}

.notification-list {
  animation-name: zy-fade-in-up;
  animation-duration: 480ms;
  animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  animation-fill-mode: forwards;
}

