.page-container {
  min-height: 100vh;
  background-color: var(--background-color);
}

.page-content {
  padding: 30rpx;
}

.section {
  background-color: #FAFAF6;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 20rpx;
  display: block;
}

.section-subtitle {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 15rpx;
  display: block;
}

.section-content {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 40rpx;
}
