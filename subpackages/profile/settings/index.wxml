<view class="page-container">
  <view class="page-content">
    <!-- 个人信息部分 -->
    <view class="card">
      <!-- 编辑个人信息 -->
      <view class="form-item" bindtap="editProfile">
        <view class="form-label">个人信息</view>
        <view class="form-value">
          <view class="picker-trigger">
            <text class="picker-value">点击修改</text>
            <text class="picker-arrow">></text>
          </view>
        </view>
      </view>
      
      <!-- 角色信息 -->
      <view class="form-item">
        <view class="form-label">当前角色</view>
        <view class="form-value">
          <text class="form-value-text">{{ userRole === 'owner' ? '宠物主人' : '寄养家庭' }}</text>
        </view>
      </view>
    </view>
    
    <!-- 其他设置 -->
    <view class="card">
      <!-- 缓存管理 -->
      <view class="form-item" bindtap="clearCache">
        <view class="form-label">缓存管理</view>
        <view class="form-value">
          <view class="picker-trigger">
            <text class="picker-value">清除缓存</text>
            <text class="picker-arrow">></text>
          </view>
        </view>
      </view>
      
      <!-- 关于我们 -->
      <view class="form-item" bindtap="aboutUs">
        <view class="form-label">关于我们</view>
        <view class="form-value">
          <view class="picker-trigger">
            <text class="picker-arrow">></text>
          </view>
        </view>
      </view>
      
      <!-- 隐私政策 -->
      <view class="form-item" bindtap="privacyPolicy">
        <view class="form-label">隐私政策</view>
        <view class="form-value">
          <view class="picker-trigger">
            <text class="picker-arrow">></text>
          </view>
        </view>
      </view>
      
      <!-- 用户协议 -->
      <view class="form-item" bindtap="userAgreement">
        <view class="form-label">用户协议</view>
        <view class="form-value">
          <view class="picker-trigger">
            <text class="picker-arrow">></text>
          </view>
        </view>
      </view>
    </view>
    
    <!-- 版本信息 -->
    <view class="version-info">
      <text class="version-text">版本 1.0.0</text>
    </view>
    
    <!-- 退出登录按钮 -->
    <view class="quick-actions">
      <button 
        class="logout-button" 
        bindtap="logout"
      >
        退出登录
      </button>
    </view>
  </view>
</view>