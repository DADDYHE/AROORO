/* ================================================================
   商城订单详情 · AROORO 深森林绿 × 香槟金 × 奶油白 高奢风格
   Skyline 兼容：无 :active / transition 仅 transform & opacity / 单行截断
   ================================================================ */
@import '../../../styles/loading-animation.wxss';
/* 令牌由 app.wxss 全局注入到 page，页面不得再 import variables.wxss —
   页面 wxss 在 app.wxss 之后加载，同为 page 选择器会反向覆盖 theme-teal，
   把旧橄榄坐标系带回来（详见 #10）。 */

.page {
  min-height: 100vh;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

/* 状态横幅。--banner-ink：本横幅内所有文字的墨色，与 background 同处一条规则，
   避免底色改了字色没跟着改。底色亮度 L≤0.1833 用白，否则用炭黑。 */
.status-banner {
  padding: 48rpx var(--page-padding) 40rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  --banner-ink: var(--card-color);
}

/* 金底：白字仅 2.40:1 → 文字改炭黑（5.27:1）。--banner-ink 定义见 .status-banner。 */
.status-banner.status-pending_payment {
  background: linear-gradient(135deg, var(--status-pending) 0%, var(--accent-deep) 100%);
  --banner-ink: var(--text-primary);
}

/* 支付倒计时（待支付订单，与后端 ORDER_TIMEOUT_MINUTES=30 超时取消对齐）
   仅在待付款（金底）渲染，原 rgba(255,255,255,0.92) 为 2.40:1。 */
.pay-countdown {
  margin-top: 14rpx;
  display: flex;
  align-items: baseline;
  font-size: 24rpx;
  color: var(--banner-ink);
}

/* 原 opacity:0.85 会把炭黑压到 4.27:1；层级由 .pay-countdown-time 的 600 字重 + 34rpx 承担 */
.pay-countdown-label {
  margin-right: 10rpx;
  letter-spacing: 0.04em;
}

.pay-countdown-time {
  font-weight: 600;
  font-size: 34rpx;
  font-variant-numeric: tabular-nums;
  letter-spacing: 1rpx;
}

/* 金底，同上取炭黑 */
.status-banner.status-pending_shipment {
  background: linear-gradient(135deg, var(--status-pending) 0%, var(--accent-deep) 100%);
  --banner-ink: var(--text-primary);
}

/* 原为 var(--status-active) → var(--info-color)，二者真值同为 #5C7A8A，渐变实际塌成纯色。
   原兜底 #4A6572 恰好记录了作者本意（= --status-active-deep），据此改用正确令牌。白字 4.56:1。 */
.status-banner.status-shipped {
  background: linear-gradient(135deg, var(--status-active) 0%, var(--status-active-deep) 100%);
}

/* 白字 5.16:1 */
.status-banner.status-completed {
  background: linear-gradient(135deg, var(--status-completed) 0%, var(--primary-color) 100%);
}

/* 原为 var(--status-cancelled) → var(--gray-600)；--status-cancelled 加深为 #7A7568 后
   与 --gray-600 同值，渐变会塌成纯色，故改用配套的 --status-cancelled-deep。白字 4.59:1。 */
.status-banner.status-cancelled {
  background: linear-gradient(135deg, var(--status-cancelled) 0%, var(--status-cancelled-deep) 100%);
}

.status-text {
  font-size: 36rpx;
  font-weight: 400;
  color: var(--banner-ink);
  letter-spacing: 0.06em;
}

/* 24rpx≈12px 属正文档位，门槛 4.5:1；原 0.8 白在金/灰底上仅 2.04~3.58:1 */
.status-desc {
  font-size: 24rpx;
  color: var(--banner-ink);
  line-height: 1.5;
  letter-spacing: 0.02em;
}

/* 通用区块 */
.section {
  margin: 16rpx var(--page-padding, 48rpx);
  background: var(--card-color);
  border-radius: var(--zy-radius-lg);
  padding: 32rpx;
  border: 1rpx solid var(--hairline, rgba(26,26,23,0.08));
}

.section-title {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 20rpx;
  letter-spacing: 0.04em;
}

.product-section {
}

.product-row {
  display: flex;
  gap: 20rpx;
  align-items: center;
}

.product-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--zy-radius-md);
  flex-shrink: 0;
  background: var(--card-cream, #FBF9F4);
}

.product-img-placeholder {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--zy-radius-md);
  flex-shrink: 0;
  background: var(--card-cream, #FBF9F4);
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 160rpx;
  padding: 4rpx 0;
}

.product-name {
  font-size: 28rpx;
  font-weight: 400;
  color: var(--text-primary);
  line-height: 1.4;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.product-sku {
  font-size: 22rpx;
  color: var(--text-tertiary);
  background: var(--accent-wash, #F8F3E6);
  padding: 4rpx 12rpx;
  border-radius: var(--zy-radius-sm);
  align-self: flex-start;
  margin-top: 8rpx;
}

.product-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}

.product-price {
  font-size: 30rpx;
  font-weight: 400;
  color: var(--text-primary);
}

.product-qty {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.product-arrow {
  width: 14rpx;
  height: 14rpx;
  border-top: 2rpx solid var(--text-tertiary);
  border-right: 2rpx solid var(--text-tertiary);
  transform: rotate(45deg);
  flex-shrink: 0;
  margin-left: 8rpx;
}

/* 收货地址 */
.receiver-row {
  display: flex;
  gap: 12rpx;
  align-items: flex-start;
}

.row-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.receiver-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.receiver-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.receiver-name {
  font-size: 28rpx;
  font-weight: 400;
  color: var(--text-primary);
}

.receiver-phone {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.receiver-address {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

/* 信息行 */
.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--hairline, rgba(26,26,23,0.08));
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.info-value {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 400;
}

.info-value-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.copy-btn {
  font-size: 22rpx;
  color: var(--text-primary);
  padding: 4rpx 16rpx;
  border: 1rpx solid var(--mall-tint);
  border-radius: var(--zy-radius-lg);
  background: var(--mall-tint, rgba(201,162,75,0.08));
}

.copy-btn.pressed {
  opacity: 0.7;
}

.total-row {
  margin-top: 8rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--hairline, rgba(26,26,23,0.08));
  border-bottom: none;
}

.total-value {
  font-size: 32rpx;
  font-weight: 400;
  color: var(--text-primary);
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  padding: 20rpx var(--page-padding, 48rpx);
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: var(--card-color);
  border-top: 1rpx solid var(--hairline, rgba(26,26,23,0.08));
}

.btn-primary {
  padding: 20rpx 48rpx;
  background: var(--mall-gradient, linear-gradient(135deg, #C9A24B 0%, #A8894A 100%));
  color: var(--text-on-accent);  /* 原 var(--card-color) */
  font-size: 28rpx;
  font-weight: 400;
  border-radius: var(--zy-radius-lg);
  letter-spacing: 0.06em;
  text-align: center;
  box-shadow: var(--shadow-glow-mall);
}

.btn-primary.pressed {
  opacity: 0.85;
  transform: scale(0.98);
}

.btn-secondary {
  padding: 20rpx 48rpx;
  background: var(--card-color);
  color: var(--text-secondary);
  font-size: 28rpx;
  font-weight: 400;
  border-radius: var(--zy-radius-lg);
  border: 1rpx solid var(--border-color, #E2DED3);
  letter-spacing: 0.06em;
  text-align: center;
}

.btn-secondary.pressed {
  opacity: 0.7;
}

.btn-secondary.danger {
  color: var(--error-color);
  border-color: rgba(184, 92, 60, 0.2);
}

.logistics-section {
  margin-top: 16rpx;
}

/* 入场动画 */
.status-banner {
  animation-name: fadeInDown;
  animation-duration: 480ms;
  animation-timing-function: cubic-bezier(0.19, 1, 0.22, 1);
  animation-fill-mode: forwards;
}

.section {
  animation-name: fadeInUp;
  animation-duration: 480ms;
  animation-timing-function: cubic-bezier(0.19, 1, 0.22, 1);
  animation-fill-mode: forwards;
}

.section:nth-child(2) { animation-delay: 80ms; }
.section:nth-child(3) { animation-delay: 160ms; }
.section:nth-child(4) { animation-delay: 240ms; }

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes fadeInDown {
  from { opacity: 0; transform: translateY(-20rpx); }
  to { opacity: 1; transform: translateY(0); }
}
