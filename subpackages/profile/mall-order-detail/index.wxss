@import '../../../styles/loading-animation.wxss';

@import '../../../styles/variables.wxss';

.page {
  background: var(--background-color);
  min-height: 100vh;
  padding-bottom: 140rpx;
}

.loading-dot:nth-child(2) {
}

.loading-dot:nth-child(3) {
}

.status-banner {
  padding: 48rpx 32rpx 40rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.status-banner.status-pending_payment {
  background: linear-gradient(135deg, var(--mall-primary) 0%, var(--mall-secondary) 100%);
}

.status-banner.status-pending_shipment {
  background: linear-gradient(135deg, #FF9800 0%, #F57C00 100%);
}

.status-banner.status-shipped {
  background: linear-gradient(135deg, var(--feeding-primary) 0%, #1976D2 100%);
}

.status-banner.status-completed {
  background: linear-gradient(135deg, #4CAF50 0%, #388E3C 100%);
}

.status-banner.status-cancelled {
  background: linear-gradient(135deg, #9E9E9E 0%, #757575 100%);
}

.status-text {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--card-color);
  letter-spacing: 2rpx;
}

.status-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.4;
}

.section {
  margin: 16rpx 24rpx;
  background: var(--card-color);
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 20rpx;
  letter-spacing: 1rpx;
}

.product-section {
}

.product-row {
  display: flex;
  gap: 20rpx;
  align-items: center;
}

.product-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: var(--background-color);
}

.product-img-placeholder {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: var(--background-color);
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 160rpx;
  padding: 4rpx 0;
}

.product-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.product-sku {
  font-size: 22rpx;
  color: var(--text-secondary);
  background: var(--divider-color);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  align-self: flex-start;
  margin-top: 8rpx;
}

.product-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}

.product-price {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--mall-primary);
}

.product-qty {
  font-size: 24rpx;
  color: var(--gray-500);
}

.product-arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 3rpx solid var(--text-tertiary);
  border-right: 3rpx solid var(--text-tertiary);
  transform: rotate(45deg);
  flex-shrink: 0;
  margin-left: 8rpx;
}

.receiver-row {
  display: flex;
  gap: 12rpx;
  align-items: flex-start;
}

.row-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.receiver-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.receiver-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.receiver-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.receiver-phone {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.receiver-address {
  font-size: 24rpx;
  color: var(--gray-700);
  line-height: 1.5;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--divider-color);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.info-value {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.info-value-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.copy-btn {
  font-size: 22rpx;
  color: var(--mall-primary);
  padding: 4rpx 16rpx;
  border: 1rpx solid rgba(156, 39, 176, 0.3);
  border-radius: 16rpx;
  background: rgba(156, 39, 176, 0.05);
}

.total-row {
  margin-top: 8rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--gray-200);
  border-bottom: none;
}

.total-value {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--mall-primary);
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: var(--card-color);
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.btn-primary {
  padding: 18rpx 48rpx;
  background: linear-gradient(135deg, var(--mall-primary) 0%, var(--mall-secondary) 100%);
  color: var(--card-color);
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 36rpx;
  letter-spacing: 1rpx;
  text-align: center;
}

.btn-secondary {
  padding: 18rpx 48rpx;
  background: var(--card-color);
  color: var(--gray-700);
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 36rpx;
  border: 1rpx solid #D1D1D6;
  letter-spacing: 1rpx;
  text-align: center;
}

.btn-secondary.danger {
  color: var(--error-color);
  border-color: rgba(255, 59, 48, 0.3);
}

.logistics-section {
  margin-top: 16rpx;
}
