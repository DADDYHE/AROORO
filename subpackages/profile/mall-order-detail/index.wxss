/* ================================================================
   商城订单详情 · A+B 奢侈品级版式（2026-09-09 全站升级）
   B1 深绿标题版 hero（全局 .lux-* 类）+ A 纸面流：
   章节行 01/02 + 票据信息行 + 14% 墨行线 + 卷宗落款。零白卡。
   Skyline 兼容：无 :active / transition 仅 transform & opacity / 单行截断
   ================================================================ */
@import '../../../styles/loading-animation.wxss';
/* 令牌由 app.wxss 全局注入到 page，页面不得再 import variables.wxss —
   页面 wxss 在 app.wxss 之后加载，同为 page 选择器会反向覆盖 theme-teal，
   把旧橄榄坐标系带回来（详见 #10）。 */

.page {
  min-height: 100vh;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

/* 状态横幅。--banner-ink：本横幅内所有文字的墨色，与 background 同处一条规则，
   避免底色改了字色没跟着改。底色亮度 L≤0.1833 用白，否则用炭黑。 */
.status-banner {
  padding: 48rpx var(--page-padding) 40rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  --banner-ink: var(--card-color);
}

/* 金底：白字仅 2.40:1 → 文字改炭黑（5.27:1）。--banner-ink 定义见 .status-banner。 */
.status-banner.status-pending_payment {
  background: linear-gradient(135deg, var(--status-pending) 0%, var(--accent-deep) 100%);
  --banner-ink: var(--text-primary);
}

/* 支付倒计时（待支付订单，与后端 ORDER_TIMEOUT_MINUTES=30 超时取消对齐）
   仅在待付款（金底）渲染，原 rgba(255,255,255,0.92) 为 2.40:1。 */
.pay-countdown {
  margin-top: 14rpx;
  display: flex;
  align-items: baseline;
  font-size: 24rpx;
  color: var(--banner-ink);
}

/* 原 opacity:0.85 会把炭黑压到 4.27:1；层级由 .pay-countdown-time 的 600 字重 + 34rpx 承担 */
.pay-countdown-label {
  margin-right: 10rpx;
  letter-spacing: 0.04em;
}

.pay-countdown-time {
  font-weight: 600;
  font-size: 34rpx;
  letter-spacing: 1rpx;
}

/* 金底，同上取炭黑 */
.status-banner.status-pending_shipment {
  background: linear-gradient(135deg, var(--status-pending) 0%, var(--accent-deep) 100%);
  --banner-ink: var(--text-primary);
}

/* 白字 4.56:1 */
.status-banner.status-shipped {
  background: linear-gradient(135deg, var(--status-active) 0%, var(--status-active-deep) 100%);
}

/* 白字 5.16:1 */
.status-banner.status-completed {
  background: linear-gradient(135deg, var(--status-completed) 0%, var(--primary-color) 100%);
}

/* 白字 4.59:1 */
.status-banner.status-cancelled {
  background: linear-gradient(135deg, var(--status-cancelled) 0%, var(--status-cancelled-deep) 100%);
}

.status-text {
  font-size: 36rpx;
  font-weight: 400;
  color: var(--banner-ink);
  letter-spacing: 0.06em;
}

.status-desc {
  font-size: 24rpx;
  color: var(--banner-ink);
  line-height: 1.5;
  letter-spacing: 0.02em;
}

/* ================================================================
   章节：双行 eyebrow（01 PRODUCT …）+ 14% 墨行线分区，无卡片
   ================================================================ */
.chapter {
  padding: 36rpx var(--page-padding) 8rpx;
}

.chapter-eyebrow-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 26rpx;
}

.chapter-no {
  font-size: 20rpx;
  letter-spacing: 0.12em;
  color: var(--lux-gold-ink);
}

.chapter-name {
  font-size: 20rpx;
  font-weight: 500;
  letter-spacing: 0.28em;
  color: var(--text-secondary);
}

.chapter-rule {
  flex: 1;
  height: 1rpx;
  background: rgba(26, 26, 23, 0.14);
}

.chapter-side {
  font-size: 20rpx;
  letter-spacing: 0.08em;
  color: var(--text-tertiary);
}

.chapter-body {
  padding-bottom: 28rpx;
  border-bottom: 1rpx solid rgba(26, 26, 23, 0.14);
}

/* ── 01 PRODUCT 商品行 ── */
.product-row {
  display: flex;
  gap: 20rpx;
  align-items: center;
  padding: 12rpx 0;
}

.product-row + .product-row {
  border-top: 1rpx solid rgba(26, 26, 23, 0.14);
}

.product-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--zy-radius-md);
  flex-shrink: 0;
  background: var(--card-cream, #FBF9F4);
}

.product-img-placeholder {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--zy-radius-md);
  flex-shrink: 0;
  background: var(--card-cream, #FBF9F4);
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 160rpx;
  padding: 4rpx 0;
}

.product-name {
  font-size: 28rpx;
  font-weight: 400;
  color: var(--text-primary);
  line-height: 1.4;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.product-sku {
  font-size: 22rpx;
  color: var(--text-tertiary);
  background: var(--accent-wash, #F8F3E6);
  padding: 4rpx 12rpx;
  border-radius: var(--zy-radius-sm);
  align-self: flex-start;
  margin-top: 8rpx;
}

.product-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}

.product-price {
  font-size: 30rpx;
  font-weight: 400;
  color: var(--text-primary);
}

.product-qty {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.product-arrow {
  width: 14rpx;
  height: 14rpx;
  border-top: 2rpx solid var(--text-tertiary);
  border-right: 2rpx solid var(--text-tertiary);
  transform: rotate(45deg);
  flex-shrink: 0;
  margin-left: 8rpx;
}

/* ── 02 RECEIVER 收货信息 ── */
.receiver-row {
  display: flex;
  gap: 12rpx;
  align-items: flex-start;
}

.row-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.receiver-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.receiver-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.receiver-name {
  font-size: 28rpx;
  font-weight: 400;
  color: var(--text-primary);
}

.receiver-phone {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.receiver-address {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

/* ── 03 LOGISTICS / 04 ORDER 信息行（票据语法） ── */
.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(26, 26, 23, 0.14);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  letter-spacing: 0.02em;
}

.info-value {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 400;
}

.info-value-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.copy-btn {
  transition: transform 160ms ease, opacity 160ms ease;
  font-size: 20rpx;
  color: var(--lux-gold-ink);
  padding: 2rpx 14rpx;
  border: 1rpx solid var(--lux-hairline-gold);
  border-radius: 999rpx;
}

.copy-btn.pressed {
  opacity: 0.7;
}

.total-row {
  margin-top: 8rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(26, 26, 23, 0.14);
  border-bottom: none;
}

.total-value {
  font-size: 36rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.01em;
}

/* ================================================================
   票据落款
   ================================================================ */
.dossier-foot {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  padding: 48rpx var(--page-padding) 24rpx;
}

.dossier-foot-line {
  width: 64rpx;
  height: 1rpx;
  background: rgba(26, 26, 23, 0.14);
}

.dossier-foot-text {
  font-size: 20rpx;
  letter-spacing: 0.3em;
  color: var(--text-tertiary);
}

/* 入场动画 */
.status-banner {
  animation-name: zy-fade-in-down;
  animation-duration: 480ms;
  animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  animation-fill-mode: forwards;
}

.chapter {
  animation-name: zy-fade-in-up;
  animation-duration: 480ms;
  animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  animation-fill-mode: forwards;
}

.chapter:nth-of-type(1) { animation-delay: 100ms; }
.chapter:nth-of-type(2) { animation-delay: 160ms; }
.chapter:nth-of-type(3) { animation-delay: 220ms; }
.chapter:nth-of-type(4) { animation-delay: 280ms; }
