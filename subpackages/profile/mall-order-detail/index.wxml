<view class="page">
  <view class="loading-wrap" wx:if="{{isLoading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <block wx:elif="{{order}}">
    <view class="status-banner status-{{order.status}}">
      <text class="status-text">{{order.statusText}}</text>
      <text class="status-desc">{{order.statusDesc}}</text>
    </view>

    <view class="section product-section" bindtap="onGoProductDetail">
      <view class="product-row">
        <image class="product-img" wx:if="{{order.productImage}}" src="{{order.productImage}}" mode="aspectFill" binderror="onCloudImageError" data-src="{{order.productImage}}" data-path="order.productImage" />
        <view class="product-img-placeholder" wx:else></view>
        <view class="product-info">
          <text class="product-name">{{order.productName}}</text>
          <text class="product-sku" wx:if="{{order.skuText}}">{{order.skuText}}</text>
          <view class="product-bottom">
            <text class="product-price">¥{{order.unitPrice}}</text>
            <text class="product-qty">×{{order.quantity}}</text>
          </view>
        </view>
        <view class="product-arrow"></view>
      </view>
    </view>

    <view class="section receiver-section" wx:if="{{order.receiverName}}">
      <view class="section-title">收货信息</view>
      <view class="receiver-row">
        <image class="row-icon" src="{{iconMapPin}}" mode="aspectFit" binderror="onCloudImageError" data-src="{{iconMapPin}}" data-path="iconMapPin" />
        <view class="receiver-detail">
          <view class="receiver-top">
            <text class="receiver-name">{{order.receiverName}}</text>
            <text class="receiver-phone">{{order.receiverPhone}}</text>
          </view>
          <text class="receiver-address">{{order.receiverAddress}}</text>
        </view>
      </view>
    </view>

    <view class="section info-section">
      <view class="section-title">订单信息</view>
      <view class="info-row">
        <text class="info-label">订单编号</text>
        <view class="info-value-row">
          <text class="info-value">{{order.orderNo}}</text>
          <view class="copy-btn" bindtap="onCopyOrderNo">复制</view>
        </view>
      </view>
      <view class="info-row">
        <text class="info-label">下单时间</text>
        <text class="info-value">{{order.createdAt}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">商品单价</text>
        <text class="info-value">¥{{order.unitPrice}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">购买数量</text>
        <text class="info-value">{{order.quantity}}件</text>
      </view>
      <view class="info-row total-row">
        <text class="info-label">订单总额</text>
        <text class="total-value">¥{{order.totalAmount}}</text>
      </view>
    </view>

    <view class="bottom-bar">
      <block wx:if="{{order.status === 'pending_payment'}}">
        <view class="btn-secondary" bindtap="onCancelOrder">取消订单</view>
        <view class="btn-primary" bindtap="onGoPay">去付款</view>
      </block>
      <block wx:elif="{{order.status === 'pending_shipment'}}">
        <view class="btn-secondary" bindtap="onCancelOrder">取消订单</view>
      </block>
      <block wx:elif="{{order.status === 'shipped'}}">
        <view class="btn-primary" bindtap="onConfirmReceive">确认收货</view>
      </block>
      <block wx:elif="{{order.status === 'completed'}}">
        <view class="btn-secondary" bindtap="onRebuy">再次购买</view>
        <view class="btn-secondary danger" bindtap="onDeleteOrder">删除订单</view>
      </block>
      <block wx:elif="{{order.status === 'cancelled'}}">
        <view class="btn-secondary" bindtap="onRebuy">重新购买</view>
        <view class="btn-secondary danger" bindtap="onDeleteOrder">删除订单</view>
      </block>
    </view>
  </block>
</view>
