<zy-navbar title="" transparent color="#F7F5EF" />
<scroll-view
  scroll-y
  enhanced
  refresher-enabled="{{true}}"
  refresher-triggered="{{_refresherTriggered}}"
  bindrefresherrefresh="_onRefresherRefresh"
  bindscrolltolower="_onScrollToLower"
  bindscroll="_onScroll"
  lower-threshold="100"
  style="height: 100vh;"
>
<!-- B · 深绿沉浸标题版（顶天，loading 常驻） -->
<view class="lux-hero" style="padding-top: calc({{_navbarHeight}}px + 24rpx);">
  <text class="lux-hero-eyebrow">MALL ORDER</text>
  <text class="lux-hero-title">{{t.BIZ_HYWFKI}}</text>
  <text class="lux-hero-sub" wx:if="{{order}}">NO. {{order.orderNo}}</text>
  <view class="lux-hero-sealline"></view>
</view>
<view class="page">
  <view wx:if="{{isLoading}}" class="loading-container">
    <view class="loading-content">
      <view class="lux-cascade">
  <view class="lux-cascade-dot" style="left: 20rpx; background: #C9A24B; animation-delay: 0ms;"></view>
  <view class="lux-cascade-dot" style="left: 36rpx; background: #A8894A; animation-delay: 150ms;"></view>
  <view class="lux-cascade-dot" style="left: 52rpx; background: #C9A24B; animation-delay: 300ms;"></view>
  <view class="lux-cascade-dot" style="left: 68rpx; background: #A8894A; animation-delay: 450ms;"></view>
  <view class="lux-cascade-dot" style="left: 84rpx; background: #C9A24B; animation-delay: 600ms;"></view>
  <view class="lux-cascade-dot" style="left: 100rpx; background: #A8894A; animation-delay: 750ms;"></view>
  <view class="lux-cascade-dot" style="left: 48rpx; background: #C9A24B; animation-delay: 900ms;"></view>

      </view>
      <text class="loading-text">{{t.BIZ_CSIK0}}</text>
    </view>
  </view>

  <block wx:elif="{{order}}">
    <order-status-banner
      status="{{order.status}}"
      status-text="{{order.statusText}}"
      status-desc="{{order.statusDesc}}"
      pay-countdown="{{payCountdown}}"
    />

    <!-- ═══ 01 · PRODUCT 商品 ═══ -->
    <view class="chapter" bindtap="onGoProductDetail">
      <view class="chapter-eyebrow-row">
        <text class="chapter-no">01</text>
        <text class="chapter-name">PRODUCT</text>
        <view class="chapter-rule"></view>
        <text class="chapter-side">{{order.itemCount || order.quantity}}件</text>
      </view>
      <view class="chapter-body">
      <view class="product-row">
        <image class="product-img" wx:if="{{order.productImage}}" src="{{order.productImage}}" mode="aspectFill" binderror="onCloudImageError" data-src="{{order.productImage}}" data-path="order.productImage" lazy-load />
        <view class="product-img-placeholder" wx:else></view>
        <view class="product-info">
          <text class="product-name">{{order.productName}}</text>
          <text class="product-sku" wx:if="{{order.skuText}}">{{order.skuText}}</text>
          <view class="product-bottom">
            <text class="product-price">¥{{order.unitPrice}}</text>
            <text class="product-qty">×{{order.quantity}}</text>
            <text class="product-qty" wx:if="{{order.itemCount > 1}}">等{{order.itemCount}}件商品</text>
          </view>
        </view>
        <view class="product-arrow"></view>
      </view>
      <!-- P1-C: 合并单列出全部商品 -->
      <block wx:if="{{order.itemCount > 1}}">
        <view class="product-row" wx:for="{{order.items}}" wx:key="index" wx:for-item="sub" wx:for-index="subIdx">
          <image class="product-img" wx:if="{{sub.productImage}}" src="{{sub.productImage}}" mode="aspectFill" binderror="onCloudImageError" data-src="{{sub.productImage}}" data-path="order.items[{{subIdx}}].productImage" lazy-load />
          <view class="product-img-placeholder" wx:else></view>
          <view class="product-info">
            <text class="product-name">{{sub.productName}}</text>
            <text class="product-sku" wx:if="{{sub.skuText}}">{{sub.skuText}}</text>
            <view class="product-bottom">
              <text class="product-price">¥{{sub.unitPrice}}</text>
              <text class="product-qty">×{{sub.quantity}}</text>
            </view>
          </view>
        </view>
      </block>
      </view>
    </view>

    <!-- ═══ 02 · RECEIVER 收货信息 ═══ -->
    <view class="chapter" wx:if="{{order.receiverName}}">
      <view class="chapter-eyebrow-row">
        <text class="chapter-no">02</text>
        <text class="chapter-name">RECEIVER</text>
        <view class="chapter-rule"></view>
      </view>
      <view class="chapter-body">
        <view class="receiver-row">
          <image class="row-icon" src="{{iconMapPin}}" mode="aspectFit" binderror="onCloudImageError" data-src="{{iconMapPin}}" data-path="iconMapPin" />
          <view class="receiver-detail">
            <view class="receiver-top">
              <text class="receiver-name">{{order.receiverName}}</text>
              <text class="receiver-phone">{{order.receiverPhone}}</text>
            </view>
            <text class="receiver-address">{{order.receiverAddress}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- ═══ 03 · LOGISTICS 物流信息（纸面行） ═══ -->
    <view class="chapter" wx:if="{{order.status === 'shipped' || order.status === 'completed'}}">
      <view class="chapter-eyebrow-row">
        <text class="chapter-no">03</text>
        <text class="chapter-name">LOGISTICS</text>
        <view class="chapter-rule"></view>
      </view>
      <view class="chapter-body">
        <view class="info-row">
          <text class="info-label">快递单号</text>
          <view class="info-value-row">
            <text class="info-value">{{order.expressNo || '暂无'}}</text>
            <view class="copy-btn" wx:if="{{order.expressNo}}" bindtap="onCopyExpressNo" hover-class="copy-btn pressed" hover-stay-time="80">复制</view>
          </view>
        </view>
        <view class="info-row" wx:if="{{order.shippedAt}}">
          <text class="info-label">发货时间</text>
          <text class="info-value">{{order.shippedAt}}</text>
        </view>
      </view>
    </view>

    <!-- ═══ 04 · ORDER 订单信息（A-票据） ═══ -->
    <view class="chapter">
      <view class="chapter-eyebrow-row">
        <text class="chapter-no">04</text>
        <text class="chapter-name">ORDER</text>
        <view class="chapter-rule"></view>
      </view>
      <view class="chapter-body">
        <view class="info-row">
          <text class="info-label">订单编号</text>
          <view class="info-value-row">
            <text class="info-value">{{order.orderNo}}</text>
            <view class="copy-btn" bindtap="onCopyOrderNo" hover-class="copy-btn pressed" hover-stay-time="80">复制</view>
          </view>
        </view>
        <view class="info-row">
          <text class="info-label">下单时间</text>
          <text class="info-value">{{order.createdAt}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">商品单价</text>
          <text class="info-value">¥{{order.unitPrice}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">购买数量</text>
          <text class="info-value">{{order.quantity}}件</text>
        </view>
        <view class="info-row total-row">
          <text class="info-label">订单总额</text>
          <text class="total-value">¥{{order.totalAmount}}</text>
        </view>
      </view>
    </view>

    <!-- 票据落款 -->
    <view class="dossier-foot">
      <view class="dossier-foot-line"></view>
      <text class="dossier-foot-text">AROORO · 宠物商城</text>
      <view class="dossier-foot-line"></view>
    </view>

    <root-portal>
      <order-action-bar
        actions="{{actions}}"
        bindaction="onAction"
      />
    </root-portal>
  </block>
</view>
</scroll-view>
