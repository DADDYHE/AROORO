/* 用户协议 - AROORO 奢华宠物 */

.page-container {
  min-height: 100vh;
  background-color: var(--card-cream, #FBF9F4);
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.page-content {
  padding: var(--page-padding, 48rpx);
}

.section {
  background-color: var(--card-color);
  border-radius: var(--zy-radius-lg);
  padding: 40rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--hairline);
}

.section-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--primary-color);
  margin-bottom: 24rpx;
  display: block;
  letter-spacing: 0.04em;
  line-height: 1.4;
}

.section-subtitle {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  display: block;
  letter-spacing: 0.02em;
  line-height: 1.5;
}

.section-content {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.75;
  letter-spacing: 0.02em;
}

/* 入场动画 */
.page-content {
  animation-name: fadeInUp;
  animation-duration: 520ms;
  animation-timing-function: cubic-bezier(0.19, 1, 0.22, 1);
  animation-fill-mode: forwards;
}

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ===== 页面头部返回按钮 ===== */
.page-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx var(--page-padding, 48rpx);
  background: var(--card-color);
  border-bottom: 1rpx solid var(--hairline);
}

.page-back {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.page-back-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.page-back-text {
  font-size: inherit;
  color: inherit;
}
