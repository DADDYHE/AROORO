/* 用户协议 - AROORO 奢华宠物 · A 纸面流（拆白卡，印纸面） */

.page-container {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.page-content {
  padding: var(--page-padding, 48rpx);
}

/* 文档章节：纸面行线分区，不用白卡 */
.section {
  padding: 0 0 32rpx;
  margin-bottom: 32rpx;
  border-bottom: 1rpx solid rgba(26, 26, 23, 0.14);
}

.section-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--primary-color);
  margin-bottom: 24rpx;
  display: block;
  letter-spacing: 0.04em;
  line-height: 1.4;
}

.section-subtitle {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  display: block;
  letter-spacing: 0.02em;
  line-height: 1.5;
}

.section-content {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.75;
  letter-spacing: 0.02em;
}

/* 入场动画 */
.page-content {
  animation-name: zy-fade-in-up;
  animation-duration: 480ms;
  animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  animation-fill-mode: forwards;
}

