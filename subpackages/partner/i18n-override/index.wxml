<zy-navbar title="多语言管理" />
<scroll-view
  scroll-y
  enhanced
  refresher-enabled="{{true}}"
  refresher-triggered="{{_refresherTriggered}}"
  bindrefresherrefresh="_onRefresherRefresh"
  bindscrolltolower="_onScrollToLower"
  bindscroll="_onScroll"
  lower-threshold="100"
  style="height: calc(100vh - {{_navbarHeight}}px);"
>
<view class="page">
  <!-- Sprint 53: 顶部统计概览 -->
  <view class="stats-bar">
    <view class="stat-item">
      <view class="stat-num">{{stats.activeDocs}}</view>
      <view class="stat-label">已启用</view>
    </view>
    <view class="stat-item">
      <view class="stat-num">{{stats.disabledDocs}}</view>
      <view class="stat-label">已禁用</view>
    </view>
    <view class="stat-item">
      <view class="stat-num">{{stats.uniqueKeys}}</view>
      <view class="stat-label">唯一 key</view>
    </view>
    <view class="stat-item">
      <view class="stat-num">{{stats.totalDocs}}</view>
      <view class="stat-label">总条目</view>
    </view>
  </view>

  <!-- 顶部工具栏 -->
  <view class="toolbar">
    <view class="toolbar-row">
      <view class="search-box">
        <input
          class="search-input"
          placeholder="按 key 前缀过滤"
          value="{{searchPrefix}}"
          bindinput="onSearchInput"
          bindconfirm="onSearchConfirm"
          confirm-type="search"
        />
        <view wx:if="{{searchPrefix}}" class="search-clear" bindtap="onClearSearch">×</view>
      </view>
      <view class="btn btn-primary" bindtap="onCreateNew">新建</view>
    </view>

    <view class="filter-row">
      <view
        class="filter-pill {{statusFilter === 'all' ? 'active' : ''}}"
        data-status="all"
        bindtap="onStatusFilterChange"
      >全部 ({{list.length}})</view>
      <view
        class="filter-pill {{statusFilter === 'active' ? 'active' : ''}}"
        data-status="active"
        bindtap="onStatusFilterChange"
      >已启用</view>
      <view
        class="filter-pill {{statusFilter === 'disabled' ? 'active' : ''}}"
        data-status="disabled"
        bindtap="onStatusFilterChange"
      >已禁用</view>
    </view>

    <!-- Sprint 53: 工具按钮组 -->
    <view class="action-row">
      <view class="action-btn" bindtap="onExportJson">导出 JSON</view>
      <view class="action-btn" bindtap="onOpenMissing">缺失翻译</view>
    </view>
  </view>

  <!-- 列表 -->
  <view wx:if="{{isLoading && list.length === 0}}" class="empty-state">
    <view class="lux-silk">
  <view class="lux-silk-line" style="background: var(--lux-gold-500, #C9A24B); animation-delay: 0ms;"></view>
  <view class="lux-silk-line" style="background: var(--lux-gold-600, #A8894A); animation-delay: 100ms;"></view>
  <view class="lux-silk-line" style="background: var(--lux-gold-500, #C9A24B); animation-delay: 200ms;"></view>
  <view class="lux-silk-line" style="background: var(--lux-gold-600, #A8894A); animation-delay: 300ms;"></view>
  <view class="lux-silk-line" style="background: var(--lux-gold-500, #C9A24B); animation-delay: 400ms;"></view>
</view>
    <text class="loading-more-text">{{t.BIZ_CSIK0}}</text>
  </view>
  <view wx:elif="{{list.length === 0}}" class="empty-state">
    <view class="empty-title">暂无覆盖</view>
    <view class="empty-desc">点击右上角"新建"添加第一条 i18n 覆盖</view>
  </view>

  <view wx:else class="list">
    <view wx:for="{{list}}" wx:key="_id" class="card">
      <view class="card-header">
        <view class="card-key">{{item.key}}</view>
        <view class="card-locale {{item.status === 'active' ? 'active' : 'disabled'}}">
          {{item.locale}}
        </view>
      </view>
      <view class="card-value">{{item.value}}</view>
      <view class="card-meta">
        <text>状态: {{item.status === 'active' ? '已启用' : '已禁用'}}</text>
        <text wx:if="{{item.note}}" class="card-note">备注: {{item.note}}</text>
      </view>
      <view class="card-actions">
        <view class="action" data-item="{{item}}" bindtap="onEditItem">编辑</view>
        <view class="action" data-key="{{item.key}}" bindtap="onPreviewItem">预览</view>
        <view
          class="action"
          data-id="{{item._id}}"
          data-status="{{item.status}}"
          bindtap="onToggleStatus"
        >{{item.status === 'active' ? '禁用' : '启用'}}</view>
        <view
          class="action danger"
          data-id="{{item._id}}"
          data-key="{{item.key}}"
          data-locale="{{item.locale}}"
          bindtap="onDeleteItem"
        >删除</view>
      </view>
    </view>
    <view wx:if="{{isLoading && list.length > 0}}" class="load-more">
      <view class="lux-silk">
  <view class="lux-silk-line" style="background: var(--lux-gold-500, #C9A24B); animation-delay: 0ms;"></view>
  <view class="lux-silk-line" style="background: var(--lux-gold-600, #A8894A); animation-delay: 100ms;"></view>
  <view class="lux-silk-line" style="background: var(--lux-gold-500, #C9A24B); animation-delay: 200ms;"></view>
  <view class="lux-silk-line" style="background: var(--lux-gold-600, #A8894A); animation-delay: 300ms;"></view>
  <view class="lux-silk-line" style="background: var(--lux-gold-500, #C9A24B); animation-delay: 400ms;"></view>
</view>
      <text class="loading-more-text">{{t.BIZ_CSIK0}}</text>
    </view>
    <view wx:elif="{{!hasMore && list.length > 0}}" class="load-more">— 已加载全部 ({{total}}) —</view>
  </view>

  <!-- 编辑器弹层 -->
  <root-portal>
  <view wx:if="{{editorVisible}}" class="modal-mask" bindtap="onCloseEditor">
    <view class="modal" catchtap="">
      <view class="modal-title">{{editorMode === 'create' ? '新建 i18n 覆盖' : '编辑 i18n 覆盖'}}</view>

      <view class="form-row">
        <text class="form-label">Key</text>
        <input
          class="form-input"
          placeholder="例：HOME_TITLE"
          value="{{editorForm.key}}"
          data-field="key"
          bindinput="onEditorFieldChange"
          disabled="{{editorMode === 'edit'}}"
        />
      </view>

      <view class="form-row">
        <text class="form-label">Locale</text>
        <view class="seg">
          <view
            wx:for="{{supportedLocales}}"
            wx:key="*this"
            class="seg-item {{editorForm.locale === item ? 'active' : ''}}"
            data-locale="{{item}}"
            bindtap="onEditorLocaleChange"
          >{{item}}</view>
        </view>
      </view>

      <view class="form-row">
        <text class="form-label">文案</text>
        <textarea
          class="form-textarea"
          placeholder="覆盖后的文案"
          value="{{editorForm.value}}"
          data-field="value"
          bindinput="onEditorFieldChange"
          maxlength="2000"
          auto-height
        />
      </view>

      <view class="form-row">
        <text class="form-label">状态</text>
        <view class="seg">
          <view
            class="seg-item {{editorForm.status === 'active' ? 'active' : ''}}"
            data-status="active"
            bindtap="onEditorStatusChange"
          >启用</view>
          <view
            class="seg-item {{editorForm.status === 'disabled' ? 'active' : ''}}"
            data-status="disabled"
            bindtap="onEditorStatusChange"
          >禁用</view>
        </view>
      </view>

      <view class="form-row">
        <text class="form-label">备注</text>
        <input
          class="form-input"
          placeholder="可选"
          value="{{editorForm.note}}"
          data-field="note"
          bindinput="onEditorFieldChange"
          maxlength="500"
        />
      </view>

      <view class="modal-actions">
        <view class="btn" bindtap="onCloseEditor">取消</view>
        <view class="btn btn-primary {{isSaving ? 'disabled' : ''}}" bindtap="onSaveEditor">
          {{isSaving ? '保存中...' : '保存'}}
        </view>
      </view>
    </view>
  </view>
  </root-portal>

  <!-- 预览弹层 -->
  <root-portal>
  <view wx:if="{{previewVisible}}" class="modal-mask" bindtap="onClosePreview">
    <view class="modal" catchtap="">
      <view class="modal-title">{{previewData.key}}</view>
      <view wx:for="{{supportedLocales}}" wx:key="*this" wx:for-item="loc" class="preview-row">
        <view class="preview-locale">{{loc}}</view>
        <view wx:if="{{previewData.locales[loc]}}" class="preview-value">
          <text>{{previewData.locales[loc].value}}</text>
          <text class="preview-status">{{previewData.locales[loc].status === 'active' ? '已启用' : '已禁用'}}</text>
        </view>
        <view wx:else class="preview-value empty">{{t.BIZ_FTE97}}</view>
      </view>
      <view class="modal-actions">
        <view class="btn btn-primary" bindtap="onClosePreview">关闭</view>
      </view>
    </view>
  </view>
  </root-portal>

  <!-- Sprint 53: 缺失翻译弹层 -->
  <root-portal>
  <view wx:if="{{missingPanelVisible}}" class="modal-mask" bindtap="onCloseMissing">
    <view class="modal modal-large" catchtap="">
      <view class="modal-title">缺失翻译概览</view>
      <view class="missing-summary">
        <text>总 key: {{missingStats.totalKeys}}</text>
        <text>缺失: {{missingStats.totalMissing}}</text>
      </view>
      <scroll-view scroll-y class="missing-scroll">
        <view wx:for="{{supportedLocales}}" wx:key="*this" wx:for-item="loc" class="missing-locale">
          <view class="missing-locale-head">
            <text class="missing-locale-name">{{loc}}</text>
            <text class="missing-locale-count">{{missingStats.missingByLocale[loc].length || 0}} 处缺失</text>
          </view>
          <view wx:if="{{missingStats.missingByLocale[loc].length > 0}}">
            <view wx:for="{{missingStats.missingByLocale[loc]}}" wx:key="key" wx:for-item="m" class="missing-item">
              <text class="missing-key">{{m.key}}</text>
              <text class="missing-avail">已在: {{m.availableIn.join(', ')}}</text>
              <view
                class="missing-fill"
                data-key="{{m.key}}"
                data-locale="{{loc}}"
                bindtap="onFillMissing"
              >补</view>
            </view>
          </view>
          <view wx:else class="missing-empty"><image class="missing-check-icon" src="/images/icons/check-luxury-line.svg" mode="aspectFit"></image><text>全部翻译齐</text></view>
        </view>
      </scroll-view>
      <view class="modal-actions">
        <view class="btn btn-primary" bindtap="onCloseMissing">关闭</view>
      </view>
    </view>
  </view>
  </root-portal>
</view>
</scroll-view>
