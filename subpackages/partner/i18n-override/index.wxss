@import '../common.wxss';

/* ================================================================
   AROORO i18n 覆盖管理 — Haute-Luxury Admin Console
   深森林绿主色 + 金属香槟金阶 + 奶油暖白底
   统计概览 · 工具栏 · 列表卡片 · 弹层编辑器 · 缺失翻译面板
   Skyline 兼容：无 :active / transition 仅 transform & opacity
   ================================================================ */

/* ---------- 页面容器 ---------- */
.page {
  min-height: 100vh;
  background: var(--background-color);
  padding: 0 var(--page-padding);
  padding-bottom: calc(env(safe-area-inset-bottom) + 48rpx);
}

/* ============================================
   顶部统计概览 — 深色高奢卡（森林绿底 + 金色数字）
   ============================================ */
.stats-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin-top: 24rpx;
  padding: 36rpx 24rpx;
  background: var(--lux-green-grad-rich);
  border-radius: var(--lux-radius-card);
  border: 1rpx solid var(--lux-hairline-green);
  box-shadow: var(--lux-shadow-green);
  position: relative;
  overflow: hidden;
}

/* 统计卡右上角金色光晕 */
.stats-bar::before {
  content: '';
  position: absolute;
  top: -30rpx;
  right: -30rpx;
  width: 160rpx;
  height: 160rpx;
  background: radial-gradient(circle, var(--mall-tint-04) 0%, transparent 70%);
  pointer-events: none;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  position: relative;
  flex: 1;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 300;
  color: var(--lux-gold-300);
  letter-spacing: 0.01em;
  font-feature-settings: 'tnum';
  line-height: 1.2;
}

.stat-label {
  font-size: 20rpx;
  color: var(--text-on-dark-50);
  letter-spacing: 0.18em;
  font-weight: 400;
}

/* 分隔线 */
.stat-item + .stat-item::before {
  content: '';
  position: absolute;
  left: -1rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 1rpx;
  height: 48rpx;
  background: var(--mall-tint-12);
}

/* ============================================
   工具栏 — 搜索 + 过滤 + 操作按钮
   ============================================ */
.toolbar {
  margin-top: 24rpx;
  padding: 24rpx 28rpx;
  background: var(--lux-card-bg);
  border-radius: var(--lux-radius-card);
  border: 1rpx solid var(--lux-hairline);
  box-shadow: var(--lux-shadow-card);
}

.toolbar-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* ---------- 搜索框 ---------- */
.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  height: 68rpx;
  padding: 0 24rpx;
  background: var(--lux-card-cream);
  border: 1rpx solid var(--lux-hairline);
  border-radius: var(--lux-radius-pill);
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-primary);
  font-family: inherit;
}

.search-clear {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: var(--divider-color);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
  margin-left: 8rpx;
  line-height: 1;
}

/* ---------- 新建按钮（工具栏尺寸） ---------- */
.toolbar-row .btn-primary {
  padding: 14rpx 36rpx;
  font-size: 24rpx;
  letter-spacing: 0.10em;
  flex-shrink: 0;
}

/* ---------- 过滤药丸行 ---------- */
.filter-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
  flex-wrap: wrap;
}

.filter-pill {
  padding: 10rpx 28rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  background: var(--lux-card-cream);
  border: 1rpx solid var(--lux-hairline);
  border-radius: var(--lux-radius-pill);
  letter-spacing: 0.04em;
  font-weight: 400;
}

.filter-pill.active {
  color: var(--text-on-primary);
  background: var(--gradient-primary);
  border-color: transparent;
  box-shadow: var(--lux-shadow-green);
  font-weight: 500;
}

/* ---------- 操作按钮行 ---------- */
.action-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--lux-hairline);
}

.action-btn {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--text-primary);
  background: var(--lux-card-cream);
  border: 1rpx solid var(--lux-hairline);
  border-radius: var(--lux-radius-inner);
  letter-spacing: 0.06em;
  font-weight: 400;
}

/* ============================================
   列表 — 覆盖项卡片
   ============================================ */
.list {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.card {
  background: var(--lux-card-bg);
  border-radius: var(--lux-radius-card);
  border: 1rpx solid var(--lux-hairline);
  box-shadow: var(--lux-shadow-card);
  padding: 28rpx 32rpx;
  position: relative;
  overflow: hidden;
}

/* 卡片左侧金色装饰条 */
.card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  width: 3rpx;
  height: 100%;
  background: var(--lux-gold-grad);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.card-key {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.04em;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
  font-feature-settings: 'tnum';
}

.card-locale {
  font-size: 20rpx;
  padding: 6rpx 18rpx;
  border-radius: var(--zy-radius-sm);
  font-weight: 400;
  letter-spacing: 0.06em;
  flex-shrink: 0;
}

.card-locale.active {
  background: var(--wash-success-08);
  color: var(--success-color);
}

.card-locale.disabled {
  background: var(--wash-neutral-10);
  color: var(--text-tertiary);
}

.card-value {
  font-size: 26rpx;
  color: var(--text-primary);
  line-height: 1.6;
  letter-spacing: 0.02em;
  padding: 12rpx 20rpx;
  background: var(--lux-card-cream);
  border-radius: var(--lux-radius-inner);
  border: 1rpx solid var(--lux-hairline);
  margin-bottom: 16rpx;
}

.card-meta {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
  letter-spacing: 0.02em;
}

.card-note {
  color: var(--text-tertiary);
  font-size: 20rpx;
}

/* ---------- 卡片操作按钮 ---------- */
.card-actions {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--lux-hairline);
}

.action {
  flex: 1;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 0.04em;
  font-weight: 400;
  border-radius: var(--lux-radius-inner);
  background: transparent;
}

.action.danger {
  color: var(--error-color);
}

/* ============================================
   空状态 / 加载更多
   ============================================ */
.empty-state {
  text-align: center;
  padding: 120rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.empty-state .empty-line {
  width: 48rpx;
  height: 1rpx;
  background: var(--lux-gold-400);
  margin: 0;
}

.empty-title {
  font-size: 28rpx;
  color: var(--text-primary);
  letter-spacing: 0.08em;
  font-weight: 400;
}

.empty-desc {
  font-size: 22rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.04em;
}

.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 40rpx 0;
  font-size: 22rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.08em;
}

.loading-more-text {
  font-size: 22rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.12em;
  font-weight: 300;
}

/* ============================================
   弹层 — 编辑器 / 预览 / 缺失翻译
   ============================================ */
.modal {
  width: 620rpx;
  max-height: 80vh;
  background: var(--lux-card-bg);
  border-radius: var(--zy-radius-2xl);
  overflow: hidden;
  box-shadow: var(--lux-shadow-elevated);
  display: flex;
  flex-direction: column;
  position: relative;
}

/* 弹层顶部金色装饰线 */
.modal::before {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 64rpx;
  height: 3rpx;
  background: var(--lux-gold-line-solid);
  border-radius: 0 0 3rpx 3rpx;
}

.modal-large {
  width: 680rpx;
  max-height: 85vh;
}

/* 弹层标题 */
.modal .modal-title {
  padding: 40rpx 36rpx 24rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.10em;
  border-bottom: 1rpx solid var(--lux-hairline);
}

/* ---------- 弹层表单覆写（垂直布局） ---------- */
.modal .form-row {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 0 36rpx;
  margin-top: 24rpx;
}

.modal .form-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 0.08em;
  font-weight: 400;
  margin-bottom: 0;
}

.modal .form-input {
  height: 72rpx;
  font-size: 26rpx;
}

.modal .form-textarea {
  min-height: 120rpx;
  font-size: 26rpx;
  padding: 16rpx 24rpx;
}

/* ---------- 分段选择器 ---------- */
.seg {
  display: flex;
  gap: 8rpx;
  background: var(--lux-card-cream);
  border: 1rpx solid var(--lux-hairline);
  border-radius: var(--lux-radius-inner);
  padding: 6rpx;
}

.seg-item {
  flex: 1;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--text-secondary);
  border-radius: 12rpx;
  letter-spacing: 0.04em;
  font-weight: 400;
}

.seg-item.active {
  background: var(--gradient-primary);
  color: var(--text-on-primary);
  font-weight: 500;
  box-shadow: var(--lux-shadow-green);
}

/* ---------- 弹层操作按钮 ---------- */
.modal-actions {
  display: flex;
  gap: 16rpx;
  padding: 32rpx 36rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--lux-hairline);
  margin-top: 24rpx;
}

.modal-actions .btn {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  border-radius: var(--lux-radius-pill);
  letter-spacing: 0.10em;
  font-weight: 500;
  line-height: 1;
}

.modal-actions .btn:not(.btn-primary) {
  background: var(--divider-color);
  color: var(--text-primary);
  font-weight: 400;
}

.modal-actions .btn-primary {
  padding: 0;
  height: 80rpx;
  font-size: 26rpx;
  letter-spacing: 0.10em;
}

.modal-actions .btn.disabled {
  opacity: 0.5;
}

/* ============================================
   预览弹层
   ============================================ */
.preview-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 20rpx 36rpx;
  border-bottom: 1rpx solid var(--lux-hairline);
}

.preview-row:last-of-type {
  border-bottom: none;
}

.preview-locale {
  font-size: 24rpx;
  color: var(--primary-color);
  font-weight: 500;
  letter-spacing: 0.08em;
  flex-shrink: 0;
  width: 80rpx;
  padding-top: 4rpx;
}

.preview-value {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.preview-value text {
  font-size: 26rpx;
  color: var(--text-primary);
  line-height: 1.5;
  letter-spacing: 0.02em;
}

.preview-value.empty {
  color: var(--text-tertiary);
  font-size: 24rpx;
  font-style: italic;
}

.preview-status {
  font-size: 20rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.06em;
}

/* ============================================
   缺失翻译面板
   ============================================ */
.missing-summary {
  display: flex;
  align-items: center;
  gap: 32rpx;
  padding: 20rpx 36rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 0.04em;
  border-bottom: 1rpx solid var(--lux-hairline);
}

.missing-scroll {
  flex: 1;
  max-height: 520rpx;
  padding: 12rpx 0;
}

.missing-locale {
  padding: 16rpx 36rpx;
  border-bottom: 1rpx solid var(--lux-hairline);
}

.missing-locale:last-child {
  border-bottom: none;
}

.missing-locale-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.missing-locale-name {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.06em;
}

.missing-locale-count {
  font-size: 22rpx;
  color: var(--text-primary);  /* B′ 金在浅底不作文字色：原 --warning-color → 炭墨（同 .missing-locale-name） */
  letter-spacing: 0.04em;
}

.missing-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 0;
}

.missing-key {
  font-size: 24rpx;
  color: var(--text-primary);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-feature-settings: 'tnum';
  letter-spacing: 0.02em;
}

.missing-avail {
  font-size: 20rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.02em;
  max-width: 240rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.missing-fill {
  width: 56rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: var(--text-on-primary);
  background: var(--gradient-primary);
  border-radius: var(--lux-radius-inner);
  letter-spacing: 0.04em;
  font-weight: 500;
  flex-shrink: 0;
  box-shadow: var(--lux-shadow-green);
}

/* ---------- 缺失翻译 — 全齐空状态 ---------- */
.missing-empty {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 0;
  font-size: 22rpx;
  color: var(--success-color);
  letter-spacing: 0.04em;
}

.missing-check-icon {
  width: 24rpx;
  height: 24rpx;
  flex-shrink: 0;
}
