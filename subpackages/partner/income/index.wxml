<zy-navbar title="收入统计" />
<scroll-view
  scroll-y
  enhanced
  refresher-enabled="{{true}}"
  refresher-triggered="{{_refresherTriggered}}"
  bindrefresherrefresh="_onRefresherRefresh"
  bindscrolltolower="_onScrollToLower"
  bindscroll="_onScroll"
  lower-threshold="100"
  style="height: calc(100vh - {{_navbarHeight}}px);"
>
<view class="gallery-container">
  <view wx:if="{{isLoading}}" class="loading-container">
    <view class="loading-content">
      <view class="lux-cascade">
  <view class="lux-cascade-dot" style="left: 20rpx; background: #C9A24B; animation-delay: 0ms;"></view>
  <view class="lux-cascade-dot" style="left: 36rpx; background: #A8894A; animation-delay: 150ms;"></view>
  <view class="lux-cascade-dot" style="left: 52rpx; background: #C9A24B; animation-delay: 300ms;"></view>
  <view class="lux-cascade-dot" style="left: 68rpx; background: #A8894A; animation-delay: 450ms;"></view>
  <view class="lux-cascade-dot" style="left: 84rpx; background: #C9A24B; animation-delay: 600ms;"></view>
  <view class="lux-cascade-dot" style="left: 100rpx; background: #A8894A; animation-delay: 750ms;"></view>
  <view class="lux-cascade-dot" style="left: 48rpx; background: #C9A24B; animation-delay: 900ms;"></view>

      </view>
      <text class="loading-text">加载中</text>
    </view>
  </view>

  <block wx:else>
    <view class="gallery-header">
      <view class="brand-block">
        <view class="brand-accent-bar"></view>
        <view class="brand-main">
          <text class="brand-text">收入概览</text>
        </view>
        <view class="brand-meta">
          <view class="brand-meta-line"></view>
          <text class="brand-subtitle">财务数据</text>
        </view>
      </view>
    </view>

    <view class="gallery-hall">
      <view wx:if="{{overview}}" class="gallery-card income-overview-card">
        <view class="card-accent income-accent"></view>
        <view class="card-body">
          <view class="overview-total">
            <text class="overview-label">累计收入</text>
            <text class="overview-value">¥{{totalIncomeText}}</text>
          </view>
          <view class="overview-divider"></view>
          <view class="overview-row overview-row-top">
            <view class="overview-stat">
              <text class="overview-stat-value">¥{{commissionText}}</text>
              <text class="overview-stat-label">带货</text>
              <text class="overview-stat-sub">（团购+商城）</text>
            </view>
            <view class="overview-stat">
              <text class="overview-stat-value">¥{{activityText}}</text>
              <text class="overview-stat-label">活动</text>
            </view>
          </view>
          <view class="overview-row overview-row-bottom">
            <view class="overview-stat">
              <text class="overview-stat-value">¥{{hostingText}}</text>
              <text class="overview-stat-label">寄养</text>
            </view>
            <view class="overview-stat">
              <text class="overview-stat-value">¥{{feedingText}}</text>
              <text class="overview-stat-label">服务</text>
            </view>
          </view>
        </view>
      </view>

      <view wx:if="{{wallet}}" class="gallery-card wallet-card">
        <view class="card-accent wallet-accent"></view>
        <view class="card-body">
          <view class="wallet-row">
            <view class="wallet-stat">
              <text class="wallet-value">¥{{walletBalanceText}}</text>
              <text class="wallet-label">可提现</text>
            </view>
            <view class="wallet-stat">
              <text class="wallet-value">¥{{walletCardTotalIncome}}</text>
              <text class="wallet-label">总收入</text>
            </view>
            <view class="wallet-stat">
              <text class="wallet-value">¥{{walletTotalWithdrawnText}}</text>
              <text class="wallet-label">已提现</text>
            </view>
          </view>
          <view class="wallet-actions">
            <view class="withdraw-btn" bindtap="onWithdrawTap">提现</view>
            <view class="withdraw-records-link" bindtap="onWithdrawRecordsTap">提现记录</view>
          </view>
        </view>
      </view>

      <view wx:if="{{commissionRates.length}}" class="gallery-card rates-card">
        <view class="card-accent rates-accent"></view>
        <view class="card-body">
          <view class="rates-title">
            <text class="rates-title-text">分成比例</text>
          </view>
          <view class="rates-grid">
            <view wx:for="{{commissionRates}}" wx:key="key" class="rates-item">
              <text class="rates-item-value">{{item.rate}}%</text>
              <text class="rates-item-label">{{item.name}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="gallery-entrance">
        <view class="entrance-line"></view>
        <text class="entrance-label">收入明细</text>
      </view>

      <view class="tab-bar">
        <view class="tab-item {{activeTab === 'all' ? 'tab-active' : ''}}" bindtap="onTabChange" data-tab="all">全部</view>
        <view class="tab-item {{activeTab === 'tuan' ? 'tab-active' : ''}}" bindtap="onTabChange" data-tab="tuan">团购</view>
        <view class="tab-item {{activeTab === 'mall' ? 'tab-active' : ''}}" bindtap="onTabChange" data-tab="mall">商城</view>
        <view class="tab-item {{activeTab === 'activity' ? 'tab-active' : ''}}" bindtap="onTabChange" data-tab="activity">活动</view>
        <view class="tab-item {{activeTab === 'boarding' ? 'tab-active' : ''}}" bindtap="onTabChange" data-tab="boarding">寄养</view>
        <view class="tab-item {{activeTab === 'feeding' ? 'tab-active' : ''}}" bindtap="onTabChange" data-tab="feeding">服务</view>
      </view>

      <view wx:if="{{isDetailLoading}}" class="detail-loading">
        <view class="lux-cascade">
          <view class="lux-cascade-dot"></view>
          <view class="lux-cascade-dot"></view>
          <view class="lux-cascade-dot"></view>
          <view class="lux-cascade-dot"></view>
          <view class="lux-cascade-dot"></view>
          <view class="lux-cascade-dot"></view>
          <view class="lux-cascade-dot"></view>
        </view>
        <text class="loading-text">加载中</text>
      </view>

      <view wx:elif="{{details.length === 0}}" class="gallery-empty">
        <view class="empty-line"></view>
        <text class="empty-text">暂无记录</text>
      </view>

      <block wx:else>
      <view wx:for="{{details}}" wx:key="id" class="gallery-card detail-card">
        <view class="card-accent"></view>
        <view class="card-body">
          <view class="detail-row">
            <view class="detail-left">
              <text class="detail-type">{{item.typeName || (item.type === 'tuan' ? '团购' : (item.type === 'mall' ? '商城' : (item.type === 'activity' ? '活动' : (item.type === 'boarding' ? '寄养' : '服务'))))}}</text>
              <text class="detail-desc">{{item.description}}</text>
              <view wx:if="{{item.buyerNickName}}" class="detail-buyer">
                <image wx:if="{{item.buyerAvatarUrl}}" class="detail-buyer-avatar" src="{{item.buyerAvatarUrl}}" mode="aspectFill" />
                <text class="detail-buyer-name">{{item.buyerNickName}}</text>
              </view>
            </view>
            <view class="detail-right">
              <text class="detail-amount">{{item.status === 'cancelled' || item.status === 'reversed' ? '' : '+'}}¥{{item.amount}}</text>
              <text class="detail-status" style="color: {{item.statusColor}}">{{item.statusText}}</text>
            </view>
          </view>
        </view>
      </view>
      <view wx:if="{{isLoadingMore}}" class="loading-more">
        <text class="loading-text">加载中</text>
      </view>
      </block>
    </view>
  </block>

  <!-- 提现弹窗 -->
  <root-portal>
  <view wx:if="{{showWithdrawModal}}" class="modal-mask" bindtap="onWithdrawCancel">
    <view class="modal-content" catchtap="">
      <view class="modal-title">申请提现</view>
      <view class="modal-balance">可提现余额：¥{{withdrawBalance}}</view>
      <view class="modal-payout">
        <text class="modal-payout-label">收款方式</text>
        <radio-group class="modal-payout-group" bindchange="onPayoutMethodChange">
          <label class="modal-payout-item {{payoutMethod === 'wechat' ? 'active' : ''}}">
            <radio value="wechat" checked="{{payoutMethod === 'wechat'}}" color="#2F6B4F" style="display:none" />
            <text>微信</text>
          </label>
          <label class="modal-payout-item {{payoutMethod === 'alipay' ? 'active' : ''}}">
            <radio value="alipay" checked="{{payoutMethod === 'alipay'}}" color="#2F6B4F" style="display:none" />
            <text>支付宝</text>
          </label>
          <label class="modal-payout-item {{payoutMethod === 'bank' ? 'active' : ''}}">
            <radio value="bank" checked="{{payoutMethod === 'bank'}}" color="#2F6B4F" style="display:none" />
            <text>银行卡</text>
          </label>
        </radio-group>
      </view>
      <view class="modal-payout-account">
        <text wx:if="{{currentChannelAccountText}}" class="payout-account-text">{{currentChannelAccountText}}</text>
        <text wx:else class="payout-account-empty">未预留该收款方式</text>
        <text class="modal-all-btn" bindtap="openPayeeManage">管理收款账号</text>
      </view>
      <view class="modal-input-row">
        <text class="modal-input-prefix">¥</text>
        <input class="modal-input" type="digit" placeholder="请输入提现金额" value="{{withdrawAmount}}" bindinput="onWithdrawAmountInput" focus="{{showWithdrawModal}}" />
      </view>
      <view class="modal-tips">
        <text>最低1元，单笔最高500元，每日限提10次</text>
        <text class="modal-all-btn" bindtap="onWithdrawAll">全部提现</text>
      </view>
      <view class="modal-btns">
        <view class="modal-btn modal-btn-cancel" bindtap="onWithdrawCancel">取消</view>
        <view class="modal-btn modal-btn-confirm {{isSubmitting ? 'modal-btn-disabled' : ''}}" bindtap="onWithdrawConfirm">{{isSubmitting ? '提交中...' : '确认提现'}}</view>
      </view>
    </view>
  </view>
  </root-portal>
  <!-- 收款账号管理（v5.1） -->
  <root-portal>
  <view wx:if="{{payeeModalVisible}}" class="modal-mask" bindtap="closePayeeManage">
    <view class="modal-content payee-modal" catchtap="">
      <view class="modal-title">收款账号</view>
      <view class="payee-section">
        <text class="payee-label">微信（微信号/手机号）</text>
        <input class="modal-input payee-input" placeholder="选填" value="{{payeeForm.wechat}}" data-field="wechat" bindinput="onPayeeInput" />
      </view>
      <view class="payee-section">
        <text class="payee-label">支付宝（邮箱/手机号）</text>
        <input class="modal-input payee-input" placeholder="选填" value="{{payeeForm.alipay}}" data-field="alipay" bindinput="onPayeeInput" />
      </view>
      <view class="payee-section">
        <text class="payee-label">银行卡</text>
        <input class="modal-input payee-input" placeholder="开户行（选填）" value="{{payeeForm.bank.bankName}}" data-field="bankName" bindinput="onBankInput" />
        <input class="modal-input payee-input" placeholder="卡号（选填）" type="number" value="{{payeeForm.bank.cardNo}}" data-field="cardNo" bindinput="onBankInput" />
        <input class="modal-input payee-input" placeholder="持卡人（选填）" value="{{payeeForm.bank.holder}}" data-field="holder" bindinput="onBankInput" />
      </view>
      <view class="modal-tips">
        <text>至少预留一种收款方式（提现时需选择）</text>
      </view>
      <view class="modal-btns">
        <view class="modal-btn modal-btn-cancel" bindtap="closePayeeManage">取消</view>
        <view class="modal-btn modal-btn-confirm {{savingPayee ? 'modal-btn-disabled' : ''}}" bindtap="onSavePayee">{{savingPayee ? '保存中...' : '保存'}}</view>
      </view>
    </view>
  </view>
  </root-portal>
</view>
</scroll-view>
