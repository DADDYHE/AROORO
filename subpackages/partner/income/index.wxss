/* ================================================================
   AROORO 合伙人收入页 · 深森林绿 × 香槟金 × 奶油白 高奢风格
   Skyline 兼容：无 :active / transition 仅 transform & opacity / 单行截断
   ================================================================ */
@import '../common.wxss';

/* ============================================
   收入仪表盘 — A 纸面台账（2026-09-10 升级）
   大数字概览 + 钱包行线 + 费率网格 + 文字 tab 流水
   ============================================ */

/* ---------- 统一拆卡：gallery-hall 内白卡 → 纸面分节 ---------- */
.gallery-hall .gallery-card {
  background: transparent;
  border-radius: 0;
  border: none;
  box-shadow: none;
  padding: 44rpx var(--page-padding) 40rpx;
  margin-bottom: 0;
  border-bottom: 1rpx solid rgba(26, 26, 23, 0.14);
}

.gallery-hall .gallery-card:last-child {
  border-bottom: none;
}

/* ---------- 佣金统计 ---------- */
.overview-total {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 32rpx;
}

.overview-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  letter-spacing: 0.24em;
  font-weight: 400;
}

.overview-value {
  font-size: 64rpx;
  font-weight: 300;
  color: var(--text-primary);
  letter-spacing: 0.02em;
  font-feature-settings: 'tnum';
  line-height: 1.1;
}

.overview-divider {
  height: 1rpx;
  background: rgba(26, 26, 23, 0.14);
  margin-bottom: 28rpx;
}

.overview-row {
  display: flex;
  justify-content: space-around;
}

.overview-row-bottom {
  margin-top: 28rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid rgba(26, 26, 23, 0.14);
}

.overview-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.overview-stat-value {
  font-size: 30rpx;
  font-weight: 400;
  color: var(--text-primary);
  font-feature-settings: 'tnum';
}

.overview-stat-value-positive {
  color: var(--lux-gold-ink);
}

.overview-stat-label {
  font-size: 20rpx;
  color: var(--text-secondary);
  letter-spacing: 0.16em;
  font-weight: 400;
}

.overview-stat-sub {
  font-size: 18rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.04em;
}

/* ---------- 钱包（三列数字带 + 提现动作行） ---------- */
.wallet-row {
  display: flex;
  justify-content: space-around;
  margin-bottom: 28rpx;
}

.wallet-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.wallet-value {
  font-size: 32rpx;
  font-weight: 400;
  color: var(--text-primary);
  font-feature-settings: 'tnum';
}

.wallet-value-accent {
  color: var(--lux-gold-ink);
  font-weight: 500;
}

.wallet-label {
  font-size: 20rpx;
  color: var(--text-secondary);
  letter-spacing: 0.16em;
  font-weight: 400;
}

.wallet-actions {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(26, 26, 23, 0.14);
}

.withdraw-btn {
  padding: 0 48rpx;
  height: 68rpx;
  line-height: 66rpx;
  font-size: 26rpx;
  font-weight: 500;
  letter-spacing: 0.08em;
  color: var(--lux-gold-ink);
  background: transparent;
  border: 1rpx solid var(--lux-gold-ink);
  border-radius: var(--lux-radius-pill);
}

.withdraw-records-link {
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 0.04em;
}

/* ---------- 费率（纸面网格） ---------- */
.rates-title {
  margin-bottom: 24rpx;
}

.rates-title-text {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.16em;
}

.rates-grid {
  display: flex;
  justify-content: space-around;
}

.rates-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.rates-item-value {
  font-size: 30rpx;
  font-weight: 400;
  color: var(--lux-gold-ink);
  font-feature-settings: 'tnum';
}

.rates-item-label {
  font-size: 20rpx;
  color: var(--text-secondary);
  letter-spacing: 0.16em;
  font-weight: 400;
}

/* ---------- 分区标题 ---------- */
.gallery-entrance {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 36rpx 0 20rpx;
  padding: 0 var(--page-padding);
}

.entrance-line {
  width: 32rpx;
  height: 2rpx;
  background: var(--lux-gold-ink);
}

.entrance-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  letter-spacing: 0.2em;
  font-weight: 400;
}

/* ---------- Tab 筛选（文字 tab + 金墨短线） ---------- */
.tab-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 36rpx;
  margin: 0 var(--page-padding) 8rpx;
  padding-bottom: 0;
  border-bottom: 1rpx solid rgba(26, 26, 23, 0.14);
}

.tab-item {
  position: relative;
  padding: 8rpx 0 18rpx;
  font-size: 24rpx;
  color: var(--text-tertiary);
  background: transparent;
  border: none;
  font-weight: 400;
  letter-spacing: 0.04em;
}

.tab-active {
  color: var(--text-primary);
  font-weight: 500;
  background: transparent;
}

.tab-active::after {
  content: '';
  position: absolute;
  bottom: -1rpx;
  left: 50%;
  margin-left: -18rpx;
  width: 36rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: var(--lux-gold-ink);
}

/* ---------- 流水明细行（紧凑：分隔线由外层 detail-card 提供，内层 22rpx 主导行高） ---------- */
.gallery-hall .detail-card {
  padding: 0 var(--page-padding);
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 0;
}

.detail-left {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  flex: 1;
  min-width: 0;
}

.detail-type {
  font-size: 25rpx;
  font-weight: 400;
  color: var(--text-primary);
  letter-spacing: 0.01em;
}

.detail-desc {
  display: block;
  width: 100%;
  font-size: 20rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.02em;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.detail-buyer {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 2rpx;
}

.detail-order-amount {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 4rpx;
}

.detail-order-amount-label {
  font-size: 20rpx;
  color: var(--text-tertiary);
}

.detail-order-amount-value {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.detail-buyer-avatar {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: var(--divider-color);
  flex-shrink: 0;
}

.detail-buyer-name {
  font-size: 20rpx;
  color: var(--text-tertiary);
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-amount {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--lux-gold-ink);
  font-feature-settings: 'tnum';
  flex-shrink: 0;
  margin-left: 16rpx;
}

.detail-amount-negative {
  color: var(--error-color);
}

.detail-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.detail-status {
  font-size: 20rpx;
  letter-spacing: 0.02em;
}

/* ---------- 空状态 ---------- */
.empty-line {
  width: 48rpx;
  height: 1rpx;
  background: var(--accent-color);
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 0.16em;
}

/* ---------- 金粒瀑布 · 切换分类加载 ---------- */
.detail-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 44rpx;
  padding: 100rpx 0;
}

/* ---------- 钱包操作 ---------- */
.wallet-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(26, 26, 23, 0.14);
}

.withdraw-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: var(--gradient-primary);
  color: var(--text-on-primary);
  font-size: 24rpx;
  font-weight: 500;
  padding: 16rpx 40rpx;
  border-radius: var(--zy-radius-lg);
  letter-spacing: 0.1em;
  box-shadow: var(--lux-shadow-green);
}

.withdraw-records-link {
  font-size: 24rpx;
  color: var(--primary-color);
  letter-spacing: 0.03em;
  font-weight: 400;
}

/* ---------- 提现弹窗 ---------- */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--overlay-color);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  width: 600rpx;
  background: var(--lux-card-bg);
  border-radius: var(--zy-radius-xl);
  padding: 48rpx 40rpx;
  border: 1rpx solid rgba(26, 26, 23, 0.14);
  box-shadow: var(--lux-shadow-elevated);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-primary);
  text-align: center;
  margin-bottom: 24rpx;
  letter-spacing: 0.05em;
}

.modal-balance {
  font-size: 24rpx;
  color: var(--text-secondary);
  text-align: center;
  margin-bottom: 28rpx;
  letter-spacing: 0.03em;
}

.modal-input-row {
  display: flex;
  align-items: center;
  border: 1rpx solid rgba(26, 26, 23, 0.14);
  border-radius: var(--lux-radius-card);
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  background: var(--lux-card-cream);
}

.modal-input-prefix {
  font-size: 36rpx;
  font-weight: 300;
  color: var(--text-primary);
  margin-right: 12rpx;
}

.modal-input {
  flex: 1;
  font-size: 36rpx;
  font-weight: 300;
  color: var(--text-primary);
  height: 50rpx;
  font-family: inherit;
  font-feature-settings: 'tnum';
}

.modal-tips {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 36rpx;
}

.modal-tips text:first-child {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.modal-all-btn {
  font-size: 24rpx;
  color: var(--primary-color);
  font-weight: 400;
  letter-spacing: 0.03em;
}

.modal-btns {
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: var(--zy-radius-lg);
  font-size: 26rpx;
  font-weight: 500;
  letter-spacing: 0.1em;
  border: none;
}

.modal-btn::after {
  border: none;
}

.modal-btn-cancel {
  background: var(--divider-color);
  color: var(--text-secondary);
}

.modal-btn-confirm {
  background: var(--gradient-primary);
  color: var(--text-on-primary);
  box-shadow: var(--lux-shadow-green);
}

.modal-btn-disabled {
  opacity: 0.5;
}

/* ==================== 收款方式选择 + 收款账号管理（v5.1） ==================== */
.modal-payout {
  margin-bottom: 16rpx;
}

.modal-payout-label {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.modal-payout-group {
  display: flex;
  gap: 16rpx;
}

.modal-payout-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 12rpx;
  border: 1rpx solid rgba(26, 26, 23, 0.14);
  background: var(--lux-card-cream);
  font-size: 26rpx;
  color: var(--text-secondary);
}

.modal-payout-item.active {
  border-color: var(--primary-color);
  color: var(--primary-color);
  background: rgba(47, 107, 79, 0.08);
}

.modal-payout-account {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.payout-account-text {
  font-size: 24rpx;
  color: var(--text-primary);
}

.payout-account-empty {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.payee-modal {
  max-height: 80vh;
  overflow-y: auto;
}

.payee-section {
  margin-bottom: 20rpx;
}

.payee-label {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 10rpx;
}

.payee-input {
  margin-bottom: 12rpx;
  border: 1rpx solid rgba(26, 26, 23, 0.14);
  border-radius: 12rpx;
  padding: 20rpx 22rpx;
  background: var(--lux-card-cream);
  font-size: 28rpx;
  font-weight: 400;
  color: var(--text-primary);
  height: auto;
  min-height: 44rpx;
  box-sizing: border-box;
}

/* ================================================================
   非合伙人引导卡（403 态 · 2026-09-10）
   ================================================================ */
.pp-noperm {
  margin: 60rpx var(--page-padding);
  padding: 56rpx 40rpx;
  border: 1rpx solid rgba(26, 26, 23, 0.14);
  border-radius: var(--lux-radius-card);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.pp-noperm-eyebrow {
  font-size: 20rpx;
  color: var(--lux-gold-ink);
  letter-spacing: 0.24em;
}

.pp-noperm-title {
  font-size: 36rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.08em;
}

.pp-noperm-desc {
  font-size: 23rpx;
  color: var(--text-tertiary);
  line-height: 1.7;
  text-align: center;
  margin-bottom: 12rpx;
}

.pp-noperm-btn {
  min-width: 340rpx;
  height: 84rpx;
  padding: 0 56rpx;
  border-radius: var(--lux-radius-pill, 999rpx);
  background: var(--lux-green-grad);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--lux-shadow-green);
  transition: transform 240ms cubic-bezier(0.25, 0.1, 0.25, 1), opacity 240ms cubic-bezier(0.25, 0.1, 0.25, 1);
}

.pp-noperm-btn--pressed {
  transform: scale(0.98);
  opacity: 0.9;
}

.pp-noperm-btn-text {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-on-primary);
  letter-spacing: 0.12em;
}
