@import '../common.wxss';

.card-accent {
  width: 3rpx;
  height: 100%;
  position: absolute;
  left: 0;
  top: 0;
  background: linear-gradient(180deg, var(--activity-primary) 0%, var(--activity-primary-mid) 100%);
}

.income-accent {
  background: linear-gradient(180deg, var(--activity-primary) 0%, var(--success-color) 100%) !important;
}

.wallet-accent {
  background: linear-gradient(180deg, #6B7D5A 0%, #3A4626 100%) !important;
}

.rates-accent {
  background: linear-gradient(180deg, var(--warning-color) 0%, var(--boarding-primary) 100%) !important;
}

.rates-title {
  margin-bottom: 24rpx;
}

.rates-title-text {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 4rpx;
}

.rates-grid {
  display: flex;
  justify-content: space-around;
}

.rates-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.rates-item-value {
  font-size: 32rpx;
  font-weight: 300;
  color: var(--text-primary);
}

.rates-item-label {
  font-size: 20rpx;
  color: var(--text-secondary);
  letter-spacing: 4rpx;
}

.card-body {
  position: relative;
  padding: 32rpx 36rpx;
}

.overview-total {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 24rpx;
}

.overview-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  letter-spacing: 4rpx;
}

.overview-value {
  font-size: 56rpx;
  font-weight: 300;
  color: var(--text-primary);
  letter-spacing: 2rpx;
}

.overview-divider {
  height: 1rpx;
  background: var(--divider-color);
  margin-bottom: 24rpx;
}

.overview-row {
  display: flex;
  justify-content: space-around;
}

.overview-row-bottom {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--divider-color);
}

.overview-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.overview-stat-value {
  font-size: 32rpx;
  font-weight: 300;
  color: var(--text-primary);
}

.overview-stat-label {
  font-size: 20rpx;
  color: var(--text-secondary);
  letter-spacing: 4rpx;
}

.overview-stat-sub {
  font-size: 16rpx;
  color: var(--text-tertiary);
  letter-spacing: 2rpx;
}

.wallet-row {
  display: flex;
  justify-content: space-around;
}

.wallet-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.wallet-value {
  font-size: 32rpx;
  font-weight: 300;
  color: var(--text-primary);
}

.wallet-label {
  font-size: 20rpx;
  color: var(--text-secondary);
  letter-spacing: 4rpx;
}

.gallery-entrance {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 32rpx 0 24rpx;
}

.entrance-line {
  width: 40rpx;
  height: 2rpx;
  background: var(--text-tertiary);
}

.entrance-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  letter-spacing: 8rpx;
}

.tab-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.tab-item {
  padding: 12rpx 28rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
  background: var(--card-color);
}

.tab-active {
  background: linear-gradient(135deg, var(--activity-primary) 0%, var(--activity-primary-mid) 100%);
  color: var(--card-color);
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.detail-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.detail-type {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.detail-desc {
  font-size: 20rpx;
  color: var(--text-secondary);
}

.detail-buyer {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 4rpx;
}

.detail-buyer-avatar {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: var(--bg-secondary, #f0f0f0);
}

.detail-buyer-name {
  font-size: 20rpx;
  color: var(--text-secondary);
  max-width: 220rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-amount {
  font-size: 32rpx;
  font-weight: 300;
  color: var(--success-color);
}
.empty-line {
  width: 60rpx;
  height: 2rpx;
  background: var(--text-tertiary);
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 4rpx;
}

/* 提现按钮和记录入口 */
.wallet-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--divider-color);
}

.withdraw-btn {
  background: linear-gradient(135deg, var(--activity-primary) 0%, var(--activity-primary-mid) 100%);
  color: var(--card-color);
  font-size: 26rpx;
  font-weight: 500;
  padding: 16rpx 48rpx;
  border-radius: 12rpx;
  letter-spacing: 4rpx;
}

.withdraw-records-link {
  font-size: 24rpx;
  color: var(--activity-primary);
  letter-spacing: 2rpx;
}

/* 提现弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  width: 600rpx;
  background: var(--card-color);
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 500;
  color: var(--text-primary);
  text-align: center;
  margin-bottom: 32rpx;
}

.modal-balance {
  font-size: 26rpx;
  color: var(--text-secondary);
  text-align: center;
  margin-bottom: 32rpx;
}

.modal-input-row {
  display: flex;
  align-items: center;
  border: 2rpx solid var(--gray-200);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}

.modal-input-prefix {
  font-size: 40rpx;
  font-weight: 300;
  color: var(--text-primary);
  margin-right: 12rpx;
}

.modal-input {
  flex: 1;
  font-size: 40rpx;
  font-weight: 300;
  color: var(--text-primary);
  height: 56rpx;
}

.modal-tips {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.modal-tips text:first-child {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.modal-all-btn {
  font-size: 24rpx;
  color: var(--activity-primary);
  font-weight: 500;
}

.modal-btns {
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 4rpx;
}

.modal-btn-cancel {
  background: var(--divider-color);
  color: var(--text-secondary);
}

.modal-btn-confirm {
  background: linear-gradient(135deg, var(--activity-primary) 0%, var(--activity-primary-mid) 100%);
  color: var(--card-color);
}

.modal-btn-disabled {
  opacity: 0.6;
  pointer-events: none;
}
