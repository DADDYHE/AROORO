@import '../common.wxss';

.card-accent {
  width: 3rpx;
  height: 100%;
  position: absolute;
  left: 0;
  top: 0;
  background: linear-gradient(180deg, var(--activity-primary) 0%, var(--activity-primary-mid) 100%);
}

.card-body {
  position: relative;
  padding: 32rpx 36rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}

.info-key {
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 2rpx;
}

.info-val {
  font-size: 26rpx;
  color: var(--text-primary);
  text-align: right;
  max-width: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.info-divider {
  height: 1rpx;
  background: var(--divider-color);
  margin: 4rpx 0;
}

.status-tag {
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.tag-active {
  background: rgba(79, 94, 53, 0.12);
  color: var(--activity-primary-mid);
}

.tag-inactive {
  background: var(--divider-color);
  color: var(--text-secondary);
}

.pending-title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-primary);
  display: block;
  margin-bottom: 12rpx;
}

.pending-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  display: block;
}

.contact-cs-btn {
  margin-top: 16rpx;
  padding: 12rpx 32rpx;
  font-size: 24rpx;
  color: var(--card-color);
  background: var(--activity-primary);
  border-radius: 32rpx;
  border: none;
  line-height: normal;
}

.contact-cs-btn::after {
  border: none;
}

.gallery-entrance {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 32rpx 0 24rpx;
}

.entrance-line {
  width: 40rpx;
  height: 2rpx;
  background: var(--text-tertiary);
}

.entrance-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  letter-spacing: 8rpx;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
}

.card-status {
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.status-pending {
  background: rgba(255, 149, 0, 0.12);
  color: var(--warning-color);
}

.status-confirmed {
  background: rgba(0, 122, 255, 0.12);
  color: var(--info-color);
}

.status-checked_in {
  background: rgba(79, 94, 53, 0.12);
  color: var(--activity-primary-mid);
}

.status-completed {
  background: rgba(52, 199, 89, 0.12);
  color: var(--success-color);
}

.status-cancelled {
  background: rgba(255, 59, 48, 0.12);
  color: var(--error-color);
}

.card-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.card-info-item {
  font-size: 22rpx;
  color: var(--text-secondary);
}
.empty-line {
  width: 60rpx;
  height: 2rpx;
  background: var(--text-tertiary);
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 4rpx;
}
