@import '../common.wxss';

/* ============================================
   AROORO 寄养商家资料
   商家资料编辑 — 基本信息 + 服务项目 + 价格表
   ============================================ */

/* ---------- 卡片色条 — 寄养板块使用暖陶土色 ---------- */
.card-accent {
  width: 3rpx;
  height: 100%;
  position: absolute;
  left: 0;
  top: 0;
  background: var(--boarding-primary);
}

.card-body {
  position: relative;
  padding: 32rpx 36rpx;
}

/* ---------- 信息行 ---------- */
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.info-key {
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 1rpx;
  font-weight: 400;
}

.info-val {
  font-size: 26rpx;
  color: var(--text-primary);
  text-align: right;
  font-weight: 400;
  max-width: 420rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.info-divider {
  height: 1rpx;
  background: var(--lux-hairline);
  margin: 4rpx 0;
}

/* ---------- 状态标签 ---------- */
.status-tag {
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: var(--zy-radius-sm);
  font-weight: 400;
  letter-spacing: 1rpx;
}

.tag-active {
  background: var(--primary-tint-08);
  color: var(--primary-color);
}

.tag-inactive {
  background: var(--wash-neutral-10);
  color: var(--text-tertiary);
}

.tag-rejected {
  background: var(--wash-error-08);
  color: var(--error-color);
}

/* ---------- 操作行（编辑档案） ---------- */
.action-row {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
}

/* ---------- 待审核/提示区 ---------- */
.pending-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  display: block;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}

.pending-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  display: block;
  line-height: 1.6;
}

.contact-cs-btn {
  margin-top: 16rpx;
  padding: 14rpx 32rpx;
  font-size: 24rpx;
  color: var(--text-on-primary);
  background: var(--gradient-primary);
  border-radius: var(--zy-radius-lg);
  border: none;
  line-height: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 2rpx;
  font-weight: 400;
  box-shadow: var(--lux-shadow-green);
}

.contact-cs-btn::after {
  border: none;
}

/* ---------- 分区标题 ---------- */
.gallery-entrance {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 32rpx 0 24rpx;
}

.entrance-line {
  width: 32rpx;
  height: 1rpx;
  background: var(--accent-color);
}

.entrance-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  letter-spacing: 6rpx;
  font-weight: 400;
}

/* ---------- 卡片头部（列表型卡片） ---------- */
.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
  letter-spacing: 1rpx;
}

.card-status {
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: var(--zy-radius-sm);
  font-weight: 400;
  flex-shrink: 0;
  letter-spacing: 1rpx;
}

.status-pending {
  background: var(--mall-tint);
  color: var(--primary-color);  /* B′ 金在浅底不作文字色：原 --warning-color 2.4:1 → 深绿 11.3:1 */
}

.status-confirmed {
  background: var(--boarding-tint);
  color: var(--boarding-primary);
}

.status-checked_in {
  background: var(--primary-tint-08);
  color: var(--primary-color);
}

.status-completed {
  background: var(--wash-success-08);
  color: var(--success-color);
}

.status-cancelled {
  background: var(--wash-error-08);
  color: var(--error-color);
}

.status-paid {
  background: var(--mall-tint);
  color: var(--primary-color);
}

.status-rejected,
.status-refunded {
  background: var(--wash-error-08);
  color: var(--error-color);
}

.status-in_progress {
  background: var(--boarding-tint);
  color: var(--boarding-primary);
}

.status-pending_payment {
  background: var(--wash-neutral-10);
  color: var(--text-tertiary);
}

/* ---------- 订单操作按钮 ---------- */
.order-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--lux-hairline);
}

.order-btn {
  margin: 0;
  padding: 12rpx 36rpx;
  font-size: 24rpx;
  line-height: 1;
  border-radius: var(--zy-radius-lg);
  letter-spacing: 2rpx;
  font-weight: 400;
}

.order-btn::after {
  border: none;
}

.order-btn--primary {
  color: var(--text-on-primary);
  background: var(--primary-color);
}

.order-btn--ghost {
  color: var(--error-color);
  background: transparent;
  border: 1rpx solid var(--wash-error-08);
}

/* ---------- 卡片信息列表 ---------- */
.card-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.card-info-item {
  font-size: 22rpx;
  color: var(--text-secondary);
  letter-spacing: 0.5rpx;
}

/* ---------- 价格表（发丝行分隔） ---------- */
.price-table {
  margin-top: 8rpx;
}

.price-table-header {
  display: flex;
  padding: 16rpx 0;
  background: var(--lux-card-cream);
  margin: 0 -36rpx;
  padding-left: 36rpx;
  padding-right: 36rpx;
  border-bottom: 1rpx solid var(--lux-hairline);
}

.price-table-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--lux-hairline);
}

.price-table-row:last-child {
  border-bottom: none;
}

.price-table-cell {
  font-size: 24rpx;
  color: var(--text-secondary);
  flex: 1;
}

.price-table-cell:first-child {
  flex: 2;
}

.price-table-value {
  font-size: 26rpx;
  color: var(--boarding-primary);
  font-weight: 400;
  font-feature-settings: 'tnum';
  text-align: right;
}

.price-table-header .price-table-cell {
  font-size: 22rpx;
  color: var(--text-tertiary);
  letter-spacing: 2rpx;
  font-weight: 400;
}

/* ---------- 服务项目标签 ---------- */
.service-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 8rpx;
}

.service-tag {
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  background: var(--boarding-wash);  /* 原 var(--boarding-accent)：4.24→4.53（C类，白字/深字对比达标） */
  color: var(--boarding-primary);
  border-radius: var(--zy-radius-sm);
  font-weight: 400;
  letter-spacing: 1rpx;
}

/* ---------- 商家封面/头像 ---------- */
.profile-cover {
  width: 100%;
  height: 280rpx;
  border-radius: var(--lux-radius-card);
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: var(--lux-shadow-card);
}

.profile-cover-image {
  width: 100%;
  height: 100%;
}

.profile-avatar-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.profile-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--lux-radius-card);
  background: var(--boarding-accent);
  flex-shrink: 0;
  overflow: hidden;
}

.profile-name-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.profile-name {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 1rpx;
}

.profile-meta {
  font-size: 22rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.5rpx;
}

/* ---------- 空状态 ---------- */
.empty-line {
  width: 48rpx;
  height: 1rpx;
  background: var(--accent-color);
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 4rpx;
}

/* ---------- 编辑按钮 ---------- */
.edit-profile-btn {
  display: inline-flex;
  padding: 14rpx 32rpx;
  border: 1rpx solid var(--boarding-primary);
  color: var(--boarding-primary);
  border-radius: var(--zy-radius-lg);
  font-size: 24rpx;
  font-weight: 400;
  letter-spacing: 2rpx;
}

.edit-profile-btn::after {
  border: none;
}
