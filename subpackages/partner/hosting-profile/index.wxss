@import '../common.wxss';

/* ============================================
   AROORO 寄养商家资料
   商家资料编辑 — 基本信息 + 服务项目 + 价格表
   ============================================ */

/* ---------- 卡片色条 — 寄养板块使用暖陶土色 ---------- */
.card-accent {
  width: 3rpx;
  height: 100%;
  position: absolute;
  left: 0;
  top: 0;
  background: var(--boarding-primary);
}

.card-body {
  position: relative;
  padding: 32rpx 36rpx;
}

/* ---------- 信息行 ---------- */
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.info-key {
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 1rpx;
  font-weight: 400;
}

.info-val {
  font-size: 26rpx;
  color: var(--text-primary);
  text-align: right;
  font-weight: 400;
  max-width: 420rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.info-divider {
  height: 1rpx;
  background: rgba(26, 26, 23, 0.14);
  margin: 4rpx 0;
}

/* ---------- 状态标签 ---------- */
.status-tag {
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: var(--zy-radius-sm);
  font-weight: 400;
  letter-spacing: 1rpx;
}

.tag-active {
  background: var(--primary-tint-08);
  color: var(--primary-color);
}

.tag-inactive {
  background: var(--wash-neutral-10);
  color: var(--text-tertiary);
}

.tag-rejected {
  background: var(--wash-error-08);
  color: var(--error-color);
}

/* ---------- 操作行（编辑档案 + 主动开单） ---------- */
.action-row {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
}

.action-row--double {
  justify-content: space-between;
  gap: 16rpx;
}

.action-row--double .edit-profile-btn,
.action-row--double .invite-create-btn {
  flex: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin: 0;
}

/* ---------- 待审核/提示区 ---------- */
.pending-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  display: block;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}

.pending-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  display: block;
  line-height: 1.6;
}

.contact-cs-btn {
  margin-top: 16rpx;
  padding: 14rpx 32rpx;
  font-size: 24rpx;
  color: var(--text-on-primary);
  background: var(--gradient-primary);
  border-radius: var(--zy-radius-lg);
  border: none;
  line-height: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 2rpx;
  font-weight: 400;
  box-shadow: var(--lux-shadow-green);
}

.contact-cs-btn::after {
  border: none;
}

/* ---------- 分区标题 ---------- */
.gallery-entrance {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 32rpx 0 24rpx;
}

.entrance-line {
  width: 32rpx;
  height: 1rpx;
  background: var(--accent-color);
}

.entrance-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  letter-spacing: 6rpx;
  font-weight: 400;
}

/* ---------- 卡片头部（列表型卡片） ---------- */
.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
  letter-spacing: 1rpx;
}

.card-status {
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: var(--zy-radius-sm);
  font-weight: 400;
  flex-shrink: 0;
  letter-spacing: 1rpx;
}

.status-pending {
  background: var(--mall-tint);
  color: var(--primary-color);  /* B′ 金在浅底不作文字色：原 --warning-color 2.4:1 → 深绿 11.3:1 */
}

.status-confirmed {
  background: var(--boarding-tint);
  color: var(--boarding-primary);
}

.status-checked_in {
  background: var(--primary-tint-08);
  color: var(--primary-color);
}

.status-completed {
  background: var(--wash-success-08);
  color: var(--success-color);
}

.status-cancelled {
  background: var(--wash-error-08);
  color: var(--error-color);
}

.status-paid {
  background: var(--mall-tint);
  color: var(--primary-color);
}

.status-rejected,
.status-refunded {
  background: var(--wash-error-08);
  color: var(--error-color);
}

.status-in_progress {
  background: var(--boarding-tint);
  color: var(--boarding-primary);
}

.status-pending_payment {
  background: var(--wash-neutral-10);
  color: var(--text-tertiary);
}

/* ---------- 订单操作按钮 ---------- */
.order-actions {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(26, 26, 23, 0.14);
}

/* 按钮触控区加大（防误触进入卡片详情）：高 72rpx + 更大内边距 + 最小宽度 */
.order-btn {
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 176rpx;
  height: 72rpx;
  padding: 0 40rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  line-height: 1;
  border-radius: var(--zy-radius-lg);
  letter-spacing: 2rpx;
  font-weight: 500;
}

.order-btn::after {
  border: none;
}

.order-btn--primary {
  color: var(--text-on-primary);
  background: var(--primary-color);
}

.order-btn--ghost {
  color: var(--error-color);
  background: transparent;
  border: 1rpx solid var(--wash-error-08);
}

/* ---------- 卡片信息列表 ---------- */
.card-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.card-info-item {
  font-size: 22rpx;
  color: var(--text-secondary);
  letter-spacing: 0.5rpx;
}

/* ---------- 价格表（发丝行分隔） ---------- */
.price-table {
  margin-top: 8rpx;
}

.price-table-header {
  display: flex;
  padding: 16rpx 0;
  background: var(--lux-card-cream);
  margin: 0 -36rpx;
  padding-left: 36rpx;
  padding-right: 36rpx;
  border-bottom: 1rpx solid rgba(26, 26, 23, 0.14);
}

.price-table-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(26, 26, 23, 0.14);
}

.price-table-row:last-child {
  border-bottom: none;
}

.price-table-cell {
  font-size: 24rpx;
  color: var(--text-secondary);
  flex: 1;
}

.price-table-cell:first-child {
  flex: 2;
}

.price-table-value {
  font-size: 26rpx;
  color: var(--boarding-primary);
  font-weight: 400;
  font-feature-settings: 'tnum';
  text-align: right;
}

.price-table-header .price-table-cell {
  font-size: 22rpx;
  color: var(--text-tertiary);
  letter-spacing: 2rpx;
  font-weight: 400;
}

/* ---------- 服务项目标签 ---------- */
.service-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 8rpx;
}

.service-tag {
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  background: var(--boarding-wash);  /* 原 var(--boarding-accent)：4.24→4.53（C类，白字/深字对比达标） */
  color: var(--boarding-primary);
  border-radius: var(--zy-radius-sm);
  font-weight: 400;
  letter-spacing: 1rpx;
}

/* ---------- 商家封面/头像 ---------- */
.profile-cover {
  width: 100%;
  height: 280rpx;
  border-radius: var(--lux-radius-card);
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: var(--lux-shadow-card);
}

.profile-cover-image {
  width: 100%;
  height: 100%;
}

.profile-avatar-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.profile-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--lux-radius-card);
  background: var(--boarding-accent);
  flex-shrink: 0;
  overflow: hidden;
}

.profile-name-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.profile-name {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 1rpx;
}

.profile-meta {
  font-size: 22rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.5rpx;
}

/* ---------- 空状态 ---------- */
.empty-line {
  width: 48rpx;
  height: 1rpx;
  background: var(--accent-color);
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 4rpx;
}

/* ---------- 编辑按钮 ---------- */
.edit-profile-btn {
  display: inline-flex;
  padding: 14rpx 32rpx;
  border: 1rpx solid var(--boarding-primary);
  color: var(--boarding-primary);
  border-radius: var(--zy-radius-lg);
  font-size: 24rpx;
  font-weight: 400;
  letter-spacing: 2rpx;
}

.edit-profile-btn::after {
  border: none;
}

/* ---------- 主动开单按钮（金色主操作） ---------- */
.invite-create-btn {
  display: inline-flex;
  padding: 14rpx 32rpx;
  border: none;
  color: var(--text-on-accent);
  background: var(--lux-gold-grad);
  border-radius: var(--zy-radius-lg);
  font-size: 24rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  box-shadow: var(--lux-shadow-gold);
}

.invite-create-btn::after {
  border: none;
}

/* ---------- 我的开单入口行 ---------- */
.invite-entrance {
  position: relative;
}

.invite-entrance--pressed {
  opacity: 0.7;
}

.invite-entrance-arrow {
  width: 14rpx;
  height: 14rpx;
  border-right: 2rpx solid var(--text-tertiary);
  border-bottom: 2rpx solid var(--text-tertiary);
  transform: rotate(-45deg);
  margin-left: 12rpx;
}

/* ================================================================
   手风琴双节（2026-09-07）：我的开单 / 寄养订单——对齐 order-stats 台账语言
   ================================================================ */
.section-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 28rpx 0 20rpx;
  padding: 26rpx 28rpx;
  background: var(--card-cream, #FBF9F4);
  border: 1rpx solid rgba(26, 26, 23, 0.14);
  border-radius: 16rpx;
}

.section-head--expanded {
  background: var(--lux-green-grad-rich);
  border-color: transparent;
}

.section-head--expanded .section-name { color: #F7F5EF; }
.section-head--expanded .section-count { color: rgba(247, 245, 239, 0.75); }
.section-head--expanded .section-rule { background: rgba(247, 245, 239, 0.2); }
.section-head--expanded .section-chevron-ring { border-color: rgba(247, 245, 239, 0.4); }
.section-head--expanded .section-chevron { border-color: #F7F5EF; }

.section-name {
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 0.06em;
  color: var(--text-primary);
}

.section-count {
  font-size: 22rpx;
  letter-spacing: 0.08em;
  color: var(--accent-color);
}

.section-rule {
  flex: 1;
  height: 1rpx;
  background: rgba(26, 26, 23, 0.14);
}

.section-chevron-ring {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 1rpx solid var(--lux-hairline-gold);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.section-chevron {
  width: 12rpx;
  height: 12rpx;
  border-right: 2rpx solid var(--text-tertiary);
  border-bottom: 2rpx solid var(--text-tertiary);
  transform: rotate(45deg);
  transition: transform 200ms ease;
  flex-shrink: 0;
}

.section-chevron--collapsed { transform: rotate(-45deg); }

.section-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 0;
}

.section-empty-text {
  font-size: 24rpx;
  letter-spacing: 0.08em;
  color: var(--text-tertiary);
}

/* 邀请行卡 */
.inv-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(31, 58, 31, 0.14);
}

.inv-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.inv-title {
  font-size: 27rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.inv-sub {
  font-size: 21rpx;
  letter-spacing: 0.06em;
  color: var(--text-tertiary);
}

.inv-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
}

.inv-price {
  font-size: 30rpx;
  font-weight: 300;
  color: var(--text-primary);
}

.inv-actions {
  display: flex;
  gap: 12rpx;
}

.inv-act {
  font-size: 20rpx;
  line-height: 1;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: transparent;
  border: 1rpx solid var(--border-color, #E2DED3);
  color: var(--text-secondary);
  margin: 0;
}

button.inv-act::after { border: none; }

.inv-view-all {
  display: flex;
  justify-content: center;
  padding: 20rpx 0 4rpx;
}

/* ================================================================
   家庭卷宗（2026-09-07）：编辑式数据 + 状态章 + 元信息——对齐台账语言
   ================================================================ */
.brand-eyebrow {
  display: block;
  font-size: 19rpx;
  font-weight: 400;
  letter-spacing: 0.32em;
  color: var(--accent-color);
  margin-bottom: 10rpx;
}

.portfolio-card {
  padding: 32rpx 36rpx;
  border: 1rpx solid rgba(26, 26, 23, 0.14);
  border-radius: var(--zy-radius-sm);
  background: linear-gradient(180deg, var(--card-satin) 0%, var(--sheet-paper) 100%);
}

.portfolio-card--alert {
  border-color: var(--wash-error-20);
}

.portfolio-status-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.portfolio-status-tag {
  font-size: 22rpx;
  letter-spacing: 0.12em;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--lux-hairline-gold);
  color: var(--accent-color);
}

.tag-inactive.portfolio-status-tag,
.portfolio-status-tag.tag-inactive {
  color: var(--text-tertiary);
  border-color: rgba(26, 26, 23, 0.14);
}

.tag-rejected.portfolio-status-tag,
.portfolio-status-tag.tag-rejected {
  color: var(--error-color);
  border-color: var(--wash-error-20);
}

.portfolio-switch {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.portfolio-switch-label {
  font-size: 22rpx;
  letter-spacing: 0.08em;
  color: var(--text-tertiary);
}

.portfolio-divider {
  height: 1rpx;
  background: rgba(26, 26, 23, 0.14);
  margin: 26rpx 0;
}

.portfolio-stats {
  display: flex;
  align-items: flex-end;
}

.portfolio-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.portfolio-stat-divider {
  width: 1rpx;
  height: 52rpx;
  background: rgba(26, 26, 23, 0.14);
  margin: 0 24rpx;
  align-self: flex-end;
  margin-bottom: 6rpx;
}

.portfolio-stat-row {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
}

.portfolio-symbol {
  font-size: 22rpx;
  color: var(--primary-deep, #0F2410);
}

.portfolio-num {
  font-size: 44rpx;
  font-weight: 300;
  line-height: 1.1;
  letter-spacing: 0.02em;
  color: var(--primary-deep, #0F2410);
}

.portfolio-num--mode {
  font-size: 30rpx;
  font-weight: 400;
}

.portfolio-unit {
  font-size: 20rpx;
  color: var(--text-tertiary);
}

.portfolio-label {
  font-size: 20rpx;
  letter-spacing: 0.14em;
  color: var(--text-tertiary);
}

.portfolio-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 0;
}

.portfolio-meta-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--accent-color);
  flex-shrink: 0;
}

.portfolio-meta-text {
  font-size: 24rpx;
  letter-spacing: 0.03em;
  color: var(--text-secondary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.portfolio-title {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.04em;
  margin-bottom: 12rpx;
}

.portfolio-desc {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.portfolio-btn {
  margin-top: 20rpx;
  padding: 16rpx 40rpx;
  font-size: 24rpx;
  letter-spacing: 0.1em;
  border-radius: 999rpx;
  line-height: 1.2;
  margin-left: 0;
  margin-right: 0;
}

button.portfolio-btn::after { border: none; }

.portfolio-btn--primary {
  background: var(--lux-green-grad-rich);
  color: #F7F5EF;
}

/* 邀请卡（手风琴节内，对齐 invitation-list 结构） */
.inv-card { margin-bottom: 16rpx; }
.inv-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 14rpx;
}
.inv-card-title {
  font-size: 27rpx;
  font-weight: 500;
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.inv-note-line { color: var(--text-tertiary); }
.tag-filled {
  background: var(--primary-tint-08);
  color: var(--primary-color);
}

.section-note {
  display: block;
  font-size: 20rpx;
  letter-spacing: 0.04em;
  color: var(--text-tertiary);
  padding: 4rpx 0 12rpx;
}
