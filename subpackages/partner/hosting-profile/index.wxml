<zy-navbar title="家庭寄养" />
<scroll-view
  scroll-y
  enhanced
  refresher-enabled="{{true}}"
  refresher-triggered="{{_refresherTriggered}}"
  bindrefresherrefresh="_onRefresherRefresh"
  bindscrolltolower="_onScrollToLower"
  bindscroll="_onScroll"
  lower-threshold="100"
  style="height: calc(100vh - {{_navbarHeight}}px);"
>
<view class="gallery-container">
  <view wx:if="{{isLoading}}" class="loading-container">
    <view class="loading-content">
      <view class="lux-cascade">
  <view class="lux-cascade-dot" style="left: 20rpx; background: #C9A24B; animation-delay: 0ms;"></view>
  <view class="lux-cascade-dot" style="left: 36rpx; background: #A8894A; animation-delay: 150ms;"></view>
  <view class="lux-cascade-dot" style="left: 52rpx; background: #C9A24B; animation-delay: 300ms;"></view>
  <view class="lux-cascade-dot" style="left: 68rpx; background: #A8894A; animation-delay: 450ms;"></view>
  <view class="lux-cascade-dot" style="left: 84rpx; background: #C9A24B; animation-delay: 600ms;"></view>
  <view class="lux-cascade-dot" style="left: 100rpx; background: #A8894A; animation-delay: 750ms;"></view>
  <view class="lux-cascade-dot" style="left: 48rpx; background: #C9A24B; animation-delay: 900ms;"></view>

      </view>
      <text class="loading-text">加载中</text>
    </view>
  </view>

  <block wx:else>
    <view class="gallery-header">
      <view class="brand-block">
        <view class="brand-accent-bar"></view>
        <view class="brand-main">
          <text class="brand-text">家庭寄养</text>
        </view>
        <view class="brand-meta">
          <view class="brand-meta-line"></view>
          <text class="brand-subtitle" wx:if="{{hasProfile}}">{{profile.hostName}}</text>
          <text class="brand-subtitle" wx:else>寄养家庭管理</text>
        </view>
      </view>
    </view>

    <view class="gallery-hall">
      <!-- 无档案：引导创建 -->
      <view wx:if="{{!hasProfile}}" class="gallery-card">
        <view class="card-accent"></view>
        <view class="card-body">
          <text class="pending-title">暂无家庭寄养</text>
          <text class="pending-desc">创建寄养家庭档案并提交审核，通过后即可在「家庭寄养」频道上架接单。</text>
          <button class="contact-cs-btn" bindtap="goCreate">创建家庭寄养</button>
        </view>
      </view>

      <block wx:else>
        <!-- 档案状态卡 -->
        <view class="gallery-card profile-card">
          <view class="card-accent"></view>
          <view class="card-body">
            <view class="info-row">
              <view class="info-key">状态</view>
              <view class="info-val">
                <text class="status-tag {{profile.status === 'active' ? 'tag-active' : (profile.status === 'rejected' ? 'tag-rejected' : 'tag-inactive')}}">{{statusText}}</text>
              </view>
            </view>
            <view class="info-divider"></view>
            <view class="info-row">
              <view class="info-key">接单状态</view>
              <view class="info-val">
                <switch
                  checked="{{profile.isAcceptingOrders}}"
                  disabled="{{profile.status !== 'active' || acceptSwitching}}"
                  color="#1F3A1F"
                  bindchange="onAcceptToggle"
                />
              </view>
            </view>
            <view class="info-divider"></view>
            <view class="info-row">
              <view class="info-key">日单价</view>
              <view class="info-val">¥{{profile.pricePerDay || 0}}/天</view>
            </view>
            <view class="info-divider"></view>
            <view class="info-row">
              <view class="info-key">最大容量</view>
              <view class="info-val">{{profile.maxPets || 0}} 只</view>
            </view>
            <view class="info-divider" wx:if="{{profile.address}}"></view>
            <view class="info-row" wx:if="{{profile.address}}">
              <view class="info-key">地址</view>
              <view class="info-val">{{profile.address}}</view>
            </view>
            <view class="info-divider" wx:if="{{profile.phone}}"></view>
            <view class="info-row" wx:if="{{profile.phone}}">
              <view class="info-key">联系电话</view>
              <view class="info-val">{{profile.phone}}</view>
            </view>
          </view>
        </view>

        <!-- 驳回原因 + 重新提审 -->
        <view wx:if="{{profile.status === 'rejected'}}" class="gallery-card">
          <view class="card-accent"></view>
          <view class="card-body">
            <text class="pending-title">档案审核未通过</text>
            <text class="pending-desc" wx:if="{{profile.rejectReason}}">驳回原因：{{profile.rejectReason}}</text>
            <text class="pending-desc" wx:else>档案未通过审核，请修改后重新提交。</text>
            <button class="contact-cs-btn" bindtap="goEdit">修改并重新提交</button>
          </view>
        </view>

        <!-- 编辑入口 -->
        <view wx:if="{{profile.status !== 'rejected'}}" class="action-row">
          <button class="edit-profile-btn" bindtap="goEdit">编辑档案</button>
        </view>

        <view class="gallery-entrance">
          <view class="entrance-line"></view>
          <text class="entrance-label">寄养订单 ({{orderTotal}})</text>
        </view>

        <view wx:if="{{orders.length === 0}}" class="gallery-empty">
          <view class="empty-line"></view>
          <text class="empty-text">暂无订单</text>
        </view>

        <view wx:for="{{orders}}" wx:key="_id" class="gallery-card order-card">
          <view class="card-accent"></view>
          <view class="card-body">
            <view class="card-header">
              <text class="card-title">寄养订单{{item.orderNo ? ' · ' + item.orderNo : ''}}</text>
              <text class="card-status status-{{item.status}}">{{item.statusText}}</text>
            </view>
            <view class="card-info">
              <text class="card-info-item" wx:if="{{item.ownerName}}">宠物主人：{{item.ownerName}}</text>
              <text class="card-info-item" wx:if="{{item.startDate || item.endDate}}">寄养日期：{{item.startDate || '-'}} 至 {{item.endDate || '-'}}</text>
              <text class="card-info-item">金额：¥{{item.totalPrice || item.totalAmount || 0}}</text>
            </view>
            <view wx:if="{{item.status === 'paid' || item.status === 'confirmed' || item.status === 'in_progress'}}" class="order-actions">
              <button wx:if="{{item.status === 'paid'}}" class="order-btn order-btn--ghost" data-id="{{item._id}}" data-op="reject" catchtap="onOrderAction">拒单</button>
              <button wx:if="{{item.status === 'paid'}}" class="order-btn order-btn--primary" data-id="{{item._id}}" data-op="confirm" catchtap="onOrderAction">接单</button>
              <button wx:if="{{item.status === 'confirmed' || item.status === 'in_progress'}}" class="order-btn order-btn--primary" data-id="{{item._id}}" data-op="complete" catchtap="onOrderAction">完成寄养</button>
            </view>
          </view>
        </view>
      </block>
    </view>
  </block>
</view>
</scroll-view>
