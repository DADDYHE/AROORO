<zy-navbar title="{{t.BIZ_BX46V0}}" />
<scroll-view
  scroll-y
  enhanced
  refresher-enabled="{{true}}"
  refresher-triggered="{{_refresherTriggered}}"
  bindrefresherrefresh="_onRefresherRefresh"
  bindscrolltolower="_onScrollToLower"
  bindscroll="_onScroll"
  lower-threshold="100"
  style="height: calc(100vh - {{_navbarHeight}}px);"
>
<view class="gallery-container">
  <view wx:if="{{isLoading}}" class="loading-container">
    <view class="loading-content">
      <view class="lux-cascade">
  <view class="lux-cascade-dot" style="left: 20rpx; background: #C9A24B; animation-delay: 0ms;"></view>
  <view class="lux-cascade-dot" style="left: 36rpx; background: #A8894A; animation-delay: 150ms;"></view>
  <view class="lux-cascade-dot" style="left: 52rpx; background: #C9A24B; animation-delay: 300ms;"></view>
  <view class="lux-cascade-dot" style="left: 68rpx; background: #A8894A; animation-delay: 450ms;"></view>
  <view class="lux-cascade-dot" style="left: 84rpx; background: #C9A24B; animation-delay: 600ms;"></view>
  <view class="lux-cascade-dot" style="left: 100rpx; background: #A8894A; animation-delay: 750ms;"></view>
  <view class="lux-cascade-dot" style="left: 48rpx; background: #C9A24B; animation-delay: 900ms;"></view>

      </view>
      <text class="loading-text">{{t.BIZ_CSIK0}}</text>
    </view>
  </view>

  <block wx:else>
    <view class="gallery-header">
      <view class="brand-block">
        <view class="brand-accent-bar"></view>
        <view class="brand-main">
          <text class="brand-eyebrow">HOST PORTFOLIO</text>
          <text class="brand-text">{{t.BIZ_BX46V0}}</text>
        </view>
        <view class="brand-meta">
          <view class="brand-meta-line"></view>
          <text class="brand-subtitle" wx:if="{{hasProfile}}">{{profile.hostName}}</text>
          <text class="brand-subtitle" wx:else>寄养家庭管理</text>
        </view>
      </view>
    </view>

    <view class="gallery-hall">
      <!-- 无档案：引导创建 -->
      <view wx:if="{{!hasProfile}}" class="portfolio-card">
        <text class="portfolio-title">暂无家庭寄养</text>
        <text class="portfolio-desc">创建寄养家庭档案并提交审核，通过后即可在「家庭寄养」频道上架接单。</text>
        <button class="portfolio-btn portfolio-btn--primary" bindtap="goCreate">创建家庭寄养</button>
      </view>

      <block wx:else>
        <!-- ═══ 家庭卷宗：状态章 + 编辑式数据 + 元信息 ═══ -->
        <view class="portfolio-card">
          <view class="portfolio-status-row">
            <text class="portfolio-status-tag {{statusTagClass}}">{{statusText}}</text>
            <view class="portfolio-switch">
              <text class="portfolio-switch-label">接单</text>
              <switch
                checked="{{profile.isAcceptingOrders}}"
                disabled="{{profile.status !== 'active' || acceptSwitching}}"
                color="#1F3A1F"
                bindchange="onAcceptToggle"
              />
            </view>
          </view>
          <view class="portfolio-divider"></view>
          <view class="portfolio-stats">
            <view class="portfolio-stat">
              <view class="portfolio-stat-row">
                <text class="portfolio-symbol">¥</text>
                <text class="portfolio-num">{{profile.pricePerDay || 0}}</text>
                <text class="portfolio-unit">/天</text>
              </view>
              <text class="portfolio-label">日单价</text>
            </view>
            <view class="portfolio-stat-divider"></view>
            <view class="portfolio-stat">
              <view class="portfolio-stat-row">
                <text class="portfolio-num">{{profile.maxPets || 0}}</text>
                <text class="portfolio-unit">只</text>
              </view>
              <text class="portfolio-label">最大容量</text>
            </view>
            <view class="portfolio-stat-divider"></view>
            <view class="portfolio-stat">
              <view class="portfolio-stat-row">
                <text class="portfolio-num portfolio-num--mode">{{profile.billingMode === 'hourly24' ? '小时' : '间夜'}}</text>
              </view>
              <text class="portfolio-label">计价模式</text>
            </view>
          </view>
          <block wx:if="{{profile.address || profile.phone}}">
            <view class="portfolio-divider"></view>
            <view class="portfolio-meta" wx:if="{{profile.address}}">
              <view class="portfolio-meta-dot"></view>
              <text class="portfolio-meta-text">{{profile.address}}</text>
            </view>
            <view class="portfolio-meta" wx:if="{{profile.phone}}">
              <view class="portfolio-meta-dot"></view>
              <text class="portfolio-meta-text">{{profile.phone}}</text>
            </view>
          </block>
        </view>

        <!-- 驳回原因 + 重新提审 -->
        <view wx:if="{{profile.status === 'rejected'}}" class="portfolio-card portfolio-card--alert">
          <text class="portfolio-title">档案审核未通过</text>
          <text class="portfolio-desc" wx:if="{{profile.rejectReason}}">驳回原因：{{profile.rejectReason}}</text>
          <text class="portfolio-desc" wx:else>档案未通过审核，请修改后重新提交。</text>
          <button class="portfolio-btn portfolio-btn--primary" bindtap="goEdit">修改并重新提交</button>
        </view>

        <!-- 编辑入口 + 主动开单入口 -->
        <view wx:if="{{profile.status !== 'rejected'}}" class="action-row action-row--double">
          <button class="edit-profile-btn" bindtap="goEdit">编辑档案</button>
          <button class="invite-create-btn" bindtap="goInviteCreate">主动开单</button>
        </view>

        <!-- ═══ 节 1：我的开单（手风琴，默认展开） ═══ -->
        <view class="ledger-section">
          <view class="section-head {{invitationExpanded ? 'section-head--expanded' : ''}}" bindtap="onToggleSection" data-key="invitations">
            <text class="section-name">我的开单</text>
            <text class="section-count">{{myInvitations.length}} 单</text>
            <view class="section-rule"></view>
            <view class="section-chevron {{invitationExpanded ? '' : 'section-chevron--collapsed'}}"></view>
          </view>
          <view class="section-body" hidden="{{!invitationExpanded}}">
            <view wx:if="{{myInvitations.length === 0}}" class="section-empty">
              <text class="section-empty-text">暂无开单邀请，点击上方「主动开单」创建</text>
            </view>
            <view wx:for="{{myInvitations}}" wx:key="_id" class="gallery-card inv-card {{ item.status === 'active' ? 'inv-card--editable' : '' }}" data-id="{{ item._id }}" bindtap="onCardTap">
              <view class="card-accent"></view>
              <view class="card-body">
                <view class="inv-card-head">
                  <text class="inv-card-title">开单邀请 · {{item.shareCode}}</text>
                  <text class="status-tag {{item.statusTagClass}}">{{item.statusText}}</text>
                </view>
                <view class="card-info">
                  <text class="card-info-item">寄养日期：{{item.dateRangeText}}</text>
                  <text class="card-info-item">接还时刻：{{item.timeText}} · {{item.days}} 天</text>
                  <text class="card-info-item">宠物数量：{{item.petCount}} 只</text>
                  <text class="card-info-item">总价：¥{{item.totalPrice}}</text>
                </view>
                <text wx:if="{{item.note}}" class="card-info-item inv-note-line">备注：{{item.note}}</text>
                <view wx:if="{{item.status === 'active'}}" class="order-actions">
                  <button class="order-btn order-btn--ghost" data-id="{{item._id}}" catchtap="onCancelInvitation">取消</button>
                  <button class="order-btn order-btn--primary" open-type="share" data-code="{{item.shareCode}}">分享给客户</button>
                </view>
                <view wx:elif="{{item.status === 'filled'}}" class="order-actions">
                  <button wx:if="{{item.releasable}}" class="order-btn order-btn--ghost" data-id="{{item._id}}" catchtap="onReleaseInvitation">释放</button>
                  <button wx:if="{{item.orderId}}" class="order-btn order-btn--primary" data-orderid="{{item.orderId}}" catchtap="onViewOrder">查看关联订单</button>
                </view>
              </view>
            </view>
            <view class="inv-view-all" wx:if="{{myInvitations.length > 0}}" bindtap="goInviteList">
              <text class="section-link">管理全部开单 ›</text>
            </view>
          </view>
        </view>

        <!-- ═══ 节 2：寄养订单（有效单，手风琴互斥） ═══ -->
        <view class="ledger-section">
          <view class="section-head {{ordersExpanded ? 'section-head--expanded' : ''}}" bindtap="onToggleSection" data-key="orders">
            <text class="section-name">寄养订单</text>
            <text class="section-count">{{orders.length}} 单</text>
            <view class="section-rule"></view>
            <view class="section-chevron {{ordersExpanded ? '' : 'section-chevron--collapsed'}}"></view>
          </view>
          <view class="section-body" hidden="{{!ordersExpanded}}">
            <view wx:if="{{orders.length === 0}}" class="section-empty">
              <text class="section-empty-text">暂无订单</text>
            </view>
            <view wx:for="{{orders}}" wx:key="_id" class="gallery-card order-card">
              <view class="card-accent"></view>
              <view class="card-body">
                <view class="card-header">
                  <text class="card-title">寄养订单{{item.orderNo ? ' · ' + item.orderNo : ''}}</text>
                  <text class="card-status status-{{item.status}}">{{item.statusText}}</text>
                </view>
                <view class="card-info">
                  <text class="card-info-item" wx:if="{{item.ownerName}}">宠物主人：{{item.ownerName}}</text>
                  <text class="card-info-item" wx:if="{{item.startDate || item.endDate}}">寄养日期：{{item.startDate || '-'}} 至 {{item.endDate || '-'}}</text>
                  <text class="card-info-item">金额：¥{{item.totalPrice || item.totalAmount || 0}}</text>
                </view>
                <view wx:if="{{item.status === 'paid' || item.status === 'confirmed' || item.status === 'in_progress'}}" class="order-actions">
                  <button wx:if="{{item.status === 'paid'}}" class="order-btn order-btn--ghost" data-id="{{item._id}}" data-op="reject" catchtap="onOrderAction">拒单</button>
                  <button wx:if="{{item.status === 'paid'}}" class="order-btn order-btn--primary" data-id="{{item._id}}" data-op="confirm" catchtap="onOrderAction">接单</button>
                  <button wx:if="{{item.status === 'confirmed' || item.status === 'in_progress'}}" class="order-btn order-btn--primary" data-id="{{item._id}}" data-op="complete" catchtap="onOrderAction">完成寄养</button>
                </view>
                <!-- 待支付/待补尾款：改价（折扣）+ 分享收款链接（客户点开即付） -->
                <view wx:if="{{item.status === 'pending_payment' || item.status === 'deposit_paid'}}" class="order-actions">
                  <button class="order-btn order-btn--ghost" data-id="{{item._id}}" data-op="adjust" catchtap="onOrderAction">改价</button>
                  <button class="order-btn order-btn--primary" open-type="share" catchtap="onShareTap" data-code="" data-orderid="{{item._id}}">分享给客户付款</button>
                </view>
              </view>
            </view>
          </view>
        </view>

        <!-- ═══ 节 3：已取消订单（手风琴互斥） ═══ -->
        <view class="ledger-section">
          <view class="section-head {{cancelledExpanded ? 'section-head--expanded' : ''}}" bindtap="onToggleSection" data-key="cancelled">
            <text class="section-name">已取消订单</text>
            <text class="section-count">{{cancelledOrders.length}} 单</text>
            <view class="section-rule"></view>
            <view class="section-chevron {{cancelledExpanded ? '' : 'section-chevron--collapsed'}}"></view>
          </view>
          <view class="section-body" hidden="{{!cancelledExpanded}}">
            <view wx:if="{{cancelledOrders.length === 0}}" class="section-empty">
              <text class="section-empty-text">暂无已取消订单</text>
            </view>
            <view wx:for="{{cancelledOrders}}" wx:key="_id" class="gallery-card order-card">
              <view class="card-accent"></view>
              <view class="card-body">
                <view class="card-header">
                  <text class="card-title">寄养订单{{item.orderNo ? ' · ' + item.orderNo : ''}}</text>
                  <text class="card-status status-{{item.status}}">{{item.statusText}}</text>
                </view>
                <view class="card-info">
                  <text class="card-info-item" wx:if="{{item.ownerName}}">宠物主人：{{item.ownerName}}</text>
                  <text class="card-info-item" wx:if="{{item.startDate || item.endDate}}">寄养日期：{{item.startDate || '-'}} 至 {{item.endDate || '-'}}</text>
                  <text class="card-info-item">金额：¥{{item.totalPrice || item.totalAmount || 0}}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </block>
    </view>
  </block>
</view>
</scroll-view>
