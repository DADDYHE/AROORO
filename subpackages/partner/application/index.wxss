@import '../common.wxss';

.card-accent {
  width: 3rpx;
  height: 100%;
  position: absolute;
  left: 0;
  top: 0;
  background: linear-gradient(180deg, var(--activity-primary) 0%, var(--activity-primary-mid) 100%);
}

.approved-accent {
  background: linear-gradient(180deg, var(--success-color) 0%, #30D158 100%) !important;
}

.pending-accent {
  background: linear-gradient(180deg, var(--warning-color) 0%, var(--boarding-primary) 100%) !important;
}

.card-body {
  position: relative;
  padding: 32rpx 36rpx;
}

.status-title {
  font-size: 36rpx;
  font-weight: 500;
  color: var(--text-primary);
  display: block;
  margin-bottom: 12rpx;
}

.status-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 24rpx;
}

.perm-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.perm-tag {
  font-size: 20rpx;
  padding: 8rpx 20rpx;
  background: rgba(78, 205, 196, 0.12);
  color: var(--activity-primary-mid);
  border-radius: 8rpx;
}

.app-info {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--divider-color);
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}

.info-key {
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 2rpx;
}

.info-val {
  font-size: 26rpx;
  color: var(--text-primary);
  text-align: right;
}

.apply-btn {
  display: inline-flex;
  padding: 20rpx 48rpx;
  background: linear-gradient(135deg, var(--activity-primary) 0%, var(--activity-primary-mid) 100%);
  border-radius: 16rpx;
  margin-top: 8rpx;
}

.apply-btn-text {
  font-size: 26rpx;
  color: var(--card-color);
  font-weight: 500;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  width: 600rpx;
  background: var(--card-color);
  border-radius: 24rpx;
  overflow: hidden;
}

.modal-header {
  padding: 36rpx;
  border-bottom: 1rpx solid var(--divider-color);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.modal-body {
  padding: 36rpx;
}

.form-field {
  margin-bottom: 28rpx;
}

.form-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 72rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--gray-200);
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid var(--gray-200);
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  box-sizing: border-box;
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid var(--divider-color);
}

.modal-btn {
  flex: 1;
  padding: 28rpx;
  text-align: center;
}

.btn-cancel {
  border-right: 1rpx solid var(--divider-color);
}

.btn-confirm .modal-btn-text {
  color: var(--activity-primary);
  font-weight: 500;
}

.modal-btn-text {
  font-size: 28rpx;
  color: var(--text-secondary);
}
