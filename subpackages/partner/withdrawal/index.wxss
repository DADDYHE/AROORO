@import '../common.wxss';

/* ============================================
   AROORO 提现页
   提现表单 — 余额大数字 + 支付方式选择 + 金额输入 + 提现按钮
   ============================================ */

.page-container {
  min-height: 100vh;
  padding: 0 var(--page-padding);
  padding-bottom: calc(env(safe-area-inset-bottom) + 180rpx);
}

/* ---------- 页面头部 ---------- */
.page-header {
  background: var(--lux-card-bg);
  margin: 0 calc(var(--page-padding) * -1);
  padding: 40rpx var(--page-padding) 48rpx;
  border-bottom: 1rpx solid var(--lux-hairline);
  text-align: center;
  position: relative;
  overflow: hidden;
}

/* ---------- 余额显示 ---------- */
.balance-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  letter-spacing: 6rpx;
  font-weight: 400;
  margin-bottom: 12rpx;
  display: block;
}

.balance-value {
  font-size: 64rpx;
  font-weight: 300;
  color: var(--text-primary);
  letter-spacing: 1rpx;
  font-feature-settings: 'tnum';
  line-height: 1.1;
  display: block;
}

.balance-currency {
  font-size: 28rpx;
  font-weight: 300;
  color: var(--text-secondary);
  margin-right: 4rpx;
}

/* ---------- 记录列表 ---------- */
.record-list {
  padding: 32rpx 0 0;
}

.record-card {
  background: var(--lux-card-bg);
  border-radius: var(--lux-radius-card);
  padding: 28rpx 32rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid var(--lux-hairline);
  box-shadow: var(--lux-shadow-card);
}

.record-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.record-amount {
  font-size: 32rpx;
  font-weight: 300;
  font-feature-settings: 'tnum';
  color: var(--error-color);
}

.record-amount-positive {
  color: var(--success-color);
}

.record-status {
  font-size: 22rpx;
  font-weight: 400;
  letter-spacing: 1rpx;
  padding: 4rpx 14rpx;
  border-radius: var(--zy-radius-sm);
}

.record-status-pending {
  background: var(--mall-tint);
  color: var(--primary-color);  /* B′ 金在浅底不作文字色：原 --warning-color → 深绿 */
}

.record-status-success {
  background: var(--wash-success-08);
  color: var(--success-color);
}

.record-status-failed {
  background: var(--wash-error-08);
  color: var(--error-color);
}

.record-bottom {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.record-time {
  font-size: 22rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.5rpx;
}

.record-reason {
  font-size: 22rpx;
  color: var(--error-color);
}

/* ---------- 确认收款按钮（P0：新版转账需用户确认收款） ---------- */
.record-confirm {
  margin-top: 16rpx;
  display: flex;
  justify-content: flex-end;
}

.record-confirm-btn {
  margin: 0;
  padding: 0 28rpx;
  height: 56rpx;
  line-height: 56rpx;
  font-size: 24rpx;
  border-radius: 28rpx;
  background: var(--lux-gold-500, #C9A24B);
  color: #FFFFFF;
}

.record-confirm-btn::after {
  border: none;
}

.record-cancel-btn {
  background: #A8A29E;
}

/* ---------- 支付方式卡片 ---------- */
.payment-methods {
  margin-top: 32rpx;
}

.payment-section-title {
  font-size: 22rpx;
  color: var(--text-secondary);
  letter-spacing: 4rpx;
  font-weight: 400;
  margin-bottom: 16rpx;
}

.payment-card {
  background: var(--lux-card-bg);
  border-radius: var(--lux-radius-card);
  padding: 28rpx 32rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid var(--lux-hairline);
  display: flex;
  align-items: center;
  gap: 20rpx;
  position: relative;
  box-shadow: var(--lux-shadow-card);
}

.payment-card.selected {
  border-left: 3rpx solid var(--primary-color);
  background: var(--primary-wash);
}

.payment-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: var(--lux-radius-inner);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 24rpx;
}

.payment-icon-wechat {
  background: var(--wash-success-08);
  color: var(--success-color);
}

.payment-icon-bank {
  background: var(--lux-card-gold-tint);
  color: var(--primary-color);
}

.payment-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.payment-name {
  font-size: 26rpx;
  font-weight: 400;
  color: var(--text-primary);
}

.payment-desc {
  font-size: 22rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.5rpx;
}

.payment-check {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid var(--border-color);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.payment-card.selected .payment-check {
  background: var(--primary-color);
  border-color: var(--primary-color);
}

.payment-check-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--lux-card-bg);
}

/* ---------- 金额输入区 ---------- */
.amount-section {
  margin-top: 32rpx;
}

.amount-input-row {
  background: var(--lux-card-cream);
  border-radius: var(--lux-radius-card);
  padding: 32rpx;
  border: 1rpx solid var(--lux-hairline);
  display: flex;
  align-items: center;
}

.amount-currency {
  font-size: 48rpx;
  font-weight: 300;
  color: var(--text-primary);
  margin-right: 12rpx;
}

.amount-input {
  flex: 1;
  font-size: 48rpx;
  font-weight: 300;
  color: var(--text-primary);
  height: 64rpx;
  font-family: inherit;
  font-feature-settings: 'tnum';
}

.amount-all-btn {
  font-size: 24rpx;
  color: var(--primary-color);
  font-weight: 400;
  letter-spacing: 1rpx;
  padding: 8rpx 20rpx;
  border: 1rpx solid var(--primary-color);
  border-radius: var(--zy-radius-lg);
  flex-shrink: 0;
}

.amount-tips {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-top: 12rpx;
  letter-spacing: 0.5rpx;
  padding: 0 8rpx;
}

/* ---------- 底部提现按钮 ---------- */
.withdraw-action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx var(--page-padding);
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: var(--lux-card-bg);
  border-top: 1rpx solid var(--lux-hairline);
  z-index: 50;
}

.withdraw-submit-btn {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--gradient-primary);
  color: var(--text-on-primary);
  border-radius: var(--zy-radius-lg);
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 6rpx;
  box-shadow: var(--lux-shadow-green);
  border: none;
}

.withdraw-submit-btn::after {
  border: none;
}

.withdraw-submit-btn.disabled {
  opacity: 0.5;
}

/* ---------- 空状态 ---------- */
.empty-container {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 50vh;
  flex-direction: column;
}

.empty-line {
  width: 48rpx;
  height: 1rpx;
  background: var(--accent-color);
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 4rpx;
}

.loading-more {
  text-align: center;
  padding: 32rpx 0;
}

.loading-more-text {
  font-size: 22rpx;
  color: var(--text-tertiary);
  letter-spacing: 2rpx;
}
