@import '../common.wxss';
.page-container {
  min-height: 100vh;
  background-color: var(--background-color);
  padding-bottom: env(safe-area-inset-bottom);
}

.page-header {
  background: var(--card-color);
  padding-bottom: 20rpx;
  position: relative;
}

.record-list {
  padding: 32rpx;
}

.record-card {
  background: var(--card-color);
  border-radius: 24rpx;
  padding: 32rpx 36rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.record-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.record-amount {
  font-size: 36rpx;
  font-weight: 300;
}

.record-status {
  font-size: 24rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}

.record-bottom {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.record-time {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.record-reason {
  font-size: 22rpx;
  color: var(--error-color);
}

.empty-container {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 60vh;
}

.empty-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  letter-spacing: 4rpx;
}
.loading-more {
  text-align: center;
  padding: 32rpx 0;
}

.loading-more-text {
  font-size: 24rpx;
  color: var(--text-secondary);
}
