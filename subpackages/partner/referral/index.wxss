@import '../common.wxss';

.card-accent {
  width: 3rpx;
  height: 100%;
  position: absolute;
  left: 0;
  top: 0;
  background: linear-gradient(180deg, var(--activity-primary) 0%, var(--activity-primary-mid) 100%);
}

.stats-accent {
  background: linear-gradient(180deg, var(--info-color) 0%, #5856D6 100%) !important;
}

.card-body {
  position: relative;
  padding: 32rpx 36rpx;
}

.stats-row {
  display: flex;
  justify-content: space-around;
}

.stats-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stats-value {
  font-size: 36rpx;
  font-weight: 300;
  color: var(--text-primary);
}

.stats-label {
  font-size: 20rpx;
  color: var(--text-secondary);
  letter-spacing: 4rpx;
}

.user-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.user-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--divider-color);
  flex-shrink: 0;
}

.user-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.user-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.user-stat {
  font-size: 22rpx;
  color: var(--text-secondary);
}
.empty-line {
  width: 60rpx;
  height: 2rpx;
  background: var(--text-tertiary);
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 4rpx;
}
