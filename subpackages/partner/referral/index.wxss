@import '../common.wxss';

/* ============================================
   AROORO 合伙人推荐/分销
   推荐计划 — 邀请码 + 二维码卡片 + 佣金统计
   ============================================ */

/* ---------- 卡片色条 ---------- */
.card-accent {
  width: 3rpx;
  height: 100%;
  position: absolute;
  left: 0;
  top: 0;
  background: var(--primary-color);
}

.stats-accent {
  background: var(--lux-gold-500);
}

.card-body {
  position: relative;
  padding: 32rpx 36rpx;
}

/* ---------- 佣金统计行 ---------- */
.stats-row {
  display: flex;
  justify-content: space-around;
}

.stats-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stats-value {
  font-size: 36rpx;
  font-weight: 300;
  color: var(--primary-color);
  font-feature-settings: 'tnum';
}

.stats-label {
  font-size: 20rpx;
  color: var(--text-secondary);
  letter-spacing: 3rpx;
  font-weight: 400;
}

/* ---------- 推荐码/二维码卡片（金色调） ---------- */
.referral-card {
  background: var(--lux-card-gold-tint);
  border-radius: var(--lux-radius-card);
  padding: 40rpx 36rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--mall-tint-12);
  text-align: center;
  position: relative;
  overflow: hidden;
  box-shadow: var(--lux-shadow-card);
}

.referral-card::before {
  content: '';
  position: absolute;
  top: -80rpx;
  right: -80rpx;
  width: 240rpx;
  height: 240rpx;
  background: radial-gradient(circle, var(--mall-tint) 0%, transparent 70%);
  pointer-events: none;
}

.referral-card-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  letter-spacing: 6rpx;
  font-weight: 400;
  margin-bottom: 16rpx;
  display: block;
}

.referral-code {
  font-size: 48rpx;
  font-weight: 300;
  color: var(--primary-color);
  letter-spacing: 8rpx;
  font-feature-settings: 'tnum';
  margin-bottom: 24rpx;
  display: block;
}

.qr-placeholder {
  width: 240rpx;
  height: 240rpx;
  background: var(--lux-card-bg);
  border-radius: var(--lux-radius-inner);
  margin: 0 auto 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  /* P3：手写 rgba → 令牌（--accent-glow 取值 rgba(201,162,75,0.20)，等值替换，零视觉变化） */
  border: 1rpx solid var(--accent-glow);
}

.qr-icon {
  font-size: 80rpx;
  color: var(--primary-color);
  font-weight: 300;
}

.referral-tip {
  font-size: 20rpx;
  color: var(--text-tertiary);
  letter-spacing: 1rpx;
}

/* ---------- 分享操作行 ---------- */
.share-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.share-btn {
  flex: 1;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--zy-radius-lg);
  font-size: 24rpx;
  font-weight: 400;
  letter-spacing: 2rpx;
  border: none;
}

.share-btn::after {
  border: none;
}

.share-btn-primary {
  background: var(--gradient-primary);
  color: var(--text-on-primary);
  box-shadow: var(--lux-shadow-green);
}

.share-btn-outline {
  background: transparent;
  color: var(--primary-color);
  border: 1rpx solid var(--primary-color);
}

/* ---------- 推荐用户列表 ---------- */
.user-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--lux-hairline);
}

.user-row:last-child {
  border-bottom: none;
}

.user-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--divider-color);
  flex-shrink: 0;
}

.user-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
  min-width: 0;
}

.user-name {
  font-size: 26rpx;
  font-weight: 400;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-stat {
  font-size: 20rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.5rpx;
}

.user-commission {
  font-size: 26rpx;
  font-weight: 300;
  color: var(--primary-color);
  font-feature-settings: 'tnum';
  flex-shrink: 0;
}

/* ---------- 规则说明 ---------- */
.rules-section {
  margin-top: 8rpx;
}

.rules-title {
  font-size: 22rpx;
  color: var(--text-secondary);
  letter-spacing: 4rpx;
  font-weight: 400;
  margin-bottom: 16rpx;
}

.rules-text {
  font-size: 22rpx;
  color: var(--text-tertiary);
  line-height: 1.8;
  letter-spacing: 0.5rpx;
}

/* ---------- 空状态 ---------- */
.empty-line {
  width: 48rpx;
  height: 1rpx;
  background: var(--accent-color);
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 4rpx;
}
