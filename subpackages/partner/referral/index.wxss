@import '../common.wxss';

/* ============================================
   AROORO 合伙人推荐/分销 — A 纸面台账（2026-09-10 升级）
   三列数据带 + 节头 + 推荐用户行线列表
   ============================================ */

/* ---------- 佣金统计（纸面三列数据带） ---------- */
.stats-strip {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 44rpx var(--page-padding) 40rpx;
  border-bottom: 1rpx solid rgba(26, 26, 23, 0.14);
}

.stats-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.stats-value {
  font-size: 38rpx;
  font-weight: 300;
  color: var(--primary-color);
  font-feature-settings: 'tnum';
  letter-spacing: 0.01em;
}

/* 佣金 = 收益档，金墨强调 */
.stats-value--gold {
  color: var(--lux-gold-ink);
  font-weight: 500;
}

.stats-label {
  font-size: 20rpx;
  color: var(--text-secondary);
  letter-spacing: 0.2em;
  font-weight: 400;
}

.stats-divider {
  width: 1rpx;
  height: 52rpx;
  background: rgba(26, 26, 23, 0.14);
}

/* ---------- 节头（推荐用户） ---------- */
.section-head-line {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 36rpx var(--page-padding) 8rpx;
}

.head-line {
  width: 32rpx;
  height: 2rpx;
  background: var(--lux-gold-ink);
}

.head-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  letter-spacing: 0.2em;
  font-weight: 400;
}

/* ---------- 推荐码/二维码卡片（金色调） ---------- */
.referral-card {
  background: var(--lux-card-gold-tint);
  border-radius: var(--lux-radius-card);
  padding: 40rpx 36rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--mall-tint-12);
  text-align: center;
  position: relative;
  overflow: hidden;
  box-shadow: var(--lux-shadow-card);
}

.referral-card::before {
  content: '';
  position: absolute;
  top: -80rpx;
  right: -80rpx;
  width: 240rpx;
  height: 240rpx;
  background: radial-gradient(circle, var(--mall-tint) 0%, transparent 70%);
  pointer-events: none;
}

.referral-card-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  letter-spacing: 6rpx;
  font-weight: 400;
  margin-bottom: 16rpx;
  display: block;
}

.referral-code {
  font-size: 48rpx;
  font-weight: 300;
  color: var(--primary-color);
  letter-spacing: 8rpx;
  font-feature-settings: 'tnum';
  margin-bottom: 24rpx;
  display: block;
}

.qr-placeholder {
  width: 240rpx;
  height: 240rpx;
  background: var(--lux-card-bg);
  border-radius: var(--lux-radius-inner);
  margin: 0 auto 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  /* P3：手写 rgba → 令牌（--accent-glow 取值 rgba(201,162,75,0.20)，等值替换，零视觉变化） */
  border: 1rpx solid var(--accent-glow);
}

.qr-icon {
  font-size: 80rpx;
  color: var(--primary-color);
  font-weight: 300;
}

.referral-tip {
  font-size: 20rpx;
  color: var(--text-tertiary);
  letter-spacing: 1rpx;
}

/* ---------- 分享操作行 ---------- */
.share-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.share-btn {
  flex: 1;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--zy-radius-lg);
  font-size: 24rpx;
  font-weight: 400;
  letter-spacing: 2rpx;
  border: none;
}

.share-btn::after {
  border: none;
}

.share-btn-primary {
  background: var(--gradient-primary);
  color: var(--text-on-primary);
  box-shadow: var(--lux-shadow-green);
}

.share-btn-outline {
  background: transparent;
  color: var(--primary-color);
  border: 1rpx solid var(--primary-color);
}

/* ---------- 推荐用户列表（行线 + 右箭头） ---------- */
.user-list {
  padding: 0 var(--page-padding);
}

.user-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 0;
  border-bottom: 1rpx solid rgba(26, 26, 23, 0.14);
  /* 可点：仅 transform/opacity 按压 */
  transition: transform 180ms cubic-bezier(0.25, 0.1, 0.25, 1), opacity 180ms cubic-bezier(0.25, 0.1, 0.25, 1);
}

.user-row--pressed {
  transform: scale(0.99);
  opacity: 0.86;
}

.user-row:last-child {
  border-bottom: none;
}

.user-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--divider-color);
  flex-shrink: 0;
  border: 1rpx solid rgba(26, 26, 23, 0.14);
}

.user-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
  min-width: 0;
}

.user-name {
  font-size: 27rpx;
  font-weight: 400;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-stat {
  font-size: 21rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.02em;
  font-feature-settings: 'tnum';
}

.user-arrow {
  font-size: 30rpx;
  color: var(--text-tertiary);
  flex-shrink: 0;
  line-height: 1;
}

.user-commission {
  font-size: 26rpx;
  font-weight: 300;
  color: var(--primary-color);
  font-feature-settings: 'tnum';
  flex-shrink: 0;
}

/* ---------- 规则说明 ---------- */
.rules-section {
  margin-top: 8rpx;
}

.rules-title {
  font-size: 22rpx;
  color: var(--text-secondary);
  letter-spacing: 4rpx;
  font-weight: 400;
  margin-bottom: 16rpx;
}

.rules-text {
  font-size: 22rpx;
  color: var(--text-tertiary);
  line-height: 1.8;
  letter-spacing: 0.5rpx;
}

/* ---------- 空状态 ---------- */
.empty-line {
  width: 48rpx;
  height: 1rpx;
  background: var(--accent-color);
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 4rpx;
}

/* ================================================================
   非合伙人引导卡（403 态 · 2026-09-10）
   ================================================================ */
.pp-noperm {
  margin: 60rpx var(--page-padding);
  padding: 56rpx 40rpx;
  border: 1rpx solid rgba(26, 26, 23, 0.14);
  border-radius: var(--lux-radius-card);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.pp-noperm-eyebrow {
  font-size: 20rpx;
  color: var(--lux-gold-ink);
  letter-spacing: 0.24em;
}

.pp-noperm-title {
  font-size: 36rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.08em;
}

.pp-noperm-desc {
  font-size: 23rpx;
  color: var(--text-tertiary);
  line-height: 1.7;
  text-align: center;
  margin-bottom: 12rpx;
}

.pp-noperm-btn {
  min-width: 340rpx;
  height: 84rpx;
  padding: 0 56rpx;
  border-radius: var(--lux-radius-pill, 999rpx);
  background: var(--lux-green-grad);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--lux-shadow-green);
  transition: transform 240ms cubic-bezier(0.25, 0.1, 0.25, 1), opacity 240ms cubic-bezier(0.25, 0.1, 0.25, 1);
}

.pp-noperm-btn--pressed {
  transform: scale(0.98);
  opacity: 0.9;
}

.pp-noperm-btn-text {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-on-primary);
  letter-spacing: 0.12em;
}
