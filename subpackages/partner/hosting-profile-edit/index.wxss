@import '../common.wxss';

/* ============================================
   家庭寄养编辑 — 3 步表单（基本信息 / 服务与定价 / 资质与相册）
   ============================================ */

.edit-page {
  min-height: 100vh;
  padding: 24rpx var(--page-padding) calc(env(safe-area-inset-bottom) + 48rpx);
  background-color: var(--background-color);
  font-family: var(--font-stack);
}

/* ---------- 步骤条 ---------- */
.step-bar {
  display: flex;
  align-items: center;
  padding: 24rpx 8rpx 32rpx;
}

.step-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.step-no {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 1rpx solid var(--lux-hairline);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: var(--text-tertiary);
  font-feature-settings: 'tnum';
}

.step-no--active {
  border-color: var(--primary-color);
  background: var(--primary-color);
  color: var(--text-on-primary);
}

.step-label {
  font-size: 24rpx;
  color: var(--text-tertiary);
  letter-spacing: 1rpx;
}

.step-label--active {
  color: var(--text-primary);
}

.step-line {
  flex: 1;
  height: 1rpx;
  background: var(--lux-hairline);
  margin: 0 16rpx;
}

.step-line--active {
  background: var(--primary-color);
}

/* ---------- 表单分区 ---------- */
.form-section {
  background: var(--card-cream);
  border-radius: var(--zy-radius-lg);
  padding: 32rpx 36rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 1rpx;
  padding-bottom: 20rpx;
  margin-bottom: 8rpx;
  border-bottom: 1rpx solid var(--lux-hairline);
}

.field-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--lux-hairline);
}

.field-row:last-child {
  border-bottom: none;
}

.field-row--col {
  flex-direction: column;
  align-items: stretch;
  gap: 16rpx;
}

.field-row--area {
  flex-direction: column;
  align-items: stretch;
  gap: 16rpx;
}

.field-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  letter-spacing: 1rpx;
  flex-shrink: 0;
}

.field-label.required::before {
  content: '* ';
  color: var(--error-color);
}

.field-hint {
  font-size: 22rpx;
  color: var(--text-tertiary);
  line-height: 1.5;
}

.field-input {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
  color: var(--text-primary);
}

.field-picker {
  text-align: right;
  font-size: 26rpx;
  color: var(--text-primary);
}

.field-picker--placeholder {
  color: var(--text-tertiary);
}

.field-textarea {
  width: 100%;
  height: 160rpx;
  font-size: 26rpx;
  color: var(--text-primary);
  line-height: 1.6;
}

.input-placeholder {
  color: var(--text-tertiary);
}

/* ---------- 选项 chip ---------- */
.choice-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.choice-chip {
  padding: 12rpx 28rpx;
  border-radius: var(--zy-radius-sm);
  border: 1rpx solid var(--lux-hairline);
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 1rpx;
}

.choice-chip--on {
  border-color: var(--primary-color);
  background: var(--primary-tint-08);
  color: var(--primary-color);
}

/* ---------- 上传网格 ---------- */
.upload-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.upload-cell {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.upload-img {
  width: 100%;
  height: 100%;
  border-radius: var(--zy-radius-sm);
}

.upload-remove {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--text-primary);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  line-height: 1;
}

.upload-add {
  width: 200rpx;
  height: 200rpx;
  border: 1rpx dashed var(--lux-hairline);
  border-radius: var(--zy-radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: var(--text-tertiary);
}

/* ---------- 证件 ---------- */
.cert-row {
  display: flex;
  gap: 16rpx;
}

.cert-cell {
  position: relative;
  width: 300rpx;
  height: 180rpx;
  border: 1rpx dashed var(--lux-hairline);
  border-radius: var(--zy-radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: visible;
}

.cert-cell--single {
  width: 300rpx;
}

.cert-img {
  width: 100%;
  height: 100%;
  border-radius: var(--zy-radius-sm);
}

.cert-text {
  font-size: 24rpx;
  color: var(--text-tertiary);
  letter-spacing: 2rpx;
}

/* ---------- 底部操作 ---------- */
.footer-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 40rpx;
}

.footer-actions .btn-primary,
.footer-actions .btn-ghost {
  flex: 1;
  margin: 0;
}

.btn-primary {
  padding: 24rpx 0;
  font-size: 28rpx;
  letter-spacing: 4rpx;
  color: var(--text-on-primary);
  background: var(--primary-color);
  border-radius: var(--zy-radius-lg);
  border: none;
  line-height: 1;
}

.btn-primary::after {
  border: none;
}

/* Skyline 不支持属性选择器（整条规则会被丢弃且告警），禁用态必须走 .btn-disabled 类（wxml 绑定 submitting） */
.btn-primary.btn-disabled {
  opacity: 0.6;
  color: var(--text-on-primary);
  background: var(--primary-color);
}

.btn-ghost {
  padding: 24rpx 0;
  font-size: 28rpx;
  letter-spacing: 4rpx;
  color: var(--primary-color);
  background: transparent;
  border: 1rpx solid var(--primary-color);
  border-radius: var(--zy-radius-lg);
  line-height: 1;
}

.btn-ghost::after {
  border: none;
}
