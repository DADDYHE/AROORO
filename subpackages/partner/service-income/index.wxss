@import '../common.wxss';

/* ================================================================
   AROORO 服务收入 — Haute-Luxury Income Dashboard
   深森林绿主色 + 金属香槟金阶 + 奶油暖白底
   总收入概览（深色高奢卡）+ 分类展区 + 收入明细时间线
   Skyline 兼容：无 :active / transition 仅 transform & opacity
   ================================================================ */

/* ---------- 页面容器 ---------- */
.service-income-page {
  min-height: 100vh;
  padding: 0 var(--page-padding);
  padding-bottom: calc(env(safe-area-inset-bottom) + 48rpx);
}

/* ---------- 内容容器 ---------- */
.gallery-container {
  padding: 32rpx 0 0;
}

/* ============================================
   主展品：总收入概览 — 深色高奢卡（森林绿底 + 金色数字）
   ============================================ */
.hero-exhibit {
  background: var(--lux-green-grad-rich);
  border-radius: var(--lux-radius-card);
  padding: 56rpx 40rpx;
  margin-bottom: 32rpx;
  border: 1rpx solid var(--lux-hairline-green);
  box-shadow: var(--lux-shadow-green);
  text-align: center;
  position: relative;
  overflow: hidden;
}

/* 右上角金色光晕 */
.hero-exhibit::before {
  content: '';
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, var(--mall-tint) 0%, transparent 70%);
  pointer-events: none;
}

/* 底部金线装饰 */
.hero-exhibit::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 80rpx;
  height: 2rpx;
  background: var(--lux-gold-line-solid);
}

.exhibit-label {
  font-size: 20rpx;
  color: var(--text-on-dark-50);
  letter-spacing: 0.24em;
  margin-bottom: 20rpx;
  font-weight: 400;
  position: relative;
}

.exhibit-amount {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 8rpx;
  margin-bottom: 36rpx;
  position: relative;
}

.exhibit-amount .currency {
  font-size: 28rpx;
  font-weight: 300;
  color: var(--accent-color);
}

.exhibit-amount .value {
  font-size: 64rpx;
  font-weight: 300;
  color: var(--accent-color);
  letter-spacing: 0.01em;
  line-height: 1;
  font-feature-settings: 'tnum';
}

.exhibit-meta {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 48rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid var(--bg-gold-on-dark);
  position: relative;
}

.meta-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.meta-label {
  font-size: 20rpx;
  color: var(--text-on-dark-50);
  letter-spacing: 0.18em;
  font-weight: 400;
}

.meta-value {
  font-size: 28rpx;
  font-weight: 300;
  color: var(--accent-color);
  font-feature-settings: 'tnum';
}

.meta-divider {
  width: 1rpx;
  height: 36rpx;
  background: var(--bg-gold-on-dark);
}

/* ============================================
   分类展区 — 三种收入类型卡片
   ============================================ */
.category-gallery {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.category-frame {
  background: var(--lux-card-bg);
  border-radius: var(--lux-radius-card);
  padding: 28rpx 32rpx;
  border: 1rpx solid var(--lux-hairline);
  box-shadow: var(--lux-shadow-card);
  position: relative;
  overflow: hidden;
}

.frame-accent {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 3rpx;
}

.activity-frame .frame-accent {
  background: var(--gradient-primary);
}

.boarding-frame .frame-accent {
  background: linear-gradient(135deg, #C08060, #D49E80);
}

.feeding-frame .frame-accent {
  background: linear-gradient(135deg, #7C9468, #9AB488);
}

.frame-content {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding-left: 8rpx;
}

.frame-icon {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.icon-dot {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  position: relative;
}

.icon-dot::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: var(--lux-card-bg);
}

.activity-dot {
  background: var(--primary-color);
}

.boarding-dot {
  background: var(--boarding-primary);
}

.feeding-dot {
  background: var(--feeding-primary);
}

.frame-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.frame-title {
  font-size: 22rpx;
  color: var(--text-secondary);
  letter-spacing: 0.08em;
  font-weight: 400;
}

.frame-amount {
  font-size: 36rpx;
  font-weight: 300;
  color: var(--text-primary);
  font-feature-settings: 'tnum';
  letter-spacing: 0.01em;
}

.frame-stat {
  flex-shrink: 0;
}

.stat-text {
  font-size: 20rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.04em;
}

/* ============================================
   明细展区 — 收入记录时间线
   ============================================ */
.timeline-exhibit {
  background: var(--lux-card-bg);
  border-radius: var(--lux-radius-card);
  padding: 32rpx;
  border: 1rpx solid var(--lux-hairline);
  box-shadow: var(--lux-shadow-card);
}

.exhibit-header {
  margin-bottom: 24rpx;
}

.exhibit-title {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.10em;
}

/* ---------- 筛选导航 ---------- */
.filter-nav {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--lux-hairline);
}

.nav-pill {
  padding: 10rpx 28rpx;
  border-radius: var(--lux-radius-pill);
  font-size: 22rpx;
  color: var(--text-secondary);
  background: var(--lux-card-cream);
  border: 1rpx solid var(--lux-hairline);
  letter-spacing: 0.04em;
  font-weight: 400;
}

.nav-pill.active {
  background: var(--gradient-primary);
  color: var(--text-on-primary);
  font-weight: 500;
  border-color: transparent;
  box-shadow: var(--lux-shadow-green);
}

/* ---------- 时间线列表 ---------- */
.timeline-list {
  position: relative;
}

/* ---------- 空状态 ---------- */
.empty-gallery {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  gap: 20rpx;
}

.empty-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--lux-card-cream);
  border: 1rpx solid var(--lux-hairline);
  position: relative;
}

.empty-icon::before,
.empty-icon::after {
  content: '';
  position: absolute;
  background: var(--accent-color);
  border-radius: 2rpx;
}

.empty-icon::before {
  top: 50%;
  left: 16rpx;
  right: 16rpx;
  height: 2rpx;
  transform: translateY(-50%);
}

.empty-icon::after {
  left: 50%;
  top: 16rpx;
  bottom: 16rpx;
  width: 2rpx;
  transform: translateX(-50%);
}

.empty-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 0.16em;
}

/* ---------- 时间线条目 ---------- */
.timeline-item {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 0;
  position: relative;
  border-bottom: 1rpx solid var(--lux-hairline);
}

.timeline-item:last-child {
  border-bottom: none;
}

.timeline-marker {
  position: relative;
  flex-shrink: 0;
  width: 40rpx;
  display: flex;
  align-items: flex-start;
  padding-top: 6rpx;
}

.marker-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  border: 2rpx solid var(--lux-card-bg);
  margin-left: 14rpx;
}

.activity-marker {
  background: var(--primary-color);
  box-shadow: 0 0 0 2rpx var(--primary-color);
}

.boarding-marker {
  background: var(--boarding-primary);
  box-shadow: 0 0 0 2rpx var(--boarding-primary);
}

.feeding-marker {
  background: var(--feeding-primary);
  box-shadow: 0 0 0 2rpx var(--feeding-primary);
}

.timeline-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.content-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.content-title {
  flex: 1;
  font-size: 24rpx;
  color: var(--text-primary);
  letter-spacing: 0.02em;
  line-height: 1.4;
  font-weight: 400;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.content-amount {
  font-size: 28rpx;
  font-weight: 300;
  color: var(--success-color);
  font-feature-settings: 'tnum';
  letter-spacing: 0.01em;
  flex-shrink: 0;
}

.content-amount-negative {
  color: var(--error-color);
}

.content-footer {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.content-time {
  font-size: 20rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.04em;
}

.content-status {
  font-size: 18rpx;
  color: var(--text-secondary);
  padding: 4rpx 14rpx;
  background: var(--lux-card-cream);
  border: 1rpx solid var(--lux-hairline);
  border-radius: var(--zy-radius-sm);
  letter-spacing: 0.04em;
  font-weight: 400;
}

/* ---------- 金粒瀑布 · 切换分类加载 ---------- */
.detail-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 44rpx;
  padding: 100rpx 0;
}

.end-mark {
  display: flex;
  justify-content: center;
  padding: 32rpx 0 16rpx;
}

.end-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: var(--accent-color);
  opacity: 0.5;
}

/* ==================== 服务收入钱包（P2 修复：可提现 + 提现入口） ==================== */
.service-wallet-card {
  margin: 28rpx 0 8rpx;
  padding: 28rpx 32rpx;
  background: var(--lux-card-bg, #FFFFFF);
  border: 1rpx solid var(--lux-hairline, rgba(201, 162, 75, 0.25));
  border-radius: var(--zy-radius-xl, 24rpx);
  box-shadow: var(--lux-shadow-elevated, 0 8rpx 32rpx rgba(29, 30, 44, 0.08));
}

.service-wallet-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.service-wallet-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.service-wallet-label {
  font-size: 24rpx;
  color: var(--text-tertiary, #9A9489);
}

.service-wallet-value {
  font-size: 44rpx;
  font-weight: 300;
  color: var(--text-primary, #1D1E2C);
  font-feature-settings: 'tnum';
}

.service-wallet-btn {
  padding: 0 44rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 26rpx;
  font-weight: 500;
  letter-spacing: 0.08em;
  color: var(--text-on-primary, #FFFFFF);
  background: var(--gradient-primary, linear-gradient(135deg, #2F6B4F, #4B8B6A));
  border-radius: var(--lux-radius-pill, 999rpx);
}

/* ==================== 提现弹窗（与 income 页一致） ==================== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--overlay-color, rgba(0, 0, 0, 0.5));
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  width: 600rpx;
  background: var(--lux-card-bg, #FFFFFF);
  border-radius: var(--zy-radius-xl, 24rpx);
  padding: 48rpx 40rpx;
  border: 1rpx solid var(--lux-hairline, rgba(201, 162, 75, 0.25));
  box-shadow: var(--lux-shadow-elevated, 0 8rpx 32rpx rgba(29, 30, 44, 0.08));
}

.modal-title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-primary, #1D1E2C);
  text-align: center;
  margin-bottom: 24rpx;
  letter-spacing: 0.05em;
}

.modal-balance {
  font-size: 24rpx;
  color: var(--text-secondary, #6B6F76);
  text-align: center;
  margin-bottom: 28rpx;
  letter-spacing: 0.03em;
}

.modal-input-row {
  display: flex;
  align-items: center;
  border: 1rpx solid var(--lux-hairline, rgba(201, 162, 75, 0.25));
  border-radius: var(--lux-radius-card, 16rpx);
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  background: var(--lux-card-cream, #FAF6EC);
}

.modal-input-prefix {
  font-size: 36rpx;
  font-weight: 300;
  color: var(--text-primary, #1D1E2C);
  margin-right: 12rpx;
}

.modal-input {
  flex: 1;
  font-size: 36rpx;
  font-weight: 300;
  color: var(--text-primary, #1D1E2C);
  height: 50rpx;
  font-family: inherit;
  font-feature-settings: 'tnum';
}

.modal-tips {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 36rpx;
}

.modal-tips text:first-child {
  font-size: 22rpx;
  color: var(--text-tertiary, #9A9489);
}

.modal-all-btn {
  font-size: 24rpx;
  color: var(--primary-color, #2F6B4F);
  font-weight: 400;
  letter-spacing: 0.03em;
}

.modal-btns {
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: var(--lux-radius-pill, 999rpx);
  font-size: 26rpx;
  font-weight: 500;
  letter-spacing: 0.1em;
  border: none;
}

.modal-btn::after {
  border: none;
}

.modal-btn-cancel {
  background: var(--divider-color, #EDEBE4);
  color: var(--text-secondary, #6B6F76);
}

.modal-btn-confirm {
  background: var(--gradient-primary, linear-gradient(135deg, #2F6B4F, #4B8B6A));
  color: var(--text-on-primary, #FFFFFF);
  box-shadow: var(--lux-shadow-green, 0 8rpx 24rpx rgba(47, 107, 79, 0.25));
}

.modal-btn-disabled {
  opacity: 0.5;
}
