@import '../common.wxss';

/* ================================================================
   AROORO 服务收入 — Haute-Luxury Income Dashboard
   深森林绿主色 + 金属香槟金阶 + 奶油暖白底
   总收入概览（深色高奢卡）+ 分类展区 + 收入明细时间线
   Skyline 兼容：无 :active / transition 仅 transform & opacity
   ================================================================ */

/* ---------- 页面容器 ---------- */
.service-income-page {
  min-height: 100vh;
  padding: 0 var(--page-padding);
  padding-bottom: calc(env(safe-area-inset-bottom) + 48rpx);
}

/* ---------- 内容容器 ---------- */
.gallery-container {
  padding: 32rpx 0 0;
}

/* ============================================
   主展品：总收入概览 — 深色高奢卡（森林绿底 + 金色数字）
   ============================================ */
.hero-exhibit {
  background: var(--lux-green-grad-rich);
  border-radius: var(--lux-radius-card);
  padding: 56rpx 40rpx;
  margin-bottom: 32rpx;
  border: 1rpx solid var(--lux-hairline-green);
  box-shadow: var(--lux-shadow-green);
  text-align: center;
  position: relative;
  overflow: hidden;
}

/* 右上角金色光晕 */
.hero-exhibit::before {
  content: '';
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, var(--mall-tint) 0%, transparent 70%);
  pointer-events: none;
}

/* 底部金线装饰 */
.hero-exhibit::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 80rpx;
  height: 2rpx;
  background: var(--lux-gold-line-solid);
}

/* ---------- 展品标签/数字：深绿底金字（--lux-gold-500 6.75:1） ---------- */
.exhibit-label {
  font-size: 20rpx;
  color: rgba(247, 245, 239, 0.72);
  letter-spacing: 0.24em;
  margin-bottom: 20rpx;
  font-weight: 400;
  position: relative;
}

.exhibit-amount {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 8rpx;
  margin-bottom: 36rpx;
  position: relative;
}

.exhibit-amount .currency {
  font-size: 28rpx;
  font-weight: 300;
  color: var(--accent-color);
}

.exhibit-amount .value {
  font-size: 64rpx;
  font-weight: 300;
  color: var(--accent-color);
  letter-spacing: 0.01em;
  line-height: 1;
  font-feature-settings: 'tnum';
}

.exhibit-meta {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 48rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid var(--bg-gold-on-dark);
  position: relative;
}

.meta-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.meta-label {
  font-size: 20rpx;
  color: rgba(247, 245, 239, 0.72);
  letter-spacing: 0.18em;
  font-weight: 400;
}

.meta-value {
  font-size: 28rpx;
  font-weight: 300;
  color: var(--lux-gold-500);
  font-feature-settings: 'tnum';
}

.meta-divider {
  width: 1rpx;
  height: 36rpx;
  background: var(--bg-gold-on-dark);
}

/* ============================================
   分类展区 — 台账行线列表（去白卡/色条/阴影）
   ============================================ */
.category-gallery {
  display: flex;
  flex-direction: column;
  margin-bottom: 8rpx;
  border-bottom: 1rpx solid rgba(26, 26, 23, 0.14);
}

.category-frame {
  padding: 30rpx 4rpx;
  position: relative;
}

.category-frame + .category-frame {
  border-top: 1rpx solid rgba(26, 26, 23, 0.14);
}

.frame-content {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.frame-icon {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.icon-dot {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  position: relative;
}

.icon-dot::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: var(--lux-card-bg);
}

.activity-dot {
  background: var(--primary-color);
}

.boarding-dot {
  background: var(--boarding-primary);
}

.feeding-dot {
  background: var(--feeding-primary);
}

.frame-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.frame-title {
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 0.08em;
  font-weight: 400;
}

.frame-amount {
  font-size: 34rpx;
  font-weight: 400;
  color: var(--text-primary);
  font-feature-settings: 'tnum';
  letter-spacing: 0.01em;
}

.frame-stat {
  flex-shrink: 0;
}

.stat-text {
  font-size: 20rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.04em;
}

/* ============================================
   明细展区 — 拆卡纸面分节 + 时间线
   ============================================ */
.timeline-exhibit {
  padding: 40rpx 4rpx 0;
}

.exhibit-header {
  margin-bottom: 24rpx;
}

.exhibit-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.10em;
}

/* ---------- 筛选导航（文字 tab + 金墨短线） ---------- */
.filter-nav {
  display: flex;
  gap: 40rpx;
  margin-bottom: 8rpx;
  padding-bottom: 0;
  border-bottom: 1rpx solid rgba(26, 26, 23, 0.14);
}

.nav-pill {
  position: relative;
  padding: 8rpx 0 20rpx;
  font-size: 25rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.06em;
  font-weight: 400;
}

.nav-pill.active {
  color: var(--text-primary);
  font-weight: 500;
  background: transparent;
  border: none;
  box-shadow: none;
}

.nav-pill.active::after {
  content: '';
  position: absolute;
  bottom: -1rpx;
  left: 50%;
  margin-left: -18rpx;
  width: 36rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: var(--lux-gold-ink);
}

/* ---------- 时间线列表 ---------- */
.timeline-list {
  position: relative;
}

/* ---------- 空状态 ---------- */
.empty-gallery {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  gap: 20rpx;
}

.empty-icon {
  animation: zy-breathe-glow 4000ms ease-in-out infinite;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--lux-card-cream);
  border: 1rpx solid rgba(26, 26, 23, 0.14);
  position: relative;
}

.empty-icon::before,
.empty-icon::after {
  content: '';
  position: absolute;
  background: var(--accent-color);
  border-radius: 2rpx;
}

.empty-icon::before {
  top: 50%;
  left: 16rpx;
  right: 16rpx;
  height: 2rpx;
  transform: translateY(-50%);
}

.empty-icon::after {
  left: 50%;
  top: 16rpx;
  bottom: 16rpx;
  width: 2rpx;
  transform: translateX(-50%);
}

.empty-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 0.16em;
}

/* ---------- 时间线条目 ---------- */
.timeline-item {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 0;
  position: relative;
  border-bottom: 1rpx solid rgba(26, 26, 23, 0.14);
}

.timeline-item:last-child {
  border-bottom: none;
}

.timeline-marker {
  position: relative;
  flex-shrink: 0;
  width: 40rpx;
  display: flex;
  align-items: flex-start;
  padding-top: 6rpx;
}

.marker-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  border: 2rpx solid var(--lux-card-bg);
  margin-left: 14rpx;
}

.activity-marker {
  background: var(--primary-color);
  box-shadow: 0 0 0 2rpx var(--primary-color);
}

.boarding-marker {
  background: var(--boarding-primary);
  box-shadow: 0 0 0 2rpx var(--boarding-primary);
}

.feeding-marker {
  background: var(--feeding-primary);
  box-shadow: 0 0 0 2rpx var(--feeding-primary);
}

.timeline-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.content-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.content-title {
  flex: 1;
  font-size: 24rpx;
  color: var(--text-primary);
  letter-spacing: 0.02em;
  line-height: 1.4;
  font-weight: 400;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.content-amount {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--lux-gold-ink, #7A5F2A);
  font-feature-settings: 'tnum';
  letter-spacing: 0.01em;
  flex-shrink: 0;
}

.content-amount-negative {
  color: var(--error-color);
}

.content-footer {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.content-time {
  font-size: 20rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.04em;
}

.content-status {
  font-size: 18rpx;
  color: var(--text-secondary);
  padding: 4rpx 14rpx;
  background: transparent;
  border: 1rpx solid rgba(26, 26, 23, 0.28);
  border-radius: var(--zy-radius-sm);
  letter-spacing: 0.04em;
  font-weight: 400;
}

/* ---------- 金粒瀑布 · 切换分类加载 ---------- */
.detail-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 44rpx;
  padding: 100rpx 0;
}

.end-mark {
  display: flex;
  justify-content: center;
  padding: 32rpx 0 16rpx;
}

.end-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: var(--accent-color);
  opacity: 0.5;
}

/* ==================== 服务收入钱包（行线式：label 左 + 金额 + 金墨描边提现按钮） ==================== */
.service-wallet-card {
  margin: 8rpx 0 40rpx;
  padding: 30rpx 4rpx;
  background: transparent;
  border-bottom: 1rpx solid rgba(26, 26, 23, 0.14);
}

.service-wallet-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.service-wallet-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.service-wallet-label {
  font-size: 24rpx;
  color: var(--text-tertiary, #9A9489);
  letter-spacing: 0.08em;
}

.service-wallet-value {
  font-size: 44rpx;
  font-weight: 300;
  color: var(--text-primary, #1D1E2C);
  font-feature-settings: 'tnum';
}

.service-wallet-btn {
  padding: 0 44rpx;
  height: 72rpx;
  line-height: 68rpx;
  font-size: 26rpx;
  font-weight: 500;
  letter-spacing: 0.08em;
  color: var(--lux-gold-ink, #7A5F2A);
  background: transparent;
  border: 1rpx solid var(--lux-gold-ink, #7A5F2A);
  border-radius: var(--lux-radius-pill, 999rpx);
}

/* ==================== 提现弹窗（与 income 页一致） ==================== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--overlay-color, rgba(0, 0, 0, 0.5));
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  width: 600rpx;
  background: var(--lux-card-bg, #FFFFFF);
  border-radius: var(--zy-radius-xl, 24rpx);
  padding: 48rpx 40rpx;
  border: 1rpx solid var(--lux-hairline, rgba(26,26,23,0.06));
  box-shadow: var(--lux-shadow-elevated, 0 8rpx 32rpx rgba(29, 30, 44, 0.08));
}

.modal-title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-primary, #1D1E2C);
  text-align: center;
  margin-bottom: 24rpx;
  letter-spacing: 0.05em;
}

.modal-balance {
  font-size: 24rpx;
  color: var(--text-secondary, #6B6F76);
  text-align: center;
  margin-bottom: 28rpx;
  letter-spacing: 0.03em;
}

.modal-input-row {
  display: flex;
  align-items: center;
  border: 1rpx solid var(--lux-hairline, rgba(26,26,23,0.06));
  border-radius: var(--lux-radius-card, 16rpx);
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  background: var(--lux-card-cream, #FDFAF3);
}

.modal-input-prefix {
  font-size: 36rpx;
  font-weight: 300;
  color: var(--text-primary, #1D1E2C);
  margin-right: 12rpx;
}

.modal-input {
  flex: 1;
  font-size: 36rpx;
  font-weight: 300;
  color: var(--text-primary, #1D1E2C);
  height: 50rpx;
  font-family: inherit;
  font-feature-settings: 'tnum';
}

.modal-tips {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 36rpx;
}

.modal-tips text:first-child {
  font-size: 22rpx;
  color: var(--text-tertiary, #9A9489);
}

.modal-all-btn {
  font-size: 24rpx;
  color: var(--primary-color, #2F6B4F);
  font-weight: 400;
  letter-spacing: 0.03em;
}

.modal-btns {
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: var(--lux-radius-pill, 999rpx);
  font-size: 26rpx;
  font-weight: 500;
  letter-spacing: 0.1em;
  border: none;
}

.modal-btn::after {
  border: none;
}

.modal-btn-cancel {
  background: var(--divider-color, #EDEBE4);
  color: var(--text-primary, #1A1A17);
}

.modal-btn-confirm {
  background: var(--gradient-primary, linear-gradient(135deg, #2F6B4F, #4B8B6A));
  color: var(--text-on-primary, #FFFFFF);
  box-shadow: var(--lux-shadow-green, 0 8rpx 24rpx rgba(47, 107, 79, 0.25));
}

.modal-btn-disabled {
  opacity: 0.5;
}

/* ==================== 收款方式选择 + 收款账号管理（v5.1） ==================== */
.modal-payout {
  margin-bottom: 16rpx;
}

.modal-payout-label {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary, #6B6F76);
  margin-bottom: 12rpx;
}

.modal-payout-group {
  display: flex;
  gap: 16rpx;
}

.modal-payout-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 12rpx;
  border: 1rpx solid var(--lux-hairline, rgba(26,26,23,0.06));
  background: var(--lux-card-cream, #FDFAF3);
  font-size: 26rpx;
  color: var(--text-secondary, #6B6F76);
}

.modal-payout-item.active {
  border-color: var(--primary-color, #2F6B4F);
  color: var(--primary-color, #2F6B4F);
  background: rgba(47, 107, 79, 0.08);
}

.modal-payout-account {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.payout-account-text {
  font-size: 24rpx;
  color: var(--text-primary, #1D1E2C);
}

.payout-account-empty {
  font-size: 24rpx;
  color: var(--text-tertiary, #9A9489);
}

.payee-modal {
  max-height: 80vh;
  overflow-y: auto;
}

.payee-section {
  margin-bottom: 20rpx;
}

.payee-label {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary, #6B6F76);
  margin-bottom: 10rpx;
}

.payee-input {
  margin-bottom: 12rpx;
  border-radius: 12rpx;
}

/* ================================================================
   非合伙人引导卡（403 态 · 2026-09-10）
   ================================================================ */
.pp-noperm {
  margin: 60rpx var(--page-padding);
  padding: 56rpx 40rpx;
  border: 1rpx solid rgba(26, 26, 23, 0.14);
  border-radius: var(--lux-radius-card);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.pp-noperm-eyebrow {
  font-size: 20rpx;
  color: var(--lux-gold-ink);
  letter-spacing: 0.24em;
}

.pp-noperm-title {
  font-size: 36rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.08em;
}

.pp-noperm-desc {
  font-size: 23rpx;
  color: var(--text-tertiary);
  line-height: 1.7;
  text-align: center;
  margin-bottom: 12rpx;
}

.pp-noperm-btn {
  min-width: 340rpx;
  height: 84rpx;
  padding: 0 56rpx;
  border-radius: var(--lux-radius-pill, 999rpx);
  background: var(--lux-green-grad);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--lux-shadow-green);
  transition: transform 240ms cubic-bezier(0.25, 0.1, 0.25, 1), opacity 240ms cubic-bezier(0.25, 0.1, 0.25, 1);
}

.pp-noperm-btn--pressed {
  transform: scale(0.98);
  opacity: 0.9;
}

.pp-noperm-btn-text {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-on-primary);
  letter-spacing: 0.12em;
}
