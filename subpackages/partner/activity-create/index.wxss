/* ================================================================
   AROORO 合伙人创建活动 · B hero + A 编辑式台账表单（2026-09-10 升级）
   范式：章节号 + 行线字段 + 无底无框输入（对齐 hosting-profile-edit）
   Skyline 兼容：无 :active / transition 仅 transform & opacity / 兄弟选择器行线
   ================================================================ */
@import '../common.wxss';

/* ---------- 章节分节 ---------- */
.ac-section {
  padding: 48rpx var(--page-padding) 44rpx;
  border-bottom: 1rpx solid rgba(26, 26, 23, 0.14);
}

.ac-section--last {
  border-bottom: none;
}

/* 章节头：金墨编号 + 标题 + 渐隐细线 */
.ac-chapter {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.ac-chapter-no {
  font-size: 22rpx;
  font-weight: 500;
  letter-spacing: 0.28em;
  color: var(--lux-gold-ink);
  font-feature-settings: 'tnum';
}

.ac-chapter-title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.1em;
}

.ac-chapter-rule {
  flex: 1;
  height: 1rpx;
  background: rgba(26, 26, 23, 0.14);
}

/* ---------- 编辑式字段行：label 左 value 右，行线分区 ---------- */
.ac-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 24rpx 0;
}

.ac-field + .ac-field {
  border-top: 1rpx solid rgba(26, 26, 23, 0.14);
}

/* 通栏字段（textarea/封面/图集）：label 上、控件下，行线仍由相邻 field 提供 */
.ac-field--stack {
  flex-direction: column;
  align-items: stretch;
  gap: 16rpx;
}

.ac-label {
  flex-shrink: 0;
  font-size: 25rpx;
  color: var(--text-secondary);
  letter-spacing: 0.08em;
  font-weight: 400;
}

.ac-req {
  color: var(--error-color);
  margin-left: 6rpx;
}

/* 无底无框输入（右对齐），placeholder 灰 */
.ac-input {
  flex: 1;
  min-width: 0;
  height: 56rpx;
  text-align: right;
  font-size: 28rpx;
  color: var(--text-primary);
  background: transparent;
  font-family: inherit;
}

.ac-input-num {
  font-feature-settings: 'tnum';
}

.ac-ph {
  color: var(--text-tertiary);
}

/* 通栏 textarea：无底无框 */
.ac-textarea {
  width: 100%;
  height: 180rpx;
  font-size: 27rpx;
  line-height: 1.7;
  color: var(--text-primary);
  background: transparent;
  font-family: inherit;
}

/* ---------- 行内 picker ---------- */
.ac-picker {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
  min-height: 56rpx;
  flex: 1;
  min-width: 0;
}

.ac-picker-text {
  font-size: 28rpx;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ac-arrow {
  font-size: 30rpx;
  color: var(--text-tertiary);
  flex-shrink: 0;
  line-height: 1;
}

.ac-picker-right {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-shrink: 0;
}

.loc-clear {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: rgba(26, 26, 23, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}

.loc-clear-icon {
  font-size: 20rpx;
  color: var(--text-secondary);
  line-height: 1;
}

/* ---------- 封面上传（虚线框 + 透明底） ---------- */
.cover-upload {
  width: 100%;
  height: 320rpx;
  border: 1rpx dashed rgba(26, 26, 23, 0.28);
  border-radius: var(--lux-radius-inner);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
}

.cover-preview {
  width: 100%;
  height: 100%;
}

.cover-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.cover-plus {
  font-size: 52rpx;
  color: var(--text-tertiary);
  font-weight: 300;
  line-height: 1;
}

.cover-hint {
  font-size: 22rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.1em;
}

/* ---------- 详情图片网格 ---------- */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.image-grid > .image-grid-item {
  flex: 0 0 calc((100% - 24rpx) / 3);
}

.image-grid-item {
  position: relative;
  width: 100%;
  aspect-ratio: 1;
  border-radius: var(--lux-radius-inner);
  overflow: hidden;
}

.grid-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.image-remove {
  position: absolute;
  top: 0;
  right: 0;
  width: 36rpx;
  height: 36rpx;
  background: var(--overlay-color);
  color: #F7F5EF;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 0 0 var(--lux-radius-inner);
}

.image-add {
  border: 1rpx dashed rgba(26, 26, 23, 0.28);
  background: transparent;
}

.upload-icon-small {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 36rpx;
  color: var(--text-tertiary);
  font-weight: 300;
}

/* ---------- 底部让位 + 操作栏 ---------- */
.ac-tail {
  height: 180rpx;
}

.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: var(--lux-card-bg);
  border-top: 1rpx solid rgba(26, 26, 23, 0.14);
  z-index: 50;
  box-shadow: var(--shadow-float);
}

.action-btn {
  flex: 1;
  height: 88rpx;
  border-radius: var(--zy-radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.action-btn::after {
  border: none;
}

.action-btn-draft {
  background: transparent;
  border: 1rpx solid var(--border-color);
}

.action-btn-draft .action-btn-text {
  color: var(--text-secondary);
  font-size: 28rpx;
  font-weight: 400;
  letter-spacing: 0.06em;
}

.action-btn-publish {
  background: var(--gradient-primary);
  box-shadow: var(--lux-shadow-green);
}

.action-btn-publish .action-btn-text {
  color: var(--text-on-primary);
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 0.1em;
}

/* ---------- 底部选择弹层 ---------- */
.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--overlay-color);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.picker-sheet {
  width: 100%;
  background: var(--lux-card-bg);
  border-radius: var(--zy-radius-2xl) var(--zy-radius-2xl) 0 0;
  overflow: hidden;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid rgba(26, 26, 23, 0.14);
  box-shadow: var(--lux-shadow-elevated);
}

.picker-sheet-header {
  padding: 32rpx 36rpx;
  border-bottom: 1rpx solid var(--divider-color);
}

.picker-sheet-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.06em;
}

.picker-sheet-body {
  padding: 12rpx 0;
}

.picker-sheet-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 36rpx;
}

.picker-item-active {
  background: var(--primary-tint);
}

.picker-sheet-item-text {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 400;
}

.picker-item-active .picker-sheet-item-text {
  color: var(--primary-color);
  font-weight: 500;
}

.picker-check {
  width: 26rpx;
  height: 26rpx;
  flex-shrink: 0;
}
