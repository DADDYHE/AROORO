/* ================================================================
   AROORO 合伙人创建活动 · 深森林绿 × 香槟金 × 奶油白 高奢风格
   Skyline 兼容：无 :active / transition 仅 transform & opacity / 单行截断
   ================================================================ */
@import '../common.wxss';

/* ============================================
   表单页 — 封面上传 + 表单字段 + 日期选择 + 发布按钮
   ============================================ */

.form-scroll {
  padding-bottom: 180rpx;
}

/* ---------- 卡片色条 ---------- */
.card-accent {
  width: 3rpx;
  height: 100%;
  position: absolute;
  left: 0;
  top: 0;
  background: var(--primary-color);
}

.card-body {
  position: relative;
  padding: 32rpx 36rpx;
}

/* ---------- 表单分区标题 ---------- */
.form-section-title {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 24rpx;
  letter-spacing: 0.16em;
}

/* ---------- 表单字段 ---------- */
.form-field {
  margin-bottom: 28rpx;
}

.form-field-half {
  flex: 1;
}

.form-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 12rpx;
  letter-spacing: 0.06em;
  font-weight: 400;
}

.required {
  color: var(--error-color);
  margin-left: 4rpx;
}

.form-input {
  width: 100%;
  height: 76rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--lux-hairline);
  border-radius: var(--lux-radius-inner);
  font-size: 28rpx;
  color: var(--text-primary);
  box-sizing: border-box;
  background: var(--lux-card-bg);
  font-family: inherit;
}

.form-textarea {
  width: 100%;
  height: 200rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid var(--lux-hairline);
  border-radius: var(--lux-radius-inner);
  font-size: 28rpx;
  color: var(--text-primary);
  box-sizing: border-box;
  background: var(--lux-card-bg);
  font-family: inherit;
  line-height: 1.6;
}

/* ---------- 选择器 ---------- */
.form-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 76rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--lux-hairline);
  border-radius: var(--lux-radius-inner);
  background: var(--lux-card-bg);
}

.form-picker-text {
  font-size: 28rpx;
  color: var(--text-primary);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.form-picker-text.placeholder {
  color: var(--text-tertiary);
}

.form-picker-arrow {
  font-size: 28rpx;
  color: var(--text-tertiary);
  flex-shrink: 0;
  margin-left: 12rpx;
}

.form-row {
  display: flex;
  gap: 20rpx;
}

/* ---------- 封面上传 ---------- */
.image-upload-area {
  width: 100%;
  height: 320rpx;
  border: 1rpx dashed var(--border-color);
  border-radius: var(--lux-radius-card);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--lux-card-cream);
}

.cover-preview {
  width: 100%;
  height: 100%;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.upload-icon {
  font-size: 48rpx;
  color: var(--text-tertiary);
  font-weight: 300;
  line-height: 1;
}

.upload-text {
  font-size: 22rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.06em;
}

/* ---------- 详情图片网格 ---------- */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.image-grid > .image-grid-item {
  flex: 0 0 calc((100% - 24rpx) / 3);
}

.image-grid-item {
  position: relative;
  width: 100%;
  aspect-ratio: 1;
  border-radius: var(--lux-radius-inner);
  overflow: hidden;
}

.grid-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.image-remove {
  position: absolute;
  top: 0;
  right: 0;
  width: 36rpx;
  height: 36rpx;
  background: var(--overlay-color);
  color: var(--lux-card-bg);
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 0 0 var(--lux-radius-inner);
}

.image-add {
  border: 1rpx dashed var(--border-color);
  background: var(--lux-card-cream);
}

.image-add .upload-icon-small {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.upload-icon-small {
  font-size: 36rpx;
  color: var(--text-tertiary);
  font-weight: 300;
}

/* ---------- 位置选择 ---------- */
.location-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 76rpx;
  padding: 16rpx 24rpx;
  border: 1rpx solid var(--lux-hairline);
  border-radius: var(--lux-radius-inner);
  background: var(--lux-card-bg);
}

.location-picker-text {
  font-size: 26rpx;
  color: var(--text-primary);
  flex: 1;
  margin-right: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.location-picker-text.placeholder {
  color: var(--text-tertiary);
}

.location-picker-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.location-clear {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: var(--divider-color);
  display: flex;
  align-items: center;
  justify-content: center;
}

.clear-icon {
  font-size: 20rpx;
  color: var(--text-secondary);
  line-height: 1;
}

/* ---------- 底部操作栏 ---------- */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: var(--lux-card-bg);
  border-top: 1rpx solid var(--lux-hairline);
  z-index: 50;
  box-shadow: var(--shadow-float);
}

.action-btn {
  flex: 1;
  height: 88rpx;
  border-radius: var(--lux-radius-pill);
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.action-btn::after {
  border: none;
}

.action-btn-draft {
  background: var(--divider-color);
}

.action-btn-draft .action-btn-text {
  color: var(--text-primary);
  font-size: 28rpx;
  font-weight: 400;
  letter-spacing: 0.06em;
}

.action-btn-publish {
  background: var(--gradient-primary);
  box-shadow: var(--lux-shadow-green);
}

.action-btn-publish .action-btn-text {
  color: var(--text-on-primary);
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 0.1em;
}

/* ---------- 底部选择弹层 ---------- */
.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--overlay-color);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.picker-sheet {
  width: 100%;
  background: var(--lux-card-bg);
  border-radius: var(--zy-radius-2xl) var(--zy-radius-2xl) 0 0;
  overflow: hidden;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid var(--lux-hairline);
  box-shadow: var(--lux-shadow-elevated);
}

.picker-sheet-header {
  padding: 32rpx 36rpx;
  border-bottom: 1rpx solid var(--divider-color);
}

.picker-sheet-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.06em;
}

.picker-sheet-body {
  padding: 12rpx 0;
}

.picker-sheet-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 36rpx;
}

.picker-item-active {
  background: var(--primary-tint);
}

.picker-sheet-item-text {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 400;
}

.picker-item-active .picker-sheet-item-text {
  color: var(--primary-color);
  font-weight: 500;
}

.picker-check {
  width: 26rpx;
  height: 26rpx;
  flex-shrink: 0;
}
