@import '../common.wxss';

.form-scroll {
  padding-bottom: 180rpx;
}

.card-accent {
  width: 3rpx;
  height: 100%;
  position: absolute;
  left: 0;
  top: 0;
  background: linear-gradient(180deg, var(--activity-primary) 0%, var(--activity-primary-mid) 100%);
}

.card-body {
  position: relative;
  padding: 32rpx 36rpx;
}

.form-section-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 24rpx;
  letter-spacing: 4rpx;
}

.form-field {
  margin-bottom: 28rpx;
}

.form-field-half {
  flex: 1;
}

.form-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}

.required {
  color: var(--error-color);
}

.form-input {
  width: 100%;
  height: 76rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--gray-200);
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  box-sizing: border-box;
  background: var(--surface-tint);
}

.form-textarea {
  width: 100%;
  height: 200rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid var(--gray-200);
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  box-sizing: border-box;
  background: var(--surface-tint);
}

.form-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 76rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--gray-200);
  border-radius: 12rpx;
  background: var(--surface-tint);
}

.form-picker-text {
  font-size: 28rpx;
  color: var(--text-primary);
}

.form-picker-text.placeholder {
  color: var(--text-tertiary);
}

.form-picker-arrow {
  font-size: 32rpx;
  color: var(--text-tertiary);
}

.form-row {
  display: flex;
  gap: 20rpx;
}

.image-upload-area {
  width: 100%;
  height: 320rpx;
  border: 2rpx dashed var(--gray-200);
  border-radius: 16rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cover-preview {
  width: 100%;
  height: 100%;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.upload-icon {
  font-size: 56rpx;
  color: var(--text-tertiary);
  font-weight: 300;
  line-height: 1;
}

.upload-text {
  font-size: 22rpx;
  color: var(--text-secondary);
  letter-spacing: 4rpx;
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.image-grid-item {
  position: relative;
  width: 100%;
  padding-bottom: 100%;
  border-radius: 12rpx;
  overflow: hidden;
}

.grid-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.image-remove {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.5);
  color: var(--card-color);
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 0 0 12rpx;
}

.image-add {
  border: 2rpx dashed var(--gray-200);
  background: var(--surface-tint);
}

.image-add .upload-icon-small {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.upload-icon-small {
  font-size: 40rpx;
  color: var(--text-tertiary);
  font-weight: 300;
}

.location-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 76rpx;
  padding: 16rpx 24rpx;
  border: 1rpx solid var(--gray-200);
  border-radius: 12rpx;
  background: var(--surface-tint);
}

.location-picker-text {
  font-size: 28rpx;
  color: var(--text-primary);
  flex: 1;
  margin-right: 16rpx;
}

.location-picker-text.placeholder {
  color: var(--text-tertiary);
}

.location-picker-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.location-clear {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--gray-200);
  display: flex;
  align-items: center;
  justify-content: center;
}

.clear-icon {
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1;
}

.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: var(--card-color);
  box-shadow: 0 -2rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 50;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn-draft {
  background: var(--divider-color);
}

.action-btn-draft .action-btn-text {
  color: var(--text-primary);
  font-size: 28rpx;
  font-weight: 500;
}

.action-btn-publish {
  background: linear-gradient(135deg, var(--activity-primary) 0%, var(--activity-primary-mid) 100%);
  box-shadow: 0 4rpx 16rpx rgba(79, 94, 53, 0.3);
}

.action-btn-publish .action-btn-text {
  color: var(--card-color);
  font-size: 28rpx;
  font-weight: 500;
}

.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.picker-sheet {
  width: 100%;
  background: var(--card-color);
  border-radius: 24rpx 24rpx 0 0;
  overflow: hidden;
  padding-bottom: env(safe-area-inset-bottom);
}

.picker-sheet-header {
  padding: 32rpx 36rpx;
  border-bottom: 1rpx solid var(--divider-color);
}

.picker-sheet-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.picker-sheet-body {
  padding: 12rpx 0;
}

.picker-sheet-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 36rpx;
}

.picker-item-active {
  background: rgba(79, 94, 53, 0.06);
}

.picker-sheet-item-text {
  font-size: 28rpx;
  color: var(--text-primary);
}

.picker-item-active .picker-sheet-item-text {
  color: var(--activity-primary-mid);
  font-weight: 500;
}

.picker-check {
  font-size: 28rpx;
  color: var(--activity-primary);
}
