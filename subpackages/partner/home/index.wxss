@import '../common.wxss';

/* ============================================
   AROORO 合伙人管理中心 — Haute-Luxury Dashboard（2026-09-10 升级）
   深绿展品收入卡 + 描边提示卡 + 台账行线模块目录
   ============================================ */

.card-body {
  position: relative;
  padding: 36rpx;
}

/* ---------- 提示卡（审核中/成为伙伴）：描边式，纸面唯一带框元素 ---------- */
.notice-card {
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(26, 26, 23, 0.28);
  border-radius: var(--lux-radius-card);
  background: transparent;
  position: relative;
  overflow: hidden;
}

.notice-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  background: var(--lux-gold-ink);
}

.pending-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  display: block;
  margin-bottom: 12rpx;
  letter-spacing: 0.06em;
}

.pending-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 28rpx;
  line-height: 1.6;
  letter-spacing: 0.02em;
}

.pending-btn {
  display: inline-flex;
  padding: 16rpx 44rpx;
  background: var(--gradient-primary);
  border-radius: var(--zy-radius-lg);
  box-shadow: var(--lux-shadow-green);
}

.pending-btn-text {
  font-size: 24rpx;
  color: var(--text-on-primary);
  font-weight: 500;
  letter-spacing: 0.10em;
}

/* ---------- 收入概览卡（深绿展品，全页唯一深色卡） ---------- */
.income-card {
  background: var(--lux-green-grad-rich);
  border: 1rpx solid var(--lux-hairline-green);
  border-radius: var(--lux-radius-card);
  margin-bottom: 8rpx;
  position: relative;
  overflow: hidden;
}

.income-card .card-body {
  padding: 44rpx 36rpx;
}

/* 收入卡片右上角金色光晕 */
.income-card::before {
  content: '';
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, var(--mall-tint) 0%, transparent 70%);
  pointer-events: none;
}

.income-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
  position: relative;
}

.income-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

/* 深绿底金字：--lux-gold-500（6.75:1），数字展品档 */
.income-value {
  font-size: 40rpx;
  font-weight: 300;
  color: var(--lux-gold-500);
  letter-spacing: 0.01em;
  font-feature-settings: 'tnum';
}

.income-label {
  font-size: 20rpx;
  color: rgba(247, 245, 239, 0.72);
  letter-spacing: 0.20em;
  font-weight: 400;
}

.income-divider {
  width: 1rpx;
  height: 56rpx;
  background: var(--bg-gold-on-dark);
}

/* ---------- 分区入口标题 ---------- */
.gallery-entrance {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 40rpx 0 8rpx;
}

.entrance-line {
  width: 32rpx;
  height: 2rpx;
  background: var(--lux-gold-ink);
}

.entrance-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  letter-spacing: 0.20em;
  font-weight: 400;
}

/* ---------- 模块入口（2 列网格 · 轻描边卡） ---------- */
.module-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.module-grid > .module-card {
  flex: 0 0 calc((100% - 20rpx) / 2);
}

.module-card {
  background: transparent;
  border-radius: var(--lux-radius-card);
  padding: 32rpx 28rpx;
  border: 1rpx solid rgba(26, 26, 23, 0.14);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
  position: relative;
  overflow: hidden;
}

/* ---------- 模块图标：刻印章牌（双环金墨，2026-09-12） ---------- */
.module-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(26, 26, 23, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 4rpx;
  position: relative;
}

.module-icon::before {
  content: '';
  position: absolute;
  top: 5rpx;
  left: 5rpx;
  right: 5rpx;
  bottom: 5rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(26, 26, 23, 0.08);
}

.module-icon-img {
  width: 40rpx;
  height: 40rpx;
}

.module-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.04em;
}

.module-desc {
  font-size: 21rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.02em;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}

/* ---------- 入场动画（卡片级联） ---------- */
.module-card {
  animation-name: zy-fade-in-up;
  animation-duration: 480ms;
  animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  animation-fill-mode: forwards;
  opacity: 0;
}

.module-grid > .module-card:nth-child(1) { animation-delay: 80ms; }
.module-grid > .module-card:nth-child(2) { animation-delay: 140ms; }
.module-grid > .module-card:nth-child(3) { animation-delay: 200ms; }
.module-grid > .module-card:nth-child(4) { animation-delay: 260ms; }
.module-grid > .module-card:nth-child(5) { animation-delay: 320ms; }
.module-grid > .module-card:nth-child(6) { animation-delay: 380ms; }
.module-grid > .module-card:nth-child(7) { animation-delay: 440ms; }
