@import '../common.wxss';

/* ============================================
   AROORO 合伙人工作台首页 — Haute-Luxury Dashboard
   深森林绿主色 + 金属香槟金阶 + 奶油暖白底
   层次阴影 · 编辑级排版 · 金线装饰 · 线性图标
   ============================================ */

/* ---------- 待处理/审核卡片 ---------- */
.card-accent {
  width: 3rpx;
  height: 100%;
  position: absolute;
  left: 0;
  top: 0;
  background: var(--primary-color);
}

.income-accent {
  background: var(--lux-gold-grad);
}

.card-body {
  position: relative;
  padding: 36rpx;
}

.pending-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  display: block;
  margin-bottom: 12rpx;
  letter-spacing: 0.06em;
}

.pending-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 28rpx;
  line-height: 1.6;
  letter-spacing: 0.02em;
}

.pending-btn {
  display: inline-flex;
  padding: 16rpx 44rpx;
  background: var(--gradient-primary);
  border-radius: var(--zy-radius-lg);
  box-shadow: var(--lux-shadow-green);
}

.pending-btn-text {
  font-size: 24rpx;
  color: var(--text-on-primary);
  font-weight: 500;
  letter-spacing: 0.10em;
}

/* ---------- 收入概览卡片（深色高奢卡） ---------- */
.income-card {
  background: var(--lux-green-grad-rich);
  border: 1rpx solid var(--lux-hairline-green);
}

.income-card .card-body {
  padding: 40rpx 36rpx;
}

/* 收入卡片右上角金色光晕 */
.income-card::before {
  content: '';
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, var(--mall-tint) 0%, transparent 70%);
  pointer-events: none;
}

.income-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
  position: relative;
}

.income-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.income-value {
  font-size: 38rpx;
  font-weight: 300;
  color: var(--accent-color);
  letter-spacing: 0.01em;
  font-feature-settings: 'tnum';
}

.income-label {
  font-size: 20rpx;
  color: var(--text-on-dark-50);
  letter-spacing: 0.20em;
  font-weight: 400;
}

.income-divider {
  width: 1rpx;
  height: 56rpx;
  background: var(--bg-gold-on-dark);
}

/* ---------- 分区入口标题 ---------- */
.gallery-entrance {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 36rpx 0 24rpx;
}

.entrance-line {
  width: 32rpx;
  height: 1rpx;
  background: var(--accent-color);
}

.entrance-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  letter-spacing: 0.20em;
  font-weight: 400;
}

/* ---------- 快捷功能网格 ---------- */
.module-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.module-grid > .module-card {
  flex: 0 0 calc((100% - 20rpx) / 2);
}

.module-card {
  background: var(--lux-card-bg);
  border-radius: var(--lux-radius-card);
  padding: 32rpx 28rpx;
  border: 1rpx solid var(--lux-hairline);
  box-shadow: var(--lux-shadow-card);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
  position: relative;
  overflow: hidden;
}

/* 模块卡片右上角微光装饰 */
.module-card::after {
  content: '';
  position: absolute;
  top: -30rpx;
  right: -30rpx;
  width: 100rpx;
  height: 100rpx;
  background: radial-gradient(circle, var(--mall-tint-04) 0%, transparent 70%);
  pointer-events: none;
}

/* ---------- 模块图标容器 ---------- */
.module-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--lux-radius-inner);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 4rpx;
  position: relative;
}

.module-icon-img {
  width: 32rpx;
  height: 32rpx;
}

/* 各模块图标底色 — 使用板块色调浅底 */
.module-icon-income {
  background: var(--lux-card-gold-tint);
  border: 1rpx solid var(--lux-hairline-gold);
}

.module-icon-serviceIncome {
  background: var(--lux-card-gold-tint);
  border: 1rpx solid var(--lux-hairline-gold);
}

.module-icon-referral {
  background: var(--activity-accent);
  border: 1rpx solid var(--lux-hairline-green);
}

.module-icon-activity {
  background: var(--activity-accent);
  border: 1rpx solid var(--lux-hairline-green);
}

.module-icon-hosting {
  background: var(--boarding-accent);
  border: 1rpx solid var(--boarding-tint-12);
}

.module-icon-feeding {
  background: var(--feeding-accent);
  border: 1rpx solid var(--feeding-tint-12);
}

.module-icon-application {
  background: var(--lux-card-cream);
  border: 1rpx solid var(--lux-hairline);
}

.module-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.04em;
}

.module-desc {
  font-size: 20rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.02em;
}

/* ---------- 入场动画 ---------- */
.module-card {
  animation-name: zy-fade-in-up;
  animation-duration: 480ms;
  animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  animation-fill-mode: forwards;
  opacity: 0;
}

.module-grid > .module-card:nth-child(1) { animation-delay: 80ms; }
.module-grid > .module-card:nth-child(2) { animation-delay: 140ms; }
.module-grid > .module-card:nth-child(3) { animation-delay: 200ms; }
.module-grid > .module-card:nth-child(4) { animation-delay: 260ms; }
.module-grid > .module-card:nth-child(5) { animation-delay: 320ms; }
.module-grid > .module-card:nth-child(6) { animation-delay: 380ms; }
.module-grid > .module-card:nth-child(7) { animation-delay: 440ms; }
