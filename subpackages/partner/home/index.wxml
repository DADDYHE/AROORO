<zy-navbar title="" transparent color="#F7F5EF" solid="{{_navbarSolid}}" />
<login-prompt visible="{{showLoginPrompt}}" bind:close="onLoginPromptClose" />
<scroll-view
  scroll-y
  enhanced
  refresher-enabled="{{true}}"
  refresher-triggered="{{_refresherTriggered}}"
  bindrefresherrefresh="_onRefresherRefresh"
  bindscrolltolower="_onScrollToLower"
  bindscroll="_onScroll"
  lower-threshold="100"
  style="height: 100vh;"
>
<view class="lux-hero" style="padding-top: calc({{_navbarHeight}}px + 24rpx);">
  <text class="lux-hero-eyebrow">PARTNER</text>
  <text class="lux-hero-title">管理中心</text>
  <text class="lux-hero-sub">合作伙伴专属</text>
  <view class="lux-hero-sealline"></view>
</view>

<view class="gallery-container">

  <view wx:if="{{isLoading}}" class="loading-container">
    <view class="loading-content">
      <view class="lux-cascade">
  <view class="lux-cascade-dot" style="left: 20rpx; background: #C9A24B; animation-delay: 0ms;"></view>
  <view class="lux-cascade-dot" style="left: 36rpx; background: #A8894A; animation-delay: 150ms;"></view>
  <view class="lux-cascade-dot" style="left: 52rpx; background: #C9A24B; animation-delay: 300ms;"></view>
  <view class="lux-cascade-dot" style="left: 68rpx; background: #A8894A; animation-delay: 450ms;"></view>
  <view class="lux-cascade-dot" style="left: 84rpx; background: #C9A24B; animation-delay: 600ms;"></view>
  <view class="lux-cascade-dot" style="left: 100rpx; background: #A8894A; animation-delay: 750ms;"></view>
  <view class="lux-cascade-dot" style="left: 48rpx; background: #C9A24B; animation-delay: 900ms;"></view>

      </view>
      <text class="loading-text">{{t.BIZ_CSIK0}}</text>
    </view>
  </view>

  <block wx:else>
    <view class="gallery-hall">
      <view wx:if="{{hasPendingApplication && !isPartner}}" class="notice-card">
        <view class="card-body">
          <text class="pending-title">申请审核中</text>
          <text class="pending-desc">您的合作伙伴申请正在审核中，请耐心等待</text>
          <view class="pending-btn" bindtap="onApplyTap">
            <text class="pending-btn-text">查看详情</text>
          </view>
        </view>
      </view>

      <view wx:if="{{!isPartner && !hasPendingApplication}}" class="notice-card">
        <view class="card-body">
          <text class="pending-title">成为合作伙伴</text>
          <text class="pending-desc">带货赚取收益，共建宠物生态</text>
          <view class="pending-btn" bindtap="onApplyTap">
            <text class="pending-btn-text">立即申请</text>
          </view>
        </view>
      </view>

      <view wx:if="{{incomeSummary && isPartner}}" class="income-card">
        <view class="card-body">
          <view class="income-row">
            <view class="income-stat">
              <text class="income-value">¥{{incomeSummary.total}}</text>
              <text class="income-label">累计收入</text>
            </view>
            <view class="income-divider"></view>
            <view class="income-stat">
              <text class="income-value">¥{{incomeSummary.monthly}}</text>
              <text class="income-label">本月收入</text>
            </view>
            <view class="income-divider"></view>
            <view class="income-stat">
              <text class="income-value">¥{{incomeSummary.walletBalance}}</text>
              <text class="income-label">可提现</text>
            </view>
          </view>
        </view>
      </view>

      <view class="gallery-entrance">
        <view class="entrance-line"></view>
        <text class="entrance-label">功能模块</text>
      </view>

      <view class="module-grid">
        <view class="module-card" wx:for="{{modules}}" wx:key="id" bindtap="onModuleTap" data-id="{{item.id}}">
          <view class="module-icon module-icon-{{item.icon}}">
            <image class="module-icon-img" src="{{item.iconPath}}" mode="aspectFit" />
          </view>
          <text class="module-title">{{item.title}}</text>
          <text class="module-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>
  </block>
</view>
</scroll-view>
