<zy-navbar title="我的开单" />
<root-portal>
  <view class="inv-root">
    <scroll-view
      scroll-y
      refresher-enabled="{{ true }}"
      refresher-triggered="{{ _refresherTriggered }}"
      bindrefresherrefresh="_onRefresherRefresh"
      bindscrolltolower="onLoadMore"
      lower-threshold="100"
      style="height: calc(100vh - {{_navbarHeight}}px);"
    >
      <view class="ledger-container">
        <!-- ═══ 卷宗头 ═══ -->
        <view class="ledger-head">
          <view class="ledger-eyebrow-row">
            <view class="ledger-accent"></view>
            <text class="ledger-eyebrow">INVITATION LEDGER</text>
          </view>
          <text class="ledger-title">我的开单</text>
          <text class="ledger-subtitle">与客户沟通好后开单，客户填写信息并完成支付</text>
          <view class="ledger-summary">
            <text class="ledger-sum-label">累计开单</text>
            <text class="ledger-sum-num">{{ total }}</text>
            <text class="ledger-sum-unit">笔</text>
          </view>
        </view>

        <!-- ═══ 状态筛选 ═══ -->
        <view class="ledger-tabs">
          <view
            wx:for="{{ tabs }}"
            wx:key="key"
            class="ledger-tab {{ activeTab === item.key ? 'ledger-tab--on' : '' }}"
            data-key="{{ item.key }}"
            bindtap="onTabTap"
            hover-class="ledger-tab--pressed"
            hover-stay-time="80"
          >
            <text class="ledger-tab-text">{{ item.label }}</text>
            <view class="ledger-tab-underline" wx:if="{{ activeTab === item.key }}"></view>
          </view>
        </view>

        <!-- 加载中 -->
        <view wx:if="{{ isLoading }}" class="ledger-loading">
          <view class="lux-cascade">
            <view class="lux-cascade-dot" style="left: 20rpx; background: #C9A24B; animation-delay: 0ms;"></view>
            <view class="lux-cascade-dot" style="left: 36rpx; background: #A8894A; animation-delay: 150ms;"></view>
            <view class="lux-cascade-dot" style="left: 52rpx; background: #C9A24B; animation-delay: 300ms;"></view>
            <view class="lux-cascade-dot" style="left: 68rpx; background: #A8894A; animation-delay: 450ms;"></view>
            <view class="lux-cascade-dot" style="left: 84rpx; background: #C9A24B; animation-delay: 600ms;"></view>
          </view>
          <text class="ledger-loading-text">正在加载…</text>
        </view>

        <block wx:else>
          <!-- 空态 -->
          <view wx:if="{{ list.length === 0 }}" class="ledger-empty">
            <text class="ledger-empty-title">暂无开单记录</text>
            <text class="ledger-empty-desc">与客户沟通好后，创建开单邀请分享给对方填写宠物信息并支付</text>
            <button class="ledger-empty-btn" bindtap="onCreateTap">立即开单</button>
          </view>

          <!-- 邀请卡（编辑式） -->
          <view
            wx:for="{{ list }}"
            wx:key="_id"
            class="inv-card {{ item.status === 'active' ? 'inv-card--editable' : '' }}"
            data-id="{{ item._id }}"
            bindtap="onCardTap"
          >
            <view class="inv-card-head">
              <view class="inv-card-title-wrap">
                <text class="inv-card-code">{{ item.shareCode }}</text>
                <text class="inv-card-days">{{ item.days }} 天 · {{ item.petCount }} 只</text>
              </view>
              <text class="inv-status {{ item.statusTagClass }}">{{ item.statusText }}</text>
            </view>

            <view class="inv-card-body">
              <view class="inv-date-col">
                <text class="inv-date-main">{{ item.dateRangeText }}</text>
                <text class="inv-date-sub">{{ item.timeText }}</text>
              </view>
              <view class="inv-price-col">
                <view class="inv-price-row">
                  <text class="inv-price-symbol">¥</text>
                  <text class="inv-price-num">{{ item.totalPrice }}</text>
                </view>
                <text class="inv-price-label">订单总价</text>
              </view>
            </view>

            <text wx:if="{{ item.note }}" class="inv-card-note">备注：{{ item.note }}</text>

              <!-- 操作区：active 分享/海报/取消；filled 释放/查看订单 -->
              <view wx:if="{{ item.status === 'active' }}" class="inv-actions">
                <button class="inv-btn inv-btn--ghost" data-id="{{ item._id }}" catchtap="onCancelTap">取消</button>
                <button class="inv-btn inv-btn--ghost" data-id="{{ item._id }}" catchtap="onPosterTap">海报</button>
                <button class="inv-btn inv-btn--primary" open-type="share" data-id="{{ item._id }}" catchtap="onShareTap">分享给客户</button>
              </view>
              <view wx:elif="{{ item.status === 'filled' }}" class="inv-actions">
                <button wx:if="{{ item.releasable }}" class="inv-btn inv-btn--ghost" data-id="{{ item._id }}" catchtap="onReleaseTap">释放</button>
                <button wx:if="{{ item.orderId }}" class="inv-btn inv-btn--primary" data-orderid="{{ item.orderId }}" catchtap="onViewOrder">查看关联订单</button>
              </view>
          </view>

          <view wx:if="{{ list.length > 0 && !hasMore }}" class="ledger-end">
            <view class="ledger-end-line"></view>
            <text class="ledger-end-text">共 {{ total }} 条记录</text>
          </view>
        </block>
      </view>
    </scroll-view>

    <!-- 底部新建按钮（root-portal 保证 Skyline 下不被 scroll-view 裁剪） -->
    <view class="inv-fab-wrap">
      <button class="inv-fab" bindtap="onCreateTap">＋ 新建开单</button>
    </view>

    <!-- 海报弹层 -->
    <view wx:if="{{ posterVisible }}" class="inv-poster-mask" bindtap="onPosterClose">
      <view class="inv-poster-panel" catchtap="">
        <text class="inv-poster-title">开单邀请海报</text>
        <view class="inv-poster-canvas-wrap">
          <canvas type="2d" id="posterCanvas" class="inv-poster-canvas"></canvas>
          <view wx:if="{{ posterLoading }}" class="inv-poster-loading">
            <text class="inv-poster-loading-text">生成中…</text>
          </view>
        </view>
        <view class="inv-poster-actions">
          <button class="inv-btn inv-btn--ghost" bindtap="onPosterClose">关闭</button>
          <button class="inv-btn inv-btn--primary {{ posterLoading || posterSaving ? 'is-disabled' : '' }}" disabled="{{ posterLoading || posterSaving }}" bindtap="onPosterSave">
            {{ posterSaving ? '保存中…' : '保存到相册' }}
          </button>
        </view>
      </view>
    </view>
  </view>
</root-portal>
