@import '../common.wxss';

/* ================================================================
   partner/invitation-list · 开单邀请列表样式
   ================================================================ */

/* ---------- 状态筛选 tabs ---------- */
.inv-tabs {
  display: flex;
  align-items: center;
  background: var(--card-color);
  border-radius: var(--zy-radius-sm);
  border: 1rpx solid var(--lux-hairline);
  margin-bottom: 24rpx;
  padding: 0 8rpx;
}

.inv-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 24rpx 0 20rpx;
  position: relative;
}

.inv-tab--pressed {
  opacity: 0.7;
}

.inv-tab-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  letter-spacing: 2rpx;
}

.inv-tab--on .inv-tab-text {
  color: var(--zy-primary-700);
  font-weight: 600;
}

.inv-tab-underline {
  width: 40rpx;
  height: 4rpx;
  border-radius: var(--lux-radius-pill);
  background: var(--lux-gold-grad);
}

/* ---------- 卡片内容 ---------- */
.inv-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.inv-card-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: 1rpx;
}

.inv-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.inv-info-item {
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 0.5rpx;
}

.inv-info-price {
  color: var(--lux-gold-600);
  font-weight: 600;
}

.inv-note {
  display: block;
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-top: 12rpx;
  line-height: 1.5;
}

/* ---------- 操作按钮 ---------- */
.inv-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
}

.inv-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: var(--lux-radius-pill);
  font-size: 24rpx;
  letter-spacing: 2rpx;
  margin: 0;
  padding: 0;
}

.inv-btn--ghost {
  background: var(--card-color);
  color: var(--text-secondary);
  border: 1rpx solid var(--border-color);
}

.inv-btn--primary {
  background: var(--lux-green-grad);
  color: var(--text-on-primary);
  border: none;
}

.inv-btn--primary.is-disabled {
  opacity: 0.6;
  color: var(--text-on-primary);
  background: var(--lux-green-grad);
}

/* ---------- 空态 ---------- */
.inv-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 48rpx 32rpx;
}

.inv-empty-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: 2rpx;
}

.inv-empty-desc {
  font-size: 24rpx;
  color: var(--text-tertiary);
  text-align: center;
  line-height: 1.6;
}

.inv-empty-btn {
  margin-top: 16rpx;
  width: 320rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: var(--lux-radius-pill);
  background: var(--lux-green-grad);
  color: var(--text-on-primary);
  font-size: 26rpx;
  letter-spacing: 2rpx;
}

/* ---------- 列表尾部 ---------- */
.inv-list-end {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 32rpx 0 180rpx;
}

.inv-list-end-line {
  width: 64rpx;
  height: 1rpx;
  background: var(--border-color);
}

.inv-list-end-text {
  font-size: 22rpx;
  color: var(--text-tertiary);
  letter-spacing: 1rpx;
}

/* ---------- FAB 新建按钮 ---------- */
.inv-root {
  position: relative;
  width: 100%;
  height: 100vh;
}

.inv-fab-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx var(--page-padding) calc(env(safe-area-inset-bottom) + 24rpx);
  background: linear-gradient(180deg, rgba(247,245,239,0) 0%, var(--background-color) 40%);
}

.inv-fab {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: var(--lux-radius-pill);
  background: var(--lux-gold-grad);
  color: var(--text-on-accent);
  font-size: 28rpx;
  letter-spacing: 4rpx;
  font-weight: 600;
  box-shadow: var(--lux-shadow-gold);
  margin: 0;
}

/* ---------- 海报弹层 ---------- */
.inv-poster-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: var(--overlay-color);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.inv-poster-panel {
  width: 620rpx;
  background: var(--card-color);
  border-radius: var(--lux-radius-card);
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  box-shadow: var(--lux-shadow-elevated);
}

.inv-poster-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  text-align: center;
  letter-spacing: 2rpx;
}

.inv-poster-canvas-wrap {
  position: relative;
  width: 100%;
  height: 780rpx;
}

.inv-poster-canvas {
  width: 100%;
  height: 780rpx;
  border-radius: var(--zy-radius-sm);
}

.inv-poster-loading {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0.8);
}

.inv-poster-loading-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  letter-spacing: 2rpx;
}

.inv-poster-actions {
  display: flex;
  gap: 16rpx;
}
