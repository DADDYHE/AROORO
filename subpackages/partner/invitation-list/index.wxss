/* ================================================================
   邀请台账 · invitation-list（2026-09-08 重设计）
   对齐 order-stats / hosting-profile 卷宗语言：
     paper 卷宗头（金 eyebrow + 编辑式数据）+ 状态筛选 + 邀请卡编辑式
   ================================================================ */

.inv-root {
  min-height: 100vh;
  background: var(--background-color, #F7F5EF);
}

.ledger-container {
  padding: 8rpx 48rpx 200rpx;
}

/* ---------- 卷宗头 ---------- */
.ledger-head {
  padding: 44rpx 0 30rpx;
  border-bottom: 1rpx solid var(--hairline);
}

.ledger-eyebrow-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 14rpx;
}

.ledger-accent {
  width: 6rpx;
  height: 26rpx;
  background: var(--accent-color, #C9A24B);
}

.ledger-eyebrow {
  font-size: 19rpx;
  font-weight: 400;
  letter-spacing: 0.32em;
  color: var(--accent-color, #C9A24B);
}

.ledger-title {
  display: block;
  font-size: 44rpx;
  font-weight: 500;
  color: var(--ink-black, #1A1A17);
  letter-spacing: 0.04em;
  line-height: 1.2;
}

.ledger-subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 23rpx;
  letter-spacing: 0.04em;
  color: var(--text-tertiary);
}

.ledger-summary {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-top: 24rpx;
}

.ledger-sum-label {
  font-size: 21rpx;
  letter-spacing: 0.12em;
  color: var(--text-tertiary);
}

.ledger-sum-num {
  font-size: 40rpx;
  font-weight: 300;
  color: var(--primary-color, #1F3A1F);
  line-height: 1;
}

.ledger-sum-unit {
  font-size: 20rpx;
  color: var(--text-tertiary);
}

/* ---------- 状态筛选 tabs ---------- */
.ledger-tabs {
  display: flex;
  gap: 8rpx;
  padding: 26rpx 0 22rpx;
}

.ledger-tab {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--hairline);
  background: transparent;
}

.ledger-tab--on {
  background: var(--primary-color, #1F3A1F);
  border-color: var(--primary-color, #1F3A1F);
}

.ledger-tab--pressed { opacity: 0.7; }

.ledger-tab-text {
  font-size: 23rpx;
  letter-spacing: 0.06em;
  color: var(--text-secondary);
}

.ledger-tab--on .ledger-tab-text {
  color: var(--text-on-primary, #F7F5EF);
}

.ledger-tab-underline { display: none; }

/* ---------- 加载/空态/列表尾 ---------- */
.ledger-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
  gap: 20rpx;
}

.ledger-loading-text {
  font-size: 23rpx;
  letter-spacing: 0.1em;
  color: var(--text-tertiary);
}

.ledger-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 90rpx 40rpx;
  border: 1rpx dashed var(--hairline);
  border-radius: var(--zy-radius-sm, 16rpx);
  background: var(--card-cream, #FBF9F4);
}

.ledger-empty-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.04em;
  margin-bottom: 14rpx;
}

.ledger-empty-desc {
  font-size: 23rpx;
  color: var(--text-tertiary);
  line-height: 1.7;
  text-align: center;
  margin-bottom: 30rpx;
}

.ledger-empty-btn {
  background: var(--lux-green-grad-rich);
  color: var(--text-on-primary, #F7F5EF);
  font-size: 25rpx;
  letter-spacing: 0.1em;
  border-radius: 999rpx;
  padding: 14rpx 52rpx;
  line-height: 1.4;
  margin: 0;
}

button.ledger-empty-btn::after { border: none; }

.ledger-end {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 40rpx 0 20rpx;
}

.ledger-end-line {
  width: 120rpx;
  height: 1rpx;
  background: var(--hairline);
}

.ledger-end-text {
  font-size: 20rpx;
  letter-spacing: 0.14em;
  color: var(--text-tertiary);
}

/* ---------- 邀请卡（编辑式） ---------- */
.inv-card {
  margin-top: 20rpx;
  padding: 30rpx 32rpx;
  border: 1rpx solid var(--hairline);
  border-radius: var(--zy-radius-sm, 16rpx);
  background: var(--card-cream, #FBF9F4);
}

.inv-card--editable {
  border-color: var(--lux-hairline-gold, rgba(201, 162, 75, 0.35));
}

.inv-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.inv-card-title-wrap {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.inv-card-code {
  font-size: 20rpx;
  letter-spacing: 0.18em;
  color: var(--text-tertiary);
}

.inv-card-days {
  font-size: 21rpx;
  color: var(--text-secondary);
}

.inv-status {
  font-size: 20rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.tag-active {
  background: var(--primary-tint, #E8ECE2);
  color: var(--primary-color, #1F3A1F);
}

.tag-filled {
  background: var(--accent-soft, #F0E6D0);
  color: var(--accent-deep, #A8894A);
}

.tag-inactive {
  background: var(--wash-neutral-10, rgba(26, 26, 23, 0.06));
  color: var(--text-tertiary);
}

/* 编辑式主体：日期列 + 价格列 */
.inv-card-body {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.inv-date-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.inv-date-main {
  font-size: 29rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.02em;
}

.inv-date-sub {
  font-size: 22rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.04em;
}

.inv-price-col {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
  flex-shrink: 0;
}

.inv-price-row {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
}

.inv-price-symbol {
  font-size: 22rpx;
  color: var(--accent-deep, #A8894A);
}

.inv-price-num {
  font-size: 40rpx;
  font-weight: 300;
  line-height: 1.1;
  color: var(--text-primary);
}

.inv-price-label {
  font-size: 19rpx;
  letter-spacing: 0.12em;
  color: var(--text-tertiary);
}

.inv-card-note {
  display: block;
  margin-top: 18rpx;
  font-size: 22rpx;
  color: var(--text-tertiary);
  line-height: 1.6;
  padding-top: 16rpx;
  border-top: 1rpx dashed var(--hairline);
}

/* ---------- 操作按钮（品牌化） ---------- */
.inv-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--hairline);
}

.inv-btn {
  font-size: 23rpx;
  letter-spacing: 0.06em;
  border-radius: 999rpx;
  padding: 12rpx 30rpx;
  line-height: 1.4;
  margin: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

button.inv-btn::after { border: none; }

.inv-btn--ghost {
  background: transparent;
  border: 1rpx solid var(--hairline);
  color: var(--text-secondary);
}

.inv-btn--primary {
  background: var(--lux-green-grad-rich);
  color: var(--text-on-primary, #F7F5EF);
  border: none;
}

.is-disabled { opacity: 0.6; }

/* ---------- FAB 新建开单 ---------- */
.inv-fab-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 48rpx calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(247, 245, 239, 0) 0%, var(--background-color, #F7F5EF) 40%);
  z-index: 50;
}

.inv-fab {
  background: var(--lux-green-grad-rich);
  color: var(--text-on-primary, #F7F5EF);
  font-size: 27rpx;
  letter-spacing: 0.12em;
  border-radius: 999rpx;
  line-height: 2.6;
  margin: 0;
  box-shadow: 0 8rpx 30rpx rgba(15, 36, 16, 0.25);
}

button.inv-fab::after { border: none; }

/* ---------- 海报弹层（品牌化） ---------- */
.inv-poster-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: var(--overlay-color, rgba(15, 36, 16, 0.55));
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.inv-poster-panel {
  width: 620rpx;
  background: var(--sheet-paper, #F7F5EF);
  border-radius: 24rpx;
  padding: 36rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.inv-poster-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.06em;
  text-align: center;
}

.inv-poster-canvas-wrap {
  position: relative;
  width: 100%;
  height: 780rpx;
  border-radius: var(--zy-radius-sm, 16rpx);
  overflow: hidden;
}

.inv-poster-canvas { width: 100%; height: 100%; }

.inv-poster-loading {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(247, 245, 239, 0.9);
}

.inv-poster-loading-text {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.inv-poster-actions {
  display: flex;
  gap: 16rpx;
}

.inv-poster-actions .inv-btn { flex: 1; }
