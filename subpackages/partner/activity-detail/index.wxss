/* ================================================================
   AROORO 合伙人活动详情/管理 · 深森林绿 × 香槟金 × 奶油白 高奢风格
   Skyline 兼容：无 :active / transition 仅 transform & opacity / 单行截断
   ================================================================ */
@import '../common.wxss';

/* ============================================
   详情管理页 — Hero + 信息卡 + 报名名单 + 操作栏
   ============================================ */

.page-content {
  padding-bottom: 180rpx;
}

/* ---------- Hero 封面 ---------- */
.hero-section {
  position: relative;
  height: 360rpx;
  overflow: hidden;
  margin: 0 calc(var(--page-padding) * -1);
}

.hero-cover {
  width: 100%;
  height: 100%;
}

.hero-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 160rpx;
  background: linear-gradient(180deg, transparent 0%, var(--scrim-overlay) 100%);
}

/* ---------- 卡片色条 ---------- */
.card-accent {
  width: 3rpx;
  height: 100%;
  position: absolute;
  left: 0;
  top: 0;
  background: var(--primary-color);
}

.card-body {
  position: relative;
  padding: 28rpx 32rpx;
}

/* ---------- 状态行 ---------- */
.status-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.status-badge {
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: var(--zy-radius-sm);
  font-weight: 400;
  letter-spacing: 0.04em;
}

.category-badge {
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: var(--zy-radius-sm);
  background: var(--divider-color);
  color: var(--text-secondary);
  font-weight: 400;
  letter-spacing: 0.04em;
}

/* ---------- 活动标题/描述 ---------- */
.activity-title {
  font-size: 34rpx;
  font-weight: 500;
  color: var(--text-primary);
  display: block;
  margin-bottom: 12rpx;
  line-height: 1.4;
  letter-spacing: 0.02em;
}

.activity-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.7;
  display: block;
  font-weight: 400;
}

/* ---------- 信息网格 ---------- */
.info-grid {
  display: flex;
  gap: 24rpx;
  margin-bottom: 20rpx;
}

.info-grid:last-child {
  margin-bottom: 0;
}

.info-cell {
  flex: 1;
}

.info-label {
  font-size: 22rpx;
  color: var(--text-tertiary);
  display: block;
  margin-bottom: 8rpx;
  letter-spacing: 0.06em;
  font-weight: 400;
}

.info-value {
  font-size: 26rpx;
  color: var(--text-primary);
  display: block;
  font-weight: 400;
}

.price-value {
  color: var(--primary-color);
  font-feature-settings: 'tnum';
}

/* ---------- 分区标题 ---------- */
.section-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.06em;
}

.view-reg-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.view-reg-text {
  font-size: 24rpx;
  color: var(--primary-color);
  font-weight: 400;
}

.view-reg-arrow {
  font-size: 26rpx;
  color: var(--primary-color);
}

/* ---------- 参与者统计 ---------- */
.participant-section {
  margin-top: 8rpx;
}

.participant-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.participant-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 400;
}

.participant-count {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 400;
  font-feature-settings: 'tnum';
}

.participant-bar {
  height: 6rpx;
  background: var(--divider-color);
  border-radius: 3rpx;
  overflow: hidden;
}

.participant-fill {
  height: 100%;
  border-radius: 3rpx;
  background: var(--gradient-primary);
}

/* ---------- 联系信息 ---------- */
.contact-info {
  margin-top: 8rpx;
}

.contact-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--lux-hairline);
}

.contact-row:last-child {
  border-bottom: none;
}

.contact-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 400;
}

.contact-value {
  font-size: 24rpx;
  color: var(--text-primary);
  font-weight: 400;
  max-width: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: right;
}

/* ---------- 图片网格 ---------- */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.image-grid > .image-grid-item {
  flex: 0 0 calc((100% - 24rpx) / 3);
}

.image-grid-item {
  position: relative;
  width: 100%;
  aspect-ratio: 1;
  border-radius: var(--lux-radius-inner);
  overflow: hidden;
}

.grid-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.bottom-spacer {
  height: 40rpx;
}

/* ---------- 底部操作栏 ---------- */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: var(--lux-card-bg);
  border-top: 1rpx solid var(--lux-hairline);
  z-index: 50;
}

.action-btn {
  flex: 1;
  height: 80rpx;
  border-radius: var(--zy-radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.action-btn::after {
  border: none;
}

.action-btn-text {
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 0.06em;
}

.action-btn-edit {
  background: var(--divider-color);
}

.action-btn-edit .action-btn-text {
  color: var(--text-primary);
}

.action-btn-status {
  background: var(--gradient-primary);
  box-shadow: var(--lux-shadow-green);
}

.action-btn-status .action-btn-text {
  color: var(--text-on-primary);
}

.action-btn-full {
  flex: none;
  width: 100%;
}

.action-btn-export {
  background: transparent;
  border: 1rpx solid var(--zy-accent-gold, #C9A24B);
}

.action-btn-export .action-btn-text {
  color: var(--zy-accent-gold, #C9A24B);
}

/* ---------- 报名名单弹层 ---------- */
.reg-list-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--overlay-color);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.reg-list-sheet {
  width: 100%;
  background: var(--lux-card-bg);
  border-radius: var(--zy-radius-2xl) var(--zy-radius-2xl) 0 0;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid var(--lux-hairline);
  box-shadow: var(--lux-shadow-elevated);
}

.reg-list-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--divider-color);
  flex-shrink: 0;
}

.reg-list-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.06em;
}

.reg-list-close {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx;
}

.modal-close-icon {
  width: 32rpx;
  height: 32rpx;
}

.reg-list-body {
  /* Skyline 下 flex:1 + 父级 max-height 会塌缩成 0，给确定高度；sheet 仍 max-height:70vh 兜底 */
  height: calc(70vh - 100rpx);
  padding: 12rpx 0;
  overflow-y: auto;
}

.reg-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid var(--lux-hairline);
}

.reg-item:last-child {
  border-bottom: none;
}

.reg-info {
  flex: 1;
}

.reg-name {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 400;
  display: block;
}

.reg-name-line {
  display: flex;
  align-items: center;
}

.reg-signed-badge {
  margin-left: 12rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  background: var(--success-color);
  flex-shrink: 0;
}

.reg-signed-text {
  font-size: 18rpx;
  color: var(--text-on-primary);
  letter-spacing: 0.06em;
}

.reg-meta {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-top: 4rpx;
  display: block;
  letter-spacing: 0.03em;
}

.reg-counts {
  flex: 0 0 auto;
  padding: 0 16rpx;
}

.reg-count-text {
  font-size: 22rpx;
  color: var(--text-secondary);
  letter-spacing: 0.02em;
  white-space: nowrap;
}

.reg-action {
  padding: 12rpx;
}

.reg-call {
  width: 30rpx;
  height: 30rpx;
}

.reg-empty {
  padding: 80rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-secondary);
  letter-spacing: 0.06em;
}

/* ---------- 导出报名表弹层 ---------- */
.export-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--overlay-color);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.export-sheet {
  width: 100%;
  background: var(--lux-card-bg);
  border-radius: var(--zy-radius-2xl) var(--zy-radius-2xl) 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--lux-hairline);
  box-shadow: var(--lux-shadow-elevated);
}

.export-sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.export-sheet-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.06em;
}

.export-sheet-tip {
  font-size: 22rpx;
  color: var(--text-tertiary);
  display: block;
  margin-bottom: 24rpx;
  letter-spacing: 0.03em;
}

.export-sheet-btn {
  height: 88rpx;
  border-radius: var(--zy-radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  border: 1rpx solid transparent;
}

.export-sheet-btn:last-child {
  margin-bottom: 0;
}

.export-sheet-btn-text {
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 0.06em;
}

.export-sheet-btn-share {
  background: var(--gradient-primary);
  box-shadow: var(--lux-shadow-green);
}

.export-sheet-btn-share .export-sheet-btn-text {
  color: var(--text-on-primary);
}

.export-sheet-btn-save {
  background: transparent;
  border-color: var(--primary-color);
}

.export-sheet-btn-save .export-sheet-btn-text {
  color: var(--primary-color);
}

.export-sheet-btn-copy {
  background: var(--divider-color);
}

.export-sheet-btn-copy .export-sheet-btn-text {
  color: var(--text-primary);
}
