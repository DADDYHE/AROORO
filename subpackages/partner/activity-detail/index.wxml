<zy-navbar title="" transparent color="#F7F5EF" solid="{{_navbarSolid}}" />
<login-prompt visible="{{showLoginPrompt}}" bind:close="onLoginPromptClose" />
<scroll-view
  scroll-y
  enhanced
  refresher-enabled="{{true}}"
  refresher-triggered="{{_refresherTriggered}}"
  bindrefresherrefresh="_onRefresherRefresh"
  bindscrolltolower="_onScrollToLower"
  bindscroll="_onScroll"
  lower-threshold="100"
  style="height: 100vh;"
>
<!-- ═══ B2 · 图片画廊 hero（scroll-view 直接子元素，满幅顶天，恒渲染）；无图降级 B1 ═══ -->
<view class="hero-section" wx:if="{{activity.coverUrl}}">
  <image class="hero-cover" src="{{activity.coverUrl}}" mode="aspectFill" lazy-load />
  <view class="hero-top-scrim"></view>
  <view class="hero-bottom-scrim"></view>
</view>
<view class="lux-hero" wx:else style="padding-top: calc({{_navbarHeight}}px + 24rpx);">
  <text class="lux-hero-eyebrow">ACTIVITY</text>
  <text class="lux-hero-title">{{activity.title || '活动详情'}}</text>
  <text class="lux-hero-sub">{{categoryText || '活动详情'}}</text>
  <view class="lux-hero-sealline"></view>
</view>

<view class="gallery-container">
  <view wx:if="{{isLoading}}" class="loading-container">
    <view class="loading-content">
      <view class="lux-cascade">
  <view class="lux-cascade-dot" style="left: 20rpx; background: #C9A24B; animation-delay: 0ms;"></view>
  <view class="lux-cascade-dot" style="left: 36rpx; background: #A8894A; animation-delay: 150ms;"></view>
  <view class="lux-cascade-dot" style="left: 52rpx; background: #C9A24B; animation-delay: 300ms;"></view>
  <view class="lux-cascade-dot" style="left: 68rpx; background: #A8894A; animation-delay: 450ms;"></view>
  <view class="lux-cascade-dot" style="left: 84rpx; background: #C9A24B; animation-delay: 600ms;"></view>
  <view class="lux-cascade-dot" style="left: 100rpx; background: #A8894A; animation-delay: 750ms;"></view>
  <view class="lux-cascade-dot" style="left: 48rpx; background: #C9A24B; animation-delay: 900ms;"></view>

      </view>
      <text class="loading-text">{{t.BIZ_CSIK0}}</text>
    </view>
  </view>

  <block wx:elif="{{activity}}">
    <view class="ad-body">
      <!-- ═══ 节 1 · 活动（状态标签 + 大标题 + 描述） ═══ -->
      <view class="ad-section">
        <view class="status-row">
          <view class="status-badge" style="background: {{statusColor}}20; color: {{statusColor}}">
            <text>{{statusText}}</text>
          </view>
          <view class="category-badge" wx:if="{{categoryText}}">
            <text>{{categoryText}}</text>
          </view>
        </view>
        <text class="activity-title">{{activity.title}}</text>
        <text class="activity-desc" wx:if="{{activity.description}}">{{activity.description}}</text>
      </view>

      <!-- ═══ 节 2 · 档案信息（台账行线） ═══ -->
      <view class="ad-section">
        <view class="ad-field">
          <text class="ad-field-label">活动日期</text>
          <text class="ad-field-value">{{dateDisplay}}</text>
        </view>
        <view class="ad-field">
          <text class="ad-field-label">活动时间</text>
          <text class="ad-field-value">{{timeDisplay || '待定'}}</text>
        </view>
        <view class="ad-field">
          <text class="ad-field-label">活动地点</text>
          <text class="ad-field-value">{{activity.location || '待定'}}</text>
        </view>
        <view class="ad-field">
          <text class="ad-field-label">活动费用</text>
          <text class="ad-field-value ad-price">{{priceDisplayText}}</text>
        </view>
      </view>

      <!-- ═══ 节 3 · 报名情况 ═══ -->
      <view class="ad-section">
        <view class="section-title-row">
          <text class="section-title">报名情况</text>
          <view class="view-reg-btn" bindtap="onViewRegistrations">
            <text class="view-reg-text">查看名单</text>
            <text class="view-reg-arrow">›</text>
          </view>
        </view>
        <view class="participant-row">
          <text class="participant-label">已报名</text>
          <text class="participant-count">{{regSummaryText}}</text>
        </view>
        <view class="participant-bar" wx:if="{{activity.maxParticipants}}">
          <view class="participant-fill" style="width: {{participantPct}}%; background: {{participantPct >= 100 ? '#C9A24B' : '#1F3A1F'}}"></view>
        </view>
      </view>

      <!-- ═══ 节 4 · 创建者信息 ═══ -->
      <view class="ad-section" wx:if="{{activity.contactName || activity.contactPhone || activity.wechatId}}">
        <text class="section-title">创建者信息</text>
        <view class="contact-info">
          <view class="contact-row" wx:if="{{activity.contactName}}">
            <text class="contact-label">联系人</text>
            <text class="contact-value">{{activity.contactName}}</text>
          </view>
          <view class="contact-row" wx:if="{{activity.contactPhone}}">
            <text class="contact-label">联系电话</text>
            <text class="contact-value">{{activity.contactPhone}}</text>
          </view>
          <view class="contact-row" wx:if="{{activity.wechatId}}">
            <text class="contact-label">微信号</text>
            <text class="contact-value">{{activity.wechatId}}</text>
          </view>
        </view>
      </view>

      <!-- ═══ 节 5 · 活动图片 ═══ -->
      <view class="ad-section" wx:if="{{activity.images && activity.images.length > 0}}">
        <text class="section-title">活动图片 ({{activity.images.length}}张)</text>
        <view class="image-grid">
          <view
            wx:for="{{activity.images}}"
            wx:key="*this"
            class="image-grid-item"
            bindtap="onPreviewImage"
            data-src="{{item}}"
          >
            <image class="grid-image" src="{{item}}" mode="aspectFill" lazy-load />
          </view>
        </view>
      </view>

      <view class="bottom-spacer"></view>
    </view>

    <root-portal>
    <view class="action-bar">
      <view wx:if="{{activity.status === 'draft'}}" class="action-btn action-btn-edit" bindtap="onEdit">
        <text class="action-btn-text">编辑</text>
      </view>
      <view class="action-btn action-btn-status {{activity.status === 'draft' ? '' : 'action-btn-full'}}" bindtap="onChangeStatus">
        <text class="action-btn-text">{{statusActionText}}</text>
      </view>
      <view class="action-btn action-btn-export action-btn-full" bindtap="onExportRegistrations">
        <text class="action-btn-text">导出报名表</text>
      </view>
    </view>
    </root-portal>
  </block>

  <root-portal>
  <view class="reg-list-mask" wx:if="{{showRegList}}" bindtap="onCloseRegList">
    <view class="reg-list-sheet" catchtap="">
      <view class="reg-list-header">
        <text class="reg-list-title">报名名单（{{regSummary.totalGroups}}组）</text>
        <view class="reg-list-close" bindtap="onCloseRegList">
          <image src="/images/icons/close-luxury-line.svg" mode="aspectFit" class="modal-close-icon"></image>
        </view>
      </view>
      <scroll-view scroll-y class="reg-list-body">
        <view class="reg-item" wx:for="{{registrations}}" wx:key="_id">
          <view class="reg-info">
            <view class="reg-name-line">
              <text class="reg-name">{{item.contactName || item.displayName || item.userNickName || '未知'}}</text>
              <view wx:if="{{item.signInStatus === 'signed'}}" class="reg-signed-badge">
                <text class="reg-signed-text">已签到</text>
              </view>
            </view>
            <text class="reg-meta">{{item.contactPhone || ''}}</text>
          </view>
          <view class="reg-counts">
            <text class="reg-count-text">宠物{{item.petCount}}只，人数{{item.participantCount}}人</text>
          </view>
          <view class="reg-action" wx:if="{{item.contactPhone}}" bindtap="onCallParticipant" data-phone="{{item.contactPhone}}">
            <image class="reg-call" src="/images/icons/phone-luxury-line.svg" mode="aspectFit"></image>
          </view>
        </view>
        <view class="reg-empty" wx:if="{{registrations.length === 0}}">
          <text>暂无报名</text>
        </view>
      </scroll-view>
    </view>
  </view>
  </root-portal>

  <root-portal>
  <view class="export-mask" wx:if="{{showExportSheet}}" bindtap="onCloseExportSheet">
    <view class="export-sheet" catchtap="">
      <view class="export-sheet-header">
        <text class="export-sheet-title">导出报名表</text>
        <view class="export-sheet-close" bindtap="onCloseExportSheet">
          <image src="/images/icons/close-luxury-line.svg" mode="aspectFit" class="modal-close-icon"></image>
        </view>
      </view>
      <text class="export-sheet-tip">CSV 含表头与全部报名信息，选择导出方式</text>
      <view class="export-sheet-btn export-sheet-btn-share" bindtap="onExportShare">
        <text class="export-sheet-btn-text">转发到微信</text>
      </view>
      <view class="export-sheet-btn export-sheet-btn-save" bindtap="onExportSave">
        <text class="export-sheet-btn-text">保存到本机（PC）</text>
      </view>
      <view class="export-sheet-btn export-sheet-btn-copy" bindtap="onExportCopy">
        <text class="export-sheet-btn-text">复制内容</text>
      </view>
    </view>
  </view>
  </root-portal>
</view>
</scroll-view>
