@import '../common.wxss';

.filter-section {
  background: var(--background-color);
  position: sticky;
  top: 0;
  z-index: 10;
  padding-bottom: 8rpx;
}

.tab-row {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 32rpx 16rpx;
  gap: 12rpx;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 14rpx 0;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  background: var(--card-color);
  position: relative;
  transition: all 0.3s;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  flex: 1;
}

.tab-active {
  background: linear-gradient(135deg, var(--activity-primary) 0%, var(--activity-primary-mid) 100%);
  color: var(--card-color);
  box-shadow: 0 4rpx 16rpx rgba(78, 205, 196, 0.3);
}

.tab-text {
  font-weight: 500;
  letter-spacing: 2rpx;
}

.tab-indicator {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--card-color);
  margin-top: 8rpx;
  animation: dotPulse 1.5s ease-in-out infinite;
}

.search-bar {
  padding: 0 32rpx 20rpx;
  transition: all 0.3s;
}

.search-focused {
  padding: 0 24rpx 20rpx;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  height: 76rpx;
  padding: 0 20rpx;
  background: var(--card-color);
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  gap: 12rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.search-focused .search-input-wrap {
  border-color: rgba(78, 205, 196, 0.4);
  box-shadow: 0 4rpx 20rpx rgba(78, 205, 196, 0.12);
}

.search-icon-wrap {
  width: 32rpx;
  height: 32rpx;
  position: relative;
  flex-shrink: 0;
}

.search-icon-circle {
  width: 20rpx;
  height: 20rpx;
  border: 3rpx solid var(--text-tertiary);
  border-radius: 50%;
  position: absolute;
  top: 2rpx;
  left: 2rpx;
}

.search-icon-stem {
  width: 10rpx;
  height: 3rpx;
  background: var(--text-tertiary);
  position: absolute;
  bottom: 4rpx;
  right: 0;
  transform: rotate(45deg);
  border-radius: 2rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-primary);
  height: 76rpx;
}

.search-placeholder {
  color: var(--text-tertiary);
  font-size: 26rpx;
}

.search-clear {
  flex-shrink: 0;
  padding: 4rpx;
}

.clear-circle {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--gray-200);
  display: flex;
  align-items: center;
  justify-content: center;
}

.clear-x {
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1;
}

.search-btn {
  padding: 12rpx 28rpx;
  background: linear-gradient(135deg, var(--activity-primary) 0%, var(--activity-primary-mid) 100%);
  border-radius: 12rpx;
  flex-shrink: 0;
}

.search-btn-text {
  font-size: 24rpx;
  color: var(--card-color);
  font-weight: 500;
  letter-spacing: 2rpx;
}

.card-hover {
  transform: scale(0.98);
  box-shadow: 0 1rpx 8rpx rgba(0, 0, 0, 0.06);
}

.card-accent {
  width: 4rpx;
  height: 100%;
  position: absolute;
  left: 0;
  top: 0;
  background: linear-gradient(180deg, var(--activity-primary) 0%, var(--activity-primary-mid) 100%);
  border-radius: 0 4rpx 4rpx 0;
}

.card-accent-draft {
  background: linear-gradient(180deg, var(--text-secondary) 0%, var(--text-tertiary) 100%);
}

.card-accent-published {
  background: linear-gradient(180deg, var(--activity-primary) 0%, var(--activity-primary-mid) 100%);
}

.card-accent-registration_stopped {
  background: linear-gradient(180deg, var(--warning-color) 0%, #FFCC00 100%);
}

.card-accent-ended {
  background: linear-gradient(180deg, var(--text-tertiary) 0%, var(--gray-200) 100%);
}

.card-accent-cancelled {
  background: linear-gradient(180deg, var(--error-color) 0%, var(--tuan-primary) 100%);
}

.card-body {
  position: relative;
  padding: 32rpx 36rpx;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
}

.card-status {
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.status-draft {
  background: var(--divider-color);
  color: var(--text-secondary);
}

.status-published {
  background: rgba(78, 205, 196, 0.12);
  color: var(--activity-primary-mid);
}

.status-registration_stopped {
  background: rgba(255, 149, 0, 0.12);
  color: var(--warning-color);
}

.status-ended {
  background: rgba(142, 142, 147, 0.12);
  color: var(--text-secondary);
}

.status-cancelled {
  background: rgba(255, 59, 48, 0.12);
  color: var(--error-color);
}

.card-info {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.card-info-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.info-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--activity-primary);
  flex-shrink: 0;
}

.info-dot-location {
  background: var(--warning-color);
}

.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--divider-color);
}

.card-participants {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
}

.card-stat-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  white-space: nowrap;
}

.card-stat {
  font-size: 22rpx;
  color: var(--text-secondary);
  white-space: nowrap;
}

.card-prices {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.card-price {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--activity-primary);
}

.card-price-pet {
  color: var(--warning-color);
}

.card-free {
  color: var(--success-color);
  font-size: 22rpx;
}
.empty-illustration {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 32rpx;
}

.empty-circle {
  width: 120rpx;
  height: 120rpx;
  border: 2rpx solid var(--gray-200);
  border-radius: 50%;
}

.empty-line-decor {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 40rpx;
  height: 2rpx;
  background: var(--text-tertiary);
}

.empty-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  letter-spacing: 4rpx;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 22rpx;
  color: var(--text-tertiary);
  letter-spacing: 2rpx;
  margin-bottom: 32rpx;
}

.empty-action {
  padding: 16rpx 48rpx;
  border: 2rpx solid var(--activity-primary);
  border-radius: 16rpx;
}

.empty-action-text {
  font-size: 24rpx;
  color: var(--activity-primary);
  font-weight: 500;
  letter-spacing: 4rpx;
}

.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 40rpx 0;
}
.list-end {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 48rpx 0 32rpx;
}

.list-end-line {
  flex: 1;
  height: 1rpx;
  background: var(--gray-200);
}

.list-end-text {
  font-size: 20rpx;
  color: var(--text-tertiary);
  letter-spacing: 4rpx;
}

.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: calc(env(safe-area-inset-bottom) + 60rpx);
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--activity-primary) 0%, var(--activity-primary-mid) 100%);
  box-shadow: 0 8rpx 32rpx rgba(78, 205, 196, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  transition: all 0.2s;
}

.fab-hover {
  transform: scale(0.9) rotate(90deg);
  box-shadow: 0 4rpx 16rpx rgba(78, 205, 196, 0.3);
}

.fab-icon-line {
  width: 40rpx;
  height: 4rpx;
  background: var(--card-color);
  border-radius: 2rpx;
  position: absolute;
}

.fab-icon-vertical {
  transform: rotate(90deg);
}

@keyframes dotPulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

.hall-refreshing {
  position: relative;
}

.card-fading {
  opacity: 0.35;
  transition: opacity 0.2s ease-out;
  pointer-events: none;
}

.refresh-indicator {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 32rpx 0;
}

.refresh-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--activity-primary);
  animation: dotBounce 1.4s ease-in-out infinite;
}

.refresh-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.refresh-dot:nth-child(3) {
  animation-delay: 0.4s;
}
