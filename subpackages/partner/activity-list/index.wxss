/* ================================================================
   AROORO 合伙人活动管理列表 · 深森林绿 × 香槟金 × 奶油白 高奢风格
   Skyline 兼容：无 :active / transition 仅 transform & opacity / 单行截断
   ================================================================ */
@import '../common.wxss';

/* ============================================
   管理列表页 — Tab筛选 + 搜索 + 卡片列表 + FAB
   ============================================ */

/* ---------- 筛选吸顶区（停靠在导航栏下方） ---------- */
.filter-section {
  position: sticky;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  padding-bottom: 8rpx;
}

/* ---------- Tab 行 ---------- */
.tab-row {
  display: flex;
  justify-content: space-between;
  padding: 24rpx var(--page-padding) 16rpx;
  gap: 12rpx;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 14rpx 0;
  border-radius: var(--lux-radius-inner);
  font-size: 24rpx;
  color: var(--text-secondary);
  background: var(--lux-card-bg);
  position: relative;
  border: 1rpx solid var(--lux-hairline);
  flex: 1;
  font-weight: 400;
  letter-spacing: 0.03em;
}

.tab-active {
  background: var(--gradient-primary);
  color: var(--text-on-primary);
  border-color: transparent;
  box-shadow: var(--lux-shadow-green);
}

.tab-text {
  font-weight: 500;
  letter-spacing: 0.06em;
}

.tab-indicator {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: var(--text-on-primary);
  margin-top: 6rpx;
}

/* ---------- 搜索栏 ---------- */
.search-bar {
  padding: 0 var(--page-padding) 20rpx;
}

.search-focused {
  padding: 0 32rpx 20rpx;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 0 20rpx;
  background: var(--lux-card-bg);
  border-radius: var(--lux-radius-card);
  border: 1rpx solid var(--lux-hairline);
  gap: 12rpx;
  box-shadow: var(--lux-shadow-card);
}

.search-focused .search-input-wrap {
  border-color: var(--primary-soft);
}

.search-icon-wrap {
  width: 32rpx;
  height: 32rpx;
  position: relative;
  flex-shrink: 0;
}

.search-icon-circle {
  width: 18rpx;
  height: 18rpx;
  border: 2rpx solid var(--text-tertiary);
  border-radius: 50%;
  position: absolute;
  top: 2rpx;
  left: 2rpx;
}

.search-icon-stem {
  width: 10rpx;
  height: 2rpx;
  background: var(--text-tertiary);
  position: absolute;
  bottom: 6rpx;
  right: 0;
  transform: rotate(45deg);
  border-radius: 2rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-primary);
  height: 72rpx;
  font-family: inherit;
}

.search-placeholder {
  color: var(--text-tertiary);
  font-size: 26rpx;
}

.search-clear {
  flex-shrink: 0;
  padding: 4rpx;
}

.clear-circle {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: var(--divider-color);
  display: flex;
  align-items: center;
  justify-content: center;
}

.clear-x {
  font-size: 20rpx;
  color: var(--text-secondary);
  line-height: 1;
}

.search-btn {
  padding: 12rpx 28rpx;
  background: var(--gradient-primary);
  border-radius: var(--lux-radius-inner);
  flex-shrink: 0;
}

.search-btn-text {
  font-size: 24rpx;
  color: var(--text-on-primary);
  font-weight: 500;
  letter-spacing: 0.06em;
}

/* ---------- 活动卡片色条 ---------- */
.card-accent {
  width: 3rpx;
  height: 100%;
  position: absolute;
  left: 0;
  top: 0;
  background: var(--primary-color);
  border-radius: 0 3rpx 3rpx 0;
}

.card-accent-draft {
  background: var(--text-tertiary);
}

.card-accent-published {
  background: var(--primary-color);
}

.card-accent-registration_stopped {
  background: var(--warning-color);
}

.card-accent-ended {
  background: var(--text-tertiary);
}

.card-accent-cancelled {
  background: var(--error-color);
}

.card-body {
  position: relative;
  padding: 32rpx 36rpx;
}

/* ---------- 卡片头部 ---------- */
.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
  letter-spacing: 0.02em;
}

.card-status {
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: var(--zy-radius-sm);
  font-weight: 400;
  flex-shrink: 0;
  letter-spacing: 0.04em;
}

.status-draft {
  background: var(--wash-neutral-10);
  color: var(--text-tertiary);
}

.status-published {
  background: var(--primary-tint-08);
  color: var(--primary-color);
}

.status-registration_stopped {
  background: var(--mall-tint);
  color: var(--primary-color);  /* B′ 金在浅底不作文字色：原 --warning-color → 深绿（同 .status-published） */
}

.status-ended {
  background: var(--wash-neutral-10);
  color: var(--text-secondary);
}

.status-cancelled {
  background: var(--wash-error-08);
  color: var(--error-color);
}

/* ---------- 卡片信息 ---------- */
.card-info {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.card-info-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
  letter-spacing: 0.01em;
}

.info-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: var(--primary-color);
  flex-shrink: 0;
}

.info-dot-location {
  background: var(--warning-color);
}

/* ---------- 卡片底部 ---------- */
.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--lux-hairline);
}

.card-participants {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
}

.card-stat-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  white-space: nowrap;
}

.card-stat {
  font-size: 22rpx;
  color: var(--text-secondary);
  white-space: nowrap;
  font-feature-settings: 'tnum';
}

.card-prices {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.card-price {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--primary-color);
  font-feature-settings: 'tnum';
}

.card-price-pet {
  color: var(--primary-color);  /* B′ 金在浅底不作文字色：原 --warning-color → 深绿（同 .card-price） */
}

.card-free {
  color: var(--success-color);
  font-size: 22rpx;
  font-weight: 400;
}

/* ---------- 空状态 ---------- */
.empty-illustration {
  position: relative;
  width: 100rpx;
  height: 100rpx;
  margin: 0 auto 24rpx;
}

.empty-circle {
  width: 100rpx;
  height: 100rpx;
  border: 1rpx solid var(--border-color);
  border-radius: 50%;
}

.empty-line-decor {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 32rpx;
  height: 2rpx;
  background: var(--accent-color);
}

.empty-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  letter-spacing: 0.16em;
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 22rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.06em;
  margin-bottom: 32rpx;
}

.empty-action {
  display: inline-flex;
  padding: 14rpx 44rpx;
  border: 1rpx solid var(--primary-color);
  border-radius: var(--lux-radius-pill);
}

.empty-action-text {
  font-size: 24rpx;
  color: var(--primary-color);
  font-weight: 400;
  letter-spacing: 0.16em;
}

/* ---------- 加载/列表尾 ---------- */
.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 40rpx 0;
}

.list-end {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 48rpx 0 32rpx;
}

.list-end-line {
  flex: 1;
  height: 1rpx;
  background: var(--divider-color);
}

.list-end-text {
  font-size: 20rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.16em;
}

/* ---------- 悬浮新建按钮 ---------- */
.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: calc(env(safe-area-inset-bottom) + 60rpx);
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: var(--gradient-primary);
  box-shadow: var(--lux-shadow-fab);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.fab-icon-line {
  width: 36rpx;
  height: 3rpx;
  background: var(--text-on-primary);
  border-radius: 2rpx;
  position: absolute;
}

.fab-icon-vertical {
  transform: rotate(90deg);
}

/* ---------- 下拉刷新 ---------- */
.refresh-indicator {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 32rpx 0;
}

.refresh-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--primary-color);
}

.refresh-dot:nth-child(2) {
  opacity: 0.6;
}

.refresh-dot:nth-child(3) {
  opacity: 0.3;
}
