/* ================================================================
   pay-loading · 全局支付 loading（变体 A：暖墨遮罩 + 金点波浪）
   常驻节点 + visibility/opacity/transform 过渡（显示零重建延迟）；
   非显示态 visibility:hidden + pointer-events:none（不挡页面）；
   动效只用 opacity/transform（Skyline 兼容）
   ================================================================ */
.pay-loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(26, 26, 23, 0.22);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  visibility: hidden;
  opacity: 0;
  transform: translateY(8%);
  pointer-events: none;
  transition:
    opacity 260ms cubic-bezier(0.22, 1, 0.36, 1),
    transform 260ms cubic-bezier(0.22, 1, 0.36, 1),
    visibility 260ms;
}

.pay-loading-mask--on {
  visibility: visible;
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.pay-loading-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 28rpx;
}

/* 金点波浪（lux-cascade 同款，Skyline 已验证） */
.pay-loading-dots {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 68rpx;
}

.pay-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: #C9A24B;
  animation: pay-dot-wave 1.2s ease-in-out infinite;
}

.pay-dot:nth-child(2) { animation-delay: 150ms; }
.pay-dot:nth-child(3) { animation-delay: 300ms; }
.pay-dot:nth-child(4) { animation-delay: 450ms; }
.pay-dot:nth-child(5) { animation-delay: 600ms; }

@keyframes pay-dot-wave {
  0%, 80%, 100% { transform: translateY(0); opacity: 0.4; }
  40% { transform: translateY(-12rpx); opacity: 1; }
}

.pay-loading-text {
  font-size: 24rpx;
  color: #F7F5EF;
  letter-spacing: 3rpx;
}
