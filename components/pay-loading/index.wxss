.pay-loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(26, 26, 23, 0.22);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pay-loading-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 28rpx;
}

.pay-loading-ring {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  border: 5rpx solid rgba(201, 162, 75, 0.25);
  border-top-color: #C9A24B;
  animation: pay-ring-spin 0.9s linear infinite;
}

@keyframes pay-ring-spin {
  to { transform: rotate(360deg); }
}

.pay-loading-text {
  font-size: 24rpx;
  color: #F7F5EF;
  letter-spacing: 3rpx;
}
