.pay-loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(26, 26, 23, 0.22);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 遮罩从底部浮升 + 淡入：支付按钮几乎总在页面底部，
     整层自下浮升 ≈ "从按钮区域升起"的视觉连续性（零坐标，全局生效） */
  opacity: 0;
  transform: translateY(8%);
  animation: pay-mask-in 260ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
}

@keyframes pay-mask-in {
  from { opacity: 0; transform: translateY(8%); }
  to { opacity: 1; transform: translateY(0); }
}

.pay-loading-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 28rpx;
}

/* ring-wrap：入场弹入（scale 0.6→1 轻回弹）；旋转在内层 ring，避免 transform 冲突 */
.pay-loading-ring-wrap {
  width: 68rpx;
  height: 68rpx;
  opacity: 0;
  transform: scale(0.6);
  animation: pay-ring-in 260ms cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

@keyframes pay-ring-in {
  from { opacity: 0; transform: scale(0.6); }
  to { opacity: 1; transform: scale(1); }
}

.pay-loading-ring {
  width: 68rpx;
  height: 68rpx;
  /* Skyline：百分比圆角 + 多色 border 渲染异常（显示为旋转矩形）→ 用绝对值圆角 */
  border-radius: 34rpx;
  border: 5rpx solid rgba(201, 162, 75, 0.25);
  border-top-color: #C9A24B;
  animation: pay-ring-spin 0.9s linear infinite;
}

@keyframes pay-ring-spin {
  to { transform: rotate(360deg); }
}

.pay-loading-text {
  font-size: 24rpx;
  color: #F7F5EF;
  letter-spacing: 3rpx;
  opacity: 0;
  transform: translateY(6rpx);
  animation: pay-text-in 240ms ease-out 120ms forwards;
}

@keyframes pay-text-in {
  from { opacity: 0; transform: translateY(6rpx); }
  to { opacity: 1; transform: translateY(0); }
}
