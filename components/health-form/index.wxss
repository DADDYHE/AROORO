/* ================================================================
   components/health-form · 健康信息表单样式
   设计语言与 theme-teal 对齐：林绿主色 + 香槟金点缀 + 奶油底
   Skyline 兼容：transition 仅 transform/opacity，无 clip-path
   ================================================================ */

.hf {
  background: var(--card-color);
  border-radius: var(--lux-radius-inner);
  border: 1rpx solid var(--lux-hairline);
  overflow: hidden;
}

/* ---------- 折叠头 ---------- */
.hf-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
}

.hf-head--pressed {
  opacity: 0.7;
}

.hf-head-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.hf-head-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: 1rpx;
}

.hf-head-sub {
  font-size: 22rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.5rpx;
}

.hf-head-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.hf-head-toggle {
  font-size: 22rpx;
  color: var(--zy-primary-500);
  letter-spacing: 1rpx;
}

.hf-head-arrow {
  width: 14rpx;
  height: 14rpx;
  border-right: 2rpx solid var(--zy-primary-500);
  border-bottom: 2rpx solid var(--zy-primary-500);
  transform: rotate(45deg);
  transition: transform 0.2s ease;
  margin-top: -6rpx;
}

.hf-head-arrow--up {
  transform: rotate(225deg);
  margin-top: 6rpx;
}

/* ---------- 表单主体 ---------- */
.hf-body {
  padding: 8rpx 32rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.hf-field {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.hf-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 1rpx;
}

.hf-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hf-textarea {
  width: auto;
  min-height: 120rpx;
  padding: 20rpx 24rpx;
  background: var(--gray-50);
  border-radius: var(--zy-radius-sm);
  font-size: 26rpx;
  color: var(--text-primary);
  line-height: 1.6;
  border: 1rpx solid var(--border-soft);
}

.hf-ph {
  color: var(--gray-400);
}

/* ---------- 选择器 ---------- */
.hf-picker {
  background: var(--gray-50);
  border-radius: var(--zy-radius-sm);
  border: 1rpx solid var(--border-soft);
}

.hf-picker-value {
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  color: var(--text-primary);
}

/* ---------- 疫苗记录 ---------- */
.hf-vaccine-add {
  padding: 6rpx 20rpx;
  border-radius: var(--lux-radius-pill);
  background: var(--primary-tint);
}

.hf-vaccine-add--pressed {
  opacity: 0.7;
}

.hf-vaccine-add-text {
  font-size: 22rpx;
  color: var(--zy-primary-700);
  letter-spacing: 1rpx;
}

.hf-vaccine-empty {
  padding: 20rpx 24rpx;
  background: var(--gray-50);
  border-radius: var(--zy-radius-sm);
  border: 1rpx solid var(--border-soft);
}

.hf-vaccine-empty-text {
  font-size: 22rpx;
  color: var(--gray-400);
}

.hf-vaccine-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.hf-vaccine-name {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  background: var(--gray-50);
  border-radius: var(--zy-radius-sm);
  border: 1rpx solid var(--border-soft);
  font-size: 24rpx;
  color: var(--text-primary);
}

.hf-vaccine-picker {
  width: 220rpx;
  height: 72rpx;
  background: var(--gray-50);
  border-radius: var(--zy-radius-sm);
  border: 1rpx solid var(--border-soft);
}

.hf-vaccine-date {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 20rpx;
  font-size: 24rpx;
  color: var(--text-primary);
}

.hf-vaccine-date--ph {
  color: var(--gray-400);
}

.hf-vaccine-del {
  padding: 12rpx 16rpx;
}

.hf-vaccine-del-text {
  font-size: 22rpx;
  color: var(--brand-red);
  letter-spacing: 1rpx;
}
