<!-- ================================================================
     components/health-form · 宠物健康信息表单
     字段顺序（2026-09-08 DADDY 定）：既往病史 / 药品使用 / 保健品使用 /
     绝育情况 / 疫苗情况（已接种/未接种）/ 过敏源 / 行为习惯备注
     三字段（病史/药品/保健品）为是/否+详情结构
     ================================================================ -->
<view class="hf">
  <view class="hf-head" bindtap="onToggle" hover-class="hf-head--pressed" hover-stay-time="80">
    <view class="hf-head-left">
      <text class="hf-head-title">健康信息</text>
      <text class="hf-head-sub">病史 · 用药 · 保健品 · 疫苗等</text>
    </view>
    <view class="hf-head-right">
      <text class="hf-head-toggle">{{ expanded ? '收起' : '展开' }}</text>
      <view class="hf-head-arrow {{ expanded ? 'hf-head-arrow--up' : '' }}"></view>
    </view>
  </view>

  <view wx:if="{{ expanded }}" class="hf-body">
    <view class="hf-field">
      <view class="hf-label-row">
        <text class="hf-label">既往病史</text>
        <view class="hf-yesno">
          <view class="hf-yn {{ medicalHistory.has === 'yes' ? 'hf-yn--on' : '' }}" data-field="medicalHistory" data-val="yes" bindtap="onHasToggle"><text class="hf-yn-text">是</text></view>
          <view class="hf-yn {{ medicalHistory.has === 'no' ? 'hf-yn--on' : '' }}" data-field="medicalHistory" data-val="no" bindtap="onHasToggle"><text class="hf-yn-text">否</text></view>
        </view>
      </view>
      <textarea
        wx:if="{{ medicalHistory.has === 'yes' }}"
        class="hf-textarea"
        value="{{ medicalHistory.detail }}"
        maxlength="500"
        placeholder="请填写病史详情以及注意事项"
        placeholder-class="hf-ph"
        bindinput="onYesDetailInput"
        data-field="medicalHistory"
      />
    </view>

    <view class="hf-field">
      <view class="hf-label-row">
        <text class="hf-label">药品使用</text>
        <view class="hf-yesno">
          <view class="hf-yn {{ medications.has === 'yes' ? 'hf-yn--on' : '' }}" data-field="medications" data-val="yes" bindtap="onHasToggle"><text class="hf-yn-text">是</text></view>
          <view class="hf-yn {{ medications.has === 'no' ? 'hf-yn--on' : '' }}" data-field="medications" data-val="no" bindtap="onHasToggle"><text class="hf-yn-text">否</text></view>
        </view>
      </view>
      <textarea
        wx:if="{{ medications.has === 'yes' }}"
        class="hf-textarea"
        value="{{ medications.detail }}"
        maxlength="500"
        placeholder="请填写用药详情（药品名称、剂量、频率）"
        placeholder-class="hf-ph"
        bindinput="onYesDetailInput"
        data-field="medications"
      />
    </view>

    <view class="hf-field">
      <view class="hf-label-row">
        <text class="hf-label">保健品使用</text>
        <view class="hf-yesno">
          <view class="hf-yn {{ supplements.has === 'yes' ? 'hf-yn--on' : '' }}" data-field="supplements" data-val="yes" bindtap="onHasToggle"><text class="hf-yn-text">是</text></view>
          <view class="hf-yn {{ supplements.has === 'no' ? 'hf-yn--on' : '' }}" data-field="supplements" data-val="no" bindtap="onHasToggle"><text class="hf-yn-text">否</text></view>
        </view>
      </view>
      <textarea
        wx:if="{{ supplements.has === 'yes' }}"
        class="hf-textarea"
        value="{{ supplements.detail }}"
        maxlength="500"
        placeholder="请填写保健品使用详情（如卵磷脂、鱼油、益生菌）"
        placeholder-class="hf-ph"
        bindinput="onYesDetailInput"
        data-field="supplements"
      />
    </view>

    <view class="hf-field">
      <view class="hf-label-row">
        <text class="hf-label">疫苗情况</text>
        <view class="hf-yesno">
          <view class="hf-yn {{ vaccinated === 'yes' ? 'hf-yn--on' : '' }}" data-val="yes" bindtap="onVacToggle"><text class="hf-yn-text">已接种</text></view>
          <view class="hf-yn {{ vaccinated === 'no' ? 'hf-yn--on' : '' }}" data-val="no" bindtap="onVacToggle"><text class="hf-yn-text">未接种</text></view>
        </view>
      </view>
    </view>

    <view class="hf-field">
      <text class="hf-label">绝育情况</text>
      <picker mode="selector" range="{{ neuteredOptions }}" range-key="label" bindchange="onNeuteredChange" class="hf-picker">
        <view class="hf-picker-value">{{ neuteredLabel }}</view>
      </picker>
    </view>

    <view class="hf-field">
      <text class="hf-label">过敏源</text>
      <textarea
        class="hf-textarea"
        value="{{ allergies }}"
        maxlength="500"
        placeholder="如对特定食物、药物、花粉过敏，无过敏可填「无」"
        placeholder-class="hf-ph"
        bindinput="onFieldInput"
        data-field="allergies"
      />
    </view>

    <view class="hf-field">
      <text class="hf-label">行为习惯备注</text>
      <textarea
        class="hf-textarea"
        value="{{ behaviorNotes }}"
        maxlength="500"
        placeholder="如怕生、护食、拆家、分离焦虑、与其他宠物相处情况等"
        placeholder-class="hf-ph"
        bindinput="onFieldInput"
        data-field="behaviorNotes"
      />
    </view>
  </view>
</view>