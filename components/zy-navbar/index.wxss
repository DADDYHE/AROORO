/* ================================================================
   components/zy-navbar · Haute-Luxury Navigation Bar
   ----------------------------------------------------------------
   高奢 Navbar：透明/纯色双模式，极简返回箭头，品牌字距
   ================================================================ */

.zy-navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: transparent;
  animation-name: navbar-fade-in;
  animation-duration: 600ms;
  animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  animation-fill-mode: forwards;
}

.zy-navbar--solid {
  background: rgba(247, 245, 239, 0.92);
  border-bottom: 1rpx solid rgba(26, 26, 23, 0.05);
}

@keyframes navbar-fade-in {
  0% { opacity: 0; transform: translateY(-8rpx); }
  100% { opacity: 1; transform: translateY(0); }
}

.zy-navbar__content {
  display: flex;
  align-items: center;
  padding: 0 12rpx;
  height: 88rpx;
}

/* 返回按钮（极简线条） */
.zy-navbar__left {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding: 20rpx;
  flex-shrink: 0;
  min-width: 88rpx;
  min-height: 88rpx;
  transition: transform 200ms cubic-bezier(0.25, 0.1, 0.25, 1),
              opacity 200ms cubic-bezier(0.25, 0.1, 0.25, 1);
}

.zy-navbar__left--pressed {
  transform: scale(0.88);
  opacity: 0.6;
}

.zy-navbar__back-icon {
  width: 18rpx;
  height: 18rpx;
  /* 带 fallback：简写内的 var() 若解析失败会令整条声明 unset（border-style 变 none → 箭头消失）。
     组件在 <root-portal> 内，变量继承不保证，故必须兜底。实际颜色由 wxml 内联 border-color 覆盖。 */
  border-left: 3rpx solid var(--text-primary, #1A1A17);
  border-bottom: 3rpx solid var(--text-primary, #1A1A17);
  transform: rotate(45deg);
  transition-property: border-color;
  transition-duration: 240ms;
  transition-timing-function: cubic-bezier(0.19, 1, 0.22, 1);
}

.zy-navbar__title {
  flex: 1;
  text-align: center;
  overflow: hidden;
  pointer-events: none;
}

.zy-navbar__title-text {
  font-size: 32rpx;
  font-weight: 500;
  letter-spacing: 0.05em;
  /* 必须 inherit：颜色由父级 .zy-navbar__title 的内联 color={{color}} 提供。
     这里若写死 color（哪怕是 var(--text-primary)），会覆盖父级内联值，
     导致 color prop 完全失效 —— 深色导航栏上标题永远渲成黑字。
     另注：本组件在 <root-portal> 内、且未自引令牌文件，var() 能否解析不确定，故不用变量。 */
  color: inherit;
  animation-name: title-reveal;
  animation-duration: 700ms;
  animation-timing-function: cubic-bezier(0.19, 1, 0.22, 1);
  animation-delay: 200ms;
  animation-fill-mode: forwards;
}

@keyframes title-reveal {
  0% { opacity: 0; transform: translateY(8rpx); }
  100% { opacity: 1; transform: translateY(0); }
}

.zy-navbar__right {
  flex-shrink: 0;
  min-width: 88rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 20rpx;
  transition: transform 200ms cubic-bezier(0.25, 0.1, 0.25, 1),
              opacity 200ms cubic-bezier(0.25, 0.1, 0.25, 1);
}

.zy-navbar__right--pressed {
  transform: scale(0.9);
  opacity: 0.6;
}

/* 无返回键时的左侧占位：与右侧胶囊占位（.zy-navbar__right）等宽，
   尺寸规则完全一致以保证左右对称，使 flex:1 的标题落在屏幕正中。
   不依赖 box-sizing —— 两侧用同一套 min-width/padding/inline-width 即天然对称。 */
.zy-navbar__spacer {
  flex-shrink: 0;
  min-width: 88rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 20rpx;
}
