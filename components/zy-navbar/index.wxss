/* ================================================================
   components/zy-navbar · Haute-Luxury Navigation Bar
   ----------------------------------------------------------------
   高奢 Navbar：透明/纯色双模式，极简返回箭头，品牌字距
   ================================================================ */

.zy-navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: transparent;
  animation-name: navbar-fade-in;
  animation-duration: 600ms;
  animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  animation-fill-mode: forwards;
}

.zy-navbar--solid {
  background: rgba(247, 245, 239, 0.92);
  border-bottom: 1rpx solid rgba(26, 26, 23, 0.05);
}

@keyframes navbar-fade-in {
  0% { opacity: 0; transform: translateY(-8rpx); }
  100% { opacity: 1; transform: translateY(0); }
}

.zy-navbar__content {
  display: flex;
  align-items: center;
  padding: 0 12rpx;
  height: 88rpx;
}

/* 返回按钮（极简线条） */
.zy-navbar__left {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding: 20rpx;
  flex-shrink: 0;
  min-width: 88rpx;
  min-height: 88rpx;
  transition: transform 200ms cubic-bezier(0.25, 0.1, 0.25, 1),
              opacity 200ms cubic-bezier(0.25, 0.1, 0.25, 1);
}

.zy-navbar__left--pressed {
  transform: scale(0.88);
  opacity: 0.6;
}

.zy-navbar__back-icon {
  width: 18rpx;
  height: 18rpx;
  border-left: 3rpx solid var(--text-primary);
  border-bottom: 3rpx solid var(--text-primary);
  transform: rotate(45deg);
  transition-property: border-color;
  transition-duration: 240ms;
  transition-timing-function: cubic-bezier(0.19, 1, 0.22, 1);
}

.zy-navbar__title {
  flex: 1;
  text-align: center;
  overflow: hidden;
  pointer-events: none;
}

.zy-navbar__title-text {
  font-size: 32rpx;
  font-weight: 500;
  letter-spacing: 0.05em;
  color: var(--text-primary);
  animation-name: title-reveal;
  animation-duration: 700ms;
  animation-timing-function: cubic-bezier(0.19, 1, 0.22, 1);
  animation-delay: 200ms;
  animation-fill-mode: forwards;
}

@keyframes title-reveal {
  0% { opacity: 0; transform: translateY(8rpx); }
  100% { opacity: 1; transform: translateY(0); }
}

.zy-navbar__right {
  flex-shrink: 0;
  min-width: 88rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 20rpx;
  transition: transform 200ms cubic-bezier(0.25, 0.1, 0.25, 1),
              opacity 200ms cubic-bezier(0.25, 0.1, 0.25, 1);
}

.zy-navbar__right--pressed {
  transform: scale(0.9);
  opacity: 0.6;
}
