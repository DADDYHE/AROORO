/* ================================================================
   logistics-card · AROORO Haute-Luxury 物流信息卡
   ----------------------------------------------------------------
   白卡 · 发丝描边 · 16rpx 圆角 · 40rpx 内边距
   标题字重 500，正文 300–400，克制轻奢
   ================================================================ */

.logistics-card {
  display: block;
  background: var(--card-color, #FFFFFF);
  border-radius: var(--zy-radius-lg);
  border: 1rpx solid var(--hairline, rgba(26, 26, 23, 0.08));
  padding: 40rpx;
  box-sizing: border-box;
}

.logistics-row {
  display: flex;
  align-items: flex-start;
  position: relative;
}

/* 左侧时间线竖线（发丝橄榄描边） */
.logistics-row::before {
  content: '';
  position: absolute;
  left: 14rpx;
  top: 40rpx;
  bottom: 0;
  width: 1rpx;
  background: var(--border-color, #E2DED3);
}

.logistics-info {
  flex: 1;
  padding-left: 48rpx;
  position: relative;
}

/* 当前节点实心圆点 */
.logistics-info::before {
  content: '';
  position: absolute;
  left: 0;
  top: 8rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--primary-color, #1F3A1F);
  border: 2rpx solid var(--card-color, #FFFFFF);
  box-shadow: 0 0 0 2rpx var(--primary-color, #1F3A1F);
}

.logistics-line {
  display: flex;
  align-items: baseline;
  padding: 12rpx 0;
  position: relative;
}

.logistics-line:last-child {
  padding-bottom: 0;
}

/* 非首个物流条目 虚线连接（发丝空心圆点暗示未来步骤） */
.logistics-line + .logistics-line::before {
  content: '';
  position: absolute;
  left: -48rpx;
  top: 50%;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--card-color, #FFFFFF);
  border: 2rpx solid var(--border-color, #E2DED3);
  transform: translateY(-50%);
}

.logistics-label {
  font-size: 24rpx;
  color: var(--text-tertiary);
  width: 140rpx;
  flex-shrink: 0;
  font-weight: 400;
  letter-spacing: 0.04em;
  line-height: 1.5;
}

.logistics-value {
  font-size: 28rpx;
  color: var(--text-primary, #1A1A17);
  flex: 1;
  font-weight: 400;
  letter-spacing: 0.02em;
  line-height: 1.5;
  word-break: break-all;
}

.logistics-value.copyable {
  transition-property: opacity;
  transition-duration: 160ms;
  transition-timing-function: cubic-bezier(0.25, 0.1, 0.25, 1);
}

.logistics-value--pressed {
  opacity: 0.5;
}

.logistics-arrow {
  width: 14rpx;
  height: 14rpx;
  border-top: 2rpx solid var(--text-tertiary);
  border-right: 2rpx solid var(--text-tertiary);
  transform: rotate(45deg);
  margin-left: 20rpx;
  flex-shrink: 0;
  margin-top: 6rpx;
}

.logistics-action {
  text-align: center;
  font-size: 26rpx;
  color: var(--primary-color, #1F3A1F);
  padding: 24rpx 0 0;
  margin-top: 24rpx;
  border-top: 1rpx solid var(--divider-color, #ECE8DE);
  font-weight: 500;
  letter-spacing: 0.04em;
  transition: color var(--transition-fast, 280ms cubic-bezier(0.25, 0.1, 0.25, 1));
}
