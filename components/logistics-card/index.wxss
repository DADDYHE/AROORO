.logistics-card {
  display: block;
}

.logistics-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.logistics-info {
  flex: 1;
}

.logistics-line {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.logistics-line:last-child {
  margin-bottom: 0;
}

.logistics-label {
  font-size: 26rpx;
  color: var(--text-tertiary);
  width: 160rpx;
}

.logistics-value {
  font-size: 28rpx;
  color: var(--text-primary);
  flex: 1;
}

.logistics-arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 2rpx solid var(--text-tertiary);
  border-right: 2rpx solid var(--text-tertiary);
  transform: rotate(45deg);
  margin-left: 16rpx;
}

.logistics-action {
  text-align: center;
  font-size: 26rpx;
  color: var(--primary-color);
  padding: 16rpx 0;
  border-top: 1rpx solid var(--divider-color);
}
