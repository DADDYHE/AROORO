.login-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  animation: fadeIn 0.25s ease-out;
}

.login-card {
  width: 600rpx;
  background: var(--card-color);
  border-radius: 24rpx;
  overflow: visible;
  position: relative;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.12);
  animation: slideUp 0.3s ease-out;
}

.card-top-bar {
  height: 3rpx;
  background: linear-gradient(90deg, var(--activity-primary) 0%, var(--activity-primary-mid) 50%, transparent 100%);
  border-radius: 24rpx 24rpx 0 0;
}

.card-content {
  padding: 56rpx 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.card-icon {
  margin-bottom: 8rpx;
}

.icon-circle {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--activity-primary) 0%, var(--activity-primary-mid) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(78, 205, 196, 0.3);
  position: relative;
}

.icon-gradient {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(78, 205, 196, 0.2) 0%, rgba(78, 205, 196, 0) 70%);
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: -1;
}

.card-text {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  text-align: center;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  text-align: center;
}

.card-subtitle {
  font-size: 24rpx;
  color: var(--text-secondary);
  text-align: center;
  line-height: 1.5;
}

.card-btn {
  width: 100%;
  margin-top: 16rpx;
  padding: 24rpx 0;
  background: linear-gradient(135deg, var(--activity-primary) 0%, var(--activity-primary-mid) 100%);
  border-radius: 48rpx;
  box-shadow: 0 6rpx 16rpx rgba(78, 205, 196, 0.3);
  text-align: center;
}

.card-btn:active {
  opacity: 0.85;
}

.btn-text {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--card-color);
}

.card-skip {
  margin-top: 12rpx;
  padding: 12rpx 0;
  text-align: center;
}

.skip-text {
  font-size: 24rpx;
  color: var(--gray-500);
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideUp {
  from { opacity: 0; transform: translateY(40rpx); }
  to { opacity: 1; transform: translateY(0); }
}
