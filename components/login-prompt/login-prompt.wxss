   login-prompt · PETLUX 橄榄绿治愈轻奢视觉语言
   2026-07-28 按新设计系统重写 — 令牌化颜色/圆角/阴影
   ================================================================ */

.login-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--overlay-color);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.login-card {
  width: 600rpx;
  background: var(--card-color);
  border-radius: var(--border-radius-md);
  overflow: visible;
  position: relative;
  box-shadow: var(--zy-shadow-md);
}

.card-top-bar {
  height: 3rpx;
  background: var(--gradient-primary);
  border-radius: var(--border-radius-md) var(--border-radius-md) 0 0;
}

.card-content {
  padding: 48rpx 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.card-icon {
  margin-bottom: 8rpx;
}

.icon-circle {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--gradient-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-glow-primary-soft);
  position: relative;
}

.icon-gradient {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: radial-gradient(circle, var(--primary-light) 0%, transparent 70%);
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: -1;
}

.card-text {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  text-align: center;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  text-align: center;
  letter-spacing: -0.01em;
}

.card-subtitle {
  font-size: 24rpx;
  color: var(--text-secondary);
  text-align: center;
  line-height: 1.55;
}

.card-btn {
  width: 100%;
  margin-top: 16rpx;
  padding: 22rpx 0;
  background: var(--gradient-primary);
  border-radius: var(--border-radius-pill);
  box-shadow: var(--shadow-glow-primary-btn);
  text-align: center;
}

.btn-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #FAFAF6;
}

.card-skip {
  margin-top: 8rpx;
  padding: 12rpx 0;
  text-align: center;
}

.skip-text {
  font-size: 24rpx;
  color: var(--text-tertiary);
}
