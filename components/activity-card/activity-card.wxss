.activity-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.activity-main {
  position: relative;
  width: 100%;
  height: 320rpx;
}

.activity-cover {
  width: 100%;
  height: 100%;
}

.activity-overlay {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
}

.activity-badge {
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.badge-active {
  background: rgba(78, 205, 196, 0.9);
  color: #fff;
}

.badge-stopped {
  background: rgba(255, 107, 0, 0.9);
  color: #fff;
}

.badge-ended {
  background: rgba(153, 153, 153, 0.9);
  color: #fff;
}

.badge-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #fff;
  margin-right: 8rpx;
}

.badge-text {
  font-size: 22rpx;
}

.activity-category-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  padding: 8rpx 16rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 20rpx;
  color: #fff;
  font-size: 20rpx;
}

.activity-details {
  padding: 20rpx 24rpx;
}

.activity-title-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.activity-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
  margin-right: 16rpx;
}

.truncate {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.activity-price {
  font-size: 28rpx;
  font-weight: 600;
  white-space: nowrap;
}

.price-paid {
  color: #FF6B00;
}

.price-free {
  color: #4ECDC4;
}

.activity-time-row,
.activity-info-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.info-item {
  display: flex;
  align-items: center;
  margin-right: 24rpx;
}

.info-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.info-text {
  font-size: 24rpx;
  color: #666;
}

.participants-text {
  color: #999;
}
