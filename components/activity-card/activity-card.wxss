/* ================================================================
   activity-card · PETLUX 橄榄绿治愈轻奢视觉语言
   2026-07-28 按新设计系统重写 — 令牌化颜色/圆角/阴影
   ================================================================ */

.activity-card {
  background: var(--card-color);
  border-radius: var(--border-radius-md);
  overflow: hidden;
  margin-bottom: 16rpx;
  box-shadow: var(--zy-shadow-xs);
}

.activity-main {
  position: relative;
  width: 100%;
  height: 320rpx;
}

.activity-cover {
  width: 100%;
  height: 100%;
}

.activity-overlay {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
}

.activity-badge {
  display: flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: var(--border-radius-pill);
  font-size: 22rpx;
}

.badge-active {
  background: var(--primary-color);
  color: #FAFAF6;
}

.badge-stopped {
  background: var(--warning-color);
  color: #FAFAF6;
}

.badge-ended {
  background: var(--text-tertiary);
  color: #FAFAF6;
}

.badge-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #FAFAF6;
  margin-right: 8rpx;
}

.badge-text {
  font-size: 22rpx;
  font-weight: 500;
}

.activity-category-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  padding: 6rpx 16rpx;
  background: var(--overlay-color);
  border-radius: var(--border-radius-pill);
  color: #FAFAF6;
  font-size: 20rpx;
}

.activity-details {
  padding: 20rpx 24rpx 24rpx;
}

.activity-title-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.activity-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  flex: 1;
  margin-right: 16rpx;
  line-height: 1.3;
}

.truncate {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.activity-price {
  font-size: 28rpx;
  font-weight: 600;
  white-space: nowrap;
}

.price-paid {
  color: var(--primary-color);
}

.price-free {
  color: var(--primary-color);
}

.activity-time-row,
.activity-info-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.info-item {
  display: flex;
  align-items: center;
  margin-right: 24rpx;
}

.info-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.info-text {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.participants-text {
  color: var(--text-tertiary);
}
