/* ================================================================
   activity-card · PETLUX 深森林绿 × 香槟金 × 奶油白 高奢视觉语言
   Skyline 兼容：无 :active / 无 text-transform / 无 backdrop-filter /
   transition 仅 transform & opacity / 无 !important / 单行截断
   ================================================================ */

.activity-card {
  background: var(--card-color);
  border-radius: var(--zy-radius-md);
  overflow: hidden;
  margin-bottom: var(--zy-space-lg);
  border: 1rpx solid var(--hairline, rgba(26,26,23,0.08));
  box-shadow: none;
}

.activity-card--pressed {
  transform: scale(0.98);
}

.activity-main {
  position: relative;
  width: 100%;
  height: 320rpx;
}

.activity-cover {
  width: 100%;
  height: 100%;
}

.activity-overlay {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
}

.activity-badge {
  display: flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: var(--zy-radius-pill);
  font-size: 22rpx;
}

.badge-active {
  background: var(--primary-color);
  color: var(--text-on-primary);
}

.badge-stopped {
  background: var(--warning-color);
  color: var(--text-on-accent);  /* 金面文字：原 --text-on-primary 2.2:1 → 炭墨 7.27:1 */
}

.badge-ended {
  background: var(--text-tertiary);
  color: var(--text-on-primary);
}

.badge-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--text-on-primary);
  margin-right: 8rpx;
}

.badge-text {
  font-size: 22rpx;
  font-weight: 500;
}

.activity-category-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  padding: 6rpx 16rpx;
  background: var(--overlay-color, rgba(26,26,23,0.5));
  border-radius: var(--zy-radius-pill);
  color: var(--text-on-primary);
  font-size: 20rpx;
}

.activity-details {
  padding: 32rpx 32rpx 36rpx;
}

.activity-title-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.activity-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  flex: 1;
  margin-right: 16rpx;
  line-height: 1.3;
  letter-spacing: 0.01em;
}

.truncate {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.activity-price {
  font-size: 28rpx;
  font-weight: 500;
  white-space: nowrap;
}

.price-paid {
  color: var(--text-primary);
}

.price-free {
  color: var(--primary-color);
}

.activity-time-row,
.activity-info-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.info-item {
  display: flex;
  align-items: center;
  margin-right: 24rpx;
}

.info-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.info-text {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.participants-text {
  color: var(--text-tertiary);
}
