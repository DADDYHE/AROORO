# 开发环境配置（请勿提交到仓库）
# 复制此文件为 .env.local 并填入实际值
#
# 使用方法：
#   cp .env.example .env.local
#
# 按环境选择对应的变量组填写，未使用的环境组可保留为占位。

# ============== 开发（dev） ==============
# 云开发环境 ID
CLOUDBASE_ENV=your-cloud-env-id
# 微信小程序 AppID
APP_ID=your-app-id
# IM SDK AppID（腾讯云 IM）
IM_SDK_APP_ID=your-im-sdk-app-id

# ============== 预发布（staging） ==============
# CLOUDBASE_ENV_STAGING=your-staging-env-id
# APP_ID_STAGING=your-staging-appid
# IM_SDK_APP_ID_STAGING=your-im-sdk-app-id
# API_BASE_URL_STAGING=

# ============== 生产（production） ==============
# CLOUDBASE_ENV_PRODUCTION=your-production-env-id
# APP_ID_PRODUCTION=your-production-appid
# IM_SDK_APP_ID_PRODUCTION=your-im-sdk-app-id
# API_BASE_URL_PRODUCTION=
