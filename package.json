{
  "name": "arooro-miniprogram",
  "version": "1.0.0",
  "description": "AROORO 宠物寄养小程序",
  "private": true,
  "scripts": {
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "lint:cloudfunctions": "eslint cloudfunctions/ --ext .js",
    "lint:cloudfunctions:fix": "eslint cloudfunctions/ --ext .js --fix",
    "format": "prettier --write \"**/*.js\" \"**/*.json\"",
    "format:check": "prettier --check \"**/*.js\" \"**/*.json\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --reporters=default --reporters=jest-junit",
    "audit:naming": "node scripts/audit-naming.js",
    "audit:empty-catch": "node scripts/audit-empty-catch.js",
    "audit:duplication": "node scripts/audit-duplication.js",
    "audit:error-codes": "node scripts/audit-error-codes.js",
    "audit:error-codes:strict": "node scripts/audit-error-codes.js --strict",
    "audit:errors-singleton": "node scripts/audit-errors-singleton.js",
    "audit:errors-singleton:strict": "node scripts/audit-errors-singleton.js --strict",
    "audit:global-rate-limit": "node scripts/audit-global-rate-limit.js",
    "audit:global-rate-limit:strict": "node scripts/audit-global-rate-limit.js",
    "audit:s22-business-risk": "node scripts/audit-s22-business-risk.js",
    "audit:s22-business-risk:strict": "node scripts/audit-s22-business-risk.js",
    "audit:s23-i18n-override": "node scripts/audit-s23-i18n-override.js",
    "audit:s23-i18n-override:strict": "node scripts/audit-s23-i18n-override.js",
    "audit:s24-payment-service-ts": "node scripts/audit-s24-payment-service-ts.js",
    "audit:s24-payment-service-ts:strict": "node scripts/audit-s24-payment-service-ts.js --strict",
    "audit:s25-payment-pay-ts": "node scripts/audit-s25-payment-pay-ts.js",
    "audit:s25-payment-pay-ts:strict": "node scripts/audit-s25-payment-pay-ts.js --strict",
    "audit:s26-payment-notify-ts": "node scripts/audit-s26-payment-notify-ts.js",
    "audit:s26-payment-notify-ts:strict": "node scripts/audit-s26-payment-notify-ts.js --strict",
    "audit:s27-payment-commission-ts": "node scripts/audit-s27-payment-commission-ts.js",
    "audit:s27-payment-commission-ts:strict": "node scripts/audit-s27-payment-commission-ts.js --strict",
    "audit:s28-order-service-orders-ts": "node scripts/audit-s28-order-service-orders-ts.js",
    "audit:s28-order-service-orders-ts:strict": "node scripts/audit-s28-order-service-orders-ts.js --strict",
    "audit:s29-order-service-payment-ts": "node scripts/audit-s29-order-service-payment-ts.js",
    "audit:s29-order-service-payment-ts:strict": "node scripts/audit-s29-order-service-payment-ts.js --strict",
    "audit:s30-order-service-stats-ts": "node scripts/audit-s30-order-service-stats-ts.js",
    "audit:s30-order-service-stats-ts:strict": "node scripts/audit-s30-order-service-stats-ts.js --strict",
    "audit:s31-handle-success-residual": "node scripts/audit-s31-handle-success-residual.js",
    "audit:s31-handle-success-residual:strict": "node scripts/audit-s31-handle-success-residual.js --strict",
    "audit:s31-global-rate-limit-coverage": "node scripts/audit-s31-global-rate-limit-coverage.js",
    "audit:s31-global-rate-limit-coverage:strict": "node scripts/audit-s31-global-rate-limit-coverage.js --strict",
    "audit:s31-ts-coverage": "node scripts/audit-s31-ts-coverage.js",
    "audit:s31-ts-coverage:strict": "node scripts/audit-s31-ts-coverage.js --strict",
    "validate:data": "node scripts/validate-legacy-data.js",
    "validate:data:report": "node scripts/validate-legacy-data.js --report",
    "typecheck:types": "npx --yes -p typescript@5.4.5 tsc --noEmit -p tsconfig.types.json",
    "typecheck:paymentService": "npx --yes -p typescript@5.4.5 tsc --noEmit -p tsconfig.paymentService.json",
    "build:common": "node scripts/build-common.js",
    "build:payment-service": "node scripts/build-payment-service.js",
    "build:order-service": "node scripts/build-order-service.js",
    "build:i18n": "node scripts/build-i18n.js",
    "build:all": "npm run build:common && npm run build:payment-service && npm run build:order-service && npm run build:i18n",
    "ci:check": "npm run lint:cloudfunctions && npm run audit:error-codes:strict && npm run audit:errors-singleton:strict && npm run audit:global-rate-limit:strict && npm run audit:s22-business-risk:strict && npm run audit:s23-i18n-override:strict && npm run audit:s24-payment-service-ts:strict && npm run audit:s25-payment-pay-ts:strict && npm run audit:s26-payment-notify-ts:strict && npm run audit:s27-payment-commission-ts:strict && npm run audit:s28-order-service-orders-ts:strict && npm run audit:s29-order-service-payment-ts:strict && npm run audit:s30-order-service-stats-ts:strict && npm run i18n:collect:zh:check && npm run codemod:page-i18n:check && npm run test:ci",
    "sync:common": "node scripts/sync-cloud-common.js",
    "sync:common:check": "node scripts/sync-cloud-common.js --check",
    "codemod:handle-error": "node scripts/codemod-handle-error.js",
    "codemod:page-i18n": "node scripts/codemod-page-i18n.js",
    "codemod:page-i18n:dry-run": "node scripts/codemod-page-i18n.js --dry-run",
    "codemod:page-i18n:check": "node scripts/codemod-page-i18n.js pages subpackages --check",
    "i18n:collect:zh": "node scripts/collect-zh-strings.js",
    "i18n:collect:zh:apply": "node scripts/collect-zh-strings.js --apply",
    "i18n:collect:zh:check": "node scripts/collect-zh-strings.js --check"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "prettier": "^3.2.4",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "@vant/weapp": "^1.11.7"
  }
}
