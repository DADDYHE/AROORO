{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "moduleResolution": "node",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@common/*": ["cloudfunctions/common/*"]
    }
  },
  "include": [
    "cloudfunctions/common/types.d.ts",
    "cloudfunctions/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "cloudfunctions/**/node_modules",
    "scripts"
  ]
}
