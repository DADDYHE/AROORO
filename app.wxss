/* 导入设计系统变量 */
@import './styles/variables.wxss';
@import './styles/design-tokens.wxss';
@import './styles/theme-teal.wxss';
@import './styles/components.wxss';

/* 全局样式 — 2026-07-29 已清除全部交互动效 */
page {
  background-color: var(--background-color);
  font-family: var(--font-regular);
  font-size: var(--font-size-sm);
  color: var(--text-primary);
  line-height: var(--line-height-text);
  min-height: 100vh;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  letter-spacing: var(--letter-spacing-normal);
  overflow-x: hidden;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
}

.container,
.card,
.btn,
.input,
.list,
.list-item,
.status-badge,
.loading,
.skeleton,
.empty-state,
.nav-grid,
.nav-item,
.nav-icon,
.host-list,
.host-item,
.host-avatar,
.event-list,
.event-item,
.stats-card,
.stat-primary-item,
.stat-secondary-item {
  box-sizing: border-box;
}

/* 容器 */
.container {
  padding: var(--spacing-xxl);
  min-height: 100vh;
  max-width: var(--container-max-width);
  margin: 0 auto;
}

/* 卡片 */
.card {
  background-color: var(--card-color);
  border-radius: var(--border-radius-2xl);
  box-shadow: var(--shadow-soft);
  padding: var(--card-padding);
  margin-bottom: var(--spacing-xxl);
  overflow: hidden;
  position: relative;
}

.card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--border-color), transparent);
  opacity: 0.5;
}

/* 按钮 */
.btn {
  display: inline-block;
  padding: var(--spacing-md) var(--spacing-xl);
  border-radius: var(--border-radius-xl);
  font-size: var(--font-size-sm);
  font-family: var(--font-semibold);
  text-align: center;
  border: none;
  min-width: 88px;
  position: relative;
  overflow: hidden;
}

.btn-primary {
  background-color: var(--primary-color);
  color: white;
  box-shadow: var(--shadow-md);
}

.btn-secondary {
  background-color: transparent;
  color: var(--primary-color);
  border: 1px solid var(--border-color);
}

.btn-text {
  background-color: transparent;
  color: var(--primary-color);
  padding: var(--spacing-sm) var(--spacing-md);
  border-radius: var(--border-radius-lg);
}

/* 输入框 */
.input {
  width: 100%;
  padding: var(--spacing-md);
  border: 1px solid var(--border-color);
  border-radius: var(--border-radius-xl);
  font-size: var(--font-size-sm);
  font-family: var(--font-regular);
  background-color: var(--card-color);
  position: relative;
}

.input::placeholder {
  color: var(--text-tertiary);
}

/* 列表 */
.list {
  background-color: var(--card-color);
  border-radius: var(--border-radius-2xl);
  overflow: hidden;
  box-shadow: var(--shadow-soft);
  margin-bottom: var(--spacing-xxl);
}

.list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: var(--list-item-height);
  padding: 0 var(--spacing-xl);
  border-bottom: 1px solid var(--divider-color);
  position: relative;
}

.list-item:last-child {
  border-bottom: none;
}

.list-item::after {
  content: '';
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%) rotate(-45deg);
  width: 8px;
  height: 8px;
  border-right: 2px solid var(--text-tertiary);
  border-bottom: 2px solid var(--text-tertiary);
  opacity: 0;
}

/* 标题 */
h1, h2, h3, h4, h5, h6 {
  font-family: var(--font-semibold);
  line-height: var(--line-height-title);
  margin-bottom: var(--spacing-xxl);
  color: var(--text-primary);
  letter-spacing: var(--letter-spacing-tight);
  position: relative;
}

/* 文本 */
.text-primary {
  color: var(--text-primary);
}

.text-secondary {
  color: var(--text-secondary);
  font-size: var(--font-size-xs);
}

.text-tertiary {
  color: var(--text-tertiary);
  font-size: var(--font-size-xxs);
}

/* 订单状态标签 */
.status-badge {
  padding: 6px 16px;
  border-radius: var(--border-radius-full);
  font-size: var(--font-size-xs);
  font-family: var(--font-semibold);
  display: inline-flex;
  align-items: center;
}

.status-pending {
  background-color: rgba(255, 149, 0, 0.1);
  color: var(--status-pending);
}

.status-active {
  background-color: rgba(0, 122, 255, 0.1);
  color: var(--status-active);
}

.status-completed {
  background-color: rgba(52, 199, 89, 0.1);
  color: var(--status-completed);
}

.status-cancelled {
  background-color: rgba(142, 142, 147, 0.1);
  color: var(--status-cancelled);
}

/* 加载状态 */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: var(--spacing-xxxxl);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-xxxxxl);
  text-align: center;
}

/* 分割线 */
.divider {
  height: 1px;
  background-color: var(--divider-color);
  margin: var(--spacing-xxl) 0;
  position: relative;
}

.divider::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--divider-color), transparent);
}

/* 阴影效果 */
.shadow-soft {
  box-shadow: var(--shadow-soft);
}

/* 文本截断 */
.truncate {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 触摸反馈（已清除动效） */
.touch-feedback {
}

.touch-feedback-strong {
}

/* 文字渐变 */
.text-gradient {
  background: var(--gradient-primary);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.text-gradient-secondary {
  background: var(--gradient-secondary);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* 边框渐变 */
.border-gradient::before {
  content: '';
  position: absolute;
  top: -2px;
  left: -2px;
  right: -2px;
  bottom: -2px;
  background: var(--gradient-primary);
  border-radius: var(--border-radius-lg);
  z-index: -1;
}

/* 滚动条样式 */
::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}

::-webkit-scrollbar-track {
  background: var(--divider-color);
  border-radius: var(--border-radius-full);
}

::-webkit-scrollbar-thumb {
  background: var(--text-tertiary);
  border-radius: var(--border-radius-full);
}

/* 选择文本样式 */
::selection {
  background-color: rgba(42, 40, 35, 0.1);
  color: var(--text-primary);
}

/* 过渡效果类（已清除动效，保留类名避免引用断裂） */
.transition {
}

.transition-fast {
}

.transition-slow {
}

.transition-smooth {
}

/* 响应式设计 */
@media (max-width: 375px) {
  .container {
    padding: var(--spacing-xl);
  }
  
  .card {
    padding: var(--spacing-md);
    margin-bottom: var(--spacing-xl);
  }
}
