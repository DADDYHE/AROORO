{
  "pages": [
    "pages/home/index",
    "pages/splash/index",
    "pages/discover/index",
    "pages/service/index",
    "pages/quick-register/index",
    "pages/profile/index",
    "pages/group-detail/index"
  ],
  "window": {
    "backgroundTextStyle": "light",
    "navigationBarBackgroundColor": "#fff",
    "navigationBarTitleText": "AROORO",
    "navigationBarTextStyle": "black",
    "navigationStyle": "custom"
  },
  "tabBar": {
    "custom": true,
    "color": "#666666",
    "selectedColor": "#4F5E35",
    "backgroundColor": "#FFFFFF",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/home/index",
        "text": "首页"
      },
      {
        "pagePath": "pages/quick-register/index",
        "text": "一键报名"
      },
      {
        "pagePath": "pages/discover/index",
        "text": "宠团团"
      },
      {
        "pagePath": "pages/service/index",
        "text": "宠物服务"
      },
      {
        "pagePath": "pages/profile/index",
        "text": "我的"
      }
    ]
  },
  "style": "v2",
  "renderer": "skyline",
  "componentFramework": "glass-easel",
  "rendererOptions": {
    "skyline": {
      "defaultDisplayBlock": true,
      "disableABTest": true,
      "defaultContentBox": true
    }
  },
  "lazyCodeLoading": "requiredComponents",
  "usingComponents": {
    "zy-navbar": "/components/zy-navbar/index"
  },
  "sitemapLocation": "sitemap.json",
  "permission": {
    "scope.userLocation": {
      "desc": "用于活动现场签到及推荐附近的寄养家庭"
    }
  },
  "requiredPrivateInfos": [
    "chooseLocation",
    "getLocation"
  ],
  "networkTimeout": {
    "request": 30000,
    "connectSocket": 30000,
    "uploadFile": 60000,
    "downloadFile": 60000
  },
  "subPackages": [
    {
      "root": "subpackages/booking",
      "name": "booking",
      "pages": [
        "pet-select",
        "confirm",
        "host-list-all",
        "host-detail"
      ]
    },
    {
      "root": "subpackages/pet",
      "name": "pet",
      "pages": [
        "create-step1",
        "list",
        "detail",
        "update-profile"
      ]
    },
    {
      "root": "subpackages/profile",
      "name": "profile",
      "pages": [
        "login/index",
        "edit/index",
        "about/about",
        "privacy/privacy",
        "agreement/agreement",
        "notification/list",
        "notification/detail",
        "referral/index",
        "order-stats/index",
        "mall-order-detail/index",
        "order-detail/index"
      ]
    },
    {
      "root": "subpackages/activity",
      "name": "activity",
      "pages": [
        "list",
        "detail",
        "register",
        "friend",
        "my-registered",
        "map-view",
        "payment"
      ]
    },
    {
      "root": "subpackages/mall",
      "name": "mall",
      "pages": [
        "product-list",
        "product-detail",
        "order-confirm",
        "cart"
      ]
    },
    {
      "root": "subpackages/feeding",
      "name": "feeding",
      "pages": [
        "service-detail",
        "confirm-service",
        "order-status"
      ]
    },
    {
      "root": "subpackages/other",
      "name": "other",
      "pages": [
        "favorites/index",
        "album/index",
        "video-list/index",
        "address/index"
      ]
    },
    {
      "root": "subpackages/coupon",
      "name": "coupon",
      "pages": [
        "my-coupons",
        "claim-center"
      ]
    },
    {
      "root": "subpackages/partner",
      "name": "partner",
      "pages": [
        "home/index",
        "activity-list/index",
        "activity-create/index",
        "activity-detail/index",
        "hosting-profile/index",
        "hosting-profile-edit/index",
        "feeding/index",
        "income/index",
        "service-income/index",
        "application/index",
        "referral/index",
        "withdrawal/index",
        "i18n-override/index"
      ]
    },
    {
      "root": "subpackages/search",
      "name": "search",
      "pages": [
        "index"
      ]
    }
  ],
  "preloadRule": {
    "pages/profile/index": {
      "network": "all",
      "packages": [
        "partner"
      ]
    },
    "pages/home/index": {
      "network": "wifi",
      "packages": [
        "partner"
      ]
    }
  }
}
