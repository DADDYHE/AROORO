/* Loading Animation — 已清除全部动效
   2026-07-29 全面清理交互动效
   保留静态布局结构，移除所有 @keyframes 和 animation 属性 */

.loading-container {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--background-color, #F8FAF3);
}

.loading-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 40rpx;
}

.loading-brand-mark {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.brand-ring {
  position: absolute;
  width: 100rpx;
  height: 100rpx;
  border: 3rpx solid transparent;
  border-radius: 50%;
}

.brand-ring--delay {
  width: 80rpx;
  height: 80rpx;
}

.brand-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--activity-primary, #7A8C5A);
}

.loading-dots {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.loading-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--activity-primary, #7A8C5A);
}

.loading-text {
  font-size: 24rpx;
  color: var(--text-secondary, #635E54);
  letter-spacing: 8rpx;
  font-weight: 300;
}
