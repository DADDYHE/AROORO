/* Loading Animation - 品牌呼吸环 + 跳动点 */
.loading-container {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F5F5F7;
}

.loading-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 40rpx;
}

.loading-brand-mark {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.brand-ring {
  position: absolute;
  width: 100rpx;
  height: 100rpx;
  border: 3rpx solid transparent;
  border-radius: 50%;
  animation: breathe 2.4s ease-in-out infinite;
}

.brand-ring--delay {
  width: 80rpx;
  height: 80rpx;
  animation-delay: 0.6s;
}

.brand-ring::before {
  content: '';
  position: absolute;
  inset: -3rpx;
  border-radius: 50%;
  border: 3rpx solid transparent;
  border-top-color: #4ECDC4;
  border-right-color: rgba(78, 205, 196, 0.3);
  animation: orbit 2s linear infinite;
}

.brand-ring--delay::before {
  border-top-color: #2AB7A9;
  border-right-color: rgba(42, 183, 169, 0.2);
  animation-duration: 2.8s;
  animation-direction: reverse;
}

.brand-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #4ECDC4;
  animation: pulse 2.4s ease-in-out infinite;
}

.loading-dots {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.loading-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #4ECDC4;
  animation: dotBounce 1.4s ease-in-out infinite;
}

.loading-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.loading-dot:nth-child(3) {
  animation-delay: 0.4s;
}

.loading-text {
  font-size: 24rpx;
  color: #8E8E93;
  letter-spacing: 8rpx;
  font-weight: 300;
}

@keyframes breathe {
  0%, 100% { opacity: 0.3; transform: scale(0.95); }
  50% { opacity: 1; transform: scale(1.05); }
}

@keyframes orbit {
  to { transform: rotate(360deg); }
}

@keyframes pulse {
  0%, 100% { opacity: 0.4; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.5); }
}

@keyframes dotBounce {
  0%, 80%, 100% { opacity: 0.3; transform: translateY(0); }
  40% { opacity: 1; transform: translateY(-12rpx); }
}

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes slideDown {
  from { transform: translateY(-100%); }
  to { transform: translateY(0); }
}
