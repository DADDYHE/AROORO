/* 活动板块样式 - 薄荷绿主题 */

/* 活动板块容器 */
.activity-container {
  background-color: var(--background-color);
  min-height: 100vh;
}

/* 活动板块标题 */
.activity-title {
  color: var(--activity-primary);
  font-family: var(--font-bold);
  font-size: var(--font-size-xxl);
  margin-bottom: var(--spacing-lg);
}

/* 活动卡片 */
.activity-card {
  background: var(--card-color);
  border-radius: var(--border-radius-xl);
  box-shadow: var(--shadow-sm);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-lg);
  transition: all var(--transition-fast);
  border: 1px solid rgba(78, 205, 196, 0.1);
}

.activity-card:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
  border-color: var(--activity-primary);
}

/* 活动封面图 */
.activity-image {
  width: 100%;
  height: 200px;
  border-radius: var(--border-radius-lg);
  object-fit: cover;
  margin-bottom: var(--spacing-md);
}

/* 活动信息 */
.activity-info {
  margin-bottom: var(--spacing-md);
}

.activity-name {
  font-family: var(--font-bold);
  font-size: var(--font-size-lg);
  color: var(--text-primary);
  margin-bottom: var(--spacing-xs);
}

.activity-date {
  display: flex;
  align-items: center;
  font-size: var(--font-size-sm);
  color: var(--text-secondary);
  margin-bottom: var(--spacing-xs);
}

.activity-date icon {
  margin-right: var(--spacing-xs);
  color: var(--activity-primary);
}

.activity-location {
  display: flex;
  align-items: center;
  font-size: var(--font-size-sm);
  color: var(--text-secondary);
  margin-bottom: var(--spacing-xs);
}

.activity-location icon {
  margin-right: var(--spacing-xs);
  color: var(--activity-primary);
}

.activity-price {
  font-family: var(--font-bold);
  font-size: var(--font-size-lg);
  color: var(--activity-primary);
  margin-bottom: var(--spacing-xs);
}

.activity-tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-xs);
  margin-bottom: var(--spacing-md);
}

.activity-tag {
  background: var(--activity-accent);
  color: var(--activity-primary);
  padding: var(--spacing-xxs) var(--spacing-xs);
  border-radius: var(--border-radius-full);
  font-size: var(--font-size-xs);
  font-weight: var(--font-semibold);
}

/* 活动板块按钮 */
.activity-btn {
  background: var(--activity-gradient);
  color: var(--text-white);
  border: none;
  border-radius: var(--border-radius-md);
  padding: var(--spacing-md) var(--spacing-xl);
  font-family: var(--font-semibold);
  font-size: var(--font-size-md);
  transition: all var(--transition-fast);
  cursor: pointer;
}

.activity-btn:hover {
  opacity: 0.9;
  transform: translateY(-1px);
  box-shadow: var(--shadow-md);
}

/* 活动详情页 */
.activity-detail {
  background: var(--card-color);
  border-radius: var(--border-radius-xl);
  padding: var(--spacing-xl);
  box-shadow: var(--shadow-sm);
}

.activity-detail-image {
  width: 100%;
  height: 300px;
  border-radius: var(--border-radius-lg);
  object-fit: cover;
  margin-bottom: var(--spacing-lg);
}

.activity-detail-title {
  font-family: var(--font-bold);
  font-size: var(--font-size-xxl);
  color: var(--text-primary);
  margin-bottom: var(--spacing-md);
}

.activity-detail-info {
  margin-bottom: var(--spacing-lg);
}

.activity-detail-description {
  font-size: var(--font-size-md);
  line-height: var(--line-height-text);
  color: var(--text-secondary);
  margin-bottom: var(--spacing-lg);
}

/* 活动报名表单 */
.activity-form {
  background: var(--card-color);
  border-radius: var(--border-radius-xl);
  padding: var(--spacing-lg);
  box-shadow: var(--shadow-sm);
}

.activity-form label {
  display: block;
  font-family: var(--font-semibold);
  font-size: var(--font-size-sm);
  color: var(--text-primary);
  margin-bottom: var(--spacing-xs);
}

.activity-form input,
.activity-form textarea {
  width: 100%;
  padding: var(--spacing-md);
  border: 1px solid var(--border-color);
  border-radius: var(--border-radius-md);
  font-size: var(--font-size-md);
  margin-bottom: var(--spacing-md);
  transition: all var(--transition-fast);
}

.activity-form input:focus,
.activity-form textarea:focus {
  outline: none;
  border-color: var(--activity-primary);
  box-shadow: 0 0 0 2px rgba(78, 205, 196, 0.1);
}

/* 活动状态 */
.activity-status {
  display: inline-block;
  padding: var(--spacing-xxs) var(--spacing-xs);
  border-radius: var(--border-radius-full);
  font-size: var(--font-size-xs);
  font-weight: var(--font-semibold);
}

.activity-status-upcoming {
  background: var(--info-color);
  color: var(--text-white);
}

.activity-status-active {
  background: var(--success-color);
  color: var(--text-white);
}

.activity-status-ended {
  background: var(--error-color);
  color: var(--text-white);
}

/* 活动板块动画 */
.activity-fade-in {
  animation: activityFadeIn 0.5s ease-in-out;
}

@keyframes activityFadeIn {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.activity-slide-up {
  animation: activitySlideUp 0.5s ease-out;
}

@keyframes activitySlideUp {
  from {
    opacity: 0;
    transform: translateY(40px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}