/**
 * 交互效果增强样式
 * 提供统一的点击反馈和基本过渡效果
 * 基于 styles/interaction.wxss 的简化版本
 */

/* ==================== 点击反馈效果 ==================== */

/* 按钮点击反馈 - 简洁版 */
.interaction-btn {
  transition: all 0.1s ease;
}

.interaction-btn:active {
  opacity: 0.7;
}

/* 卡片点击反馈 - 简洁版 */
.interaction-card {
  transition: all 0.1s ease;
}

.interaction-card:active {
  opacity: 0.7;
}

/* 列表项点击反馈 - 简洁版 */
.interaction-list-item {
  transition: all 0.1s ease;
}

.interaction-list-item:active {
  opacity: 0.7;
  background-color: rgba(0, 0, 0, 0.03);
}

/* ==================== 滑动效果 ==================== */

/* 滑动容器 - 基础 */
.interaction-scroll {
  -webkit-overflow-scrolling: touch;
  overflow-y: auto;
  overflow-x: hidden;
}

/* 滑动操作按钮 */
.interaction-swipe-btn {
  padding: 0 32rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
  transition: opacity 0.1s ease;
}

.interaction-swipe-btn:active {
  opacity: 0.7;
}

/* ==================== 弹窗效果 ==================== */

/* 弹窗遮罩层 - 简化 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  opacity: 0;
  transition: opacity 0.2s ease;
}

.modal-overlay.show {
  opacity: 1;
}

/* ==================== 表单交互 ==================== */

/* 输入框聚焦效果 - 简化 */
.interaction-input {
  transition: border-color 0.2s ease;
}

.interaction-input:focus {
  border-color: #FF6B00;
}

/* 开关按钮 - 简化 */
.interaction-switch {
  position: relative;
  transition: background-color 0.2s ease;
}

.interaction-switch::after {
  content: '';
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 44rpx;
  height: 44rpx;
  background-color: #fff;
  border-radius: 50%;
  transition: transform 0.2s ease;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.interaction-switch.active::after {
  transform: translateX(48rpx);
}

/* ==================== 进度条 ==================== */

/* 进度条填充 - 简化 */
.interaction-progress {
  position: relative;
  overflow: hidden;
}

.interaction-progress-bar {
  height: 100%;
  background-color: #FF6B00;
  transition: width 0.3s ease;
}

/* ==================== 图片加载 ==================== */

/* 图片渐入 - 简化 */
.interaction-image {
  opacity: 0;
  transition: opacity 0.3s ease;
}

.interaction-image.loaded {
  opacity: 1;
}

/* 图片骨架屏 - 保留 */
.interaction-skeleton {
  background-color: #f0f0f0;
}

/* ==================== 工具类 ==================== */

/* 禁止点击 */
.interaction-disabled {
  opacity: 0.5 !important;
  pointer-events: none !important;
}

/* 性能优化 */
.interaction-hw-accel {
  transform: translateZ(0);
}
