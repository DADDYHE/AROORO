/* ============================================================
   design-tokens.wxss · --zy-* 令牌层（任务 #10 去重后残余）
   ------------------------------------------------------------
   ⚠ 防复发约定（改动本文件前必读）
   1. 本文件**不得声明 theme-teal.wxss 已有的令牌**。
      theme-teal.wxss 是全站唯一的运行时生效层（app.wxss 中最后 import，
      且 custom-tab-bar 单独 import 的也是它）。在本文件重复声明同名令牌，
      运行时一定被 theme-teal 覆盖 = 纯冗余，还会让人误以为改这里有用。
   2. 新增令牌请直接加到 styles/theme-teal.wxss，不要加在这里。
   3. 守卫会拦：`node scripts/lint-tokens.js` 规则 C（同名跨文件冲突）应恒为 0；
      层叠等价性由 `node scripts/verify-token-cascade.js` 验收。
   ------------------------------------------------------------
   单位约定：所有尺寸用 rpx（750rpx 设计稿基准，1rpx≈0.5pt）。
   例外（非 rpx）：env(safe-area-inset-bottom) 返回 px，保留在 calc() 中。
   历史：本文件原为橄榄绿 --zy-* 全量令牌（181 行），#10 已删除 79 行
   （theme-teal 已同名定义者），只保留 theme-teal 未定义的独有令牌。
   ============================================================ */

page {
  /* ---------- TabBar 描边（theme-teal 未定义此档） ---------- */
  --zy-tabbar-icon-stroke: 4rpx;                          /* ≈2px@1x 视觉描边（750rpx 2x 下）；当前 0 引用 */

  /* ---------- 无衬线字体栈（theme-teal 的 --font-sans 是另一个名字，此处独有） ---------- */
  --zy-font-sans: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", "Source Han Sans SC", "Noto Sans CJK SC", sans-serif;

  /* ---------- 奢侈品级令牌 — Haute-Luxury Elevation Layer ----------
     金属香槟金阶 · 深森林绿阶 · 层次阴影 · 金线装饰
     供 zy-loading 奢侈级动画变体及全局高奢组件使用 */
  --lux-gold-100: #FDF8EE;
  --lux-gold-200: #F5EBD0;
  --lux-gold-300: #E8D5A8;
  --lux-gold-400: #D4B978;
  --lux-gold-500: #C9A24B;
  --lux-gold-600: #B8923E;
  --lux-gold-700: #9A7430;
  --lux-gold-grad: linear-gradient(135deg, #E8D5A8 0%, #C9A24B 40%, #B8923E 100%);

  --lux-green-900: #1A2E1A;
  --lux-green-800: #1F3A1F;
  --lux-green-700: #2D4A2D;
  --lux-green-600: #3D5A3D;

  --lux-shadow-gold: 0 2rpx 8rpx rgba(201,162,75,0.12), 0 8rpx 24rpx rgba(201,162,75,0.16);

  --lux-hairline-gold: rgba(201,162,75,0.18);

  /* 奢侈级动画时长令牌 */
  --lux-dur-ring-spin: 2400ms;
  --lux-dur-ring-reverse: 3000ms;
  --lux-dur-ring-inner: 1800ms;
  --lux-dur-dot-pulse: 2000ms;
  --lux-dur-cascade: 1600ms;
  --lux-dur-silk-wave: 1400ms;
  --lux-dur-breath: 2400ms;
  --lux-dur-text-pulse: 2400ms;
  --lux-ease-soft: cubic-bezier(0.25, 0.1, 0.25, 1);

  /* ---------- 纸纹材质（REV.4 P0-2 base64 内联）----------
     微信 WXSS 不支持本地图片 background-image，真机静默失败；
     改用 base64 内联（48×48 · 4% alpha · 5.8KB），纯色 #ECE4D4 兜底。
     用法：background: var(--zy-paper-noise) repeat, var(--zy-paper-fallback); */
  --zy-paper-noise: url("data:image/png;base64,");
  --zy-paper-fallback: #ECE4D4;

  /* ---------- 已废弃：「兼容重映射」注释块（#10 移除） ----------
     此处原有一段被注释掉的重映射声明（--primary-color / --background-color 等
     11 条），附带「取消注释即可换肤」的指引。现已废弃，且**禁止恢复**：
       · 这些令牌现由 theme-teal.wxss 统一定义，本文件再声明一定被覆盖；
       · 恢复它等于直接违反本文件顶部的防复发约定第 1 条。
     另外它还是个隐蔽的度量污染源：守卫早期按行正则建索引、不识别注释，
     曾把这 11 条计入「同名令牌冲突」，凭空造出 --card-color 这类假冲突
     （两侧同为 #FFFFFF，本不冲突）。守卫已改用真 CSS 解析器修正。 */
}

/* ============================================================
   毛玻璃降级：安卓低端机不支持 backdrop-filter 时的兜底
   策略：基色用半透明白 0.92（无 blur 也成立）
        → 支持 blur 时降 alpha 至 0.72 并加模糊
   ============================================================ */
.zy-glass {
  background: rgba(255, 255, 255, 0.88); /* Skyline: backdrop-filter 不支持，改用实色半透明背景 */
  border-top: 1rpx solid var(--zy-surface-glass-border);
}
