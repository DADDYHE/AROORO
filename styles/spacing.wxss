/* AROORO 设计系统 - 间距系统 */

:root {
  /* 基础间距单位 */
  --spacing-base: 8px;
  
  /* 间距尺寸 */
  --spacing-xs: calc(var(--spacing-base) * 0.5); /* 4px */
  --spacing-sm: var(--spacing-base); /* 8px */
  --spacing-md: calc(var(--spacing-base) * 1.5); /* 12px */
  --spacing-lg: calc(var(--spacing-base) * 2); /* 16px */
  --spacing-xl: calc(var(--spacing-base) * 3); /* 24px */
  --spacing-xxl: calc(var(--spacing-base) * 4); /* 32px */
  --spacing-xxxl: calc(var(--spacing-base) * 5); /* 40px */
  
  /* 布局间距 */
  --spacing-container: var(--spacing-lg); /* 容器内边距 */
  --spacing-section: var(--spacing-xl); /* 区块间距 */
  --spacing-card: var(--spacing-md); /* 卡片内边距 */
  --spacing-item: var(--spacing-sm); /* 列表项间距 */
  --spacing-button: var(--spacing-md); /* 按钮内边距 */
  --spacing-input: var(--spacing-md); /* 输入框内边距 */
  
  /* 外边距 */
  --margin-xs: var(--spacing-xs);
  --margin-sm: var(--spacing-sm);
  --margin-md: var(--spacing-md);
  --margin-lg: var(--spacing-lg);
  --margin-xl: var(--spacing-xl);
  --margin-xxl: var(--spacing-xxl);
  
  /* 内边距 */
  --padding-xs: var(--spacing-xs);
  --padding-sm: var(--spacing-sm);
  --padding-md: var(--spacing-md);
  --padding-lg: var(--spacing-lg);
  --padding-xl: var(--spacing-xl);
  --padding-xxl: var(--spacing-xxl);
  
  /* 圆角 */
  --border-radius-sm: 4px;
  --border-radius-md: 8px;
  --border-radius-lg: 12px;
  --border-radius-xl: 16px;
  --border-radius-full: 9999px;
  
  /* 边框宽度 */
  --border-width: 1px;
  --border-width-thick: 2px;
  
  /* 阴影 */
  --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.05);
  --shadow-md: 0 4px 6px rgba(0, 0, 0, 0.1);
  --shadow-lg: 0 10px 15px rgba(0, 0, 0, 0.1);
  
  /* 过渡动画 */
  --transition-fast: 0.2s ease;
  --transition-normal: 0.3s ease;
  --transition-slow: 0.5s ease;
}