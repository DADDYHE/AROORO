/* 寄养板块样式 - 珊瑚橙主题 */

/* 寄养板块容器 */
.boarding-container {
  background-color: var(--background-color);
  min-height: 100vh;
}

/* 寄养板块标题 */
.boarding-title {
  color: var(--boarding-primary);
  font-family: var(--font-bold);
  font-size: var(--font-size-xxl);
  margin-bottom: var(--spacing-lg);
}

/* 寄养家庭卡片 */
.boarding-card {
  background: var(--card-color);
  border-radius: var(--border-radius-xl);
  box-shadow: var(--shadow-sm);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-lg);
  transition: all var(--transition-fast);
  border: 1px solid rgba(255, 107, 0, 0.1);
}

.boarding-card:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
  border-color: var(--boarding-primary);
}

/* 寄养家庭图片 */
.boarding-image {
  width: 100%;
  height: 200px;
  border-radius: var(--border-radius-lg);
  object-fit: cover;
  margin-bottom: var(--spacing-md);
}

/* 寄养家庭信息 */
.boarding-info {
  margin-bottom: var(--spacing-md);
}

.boarding-name {
  font-family: var(--font-bold);
  font-size: var(--font-size-lg);
  color: var(--text-primary);
  margin-bottom: var(--spacing-xs);
}

.boarding-price {
  font-family: var(--font-bold);
  font-size: var(--font-size-lg);
  color: var(--boarding-primary);
  margin-bottom: var(--spacing-xs);
}

.boarding-rating {
  display: flex;
  align-items: center;
  margin-bottom: var(--spacing-xs);
}

.boarding-rating stars {
  color: var(--accent-color);
  margin-right: var(--spacing-xs);
}

.boarding-tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-xs);
  margin-bottom: var(--spacing-md);
}

.boarding-tag {
  background: var(--boarding-accent);
  color: var(--boarding-primary);
  padding: var(--spacing-xxs) var(--spacing-xs);
  border-radius: var(--border-radius-full);
  font-size: var(--font-size-xs);
  font-weight: var(--font-semibold);
}

/* 寄养板块按钮 */
.boarding-btn {
  background: var(--boarding-gradient);
  color: var(--text-white);
  border: none;
  border-radius: var(--border-radius-md);
  padding: var(--spacing-md) var(--spacing-xl);
  font-family: var(--font-semibold);
  font-size: var(--font-size-md);
  transition: all var(--transition-fast);
  cursor: pointer;
}

.boarding-btn:hover {
  opacity: 0.9;
  transform: translateY(-1px);
  box-shadow: var(--shadow-md);
}

/* 寄养板块表单 */
.boarding-form {
  background: var(--card-color);
  border-radius: var(--border-radius-xl);
  padding: var(--spacing-lg);
  box-shadow: var(--shadow-sm);
}

.boarding-form label {
  display: block;
  font-family: var(--font-semibold);
  font-size: var(--font-size-sm);
  color: var(--text-primary);
  margin-bottom: var(--spacing-xs);
}

.boarding-form input,
.boarding-form textarea {
  width: 100%;
  padding: var(--spacing-md);
  border: 1px solid var(--border-color);
  border-radius: var(--border-radius-md);
  font-size: var(--font-size-md);
  margin-bottom: var(--spacing-md);
  transition: all var(--transition-fast);
}

.boarding-form input:focus,
.boarding-form textarea:focus {
  outline: none;
  border-color: var(--boarding-primary);
  box-shadow: 0 0 0 2px rgba(255, 107, 0, 0.1);
}

/* 寄养板块状态 */
.boarding-status {
  display: inline-block;
  padding: var(--spacing-xxs) var(--spacing-xs);
  border-radius: var(--border-radius-full);
  font-size: var(--font-size-xs);
  font-weight: var(--font-semibold);
}

.boarding-status-available {
  background: var(--success-color);
  color: var(--text-white);
}

.boarding-status-unavailable {
  background: var(--error-color);
  color: var(--text-white);
}

/* 寄养板块动画 */
.boarding-fade-in {
  animation: boardingFadeIn 0.5s ease-in-out;
}

@keyframes boardingFadeIn {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.boarding-slide-up {
  animation: boardingSlideUp 0.5s ease-out;
}

@keyframes boardingSlideUp {
  from {
    opacity: 0;
    transform: translateY(40px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}