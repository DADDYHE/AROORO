/* ================================================================
   theme-teal.wxss · 橄榄绿治愈轻奢主题（PETLUX · 全盘换肤）
   2026-07-28 基于 pet-luxury-mini-program 设计系统确立
   注：文件名 theme-teal 为历史遗留，内容已全盘替换为橄榄绿主题。
   ----------------------------------------------------------------
   设计语言：
     橄榄色调暖白底 + 深橄榄绿品牌色 + 纯白卡片 + 克制圆角
     + 暖灰药丸分类条 + 品牌强调线 + 画廊式留白
     + 极简 TabBar（白底 + 居中橄榄绿圆钮）
   ----------------------------------------------------------------
   橄榄绿色板（源自 pet-luxury-mini-program 设计系统）：
     主锚点 #4F5E35 · 深橄榄 #3A4626 · 柔橄榄 #EAEDDF
     暖墨 #2A2823 · 次墨 #635E54 · 浅墨 #9A9489
     橄榄线 #D8DCCE · 页底 #F8FAF3
   ----------------------------------------------------------------
   接线方式：在 app.wxss 中本文件须 import 于 variables.wxss 之后，
   使同名语义变量覆盖旧值；同时覆盖 design-tokens.wxss 的 --zy-* 令牌。
   本文件合并了原 theme-teal（令牌覆盖）与 theme-warm（圆角/阴影调整）
   的职责，全局唯一橄榄绿主题，首页无需再单独 import。
   ================================================================ */

page {
  /* ===== 品牌层：橄榄绿（PETLUX 主色 #4F5E35） ===== */
  --primary-color: #4F5E35;            /* 橄榄绿 — 主按钮 / 选中态 / 品牌锚点 */
  --primary-light: #EAEDDF;            /* 柔橄榄底 — 浅选中态芯片 */
  --secondary-color: #3A4626;          /* 深橄榄 — hover / 按下态 */
  --accent-color: #B8893A;             /* 暖金 — 点缀 / 提示（极少用） */
  --gradient-primary: linear-gradient(160deg, #4F5E35 0%, #3A4626 100%);
  --gradient-secondary: linear-gradient(135deg, #B8893A 0%, #9A7430 100%);

  /* ===== --zy-* 橄榄绿令牌（覆盖 design-tokens.wxss） ===== */
  --zy-primary-900: #3A4626;            /* 最深：按下态 / 深色卡片 */
  --zy-primary-700: #4F5E35;            /* 主锚点：TabBar 选中 / 主按钮 */
  --zy-primary-500: #6B7D5A;            /* 浅橄榄：hover / 次级结构 */
  --zy-primary-300: #9A9489;            /* 柔灰：禁用 / 插画 */
  --zy-primary-100: #EAEDDF;            /* 橄榄浅底：选中态芯片底 */
  --zy-primary-grad: linear-gradient(160deg, #4F5E35 0%, #3A4626 100%);

  /* ===== 中性层：橄榄调暖白底 + 暖墨文字（对齐 PETLUX 令牌） ===== */
  --background-color: #F8FAF3;          /* 橄榄调暖白页面底色 */
  --card-color: #FFFFFF;                /* 纯白卡片 */
  --surface-tint: #EAEDDF;              /* 次级表面 / 芯片底 */
  --text-primary: #2A2823;              /* 主文字 暖墨（非纯黑） */
  --text-secondary: #635E54;            /* 中性次文字 */
  --text-tertiary: #9A9489;             /* 浅灰提示 */
  --border-color: #D8DCCE;              /* 边框 橄榄调 */
  --divider-color: #EAEDDF;             /* 分割线 */
  --overlay-color: rgba(42, 40, 35, 0.5);

  /* ===== --zy-* 中性令牌覆盖 ===== */
  --zy-bg: #F8FAF3;
  --zy-surface: #FFFFFF;
  --zy-surface-glass: rgba(255, 255, 255, 0.92);
  --zy-surface-glass-solid: #FFFFFF;
  --zy-surface-glass-border: rgba(255, 255, 255, 0.55);
  --zy-border: #D8DCCE;
  --zy-border-strong: #C9CFBA;
  --zy-divider: #EAEDDF;
  --zy-text-1: #2A2823;
  --zy-text-2: #635E54;
  --zy-text-3: #9A9489;
  --zy-text-on-primary: #FAFAF6;

  /* ===== PETLUX 专属令牌（暖金圆卡 + 橄榄强调） ===== */
  --pa-card-coral: #B8893A;             /* 暖金圆卡底（替代珊瑚） */
  --pa-card-coral-deep: #9A7430;        /* 暖金深环 */
  --pa-paw-red: #A85B4A;                /* 爪印/红心 暖陶土 */

  /* ===== TabBar 专用令牌覆盖 ===== */
  --zy-tabbar-item-active: #4F5E35;                    /* 选中 图标+文字 橄榄绿 */
  --zy-tabbar-item-inactive: #9A9489;                  /* 未选中 暖灰 */
  --zy-tabbar-item-active-bg: rgba(79, 94, 53, 0.08);  /* 选中态浅橄榄底 */
  --zy-tabbar-border-top: 1rpx solid rgba(79, 94, 53, 0.08);
  --zy-tabbar-center-grad: linear-gradient(160deg, #4F5E35 0%, #3A4626 100%);
  --zy-tabbar-center-shadow: 0 12rpx 28rpx rgba(79, 94, 53, 0.35), 0 4rpx 10rpx rgba(79, 94, 53, 0.20);

  /* ===== 阴影（PETLUX 极柔 — 静态 alpha ≤ 0.04，浮层渐强） ===== */
  --zy-shadow-xs: 0 2rpx 6rpx rgba(42, 40, 35, 0.04), 0 1rpx 3rpx rgba(42, 40, 35, 0.03);
  --zy-shadow-sm: 0 4rpx 12rpx rgba(42, 40, 35, 0.05), 0 1rpx 4rpx rgba(42, 40, 35, 0.03);
  --zy-shadow-md: 0 8rpx 24rpx -8rpx rgba(42, 40, 35, 0.10);
  --zy-shadow-lg: 0 16rpx 48rpx -16rpx rgba(42, 40, 35, 0.16);
  --zy-shadow-float-tabbar: 0 -4rpx 32rpx rgba(42, 40, 35, 0.08);

  --shadow-soft: 0 2rpx 6rpx rgba(42, 40, 35, 0.04), 0 1rpx 3rpx rgba(42, 40, 35, 0.03);
  --shadow-xs: 0 1rpx 3rpx rgba(42, 40, 35, 0.03);
  --shadow-md: 0 4rpx 12rpx rgba(42, 40, 35, 0.05), 0 1rpx 4rpx rgba(42, 40, 35, 0.03);
  --shadow-lg: 0 8rpx 24rpx -8rpx rgba(42, 40, 35, 0.10);
  --shadow-float: 0 -4rpx 32rpx rgba(42, 40, 35, 0.08);

  /* ===== 发光阴影 ===== */
  --shadow-glow-primary: 0 8rpx 24rpx rgba(79, 94, 53, 0.30);
  --shadow-glow-primary-soft: 0 4rpx 12rpx rgba(79, 94, 53, 0.18);
  --shadow-glow-primary-lg: 0 16rpx 40rpx rgba(79, 94, 53, 0.38);
  --shadow-glow-primary-btn: 0 6rpx 16rpx rgba(79, 94, 53, 0.30);
  --shadow-glow-primary-xs: 0 2rpx 6rpx rgba(79, 94, 53, 0.18);
  --shadow-glow-mall: 0 8rpx 24rpx rgba(184, 137, 58, 0.30);
  --shadow-glow-coupon: 0 8rpx 24rpx rgba(184, 137, 58, 0.35);

  /* ===== 功能色（PETLUX 语义状态色） ===== */
  --success-color: #5B7C4A;
  --warning-color: #B8893A;
  --error-color: #A85B4A;
  --info-color: #6B7D8C;

  /* ===== 订单状态色 ===== */
  --status-pending: #B8893A;
  --status-active: #6B7D8C;
  --status-completed: #5B7C4A;
  --status-cancelled: #9A9489;

  /* ===== 语义补齐 ===== */
  --gray-100: #F8FAF3;                /* 橄榄调暖白（对齐 PETLUX 页底） */
  --gray-450: #9A9489;
  --gray-350: #C9CFBA;
  --activity-primary-mid: #6B7D5A;
  --text-gold: #B8893A;

  /* ===== 圆角（PETLUX 克制圆角 4/8/12/16px） ===== */
  --border-radius-xs: 8rpx;            /* 4px — 小标签、芯片 */
  --border-radius-sm: 16rpx;           /* 8px — 小卡片、输入框 */
  --border-radius-md: 24rpx;           /* 12px — 中卡片、按钮 */
  --border-radius-lg: 32rpx;           /* 16px — 大卡片（默认） */
  --border-radius-xl: 32rpx;
  --border-radius-2xl: 32rpx;          /* 卡片默认 */
  --border-radius-3xl: 32rpx;
  --border-radius-4xl: 32rpx;
  --border-radius-pill: 999rpx;        /* 药丸 — 按钮、标签 */

  /* ===== 排版层级（PETLUX Typography — px→rpx 2x） ===== */
  --text-display: 64rpx;               /* 32px — 首屏大标题 */
  --text-h1: 48rpx;                    /* 24px — 页面标题 */
  --text-h2: 40rpx;                    /* 20px — 区块标题 */
  --text-h3: 34rpx;                    /* 17px — 卡片标题 */
  --text-body: 30rpx;                  /* 15px — 正文 */
  --text-body-sm: 26rpx;               /* 13px — 小正文 */
  --text-caption: 24rpx;               /* 12px — 辅助/说明 */
  --leading-tight: 1.2;
  --leading-normal: 1.55;
  --leading-relaxed: 1.7;
  --tracking-tight: -0.02em;
  --tracking-normal: 0;
  --tracking-wide: 0.01em;

  /* ===== 间距（PETLUX 8pt 网格 — px→rpx 2x） ===== */
  --space-1: 8rpx;                     /* 4px */
  --space-2: 16rpx;                    /* 8px */
  --space-3: 24rpx;                    /* 12px */
  --space-4: 32rpx;                    /* 16px */
  --space-5: 48rpx;                    /* 24px */
  --space-6: 64rpx;                    /* 32px */
  --space-7: 96rpx;                    /* 48px */

  /* ===== 板块色（统一向橄榄绿家族靠拢，保留各板块辨识度） ===== */
  --boarding-primary: #C08060;          /* 寄养 暖陶土（暖调区分） */
  --boarding-secondary: #D49E80;
  --boarding-accent: #F0E0D4;
  --boarding-gradient: linear-gradient(135deg, #C08060 0%, #D49E80 100%);
  --boarding-tint: rgba(192, 128, 96, 0.10);

  --activity-primary: #7A8C5A;          /* 活动 橄榄绿（品牌家族） */
  --activity-secondary: #9AAB7A;
  --activity-accent: #EAEDDF;
  --activity-gradient: linear-gradient(135deg, #7A8C5A 0%, #9AAB7A 100%);
  --activity-tint: rgba(122, 140, 90, 0.10);

  --mall-primary: #B8893A;             /* 商城 暖金 */
  --mall-secondary: #D4A858;
  --mall-accent: #F2E8D4;
  --mall-gradient: linear-gradient(135deg, #B8893A 0%, #D4A858 100%);
  --mall-tint: rgba(184, 137, 58, 0.10);

  --feeding-primary: #7C9468;          /* 服务 鼠尾草绿 */
  --feeding-secondary: #9AB488;
  --feeding-accent: #E8EFE0;
  --feeding-gradient: linear-gradient(135deg, #7C9468 0%, #9AB488 100%);
  --feeding-tint: rgba(124, 148, 104, 0.10);

  --tuan-primary: #B07560;              /* 团购 暖陶土玫瑰 */
  --tuan-secondary: #C99480;
  --tuan-accent: #F0DEDE;
  --tuan-gradient: linear-gradient(135deg, #B07560 0%, #C99480 100%);
  --tuan-tint: rgba(176, 117, 96, 0.10);

  /* ===== 券渐变 ===== */
  --coupon-gradient: linear-gradient(135deg, #4F5E35 0%, #3A4626 100%);

  /* ===== 骨架屏 ===== */
  --skeleton-base: #E2E6D3;
}

/* ===== 暗色模式（手动切换 data-theme="dark"） ===== */
[data-theme="dark"] {
  --primary-color: #7A8C5A;
  --secondary-color: #9AAB7A;
  --background-color: #1A1916;
  --card-color: #262420;
  --text-primary: #EDE9E0;
  --text-secondary: #9A9489;
  --text-tertiary: #635E54;
  --border-color: #3A3830;
  --divider-color: #2A2924;
  --surface-tint: #262420;
  --overlay-color: rgba(0, 0, 0, 0.7);
}
