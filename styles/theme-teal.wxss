/* ================================================================
   theme-teal.wxss · AROORO 高奢视觉主题 v2
   方向：Haute-Luxury · Artistic Whitespace · Editorial Minimalism
   ----------------------------------------------------------------
   设计参考：Hermès / Chanel / Dior / The Row / Loewe
   核心哲学：
     · 少即是多——每一个像素都有理由存在
     · 奶油米白底 + 深森林绿主色 + 香槟金点缀
     · 发丝描边取代阴影，直角/微圆角取代大圆角
     · 艺术级留白：外侧 48rpx+ 边距，章节间距 ≥ 120rpx
     · 排版像杂志：大字重标题 + 轻正文 + 宽字距小标签
     · 图片优先：全出血大图 + 克制文案
   Skyline 兼容：不使用 :active / text-transform / backdrop-filter / sticky
   ================================================================ */

/* ===== 暗色模式 ===== */
.theme-dark {
  --primary-color: #3D6B3D;
  --primary-deep: #1F3A1F;
  --secondary-color: #4A8A4A;
  --background-color: #121310;
  --background-warm: #181915;
  --card-color: #1E1F1B;
  --card-cream: #252621;
  --ink-black: #F0EDE4;
  --text-primary: #F0EDE4;
  --text-secondary: #A39E90;
  --text-tertiary: #6E6A5E;
  --border-color: #2E2F29;
  --border-soft: #252621;
  --divider-color: #252621;
  --hairline: rgba(240, 237, 228, 0.08);
  --gray-50: #181915;
  --gray-100: #1E1F1B;
  --gray-200: #2E2F29;
  --gray-900: #F0EDE4;
  --surface-tint: #252621;
  --overlay-color: rgba(0, 0, 0, 0.75);
  --zy-bg: #121310;
  --zy-surface: #1E1F1B;
  --zy-text-1: #F0EDE4;
  --zy-text-2: #A39E90;
  --zy-text-3: #6E6A5E;
  --zy-border: #2E2F29;
  --zy-divider: #252621;

  /* ===== Plain Sheet（暗态） ===== */
  --sheet-paper: #161713;
  --card-satin: #1A1C16;                      /* 卡底，必须比 --sheet-paper 亮一档，卡才浮得起来 */
  --text-on-glass: #F0EDE4;
  --text-on-glass-2: #CFCABA;
  --hairline-glass: rgba(240, 237, 228, 0.16);
  --skeleton-base: #23251E;                   /* 暗态补档：亮态 #ECE8DE 在暗底会成刺眼白块占位 */
  --skeleton-shimmer: rgba(255, 255, 255, 0.14); /* 暗态压低高光，避免扫光变成白闪 */
}

/* ===== 毛玻璃降级 ===== */
.zy-glass {
  background: rgba(255, 255, 255, 0.92);
  border-top: 1rpx solid rgba(214, 210, 199, 0.3);
}
