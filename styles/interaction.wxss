/**
 * 全局交互优化样式规范
 * 用于统一小程序的触摸、点击和滑动交互效果
 * 确保操作响应迅速流畅，触控区域符合人机工程学标准
 */

/* ==================== 触控区域标准 ==================== */

/* 最小触控目标尺寸 - 88rpx (44px) 符合iOS和Android人机工程学标准 */
:root {
  --min-touch-size: 88rpx;
  --touch-size-small: 72rpx;
  --touch-size-medium: 96rpx;
  --touch-size-large: 120rpx;
}

/* 增大触控区域的通用类 - 适用于小图标或小按钮 */
.touch-enlarged {
  position: relative;
  min-width: var(--min-touch-size);
  min-height: var(--min-touch-size);
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

/* 小图标使用伪元素扩大触控区域 */
.touch-enlarged::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: var(--min-touch-size);
  height: var(--min-touch-size);
  z-index: -1;
}

/* ==================== 按钮优化 ==================== */

/* 主要操作按钮 - 大触控区域 */
.button-primary {
  min-height: var(--touch-size-medium);
  padding: 0 var(--touch-size-medium);
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 500;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

/* 次要操作按钮 - 中等触控区域 */
.button-secondary {
  min-height: 72rpx;
  min-width: 140rpx;
  padding: 0 40rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* 小按钮 - 图标按钮 */
.button-small {
  min-width: 60rpx;
  min-height: 60rpx;
  padding: 0;
  border-radius: 8rpx;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

/* 图标按钮 - 用于编辑、删除等操作 */
.button-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
}

/* 圆形操作按钮 - 用于浮动操作 */
.button-circle {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.15);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  z-index: 100;
}

/* ==================== 点击反馈效果 ==================== */

/* 点击按下效果 */
:active {
  opacity: 0.85;
}

/* 按钮点击效果 */
.button-primary:active,
.button-secondary:active,
.button-small:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.button-icon:active,
.button-circle:active {
  transform: scale(0.95);
  opacity: 0.85;
}

/* 列表项点击效果 */
.list-item {
  transition: background-color 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.list-item:active {
  background-color: rgba(0, 0, 0, 0.05);
}

/* 卡片点击效果 */
.card-item {
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.card-item:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

/* ==================== 过渡动画统一 ==================== */

/* 快速过渡 - 用于状态切换 */
.transition-fast {
  transition: all 0.15s cubic-bezier(0.4, 0, 0.2, 1);
}

/* 标准过渡 - 用于一般交互 */
.transition-normal {
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* 慢速过渡 - 用于复杂动画 */
.transition-slow {
  transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}

/* 特定属性过渡 */
.transition-opacity {
  transition: opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.transition-transform {
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.transition-background {
  transition: background-color 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* ==================== 滑动优化 ==================== */

/* 滑动容器 - 防止误触 */
.scroll-container {
  -webkit-overflow-scrolling: touch;
  scroll-behavior: smooth;
  overflow-y: auto;
  overflow-x: hidden;
}

/* 横向滑动容器 */
.scroll-horizontal {
  white-space: nowrap;
  overflow-x: auto;
  overflow-y: hidden;
  -webkit-overflow-scrolling: touch;
  scroll-behavior: smooth;
}

/* 隐藏滚动条 */
.scroll-no-scrollbar::-webkit-scrollbar {
  display: none;
}

/* ==================== 防止误触 ==================== */

/* 增加点击区域之间的间距 */
.gap-safe {
  gap: 20rpx;
}

.gap-touch {
  gap: 24rpx;
}

/* 防止误触的透明层 */
.touch-guard {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  pointer-events: none;
}

/* 阻止事件冒泡 */
.no-bubble {
  pointer-events: none;
}

/* ==================== 焦点状态 ==================== */

/* 按钮聚焦效果（无障碍支持） */
.button-primary:focus,
.button-secondary:focus,
.button-icon:focus {
  outline: none;
  box-shadow: 0 0 0 4rpx rgba(0, 122, 255, 0.3);
}

/* ==================== 加载状态 ==================== */

/* 按钮加载状态 */
.button-loading {
  opacity: 0.7;
  pointer-events: none;
}

.button-loading::after {
  content: '';
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* ==================== 禁用状态 ==================== */

/* 按钮禁用状态 */
.button-disabled {
  opacity: 0.5;
  pointer-events: none;
  filter: grayscale(100%);
}

/* ==================== 响应式适配 ==================== */

/* 小屏幕适配 */
@media (max-width: 375px) {
  :root {
    --min-touch-size: 80rpx;
    --touch-size-small: 64rpx;
    --touch-size-medium: 88rpx;
    --touch-size-large: 110rpx;
  }
}

/* 大屏幕适配 */
@media (min-width: 768px) {
  :root {
    --min-touch-size: 96rpx;
    --touch-size-small: 80rpx;
    --touch-size-medium: 104rpx;
    --touch-size-large: 128rpx;
  }
}

/* ==================== 触觉反馈 ==================== */

/* 触觉反馈类 - 配合wx.vibrateShort使用 */
.haptic-feedback:active {
  /* 视觉反馈 */
  transform: scale(0.97);
}

/* ==================== 悬浮按钮 ==================== */

/* 浮动操作按钮组 */
.fab-group {
  position: fixed;
  bottom: 40rpx;
  right: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  z-index: 1000;
}

.fab-item {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.fab-item:active {
  transform: scale(0.95);
}

/* ==================== 列表优化 ==================== */

/* 列表项触控区域 */
.list-item-touch {
  min-height: 120rpx;
  padding: 24rpx 32rpx;
  transition: background-color 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.list-item-touch:active {
  background-color: rgba(0, 0, 0, 0.05);
}

/* ==================== 输入控件优化 ==================== */

/* 输入框触控区域 */
.input-wrapper {
  min-height: 88rpx;
  padding: 0 24rpx;
  border-radius: 12rpx;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.input-wrapper:focus-within {
  box-shadow: 0 0 0 4rpx rgba(0, 122, 255, 0.2);
}

/* 开关按钮触控区域 */
.switch-touch {
  min-width: 104rpx;
  min-height: 60rpx;
}

/* ==================== 选择器优化 ==================== */

/* 单选/多选按钮 */
.radio-button,
.checkbox-button {
  min-width: 48rpx;
  min-height: 48rpx;
  padding: 8rpx;
  border-radius: 50%;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.radio-button:active,
.checkbox-button:active {
  transform: scale(0.95);
}
