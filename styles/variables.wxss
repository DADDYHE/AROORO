/* ============================================================
   variables.wxss · 补充令牌层（任务 #10 去重后残余）
   ------------------------------------------------------------
   ⚠ 防复发约定（改动本文件前必读）
   1. 本文件**不得声明 theme-teal.wxss 已有的令牌**。
      theme-teal.wxss 是全站唯一的运行时生效层（app.wxss 中最后 import，
      且 custom-tab-bar 单独 import 的也是它）。在本文件重复声明同名令牌，
      运行时一定被 theme-teal 覆盖 = 纯冗余，还会让人误以为改这里有用。
   2. 新增令牌请直接加到 styles/theme-teal.wxss，不要加在这里。
   3. 守卫会拦：`node scripts/lint-tokens.js` 规则 C（同名跨文件冲突）应恒为 0；
      层叠等价性由 `node scripts/verify-token-cascade.js` 验收。
   ------------------------------------------------------------
   历史：本文件原为 PETLUX 橄榄绿坐标系全量令牌（290 行），与 theme-teal
   有 108 处同名取值冲突，仅靠 @import 顺序压制。#10 已按「theme-teal 有
   同名即删」删除 157 行，只保留 theme-teal 未定义的独有令牌。
   ============================================================ */

page {
  /* ---- 通用渐变 ----
     注：原先此处有 --boarding/activity/feeding/tuan-gradient 四条「按板块分色」渐变，
     全为旧橄榄/陶土坐标。唯一活体消费点是 order-detail 状态横幅误借 --feeding-gradient，
     已改接 --status-progress 档位；四条降为零引用死码，#13 追加项①已整体删除。
     业务线单色若日后需要，theme-teal 有 --boarding/activity/feeding-primary，不要在此重建渐变。 */
  --gradient-accent: linear-gradient(135deg, #C9A24B 0%, #A8894A 100%);    /* 规范金，无需改 */
  --gradient-light: linear-gradient(135deg, #F8FAF3 0%, #FFFFFF 100%);     /* 0 引用；#F8FAF3 为旧橄榄底 */
  /* #10 已按裁定改值：原值为「墨黑 → 深橄榄」两段旧坐标写死色（桶①b 唯一命中项）。
     改用 var() 引用 theme-teal 真值，从结构上杜绝再次漂移。
     注：此处刻意不复述旧色号字面量，否则守卫的注释内扫描会把它重新计成一次旧坐标泄漏。 */
  --gradient-dark: linear-gradient(135deg, var(--ink-black) 0%, var(--primary-deep) 100%);

  /* ---- theme-teal 未覆盖的阴影档位 ---- */
  --shadow-3xl: 0 32px 48px rgba(0,0,0,0.12);
  --shadow-inner: inset 0 2px 4px rgba(0,0,0,0.06);

  /* ---- 仅 web-admin(Vue) 引用，小程序侧无消费 ---- */
  --radius-lg: 32rpx;

  /* ================================================================
     奢侈品级令牌 — Haute-Luxury Elevation Layer
     ----------------------------------------------------------------
     金属质感、层次阴影与编辑级排版细节。theme-teal 未定义 --lux-*，
     故整层保留在此。partner 子包与高奢页面大量引用。
     Skyline 兼容：仅用 transform/opacity 做过渡，无 backdrop-filter。
     ================================================================ */

  /* ---- 金属香槟金阶（用于强调数字、徽章描边、渐变高光） ---- */
  /* P0-2 收敛：-300/-400/-700 已删档，收敛为两档金 主金 -500 #C9A24B / 深金 -600 #A8894A */
  --lux-gold-100: #FDF8EE;   /* 最浅：金箔底纹 */
  --lux-gold-200: #F5EBD0;   /* 浅金：柔和高光 */
  --lux-gold-500: #C9A24B;   /* 香槟金：品牌点缀锚点 */
  --lux-gold-600: #A8894A;   /* 深金：描边/按下深态 B′ */
  --lux-gold-grad: linear-gradient(135deg, #C9A24B 0%, #A8894A 100%);

  /* ---- 深森林绿阶（用于深色卡片底、品牌头部、渐变深停） ---- */
  --lux-green-900: #1A2E1A;  /* 极深：暗调底/深色卡 */
  --lux-green-800: #1F3A1F;  /* 深森林 */
  --lux-green-700: #2D4A2D;  /* 中深：按下态 */
  --lux-green-600: #3D5A3D;  /* 中：结构色 */
  --lux-green-grad: linear-gradient(160deg, #2D4A2D 0%, #1A2E1A 100%);
  --lux-green-grad-rich: linear-gradient(135deg, #3D5A3D 0%, #1F3A1F 50%, #1A2E1A 100%);

  /* ---- 层次阴影系统（取代单一 flat hairline，增加纵深） ---- */
  --lux-shadow-card: 0 1rpx 2rpx rgba(26,26,23,0.03), 0 4rpx 16rpx rgba(26,26,23,0.05);
  --lux-shadow-elevated: 0 2rpx 4rpx rgba(26,26,23,0.04), 0 8rpx 32rpx rgba(26,26,23,0.08);
  --lux-shadow-gold: 0 2rpx 8rpx rgba(201,162,75,0.12), 0 8rpx 24rpx rgba(201,162,75,0.16);
  --lux-shadow-green: 0 2rpx 8rpx rgba(31,58,31,0.12), 0 8rpx 24rpx rgba(31,58,31,0.18);
  --lux-shadow-fab: 0 8rpx 32rpx rgba(31,58,31,0.30), 0 2rpx 8rpx rgba(31,58,31,0.15);

  /* ---- 发丝描边渐变（卡片边框从纯线升级为微妙渐变） ---- */
  --lux-hairline: rgba(26,26,23,0.06);
  --lux-hairline-gold: rgba(201,162,75,0.18);
  --lux-hairline-green: rgba(31,58,31,0.10);
  --lux-border-grad: linear-gradient(180deg, rgba(26,26,23,0.06) 0%, rgba(26,26,23,0.04) 100%);

  /* ---- 编辑级排版令牌 ---- */
  --lux-ls-display: 0.16em;    /* 大标题：宽幅字距 */
  --lux-ls-heading: 0.08em;    /* 标题 */
  --lux-ls-label: 0.24em;      /* 小标签/eyebrow */
  --lux-ls-caption: 0.04em;    /* 说明文字 */
  --lux-ls-number: 0.01em;     /* 数字（紧凑） */

  /* ---- 奢侈级圆角（更克制，配合层次阴影） ---- */
  --lux-radius-card: 40rpx;       /* 主卡片（P0-4 升档：20→40） */
  --lux-radius-inner: 32rpx;      /* 卡片内元素（P0-4 升档：16→32） */
  --lux-radius-pill: 9999rpx;     /* 胶囊按钮 */

  /* ---- 金线装饰令牌 ---- */
  --lux-gold-line: linear-gradient(90deg, transparent 0%, #C9A24B 50%, transparent 100%);
  --lux-gold-line-solid: linear-gradient(90deg, #C9A24B 0%, #A8894A 100%);

  /* ---- 卡片底纹令牌 ---- */
  --lux-card-bg: #FFFFFF;
  --lux-card-cream: #FDFAF3;      /* 暖奶油卡片底 */
  --lux-card-gold-tint: #FDF8EE;  /* 金箔底纹卡 */
  --lux-card-green-tint: #F5F8F2; /* 森林浅底卡 */
}

/* 暗色模式：原 .theme-dark 块的 15 条声明已全部由 theme-teal.wxss 的 .theme-dark
   覆盖（同为类选择器，theme-teal 后声明胜出），属纯冗余，#10 已整块删除。
   暗色令牌请统一改 styles/theme-teal.wxss 的 .theme-dark 块。 */
