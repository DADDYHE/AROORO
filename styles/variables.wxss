/* 设计系统变量 - PETLUX 橄榄绿治愈轻奢美学 */

/* 品牌颜色 */
page {
  /* 主色 — 橄榄绿（PETLUX 品牌锚点） */
  --primary-color: #4F5E35;    /* 橄榄绿 */
  /* 辅助色 */
  --secondary-color: #3A4626;  /* 深橄榄 */
  /* 点缀色 */
  --accent-color: #B8893A;     /* 暖金 */

  /* 中性色 — 橄榄调暖白 */
  --background-color: #F8FAF3;  /* 橄榄调暖白背景（已减淡） */
  --card-color: #FFFFFF;        /* 卡片白色 */
  --text-primary: #2A2823;      /* 主要文字 暖墨 */
  --text-secondary: #635E54;    /* 次要文字 */
  --text-tertiary: #9A9489;     /* 三级文字 */
  --border-color: #D8DCCE;      /* 边框颜色 橄榄调 */
  --divider-color: #EAEDDF;     /* 分割线颜色 */
  --overlay-color: rgba(42, 40, 35, 0.5);  /* 遮罩颜色 */
  
  /* 扩展中性色 - 苹果风格精致灰阶 */
  --gray-50: #F9F9F9;
  --gray-100: #F5F5F7;
  --gray-200: #E5E5EA;
  --gray-300: #D2D2D7;
  --gray-400: #C7C7CC;
  --gray-500: #AEAEB2;
  --gray-600: #86868B;
  --gray-700: #636366;
  --gray-800: #48484A;
  --gray-900: #3A3A3C;
  --gray-950: #2C2C2E;
  
  /* 功能色 — PETLUX 语义状态色 */
  --success-color: #5B7C4A;
  --warning-color: #B8893A;
  --error-color: #A85B4A;
  --info-color: #6B7D8C;

  /* 订单状态色 */
  --status-pending: #B8893A;
  --status-active: #6B7D8C;
  --status-completed: #5B7C4A;
  --status-cancelled: #9A9489;
  
  /* 板块主题色 - 艺术展美学增强版 */
  /* 寄养板块 — 暖陶土 */
  --boarding-primary: #C08060;
  --boarding-secondary: #D49E80;
  --boarding-accent: #F0E0D4;
  --boarding-gradient: linear-gradient(135deg, #C08060 0%, #D49E80 100%);

  /* 活动板块 — 橄榄绿（品牌家族） */
  --activity-primary: #7A8C5A;
  --activity-secondary: #9AAB7A;
  --activity-accent: #EAEDDF;
  --activity-gradient: linear-gradient(135deg, #7A8C5A 0%, #9AAB7A 100%);

  /* 商城板块 — 暖金 */
  --mall-primary: #B8893A;
  --mall-secondary: #D4A858;
  --mall-accent: #F2E8D4;
  --mall-gradient: linear-gradient(135deg, #B8893A 0%, #D4A858 100%);

  /* 喂养板块 — 鼠尾草绿 */
  --feeding-primary: #7C9468;
  --feeding-secondary: #9AB488;
  --feeding-accent: #E8EFE0;
  --feeding-gradient: linear-gradient(135deg, #7C9468 0%, #9AB488 100%);

  /* 团购板块 — 暖陶土玫瑰 */
  --tuan-primary: #B07560;
  --tuan-secondary: #C99480;
  --tuan-accent: #F0DEDE;
  --tuan-gradient: linear-gradient(135deg, #B07560 0%, #C99480 100%);

  /* 板块色低透明度浅底 */
  --boarding-tint: rgba(192, 128, 96, 0.10);
  --activity-tint: rgba(122, 140, 90, 0.10);
  --mall-tint: rgba(184, 137, 58, 0.10);
  --feeding-tint: rgba(124, 148, 104, 0.10);
  --tuan-tint: rgba(176, 117, 96, 0.10);
  
  /* 渐变色 - PETLUX 橄榄绿 */
  --gradient-primary: linear-gradient(135deg, #4F5E35 0%, #3A4626 100%);
  --gradient-secondary: linear-gradient(135deg, #7A8C5A 0%, #6B7D5A 100%);
  --gradient-accent: linear-gradient(135deg, #B8893A 0%, #9A7430 100%);
  --gradient-light: linear-gradient(135deg, #F8FAF3 0%, #FFFFFF 100%);
  --gradient-dark: linear-gradient(135deg, #2A2823 0%, #3A4626 100%);
  
  /* 字体 - 系统字体栈（含中文，跨端稳定，2026-07-26 评审修正：原 SF Pro 为 iOS 私有且无法加载中文字形） */
  --font-stack: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  --font-bold: var(--font-stack);
  --font-regular: var(--font-stack);
  --font-light: var(--font-stack);
  --font-thin: var(--font-stack);
  --font-semibold: var(--font-stack);
  --font-heavy: var(--font-stack);
  
  /* 字号 */
  --font-size-xxxl: 28px;
  --font-size-xxl: 24px;
  --font-size-xl: 20px;
  --font-size-lg: 18px;
  --font-size-md: 16px;
  --font-size-sm: 14px;
  --font-size-xs: 12px;
  --font-size-xxs: 10px;
  
  /* 行高 */
  --line-height-title: 1.05;
  --line-height-text: 1.4;
  --line-height-tight: 1.2;
  --line-height-loose: 1.6;
  
  /* 字间距 */
  --letter-spacing-tight: -0.02em;
  --letter-spacing-normal: 0;
  --letter-spacing-wide: 0.01em;
  --letter-spacing-wider: 0.02em;
  
  /* 间距 - 统一 rpx（750 视口基准，1px≈2rpx，2026-07-26 评审修正：原 px 与页面 rpx 割裂） */
  --spacing-xxxxs: 2rpx;
  --spacing-xxxs: 4rpx;
  --spacing-xxs: 8rpx;
  --spacing-xs: 16rpx;
  --spacing-sm: 24rpx;
  --spacing-md: 32rpx;
  --spacing-lg: 48rpx;
  --spacing-xl: 64rpx;
  --spacing-xxl: 80rpx;
  --spacing-xxxl: 96rpx;
  --spacing-xxxxl: 128rpx;
  --spacing-xxxxxl: 160rpx;
  
  /* 圆角 - 统一 rpx（2026-07-26 评审修正） */
  --border-radius-xs: 8rpx;
  --border-radius-sm: 16rpx;
  --border-radius-md: 24rpx;
  --border-radius-lg: 32rpx;
  --border-radius-xl: 40rpx;
  --border-radius-2xl: 48rpx;
  --border-radius-3xl: 56rpx;
  --border-radius-4xl: 64rpx;
  --border-radius-full: 9999rpx;
  
  /* 阴影 - 苹果风格自然阴影 */
  --shadow-xs: 0 1px 2px rgba(0,0,0,0.02);
  --shadow-sm: 0 2px 4px rgba(0,0,0,0.03);
  --shadow-md: 0 4px 8px rgba(0,0,0,0.04);
  --shadow-lg: 0 8px 16px rgba(0,0,0,0.06);
  --shadow-xl: 0 16px 24px rgba(0,0,0,0.08);
  --shadow-2xl: 0 24px 32px rgba(0,0,0,0.10);
  --shadow-3xl: 0 32px 48px rgba(0,0,0,0.12);
  --shadow-inner: inset 0 2px 4px rgba(0,0,0,0.06);
  --shadow-soft: 0 8px 32px rgba(0,0,0,0.08);
  
  /* 动画 - 已清除，时长归零（保留变量名避免引用断裂） */
  --transition-fast: 0s cubic-bezier(0.4, 0, 0.2, 1);
  --transition-normal: 0s cubic-bezier(0.4, 0, 0.2, 1);
  --transition-slow: 0s cubic-bezier(0.4, 0, 0.2, 1);
  --transition-bounce: 0s cubic-bezier(0.68, -0.55, 0.265, 1.55);
  --transition-smooth: 0s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  --transition-elastic: 0s cubic-bezier(0.68, -0.55, 0.265, 1.55);
  
  /* 布局 */
  --header-height: 44px;
  --tabbar-height: 50px;
  --list-item-height: 56px;
  --card-padding: var(--spacing-lg);
  --container-max-width: 750rpx;
  
  /* 安全区域 */
  --safe-area-top: env(safe-area-inset-top, 0px);
  --safe-area-bottom: env(safe-area-inset-bottom, 0px);
  
  /* Z-index层级 */
  --z-index-dropdown: 1000;
  --z-index-sticky: 1020;
  --z-index-fixed: 1030;
  --z-index-modal-backdrop: 1040;
  --z-index-modal: 1050;
  --z-index-popover: 1060;
  --z-index-tooltip: 1070;
  --z-index-toast: 1080;

  /* 补充设计令牌 */
  --metallic-gold-dark: #A88030;
  --shadow-glow-primary: 0 8rpx 24rpx rgba(79, 94, 53, 0.35);
  --shadow-glow-primary-soft: 0 4rpx 12rpx rgba(79, 94, 53, 0.2);
  --shadow-glow-primary-lg: 0 16rpx 40rpx rgba(79, 94, 53, 0.45);
  --shadow-glow-primary-btn: 0 6rpx 16rpx rgba(79, 94, 53, 0.3);
  --shadow-glow-primary-xs: 0 2rpx 6rpx rgba(79, 94, 53, 0.18);
  --shadow-glow-mall: 0 8rpx 24rpx rgba(184, 137, 58, 0.35);
  --shadow-glow-coupon: 0 8rpx 24rpx rgba(184, 137, 58, 0.35);
  --shadow-emboss: inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
  --radius-lg: 32rpx;
  --skeleton-base: #EAEAEF;

  /* 语义 token（供 lint 收敛残留 hex） */
  --surface-tint: #FAFAFA;          /* 近白卡片底，替代散落的 #FAFAFA */
  --gray-450: #A0A0A0;              /* 替代 #a0a0a0 */
  --gray-350: #C0C0C0;              /* 替代 #c0c0c0 */
  --activity-primary-mid: #2AB7A9;  /* 活动渐变深停，替代 #2AB7A9/#3DB5AD/#45B7AA/#44a08d */
  --text-gold: #C4843D;             /* 金色提示文案 */
  --tap-target-min: 80rpx;          /* 最小可点击区（WCAG 亲和点） */
}

/* 暗色模式（手动切换 data-theme="dark"，PETLUX 暗色） */
[data-theme="dark"] {
  --primary-color: #7A8C5A;
  --secondary-color: #9AAB7A;
  --background-color: #1A1916;
  --card-color: #262420;
  --text-primary: #EDE9E0;
  --text-secondary: #9A9489;
  --text-tertiary: #635E54;
  --border-color: #3A3830;
  --divider-color: #2A2924;
  --gray-50: #262420;
  --gray-100: #1A1916;
  --gray-200: #2A2924;
  --gray-900: #EDE9E0;
  --surface-tint: #262420;
  --overlay-color: rgba(0, 0, 0, 0.7);
}
