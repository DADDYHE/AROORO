/* ================================================================
   lux-page.wxss · A+B 版式全局类（2026-09-09 全站升级方案 Phase 0）
   ----------------------------------------------------------------
   B1 = 深绿沉浸标题版 hero；A = 整版纸面流（14% 墨行线）。
   由 app.wxss @import 全局注入，分包零体积重复。
   基准页：booking/invitation-fill、pet/list、booking/host-detail。
   ⚠ 纸面行线一律 rgba(26,26,23,0.14)；纸面金字一律 --lux-gold-ink；
     深绿底金字用 --lux-gold-500。Skyline：transition 仅 transform/opacity。
   ================================================================ */

/* ===== B1 · 深绿沉浸标题版 hero（顶天，无图） ===== */
.lux-hero {
  position: relative;
  width: 100%;
  /* min-height 跟随内容，状态栏高的机型不裁切标题 */
  min-height: 320rpx;
  padding: 0 var(--page-padding) 56rpx;
  box-sizing: border-box;
  background: var(--lux-green-grad-rich);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  gap: 10rpx;
  overflow: hidden;
}

.lux-hero-eyebrow {
  font-size: 20rpx;
  color: var(--lux-gold-500);
  letter-spacing: var(--lux-ls-label, 0.24em);
  font-weight: 400;
}

.lux-hero-title {
  font-size: 44rpx;
  color: var(--text-on-primary);
  letter-spacing: var(--lux-ls-heading, 0.08em);
  font-weight: 500;
  line-height: 1.2;
}

.lux-hero-sub {
  font-size: 24rpx;
  color: var(--text-on-primary);
  opacity: 0.72;
  letter-spacing: var(--lux-ls-caption, 0.04em);
  line-height: 1.4;
}

/* hero 内大数字（收入/总额等数据面板副行主值档） */
.lux-hero-num {
  font-size: 56rpx;
  color: var(--text-on-primary);
  font-weight: 500;
  letter-spacing: var(--lux-ls-number, 0.01em);
  line-height: 1.2;
}

/* 封口金线：深绿与纸面的分界 */
.lux-hero-sealline {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 1rpx;
  background: var(--lux-gold-line);
}

/* ===== A · 纸面流容器 ===== */
.lux-container {
  min-height: 60vh;
  padding: 48rpx var(--page-padding) calc(48rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 40rpx;
  box-sizing: border-box;
}

/* ===== 章节行：01 + EYEBROW + rule + action 槽 ===== */
.lux-chapter {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.lux-chapter-no {
  font-size: 24rpx;
  color: var(--lux-gold-ink);
  font-weight: 500;
  letter-spacing: var(--lux-ls-display, 0.16em);
}

.lux-chapter-eyebrow {
  font-size: 20rpx;
  color: var(--text-tertiary);
  letter-spacing: var(--lux-ls-label, 0.24em);
  font-weight: 400;
}

.lux-chapter-rule {
  flex: 1;
  height: 1rpx;
  background: rgba(26, 26, 23, 0.14);
}

.lux-section-title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: var(--lux-ls-heading, 0.08em);
  line-height: 1.3;
}

.lux-section-sub {
  font-size: 24rpx;
  color: var(--text-tertiary);
  letter-spacing: var(--lux-ls-caption, 0.04em);
  line-height: 1.6;
}

/* ===== A · 纸面行线 util ===== */
.lux-line-top {
  border-top: 1rpx solid rgba(26, 26, 23, 0.14);
}

.lux-line-bottom {
  border-bottom: 1rpx solid rgba(26, 26, 23, 0.14);
}

/* ===== A · 列表行骨架（拆白卡，行印纸面） ===== */
.lux-row {
  display: flex;
  align-items: center;
  padding: 28rpx var(--zy-space-sm2);
  position: relative;
  transition: transform 240ms cubic-bezier(0.25, 0.1, 0.25, 1),
              background-color 240ms cubic-bezier(0.25, 0.1, 0.25, 1);
}

.lux-row--pressed {
  background-color: rgba(26, 26, 23, 0.04);
}

.lux-row-divider {
  position: absolute;
  bottom: 0;
  left: var(--zy-space-sm2);
  right: var(--zy-space-sm2);
  height: 1rpx;
  background: rgba(26, 26, 23, 0.14);
}

/* ===== A · 表单行骨架（label 左 value 右） ===== */
.lux-field {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid rgba(26, 26, 23, 0.14);
}

.lux-field-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  letter-spacing: var(--lux-ls-caption, 0.04em);
  flex-shrink: 0;
  min-width: 160rpx;
}

.lux-field-value {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.5;
  text-align: right;
}

/* A-表单输入控件：透明底 + 16% 墨边（替代 --gray-50/--border-soft 纸面隐形） */
.lux-input {
  background: transparent;
  border: 1rpx solid rgba(26, 26, 23, 0.16);
  border-radius: var(--zy-radius-sm, 4rpx);
}
