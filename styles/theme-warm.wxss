/* ================================================================
   theme-warm.wxss · Smart Home Dashboard 风格（打样用）
   2026-07-26 基于 DADDY 提供的智能家居仪表盘参考图确立
   ----------------------------------------------------------------
   设计语言：
     冷灰白底 + 深海蓝绿品牌色 + 纯白卡片 + 超大圆角
     + 浅灰药丸分类条 + 大深色主卡+小白卡网格
     + 浮动 TabBar（白底圆角顶+居中蓝色圆钮）
   ================================================================ */

page {
  /* ===== 中性层（冷灰白，参考图同款底色） ===== */
  --background-color: #EEF2F6;        /* 冷灰白底 */
  --card-color: #FFFFFF;
  --surface-tint: #F4F7FA;           /* 次级表面/芯片底 */
  --text-primary: #1E3A4C;            /* 深墨蓝灰（非纯黑） */
  --text-secondary: #6B8299;          /* 中性蓝灰 */
  --text-tertiary: #9BB0C5;           /* 浅灰提示 */
  --border-color: #E2E8EF;            /* 极淡边框 */
  --divider-color: #F0F4F8;           /* 分割线 */
  --overlay-color: rgba(30, 58, 76, 0.35);

  /* ===== 品牌层（深海蓝绿，参考图主色调） ===== */
  --primary-color: #1B6B8C;           /* 深海蓝绿（参考图选中态/主按钮） */
  --primary-light: #E8F2F5;           /* 极浅蓝绿底（用于浅选中态） */
  --secondary-color: #4A9DB8;         /* 浅海蓝 */
  --accent-color: #F5A623;            /* 暖金点缀（极少用） */
  --gradient-primary: linear-gradient(135deg, #1B6B8C 0%, #248BA8 100%);
  --gradient-secondary: linear-gradient(135deg, #F5A623 0%, #F7C04B 100%);

  /* ===== 板块色（统一降饱和·向蓝绿色温靠拢） ===== */
  --boarding-primary: #E07850;        /* 寄养 柔珊瑚（暖调区分） */
  --boarding-secondary: #F09A78;
  --boarding-accent: #FAD4C4;

  --activity-primary: #5B8FBF;        /* 活动 海蓝 */
  --activity-secondary: #82ABD4;
  --activity-accent: #D4E4F4;

  --mall-primary: #8B7BC8;            /* 商城 柔靛紫 */
  --mall-secondary: #A99BD4;
  --mall-accent: #E8E2F4;

  --feeding-primary: #4AA8B8;         /* 服务 青绿 */
  --feeding-secondary: #74C4D2;
  --feeding-accent: #D4F0F4;

  --tuan-primary: #D46B7A;             /* 团购 柔玫瑰 */
  --tuan-secondary: #E094A0;
  --tuan-accent: #F8DEE2;

  /* 板块渐变 */
  --boarding-gradient: linear-gradient(135deg, #E07850 0%, #F09A78 100%);
  --activity-gradient: linear-gradient(135deg, #5B8FBF 0%, #82ABD4 100%);
  --mall-gradient: linear-gradient(135deg, #8B7BC8 0%, #A99BD4 100%);
  --feeding-gradient: linear-gradient(135deg, #4AA8B8 0%, #74C4D2 100%);
  --tuan-gradient: linear-gradient(135deg, #D46B7A 0%, #E094A0 100%);

  /* 板块浅底 tint */
  --boarding-tint: rgba(224, 120, 80, 0.10);
  --activity-tint: rgba(91, 143, 191, 0.10);
  --mall-tint: rgba(139, 123, 200, 0.10);
  --feeding-tint: rgba(74, 168, 184, 0.10);
  --tuan-tint: rgba(212, 107, 122, 0.10);

  /* ===== 圆角（超大圆角，参考图风格） ===== */
  --border-radius-lg: 24rpx;
  --border-radius-xl: 32rpx;
  --border-radius-2xl: 40rpx;         /* 卡片默认 */
  --border-radius-3xl: 48rpx;
  --border-radius-4xl: 56rpx;

  /* ===== 阴影（柔和扩散） ===== */
  --shadow-soft: 0 8rpx 32rpx rgba(30, 58, 76, 0.06);
  --shadow-md: 0 4rpx 16rpx rgba(30, 58, 76, 0.05);
  --shadow-lg: 0 12rpx 40rpx rgba(30, 58, 76, 0.08);
  --shadow-float: 0 -4rpx 32rpx rgba(30, 58, 76, 0.10);  /* 浮动 TabBar 用 */

  /* ===== 功能色 ===== */
  --success-color: #3DA86E;
  --warning-color: #E5A03C;
  --error-color: #D9534F;
  --info-color: #4A9DB8;

  /* ===== 字体栈 ===== */
  --font-regular: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  --font-semibold: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;

  /* ===== 动效 ===== */
  --transition-bounce: 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);

  /* ===== 发光阴影 ===== */
  --shadow-glow-primary: 0 8rpx 24rpx rgba(27, 107, 140, 0.30);
  --shadow-glow-primary-soft: 0 4rpx 12rpx rgba(27, 107, 140, 0.18);
  --shadow-glow-primary-lg: 0 16rpx 40rpx rgba(27, 107, 140, 0.38);
  --shadow-glow-mall: 0 8rpx 24rpx rgba(139, 123, 200, 0.30);

  /* ===== 语义补齐 ===== */
  --gray-450: #9BB0C5;
  --gray-350: #B8C9D6;
  --activity-primary-mid: #4A82AD;
  --text-gold: #B08840;
}
