/* 喂养板块样式 - 蓝色主题 */

/* 喂养板块容器 */
.feeding-container {
  background-color: var(--background-color);
  min-height: 100vh;
}

/* 喂养板块标题 */
.feeding-title {
  color: var(--feeding-primary);
  font-family: var(--font-bold);
  font-size: var(--font-size-xxl);
  margin-bottom: var(--spacing-lg);
}

/* 喂养人员卡片 */
.feeding-card {
  background: var(--card-color);
  border-radius: var(--border-radius-xl);
  box-shadow: var(--shadow-sm);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-lg);
  transition: all var(--transition-fast);
  border: 1px solid rgba(33, 150, 243, 0.1);
}

.feeding-card:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
  border-color: var(--feeding-primary);
}

/* 喂养人员信息 */
.feeding-info {
  display: flex;
  align-items: center;
  margin-bottom: var(--spacing-md);
}

.feeding-avatar {
  width: 60px;
  height: 60px;
  border-radius: var(--border-radius-full);
  object-fit: cover;
  margin-right: var(--spacing-md);
  border: 2px solid var(--feeding-primary);
}

.feeding-details {
  flex: 1;
}

.feeding-name {
  font-family: var(--font-bold);
  font-size: var(--font-size-lg);
  color: var(--text-primary);
  margin-bottom: var(--spacing-xs);
}

.feeding-rating {
  display: flex;
  align-items: center;
  margin-bottom: var(--spacing-xs);
}

.feeding-rating stars {
  color: var(--accent-color);
  margin-right: var(--spacing-xs);
}

.feeding-experience {
  font-size: var(--font-size-sm);
  color: var(--text-secondary);
  margin-bottom: var(--spacing-xs);
}

/* 服务信息 */
.feeding-services {
  margin-bottom: var(--spacing-md);
}

.feeding-services-title {
  font-family: var(--font-semibold);
  font-size: var(--font-size-sm);
  color: var(--text-primary);
  margin-bottom: var(--spacing-xs);
}

.feeding-service-tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-xs);
  margin-bottom: var(--spacing-md);
}

.feeding-service-tag {
  background: var(--feeding-accent);
  color: var(--feeding-primary);
  padding: var(--spacing-xxs) var(--spacing-xs);
  border-radius: var(--border-radius-full);
  font-size: var(--font-size-xs);
  font-weight: var(--font-semibold);
}

/* 价格信息 */
.feeding-price {
  font-family: var(--font-bold);
  font-size: var(--font-size-lg);
  color: var(--feeding-primary);
  margin-bottom: var(--spacing-md);
}

/* 喂养板块按钮 */
.feeding-btn {
  background: var(--feeding-gradient);
  color: var(--text-white);
  border: none;
  border-radius: var(--border-radius-md);
  padding: var(--spacing-md) var(--spacing-xl);
  font-family: var(--font-semibold);
  font-size: var(--font-size-md);
  transition: all var(--transition-fast);
  cursor: pointer;
}

.feeding-btn:hover {
  opacity: 0.9;
  transform: translateY(-1px);
  box-shadow: var(--shadow-md);
}

/* 喂养详情页 */
.feeding-detail {
  background: var(--card-color);
  border-radius: var(--border-radius-xl);
  padding: var(--spacing-xl);
  box-shadow: var(--shadow-sm);
}

.feeding-detail-avatar {
  width: 100px;
  height: 100px;
  border-radius: var(--border-radius-full);
  object-fit: cover;
  margin-bottom: var(--spacing-lg);
  border: 3px solid var(--feeding-primary);
}

.feeding-detail-name {
  font-family: var(--font-bold);
  font-size: var(--font-size-xxl);
  color: var(--text-primary);
  margin-bottom: var(--spacing-md);
}

.feeding-detail-info {
  margin-bottom: var(--spacing-lg);
}

.feeding-detail-description {
  font-size: var(--font-size-md);
  line-height: var(--line-height-text);
  color: var(--text-secondary);
  margin-bottom: var(--spacing-lg);
}

/* 喂养预订表单 */
.feeding-form {
  background: var(--card-color);
  border-radius: var(--border-radius-xl);
  padding: var(--spacing-lg);
  box-shadow: var(--shadow-sm);
}

.feeding-form label {
  display: block;
  font-family: var(--font-semibold);
  font-size: var(--font-size-sm);
  color: var(--text-primary);
  margin-bottom: var(--spacing-xs);
}

.feeding-form input,
.feeding-form textarea {
  width: 100%;
  padding: var(--spacing-md);
  border: 1px solid var(--border-color);
  border-radius: var(--border-radius-md);
  font-size: var(--font-size-md);
  margin-bottom: var(--spacing-md);
  transition: all var(--transition-fast);
}

.feeding-form input:focus,
.feeding-form textarea:focus {
  outline: none;
  border-color: var(--feeding-primary);
  box-shadow: 0 0 0 2px rgba(33, 150, 243, 0.1);
}

/* 喂养状态 */
.feeding-status {
  display: inline-block;
  padding: var(--spacing-xxs) var(--spacing-xs);
  border-radius: var(--border-radius-full);
  font-size: var(--font-size-xs);
  font-weight: var(--font-semibold);
}

.feeding-status-available {
  background: var(--success-color);
  color: var(--text-white);
}

.feeding-status-busy {
  background: var(--error-color);
  color: var(--text-white);
}

/* 喂养板块动画 */
.feeding-fade-in {
  animation: feedingFadeIn 0.5s ease-in-out;
}

@keyframes feedingFadeIn {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.feeding-slide-up {
  animation: feedingSlideUp 0.5s ease-out;
}

@keyframes feedingSlideUp {
  from {
    opacity: 0;
    transform: translateY(40px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}