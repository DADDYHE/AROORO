/* 商城板块样式 - 紫色主题 */

/* 商城板块容器 */
.mall-container {
  background-color: var(--background-color);
  min-height: 100vh;
}

/* 商城板块标题 */
.mall-title {
  color: var(--mall-primary);
  font-family: var(--font-bold);
  font-size: var(--font-size-xxl);
  margin-bottom: var(--spacing-lg);
}

/* 商城分类导航 */
.mall-categories {
  display: flex;
  overflow-x: auto;
  gap: var(--spacing-md);
  padding: var(--spacing-md) 0;
  margin-bottom: var(--spacing-lg);
  scrollbar-width: none;
  -ms-overflow-style: none;
}

.mall-categories::-webkit-scrollbar {
  display: none;
}

.mall-category {
  background: var(--card-color);
  padding: var(--spacing-sm) var(--spacing-md);
  border-radius: var(--border-radius-full);
  font-size: var(--font-size-sm);
  font-weight: var(--font-semibold);
  color: var(--text-secondary);
  white-space: nowrap;
  transition: all var(--transition-fast);
  border: 1px solid var(--border-color);
}

.mall-category.active {
  background: var(--mall-gradient);
  color: var(--text-white);
  border-color: var(--mall-primary);
}

/* 商品卡片 */
.mall-product-card {
  background: var(--card-color);
  border-radius: var(--border-radius-xl);
  box-shadow: var(--shadow-sm);
  padding: var(--spacing-md);
  margin-bottom: var(--spacing-lg);
  transition: all var(--transition-fast);
  border: 1px solid rgba(156, 39, 176, 0.1);
}

.mall-product-card:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
  border-color: var(--mall-primary);
}

/* 商品图片 */
.mall-product-image {
  width: 100%;
  height: 200px;
  border-radius: var(--border-radius-lg);
  object-fit: cover;
  margin-bottom: var(--spacing-md);
}

/* 商品信息 */
.mall-product-info {
  margin-bottom: var(--spacing-md);
}

.mall-product-name {
  font-family: var(--font-bold);
  font-size: var(--font-size-md);
  color: var(--text-primary);
  margin-bottom: var(--spacing-xs);
  line-height: var(--line-height-tight);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.mall-product-price {
  font-family: var(--font-bold);
  font-size: var(--font-size-lg);
  color: var(--mall-primary);
  margin-bottom: var(--spacing-xs);
}

.mall-product-sales {
  font-size: var(--font-size-xs);
  color: var(--text-tertiary);
  margin-bottom: var(--spacing-md);
}

/* 商城板块按钮 */
.mall-btn {
  background: var(--mall-gradient);
  color: var(--text-white);
  border: none;
  border-radius: var(--border-radius-md);
  padding: var(--spacing-md) var(--spacing-xl);
  font-family: var(--font-semibold);
  font-size: var(--font-size-md);
  transition: all var(--transition-fast);
  cursor: pointer;
}

.mall-btn:hover {
  opacity: 0.9;
  transform: translateY(-1px);
  box-shadow: var(--shadow-md);
}

/* 商品详情页 */
.mall-product-detail {
  background: var(--card-color);
  border-radius: var(--border-radius-xl);
  padding: var(--spacing-xl);
  box-shadow: var(--shadow-sm);
}

.mall-product-detail-image {
  width: 100%;
  height: 300px;
  border-radius: var(--border-radius-lg);
  object-fit: cover;
  margin-bottom: var(--spacing-lg);
}

.mall-product-detail-title {
  font-family: var(--font-bold);
  font-size: var(--font-size-xxl);
  color: var(--text-primary);
  margin-bottom: var(--spacing-md);
}

.mall-product-detail-price {
  font-family: var(--font-bold);
  font-size: var(--font-size-xl);
  color: var(--mall-primary);
  margin-bottom: var(--spacing-lg);
}

.mall-product-detail-description {
  font-size: var(--font-size-md);
  line-height: var(--line-height-text);
  color: var(--text-secondary);
  margin-bottom: var(--spacing-lg);
}

/* 购物车 */
.mall-cart {
  background: var(--card-color);
  border-radius: var(--border-radius-xl);
  padding: var(--spacing-lg);
  box-shadow: var(--shadow-sm);
}

.mall-cart-item {
  display: flex;
  align-items: center;
  padding: var(--spacing-md) 0;
  border-bottom: 1px solid var(--border-color);
}

.mall-cart-item:last-child {
  border-bottom: none;
}

.mall-cart-item-image {
  width: 80px;
  height: 80px;
  border-radius: var(--border-radius-md);
  object-fit: cover;
  margin-right: var(--spacing-md);
}

.mall-cart-item-info {
  flex: 1;
}

.mall-cart-item-name {
  font-size: var(--font-size-md);
  color: var(--text-primary);
  margin-bottom: var(--spacing-xs);
  line-height: var(--line-height-tight);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.mall-cart-item-price {
  font-family: var(--font-bold);
  font-size: var(--font-size-md);
  color: var(--mall-primary);
  margin-bottom: var(--spacing-xs);
}

.mall-cart-item-quantity {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}

.mall-cart-item-quantity button {
  width: 28px;
  height: 28px;
  border: 1px solid var(--border-color);
  border-radius: var(--border-radius-full);
  background: var(--card-color);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-size-md);
  color: var(--text-primary);
  cursor: pointer;
}

.mall-cart-item-quantity span {
  font-size: var(--font-size-md);
  color: var(--text-primary);
  min-width: 30px;
  text-align: center;
}

/* 商城板块表单 */
.mall-form {
  background: var(--card-color);
  border-radius: var(--border-radius-xl);
  padding: var(--spacing-lg);
  box-shadow: var(--shadow-sm);
}

.mall-form label {
  display: block;
  font-family: var(--font-semibold);
  font-size: var(--font-size-sm);
  color: var(--text-primary);
  margin-bottom: var(--spacing-xs);
}

.mall-form input,
.mall-form textarea {
  width: 100%;
  padding: var(--spacing-md);
  border: 1px solid var(--border-color);
  border-radius: var(--border-radius-md);
  font-size: var(--font-size-md);
  margin-bottom: var(--spacing-md);
  transition: all var(--transition-fast);
}

.mall-form input:focus,
.mall-form textarea:focus {
  outline: none;
  border-color: var(--mall-primary);
  box-shadow: 0 0 0 2px rgba(156, 39, 176, 0.1);
}

/* 商城板块动画 */
.mall-fade-in {
  animation: mallFadeIn 0.5s ease-in-out;
}

@keyframes mallFadeIn {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.mall-slide-up {
  animation: mallSlideUp 0.5s ease-out;
}

@keyframes mallSlideUp {
  from {
    opacity: 0;
    transform: translateY(40px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}