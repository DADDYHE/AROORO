.TUI-LocationMessage {
  width: 400rpx;
  max-width: 400rpx;
  background-color: #ffffff;
  border-radius: 12rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
  position: relative;
}

.location-map {
  width: 100%;
  height: 240rpx;
  position: relative;
  background-color: #e8e8e8;
  overflow: hidden;
}

.map-background {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, #f0f5f9 0%, #e8ecf1 100%);
}

.map-grid {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-image:
    linear-gradient(to right, rgba(0,0,0,0.05) 1rpx, transparent 1rpx),
    linear-gradient(to bottom, rgba(0,0,0,0.05) 1rpx, transparent 1rpx);
  background-size: 40rpx 40rpx;
}

.location-marker {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: bounce 2s infinite;
}

@keyframes bounce {
  0%, 100% {
    transform: translate(-50%, -50%);
  }
  50% {
    transform: translate(-50%, -70%);
  }
}

.marker-icon {
  width: 64rpx;
  height: 64rpx;
  filter: drop-shadow(0 4rpx 8rpx rgba(255, 107, 0, 0.3));
}

.map-hint {
  position: absolute;
  bottom: 16rpx;
  left: 16rpx;
  background-color: rgba(0, 0, 0, 0.6);
  color: #ffffff;
  padding: 8rpx 16rpx;
  border-radius: 4rpx;
  font-size: 20rpx;
  backdrop-filter: blur(4rpx);
}

.location-info {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  background-color: #ffffff;
  padding-right: 60rpx;
}

.location-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.location-address {
  font-size: 24rpx;
  color: #999999;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.location-arrow {
  position: absolute;
  right: 24rpx;
  top: 270rpx;
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.arrow-icon {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.4;
}
