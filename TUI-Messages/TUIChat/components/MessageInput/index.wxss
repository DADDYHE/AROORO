.TUI-message-input-container {
    background-color: #ffffff;
    border-top: 1rpx solid #f0f0f0;
    box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.03);
}

.TUI-message-input {
    display: flex;
    padding: 20rpx 30rpx;
    background-color: #ffffff;
    width: 100vw;
    overflow: scroll;
    align-items: center;
}

/* 移除顶部快捷功能按钮样式 */

.TUI-message-input-functions {
    display: flex;
    align-items: center;
}

.TUI-message-input-main {
    height: 30px;
    background-color: #f5f5f5;
    border: 1rpx solid #e0e0e0;
    flex: 1;
    margin: 0 10rpx;
    padding: 0 20rpx;
    border-radius: 20rpx;
    display: flex;
    align-items: center;
    transition: all 0.3s ease;
}

.TUI-message-input-main-focus {
    height: auto;
    background-color: #ffffff;
    border: 1rpx solid #000000;
    flex: 1;
    margin: 0 10rpx;
    padding: 0 20rpx;
    border-radius: 20rpx;
    display: flex;
    align-items: center;
    box-shadow: 0 0 0 2rpx rgba(0, 0, 0, 0.05);
    transition: all 0.3s ease;
}

.TUI-message-input-area {
    width: 100%;
    height: 100%;
    max-height: 300rpx;
    line-height: 30rpx;
    overflow: scroll;
    font-size: 28rpx;
    font-weight: 500;
    color: #333333;
    letter-spacing: 2rpx;
}

.TUI-icon {
    width: 64rpx;
    height: 64rpx;
    margin: 0 5rpx;
    padding: 8rpx;
    display: flex;
    align-items: center;
    justify-content: center;
}

.TUI-Extensions {
    display: flex;
    flex-wrap: wrap;
    width: 100vw;
    height: 450rpx;
    margin-left: 14rpx;
    margin-right: 14rpx;
}

.TUI-Extension-slot {
    width: 140rpx;
    height: 180rpx;
    margin-left: 24rpx;
    margin-right: 24rpx;
    margin-top: 24rpx;
    padding: 10rpx;
}

.TUI-Extension-icon {
    width: 120rpx;
    height: 120rpx;
    border-radius: 25%;
}

.TUI-sendMessage-btn {
    display: flex;
    align-items: center;
    margin: 0 5rpx;
}

/* 为右侧按钮添加右边距，确保不超出显示区域 */
.TUI-message-input-functions {
    margin-right: 40rpx;
}

.TUI-Emoji-area {
    width: 100vw;
    height: 450rpx;
}

.TUI-Extension-slot-name {
    line-height: 34rpx;
    font-size: 24rpx;
    color: #333333;
    letter-spacing: 0;
    text-align: center;
}

.record-modal {
    height: 300rpx;
    width: 60vw;
    background-color: #000;
    opacity: 0.8;
    position: fixed;
    top: 670rpx;
    z-index: 9999;
    left: 20vw;
    border-radius: 24rpx;
    display: flex;
    flex-direction: column;
}
.record-modal .wrapper {
    display: flex;
    height: 200rpx;
    box-sizing: border-box;
    padding: 10vw;
}
 .record-modal .wrapper .modal-loading {
    opacity: 1;
    width: 40rpx;
    height: 16rpx;
    border-radius: 4rpx;
    background-color: #006fff;
    animation: loading 2s 
            cubic-bezier(0.17, 0.37, 0.43, 0.67) infinite;
}
.modal-title {
    text-align: center;
    color: #fff;
}
@keyframes loading{
    0% {
        transform: translate(0,0)
    }
  50%
  {
    transform :translate(30vw,0);
    background-color: #f5634a;
    width :40px;
    }
  100%
    {transform: translate(0,0);
    }
}
.TUI-Call-Extension-container{
    display:flex
}