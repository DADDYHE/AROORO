.container {
  width: 100vw;
  height: 100vh;
  background-color: #fafafa;
  display: flex;
  flex-direction: column;
}

.enter {
  transform: translate3d(0,0,0);
  transform-origin: right;
  animation: pageEnter .3s ease-in-out;
}

@keyframes pageEnter {
  0%{
    transform:translate(100%, 0);
  }
  100% {
    transform:translate(0, 0);
  }
}

.safetytips-box{
  background: rgba(255, 149, 0, 0.1);
  padding: 9px;
}
.safetytips{
  font-family: 'PingFang SC';
  font-style: normal;
  font-weight: 400;
  font-size: 24rpx;
  line-height: 36rpx;
  text-align: justify;
  color: #FF8C39;
}
.report{
  float: right;
  color: #006EFF;
}
/* 移除内部顶部导航栏样式，使用项目自带的顶部栏 */

/* 调整列表容器高度，适应没有内部导航栏的情况 */
.list-box {
  height: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  background-color: #fafafa;
}

.list-box-group {
  height: calc(100vh - 100px);
  top: 0;
  background-color: #fafafa;
}

.input-area {
  position: relative;
  background-color: #fafafa;
}
.message-list {
  flex: 1;
  height: 0;
  background-color: #fafafa;
}

.message-input {
  flex-shrink: 0;
  width: 100%;
  padding-bottom: var(--padding);
  background-color: #ffffff;
  border-top: 1rpx solid #f0f0f0;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.03);
}
.calling {
  position: fixed;
  z-index: 199;
  top: 0;
  bottom: 0;
  right: 0;
}
.group-profile {
  height: 60px;
  position: relative;
  z-index: 10;
}
.group{
  top: 0;
  left: 0;
  z-index: 10;
  position: absolute;
}
