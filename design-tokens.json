      "700": "#4F5E35",
      "500": "#6B7D5A",
      "300": "#9A9489",
      "100": "#EAEDDF",
      "gradient": "linear-gradient(160deg, #4F5E35 0%, #3A4626 100%)"
    },
    "accent": {
      "base": "#B8893A",
      "hover": "#9A7430",
      "soft": "#F2E8D4",
      "glow": "rgba(184,138,58,0.35)"
    },
    "neutral": {
      "bg": "#F8FAF3",
      "surface": "#FFFFFF",
      "surfaceGlass": "rgba(255,255,255,0.72)",
      "surfaceGlassSolid": "#FFFFFF",
      "surfaceGlassBorder": "rgba(255,255,255,0.55)",
      "border": "#D8DCCE",
      "borderStrong": "#C9CFBA",
      "divider": "#EAEDDF",
      "text1": "#2A2823",
      "text2": "#635E54",
      "text3": "#9A9489",
      "textOnPrimary": "#FAFAF6"
    },
    "state": {
      "success": "#5B7C4A",
      "warning": "#B8893A",
      "error": "#A85B4A",
      "info": "#6B7D8C"
    }
  },
  "tabBar": {
    "height": "100rpx",
    "safeBottom": "env(safe-area-inset-bottom, 0px)",
    "totalHeight": "calc(100rpx + env(safe-area-inset-bottom, 0px))",
    "bg": "rgba(255,255,255,0.92)",
    "bgGlass": "rgba(255,255,255,0.72)",
    "blur": "20px",
    "borderTop": "1rpx solid rgba(79,94,53,0.08)",
    "itemActive": "#4F5E35",
    "itemInactive": "#9A9489",
    "itemActiveBg": "rgba(79,94,53,0.08)",
    "iconSize": "48rpx",
    "iconStroke": "4rpx",
    "labelSize": "22rpx",
    "labelWeight": 500,
    "labelWeightActive": 600,
    "center": {
      "diameter": "120rpx",
      "protrusion": "40rpx",
      "bottom": "calc(env(safe-area-inset-bottom, 0px) + 20rpx)",
      "iconSize": "56rpx",
      "gradient": "linear-gradient(160deg, #4F5E35 0%, #3A4626 100%)",
      "iconColor": "#FAFAF6",
      "shadow": "0 12rpx 28rpx rgba(79,94,53,0.35), 0 4rpx 10rpx rgba(79,94,53,0.20)"
    }
  },
  "typography": {
    "fontStack": "-apple-system, BlinkMacSystemFont, \"PingFang SC\", \"Helvetica Neue\", \"Microsoft YaHei\", \"Source Han Sans SC\", \"Noto Sans CJK SC\", sans-serif",
    "scale": {
      "display": { "size": "56rpx", "weight": 700, "lineHeight": 1.15 },
      "h1": { "size": "44rpx", "weight": 700, "lineHeight": 1.2 },
      "h2": { "size": "36rpx", "weight": 600, "lineHeight": 1.3 },
      "h3": { "size": "32rpx", "weight": 600, "lineHeight": 1.4 },
      "body": { "size": "28rpx", "weight": 400, "lineHeight": 1.6 },
      "sm": { "size": "24rpx", "weight": 400, "lineHeight": 1.5 },
      "xs": { "size": "20rpx", "weight": 500, "lineHeight": 1.4 },
      "tab": { "size": "22rpx", "weight": 500, "lineHeight": 1 }
    }
  },
  "spacing": {
    "2xs": "4rpx", "xs": "8rpx", "sm": "16rpx", "md": "24rpx",
    "lg": "32rpx", "xl": "48rpx", "2xl": "64rpx", "3xl": "96rpx"
  },
  "radius": {
    "sm": "16rpx", "md": "24rpx", "lg": "24rpx", "xl": "32rpx",
    "2xl": "32rpx", "3xl": "40rpx", "pill": "999rpx"
  },
  "shadow": {
    "xs": "0 2rpx 8rpx rgba(42,40,35,0.04)",
    "sm": "0 4rpx 16rpx rgba(42,40,35,0.06)",
    "md": "0 8rpx 24rpx rgba(42,40,35,0.08)",
    "lg": "0 16rpx 40rpx rgba(42,40,35,0.10)",
    "fab": "0 12rpx 28rpx rgba(79,94,53,0.35), 0 4rpx 10rpx rgba(79,94,53,0.20)",
    "floatTabBar": "0 -4rpx 32rpx rgba(42,40,35,0.10)"
  },
  "motion": {
    "easeStandard": "cubic-bezier(0.4,0,0.2,1)",
    "easeEmphasized": "cubic-bezier(0.2,0,0,1)",
    "easeDecelerate": "cubic-bezier(0,0,0.2,1)",
    "easeSpring": "cubic-bezier(0.34,1.56,0.64,1)",
    "durationFast": "150ms",
    "durationBase": "250ms",
    "durationSlow": "350ms",
    "durationFab": "200ms"
  },
  "glassFallback": {
    "strategy": "基色 rgba(255,255,255,0.92) 始终生效；@supports backdrop-filter 时降 alpha 至 0.72 并加 blur(20px)",
    "androidLowEnd": "不支持 backdrop-filter → 使用 0.92 半透明白（视觉接近磨砂，仅无实时模糊）",
    "perfNote": "低端安卓滚动模糊可掉帧，建议 blur 降至 12-16px 或关闭 blur 仅用半透明白"
  }
}
