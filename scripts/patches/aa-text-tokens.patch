# ============================================================================
# aa-text-tokens.patch —— 两个文字令牌的 AA 达标改造（待 DADDY 拍板后再 apply）
#
# 应用：  git apply scripts/patches/aa-text-tokens.patch
# 回滚：  git apply -R scripts/patches/aa-text-tokens.patch
# 样张：  scripts/patches/aa-text-tokens-sample.html（改前/改后对照，浏览器直开）
#
# ---------------------------------------------------------------------------
# 为什么改
# ---------------------------------------------------------------------------
# --text-tertiary #9E9889：全仓 291 处引用，在任何一种卡片底上都只有 2.5~2.9:1，
#   是当前唯一「无论压在什么底上都必然不达标」的正文级令牌。
# --error-color   #B85C3C：23 处引用。既当实色文字，又在 .status-error 里当
#   「自身 8% wash 上的文字」——后一种场景对比度再掉 0.4，是全仓最低的 3.78:1。
#
# ---------------------------------------------------------------------------
# 取值怎么定的（与 team-lead 初版取值的差异，已在报告中说明）
# ---------------------------------------------------------------------------
# 约束一：色相不许动。两个值都用 HLS 固定 H/S、只沿 L 下探，取「第一个全场景达标」
#         的解，保证是最小改动量——不是随手挑一个更深的颜色。
# 约束二：场景要取全。只验纯白卡会漏掉真正的最不利底。实际底色有 6 种：
#         #FFFFFF 白卡 / #FBF9F4 奶油卡 / #F7F5EF 页面底 /
#         #F8F3E6 accent-wash / #F2F5EC primary-wash / #F2F0E8 surface-tint
#         error 还要额外算「自身 8% wash 压在这三种卡上」的合成底。
# 约束三：disabled / inactive 按 WCAG 1.4.3「非活动 UI 组件」豁免，不参与卡值。
#         --text-tertiary 的 11 处 wash 场景里有 6 处属此类
#         （.status-disabled / .tag-inactive×2 / .status-draft /
#           .card-locale.disabled / .confirm-btn.disabled）。
#         若 DADDY 认为 .status-draft 属信息性不该豁免，需再降至 #706B5C（最低 4.66）。
#
# ---------------------------------------------------------------------------
# 对比度实测（门槛 4.5:1）
# ---------------------------------------------------------------------------
#  --text-tertiary          白卡  奶油卡 页面底 accent primary surface  最低
#    #9E9889  现值          2.87  2.73  2.64  2.59  2.61  2.52   2.52  ✗
#    #747065  初版取值       4.94  4.70  4.53  4.46  4.48  4.33   4.33  ✗ 差 0.17
#    #736D5F  本 patch      5.14  4.89  4.72  4.64  4.67  4.51   4.51  ✓
#      └ H=42.9° 不变，L 0.578→0.412
#
#  --error-color            白卡  奶油卡 页面底 ─── 自身 8%wash 压在三种卡上 ───  最低
#    #B85C3C  现值          4.53  4.31  4.16  4.09  3.89  3.78          3.78  ✗
#    #AE5739  初版取值       4.97  4.73  4.56  4.49  4.27  4.11          4.11  ✗ 差 0.39
#    #A45236  本 patch      5.47  5.20  5.02  4.90  4.68  4.51          4.51  ✓
#      └ H=15.5° 不变，L 0.478→0.427
#
# ---------------------------------------------------------------------------
# 附带一条：--wash-error-08 要不要跟着改
# ---------------------------------------------------------------------------
# --wash-error-08 目前写死 rgba(184,92,60,0.08)，即旧的 #B85C3C 拆出来的三通道。
# error 改色后这个 wash 仍是旧色相。实测在 8% 透明度下两者合成结果逐通道只差
# 1/255，肉眼不可辨，因此本 patch **不改** wash，避免扩大改动面。
# 上面表格里 error 的 wash 场景就是按「wash 保持旧色」算的，结论不受影响。
# 若追求令牌族自洽，可另开一行改成 rgba(164,82,54,0.08)——纯洁癖，不影响达标。
#
# ---------------------------------------------------------------------------
# 影响面
# ---------------------------------------------------------------------------
# 只改 styles/theme-teal.wxss 亮色 page{} 块内 2 行。
# 暗色 .theme-dark 块的 --text-tertiary: #6E6A5E 不动（深底上是另一套账，已达标）。
# 314 处引用点（291 + 23）零改动，全部通过令牌自动继承。
# ============================================================================
#
# ============================================================================
diff -u -r a/styles/theme-teal.wxss b/styles/theme-teal.wxss
--- a/styles/theme-teal.wxss
+++ b/styles/theme-teal.wxss
@@ -52,7 +52,7 @@
   --ink-black: #1A1A17;                /* 炭黑 — 主标题（非纯黑） */
   --text-primary: #1A1A17;             /* 主文字 炭墨 */
   --text-secondary: #5A564C;           /* 次文字 暖炭灰 */
-  --text-tertiary: #9E9889;            /* 三级文字 米灰 */
+  --text-tertiary: #736D5F;            /* 三级文字 米灰 — AA：6 种卡底最低 4.51:1（原 #9E9889 仅 2.52，全场景不达标）*/
   --text-on-primary: #F7F5EF;          /* 主色上的反白文字 */
   --text-on-accent: #1A1A17;           /* 金族面上的文字 — 炭墨。补齐"缺的一格"：
                                           金族四个色停 L=0.271~0.676，全部 > 白字上限 0.1833，
@@ -110,7 +110,7 @@
   /* ===== 功能色 ===== */
   --success-color: #3D7A45;
   --warning-color: #C9A24B;
-  --error-color: #B85C3C;
+  --error-color: #A45236;              /* AA：含「自身 8% wash 上的文字」最低 4.51:1（原 #B85C3C 仅 3.78）*/
   --info-color: #5C7A8A;
   /* status 族：横幅底色，均为「白字压其上」用途，故全部满足 L≤0.1833（白字 4.5:1）。
      新增/改值时务必复核该阈值，勿凭肉眼判断"够不够深"。 */
