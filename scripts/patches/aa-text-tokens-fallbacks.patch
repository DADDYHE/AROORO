# aa-text-tokens-fallbacks.patch —— aa-text-tokens.patch 的强制配套件
#
# ⚠ 必须与 aa-text-tokens.patch 同批 apply，单独 apply aa-text-tokens 会让
#   守卫「桶② 旧坐标泄漏」从 58 跳到 80（+22），凭空造出 22 颗二级雷。
#
# 原因：这 22 处写的是 var(--text-tertiary, #9E9889) / var(--error-color, #B85C3C)。
#   今天兜底值 == 令牌真值，所以我在 Q4 清扫「兜底≠真值」时按规矩放过了它们；
#   一旦 Q3 把令牌改成 #736D5F / #A45236，它们当场全部变成"兜底≠真值"。
#   兜底本身永不触发（令牌在 page 作用域已定义），不影响渲染，只污染真相源。
#
# 处理：删兜底值，保留 var(--x)。与任务 #12 的授权口径一致（删兜底值，不改兜底值）。
#
#   components/zy-action-sheet/index.wxss  ×5
#   components/logistics-card/index.wxss   ×3   （含 2 处 border-*，非文字）
#   components/zy-calendar/index.wxss      ×2
#   components/login-prompt/login-prompt.wxss ×1
#   pages/service/index.wxss               ×7
#   pages/profile/index.wxss               ×2
#   pages/quick-register/index.wxss        ×2
#
# 我的边界只覆盖 pages/*（11 处），components/*（11 处）需 team-lead 派单，
# 故整体做成 patch 不 apply。
#
# 应用：git apply -p1 scripts/patches/aa-text-tokens-fallbacks.patch
# 回滚：git apply -R -p1 scripts/patches/aa-text-tokens-fallbacks.patch
#
diff -u -r a/components/login-prompt/login-prompt.wxss b/components/login-prompt/login-prompt.wxss
--- a/components/login-prompt/login-prompt.wxss
+++ b/components/login-prompt/login-prompt.wxss
@@ -159,7 +159,7 @@
 
 .skip-text {
   font-size: 24rpx;
-  color: var(--text-tertiary, #9E9889);
+  color: var(--text-tertiary);
   letter-spacing: 0.04em;
 }
 
diff -u -r a/components/logistics-card/index.wxss b/components/logistics-card/index.wxss
--- a/components/logistics-card/index.wxss
+++ b/components/logistics-card/index.wxss
@@ -78,7 +78,7 @@
 
 .logistics-label {
   font-size: 24rpx;
-  color: var(--text-tertiary, #9E9889);
+  color: var(--text-tertiary);
   width: 140rpx;
   flex-shrink: 0;
   font-weight: 400;
@@ -109,8 +109,8 @@
 .logistics-arrow {
   width: 14rpx;
   height: 14rpx;
-  border-top: 2rpx solid var(--text-tertiary, #9E9889);
-  border-right: 2rpx solid var(--text-tertiary, #9E9889);
+  border-top: 2rpx solid var(--text-tertiary);
+  border-right: 2rpx solid var(--text-tertiary);
   transform: rotate(45deg);
   margin-left: 20rpx;
   flex-shrink: 0;
