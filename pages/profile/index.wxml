<zy-navbar title="我的" showBack="{{false}}" />
<scroll-view
  scroll-y
  enhanced
  refresher-enabled="{{true}}"
  refresher-triggered="{{_refresherTriggered}}"
  bindrefresherrefresh="_onRefresherRefresh"
  bindscrolltolower="_onScrollToLower"
  bindscroll="_onScroll"
  lower-threshold="100"
  style="height: calc(100vh - {{_navbarHeight}}px);"
>
<view class="page {{rmClass}}">
  <!-- 顶部画廊区 -->
  <view class="gallery-header">
    <view class="brand-block">
      <view class="brand-accent-bar"></view>
      <view class="brand-main">
        <text class="brand-text">AROORO</text>
      </view>
      <view class="brand-meta">
        <view class="brand-meta-line"></view>
        <text class="brand-subtitle">安心呼噜，放心托付</text>
      </view>
    </view>
  </view>

  <!-- 个人信息 -->
<view class="order-exhibit-section">
  <view class="exhibit-list">
    <view class="exhibit-row">
      <view class="exhibit-profile-cell">
        <view class="exhibit-avatar-wrap">
          <image lazy-load class="exhibit-avatar" src="{{userInfo.avatarUrl || '/images/default-avatar.svg'}}" mode="aspectFill" binderror="onCloudImageError" data-src="{{userInfo.avatarUrl}}" data-path="userInfo.avatarUrl" />
        </view>
        <text class="exhibit-name">{{userInfo.nickName}}</text>
      </view>
    </view>
  </view>
</view>

  <!-- 数据统计 -->
<view class="order-exhibit-section">
  <view class="exhibit-stats">
    <view class="exhibit-stat" bindtap="onMyPets">
      <text class="exhibit-stat-num">{{stats.petCount}}</text>
      <text class="exhibit-stat-label">我的宠物</text>
    </view>
    <view class="exhibit-stat" bindtap="onMyActivities">
      <text class="exhibit-stat-num">{{stats.activityCount}}</text>
      <text class="exhibit-stat-label">我的活动</text>
    </view>
    <view class="exhibit-stat" bindtap="onMyCoupons">
      <text class="exhibit-stat-num">{{stats.couponCount}}</text>
      <text class="exhibit-stat-label">我的优惠券</text>
    </view>
  </view>
</view>

  <!-- 我的订单 - 艺术展陈风格 -->
<view class="order-exhibit-section">
  <view class="exhibit-header">
    <view class="exhibit-number">01</view>
    <view class="exhibit-title-block">
      <text class="exhibit-title">我的订单</text>
      <view class="exhibit-line"></view>
    </view>
  </view>
  
  <view class="exhibit-list">
    <view class="exhibit-row" bindtap="onGroupOrders">
      <view class="exhibit-row-index">01</view>
      <view class="exhibit-row-card group">
        <view class="exhibit-row-icon">
          <image class="exhibit-icon-img" src="/images/icons/discover-line.svg" mode="aspectFit" />
        </view>
        <view class="exhibit-row-info">
          <text class="exhibit-row-title">团购订单</text>
          <text class="exhibit-row-desc">查看团购参与记录</text>
        </view>
        <view class="exhibit-row-arrow"></view>
      </view>
    </view>
    
    <view class="exhibit-row" bindtap="onMallOrders">
      <view class="exhibit-row-index">02</view>
      <view class="exhibit-row-card mall">
        <view class="exhibit-row-icon">
          <image class="exhibit-icon-img" src="{{iconShoppingCart}}" mode="aspectFit" binderror="onCloudImageError" data-src="{{iconShoppingCart}}" data-path="iconShoppingCart" />
        </view>
        <view class="exhibit-row-info">
          <text class="exhibit-row-title">商城订单</text>
          <text class="exhibit-row-desc">查看宠物商城购买记录</text>
        </view>
        <view class="exhibit-row-arrow"></view>
      </view>
    </view>
    
    <view class="exhibit-row" bindtap="onActivityOrders">
      <view class="exhibit-row-index">03</view>
      <view class="exhibit-row-card activity">
        <view class="exhibit-row-icon">
          <image class="exhibit-icon-img" src="{{iconBell}}" mode="aspectFit" binderror="onCloudImageError" data-src="{{iconBell}}" data-path="iconBell" />
        </view>
        <view class="exhibit-row-info">
          <text class="exhibit-row-title">活动订单</text>
          <text class="exhibit-row-desc">查看活动报名记录</text>
        </view>
        <view class="exhibit-row-arrow"></view>
      </view>
    </view>
    
    <view class="exhibit-row" bindtap="onServiceOrders">
      <view class="exhibit-row-index">04</view>
      <view class="exhibit-row-card service">
        <view class="exhibit-row-icon">
          <image class="exhibit-icon-img" src="{{iconDoorOpen}}" mode="aspectFit" binderror="onCloudImageError" data-src="{{iconDoorOpen}}" data-path="iconDoorOpen" />
        </view>
        <view class="exhibit-row-info">
          <text class="exhibit-row-title">服务订单</text>
          <text class="exhibit-row-desc">查看服务预约记录</text>
        </view>
        <view class="exhibit-row-arrow"></view>
      </view>
    </view>
    
    <view class="exhibit-row" bindtap="onHostingOrders">
      <view class="exhibit-row-index">05</view>
      <view class="exhibit-row-card hosting">
        <view class="exhibit-row-icon">
          <image class="exhibit-icon-img" src="{{iconHomeHeart}}" mode="aspectFit" binderror="onCloudImageError" data-src="{{iconHomeHeart}}" data-path="iconHomeHeart" />
        </view>
        <view class="exhibit-row-info">
          <text class="exhibit-row-title">寄养订单</text>
          <text class="exhibit-row-desc">查看寄养服务记录</text>
        </view>
        <view class="exhibit-row-arrow"></view>
      </view>
    </view>
  </view>
</view>

  <!-- 账户设置 -->
<view class="order-exhibit-section">
  <view class="exhibit-header">
    <view class="exhibit-number">02</view>
    <view class="exhibit-title-block">
      <text class="exhibit-title">账户设置</text>
      <view class="exhibit-line"></view>
    </view>
  </view>
  
  <view class="exhibit-list">
    <view class="exhibit-row" bindtap="onPersonalInfo">
      <view class="exhibit-row-index">01</view>
      <view class="exhibit-row-card neutral">
        <view class="exhibit-row-icon neutral-icon-user"></view>
        <view class="exhibit-row-info">
          <text class="exhibit-row-title">个人信息</text>
          <text class="exhibit-row-desc">编辑昵称、头像等资料</text>
        </view>
        <view class="exhibit-row-arrow"></view>
      </view>
    </view>
    
    <view class="exhibit-row">
      <view class="exhibit-row-index">02</view>
      <view class="exhibit-row-card neutral contact-row-card">
        <view class="exhibit-row-icon neutral-icon-cs"></view>
        <view class="exhibit-row-info">
          <text class="exhibit-row-title">联系客服</text>
          <text class="exhibit-row-desc">在线咨询与帮助</text>
        </view>
        <button class="contact-overlay-btn" open-type="contact"></button>
      </view>
    </view>

    <view class="exhibit-row" bindtap="onPrivacySettings">
      <view class="exhibit-row-index">03</view>
      <view class="exhibit-row-card neutral">
        <view class="exhibit-row-icon neutral-icon-lock"></view>
        <view class="exhibit-row-info">
          <text class="exhibit-row-title">隐私设置</text>
          <text class="exhibit-row-desc">管理隐私与数据权限</text>
        </view>
        <view class="exhibit-row-arrow"></view>
      </view>
    </view>
    
    <view class="exhibit-row" bindtap="onAboutUs">
      <view class="exhibit-row-index">04</view>
      <view class="exhibit-row-card neutral">
        <view class="exhibit-row-icon neutral-icon-info"></view>
        <view class="exhibit-row-info">
          <text class="exhibit-row-title">关于我们</text>
          <text class="exhibit-row-desc">了解团队与联系方式</text>
        </view>
        <view class="exhibit-row-arrow"></view>
      </view>
    </view>

    <view class="exhibit-row" bindtap="onPartnerTap">
      <view class="exhibit-row-index">05</view>
      <view class="exhibit-row-card partner">
        <view class="exhibit-row-icon partner-icon"></view>
        <view class="exhibit-row-info">
          <text class="exhibit-row-title" wx:if="{{userInfo.isPartner}}">管理中心</text>
          <text class="exhibit-row-title" wx:else>成为合作伙伴</text>
          <text class="exhibit-row-desc" wx:if="{{userInfo.isPartner}}">管理活动、订单和查看数据</text>
          <text class="exhibit-row-desc" wx:else>带货赚取收益，共建宠物生态</text>
        </view>
        <view class="exhibit-row-arrow"></view>
      </view>
    </view>
  </view>
</view>

  <!-- 退出登录 -->
<view class="order-exhibit-section">
  <view class="exhibit-list">
    <view class="exhibit-row">
      <view class="exhibit-profile-cell">
        <view id="logoutBtn" class="exhibit-logout-btn" data-press-selector="#logoutBtn" bindtap="onLogout" bindtouchstart="_onPressScaleStart" bindtouchend="_onPressScaleEnd" bindtouchcancel="_onPressScaleEnd">
          <text class="exhibit-logout-text">退出登录</text>
        </view>
      </view>
    </view>
  </view>
</view>

  <!-- 版本信息 -->
  <view class="version-wrap">
    <text class="version-text">版本 {{appVersion}}</text>
  </view>

  <!-- 入驻弹窗（root-portal：Skyline 下保证 fixed 相对 viewport） -->
  <root-portal wx:if="{{showHostModal}}">
    <view class="modal-mask" bindtap="onCloseHostModal">
      <view class="modal-content" catchtap="">
        <view class="modal-header">
          <text class="modal-title">入驻平台请联系客服</text>
        </view>
        <view class="modal-body">
          <text class="modal-desc">点击下方按钮联系微信客服</text>
        </view>
        <view class="modal-footer">
          <button class="modal-btn contact-customer-btn" open-type="contact">
            <text class="modal-btn-text">联系客服</text>
          </button>
        </view>
        <view class="modal-close" bindtap="onCloseHostModal">
          <view class="modal-close-icon"></view>
        </view>
      </view>
    </view>
  </root-portal>
</view>
</scroll-view>
