/* ====== 页面容器 ====== */
.page {
  background-color: var(--background-color);
  min-height: 100vh;
  padding-bottom: 64rpx;
}

/* ====== 顶部画廊区 ====== */
.gallery-header {
  padding: 0;
  position: relative;
  overflow: hidden;
  background: var(--card-color);
  padding-bottom: 24rpx;
}

.brand-block {
  padding: 64rpx 48rpx 48rpx;
  position: relative;
}

.brand-block::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, var(--primary-light) 0%, transparent 70%);
  pointer-events: none;
}

.brand-accent-bar {
  position: absolute;
  top: 0;
  left: 48rpx;
  width: 48rpx;
  height: 6rpx;
  background: linear-gradient(90deg, var(--primary-color) 0%, var(--secondary-color) 100%);
  border-radius: 0 0 var(--border-radius-xs) var(--border-radius-xs);
}

.brand-main {
  position: relative;
  margin-bottom: 24rpx;
}

.brand-text {
  font-size: 64rpx;
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: 12rpx;
  display: block;
  line-height: 1;
  position: relative;
}

.brand-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.brand-meta-line {
  width: 40rpx;
  height: 2rpx;
  background: var(--divider-color);
  position: relative;
}

.brand-meta-line::after {
  content: '';
  position: absolute;
  top: 50%;
  right: -4rpx;
  transform: translateY(-50%);
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: var(--primary-color);
}

.brand-subtitle {
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 8rpx;
  font-weight: 400;
}

.page-title {
  font-size: 64rpx;
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: -1rpx;
}

/* ====== 个人信息卡片 ====== */
.exhibit-avatar-wrap {
  margin-bottom: 16rpx;
}

.exhibit-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 4rpx solid var(--card-color);
  box-shadow: var(--zy-shadow-sm);
}

.exhibit-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 300rpx;
  margin: 0 auto;
}

/* ====== 数据统计 ====== */
.exhibit-stats {
  background: linear-gradient(135deg, var(--card-color) 0%, var(--surface-tint) 100%);
  border-radius: var(--border-radius-md);
  padding: 32rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  border: 1rpx solid var(--border-color);
  box-shadow: var(--zy-shadow-xs);
}

.exhibit-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 0;
}

.exhibit-stat-num {
  font-size: 56rpx;
  font-weight: 600;
  color: var(--primary-color);
  line-height: 1;
  letter-spacing: -2rpx;
}

.exhibit-stat-label {
  font-size: 24rpx;
  color: var(--text-tertiary);
  letter-spacing: 1rpx;
  font-weight: 400;
}

/* ====== 我的订单 - 艺术展陈风格 ====== */
.order-exhibit-section {
  margin: 0 32rpx 48rpx;
}

.exhibit-header {
  display: flex;
  align-items: flex-end;
  gap: 24rpx;
  padding: 0 0 32rpx;
}

.exhibit-number {
  font-size: 96rpx;
  font-weight: 600;
  line-height: 1;
  background: linear-gradient(180deg, var(--text-tertiary) 0%, var(--border-color) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  letter-spacing: -4rpx;
}

.exhibit-title-block {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding-bottom: 8rpx;
}

.exhibit-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: 2rpx;
}

.exhibit-line {
  width: 48rpx;
  height: 3rpx;
  background: linear-gradient(90deg, var(--primary-color) 0%, transparent 100%);
  border-radius: var(--border-radius-xs);
}

.exhibit-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.exhibit-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.exhibit-row-index {
  width: 48rpx;
  font-size: 28rpx;
  font-weight: 400;
  color: var(--text-tertiary);
  letter-spacing: 2rpx;
  font-family: -apple-system, 'Helvetica Neue', monospace;
  padding-top: 24rpx;
  flex-shrink: 0;
  text-align: center;
}

.exhibit-row-card {
  flex: 1;
  border-radius: var(--border-radius-md);
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  position: relative;
  overflow: hidden;
}

/* 图标容器 */
.exhibit-row-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--border-radius-sm);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.exhibit-icon-img {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.8;
}

/* 活动订单 — 橄榄绿 */
.exhibit-row-card.activity {
  background: linear-gradient(135deg, var(--card-color) 0%, var(--activity-accent) 100%);
  border: 1rpx solid var(--border-color);
  box-shadow: var(--zy-shadow-xs);
}

.exhibit-row-card.activity .exhibit-row-icon {
  background: var(--activity-tint);
}

/* 服务订单 — 鼠尾草绿 */
.exhibit-row-card.service {
  background: linear-gradient(135deg, var(--card-color) 0%, var(--feeding-accent) 100%);
  border: 1rpx solid var(--border-color);
  box-shadow: var(--zy-shadow-xs);
}

.exhibit-row-card.service .exhibit-row-icon {
  background: var(--feeding-tint);
}

/* 团购订单 — 暖陶土玫瑰 */
.exhibit-row-card.group {
  background: linear-gradient(135deg, var(--card-color) 0%, var(--tuan-accent) 100%);
  border: 1rpx solid var(--border-color);
  box-shadow: var(--zy-shadow-xs);
}

.exhibit-row-card.group .exhibit-row-icon {
  background: var(--tuan-tint);
}

/* 寄养订单 — 暖陶土 */
.exhibit-row-card.hosting {
  background: linear-gradient(135deg, var(--card-color) 0%, var(--boarding-accent) 100%);
  border: 1rpx solid var(--border-color);
  box-shadow: var(--zy-shadow-xs);
}

.exhibit-row-card.hosting .exhibit-row-icon {
  background: var(--boarding-tint);
}

/* 商城订单 — 暖金 */
.exhibit-row-card.mall {
  background: linear-gradient(135deg, var(--card-color) 0%, var(--mall-accent) 100%);
  border: 1rpx solid var(--border-color);
  box-shadow: var(--zy-shadow-xs);
}

.exhibit-row-card.mall .exhibit-row-icon {
  background: var(--mall-tint);
}

/* 中性色图标 — 账户设置 */
.exhibit-row-card.neutral {
  background: linear-gradient(135deg, var(--card-color) 0%, var(--surface-tint) 100%);
  border: 1rpx solid var(--border-color);
  box-shadow: var(--zy-shadow-xs);
}

.neutral-icon-user {
  background: var(--surface-tint);
}

.neutral-icon-user::before {
  content: '';
  position: absolute;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--text-secondary);
  top: 30%;
  left: 50%;
  transform: translateX(-50%);
}

.neutral-icon-user::after {
  content: '';
  position: absolute;
  bottom: 10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 24rpx;
  height: 14rpx;
  border-radius: 50% 50% 0 0;
  background: var(--text-secondary);
}

.neutral-icon-shop {
  background: var(--surface-tint);
}

.neutral-icon-shop::before {
  content: '';
  position: absolute;
  top: 12rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 16rpx solid transparent;
  border-right: 16rpx solid transparent;
  border-bottom: 10rpx solid var(--text-secondary);
}

.neutral-icon-shop::after {
  content: '';
  position: absolute;
  top: 22rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 24rpx;
  height: 16rpx;
  background: var(--text-secondary);
  border-radius: var(--border-radius-xs);
}

.partner-icon {
  background: var(--gradient-primary);
}

.partner-icon::before {
  content: '';
  position: absolute;
  top: 14rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 20rpx;
  height: 4rpx;
  background: var(--zy-text-on-primary);
  border-radius: var(--border-radius-xs);
}

.partner-icon::after {
  content: '';
  position: absolute;
  top: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 12rpx;
  height: 12rpx;
  border: 3rpx solid var(--zy-text-on-primary);
  border-radius: 50%;
}

.exhibit-row-card.partner {
  background: linear-gradient(135deg, var(--card-color) 0%, var(--primary-light) 100%);
  border: 1rpx solid var(--border-color);
  border-left: 3rpx solid var(--primary-color);
  box-shadow: var(--zy-shadow-xs);
}

/* 联系客服卡片 */
.contact-row-card {
  position: relative;
}

.contact-overlay-btn {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  z-index: 1;
  padding: 0 !important;
  margin: 0 !important;
  border: none !important;
  background: transparent !important;
  line-height: normal !important;
  min-width: 0 !important;
  font-size: 0 !important;
}

.contact-overlay-btn::after {
  border: none !important;
}

.neutral-icon-cs {
  background: var(--activity-accent);
}

.neutral-icon-cs::before {
  content: '';
  position: absolute;
  top: 14rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 22rpx;
  height: 16rpx;
  border: 3rpx solid var(--success-color);
  border-radius: var(--border-radius-xs) var(--border-radius-xs) var(--border-radius-sm) var(--border-radius-sm);
  background: transparent;
}

.neutral-icon-cs::after {
  content: '';
  position: absolute;
  top: 24rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--success-color);
}

.neutral-icon-lock {
  background: var(--surface-tint);
}

.neutral-icon-lock::before {
  content: '';
  position: absolute;
  top: 14rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 20rpx;
  height: 12rpx;
  border: 4rpx solid var(--text-secondary);
  border-bottom: none;
  border-radius: 10rpx 10rpx 0 0;
}

.neutral-icon-lock::after {
  content: '';
  position: absolute;
  top: 26rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 28rpx;
  height: 18rpx;
  background: var(--text-secondary);
  border-radius: var(--border-radius-xs);
}

.neutral-icon-info {
  background: var(--surface-tint);
}

.neutral-icon-info::before {
  content: '';
  position: absolute;
  top: 16rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: var(--text-secondary);
}

.neutral-icon-info::after {
  content: '';
  position: absolute;
  top: 30rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 6rpx;
  height: 20rpx;
  background: var(--text-secondary);
  border-radius: var(--border-radius-xs);
}

.exhibit-row-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.exhibit-row-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: 1rpx;
}

.exhibit-row-desc {
  font-size: 24rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.5rpx;
  font-weight: 400;
}

.exhibit-row-arrow {
  width: 12rpx;
  height: 12rpx;
  border-top: 3rpx solid var(--text-tertiary);
  border-right: 3rpx solid var(--text-tertiary);
  transform: rotate(45deg);
  flex-shrink: 0;
  margin-top: 20rpx;
}

/* ====== 区块通用 ====== */
.section {
  margin: 0 32rpx 32rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 24rpx;
  padding-left: 8rpx;
}

/* ====== 快捷功能 4宫格 ====== */
.grid-card {
  background: var(--card-color);
  border-radius: var(--border-radius-md);
  padding: 24rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  box-shadow: var(--zy-shadow-xs);
}

.grid-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 0;
}

.grid-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--border-radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.grid-icon-wrap.pet {
  background: var(--surface-tint);
}

.grid-icon-wrap.order {
  background: var(--surface-tint);
}

.grid-icon-wrap.heart {
  background: var(--tuan-accent);
}

.grid-icon-wrap.coupon {
  background: var(--surface-tint);
}

.grid-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  text-align: center;
  letter-spacing: 0.5rpx;
  font-weight: 400;
}

/* 4宫格 CSS 图标 */
.grid-icon-pet {
  width: 36rpx;
  height: 36rpx;
  position: relative;
}

.grid-icon-pet::before {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 28rpx;
  height: 20rpx;
  border-radius: 50% 50% 0 0;
  background: var(--text-secondary);
}

.grid-icon-pet::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 10rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--text-secondary);
  transform: rotate(-15deg);
  box-shadow: 18rpx 0 0 0 var(--text-secondary), 9rpx -4rpx 0 0 var(--text-secondary);
}

.grid-icon-order {
  width: 32rpx;
  height: 36rpx;
  border: 4rpx solid var(--text-secondary);
  border-radius: var(--border-radius-xs);
  position: relative;
}

.grid-icon-order::before {
  content: '';
  position: absolute;
  top: -8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 16rpx;
  height: 6rpx;
  border: 4rpx solid var(--text-secondary);
  border-radius: 0 0 var(--border-radius-xs) var(--border-radius-xs);
  border-top: none;
}

.grid-icon-order::after {
  content: '';
  position: absolute;
  top: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 12rpx;
  height: 3rpx;
  background: var(--text-secondary);
  box-shadow: 0 6rpx 0 0 var(--text-secondary), 0 12rpx 0 0 var(--text-secondary);
}

.grid-icon-heart {
  width: 36rpx;
  height: 32rpx;
  position: relative;
}

.grid-icon-heart::before,
.grid-icon-heart::after {
  content: '';
  position: absolute;
  top: 0;
  width: 20rpx;
  height: 32rpx;
  border-radius: 20rpx 20rpx 0 0;
  background: var(--tuan-primary);
  transform: rotate(-45deg);
  transform-origin: bottom center;
}

.grid-icon-heart::before {
  left: 10rpx;
}

.grid-icon-heart::after {
  right: 10rpx;
  transform: rotate(45deg);
}

.grid-icon-coupon {
  width: 36rpx;
  height: 24rpx;
  background: var(--text-secondary);
  border-radius: var(--border-radius-xs);
  position: relative;
}

.grid-icon-coupon::before {
  content: '';
  position: absolute;
  top: 50%;
  right: -6rpx;
  transform: translateY(-50%);
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--card-color);
  box-shadow: -36rpx 0 0 0 var(--card-color);
}

.grid-icon-coupon::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translateY(-50%);
  width: 16rpx;
  height: 2rpx;
  background: var(--card-color);
}

/* ====== 列表卡片（热门服务 + 账户设置） ====== */
.list-card {
  background: var(--card-color);
  border-radius: var(--border-radius-md);
  overflow: hidden;
  box-shadow: var(--zy-shadow-xs);
}

.list-cell {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid var(--divider-color);
}

.list-cell:last-child {
  border-bottom: none;
}

.list-indicator {
  width: 4rpx;
  height: 36rpx;
  border-radius: var(--border-radius-xs);
  flex-shrink: 0;
}

.list-indicator.activity {
  background: var(--activity-primary);
}

.list-indicator.service {
  background: var(--feeding-primary);
}

.list-indicator.group {
  background: var(--tuan-primary);
}

.list-indicator.hosting {
  background: var(--boarding-primary);
}

.list-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--border-radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.list-icon-wrap.boarding {
  background: var(--boarding-accent);
}

.list-icon-wrap.feeding {
  background: var(--feeding-accent);
}

.list-icon-wrap.activity {
  background: var(--activity-accent);
}

.list-icon-wrap.referral {
  background: var(--mall-accent);
}

.list-icon-wrap.neutral {
  background: var(--surface-tint);
}

.list-label {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-primary);
  letter-spacing: 0.5rpx;
  font-weight: 400;
}

.list-arrow {
  width: 12rpx;
  height: 12rpx;
  border-top: 3rpx solid var(--text-tertiary);
  border-right: 3rpx solid var(--text-tertiary);
  transform: rotate(45deg);
  flex-shrink: 0;
}

/* 列表 CSS 图标 */
.list-icon-home {
  width: 32rpx;
  height: 24rpx;
  position: relative;
}

.list-icon-home::before {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 24rpx;
  height: 16rpx;
  border: 4rpx solid var(--boarding-primary);
  border-top: none;
  border-radius: 0 0 var(--border-radius-xs) var(--border-radius-xs);
}

.list-icon-home::after {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 20rpx solid transparent;
  border-right: 20rpx solid transparent;
  border-bottom: 12rpx solid var(--boarding-primary);
}

.list-icon-bowl {
  width: 32rpx;
  height: 20rpx;
  border: 4rpx solid var(--feeding-primary);
  border-top: none;
  border-radius: 0 0 20rpx 20rpx;
  position: relative;
}

.list-icon-bowl::before {
  content: '';
  position: absolute;
  top: -6rpx;
  left: -2rpx;
  width: 36rpx;
  height: 4rpx;
  background: var(--feeding-primary);
  border-radius: var(--border-radius-xs);
}

.list-icon-bowl::after {
  content: '';
  position: absolute;
  bottom: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 6rpx;
  height: 6rpx;
  background: var(--feeding-primary);
  border-radius: 50%;
}

.list-icon-star {
  width: 28rpx;
  height: 28rpx;
  position: relative;
  background: var(--success-color);
  clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
}

.list-icon-link {
  width: 28rpx;
  height: 28rpx;
  position: relative;
}

.list-icon-link::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 16rpx;
  height: 16rpx;
  border: 4rpx solid var(--mall-primary);
  border-radius: 50%;
}

.list-icon-link::after {
  content: '';
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  width: 16rpx;
  height: 16rpx;
  border: 4rpx solid var(--mall-primary);
  border-radius: 50%;
}

.list-icon-user {
  width: 28rpx;
  height: 32rpx;
  position: relative;
}

.list-icon-user::before {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--text-secondary);
}

.list-icon-user::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 24rpx;
  height: 14rpx;
  border-radius: 50% 50% 0 0;
  background: var(--text-secondary);
}

.list-icon-lock {
  width: 28rpx;
  height: 32rpx;
  position: relative;
}

.list-icon-shop {
  width: 28rpx;
  height: 28rpx;
  position: relative;
}

.list-icon-shop::before {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 16rpx solid transparent;
  border-right: 16rpx solid transparent;
  border-bottom: 10rpx solid var(--text-secondary);
}

.list-icon-shop::after {
  content: '';
  position: absolute;
  top: 10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 24rpx;
  height: 16rpx;
  background: var(--text-secondary);
  border-radius: var(--border-radius-xs);
}

.list-icon-lock::before {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 20rpx;
  height: 12rpx;
  border: 4rpx solid var(--text-secondary);
  border-bottom: none;
  border-radius: 10rpx 10rpx 0 0;
}

.list-icon-lock::after {
  content: '';
  position: absolute;
  top: 12rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 28rpx;
  height: 18rpx;
  background: var(--text-secondary);
  border-radius: var(--border-radius-xs);
}

.list-icon-bell {
  width: 28rpx;
  height: 32rpx;
  position: relative;
}

.list-icon-bell::before {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 24rpx;
  height: 20rpx;
  border-radius: 50% 50% 0 0;
  background: var(--text-secondary);
}

.list-icon-bell::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 8rpx;
  height: 6rpx;
  border-radius: 0 0 var(--border-radius-xs) var(--border-radius-xs);
  background: var(--text-secondary);
}

.list-icon-question {
  width: 28rpx;
  height: 28rpx;
  position: relative;
  font-size: 0;
}

.list-icon-question::before {
  content: '?';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 28rpx;
  color: var(--text-secondary);
  font-weight: 600;
  font-family: sans-serif;
}

.list-icon-info {
  width: 28rpx;
  height: 28rpx;
  position: relative;
}

.list-icon-info::before {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background: var(--text-secondary);
}

.list-icon-info::after {
  content: '';
  position: absolute;
  top: 10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 4rpx;
  height: 16rpx;
  background: var(--text-secondary);
  border-radius: var(--border-radius-xs);
}

/* ====== 退出登录 ====== */
.exhibit-logout-btn {
  background: var(--card-color);
  border-radius: var(--border-radius-md);
  padding: 32rpx;
  text-align: center;
  border: 1rpx solid var(--border-color);
  box-shadow: var(--zy-shadow-xs);
}

.exhibit-logout-text {
  font-size: 30rpx;
  color: var(--error-color);
  font-weight: 400;
  letter-spacing: 2rpx;
}

/* ====== 版本信息 ====== */
.version-wrap {
  text-align: center;
  padding-top: 16rpx;
}

.version-text {
  font-size: 24rpx;
  color: var(--text-tertiary);
  letter-spacing: 1rpx;
  font-weight: 400;
}

/* ====== 入驻弹窗 ====== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--overlay-color);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 560rpx;
  background: var(--card-color);
  border-radius: var(--border-radius-lg);
  padding: 48rpx 32rpx 32rpx;
  position: relative;
  box-shadow: var(--zy-shadow-md);
}

.modal-header {
  text-align: center;
  margin-bottom: 32rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
}

.modal-body {
  text-align: center;
  margin-bottom: 40rpx;
}

.modal-phone {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--primary-color);
  letter-spacing: 4rpx;
  display: block;
}

.modal-desc {
  font-size: 28rpx;
  color: var(--text-secondary);
  text-align: center;
  font-weight: 400;
}

.modal-footer {
  display: flex;
  justify-content: center;
}

.modal-btn {
  background: var(--primary-color);
  border-radius: var(--border-radius-pill);
  padding: 24rpx 64rpx;
  text-align: center;
}

.contact-customer-btn {
  border: none;
  margin: 0;
  line-height: normal;
}

.contact-customer-btn::after {
  border: none;
}

.modal-btn-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--zy-text-on-primary);
}

.modal-close {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-close-icon {
  width: 20rpx;
  height: 20rpx;
  position: relative;
}

.modal-close-icon::before,
.modal-close-icon::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 20rpx;
  height: 3rpx;
  background: var(--text-tertiary);
  border-radius: var(--border-radius-xs);
}

.modal-close-icon::before {
  transform: translate(-50%, -50%) rotate(45deg);
}

.modal-close-icon::after {
  transform: translate(-50%, -50%) rotate(-45deg);
}

/* ====== 动画（已清除） ====== */
