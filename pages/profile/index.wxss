/* ====== 退出登录 ====== */
.exhibit-logout-btn {
  background: linear-gradient(135deg, #FFFFFF 0%, #FAFAFA 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  text-align: center;
  border: 1rpx solid rgba(255, 59, 48, 0.15);
  box-shadow: 0 4rpx 16rpx rgba(255, 59, 48, 0.04);
  transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.exhibit-logout-btn:active {
  transform: scale(0.98);
  background: linear-gradient(135deg, #FFF5F5 0%, #FAFAFA 100%);
}

.exhibit-logout-text {
  font-size: 30rpx;
  color: #FF3B30;
  font-weight: 500;
  letter-spacing: 2rpx;
}

/* ====== 版本信息 ====== */
.version-wrap {
  text-align: center;
  padding-top: 16rpx;
}

.version-text {
  font-size: 22rpx;
  color: #C7C7CC;
  letter-spacing: 1rpx;
}

/* ====== 入驻弹窗 ====== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  animation: fadeIn 0.2s ease;
}

.modal-content {
  width: 560rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 56rpx 40rpx 40rpx;
  position: relative;
  animation: modalSlideUp 0.3s ease;
}

.modal-header {
  text-align: center;
  margin-bottom: 32rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1D1D1F;
  display: block;
}

.modal-body {
  text-align: center;
  margin-bottom: 40rpx;
}

.modal-phone {
  font-size: 44rpx;
  font-weight: 700;
  color: #4ECDC4;
  letter-spacing: 4rpx;
  display: block;
}

.modal-desc {
  font-size: 28rpx;
  color: #8E8E93;
  text-align: center;
}

.modal-footer {
  display: flex;
  justify-content: center;
}

.modal-btn {
  background: #4ECDC4;
  border-radius: 48rpx;
  padding: 24rpx 80rpx;
  text-align: center;
}

.contact-customer-btn {
  border: none;
  margin: 0;
  line-height: normal;
}

.contact-customer-btn::after {
  border: none;
}

.modal-btn:active {
  background: #3DB8B0;
}

.modal-btn-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.modal-close {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-close-icon {
  width: 20rpx;
  height: 20rpx;
  position: relative;
}

.modal-close-icon::before,
.modal-close-icon::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 20rpx;
  height: 3rpx;
  background: #C7C7CC;
  border-radius: 2rpx;
}

.modal-close-icon::before {
  transform: translate(-50%, -50%) rotate(45deg);
}

.modal-close-icon::after {
  transform: translate(-50%, -50%) rotate(-45deg);
}

/* ====== 动画 ====== */
@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(24rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes modalSlideUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
