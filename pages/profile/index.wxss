/* ====== 页面容器 ====== */
.page {
  background-color: #F5F5F7;
  min-height: 100vh;
  padding-bottom: 64rpx;
}

/* ====== 顶部画廊区 ====== */
.gallery-header {
  padding: 0;
  position: relative;
  overflow: hidden;
  background: #FFFFFF;
  animation: fadeUp 0.6s ease-out;
  padding-bottom: 20rpx;
}

.brand-block {
  padding: 80rpx 48rpx 64rpx;
  position: relative;
}

.brand-block::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, rgba(78, 205, 196, 0.15) 0%, transparent 70%);
  pointer-events: none;
}

.brand-accent-bar {
  position: absolute;
  top: 0;
  left: 48rpx;
  width: 48rpx;
  height: 6rpx;
  background: linear-gradient(90deg, #4ECDC4 0%, #2AB7A9 100%);
  border-radius: 0 0 4rpx 4rpx;
  animation: slideDown 0.5s ease-out;
}

.brand-main {
  position: relative;
  margin-bottom: 24rpx;
}

.brand-text {
  font-size: 64rpx;
  font-weight: 300;
  color: #1D1D1F;
  letter-spacing: 12rpx;
  display: block;
  line-height: 1;
  position: relative;
}

.brand-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.brand-meta-line {
  width: 40rpx;
  height: 2rpx;
  background: #E5E5EA;
  position: relative;
}

.brand-meta-line::after {
  content: '';
  position: absolute;
  top: 50%;
  right: -4rpx;
  transform: translateY(-50%);
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #4ECDC4;
}

.brand-subtitle {
  font-size: 22rpx;
  color: #8E8E93;
  letter-spacing: 8rpx;
  font-weight: 400;
}

.page-title {
  font-size: 64rpx;
  font-weight: 700;
  color: #1D1D1F;
  letter-spacing: -1rpx;
}

/* ====== 个人信息卡片 ====== */
.exhibit-avatar-wrap {
  margin-bottom: 16rpx;
}

.exhibit-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 4rpx solid #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.exhibit-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1D1D1F;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 300rpx;
  margin: 0 auto;
}

/* ====== 数据统计 ====== */
.exhibit-stats {
  background: linear-gradient(135deg, #FFFFFF 0%, #FAFAFA 100%);
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  border: 1rpx solid rgba(134, 134, 139, 0.1);
  box-shadow: 0 4rpx 16rpx rgba(134, 134, 139, 0.04);
}

.exhibit-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 0;
}

.exhibit-stat:active {
  transform: scale(0.96);
}

.exhibit-stat-num {
  font-size: 56rpx;
  font-weight: 700;
  color: #1D1D1F;
  line-height: 1;
  letter-spacing: -2rpx;
}

.exhibit-stat-label {
  font-size: 22rpx;
  color: #AEAEB2;
  letter-spacing: 1rpx;
}

/* ====== 我的订单 - 艺术展陈风格 ====== */
.order-exhibit-section {
  margin: 0 32rpx 48rpx;
  animation: fadeUp 0.5s ease-out 0.2s both;
}

.exhibit-header {
  display: flex;
  align-items: flex-end;
  gap: 24rpx;
  padding: 0 0 32rpx;
}

.exhibit-number {
  font-size: 96rpx;
  font-weight: 700;
  line-height: 1;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.06) 0%, rgba(0, 0, 0, 0.03) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  letter-spacing: -4rpx;
}

.exhibit-title-block {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding-bottom: 8rpx;
}

.exhibit-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1D1D1F;
  letter-spacing: 2rpx;
}

.exhibit-line {
  width: 48rpx;
  height: 3rpx;
  background: linear-gradient(90deg, #1D1D1F 0%, transparent 100%);
  border-radius: 2rpx;
}

.exhibit-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.exhibit-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.exhibit-row-index {
  width: 48rpx;
  font-size: 28rpx;
  font-weight: 300;
  color: #C7C7CC;
  letter-spacing: 2rpx;
  font-family: -apple-system, 'Helvetica Neue', monospace;
  padding-top: 24rpx;
  flex-shrink: 0;
  text-align: center;
}

.exhibit-row-card {
  flex: 1;
  border-radius: 24rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  position: relative;
  overflow: hidden;
  transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.exhibit-row-card:active {
  transform: scale(0.98);
}

/* 图标容器 */
.exhibit-row-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.exhibit-icon-img {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.85;
}

/* 活动订单 - 绿色 */
.exhibit-row-card.activity {
  background: linear-gradient(135deg, #FFFFFF 0%, #F8FFFE 100%);
  border: 1rpx solid rgba(52, 199, 89, 0.12);
  box-shadow: 0 4rpx 16rpx rgba(52, 199, 89, 0.05);
}

.exhibit-row-card.activity .exhibit-row-icon {
  background: linear-gradient(135deg, rgba(52, 199, 89, 0.15) 0%, rgba(48, 209, 88, 0.08) 100%);
}

.exhibit-row-card.activity .exhibit-icon-img {
  filter: brightness(0) saturate(100%) invert(43%) sepia(87%) saturate(1562%) hue-rotate(86deg) brightness(98%) contrast(92%);
}

/* 服务订单 - 蓝色 */
.exhibit-row-card.service {
  background: linear-gradient(135deg, #FFFFFF 0%, #F8FCFF 100%);
  border: 1rpx solid rgba(0, 122, 255, 0.12);
  box-shadow: 0 4rpx 16rpx rgba(0, 122, 255, 0.05);
}

.exhibit-row-card.service .exhibit-row-icon {
  background: linear-gradient(135deg, rgba(90, 200, 250, 0.15) 0%, rgba(0, 122, 255, 0.08) 100%);
}

.exhibit-row-card.service .exhibit-icon-img {
  filter: brightness(0) saturate(100%) invert(45%) sepia(98%) saturate(3478%) hue-rotate(194deg) brightness(96%) contrast(96%);
}

/* 团购订单 - 紫色 */
.exhibit-row-card.group {
  background: linear-gradient(135deg, #FFFFFF 0%, #FFFAFF 100%);
  border: 1rpx solid rgba(191, 90, 242, 0.12);
  box-shadow: 0 4rpx 16rpx rgba(191, 90, 242, 0.05);
}

.exhibit-row-card.group .exhibit-row-icon {
  background: linear-gradient(135deg, rgba(191, 90, 242, 0.15) 0%, rgba(175, 82, 222, 0.08) 100%);
}

.exhibit-row-card.group .exhibit-icon-img {
  filter: brightness(0) saturate(100%) invert(43%) sepia(86%) saturate(2592%) hue-rotate(268deg) brightness(95%) contrast(93%);
}

/* 寄养订单 - 橙色 */
.exhibit-row-card.hosting {
  background: linear-gradient(135deg, #FFFFFF 0%, #FFFCF8 100%);
  border: 1rpx solid rgba(255, 159, 10, 0.12);
  box-shadow: 0 4rpx 16rpx rgba(255, 159, 10, 0.05);
}

.exhibit-row-card.hosting .exhibit-row-icon {
  background: linear-gradient(135deg, rgba(255, 159, 10, 0.15) 0%, rgba(255, 103, 35, 0.08) 100%);
}

.exhibit-row-card.hosting .exhibit-icon-img {
  filter: brightness(0) saturate(100%) invert(66%) sepia(74%) saturate(1388%) hue-rotate(355deg) brightness(99%) contrast(97%);
}

/* 商城订单 - 紫色 */
.exhibit-row-card.mall {
  background: linear-gradient(135deg, #FFFFFF 0%, #FDF8FF 100%);
  border: 1rpx solid rgba(156, 39, 176, 0.12);
  box-shadow: 0 4rpx 16rpx rgba(156, 39, 176, 0.05);
}

.exhibit-row-card.mall .exhibit-row-icon {
  background: linear-gradient(135deg, rgba(156, 39, 176, 0.15) 0%, rgba(123, 31, 162, 0.08) 100%);
}

.exhibit-row-card.mall .exhibit-icon-img {
  filter: brightness(0) saturate(100%) invert(25%) sepia(89%) saturate(1576%) hue-rotate(276deg) brightness(92%) contrast(94%);
}

/* 中性色图标 - 账户设置 */
.exhibit-row-card.neutral {
  background: linear-gradient(135deg, #FFFFFF 0%, #FAFAFA 100%);
  border: 1rpx solid rgba(134, 134, 139, 0.12);
  box-shadow: 0 4rpx 16rpx rgba(134, 134, 139, 0.04);
}

.neutral-icon-user {
  background: linear-gradient(135deg, #F2F2F7 0%, #E5E5EA 100%);
}

.neutral-icon-user::before {
  content: '';
  position: absolute;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #86868B;
  top: 30%;
  left: 50%;
  transform: translateX(-50%);
}

.neutral-icon-user::after {
  content: '';
  position: absolute;
  bottom: 10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 24rpx;
  height: 14rpx;
  border-radius: 50% 50% 0 0;
  background: #86868B;
}

.neutral-icon-shop {
  background: linear-gradient(135deg, #F2F2F7 0%, #E5E5EA 100%);
}

.neutral-icon-shop::before {
  content: '';
  position: absolute;
  top: 12rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 16rpx solid transparent;
  border-right: 16rpx solid transparent;
  border-bottom: 10rpx solid #86868B;
}

.neutral-icon-shop::after {
  content: '';
  position: absolute;
  top: 22rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 24rpx;
  height: 16rpx;
  background: #86868B;
  border-radius: 2rpx;
}

.partner-icon {
  background: linear-gradient(135deg, #4ECDC4 0%, #26A69A 100%);
}

.partner-icon::before {
  content: '';
  position: absolute;
  top: 14rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 20rpx;
  height: 4rpx;
  background: #ffffff;
  border-radius: 2rpx;
}

.partner-icon::after {
  content: '';
  position: absolute;
  top: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 12rpx;
  height: 12rpx;
  border: 3rpx solid #ffffff;
  border-radius: 50%;
}

.exhibit-row-card.partner {
  border-left: 3rpx solid #4ECDC4;
}

/* 联系客服卡片 */
.contact-row-card {
  position: relative;
}

.contact-overlay-btn {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  z-index: 1;
  padding: 0 !important;
  margin: 0 !important;
  border: none !important;
  background: transparent !important;
  line-height: normal !important;
  min-width: 0 !important;
  font-size: 0 !important;
}

.contact-overlay-btn::after {
  border: none !important;
}

.neutral-icon-cs {
  background: linear-gradient(135deg, #E8F5E9 0%, #C8E6C9 100%);
}

.neutral-icon-cs::before {
  content: '';
  position: absolute;
  top: 14rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 22rpx;
  height: 16rpx;
  border: 3rpx solid #4CAF50;
  border-radius: 4rpx 4rpx 8rpx 8rpx;
  background: transparent;
}

.neutral-icon-cs::after {
  content: '';
  position: absolute;
  top: 24rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #4CAF50;
}

.neutral-icon-lock {
}

.neutral-icon-lock {
  background: linear-gradient(135deg, #F2F2F7 0%, #E5E5EA 100%);
}

.neutral-icon-lock::before {
  content: '';
  position: absolute;
  top: 14rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 20rpx;
  height: 12rpx;
  border: 4rpx solid #86868B;
  border-bottom: none;
  border-radius: 10rpx 10rpx 0 0;
}

.neutral-icon-lock::after {
  content: '';
  position: absolute;
  top: 26rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 28rpx;
  height: 18rpx;
  background: #86868B;
  border-radius: 4rpx;
}

.neutral-icon-info {
  background: linear-gradient(135deg, #F2F2F7 0%, #E5E5EA 100%);
}

.neutral-icon-info::before {
  content: '';
  position: absolute;
  top: 16rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #86868B;
}

.neutral-icon-info::after {
  content: '';
  position: absolute;
  top: 30rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 6rpx;
  height: 20rpx;
  background: #86868B;
  border-radius: 3rpx;
}

.exhibit-row-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.exhibit-row-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1D1D1F;
  letter-spacing: 1rpx;
}

.exhibit-row-desc {
  font-size: 22rpx;
  color: #AEAEB2;
  letter-spacing: 0.5rpx;
}

.exhibit-row-arrow {
  width: 12rpx;
  height: 12rpx;
  border-top: 3rpx solid #C7C7CC;
  border-right: 3rpx solid #C7C7CC;
  transform: rotate(45deg);
  flex-shrink: 0;
  margin-top: 20rpx;
}

/* ====== 区块通用 ====== */
.section {
  margin: 0 32rpx 32rpx;
  animation: fadeUp 0.5s ease-out 0.2s both;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D1D1F;
  margin-bottom: 20rpx;
  padding-left: 8rpx;
}

/* ====== 快捷功能 4宫格 ====== */
.grid-card {
  background: #FFFFFF;
  border-radius: 36rpx;
  padding: 24rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.grid-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 0;
}

.grid-cell:active {
  transform: scale(0.96);
}

.grid-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.grid-icon-wrap.pet {
  background: linear-gradient(135deg, #F5F5F7 0%, #E5E5EA 100%);
}

.grid-icon-wrap.order {
  background: linear-gradient(135deg, #F5F5F7 0%, #E5E5EA 100%);
}

.grid-icon-wrap.heart {
  background: linear-gradient(135deg, #FFF5F5 0%, #FFE5E5 100%);
}

.grid-icon-wrap.coupon {
  background: linear-gradient(135deg, #F5F5F7 0%, #E5E5EA 100%);
}

.grid-label {
  font-size: 22rpx;
  color: #636366;
  text-align: center;
  letter-spacing: 0.5rpx;
}

/* 4宫格 CSS 图标 */
.grid-icon-pet {
  width: 36rpx;
  height: 36rpx;
  position: relative;
}

.grid-icon-pet::before {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 28rpx;
  height: 20rpx;
  border-radius: 50% 50% 0 0;
  background: #86868B;
}

.grid-icon-pet::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 10rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #86868B;
  transform: rotate(-15deg);
  box-shadow: 18rpx 0 0 0 #86868B, 9rpx -4rpx 0 0 #86868B;
}

.grid-icon-order {
  width: 32rpx;
  height: 36rpx;
  border: 4rpx solid #86868B;
  border-radius: 6rpx;
  position: relative;
}

.grid-icon-order::before {
  content: '';
  position: absolute;
  top: -8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 16rpx;
  height: 6rpx;
  border: 4rpx solid #86868B;
  border-radius: 0 0 4rpx 4rpx;
  border-top: none;
}

.grid-icon-order::after {
  content: '';
  position: absolute;
  top: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 12rpx;
  height: 3rpx;
  background: #86868B;
  box-shadow: 0 6rpx 0 0 #86868B, 0 12rpx 0 0 #86868B;
}

.grid-icon-heart {
  width: 36rpx;
  height: 32rpx;
  position: relative;
}

.grid-icon-heart::before,
.grid-icon-heart::after {
  content: '';
  position: absolute;
  top: 0;
  width: 20rpx;
  height: 32rpx;
  border-radius: 20rpx 20rpx 0 0;
  background: #FF6B6B;
  transform: rotate(-45deg);
  transform-origin: bottom center;
}

.grid-icon-heart::before {
  left: 10rpx;
}

.grid-icon-heart::after {
  right: 10rpx;
  transform: rotate(45deg);
}

.grid-icon-coupon {
  width: 36rpx;
  height: 24rpx;
  background: #86868B;
  border-radius: 4rpx;
  position: relative;
}

.grid-icon-coupon::before {
  content: '';
  position: absolute;
  top: 50%;
  right: -6rpx;
  transform: translateY(-50%);
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: -36rpx 0 0 0 #FFFFFF;
}

.grid-icon-coupon::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translateY(-50%);
  width: 16rpx;
  height: 2rpx;
  background: #FFFFFF;
}

/* ====== 列表卡片（热门服务 + 账户设置） ====== */
.list-card {
  background: #FFFFFF;
  border-radius: 36rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.list-cell {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 28rpx;
  border-bottom: 1rpx solid #F2F2F7;
  transition: background 0.2s ease;
}

.list-cell:last-child {
  border-bottom: none;
}

.list-cell:active {
  background: #FAFAFA;
}

.list-indicator {
  width: 4rpx;
  height: 36rpx;
  border-radius: 2rpx;
  flex-shrink: 0;
}

.list-indicator.activity {
  background: #34C759;
}

.list-indicator.service {
  background: #2196F3;
}

.list-indicator.group {
  background: #9C27B0;
}

.list-indicator.hosting {
  background: #FF8C00;
}

.list-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.list-icon-wrap.boarding {
  background: linear-gradient(135deg, #FFF3E0 0%, #FFE0B2 100%);
}

.list-icon-wrap.feeding {
  background: linear-gradient(135deg, #E3F2FD 0%, #BBDEFB 100%);
}

.list-icon-wrap.activity {
  background: linear-gradient(135deg, #E8F5E9 0%, #C8E6C9 100%);
}

.list-icon-wrap.referral {
  background: linear-gradient(135deg, #F3E5F5 0%, #E1BEE7 100%);
}

.list-icon-wrap.neutral {
  background: linear-gradient(135deg, #F5F5F7 0%, #E5E5EA 100%);
}

.list-label {
  flex: 1;
  font-size: 30rpx;
  color: #1D1D1F;
  letter-spacing: 0.5rpx;
}

.list-arrow {
  width: 12rpx;
  height: 12rpx;
  border-top: 3rpx solid #C7C7CC;
  border-right: 3rpx solid #C7C7CC;
  transform: rotate(45deg);
  flex-shrink: 0;
}

/* 列表 CSS 图标 */
.list-icon-home {
  width: 32rpx;
  height: 24rpx;
  position: relative;
}

.list-icon-home::before {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 24rpx;
  height: 16rpx;
  border: 4rpx solid #FF8C00;
  border-top: none;
  border-radius: 0 0 4rpx 4rpx;
}

.list-icon-home::after {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 20rpx solid transparent;
  border-right: 20rpx solid transparent;
  border-bottom: 12rpx solid #FF8C00;
}

.list-icon-bowl {
  width: 32rpx;
  height: 20rpx;
  border: 4rpx solid #2196F3;
  border-top: none;
  border-radius: 0 0 20rpx 20rpx;
  position: relative;
}

.list-icon-bowl::before {
  content: '';
  position: absolute;
  top: -6rpx;
  left: -2rpx;
  width: 36rpx;
