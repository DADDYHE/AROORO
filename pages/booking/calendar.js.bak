const app = getApp()
const db = wx.cloud.database({
  env: app.globalData.envId
})
import loginModule from '../../src/modules/auth/index'
const { enhancePage } = require('../../utils/base-page')
const { centralIdentityManager } = require('../../utils/CentralIdentityManager')

Page(enhancePage({
  data: {
    showCalendar: false,
    minDate: new Date().getTime(),
    maxDate: new Date(new Date().getFullYear(), new Date().getMonth() + 6, new Date().getDate()).getTime(),
    defaultDate: null,
    selectedStartDate: '',
    selectedEndDate: '',
    days: 0,
    isLoggedIn: false,
    selectedPetsCount: 0,
    selectedLocation: '', // 显示用的位置文本
    locationDetail: null, // 详细位置信息（包含经纬度等）
    dailyPrice: 100, // 假设每日价格为100元
    estimatedTotal: 0,
    userRole: 'owner', // 用户角色，默认为宠物主人
    hostOrders: [] // 寄养家庭的订单列表
  },

  onLoad() {
    // 检查用户是否已登录
    this.checkLoginStatus()
    // 获取用户角色
    this.getUserInfo()
    
    // 初始化默认日期（今天和明天）
    const today = new Date()
    const tomorrow = new Date(today.getTime() + 24 * 60 * 60 * 1000)

    // 格式化初始日期
    const formatDate = date => {
      const month = String(date.getMonth() + 1).padStart(2, '0')
      const day = String(date.getDate()).padStart(2, '0')
      const weekDays = ['周日', '周一', '周二', '周三', '周四', '周五', '周六']
      const weekDay = weekDays[date.getDay()]
      return {
        text: `${month}月${day}日`,
        weekDay: weekDay
      }
    }

    const todayFormatted = formatDate(today)
    const tomorrowFormatted = formatDate(tomorrow)
    const initialDays = 1

    this.setData({
      defaultDate: [today, tomorrow],
      selectedStartDate: todayFormatted,
      selectedEndDate: tomorrowFormatted,
      days: initialDays,
      estimatedTotal: initialDays * this.data.dailyPrice
    })
    
    // 检查是否有已选择的宠物
    this.checkSelectedPets()
  },
  
  // 检查登录状态
  async checkLoginStatus() {
    try {
      const isLoggedIn = await loginModule.checkLoginStatusValid()
      this.setData({
        isLoggedIn: isLoggedIn
      })
      
      if (!isLoggedIn) {
        // 引导用户登录
        const loginResult = await loginModule.login()
        if (loginResult.success) {
          this.setData({
            isLoggedIn: true
          })
        }
      }
    } catch (error) {
      console.error('检查登录状态失败:', error)
      this.setData({
        isLoggedIn: false
      })
    }
  },

  async getUserInfo() {
    try {
      // 使用标准登录模块获取用户信息
      const userInfo = loginModule.getUserInfo()
      const userRole = loginModule.getUserRole() || 'owner'
      
      if (userInfo) {
        this.setData({
          userRole: userRole
        })
        
        // 根据用户角色加载不同的数据
        if (userRole === 'host') {
          this.getHostOrders()
        }
        return
      }
      
      // 如果没有用户信息，尝试登录
      console.log('getUserInfo - 没有用户信息，尝试登录获取')
      const loginResult = await loginModule.login()
      
      if (loginResult.success) {
        const newUserInfo = loginModule.getUserInfo()
        const newUserRole = loginModule.getUserRole() || 'owner'
        
        this.setData({
          userRole: newUserRole
        })
        
        // 根据用户角色加载不同的数据
        if (newUserRole === 'host') {
          this.getHostOrders()
        }
      }
    } catch (error) {
      console.error('获取用户信息失败:', error)
    }
  },
  
  // 获取寄养家庭的订单数据
  getHostOrders() {
    // 调用云函数获取订单数据
    wx.cloud.callFunction({
      name: 'getHostOrders',
      success: (res) => {
        console.log('获取寄养家庭订单数据成功:', res.result)
        
        if (res.result.code === 0 && res.result.data) {
          this.setData({
            hostOrders: res.result.data
          })
        } else {
          console.error('获取寄养家庭订单数据失败:', res.result.message)
          // 使用模拟数据作为备用
          this.setData({
            hostOrders: [
              {
                id: '1',
                petName: '小白',
                ownerName: '张三',
                startDate: '2024-01-15',
                endDate: '2024-01-20',
                status: 'pending',
                price: 500
              },
              {
                id: '2',
                petName: '旺财',
                ownerName: '李四',
                startDate: '2024-01-25',
                endDate: '2024-01-30',
                status: 'confirmed',
                price: 600
              }
            ]
          })
        }
      },
      fail: (error) => {
        console.error('调用云函数 getHostOrders 失败:', error)
        // 使用模拟数据作为备用
        this.setData({
          hostOrders: [
            {
              id: '1',
              petName: '小白',
              ownerName: '张三',
              startDate: '2024-01-15',
              endDate: '2024-01-20',
              status: 'pending',
              price: 500
            },
            {
              id: '2',
              petName: '旺财',
              ownerName: '李四',
              startDate: '2024-01-25',
              endDate: '2024-01-30',
              status: 'confirmed',
              price: 600
            }
          ]
        })
      }
    })
  },

  // 打开日期选择器
  openDateSelector() {
    this.setData({
      showCalendar: true
    })
  },

  // 打开位置选择器（仅提供城市选择）

  openLocationSelector() {
    // 城市列表（仅包含成都市）
    const cities = [
      { id: '510100', name: '成都市' }
    ]

    // 显示城市选择列表
    wx.showActionSheet({
      itemList: cities.map(city => city.name),
      success: (res) => {
        const selectedCity = cities[res.tapIndex]
        console.log('选择的城市:', selectedCity)
        
        // 更新页面显示
        this.setData({
          selectedLocation: selectedCity.name
        })

        // 组装位置信息
        const locationInfo = {
          name: selectedCity.name,
          city: selectedCity.name
        }

        // 保存完整的位置信息到全局变量
        const userRole = centralIdentityManager.getCurrentRole() || 'owner'
        if (userRole === 'owner') {
          app.globalData.ownerData.selectedLocation = locationInfo
        } else {
          app.globalData.hostData.selectedLocation = locationInfo
        }

        wx.showToast({
          title: '城市选择成功',
          icon: 'success'
        })
      },
      fail: (error) => {
        console.error('选择城市失败:', error)
      }
    })
  },

  // 跳转到宠物选择页面
  async jumpToPetSelect() {
    wx.navigateTo({
      url: '/subpackages/booking/pet-select'
    })
  },

  // 找寄养
  findHost() {

    if (!this.data.selectedStartDate || !this.data.selectedEndDate) {
      wx.showToast({
        title: '请选择入住和退房日期',
        icon: 'none'
      })
      return
    }

    if (!this.data.selectedLocation) {
      wx.showToast({
        title: '请选择寄养位置',
        icon: 'none'
      })
      return
    }

    if (this.data.selectedPetsCount === 0) {
      wx.showToast({
        title: '请选择宠物',
        icon: 'none'
      })
      return
    }

    // 跳转到寄养家庭列表页面
    wx.navigateTo({
      url: '/subpackages/booking/host-list'
    })
  },

  // 检查已选择的宠物数量
  checkSelectedPets() {
    // 获取当前用户角色和对应的选中宠物数据
    const userRole = app.globalData.userRole || 'owner'
    const selectedPets = userRole === 'owner' ? app.globalData.ownerData.selectedPets : app.globalData.hostData.selectedPets
    
    if (selectedPets && selectedPets.length > 0) {
      this.setData({
        selectedPetsCount: selectedPets.length
      })
    }
  },

  // 检查用户登录状态
  // 使用增强页面提供的方法

  // 微信登录
  // 使用增强页面提供的方法

  onConfirm(event) {
    console.log('========================================')
    console.log('日期选择器确定按钮点击事件触发')
    console.log('事件对象:', event)
    console.log('event.detail:', event.detail)
    console.log('========================================')

    let startDate, endDate

    try {
      // Vant Weapp 1.11.7 版本 type="range" 模式的标准事件参数结构
      // 标准结构1：event.detail = { start: 时间戳, end: 时间戳 }
      if (event.detail && typeof event.detail.start === 'number' && typeof event.detail.end === 'number') {
        startDate = new Date(event.detail.start)
        endDate = new Date(event.detail.end)
        console.log('使用 Vant 1.11.7 标准结构1：event.detail.start 和 event.detail.end（时间戳）')
      }
      // 标准结构2：event.detail = { start: Date, end: Date }
      else if (event.detail && event.detail.start instanceof Date && event.detail.end instanceof Date) {
        startDate = event.detail.start
        endDate = event.detail.end
        console.log('使用标准结构2：event.detail.start 和 event.detail.end（Date 对象）')
      }
      // 标准结构3：event.detail.value = [时间戳, 时间戳]
      else if (event.detail && event.detail.value && Array.isArray(event.detail.value) && event.detail.value.length === 2) {
        if (typeof event.detail.value[0] === 'number') {
          startDate = new Date(event.detail.value[0])
          endDate = new Date(event.detail.value[1])
          console.log('使用标准结构3：event.detail.value 是时间戳数组')
        } else if (event.detail.value[0] instanceof Date) {
          startDate = event.detail.value[0]
          endDate = event.detail.value[1]
          console.log('使用标准结构4：event.detail.value 是 Date 对象数组')
        }
      }
      // 兼容结构5：event.detail 是日期字符串数组
      else if (Array.isArray(event.detail) && event.detail.length === 2) {
        if (typeof event.detail[0] === 'string' && typeof event.detail[1] === 'string') {
          startDate = new Date(event.detail[0])
          endDate = new Date(event.detail[1])
          console.log('使用兼容结构5：event.detail 是日期字符串数组')
        } else if (typeof event.detail[0] === 'number') {
          startDate = new Date(event.detail[0])
          endDate = new Date(event.detail[1])
          console.log('使用兼容结构1：event.detail 是时间戳数组')
        } else if (event.detail[0] instanceof Date) {
          startDate = event.detail[0]
          endDate = event.detail[1]
          console.log('使用兼容结构2：event.detail 是 Date 对象数组')
        }
      }
      else {
        console.error('未识别的事件参数结构:', JSON.stringify(event))
        throw new Error('未识别的事件参数结构')
      }

      // 验证日期对象
      if (!startDate || !endDate) {
        console.error('日期对象为空:', { startDate, endDate })
        throw new Error('日期对象为空')
      }

      if (!(startDate instanceof Date && !isNaN(startDate.getTime()) && endDate instanceof Date && !isNaN(endDate.getTime()))) {
        console.error('日期对象验证失败:', { startDate, endDate })
        throw new Error('无效的日期对象')
      }
      
      console.log('日期选择成功，开始日期:', startDate)
      console.log('日期选择成功，结束日期:', endDate)
      
      // 更新选中的日期
      this.updateSelectedDates(startDate, endDate)
      // 关闭日历
      this.setData({
        showCalendar: false
      })
      
      console.log('日期选择器处理完成，showCalendar:', this.data.showCalendar)
      console.log('更新后的选中日期:', {
        selectedStartDate: this.data.selectedStartDate,
        selectedEndDate: this.data.selectedEndDate,
        days: this.data.days
      })
    } catch (error) {
      console.error('日期选择器事件处理失败:', error)
      console.error('事件参数:', JSON.stringify(event))
      
      // 手动获取当前选中的日期（作为备选方案）
      try {
        const today = new Date()
        const tomorrow = new Date(today.getTime() + 24 * 60 * 60 * 1000)
        this.updateSelectedDates(today, tomorrow)
        this.setData({
          showCalendar: false
        })
        console.log('使用默认日期作为备选方案')
      } catch (backupError) {
        console.error('备选方案也失败:', backupError)
      }
    }
  },

  onCancel() {
    this.setData({
      showCalendar: false
    })
  },

  onSelect(event) {
    console.log('========================================')
    console.log('onSelect 事件触发')
    console.log('event.detail:', JSON.stringify(event.detail))
    console.log('========================================')

    // 当选择完整日期范围时自动确认
    if (event.detail && Array.isArray(event.detail) && event.detail.length === 2) {
      const firstDate = event.detail[0]
      const secondDate = event.detail[1]

      console.log('第一个日期:', firstDate)
      console.log('第二个日期:', secondDate)

      // 检查两个日期是否都存在（用户已选择完整日期范围）
      if (firstDate && secondDate) {
        const startDate = new Date(firstDate)
        const endDate = new Date(secondDate)

        console.log('自动确认选中的日期:', {
          startDate: startDate,
          endDate: endDate
        })

        // 延迟关闭日历，确保用户看到选中的效果
        setTimeout(() => {
          this.onConfirm(event)
        }, 300)
      } else {
        console.log('用户只选择了开始日期，等待选择结束日期')
      }
    }
  },

  // 日历日期格式化
  formatter(day) {
    return day
  },

  updateSelectedDates(startDate, endDate) {
    // 确保日期对象有效
    if (!(startDate instanceof Date && endDate instanceof Date)) {
      console.error('updateSelectedDates: 无效的日期对象', { startDate, endDate })
      return
    }
    
    const formatDate = date => {
      // 确保传入的是日期对象
      if (!(date instanceof Date)) {
        date = new Date(date)
      }
      const month = String(date.getMonth() + 1).padStart(2, '0')
      const day = String(date.getDate()).padStart(2, '0')
      const weekDays = ['周日', '周一', '周二', '周三', '周四', '周五', '周六']
      const weekDay = weekDays[date.getDay()]
      return {
        text: `${month}月${day}日`,
        weekDay: weekDay
      }
    }

    const startDateFormatted = formatDate(startDate)
    const endDateFormatted = formatDate(endDate)
    const days = Math.ceil((endDate - startDate) / (1000 * 60 * 60 * 24))

    // 获取当前用户角色和对应的选中宠物数据
    const userRole = app.globalData.userRole || 'owner'
    const selectedPets = userRole === 'owner' ? app.globalData.ownerData.selectedPets : app.globalData.hostData.selectedPets

    // 计算预估总费用，考虑宠物数量折扣
    const petCount = selectedPets ? selectedPets.length : 0

    // 计算基础费用
    let estimatedTotal = days * this.data.dailyPrice

    // 根据宠物数量计算折扣（每增加一只宠物，总费用打 9 折）
    if (petCount > 1) {
      estimatedTotal = estimatedTotal * (0.9 ** (petCount - 1))
    }

    // 计算最终价格（保留整数）
    estimatedTotal = Math.floor(estimatedTotal)

    // 预计算要更新的数据
    const updateData = {
      selectedStartDate: startDateFormatted,
      selectedEndDate: endDateFormatted,
      days: days,
      estimatedTotal: estimatedTotal,
      selectedPetsCount: petCount
    }

    console.log('准备更新的数据:', JSON.stringify(updateData, null, 2))
    console.log('startDateFormatted:', startDateFormatted)
    console.log('endDateFormatted:', endDateFormatted)

    // 更新页面数据
    this.setData(updateData, () => {
      console.log('页面数据更新完成:', {
        selectedStartDate: this.data.selectedStartDate,
        selectedEndDate: this.data.selectedEndDate,
        days: this.data.days,
        estimatedTotal: this.data.estimatedTotal
      })
    })

    // 保存到全局变量，根据用户角色保存到对应的身份数据中
    const selectedDates = {
      start: startDateFormatted,
      end: endDateFormatted,
      days: days,
      dailyPrice: this.data.dailyPrice,
      estimatedTotal: estimatedTotal
    }
    
    if (userRole === 'owner') {
      app.globalData.ownerData.selectedDates = selectedDates
    } else {
      app.globalData.hostData.selectedDates = selectedDates
    }
    
    console.log('全局变量保存完成:', selectedDates)
  },

  nextStep() {

    if (!this.data.selectedStartDate || !this.data.selectedEndDate) {
      wx.showToast({
        title: '请选择入住和退房日期',
        icon: 'none'
      })
      return
    }

    wx.navigateTo({
      url: '/subpackages/booking/pet-select'
    })
  },

  // 检查日期可用性
  async checkDateAvailability(date) {
    try {
      const formatDate = date => {
        const year = date.getFullYear()
        const month = String(date.getMonth() + 1).padStart(2, '0')
        const day = String(date.getDate()).padStart(2, '0')
        return `${year}-${month}-${day}`
      }

      const formattedDate = formatDate(date)
      
      // 调用云函数检查日期可用性
      const result = await wx.cloud.callFunction({
        name: 'checkDateAvailability',
        data: {
          date: formattedDate
        }
      })
      
      if (result.result.code === 0) {
        return result.result.data.isAvailable
      } else {
        console.error('检查日期可用性失败:', result.result.message)
        return true // 默认返回可用
      }
    } catch (error) {
      console.error('检查日期可用性失败:', error)
      return true // 默认返回可用
    }
  },

  // 标记可用日期
  async markAvailableDates() {
    // 这里可以通过扩展 van-calendar 组件来实现日期标记功能
    // 或者使用自定义日历组件
    console.log('标记可用日期')
  },

  // 设置 tabBar 选中状态
  setTabBarSelected() {
    // 调用增强页面提供的方法
    this.setTabBarIndex(1)
  },

  // 页面显示时更新登录状态和 tabBar 选中状态
  onShow() {
    console.log('Booking page onShow - 开始更新登录状态')
    console.log('当前日期数据:', {
      selectedStartDate: this.data.selectedStartDate,
      selectedEndDate: this.data.selectedEndDate,
      days: this.data.days
    })

    // 检查并更新登录状态
    this.checkLoginStatus()
    // 获取用户角色
    this.getUserInfo()
    // 检查已选择的宠物数量
    this.checkSelectedPets()
    // 设置 tabBar 选中状态
    this.setTabBarSelected()

    // 强制更新找寄养按钮样式
    this.updateFindHostButtonStyle()
  },
  
  // 强制更新找寄养按钮样式
  updateFindHostButtonStyle() {
    // 使用 setTimeout 确保 DOM 已渲染完成
    setTimeout(() => {
      // 尝试获取页面所有 custom-button 元素
      const query = wx.createSelectorQuery()
      query.selectAll('.custom-button')
        .fields({
          rect: true,
          dataset: true,
          properties: ['style']
        })
        .exec((res) => {
          if (res && res[0] && res[0].length > 0) {
            console.log('找到按钮:', res[0])
            // 尝试强制设置按钮样式
            // 在微信小程序中，我们可以通过 setData 或直接修改样式
            // 这里我们尝试添加一个强制类名或直接修改样式
            this.setData({
              forceButtonStyle: true
            })
          } else {
            console.log('未找到按钮')
          }
        })
    }, 100)
  }
}))