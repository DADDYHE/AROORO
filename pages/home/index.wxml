<view class="home-container">
  <login-prompt visible="{{showLoginPrompt}}" bind:close="onLoginPromptClose" />

  <!-- ===== Section 1: 顶部栏（对齐设计稿 #topbar，仅登录用户可见） ===== -->
  <header class="topbar" wx:if="{{isLoggedIn}}">
    <view class="topbar-left" catchtap="handleLogin">
      <image wx:if="{{isLoggedIn && userInfo.avatarUrl}}" class="topbar-avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill" />
      <view wx:else class="topbar-avatar topbar-avatar-ph">
        <text class="topbar-avatar-text">{{isLoggedIn ? (userInfo.nickName ? userInfo.nickName.charAt(0) : '宠') : '宠'}}</text>
      </view>
      <view class="topbar-greeting">
        <text class="topbar-name">{{isLoggedIn ? (userInfo.nickName || '铲屎官') : '发现萌宠'}}</text>
        <text class="topbar-loc">{{todayDate || '早上好'}}</text>
      </view>
    </view>
    <view class="topbar-search" catchtap="handleSearch">
      <view class="topbar-search-icon"></view>
      <text class="topbar-search-text">搜索</text>
    </view>
  </header>

  <!-- ===== Section 2: 英雄区（对齐设计稿 #hero） ===== -->
  <view class="hero-section" wx:if="{{bannerList.length}}">
    <swiper class="hero-swiper" autoplay circular interval="5000" duration="400" style="height: {{bannerHeight}}px;">
      <swiper-item wx:for="{{bannerList}}" wx:key="_id" data-action="{{item.actionType || 'none'}}" data-target="{{item.actionTarget || ''}}" bindtap="handleBannerTap">
        <view class="hero-card">
          <image class="hero-img" src="{{item.imageUrl}}" mode="aspectFill" bindload="onBannerImageLoad" />
          <view class="hero-overlay"></view>
          <view class="hero-text">
            <text class="hero-title">{{item.title || '宠爱如初'}}</text>
            <text class="hero-sub">{{item.subtitle || '为爱宠开启精致生活'}}</text>
          </view>
        </view>
      </swiper-item>
    </swiper>
  </view>
  <view class="hero-section" wx:else>
    <view class="hero-card" style="height: {{bannerHeight}}px;">
      <view class="hero-img hero-img-ph"></view>
      <view class="hero-overlay"></view>
      <view class="hero-text">
        <text class="hero-title">宠爱如初</text>
        <text class="hero-sub">为爱宠开启精致生活</text>
      </view>
    </view>
  </view>

  <!-- ===== 内容卡片：整体上移覆盖 banner，顶部 96rpx 圆角 ===== -->
  <view class="home-content-sheet" style="margin-top: {{contentSheetMarginTop}}px;">

  <!-- ===== Section 2.5: 我的宠物（仅登录用户可见） ===== -->
  <view class="section my-pets-section" wx:if="{{isLoggedIn}}">
    <view class="my-pets-header">
      <view class="my-pets-title-wrap">
        <text class="section-title">我的宠物</text>
        <view class="pet-add-btn" catchtap="handleAddPet">
          <text class="pet-add-icon">+</text>
          <text class="pet-add-text">添加</text>
        </view>
      </view>
      <text class="pet-view-all" wx:if="{{myPets.length > 0}}" bindtap="handleViewAllPets">查看全部 ›</text>
    </view>

    <!-- 有宠物：两列网格卡片 -->
    <view class="pets-grid" wx:if="{{myPets.length > 0}}">
      <view class="pet-card pet-card-{{item.genderClass}}" wx:for="{{myPets}}" wx:key="_id" data-id="{{item._id}}" bindtap="handlePetTap">
        <image class="pet-avatar pet-avatar-{{item.genderClass}}" src="{{item.avatarUrl}}" mode="aspectFill" />
        <view class="pet-info">
          <view class="pet-name-row">
            <text class="pet-name">{{item.name || '未命名'}}</text>
            <text class="pet-gender-tag pet-gender-{{item.genderClass}}">{{item.genderSymbol}}</text>
          </view>
          <text class="pet-breed" wx:if="{{item.breed}}">{{item.breed}}</text>
        </view>
      </view>
    </view>

    <!-- 无宠物：两个占位卡片 -->
    <view class="pets-grid pets-grid-empty" wx:else>
      <view class="pet-card pet-card-empty" wx:for="{{[1,2]}}" wx:key="*this" bindtap="handleAddPet">
        <text class="pet-empty-text">宠物档案待添加</text>
      </view>
    </view>
  </view>

  <!-- ===== Section 3: 未登录登录入口 ===== -->
  <view class="search-section" wx:if="{{!isLoggedIn}}">
    <view class="home-login-btn" catchtap="handleLogin">
      <text class="home-login-text">立即登录</text>
    </view>
  </view>

  <!-- ===== Section 4: 快捷服务入口 ===== -->
  <view class="quick-services-wrapper">
    <view class="quick-services">
    <view class="qs-item" data-action="activity" bindtap="handleBannerTap">
      <view class="qs-icon qs-icon-activity">
        <image class="qs-emoji-img" src="cloud://cloudbase-d7getcjqy33b13475.636c-cloudbase-d7getcjqy33b13475-1433773870/icons/megaphone-line.svg" mode="aspectFit" />
      </view>
      <text class="qs-title">线下活动</text>
      <text class="qs-subtitle">精彩社区活动</text>
      <view class="qs-accent qs-accent-activity"></view>
    </view>
    <view class="qs-item" data-action="mall" bindtap="handleBannerTap">
      <view class="qs-icon qs-icon-mall">
        <image class="qs-emoji-img" src="cloud://cloudbase-d7getcjqy33b13475.636c-cloudbase-d7getcjqy33b13475-1433773870/icons/shopping-cart-2-line.svg" mode="aspectFit" />
      </view>
      <text class="qs-title">宠物商城</text>
      <text class="qs-subtitle">精选好物推荐</text>
      <view class="qs-accent qs-accent-mall"></view>
    </view>
    </view>
  </view>

  <!-- ===== Section 5: 团购好物（横滑商品卡，图片占满 + 底部渐变标题） ===== -->
  <view class="section" wx:if="{{tuanDeals.length}}">
    <view class="section-head">
      <text class="section-title">团购好物</text>
      <text class="section-link" bindtap="handleViewAllTuan">查看全部 ›</text>
    </view>
    <scroll-view class="featured-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
      <view class="mall-card" wx:for="{{tuanDeals}}" wx:key="_id" data-id="{{item._id}}" bindtap="handleTuanTap">
        <image wx:if="{{item.coverUrl}}" class="mall-card-img" src="{{item.coverUrl}}" mode="aspectFill" />
        <view wx:else class="mall-card-img mall-card-img-ph">
          <text class="featured-img-ph-text">团</text>
        </view>
        <view class="mall-card-overlay"></view>
        <view class="mall-card-info">
          <text class="mall-card-name">{{item.title}}</text>
          <view class="mall-card-price-row">
            <text class="mall-card-price">¥{{item.minPrice}}</text>
            <text class="mall-card-sold" wx:if="{{item.totalOrders > 0}}">已拼{{item.totalOrders}}件</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- ===== Section 5.5: 商城好物（横滑商品卡，图片占满 + 底部渐变标题） ===== -->
  <view class="section" wx:if="{{mallProducts.length}}">
    <view class="section-head">
      <text class="section-title">商城好物</text>
      <text class="section-link" bindtap="handleViewAllMallProducts">查看全部 ›</text>
    </view>
    <scroll-view class="featured-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
      <view class="mall-card" wx:for="{{mallProducts}}" wx:key="_id" data-id="{{item._id}}" bindtap="handleMallProductTap">
        <image wx:if="{{item.coverUrl}}" class="mall-card-img" src="{{item.coverUrl}}" mode="aspectFill" />
        <view wx:else class="mall-card-img mall-card-img-ph">
          <text class="featured-img-ph-text">品</text>
        </view>
        <view class="mall-card-overlay"></view>
        <view class="mall-card-info">
          <text class="mall-card-name">{{item.name}}</text>
          <view class="mall-card-price-row">
            <text class="mall-card-price">¥{{item.price}}</text>
            <text class="mall-card-original" wx:if="{{item.originalPrice > item.price}}">¥{{item.originalPrice}}</text>
            <text class="mall-card-sold" wx:if="{{item.soldCount > 0}}">已售{{item.soldCount}}</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- ===== Section 6: 近期活动（对齐设计稿 #activity 横向卡片左图右文） ===== -->
  <view class="section" wx:if="{{latestActivities.length}}">
    <view class="section-head">
      <text class="section-title">近期活动</text>
      <text class="section-link" bindtap="handleViewAllActivities">更多 ›</text>
    </view>
    <view class="activity-list">
      <view class="activity-h-card" wx:for="{{latestActivities}}" wx:key="_id" data-id="{{item._id}}" bindtap="handleActivityTap">
        <image wx:if="{{item.coverUrl}}" class="activity-h-img" src="{{item.coverUrl}}" mode="aspectFill" />
        <view wx:else class="activity-h-img activity-h-img-ph">
          <text class="activity-h-img-ph-text">活动</text>
        </view>
        <view class="activity-h-body">
          <text class="activity-h-name">{{item.title}}</text>
          <text class="activity-h-info">{{item.timeText}}</text>
          <view class="activity-h-meta">
            <text class="activity-h-loc">📍 {{item.location || '待定'}}</text>
          </view>
          <text class="activity-h-people" wx:if="{{item.currentParticipants > 0}}">👥 已有{{item.currentParticipants}}人报名</text>
        </view>
      </view>
    </view>
  </view>

  <view class="bottom-spacer"></view>
  </view>
</view>
