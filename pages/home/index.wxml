<view class="home-container">
  <!-- 轮播 Banner -->
  <swiper class="home-banner" style="height: {{bannerHeight}}px;" autoplay circular interval="5000" indicator-dots indicator-color="rgba(255,255,255,0.3)" indicator-active-color="#ffffff">
    <swiper-item wx:for="{{bannerList}}" wx:key="id">
      <view class="banner-item" data-action="{{item.action}}" data-target="{{item.actionTarget}}" bindtap="handleBannerTap">
        <image lazy-load class="banner-image" src="{{item.image}}" mode="widthFix" binderror="onCloudImageError" data-src="{{item.image}}" data-path="bannerList[{{index}}].image" />
        <view class="banner-overlay"></view>
        <view class="banner-content">
          <view class="banner-tag">{{item.tag || 'AROORO'}}</view>
          <text class="banner-title">{{item.title}}</text>
          <text class="banner-subtitle">{{item.subtitle}}</text>
          <view class="banner-cta">
            <text class="banner-cta-text">{{item.ctaText || '立即体验'}}</text>
            <view class="banner-cta-arrow">→</view>
          </view>
        </view>
        <view class="banner-decoration">
          <view class="deco-line deco-line-1"></view>
          <view class="deco-line deco-line-2"></view>
          <view class="deco-circle"></view>
        </view>
      </view>
    </swiper-item>
  </swiper>

  <view class="page-content">

    <!-- 登录提示（未登录时显示） -->
    <view wx:if="{{!isLoggedIn}}" class="login-prompt-card card">
      <view class="login-prompt-content">
        <view class="login-prompt-text">
          <text class="login-prompt-title">欢迎加入AROORO</text>
          <text class="login-prompt-subtitle">安心呼噜，放心托付</text>
        </view>
        <view class="login-prompt-action">
          <button class="login-prompt-btn" bindtap="handleLogin">立即登录</button>
        </view>
      </view>
    </view>

    <!-- 我的宠物（已登录时显示） -->
    <view wx:if="{{isLoggedIn}}" class="section-card card">
      <view class="card-header">
        <view class="card-title-row">
          <text class="card-title">我的宠物</text>
          <view class="add-pet-btn" bindtap="handleAddPet">
            <text class="add-pet-icon">+</text>
            <text class="add-pet-text">添加</text>
          </view>
        </view>
        <view class="view-more-container" bindtap="handleViewAllPets" wx:if="{{hasMorePets}}">
          <text class="view-more">查看更多</text>
          <text class="view-more-arrow">›</text>
        </view>
      </view>
      <view class="pets-scroll" wx:if="{{displayPets.length > 0}}">
        <view class="pet-card pet-card-{{item.genderClass}}" wx:for="{{displayPets}}" wx:key="_id" data-id="{{item._id}}" bindtap="handlePetTap">
          <image lazy-load class="pet-avatar" src="{{item.avatarUrl}}" mode="aspectFill" wx:if="{{item.avatarUrl}}" binderror="onCloudImageError" data-src="{{item.avatarUrl}}" data-path="displayPets[{{index}}].avatarUrl" />
          <view class="pet-avatar-placeholder" wx:else>
            <text>{{item.name.charAt(0)}}</text>
          </view>
          <view class="pet-info">
            <text class="pet-name">{{item.name}}</text>
            <text class="pet-breed">{{item.breed}}</text>
            <text class="pet-age" wx:if="{{item.birthday}}">{{item.birthday}}</text>
          </view>
        </view>
      </view>
      <view wx:else class="empty-pets" bindtap="handleAddPet">
        <text class="empty-text">点击添加你的第一只宠物</text>
      </view>
    </view>

    <!-- 功能入口 -->
    <view class="feature-card">
      <view class="feature-grid">
        <view class="feature-item {{item.id}}-item {{item.comingSoon ? 'coming-soon-item' : ''}}" wx:for="{{featureItems}}" wx:key="id" bindtap="{{item.comingSoon ? '' : 'handleFeatureTap'}}" data-id="{{item.id}}">
          <view class="feature-background"></view>
          <view class="feature-content">
            <view class="feature-icon  feature-icon-{{item.id}}">
              <image lazy-load class="feature-icon-image" src="{{item.icon}}" mode="aspectFit" binderror="onCloudImageError" data-src="{{item.icon}}" data-path="featureItems[{{index}}].icon" />
            </view>
            <text class="feature-text">{{item.name}}</text>
            <text class="feature-desc">{{item.desc}}</text>
            <view class="feature-accent"></view>
          </view>
          <view wx:if="{{item.comingSoon}}" class="coming-soon-mask">
            <view class="coming-soon-dots">
              <view class="coming-soon-dot"></view>
              <view class="coming-soon-dot"></view>
              <view class="coming-soon-dot"></view>
            </view>
            <text class="coming-soon-text">敬请期待！</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 宠团团 -->
    <view class="tuan-section" wx:if="{{tuanDeals.length > 0}}">
      <view class="section-header">
        <text class="section-title">宠团团</text>
        <view class="view-more" bindtap="handleViewAllTuan">
          <text>查看全部</text>
          <text class="view-more-arrow">›</text>
        </view>
      </view>

      <view class="tuan-list">
        <view class="tuan-card" wx:for="{{tuanDeals}}" wx:key="_id" data-id="{{item._id}}" bindtap="handleTuanTap">
          <view class="tuan-cover-wrap">
            <image lazy-load class="tuan-cover" src="{{item.coverUrl}}" mode="aspectFill" binderror="onCloudImageError" data-src="{{item.coverUrl}}" data-path="tuanDeals[{{index}}].coverUrl" />
            <view class="tuan-badge">
              <text class="tuan-badge-text">团购</text>
            </view>
          </view>
          <view class="tuan-info">
            <text class="tuan-name truncate">{{item.title}}</text>
            <view class="tuan-meta">
              <text class="tuan-price">¥{{item.minPrice}}</text>
              <text class="tuan-orders" wx:if="{{item.totalOrders > 0}}">{{item.totalOrders}}人已团</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 最新活动 -->
    <view class="activities-section" wx:if="{{latestActivities.length > 0}}">
      <view class="section-header">
        <text class="section-title">最新活动</text>
        <view class="view-more" bindtap="handleViewAllActivities">
          <text>查看全部</text>
          <text class="view-more-arrow">›</text>
        </view>
      </view>

      <view class="activity-list">
        <view class="activity-block" wx:for="{{latestActivities}}" wx:key="_id" data-id="{{item._id}}" bindtap="handleActivityTap">
          <view class="activity-main">
            <image lazy-load class="activity-cover" src="{{item.coverUrl}}" mode="aspectFill" binderror="onCloudImageError" data-src="{{item.coverUrl}}" data-path="latestActivities[{{index}}].coverUrl" />
            <view class="activity-overlay">
              <view class="activity-badge {{item.registrationEnded ? 'badge-stopped' : 'badge-active'}}">
                <text class="badge-dot">{{item.registrationEnded ? '' : '●'}}</text>
                <text class="badge-text">{{item.registrationEnded ? '已截止' : '报名中'}}</text>
              </view>
            </view>
            <view class="activity-category-badge" wx:if="{{item.category}}">
              <text class="category-text">{{item.category === 'outdoor' ? '户外' : item.category === 'social' ? '社交' : item.category === 'training' ? '训练' : item.category === 'health' ? '健康' : item.category}}</text>
            </view>
          </view>

          <view class="activity-details">
            <view class="activity-title-row">
              <text class="activity-name truncate">{{item.title}}</text>
              <view class="activity-price {{(item.pricePerPerson > 0 || item.pricePerPet > 0) ? 'price-paid' : 'price-free'}}">
                <block wx:if="{{item.pricePerPerson > 0 && item.pricePerPet > 0}}">¥{{item.pricePerPerson}}/人 ¥{{item.pricePerPet}}/宠</block>
                <block wx:elif="{{item.pricePerPerson > 0}}">¥{{item.pricePerPerson}}/人</block>
                <block wx:elif="{{item.pricePerPet > 0}}">¥{{item.pricePerPet}}/宠</block>
                <block wx:else>免费</block>
              </view>
            </view>

            <view class="activity-time-row">
              <view class="info-item time-item">
                <image class="info-icon-img" src="{{iconTimeLine}}" mode="aspectFit" binderror="onCloudImageError" data-src="{{iconTimeLine}}" data-path="iconTimeLine" />
                <text class="info-text">{{item.timeText}}</text>
              </view>
              <view class="info-item participants-item">
                <text class="info-icon">👥</text>
                <text class="info-text participants-text">{{item.currentParticipants > 0 ? item.currentParticipants : 0}}/{{item.maxParticipants || '不限'}}</text>
              </view>
            </view>

            <view class="activity-info-row">
              <view class="info-item">
                <image class="info-icon-img" src="{{iconMapPin}}" mode="aspectFit" binderror="onCloudImageError" data-src="{{iconMapPin}}" data-path="iconMapPin" />
                <text class="info-text">{{item.location || '待定'}}</text>
              </view>
            </view>
          </view>

          <view class="activity-action">
            <view class="action-btn {{item.isRegistered ? 'btn-registered' : item.registrationEnded ? 'btn-disabled' : 'btn-active'}}">
              <text class="btn-text">{{item.isRegistered ? '已报名' : item.registrationEnded ? '报名已截止' : '立即报名'}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 最近浏览（已登录时显示） -->
    <view wx:if="{{isLoggedIn && recentViews.length > 0}}" class="section-card card">
      <view class="card-header">
        <text class="card-title">👀 最近浏览</text>
      </view>
      <view class="recent-list">
        <view class="recent-card" wx:for="{{recentViews}}" wx:key="_id" data-id="{{item._id}}" data-type="{{item.type}}" bindtap="handleRecentViewTap">
          <image lazy-load class="recent-cover" src="" mode="aspectFill" />
          <view class="recent-info">
            <text class="recent-name truncate">{{item.name}}</text>
            <text class="recent-price">
              <block wx:if="{{item.pricePerPerson > 0 && item.pricePerPet > 0}}">¥{{item.pricePerPerson}}/人 ¥{{item.pricePerPet}}/宠</block>
              <block wx:elif="{{item.pricePerPerson > 0}}">¥{{item.pricePerPerson}}/人起</block>
              <block wx:elif="{{item.pricePerPet > 0}}">¥{{item.pricePerPet}}/宠起</block>
              <block wx:else>免费</block>
            </text>
          </view>
        </view>
      </view>
    </view>

    <view class="bottom-spacer"></view>
  </view>
</view>
