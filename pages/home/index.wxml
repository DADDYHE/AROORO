<view class="home-container">
  <login-prompt visible="{{showLoginPrompt}}" bind:close="onLoginPromptClose" />

  <!-- ===== 顶部状态栏（参考图：时间/天气/通知） ===== -->
  <view class="top-bar">
    <view class="top-bar-left">
      <text class="top-greeting">{{isLoggedIn ? 'Hi, ' + (userInfo.nickName || '铲屎官') : '发现萌宠'}}</text>
      <text class="top-date">{{todayDate}}</text>
    </view>
    <view class="top-bar-right">
      <text class="top-weather">☀ {{weatherTemp}}°C</text>
      <view class="top-bell" bindtap="handleLogin">
        <text class="bell-icon">🔔</text>
        <view wx:if="{{unreadCount > 0}}" class="bell-dot"></view>
      </view>
    </view>
  </view>

  <!-- ===== 快捷操作卡片（参考图：3 个圆角白卡 + 图标圆，一个深色选中） ===== -->
  <view class="quick-grid">
    <view class="quick-card quick-active" data-action="boarding" bindtap="handleBannerTap">
      <view class="quick-icon-wrap">
        <text class="quick-icon-text">寄</text>
      </view>
      <text class="quick-label">寄养</text>
      <text class="quick-desc">安心托管</text>
    </view>
    <view class="quick-card" data-action="activity" bindtap="handleBannerTap">
      <view class="quick-icon-wrap">
        <text class="quick-icon-text">活</text>
      </view>
      <text class="quick-label">活动</text>
      <text class="quick-desc">社区聚会</text>
    </view>
    <view class="quick-card" data-action="mall" bindtap="handleBannerTap">
      <view class="quick-icon-wrap">
        <text class="quick-icon-text">商</text>
      </view>
      <text class="quick-label">商城</text>
      <text class="quick-desc">精选好物</text>
    </view>
  </view>

  <!-- ===== 分页指示点（参考图风格） ===== -->
  <view class="page-dots">
    <view class="page-dot page-dot-active"></view>
    <view class="page-dot"></view>
    <view class="page-dot"></view>
  </view>

  <!-- ===== 板块区块（参考图：Connected Devices 样式） ===== -->

  <!-- 我的宠物 -->
  <view class="section-block" wx:if="{{isLoggedIn}}">
    <view class="section-head">
      <view class="section-title-row">
        <text class="section-title">我的宠物</text>
        <view class="section-badge">{{displayPets.length}}</view>
      </view>
      <text class="section-more" bindtap="handleViewAllPets">查看全部 ›</text>
    </view>

    <!-- 分类芯片条（参考图：Living Room / Kitchen / Bedroom 药丸） -->
    <scroll-view class="chip-strip" scroll-x="true" enhanced="true" show-scrollbar="false">
      <view class="chip chip-active"><text class="chip-icon">🐕</text><text>全部</text></view>
      <view class="chip"><text class="chip-icon">🐶</text><text>狗狗</text></view>
      <view class="chip"><text class="chip-icon">🐱</text><text>猫咪</text></view>
      <view class="chip"><text class="chip-icon">🐰</text><text>其他</text></view>
    </scroll-view>

    <!-- 卡片网格（参考图：大深色主卡 + 小白卡） -->
    <view class="card-grid">
      <!-- 主卡片：深色大卡（参考图 Apple Air Conditioner 同款） -->
      <view class="card-main" wx:if="{{displayPets.length > 0}}" data-id="{{displayPets[0]._id}}" bindtap="handlePetTap">
        <view class="card-main-header">
          <image wx:if="{{displayPets[0].avatarUrl}}" class="card-main-avatar" src="{{displayPets[0].avatarUrl}}" mode="aspectFill" />
          <view wx:else class="card-main-avatar-ph">{{displayPets[0].name.charAt(0)}}</view>
          <view class="card-main-info">
            <text class="card-main-name">{{displayPets[0].name}}</text>
            <text class="card-main-breed">{{displayPets[0].breed}} · {{displayPets[0].birthday || ''}}</text>
          </view>
          <view class="card-main-tag">寄养中</view>
        </view>
        <view class="card-main-body">
          <text class="card-main-big-num">{{displayPets[0].age || '2'}}</text>
          <text class="card-main-unit">岁</text>
        </view>
        <view class="card-main-footer">
          <view class="card-main-stat"><text class="stat-icon">❤</text></view>
          <view class="card-main-stat"><text class="stat-icon">🍖</text></view>
          <view class="card-main-stat"><text class="stat-icon">💉</text></view>
          <view class="card-main-stat"><text class="stat-icon">✂</text></view>
          <view class="card-main-stat"><text class="stat-icon">🏠</text></view>
        </view>
      </view>

      <!-- 侧边小白卡（参考图 PHILO Bed Lamp 同款） -->
      <view class="card-side" wx:if="{{displayPets.length > 1}}" data-id="{{displayPets[1]._id}}" bindtap="handlePetTap">
        <view class="card-side-icon-wrap">
          <image wx:if="{{displayPets[1].avatarUrl}}" class="card-side-avatar" src="{{displayPets[1].avatarUrl}}" mode="aspectFill" />
          <view wx:else class="card-side-avatar-ph">{{displayPets[1].name.charAt(0)}}</view>
        </view>
        <view class="card-side-info">
          <text class="card-side-name">{{displayPets[1].name}}</text>
          <text class="card-side-breed">{{displayPets[1].breed}}</text>
        </view>
        <view class="card-side-tag">健康</view>
      </view>
    </view>

    <!-- 更多小卡（第三行，参考图 LUNO/Sony 同款） -->
    <view class="card-grid card-grid-sm" wx:if="{{displayPets.length > 2}}">
      <view class="card-mini" wx:for="{{displayPets}}" wx:key="_id" wx:if="{{index >= 2}}" data-id="{{item._id}}" bindtap="handlePetTap">
        <view class="card-mini-icon"></view>
        <text class="card-mini-name">{{item.name}}</text>
        <text class="card-mini-breed">{{item.breed}}</text>
        <view class="card-mini-tag">正常</view>
      </view>
    </view>
  </view>

  <!-- 未登录提示卡 -->
  <view class="section-block" wx:if="{{!isLoggedIn}}">
    <view class="section-head">
      <text class="section-title">开始使用</text>
    </view>
    <view class="login-card" bindtap="handleLogin">
      <text class="login-card-title">登录后管理你的萌宠</text>
      <text class="login-card-sub">记录成长 · 预约服务 · 社区互动</text>
      <view class="login-card-btn">立即登录</view>
    </view>
  </view>

  <!-- 宠团团区块 -->
  <view class="section-block" wx:if="{{tuanDeals.length}}">
    <view class="section-head">
      <view class="section-title-row">
        <text class="section-title">{{t.GROUP_DEALS}}</text>
        <view class="section-badge">{{tuanDeals.length}}</view>
      </view>
      <text class="section-more" bindtap="handleViewAllTuan">查看全部 ›</text>
    </view>
    <scroll-view class="deal-strip" scroll-x="true" enhanced="true" show-scrollbar="false">
      <view class="deal-card" wx:for="{{tuanDeals}}" wx:key="_id" data-id="{{item._id}}" bindtap="handleTuanTap">
        <image wx:if="{{item.coverUrl}}" class="deal-cover" src="{{item.coverUrl}}" mode="aspectFill" />
        <view wx:else class="deal-cover-ph"></view>
        <view class="deal-info">
          <text class="deal-name truncate">{{item.title}}</text>
          <view class="deal-meta">
            <text class="deal-price">¥{{item.minPrice}}</text>
            <text class="deal-orders" wx:if="{{item.totalOrders > 0}}">{{item.totalOrders}}人团</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 最新活动 -->
  <view class="section-block" wx:if="{{latestActivities.length}}">
    <view class="section-head">
      <view class="section-title-row">
        <text class="section-title">{{t.LATEST_ACTIVITIES}}</text>
        <view class="section-badge">{{latestActivities.length}}</view>
      </view>
      <text class="section-more" bindtap="handleViewAllActivities">查看全部 ›</text>
    </view>
    <view class="act-list">
      <activity-card wx:for="{{latestActivities}}" wx:key="_id" item="{{item}}" locale="{{locale}}" bind:tap="handleActivityTap" />
    </view>
  </view>

  <view class="bottom-spacer"></view>
</view>
