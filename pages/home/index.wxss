  color: var(--text-primary);
}

/* ================================================================
   Section 4.8: 寄养开单入口（深绿展品卡 · 仅已开通家庭寄养用户可见）
   ================================================================ */
.host-invite-card {
  position: relative;
  overflow: hidden;
  padding: 36rpx 36rpx 32rpx;
  background-image: var(--lux-green-grad-rich);
  background-size: 100% 100%;
  background-repeat: no-repeat;
  border-radius: var(--lux-radius-card);
  border: 1rpx solid var(--lux-hairline-green);
  display: flex;
  align-items: center;
  gap: 24rpx;
  transition: transform 240ms cubic-bezier(0.25, 0.1, 0.25, 1),
              opacity 240ms cubic-bezier(0.25, 0.1, 0.25, 1);
}

.host-invite-card--pressed {
  transform: scale(0.99);
  opacity: 0.92;
}

/* 右上角金色光晕 */
.host-invite-glow {
  position: absolute;
  top: -60rpx;
  right: -60rpx;
  width: 240rpx;
  height: 240rpx;
  background-image: radial-gradient(circle, rgba(201, 162, 75, 0.20) 0%, rgba(201, 162, 75, 0) 70%);
  pointer-events: none;
}

.host-invite-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  position: relative;
}

.host-invite-eyebrow {
  font-size: 20rpx;
  color: var(--lux-gold-500);
  letter-spacing: 0.24em;
  font-weight: 400;
}

.host-invite-title {
  font-size: 36rpx;
  color: var(--text-on-primary);
  font-weight: 500;
  letter-spacing: 0.08em;
  line-height: 1.3;
}

.host-invite-desc {
  font-size: 22rpx;
  color: rgba(247, 245, 239, 0.72);
  letter-spacing: 0.04em;
  line-height: 1.6;
}

.host-invite-arrow {
  font-size: 40rpx;
  color: var(--lux-gold-500);
  line-height: 1;
  flex-shrink: 0;
  position: relative;
}

/* 封口金线 */
.host-invite-sealline {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 1rpx;
  background-image: var(--lux-gold-line);
  background-size: 100% 100%;
  background-repeat: no-repeat;
}

/* ================================================================
   B 版式覆盖层 · 时装屋开场（2026-09-12，DADDY 已通过）
   ----------------------------------------------------------------
   来源：preview/home-option-shot.html?v=E3 定稿
     hero-e3（封面「落款封印」）+ c-gallery（画册式：留白文字、无底无框无圆角）
     + t-big（serif 大标题 / 英文小标 / 金墨短规则线）+ i-med（刻印章牌图标）
     + p-gold（纸面金墨价）+ g-B（板块间距 88rpx = 88rpx）
   换算：mock 的 px 1:1 对应 375pt 屏，故 ×2 = rpx
     （校验：mock .sec padding 48rpx == 项目 --page-padding 48rpx）
   做法：不删旧规则，统一在本层以同选择器覆盖（同权重下后声明胜出）。
     理由：旧层 ~1480 行互相耦合，按「起止标记」切块删会连带吞掉夹在中间的非
     目标样式（service-detail 已踩过）。本层可整段回滚，回滚即还原 Plain Sheet。
   色板：纸面 / 墨（--text-primary） / 金墨（--lux-gold-ink）
     深绿封面 165deg：鼠尾草 5A7C63 → 深森林（--lux-green-800）55% → 近黑绿 0F2410
   铁律：浅底行线一律 1rpx rgba(26,26,23,0.14)；品牌金 1F3A1F/C9A24B 绝不上纸面做文字/填充
   Skyline：禁 float（t-big 的 sec-link 在 mock 用 float:right，这里改用
     flex-wrap + 100% 换行等效实现）；禁外阴影（B 版式无阴影语义）
   ================================================================ */

/* ---------- 1. 封面：深绿沉浸 + 品牌落款（E3 落款封印） ---------- */
/* 800rpx = 800rpx，与 B 原封面同高：首屏高度不变、不牵动 refresher 阈值 */
.lux-cover {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 800rpx;
  box-sizing: border-box;
  padding: 88rpx 0 76rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  background-image: linear-gradient(165deg, #5A7C63 0%, var(--lux-green-800) 55%, #0F2410 100%);
  background-size: 100% 100%;
  background-repeat: no-repeat;
}

.lux-cover-top {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.lux-cover-wm {
  font-family: var(--font-serif);
  font-size: 84rpx;                /* 84rpx */
  font-weight: 400;
  line-height: 1.1;
  letter-spacing: 0.34em;
  text-indent: 0.34em;             /* 必须 = letter-spacing，否则末字右侧多留、视觉不居中 */
  color: #F7F5EF;
}

.lux-cover-tg {
  margin-top: 32rpx;               /* 32rpx */
  font-size: 24rpx;                /* 24rpx */
  letter-spacing: 0.34em;
  text-indent: 0.34em;
  color: rgba(247, 245, 239, 0.65);
}

/* 落款印章：细金双环（外环 .42 / 内环 inset 22rpx .14），内嵌 176rpx 组合标。
   2026-09-12：印章整体上移 64rpx（margin-bottom 64rpx）；外环抽成独立 .lux-cover-ring 以承载呼吸动画。 */
.lux-cover-seal {
  position: relative;
  width: 352rpx;                   /* 352rpx */
  height: 352rpx;
  margin-bottom: 64rpx;            /* 上移 64rpx：印章底距封面底 76rpx → 140rpx，与文字组间距 126rpx → 62rpx */
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 外环：唯一承载呼吸的层。只动 transform/opacity（GPU 友好）；
   环用 inset box-shadow 画（深色底上禁外阴影，Skyline 也不支持） */
.lux-cover-ring {
  position: absolute;
  top: 0; right: 0; bottom: 0; left: 0;
  border-radius: 50%;
  box-shadow: inset 0 0 0 2rpx rgba(201, 162, 75, 0.42);
  transform-origin: 50% 50%;       /* Skyline：动 scale 必须显式给 origin */
  animation: lux-seal-breathe 4.8s cubic-bezier(0.45, 0, 0.55, 1) infinite;
}

/* 一个来回 4.8s ≈ 静息呼吸节律：扩到 1.05 并提亮为「吸」，收到 1 并压暗为「呼」 */
@keyframes lux-seal-breathe {
  0%, 100% { transform: scale(1);    opacity: 0.72; }
  50%      { transform: scale(1.05); opacity: 1; }
}

.lux-cover-seal::after {
  content: '';
  position: absolute;
  top: 22rpx; right: 22rpx; bottom: 22rpx; left: 22rpx;
  border-radius: 50%;
  box-shadow: inset 0 0 0 2rpx rgba(201, 162, 75, 0.14);
}

/* 深底必须用 -cream 变体；-ink 墨色版在深绿上不可读 */
.lux-cover-mark { width: 176rpx; height: 176rpx; display: block; }

/* ---------- 2. 当期橱窗：手动横滑（无 autoplay / 无 circular），banner 全宽占满区域 ---------- */
/* banner 全宽 750rpx × 16:9 → 高 422rpx（211px），无页边距无露边，整页切换；
   margin-top 0 —— banner 与封面直接相接；交界 1rpx 金墨装帧线过渡 */
.lux-carousel {
  margin-top: 0;
  position: relative;
  border-top: 2rpx solid rgba(201, 162, 75, 0.9);
}
.lux-car-swiper { width: 100%; }

.lux-car-card {
  height: 422rpx;
  overflow: hidden;
  background-color: var(--skeleton-base);
}
.lux-car-card--pressed { opacity: 0.92; }
.lux-car-img { width: 100%; height: 100%; display: block; }

.lux-car-cap {
  margin-top: 32rpx;               /* 32rpx（标题/副题删除后收紧，下板块上移） */
  padding: 0 var(--page-padding);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
.lux-car-num {
  flex-shrink: 0;
  font-size: 22rpx;                /* 22rpx */
  letter-spacing: 0.18em;
  color: rgba(26, 26, 23, 0.42);
}

/* 分页指示器：金墨细线段（44×2rpx）与页码同行（左线段 / 右页码，杂志页脚式） */
.lux-car-dots {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.lux-car-dot {
  width: 44rpx;                    /* 44rpx */
  height: 2rpx;
  margin-right: 16rpx;             /* 16rpx */
  background-color: rgba(26, 26, 23, 0.18);
}
.lux-car-dot.on { width: 88rpx; background-color: var(--lux-gold-ink); }

/* 手动滑动提示（书签式竖签）：流动金线 + 竖排「滑动」，首次横滑后隐去（slideHintTouched）。
   只动 transform/opacity（Skyline 安全）；金 #C9A24B 在深色签底使用（合规） */
.lux-car-hint {
  position: absolute;
  /* 全宽图右缘书签：垂直居中于图（图高 422rpx 的一半） */
  top: 211rpx;
  right: 36rpx;
  transform: translateY(-50%);
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 9rpx;
  border-radius: 999rpx;
  background: rgba(15, 36, 16, 0.55);
  border: 1rpx solid rgba(201, 162, 75, 0.5);
}
.lux-car-hint .hint-line {
  width: 2rpx;
  height: 44rpx;
  background: linear-gradient(180deg, rgba(201, 162, 75, 0.95) 0%, rgba(201, 162, 75, 0.15) 100%);
  animation: lux-hint-flow 2.4s cubic-bezier(0.45, 0, 0.55, 1) infinite;
}
.lux-car-hint .hint-word {
  font-family: var(--font-serif);
  font-size: 17rpx;
  color: rgba(247, 245, 239, 0.92);
  line-height: 1.3;
}
@keyframes lux-hint-flow {
  0%, 100% { transform: translateY(-8rpx); opacity: 0.55; }
  50% { transform: translateY(8rpx); opacity: 1; }
}

/* ---------- 3. 内容 sheet → 纸面流（撤掉暖石缎面与 100vh 垫高） ---------- */
.home-container { min-height: 0; }
.home-content-sheet {
  min-height: 0;
  background-color: transparent;
  background-image: none;
}

/* ---------- 4. 板块标题：serif 大字 + 英文小标 + 金墨短规则线（t-big） ---------- */
/* mock 用 display:block + sec-link float:right，Skyline 禁 float →
   改用 flex-wrap，靠 .section-en 的 0 0 100% 强制换行，视觉等价 */
.section-head,
.my-pets-header {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 40rpx;            /* 40rpx */
}

.section-title {
  font-family: var(--font-serif);
  font-size: 50rpx;                /* 50rpx */
  font-weight: 400;
  letter-spacing: 0.16em;
  line-height: 1.25;
  color: var(--text-primary);
}

.section-link { font-size: 24rpx; font-weight: 400; color: rgba(26, 26, 23, 0.45); }
.pet-view-all { font-size: 24rpx; color: rgba(26, 26, 23, 0.45); }

.section-en {
  flex: 0 0 100%;
  margin-top: 16rpx;               /* 16rpx */
  font-size: 20rpx;                /* 20rpx */
  letter-spacing: 0.32em;
  color: var(--lux-gold-ink);
}

.section-rule {
  flex: 0 0 auto;                  /* 前一项占满整行 → 本项自然落到第三行 */
  width: 68rpx;                    /* 68rpx */
  height: 2rpx;
  margin-top: 24rpx;               /* 24rpx */
  background-color: var(--lux-gold-ink);
}

/* 「+ 添加」去纸药丸装帧，收成金墨文字（与标题同在首行） */
.pet-add-btn {
  padding: 0;
  margin-left: 24rpx;
  border: 0;
  background: transparent;
  gap: 4rpx;
}
.pet-add-btn--pressed { transform: none; opacity: 0.6; background: transparent; }
.pet-add-icon,
.pet-add-text { font-size: 24rpx; color: var(--lux-gold-ink); }

/* ---------- 5. 我的宠物：c-gallery · 单列堆叠去纸卡 ---------- */
.pets-grid { display: block; }
.pet-card,
.pet-card-empty {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex: none;
  width: 100%;
  max-width: 100%;                 /* 抵消基础规则 .pet-card 的 calc(50% - 24rpx)（旧两列网格）。
                                      勿写 max-width: none —— Skyline 不认 none、会整条丢弃，
                                      于是 50% 上限留着、卡片变半宽且无任何报错。 */
  margin: 0;
  padding: 0 0 48rpx;              /* 48rpx */
  background: transparent;
  background-image: none;
  border: 0;
  border-radius: 0;
  box-shadow: none;                /* 去掉性别色条（属纸卡装帧；性别符号仍在名字旁） */
  overflow: visible;
}
.pet-card:nth-child(2),
.pets-grid .pet-card + .pet-card { margin-left: 0; }
.pet-card-empty {
  justify-content: center;
  min-height: 168rpx;
  padding: 40rpx 0;
  border: 1rpx dashed rgba(26, 26, 23, 0.14);
}
.pet-card-empty--pressed { border-color: rgba(122, 95, 42, 0.45); background: transparent; }
.pet-name { font-family: var(--font-serif); font-size: 30rpx; font-weight: 400; letter-spacing: 0.06em; }

/* ---------- 6. 快捷服务：c-gallery · 两列横排 + i-med 刻印章牌图标 ---------- */
.quick-services { flex-direction: row; gap: 32rpx; }   /* mock .qs gap 32rpx */
.qs-item {
  flex: 1;
  width: auto;
  padding: 0 0 52rpx;              /* 52rpx */
  background: transparent;
  background-image: none;
  border: 0;
  border-radius: 0;
  overflow: visible;
}
.qs-item--pressed { transform: scale(0.97); }
/* 刻印章牌：116rpx 双环，图标 60rpx */
.qs-icon {
  width: 116rpx;                   /* 116rpx */
  height: 116rpx;
  border-radius: 50%;
  margin-bottom: 32rpx;            /* 32rpx */
  background: transparent;
  background-image: none;
  box-shadow: inset 0 0 0 2rpx rgba(26, 26, 23, 0.22);
}
.qs-icon::after {
  content: '';
  position: absolute;
  top: 8rpx; right: 8rpx; bottom: 8rpx; left: 8rpx;   /* inset 8rpx */
  border-radius: 50%;
  box-shadow: inset 0 0 0 2rpx rgba(26, 26, 23, 0.08);
}
.qs-icon-activity,
.qs-icon-mall { background: transparent; background-image: none; }
.qs-emoji-img { width: 60rpx; height: 60rpx; }         /* mock svg 60rpx */
.qs-accent { display: none; }                          /* 旧纸卡的左侧强调条，属装帧层 */
.qs-title {
  font-family: var(--font-serif);
  font-size: 32rpx;                /* 32rpx */
  font-weight: 400;
  letter-spacing: 0.07em;
  color: var(--text-primary);
  margin-bottom: 0;
}
.qs-subtitle { margin-top: 12rpx; font-size: 24rpx; color: rgba(26, 26, 23, 0.45); }

/* ---------- 7. 待处理订单：行式去卡（mock 无此板块，按 c-gallery 语言自定） ---------- */
.pending-list { gap: 0; }
.pending-card {
  background: transparent;
  background-image: none;
  border: 0;
  border-bottom: 1rpx solid rgba(26, 26, 23, 0.14);
  border-radius: 0;
  padding: 32rpx 0;
}
.pending-list .pending-card:first-child { border-top: 1rpx solid rgba(26, 26, 23, 0.14); }
.pending-card--pressed { transform: none; opacity: 0.6; }
.pending-title { font-family: var(--font-serif); font-size: 30rpx; font-weight: 400; letter-spacing: 0.06em; }
.pending-symbol { color: var(--lux-gold-ink); }
.pending-price { font-family: var(--font-serif); font-size: 36rpx; font-weight: 400; color: var(--lux-gold-ink); }
.pending-status { color: var(--lux-gold-ink); border-color: rgba(201, 162, 75, 0.45); }

/* ---------- 8. 寄养开单：保持深绿展品卡（本就在 B 语言内，不改） ---------- */
/* .host-invite-card 用 --lux-green-grad-rich + 深色描边，属深绿沉浸语言，原样保留 */

/* ---------- 9. 好物：c-gallery（400rpx 图）+ p-gold（纸面图注，金墨价） ---------- */
.featured-scroll { height: 600rpx; }
.featured-list { height: 100%; align-items: flex-start; }
.mall-card {
  flex-direction: column;
  width: 400rpx;                   /* 400rpx */
  height: auto;
  margin-right: 32rpx;             /* gap 32rpx */
  border: 0;
  border-radius: 0;
  background: transparent;
  background-image: none;
  overflow: visible;
}
.mall-card-img-share { width: 100%; height: 432rpx; overflow: hidden; }
.mall-card-img { width: 100%; height: 432rpx; display: block; }   /* 432rpx */
.mall-card-img-ph { background-color: var(--skeleton-base); }
/* 全图卡的白字遮罩层整体退场（p-gold 语义：价签落到纸面） */
.mall-card-overlay,
.mall-card-guard,
.mall-card .aurora-lume-line { display: none; }
.mall-card-info { position: relative; padding: 24rpx 4rpx 0; }      /* .mall-bar padding 24rpx 4rpx 0 */
/* ↑ 必须写 relative，不能写 static：基础规则（L568）是 position: absolute + bottom/left/right: 0，
   Skyline 不支持 static、会把声明整条丢弃 → 退回 absolute，价签卡片文字又叠回图片上
   （而 .mall-card-overlay 守护层已在 L1838 关掉）→ 深色字压照片、不可读。
   relative 让元素回到正常流；基础规则的 left/right/bottom 全为 0，作相对偏移时位移也是 0，观感与 static 等效。 */
.mall-card-name {
  font-family: var(--font-sans);
  font-size: 28rpx;                /* 28rpx */
  font-weight: 400;
  letter-spacing: 0;
  color: var(--text-primary);
}
.mall-card-price-row { flex-wrap: wrap; margin-top: 10rpx; }      /* 10rpx */
.mall-card-price {
  font-family: var(--font-serif);
  font-size: 36rpx;                /* 36rpx */
  font-weight: 400;
  letter-spacing: 0;
  color: var(--lux-gold-ink);
}
.mall-card-original { font-size: 22rpx; color: rgba(26, 26, 23, 0.4); margin-left: 14rpx; }
/* 「已售 n」独占一行（mock .mall-bs margin-top 10rpx），不再靠 margin-left:auto 吊在价尾 */
.mall-card-sold { flex: 0 0 100%; margin-left: 0; margin-top: 10rpx; font-size: 22rpx; color: rgba(26, 26, 23, 0.4); }

/* ---------- 10. 快速签到 / 近期活动：c-gallery · 单列全幅图 + 纸面图注 ---------- */
.my-act-list,
.activity-list { gap: 0; }
.my-act-card,
.activity-h-card {
  flex-direction: column;
  align-items: stretch;
  padding: 0 0 68rpx;              /* 68rpx */
  background: transparent;
  background-image: none;
  border: 0;
  border-radius: 0;
  overflow: visible;
}
.my-act-card--pressed,
.activity-h-card--pressed { transform: none; opacity: 0.72; }
.my-act-img,
.activity-h-img { width: 100%; height: 380rpx; }                 /* 380rpx */
.my-act-img-ph,
.activity-h-img-ph { background-color: var(--skeleton-base); }
.my-act-img-ph-text,
.activity-h-img-ph-text { color: rgba(26, 26, 23, 0.45); }
.my-act-body,
.activity-h-body { padding: 32rpx 0 0; gap: 0; }                 /* 32rpx */
.my-act-name,
.activity-h-name {
  font-family: var(--font-serif);
  font-size: 32rpx;                /* 32rpx */
  font-weight: 400;
  letter-spacing: 0.06em;
  line-height: 1.4;
  white-space: normal;
}
.my-act-info,
.activity-h-info { font-size: 24rpx; color: rgba(26, 26, 23, 0.55); line-height: 1.5; }
.my-act-meta,
.activity-h-meta { margin-top: 16rpx; }
.my-act-loc-text,
.activity-h-loc-text,
.activity-h-people-text { font-size: 22rpx; color: rgba(26, 26, 23, 0.45); }
/* 签到按钮：深绿 pill（mock .act-sign align-self:center → 居中） */
.my-act-action { padding: 20rpx 0 0; justify-content: center; }
.my-act-signin {
  padding: 20rpx 36rpx;
  border-radius: var(--lux-radius-pill);
  background: var(--lux-green-grad);
  box-shadow: none;                /* B 版式无阴影 */
}
.my-act-signin-text { font-size: 24rpx; font-weight: 400; letter-spacing: 0.12em; color: var(--lux-gold-500); }
.my-act-card .aurora-gold-rule,
.activity-h-card .aurora-gold-rule {
  width: 56rpx;                    /* 56rpx */
  height: 2rpx;
  margin: 20rpx 0;                 /* 20rpx */
  background: var(--lux-gold-ink);
  border-radius: 0;
}

/* ---------- 11. 纸卡装帧层退场（极光描边 / 角弧 / 晕 / 提亮线都是卡片的「装帧」） ---------- */
.aurora-edge,
.aurora-corner,
