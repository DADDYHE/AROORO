/* 首页样式 - Smart Home Dashboard 风格（参考图 1:1 还原，2026-07-26） */
/* 视觉 token 由 ../../styles/theme-warm.wxss 覆写提供（仅本页生效） */

@import '../../styles/theme-warm.wxss';

.home-container {
  min-height: 100vh;
  background: var(--background-color);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  padding: 0 28rpx;
  box-sizing: border-box;
}

/* ===== 顶部状态栏（参考图：时间/天气/通知） ===== */
.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 28rpx 4rpx 20rpx;
}

.top-bar-left {
  display: flex;
  flex-direction: column;
}

.top-greeting {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.top-date {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
}

.top-bar-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.top-weather {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.top-bell {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--card-color);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-md);
  position: relative;
}

.bell-icon { font-size: 28rpx; }

.bell-dot {
  position: absolute;
  top: 10rpx;
  right: 12rpx;
  width: 14rpx;
  height: 14rpx;
  background: #E74C3C;
  border-radius: 50%;
  border: 2rpx solid #FFFFFF;
}

/* ===== 快捷操作卡片（参考图：3 个圆角白卡 + 图标圆） ===== */
.quick-grid {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.quick-card {
  flex: 1;
  background: var(--card-color);
  border-radius: var(--border-radius-xl);
  padding: 28rpx 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: var(--shadow-md);
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}

.quick-card:active {
  transform: scale(0.96);
}

/* 选中态：深色填充（参考图 Movie Night 同款） */
.quick-active {
  background: var(--primary-color);
  box-shadow: var(--shadow-glow-primary);
}

.quick-active .quick-label,
.quick-active .quick-desc { color: #FFFFFF; }

.quick-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--surface-tint);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.quick-active .quick-icon-wrap {
  background: rgba(255, 255, 255, 0.18);
}

.quick-icon-text {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--primary-color);
}

.quick-active .quick-icon-text { color: #FFFFFF; }

.quick-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.quick-desc {
  font-size: 20rpx;
  color: var(--text-tertiary);
}

/* ===== 分页指示点 ===== */
.page-dots {
  display: flex;
  justify-content: center;
  gap: 10rpx;
  margin-top: 28rpx;
}

.page-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #D0DAE4;
}

.page-dot-active {
  width: 32rpx;
  border-radius: 6rpx;
  background: var(--primary-color);
}

/* ===== 通用区块 ===== */
.section-block {
  margin-top: 40rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.section-badge {
  background: #E74C3C;
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 600;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  line-height: 1.6;
}

.section-more {
  font-size: 24rpx;
  color: var(--primary-color);
  font-weight: 500;
}

/* ===== 分类芯片条（参考图：Living Room / Kitchen 药丸） ===== */
.chip-strip {
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: var(--card-color);
  border: 0.5rpx solid var(--border-color);
  margin-right: 16rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  box-shadow: var(--shadow-sm);
}

.chip-icon { font-size: 22rpx; }

.chip-active {
  background: var(--primary-light);
  border-color: var(--primary-color);
  color: var(--primary-color);
  font-weight: 500;
}

/* ===== 卡片网格（参考图：大深色主卡 + 小白卡布局） ===== */
.card-grid {
  display: flex;
  gap: 20rpx;
}

.card-grid-sm {
  margin-top: 20rpx;
}

/* ---- 主卡片：深色大卡（参考图 Apple Air Conditioner 同款） ---- */
.card-main {
  flex: 55%;
  min-height: 320rpx;
  background: var(--primary-color);
  border-radius: var(--border-radius-2xl);
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-shadow: var(--shadow-glow-primary-lg);
  position: relative;
  overflow: hidden;
}

.card-main::before {
  content: '';
  position: absolute;
  top: -40rpx;
  right: -30rpx;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
}

.card-main-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  position: relative;
  z-index: 1;
}

.card-main-avatar,
.card-main-avatar-ph {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #FFF;
  font-weight: 600;
}

.card-main-info {
  flex: 1;
}

.card-main-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  display: block;
}

.card-main-breed {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  display: block;
  margin-top: 2rpx;
}

.card-main-tag {
  background: rgba(255, 255, 255, 0.18);
  color: #FFFFFF;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-weight: 500;
}

.card-main-body {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.card-main-big-num {
  font-size: 72rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1;
}

.card-main-unit {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

.card-main-footer {
  display: flex;
  gap: 20rpx;
  position: relative;
  z-index: 1;
}

.card-main-stat {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
}

.stat-icon { font-size: 22rpx; }

/* ---- 侧边小白卡（参考图 PHILO Bed Lamp 同款） ---- */
.card-side {
  flex: 45%;
  min-height: 320rpx;
  background: var(--card-color);
  border-radius: var(--border-radius-2xl);
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  box-shadow: var(--shadow-md);
  border: 0.5rpx solid var(--border-color);
}

.card-side-icon-wrap {
  margin-bottom: auto;
}

.card-side-avatar,
.card-side-avatar-ph {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--surface-tint);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--primary-color);
  font-weight: 600;
}

.card-side-info { margin-top: 16rpx; }

.card-side-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
}

.card-side-breed {
  font-size: 22rpx;
  color: var(--text-tertiary);
  display: block;
  margin-top: 4rpx;
}

.card-side-tag {
  display: inline-flex;
  align-self: flex-start;
  margin-top: 16rpx;
  background: var(--primary-light);
  color: var(--primary-color);
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-weight: 500;
}

/* ---- 迷你卡（参考图 LUNO / Sony 同款） ---- */
.card-mini {
  flex: 1;
  min-height: 140rpx;
  background: var(--card-color);
  border-radius: var(--border-radius-xl);
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  box-shadow: var(--shadow-md);
  border: 0.5rpx solid var(--border-color);
}

.card-mini-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--surface-tint);
  margin-bottom: 12rpx;
}

.card-mini-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.card-mini-breed {
  font-size: 20rpx;
  color: var(--text-tertiary);
  margin-top: 2rpx;
}

.card-mini-tag {
  display: inline-flex;
  align-self: flex-start;
  margin-top: auto;
  padding-top: 8rpx;
  font-size: 20rpx;
  color: var(--text-tertiary);
}

/* ===== 未登录提示卡 ===== */
.login-card {
  background: var(--card-color);
  border-radius: var(--border-radius-2xl);
  padding: 36rpx;
  box-shadow: var(--shadow-md);
  border: 0.5rpx solid var(--border-color);
}

.login-card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
}

.login-card-sub {
  font-size: 24rpx;
  color: var(--text-secondary);
  display: block;
  margin-top: 8rpx;
}

.login-card-btn {
  display: inline-flex;
  margin-top: 24rpx;
  background: var(--primary-color);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 500;
  padding: 18rpx 40rpx;
  border-radius: 999rpx;
  align-self: flex-start;
}

/* ===== 团购横滑卡 ===== */
.deal-strip {
  white-space: nowrap;
}

.deal-card {
  display: inline-flex;
  flex-direction: column;
  width: 280rpx;
  margin-right: 20rpx;
  vertical-align: top;
  background: var(--card-color);
  border-radius: var(--border-radius-xl);
  overflow: hidden;
  box-shadow: var(--shadow-md);
  border: 0.5rpx solid var(--border-color);
}

.deal-cover,
.deal-cover-ph {
  width: 280rpx;
  height: 180rpx;
  background: var(--surface-tint);
}

.deal-info {
  padding: 16rpx 20rpx 20rpx;
}

.deal-name {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-primary);
  display: block;
}

.deal-meta {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 8rpx;
}

.deal-price {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--tuan-primary);
}

.deal-orders {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

/* ===== 活动列表 ===== */
.act-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 通用省略 */
.truncate {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bottom-spacer {
  height: 200rpx;
}
