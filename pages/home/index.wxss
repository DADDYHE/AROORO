/* ================================================================
   pages/home/index.wxss · AROORO 首页 · Haute-Luxury v2
   ----------------------------------------------------------------
   设计方向：Editorial Luxury（杂志式奢侈品首页）
     · Hero 全出血大图，极简文案
     · 奶油白内容卡片 sheet 优雅上掀
     · 服务入口：极简线条 + 宽字距标签
     · 商品卡：全图 + 底部渐变信息
     · 活动卡：左图右文，发丝描边
     · 我的宠物：圆形头像 + 极简排版
   Skyline 兼容：仅 transform/opacity 动画，GPU 加速
   ================================================================ */

/* ===== 基础容器 ===== */
.home-container {
  min-height: 100vh;
  background: transparent;
  font-family: var(--font-sans);
  padding: 0 0 240rpx;
  margin-top: 0;
  box-sizing: border-box;
}

.home-scroll {
  position: relative;
  z-index: 2;
  background: transparent;
}

page {
  margin: 0;
  padding: 0;
  background-color: var(--background-color);
}

/* ===== 下拉刷新指示器（极简） ===== */
.refresh-indicator {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100rpx;
  gap: 12rpx;
}

.refresh-spinner {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.refresh-arrow {
  width: 16rpx;
  height: 16rpx;
  border-right: 2rpx solid var(--primary-color);
  border-bottom: 2rpx solid var(--primary-color);
  transform: rotate(45deg);
  transition-property: transform;
  transition-duration: 400ms;
  transition-timing-function: cubic-bezier(0.34, 1.15, 0.64, 1);
}

.refresh-arrow.refresh-arrow-pulling {
  transform: rotate(225deg);
}

.refresh-text {
  font-size: 20rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.12em;
  transition-property: opacity;
  transition-duration: 280ms;
  transition-timing-function: cubic-bezier(0.25, 0.1, 0.25, 1);
}

/* ===== Section 1: 顶部栏（高奢极简） ===== */
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 96rpx;
  padding: 0 var(--page-padding);
  background: transparent;
  position: relative;
  z-index: 30;
}

.topbar-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-width: 0;
  flex: 1;
  transition-property: transform;
  transition-duration: 180ms;
  transition-timing-function: cubic-bezier(0.25, 0.1, 0.25, 1);
}

.topbar-left--pressed {
  transform: scale(0.98);
}

.topbar-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  border: 1rpx solid var(--hairline);
  transition-property: transform;
  transition-duration: 280ms;
  transition-timing-function: cubic-bezier(0.34, 1.15, 0.64, 1);
}

.topbar-avatar--pressed {
  transform: scale(0.9);
}

.topbar-avatar-ph {
  background: var(--gradient-primary);
  display: flex;
  align-items: center;
  justify-content: center;
}

.topbar-avatar-text {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-on-primary);
  letter-spacing: 0.02em;
}

.topbar-greeting {
  display: flex;
  flex-direction: column;
  min-width: 0;
  gap: 4rpx;
}

.topbar-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  letter-spacing: 0.02em;
}

.topbar-loc {
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.2;
  letter-spacing: 0.08em;
}

.topbar-search {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  margin-left: 16rpx;
  border-radius: 50%;
  background: var(--gray-100);
  border: 1rpx solid var(--border-color);
  flex-shrink: 0;
  transition-property: transform;
  transition-duration: 180ms;
  transition-timing-function: cubic-bezier(0.25, 0.1, 0.25, 1);
}

.topbar-search--pressed {
  transform: scale(0.9);
  background: var(--gray-200);
}

.topbar-search-icon {
  width: 28rpx;
  height: 28rpx;
  border: 2rpx solid var(--text-secondary);
  border-radius: 50%;
  position: relative;
  flex-shrink: 0;
}

.topbar-search-icon::after {
  content: '';
  position: absolute;
  right: -6rpx;
  bottom: -6rpx;
  width: 12rpx;
  height: 2rpx;
  background: var(--text-secondary);
  border-radius: 1rpx;
  transform: rotate(45deg);
}

.topbar-search-text {
  display: none;
}

/* ===== Section 2: 英雄区（全出血大图 + 极简文案） ===== */
.hero-section {
  padding: 0;
  margin-top: 0;
  position: relative;
  z-index: 1;
  width: 100%;
}

.hero-swiper {
  width: 100%;
}

.hero-card {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.hero-img {
  width: 100%;
  height: 100%;
  display: block;
}

.hero-img-ph {
  background: linear-gradient(180deg, #3D6B3D 0%, #1F3A1F 100%);
}

.hero-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(to top, rgba(15, 36, 16, 0.75) 0%, rgba(15, 36, 16, 0.2) 45%, transparent 70%);
}

.hero-text {
  position: absolute;
  bottom: 0;
  left: 0;
  padding: 0 var(--page-padding) 96rpx;
}

/* 向下滚动提示：极简圆点脉动 */
.scroll-hint {
  position: absolute;
  bottom: 48rpx;
  right: var(--page-padding);
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  animation-name: scroll-hint-appear;
  animation-duration: 900ms;
  animation-timing-function: cubic-bezier(0.19, 1, 0.22, 1);
  animation-delay: 1500ms;
  animation-fill-mode: forwards;
}

.scroll-hint-line {
  width: 6rpx;
  height: 6rpx;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 50%;
  animation-name: scroll-dot-breathe;
  animation-duration: 2400ms;
  animation-timing-function: linear;
  animation-fill-mode: forwards;
  animation-iteration-count: infinite;
}

@keyframes scroll-hint-appear {
  from { opacity: 0; transform: translateY(12rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes scroll-dot-breathe {
  0%, 100% { transform: scale(1); opacity: 0.5; }
  50% { transform: scale(1.8); opacity: 0.9; }
}

.hero-title {
  font-size: 64rpx;
  font-weight: 300;
  color: #FFFFFF;
  letter-spacing: 0.02em;
  display: block;
  line-height: 1.15;
}

.hero-sub {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 16rpx;
  display: block;
  line-height: 1.6;
  letter-spacing: 0.08em;
  font-weight: 300;
}

/* ===== 内容 sheet：奶油白卡片优雅上掀 ===== */
.home-content-sheet {
  position: relative;
  z-index: 2;
  background: var(--background-color);
  border-radius: 0;
  padding-top: 0;
  margin-top: -48rpx;
}

/* ===== Section 3: 登录入口（奢侈品 CTA） ===== */
.search-section {
  padding: var(--zy-space-xl) var(--page-padding) var(--zy-space-lg);
}

.home-login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  background: var(--card-color);
  color: var(--text-primary);
  font-size: 26rpx;
  font-weight: 400;
  letter-spacing: 0.12em;
  padding: 32rpx;
  border-radius: var(--zy-radius-lg);
  border: 1rpx solid var(--hairline);
  position: relative;
  overflow: hidden;
  transition-property: transform;
  transition-duration: 180ms;
  transition-timing-function: cubic-bezier(0.25, 0.1, 0.25, 1);
}

.home-login-btn--pressed {
  transform: scale(0.98);
  border-color: var(--primary-soft);
}

.home-login-text {
  font-size: 26rpx;
  color: inherit;
  position: relative;
  z-index: 1;
}

/* ===== Section 4: 快捷服务入口（极简网格） ===== */
.quick-services-wrapper {
  margin-top: 0;
  overflow: hidden;
  padding: 0 var(--page-padding);
}

.quick-services {
  display: flex;
  gap: var(--zy-space-lg);
  background: transparent;
  padding: 0;
}

.qs-item {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  flex: 1;
  box-sizing: border-box;
  padding: 36rpx 32rpx;
  background: var(--card-color);
  border-radius: var(--lux-radius-card);
  border: 1rpx solid var(--hairline);
  position: relative;
  overflow: hidden;
  transition-property: transform;
  transition-duration: 280ms;
  transition-timing-function: cubic-bezier(0.34, 1.15, 0.64, 1);
}

.qs-item--pressed {
  transform: scale(0.97);
  border-color: var(--primary-color);
}

.qs-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--zy-radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  position: relative;
  transition-property: transform;
  transition-duration: 280ms;
  transition-timing-function: cubic-bezier(0.34, 1.15, 0.64, 1);
}

.qs-item--pressed .qs-icon {
  transform: scale(0.92);
}

.qs-icon-activity {
  background: var(--activity-tint);
}

.qs-icon-mall {
  background: var(--mall-tint);
}

.qs-emoji {
  font-size: 40rpx;
  line-height: 1;
  position: relative;
  z-index: 1;
}

.qs-emoji-img {
  width: 44rpx;
  height: 44rpx;
  position: relative;
  z-index: 1;
}

.qs-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  line-height: 1.3;
  margin-bottom: 8rpx;
  letter-spacing: 0.02em;
}

.qs-subtitle {
  font-size: 22rpx;
  color: var(--text-tertiary);
  line-height: 1.4;
  letter-spacing: 0.04em;
  font-weight: 300;
}

.qs-accent {
  position: absolute;
  top: 0;
  left: 0;
  width: 4rpx;
  height: 100%;
  border-radius: 0 2rpx 2rpx 0;
  transform: scaleY(0);
  transform-origin: top;
  transition-property: transform;
  transition-duration: 500ms;
  transition-timing-function: cubic-bezier(0.19, 1, 0.22, 1);
}

.qs-item--pressed .qs-accent {
  transform: scaleY(1);
}

.qs-accent-activity { background: var(--activity-primary); }
.qs-accent-mall { background: var(--mall-primary); }

/* ===== 通用区块（艺术留白） ===== */
.section {
  margin-top: var(--section-gap);
  padding: 0 var(--page-padding);
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: var(--zy-space-xl);
}

.section-title {
  font-size: 36rpx;
  font-weight: 400;
  color: var(--text-primary);
  line-height: 1.2;
  letter-spacing: 0.02em;
}

.section-link {
  font-size: 22rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.08em;
  transition-property: transform;
  transition-duration: 180ms;
  transition-timing-function: cubic-bezier(0.25, 0.1, 0.25, 1);
  padding: 8rpx 0;
  font-weight: 400;
}

.section-link--pressed {
  color: #1F3A1F;
  transform: translateX(4rpx);
}

/* ===== Section 5: 团购/商城好物（全图卡，杂志式横滑） ===== */
.section-featured {
  padding-right: 0;
}

.featured-scroll {
  height: 400rpx;
  white-space: nowrap;
}

.featured-list {
  display: flex;
  flex-direction: row;
  height: 100%;
  padding-right: var(--page-padding);
}

.featured-card {
  display: flex;
  flex-direction: column;
  width: 300rpx;
  background: var(--card-color);
  border-radius: var(--lux-radius-card);
  overflow: hidden;
  border: 1rpx solid var(--hairline);
  flex-shrink: 0;
  margin-right: var(--zy-space-lg);
  transition-property: transform;
  transition-duration: 280ms;
  transition-timing-function: cubic-bezier(0.34, 1.15, 0.64, 1);
}

.featured-card--pressed {
  transform: scale(0.97);
  border-color: var(--primary-soft);
}

.featured-img {
  width: 300rpx;
  height: 280rpx;
  display: block;
}

.featured-img-ph {
  background: var(--primary-wash);
  display: flex;
  align-items: center;
  justify-content: center;
}

.featured-img-ph-text {
  font-size: 40rpx;
  color: var(--text-tertiary);
  font-weight: 300;
}

.featured-body {
  padding: 20rpx 24rpx 24rpx;
}

.featured-name {
  font-size: 26rpx;
  color: var(--text-primary);
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
  font-weight: 400;
}

.featured-price-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-top: 8rpx;
}

.featured-price {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  line-height: 1.2;
}

.featured-price-orig {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

/* ===== 商城好物：全图 + 底部渐变信息 ===== */
.mall-card {
  display: flex;
  width: 300rpx;
  height: 400rpx;
  position: relative;
  border-radius: var(--lux-radius-card);
  overflow: hidden;
  flex-shrink: 0;
  margin-right: var(--zy-space-lg);
  border: 1rpx solid var(--hairline);
  transition-property: transform;
  transition-duration: 280ms;
  transition-timing-function: cubic-bezier(0.34, 1.15, 0.64, 1);
}

.mall-card--pressed {
  transform: scale(0.97);
}

.mall-card-img {
  width: 100%;
  height: 100%;
  display: block;
  transition-property: transform;
  transition-duration: 700ms;
  transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
}

.mall-card--pressed .mall-card-img {
  transform: scale(1.04);
}

.mall-card-img-share {
  width: 100%;
  height: 100%;
  display: block;
}

.mall-card-img-ph {
  background: var(--primary-wash);
  display: flex;
  align-items: center;
  justify-content: center;
}

.mall-card-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 55%;
  background: linear-gradient(to top, rgba(15, 36, 16, 0.85) 0%, rgba(15, 36, 16, 0.5) 40%, transparent 100%);
  pointer-events: none;
}

.mall-card-info {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx;
}

.mall-card-name {
  font-size: 26rpx;
  font-weight: 400;
  color: #FFFFFF;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
  letter-spacing: 0.02em;
}

.mall-card-price-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-top: 8rpx;
}

.mall-card-price {
  font-size: 28rpx;
  font-weight: 500;
  color: #FFFFFF;
  line-height: 1.2;
}

.mall-card-original {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.45);
  text-decoration: line-through;
}

.mall-card-sold {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-left: auto;
  letter-spacing: 0.04em;
}

/* ===== Section 6: 近期活动（杂志式横卡） ===== */
.activity-list {
  display: flex;
  flex-direction: column;
  gap: var(--zy-space-lg);
}

.activity-h-card {
  display: flex;
  background: var(--card-color);
  border-radius: var(--lux-radius-card);
  overflow: hidden;
  border: 1rpx solid var(--hairline);
  transition-property: transform;
  transition-duration: 280ms;
  transition-timing-function: cubic-bezier(0.34, 1.15, 0.64, 1);
}

.activity-h-card--pressed {
  transform: scale(0.99);
  border-color: var(--primary-soft);
}

.activity-h-img {
  width: 240rpx;
  height: 240rpx;
  flex-shrink: 0;
  transition-property: transform;
  transition-duration: 700ms;
  transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
}

.activity-h-card--pressed .activity-h-img {
  transform: scale(1.04);
}

.activity-h-img-share {
  width: 240rpx;
  height: 240rpx;
  flex-shrink: 0;
  overflow: hidden;
}

.activity-h-img-ph {
  background: var(--primary-wash);
  display: flex;
  align-items: center;
  justify-content: center;
}

.activity-h-img-ph-text {
  font-size: 28rpx;
  color: var(--text-tertiary);
  font-weight: 300;
}

.activity-h-body {
  flex: 1;
  padding: 32rpx 28rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
  min-width: 0;
}

.activity-h-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  letter-spacing: 0.01em;
}

.activity-h-info {
  font-size: 22rpx;
  color: var(--text-tertiary);
  line-height: 1.5;
  letter-spacing: 0.04em;
  font-weight: 300;
}

.activity-h-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 4rpx;
}

.activity-h-loc {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 20rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.04em;
}

.activity-h-loc-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.activity-h-loc-text {
  font-size: inherit;
  color: inherit;
}

.activity-h-people {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 20rpx;
  color: #1F3A1F;
  letter-spacing: 0.04em;
}

.activity-h-people-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.activity-h-people-text {
  font-size: inherit;
  color: inherit;
}

/* ===== 未登录提示卡（极简） ===== */
.login-card {
  background: var(--card-color);
  border-radius: var(--lux-radius-card);
  padding: 64rpx 40rpx;
  border: 1rpx solid var(--hairline);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  transition-property: transform;
  transition-duration: 280ms;
  transition-timing-function: cubic-bezier(0.34, 1.15, 0.64, 1);
}

.login-card--pressed {
  transform: scale(0.99);
  border-color: var(--primary-soft);
}

.login-title {
  font-size: 36rpx;
  font-weight: 300;
  color: var(--text-primary);
  display: block;
  letter-spacing: 0.02em;
}

.login-sub {
  font-size: 24rpx;
  color: var(--text-tertiary);
  display: block;
  margin-top: 16rpx;
  line-height: 1.7;
  letter-spacing: 0.04em;
  font-weight: 300;
}

.login-btn {
  display: flex;
  margin-top: 40rpx;
  background: var(--gradient-primary);
  color: var(--text-on-primary);
  font-size: 24rpx;
  font-weight: 400;
  padding: 24rpx 56rpx;
  border-radius: var(--zy-radius-pill);
  align-self: flex-start;
  letter-spacing: 0.12em;
  position: relative;
  overflow: hidden;
  box-shadow: var(--shadow-glow-primary-soft);
  transition: transform 180ms cubic-bezier(0.25, 0.1, 0.25, 1),
              opacity 280ms cubic-bezier(0.25, 0.1, 0.25, 1);
}

.login-btn--pressed {
  transform: scale(0.97);
  opacity: 0.9;
}

/* ===== 底部留白（艺术级呼吸） ===== */
.bottom-spacer {
  height: 160rpx;
}

/* ===== Section 2.5: 我的宠物（极简头像行） ===== */
.my-pets-section {
  margin: var(--zy-space-xl) 0 var(--zy-space-lg);
  padding: 40rpx var(--page-padding) 48rpx;
  background: transparent;
  border-radius: 0;
  border-bottom: 1rpx solid var(--hairline);
}

.my-pets-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--zy-space-lg);
  padding: 0;
}

.my-pets-title-wrap {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  white-space: nowrap;
}

.pet-add-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 24rpx;
  margin-left: 24rpx;
  border-radius: var(--zy-radius-pill);
  background: transparent;
  border: 1rpx solid var(--hairline);
  flex-shrink: 0;
  white-space: nowrap;
  transition-property: transform;
  transition-duration: 180ms;
  transition-timing-function: cubic-bezier(0.25, 0.1, 0.25, 1);
}

.pet-add-btn--pressed {
  transform: scale(0.94);
  border-color: var(--primary-color);
  background: var(--primary-wash);
}

.pet-view-all {
  font-size: 22rpx;
  color: var(--text-tertiary);
  line-height: 1;
  letter-spacing: 0.08em;
  transition-property: transform;
  transition-duration: 180ms;
  transition-timing-function: cubic-bezier(0.25, 0.1, 0.25, 1);
  padding: 8rpx 0;
}

.pet-view-all--pressed {
  color: #1F3A1F;
  transform: translateX(4rpx);
}

.pet-add-icon {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1;
}

.pet-add-text {
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1;
  letter-spacing: 0.06em;
}

.pets-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--zy-space-lg);
}

.pet-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex: 1;
  max-width: calc(50% - 24rpx); /* 50% - spacing-lg/2，与 .qs-item flex:1 平分等价 */
  min-width: 0;
  padding: 24rpx;
  background: var(--card-color);
  border-radius: var(--lux-radius-card);
  border: 1rpx solid var(--hairline);
  box-sizing: border-box;
  transition-property: transform;
  transition-duration: 280ms;
  transition-timing-function: cubic-bezier(0.34, 1.15, 0.64, 1);
}

.pet-card--pressed {
  transform: scale(0.97);
  border-color: var(--primary-soft);
}

/* 右侧卡片右移 20rpx，对齐快捷板块视觉宽度 */
.pet-card:nth-child(2) {
  margin-left: 20rpx;
}

.pet-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--primary-wash);
  flex-shrink: 0;
  margin-right: 20rpx;
  box-sizing: border-box;
  transition-property: transform;
  transition-duration: 280ms;
  transition-timing-function: cubic-bezier(0.34, 1.15, 0.64, 1);
  border: 1rpx solid var(--hairline);
}

.pet-card--pressed .pet-avatar {
  transform: scale(0.9);
}

.pet-avatar-male {
  border: 2rpx solid var(--gender-male, #6B9DAE);
}

.pet-avatar-female {
  border: 2rpx solid var(--gender-female, #C0788E);
}

.pet-info {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.pet-name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.pet-gender-tag {
  font-size: 18rpx;
  font-weight: 500;
  line-height: 1;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.pet-gender-male {
  color: var(--gender-male, #6B9DAE);
  background: var(--gender-male-tint, rgba(107, 157, 174, 0.10));
}

.pet-gender-female {
  color: var(--gender-female, #C0788E);
  background: var(--gender-female-tint, rgba(192, 120, 142, 0.10));
}

.pet-gender-unknown {
  display: none;
}

.pet-card-male {
  /* 性别色左侧线：用 inset 内阴影替代 border-left，确保被 40rpx 圆角裁切、随圆角围绕过去；
     规避 Skyline 下"单边加粗 border + 大 radius"拐角不圆、方头戳出圆角的硬边 bug */
  box-shadow: inset 3rpx 0 0 0 var(--gender-male, #6B9DAE);
}

.pet-card-female {
  box-shadow: inset 3rpx 0 0 0 var(--gender-female, #C0788E);
}

.pet-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  line-height: 1.2;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  letter-spacing: 0.01em;
}

.pet-breed {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-top: 6rpx;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  letter-spacing: 0.02em;
  font-weight: 300;
}

.pet-card-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  max-width: calc(50% - 24rpx);
  min-width: 0;
  min-height: 140rpx;
  padding: 24rpx;
  background: var(--card-cream);
  border-radius: var(--lux-radius-card);
  border: 1rpx dashed var(--border-soft);
  box-sizing: border-box;
  transition-property: transform;
  transition-duration: 180ms;
  transition-timing-function: cubic-bezier(0.25, 0.1, 0.25, 1);
}

.pet-card-empty--pressed {
  border-color: var(--primary-color);
  background: var(--primary-wash);
  transform: scale(0.98);
}

.pet-empty-text {
  font-size: 24rpx;
  font-weight: 300;
  color: var(--text-tertiary);
  line-height: 1.4;
  text-align: center;
  letter-spacing: 0.06em;
}

/* ================================================================
   入场动画 · Stagger 丝绸展开（Haute-Luxury 版）
   ----------------------------------------------------------------
   更慢更柔，幅度更小，更克制
   ================================================================ */
@keyframes rise-fade-in {
  0% { opacity: 0; transform: translateY(24rpx); }
  100% { opacity: 1; transform: translateY(0); }
}

@keyframes rise-fade-in-short {
  0% { opacity: 0; transform: translateY(16rpx); }
  100% { opacity: 1; transform: translateY(0); }
}

@keyframes scale-fade-in {
  0% { opacity: 0; transform: scale(0.96); }
  100% { opacity: 1; transform: scale(1); }
}

@keyframes sheet-slide-up {
  0% { opacity: 0; transform: translateY(40rpx); }
  100% { opacity: 1; transform: translateY(0); }
}

.stagger-item {
  opacity: 0;
  animation-fill-mode: forwards;
}

.stagger-rise {
  animation-name: rise-fade-in;
  animation-duration: 700ms;
  animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
}

.stagger-rise-fast {
  animation-name: rise-fade-in-short;
  animation-duration: 500ms;
  animation-timing-function: cubic-bezier(0.19, 1, 0.22, 1);
}

.stagger-scale {
  animation-name: scale-fade-in;
  animation-duration: 600ms;
  animation-timing-function: cubic-bezier(0.34, 1.15, 0.64, 1);
}

.stagger-sheet {
  animation-name: sheet-slide-up;
  animation-duration: 800ms;
  animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  animation-delay: 200ms;
}

.delay-0 { animation-delay: 0ms; }
.delay-1 { animation-delay: 120ms; }
.delay-2 { animation-delay: 240ms; }
.delay-3 { animation-delay: 360ms; }
.delay-4 { animation-delay: 480ms; }
.delay-5 { animation-delay: 600ms; }
.delay-6 { animation-delay: 720ms; }
.delay-7 { animation-delay: 840ms; }
.delay-8 { animation-delay: 960ms; }

/* Hero 文字入场：字间距收紧 */
.hero-title-stagger {
  opacity: 0;
  animation-name: hero-title-fade;
  animation-duration: 900ms;
  animation-timing-function: cubic-bezier(0.19, 1, 0.22, 1);
  animation-delay: 500ms;
  animation-fill-mode: forwards;
}

.hero-sub-stagger {
  opacity: 0;
  animation-name: hero-sub-fade;
  animation-duration: 800ms;
  animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  animation-delay: 700ms;
  animation-fill-mode: forwards;
}

@keyframes hero-title-fade {
  0% { opacity: 0; }
  100% { opacity: 1; }
}

@keyframes hero-sub-fade {
  0% { opacity: 0; transform: translateY(8rpx); }
  100% { opacity: 0.7; transform: translateY(0); }
}

/* 顶部栏淡入 */
@keyframes topbar-fade {
  0% { opacity: 0; transform: translateY(-12rpx); }
  100% { opacity: 1; transform: translateY(0); }
}

.topbar-stagger {
  opacity: 0;
  animation-name: topbar-fade;
  animation-duration: 700ms;
  animation-timing-function: cubic-bezier(0.19, 1, 0.22, 1);
  animation-delay: 100ms;
  animation-fill-mode: forwards;
}
