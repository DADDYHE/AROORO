/* 首页样式 - 艺术画廊展陈风格 */

/* ====== 页面容器 ====== */
.home-container {
  background-color: #F5F5F7;
  min-height: 100vh;
}

/* ====== 轮播 Banner - 画廊封面 ====== */
.home-banner {
  width: 100%;
  overflow: hidden;
  position: relative;
  z-index: 1;
  animation: fadeUp 0.6s ease-out;
}

@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(24rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.banner-item {
  position: relative;
  width: 100%;
  display: flex;
  align-items: center;
}

.banner-image {
  width: 100%;
  display: block;
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
}

.banner-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(
    135deg,
    rgba(0, 0, 0, 0.35) 0%,
    rgba(0, 0, 0, 0.2) 40%,
    rgba(0, 0, 0, 0.08) 70%,
    transparent 100%
  );
  z-index: 1;
  pointer-events: none;
}

.banner-content {
  position: absolute;
  z-index: 2;
  left: 40rpx;
  right: 40rpx;
  bottom: 36rpx;
  display: flex;
  flex-direction: column;
  animation: bannerContentFadeIn 0.8s ease-out;
}

@keyframes bannerContentFadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 0.85;
    transform: translateY(0);
  }
}

.banner-tag {
  display: inline-flex;
  align-items: center;
  width: fit-content;
  padding: 6rpx 16rpx;
  margin-bottom: 12rpx;
  background: linear-gradient(135deg, rgba(78, 205, 196, 0.75) 0%, rgba(69, 183, 170, 0.75) 100%);
  border-radius: 4rpx;
  font-size: 18rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.9);
  letter-spacing: 2rpx;
  text-transform: uppercase;
  box-shadow: 0 2rpx 8rpx rgba(78, 205, 196, 0.2);
  animation: tagSlideIn 0.6s ease-out 0.2s both;
}

@keyframes tagSlideIn {
  from {
    opacity: 0;
    transform: translateX(-20rpx);
  }
  to {
    opacity: 0.85;
    transform: translateX(0);
  }
}

.banner-title {
  font-size: 44rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 10rpx;
  line-height: 1.15;
  letter-spacing: 1rpx;
  text-shadow: 0 3rpx 12rpx rgba(0, 0, 0, 0.3);
  animation: titleReveal 0.8s ease-out 0.3s both;
}

@keyframes titleReveal {
  from {
    opacity: 0;
    transform: translateY(25rpx);
    filter: blur(6rpx);
  }
  to {
    opacity: 0.85;
    transform: translateY(0);
    filter: blur(0);
  }
}

.banner-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
  font-weight: 400;
  line-height: 1.5;
  letter-spacing: 0.5rpx;
  margin-bottom: 20rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.25);
  animation: subtitleFadeIn 0.8s ease-out 0.45s both;
}

@keyframes subtitleFadeIn {
  from {
    opacity: 0;
    transform: translateY(15rpx);
  }
  to {
    opacity: 0.85;
    transform: translateY(0);
  }
}

.banner-cta {
  display: inline-flex;
  align-items: center;
  width: fit-content;
  padding: 14rpx 28rpx;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(8rpx);
  border: 1.5rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 50rpx;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  animation: ctaSlideIn 0.8s ease-out 0.6s both;
}

@keyframes ctaSlideIn {
  from {
    opacity: 0;
    transform: translateX(-20rpx);
  }
  to {
    opacity: 0.85;
    transform: translateX(0);
  }
}

.banner-item:active .banner-cta {
  background: rgba(255, 255, 255, 0.18);
  transform: scale(0.96);
}

.banner-cta-text {
  font-size: 22rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.9);
  letter-spacing: 1.5rpx;
}

.banner-cta-arrow {
  margin-left: 10rpx;
  font-size: 22rpx;
  color: rgba(78, 205, 196, 0.85);
  transition: transform 0.3s ease;
}

.banner-item:active .banner-cta-arrow {
  transform: translateX(8rpx);
}

.banner-decoration {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
  pointer-events: none;
  overflow: hidden;
}

.deco-line {
  position: absolute;
  background: linear-gradient(90deg, transparent, rgba(78, 205, 196, 0.35), transparent);
  height: 1.5rpx;
  animation: decoLineMove 8s linear infinite;
}

.deco-line-1 {
  top: 25%;
  left: -100%;
  width: 50%;
  animation-delay: 0s;
}

.deco-line-2 {
  top: 45%;
  left: -100%;
  width: 35%;
  animation-delay: 4s;
}

@keyframes decoLineMove {
  0% {
    transform: translateX(0);
    opacity: 0;
  }
  10% {
    opacity: 1;
  }
  90% {
    opacity: 1;
  }
  100% {
    transform: translateX(calc(100vw + 100%));
    opacity: 0;
  }
}

.deco-circle {
  position: absolute;
  right: 8%;
  top: 30%;
  width: 200rpx;
  height: 200rpx;
  border: 1.5rpx solid rgba(78, 205, 196, 0.15);
  border-radius: 50%;
  animation: decoCirclePulse 4s ease-in-out infinite;
}

@keyframes decoCirclePulse {
  0%, 100% {
    transform: scale(1);
    opacity: 0.25;
  }
  50% {
    transform: scale(1.08);
    opacity: 0.45;
  }
}

/* ====== 页面内容区 ====== */
.page-content {
  padding: 0 32rpx 48rpx;
  max-width: 1000rpx;
  margin: 0 auto;
}

/* ====== 登录提示卡片 - 画廊展品样式 ====== */
.login-prompt-card {
  margin: 0 0 32rpx;
  padding: 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(134, 134, 139, 0.1);
  position: relative;
  overflow: hidden;
  animation: fadeUp 0.5s ease-out 0.1s both;
}

.login-prompt-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: linear-gradient(90deg, #4ECDC4 0%, #2AB7A9 50%, transparent 100%);
  border-radius: 24rpx 24rpx 0 0;
}

.login-prompt-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  position: relative;
  z-index: 2;
  width: 100%;
}

.login-prompt-visual {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
}

.paw-icon-container {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4ECDC4 0%, #45B7AA 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(78, 205, 196, 0.3);
  position: relative;
  z-index: 2;
}

.default-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(255,255,255,0.4) 0%, rgba(255,255,255,0.1) 100%);
}

.login-prompt-gradient {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(78, 205, 196, 0.2) 0%, rgba(78, 205, 196, 0) 70%);
  z-index: 1;
}

.login-prompt-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  text-align: center;
  width: 100%;
}

.login-prompt-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1D1D1F;
  text-align: center;
  line-height: 1.2;
}

.login-prompt-subtitle {
  font-size: 22rpx;
  color: #8E8E93;
  text-align: center;
  line-height: 1.4;
}

.login-prompt-action {
  margin-top: 16rpx;
  width: 100%;
  max-width: 400rpx;
}

.login-prompt-btn {
  display: block;
  width: 100%;
  padding: 16rpx 0;
  background: linear-gradient(135deg, #4ECDC4 0%, #45B7AA 100%);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 48rpx;
  box-shadow: 0 6rpx 16rpx rgba(78, 205, 196, 0.3);
  text-align: center;
  position: relative;
  overflow: hidden;
  border: none;
}

.login-prompt-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
  transition: left 0.6s ease;
}

.login-prompt-btn:active {
  transform: scale(0.96);
}

/* ====== 我的宠物 - 画廊展品区 ====== */
.section-card {
  margin: 0 0 32rpx;
  animation: fadeUp 0.5s ease-out 0.2s both;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 0 4rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D1D1F;
}

.card-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.add-pet-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 4rpx 16rpx 4rpx 10rpx;
  border-radius: 24rpx;
  background: rgba(78, 205, 196, 0.1);
  transition: all 0.3s ease;
}

.add-pet-btn:active {
  background: rgba(78, 205, 196, 0.2);
  transform: scale(0.95);
}

.add-pet-icon {
  font-size: 26rpx;
  color: #4ECDC4;
  font-weight: 500;
  line-height: 1;
}

.add-pet-text {
  font-size: 22rpx;
  color: #4ECDC4;
  font-weight: 500;
}

.view-more-container {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 16rpx;
  border-radius: 24rpx;
  background: rgba(78, 205, 196, 0.08);
  transition: all 0.3s ease;
}

.view-more-container:active {
  background: rgba(78, 205, 196, 0.15);
}

.view-more {
  font-size: 22rpx;
  color: #4ECDC4;
  font-weight: 500;
}

.view-more-arrow {
  font-size: 28rpx;
  color: #4ECDC4;
  font-weight: 300;
}

.pets-scroll {
  display: flex;
  gap: 16rpx;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
}

.pets-scroll::-webkit-scrollbar {
  display: none;
}

.pet-card {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  padding: 20rpx;
  border-radius: 20rpx;
  transition: all 0.3s ease;
}

.pet-card:active {
  transform: scale(0.98);
}

.pet-card-male {
  background: linear-gradient(135deg, #FFFFFF 0%, #F0F7FF 100%);
  border: 1rpx solid rgba(59, 130, 246, 0.12);
}

.pet-card-female {
  background: linear-gradient(135deg, #FFFFFF 0%, #FFF0F5 100%);
  border: 1rpx solid rgba(236, 72, 153, 0.12);
}

.pet-card-unknown {
  background: linear-gradient(135deg, #FFFFFF 0%, #FAFAFA 100%);
  border: 1rpx solid rgba(134, 134, 139, 0.1);
}

.pet-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  border: 2rpx solid rgba(78, 205, 196, 0.2);
}

.pet-avatar-placeholder {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background: linear-gradient(135deg, #4ecdc4 0%, #44a08d 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  color: white;
  text-transform: uppercase;
}

.pet-info {
  display: flex;
  flex-direction: column;
}

.pet-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D1D1F;
  margin-bottom: 4rpx;
}

.pet-breed {
  font-size: 22rpx;
  color: #8E8E93;
  margin-bottom: 2rpx;
}

.pet-age {
  font-size: 22rpx;
  color: #AEAEB2;
}

.empty-pets {
  padding: 48rpx;
  text-align: center;
  background: linear-gradient(135deg, #FFFFFF 0%, #FAFAFA 100%);
  border-radius: 20rpx;
  border: 2rpx dashed rgba(134, 134, 139, 0.2);
}

.empty-text {
  font-size: 24rpx;
  color: #AEAEB2;
}

/* ====== 功能入口 - 画廊展品网格 ====== */
.feature-card {
  margin: 0 0 32rpx;
  padding: 32rpx 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(134, 134, 139, 0.1);
  position: relative;
  overflow: hidden;
  animation: fadeUp 0.5s ease-out 0.3s both;
}

.feature-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: linear-gradient(90deg, #4ECDC4 0%, #2AB7A9 50%, transparent 100%);
  border-radius: 24rpx 24rpx 0 0;
}

.feature-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
  position: relative;
  z-index: 2;
}

.feature-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 16rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #FFFFFF 0%, #FAFAFA 100%);
  border: 1rpx solid rgba(134, 134, 139, 0.08);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.feature-item:active {
  transform: scale(0.96);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.coming-soon-item {
  cursor: default;
}

.coming-soon-item:active {
  transform: none;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.coming-soon-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(78, 205, 196, 0.15) 0%, rgba(255, 159, 67, 0.2) 50%, rgba(156, 39, 176, 0.1) 100%);
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  z-index: 10;
  overflow: hidden;
  animation: maskPulse 3s ease-in-out infinite;
}

@keyframes maskPulse {
  0%, 100% { opacity: 0.6; }
  50% { opacity: 1; }
}

.coming-soon-dots {
  display: flex;
  gap: 8rpx;
  position: relative;
  z-index: 2;
}

.coming-soon-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: rgba(44, 44, 44, 0.6);
  animation: dotPulse 1.5s ease-in-out infinite;
}

.coming-soon-dot:nth-child(1) { animation-delay: 0s; }
.coming-soon-dot:nth-child(2) { animation-delay: 0.2s; }
.coming-soon-dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes dotPulse {
  0%, 100% { opacity: 0.3; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1.2); }
}

.coming-soon-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #2c2c2c;
  letter-spacing: 6rpx;
  position: relative;
  z-index: 3;
  text-shadow: 0 1rpx 3rpx rgba(255, 255, 255, 0.5);
}

/* 功能图标颜色 */
.feature-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  pointer-events: none;
}

.feature-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  position: relative;
  overflow: hidden;
}

.feature-icon-image {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
}

/* 功能图标颜色 */
.feature-icon-boarding {
  background: linear-gradient(135deg, rgba(78, 205, 196, 0.15) 0%, rgba(69, 183, 170, 0.08) 100%);
}

.coming-soon-item .feature-icon-feeding,
.coming-soon-item .feature-icon-boarding {
  background: rgba(158, 158, 158, 0.1);
}

.coming-soon-item .feature-icon-image {
  filter: grayscale(1) brightness(0.8) opacity(0.35);
}

.coming-soon-item .feature-text {
  color: #a0a0a0;
}

.coming-soon-item .feature-desc {
  color: #c0c0c0;
}

.coming-soon-item .feature-accent {
  background: #c0c0c0;
}

.feature-icon-feeding {
  background: linear-gradient(135deg, rgba(255, 159, 67, 0.15) 0%, rgba(255, 138, 101, 0.08) 100%);
}

.feature-icon-activity {
  background: linear-gradient(135deg, rgba(156, 39, 176, 0.12) 0%, rgba(171, 71, 188, 0.06) 100%);
}

.feature-icon-mall {
  background: linear-gradient(135deg, rgba(255, 107, 107, 0.12) 0%, rgba(240, 98, 146, 0.06) 100%);
}

.feature-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #1D1D1F;
  margin-bottom: 4rpx;
  text-align: center;
}

.feature-desc {
  font-size: 20rpx;
  color: #AEAEB2;
  text-align: center;
  margin-bottom: 8rpx;
}

.feature-accent {
  width: 32rpx;
  height: 2rpx;
  background: linear-gradient(90deg, #4ECDC4 0%, #45B7AA 100%);
  border-radius: 1rpx;
  opacity: 0.5;
}

/* ====== 宠团团 - 画廊展区 ====== */
.tuan-section {
  margin: 32rpx 0 0;
  animation: fadeUp 0.5s ease-out 0.35s both;
}

.tuan-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.tuan-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(134, 134, 139, 0.1);
  transition: all 0.3s ease;
}

.tuan-card:active {
  transform: scale(0.97);
}

.tuan-cover-wrap {
  position: relative;
  width: 100%;
  height: 200rpx;
}

.tuan-cover {
  width: 100%;
  height: 100%;
  object-fit: cover;
  background: linear-gradient(135deg, #FFF3E0 0%, #FFE0B2 50%, #FFCC80 100%);
}

.tuan-badge {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  padding: 4rpx 16rpx;
  border-radius: 24rpx;
  background: rgba(255, 107, 107, 0.9);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}

.tuan-badge-text {
  font-size: 18rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: 1rpx;
}

.tuan-info {
  padding: 16rpx 20rpx 20rpx;
}

.tuan-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1D1D1F;
  line-height: 1.3;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 8rpx;
}

.tuan-meta {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.tuan-price {
  font-size: 30rpx;
  font-weight: 700;
  color: #FF6B6B;
}

.tuan-orders {
  font-size: 20rpx;
  color: #AEAEB2;
}

/* ====== 最新活动 - 画廊展区 ====== */
.activities-section {
  margin: 32rpx 0 0;
  animation: fadeUp 0.5s ease-out 0.4s both;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 0 4rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D1D1F;
}

.view-more {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 22rpx;
  color: #8E8E93;
}

.view-more-arrow {
  font-size: 28rpx;
  font-weight: 300;
}

.activity-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.activity-block {
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(134, 134, 139, 0.1);
  transition: all 0.3s ease;
  position: relative;
}

.activity-block:active {
  transform: scale(0.99);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.activity-main {
  position: relative;
  width: 100%;
  height: 280rpx;
}

.activity-cover {
  width: 100%;
  height: 100%;
  object-fit: cover;
  background: linear-gradient(135deg, #E8F5E9 0%, #C8E6C9 50%, #A5D6A7 100%);
}

.activity-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(0,0,0,0) 50%, rgba(0,0,0,0.4) 100%);
  padding: 24rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.activity-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: 32rpx;
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}

.activity-badge.badge-active {
  background: rgba(78, 205, 196, 0.9);
}

.activity-badge.badge-stopped {
  background: rgba(255, 107, 107, 0.9);
}

.badge-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #fff;
  flex-shrink: 0;
}

.badge-text {
  font-size: 20rpx;
  font-weight: 500;
  color: #fff;
}

.activity-category-badge {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.category-text {
  font-size: 20rpx;
  font-weight: 500;
  color: #1D1D1F;
}

.activity-details {
  padding: 24rpx;
}

.activity-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.activity-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1D1D1F;
  flex: 1;
  line-height: 1.2;
}

.activity-price {
  font-size: 32rpx;
  font-weight: 700;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.activity-price.price-paid {
  color: #4ECDC4;
}

.activity-price.price-free {
  color: #FF6B6B;
}

.activity-time-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 8rpx;
  gap: 16rpx;
}

.activity-time-row .info-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.info-icon-img {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.info-text {
  font-size: 22rpx;
  color: #8E8E93;
  line-height: 1.4;
}

.participants-text {
  font-weight: 500;
  color: #4ECDC4;
  white-space: nowrap;
}

.activity-info-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.activity-info-row .info-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.activity-action {
  padding: 0 24rpx 24rpx;
}

.action-btn {
  padding: 16rpx 32rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  transition: all 0.3s ease;
}

.action-btn:active {
  transform: scale(0.98);
}

.action-btn.btn-active {
  background: linear-gradient(135deg, #4ECDC4 0%, #3DB5AD 100%);
  box-shadow: 0 4rpx 12rpx rgba(78, 205, 196, 0.3);
}

.action-btn.btn-active .btn-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #fff;
}

.action-btn.btn-disabled {
  background: linear-gradient(135deg, #F5F5F7 0%, #FAFAFA 100%);
  border: 1rpx solid rgba(134, 134, 139, 0.12);
}

.action-btn.btn-disabled .btn-text {
  font-size: 24rpx;
  font-weight: 500;
  color: #AEAEB2;
}

.action-btn.btn-registered {
  background: linear-gradient(135deg, #FFFFFF 0%, #F8FFFE 100%);
  border: 2rpx solid rgba(78, 205, 196, 0.3);
}

.action-btn.btn-registered .btn-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #4ECDC4;
}

/* ====== 最近浏览 ====== */
.recent-list {
  display: flex;
  gap: 24rpx;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
}

.recent-list::-webkit-scrollbar {
  display: none;
}

.recent-card {
  min-width: 320rpx;
  transition: all 0.3s ease;
}

.recent-card:active {
  transform: scale(0.96);
}

.recent-cover {
  width: 320rpx;
  height: 200rpx;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
  background: linear-gradient(135deg, #E8F5E9 0%, #C8E6C9 100%);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.recent-info {
  display: flex;
  flex-direction: column;
}

.recent-name {
  font-size: 24rpx;
  font-weight: 500;
  color: #1D1D1F;
  margin-bottom: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 320rpx;
}

.recent-price {
  font-size: 22rpx;
  color: #4ECDC4;
  font-weight: 600;
}

/* ====== 底部间距 ====== */
.bottom-spacer {
  height: 200rpx;
}
