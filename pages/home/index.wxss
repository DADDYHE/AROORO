/* ================================================================
   pages/home/index.wxss · AROORO 首页 · Plain Sheet
   设计系统：styles/theme-teal.wxss（teal 调色板，无新色相）
   ----------------------------------------------------------------
   设计方向：零装帧极简
     · Banner 16:9 纯图，无 scrim / 无文案 / 无描金
     · 下方一整片暖石缎面渐变（--sheet-grad，与 page 同源），与 banner 硬边相接、零透叠
     · 卡片：暖石渐变（--card-satin→--sheet-paper）+ 单条 --hairline-glass 边
     · 排版：中性无衬线、常规字重、零字距处理
   Skyline 兼容：禁用 backdrop-filter / text-shadow / mask-image /
                 :active / position:sticky / text-transform / 负 z-index
                 仅 transform/opacity 动画，GPU 加速
   ================================================================ */

/* ===== 基础容器 ===== */
.home-container {
  --sheet-grad: var(--zy-paper-noise), linear-gradient(180deg, var(--card-satin) 0%, var(--sheet-paper) 50%, var(--background-warm) 100%);
  min-height: 100vh;
  background: transparent;
  font-family: var(--font-sans);
  padding: 0; /* Plain Sheet：整片背景统一暖石缎面渐变（sheet 用 --sheet-grad，与 page 同源），零装帧 */
  margin-top: 0;
  box-sizing: border-box;
}

.home-scroll {
  position: relative;
  z-index: 2;
  background: transparent;
}

page {
  margin: 0;
  padding: 0;
}

/* ===== 下拉刷新指示器（极简） ===== */
.refresh-indicator {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100rpx;
  gap: 12rpx;
}

.refresh-spinner {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.refresh-arrow {
  width: 16rpx;
  height: 16rpx;
  border-right: 2rpx solid var(--primary-color);
  border-bottom: 2rpx solid var(--primary-color);
  transform: rotate(45deg);
  transition-property: transform;
  transition-duration: 400ms;
  transition-timing-function: cubic-bezier(0.34, 1.15, 0.64, 1);
}

.refresh-arrow.refresh-arrow-pulling {
  transform: rotate(225deg);
}

.refresh-text {
  font-size: 20rpx;
  color: var(--text-on-glass-2);
  transition-property: opacity;
  transition-duration: 280ms;
  transition-timing-function: cubic-bezier(0.25, 0.1, 0.25, 1);
}

/* ===== Section 1: 顶部栏（高奢极简） ===== */
/* 顶栏占位：补偿 zy-navbar(root-portal) 占位块失效，避免内容被 fixed 导航栏压住 banner */
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 96rpx;
  padding: 0 var(--page-padding);
  background: transparent;
  position: relative;
  z-index: 30;
}

.topbar-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-width: 0;
  flex: 1;
  transition-property: transform;
  transition-duration: 180ms;
  transition-timing-function: cubic-bezier(0.25, 0.1, 0.25, 1);
}

.topbar-left--pressed {
  transform: scale(0.98);
}

.topbar-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  border: 1rpx solid var(--hairline);
  transition-property: transform;
  transition-duration: 280ms;
  transition-timing-function: cubic-bezier(0.34, 1.15, 0.64, 1);
}

.topbar-avatar--pressed {
  transform: scale(0.9);
}

.topbar-avatar-ph {
  background: var(--gradient-primary);
  display: flex;
  align-items: center;
  justify-content: center;
}

.topbar-avatar-text {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-on-primary);
  letter-spacing: 0;
}

.topbar-greeting {
  display: flex;
  flex-direction: column;
  min-width: 0;
  gap: 4rpx;
}

.topbar-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  letter-spacing: 0;
}

.topbar-loc {
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.2;
}

.topbar-search {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  margin-left: 16rpx;
  border-radius: 50%;
  background: var(--gray-100);
  border: 1rpx solid var(--border-color);
  flex-shrink: 0;
  transition-property: transform;
  transition-duration: 180ms;
  transition-timing-function: cubic-bezier(0.25, 0.1, 0.25, 1);
}

.topbar-search--pressed {
  transform: scale(0.9);
  background: var(--gray-200);
}

.topbar-search-icon {
  width: 28rpx;
  height: 28rpx;
  border: 2rpx solid var(--text-secondary);
  border-radius: 50%;
  position: relative;
  flex-shrink: 0;
}

.topbar-search-icon::after {
  content: '';
  position: absolute;
  right: -6rpx;
  bottom: -6rpx;
  width: 12rpx;
  height: 2rpx;
  background: var(--text-secondary);
  border-radius: 1rpx;
  transform: rotate(45deg);
}

.topbar-search-text {
  display: none;
}

/* ===== Section 2: Banner 16:9（纯图，无 scrim / 无文案） ===== */
.hero-section { position: relative; z-index: 1; width: 100%; }
.hero-swiper { width: 100%; height: 422rpx; }
.hero-card {
  position: relative; width: 100%; height: 422rpx;
  overflow: hidden; background: var(--skeleton-base);
}
.hero-img { width: 100%; height: 100%; display: block; }
.hero-img-ph { background: var(--skeleton-base); }

/* ===== 内容 sheet：一整片暖石缎面渐变，与 banner 硬边相接（零装帧） ===== */
.home-content-sheet {
  position: relative;
  z-index: 2;
  border-radius: 0;
  padding-top: 0;
  min-height: 100vh;
  background-color: var(--sheet-paper);
  background-image: var(--sheet-grad);
  background-repeat: repeat, no-repeat;
  background-size: auto, 100% 100%;
}

/* ===== Section 3: 登录入口（实心主按钮 CTA） ===== */
.search-section {
  padding: var(--zy-space-xl) var(--page-padding) var(--zy-space-lg);
}

.home-login-btn {
  display: flex; align-items: center; justify-content: center;
  width: 100%; padding: 32rpx;
  background: var(--primary-color); color: var(--text-on-primary);
  font-size: 26rpx; font-weight: 500; letter-spacing: 0;
  border-radius: var(--zy-radius-pill); border: none; box-shadow: none;
  transition-property: transform;
  transition-duration: 180ms;
  transition-timing-function: cubic-bezier(0.25, 0.1, 0.25, 1);
}

.home-login-btn--pressed { transform: scale(0.98); opacity: 0.92; }

.home-login-text {
  font-size: 26rpx;
  color: inherit;
  position: relative;
  z-index: 1;
}

/* ===== Section 4: 快捷服务入口（极简网格） ===== */
.quick-services-wrapper {
  margin-top: 0;
  overflow: hidden;
  padding: 0 var(--page-padding);
}

.quick-services {
  display: flex;
  gap: var(--zy-space-lg);
  background: transparent;
  padding: 0;
}

.qs-item {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  flex: 1;
  box-sizing: border-box;
  padding: 36rpx 32rpx;
  background: linear-gradient(180deg, var(--card-satin) 0%, var(--sheet-paper) 100%); /* Plain Sheet：实心暖石纸卡，单条炭墨发丝边 */
  border-radius: var(--lux-radius-card);
  border: 1rpx solid var(--hairline-glass);
  position: relative;
  overflow: hidden;
  transition-property: transform;
  transition-duration: 280ms;
  transition-timing-function: cubic-bezier(0.34, 1.15, 0.64, 1);
}

.qs-item--pressed {
  transform: scale(0.97);
  border-color: var(--primary-color);
}

.qs-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--zy-radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  position: relative;
  transition-property: transform;
  transition-duration: 280ms;
  transition-timing-function: cubic-bezier(0.34, 1.15, 0.64, 1);
}

.qs-item--pressed .qs-icon {
  transform: scale(0.92);
}

.qs-icon-activity {
  background: var(--activity-tint);
}

.qs-icon-mall {
  background: var(--mall-tint);
}

.qs-emoji {
  font-size: 40rpx;
  line-height: 1;
  position: relative;
  z-index: 1;
}

.qs-emoji-img {
  width: 44rpx;
  height: 44rpx;
  position: relative;
  z-index: 1;
}

.qs-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-on-glass);
  line-height: 1.3;
  margin-bottom: 8rpx;
}

.qs-subtitle {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--text-on-glass-2);
  line-height: 1.4;
}

.qs-accent {
  position: absolute;
  top: 0;
  left: 0;
  width: 4rpx;
  height: 100%;
  border-radius: 0 2rpx 2rpx 0;
  transform: scaleY(0);
  transform-origin: top;
  transition-property: transform;
  transition-duration: 500ms;
  transition-timing-function: cubic-bezier(0.19, 1, 0.22, 1);
}

.qs-item--pressed .qs-accent {
  transform: scaleY(1);
}

.qs-accent-activity { background: var(--activity-primary); }
.qs-accent-mall { background: var(--mall-primary); }

/* ===== 通用区块（艺术留白） ===== */
.section {
  margin-top: var(--section-gap);
  padding: 0 var(--page-padding);
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: var(--zy-space-xl);
}

/* Plain Sheet：中性无衬线，常规字重，零字距处理 */
.section-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.2;
}

.section-link {
  font-size: 22rpx;
  color: var(--text-on-glass-2);
  transition-property: transform;
  transition-duration: 180ms;
  transition-timing-function: cubic-bezier(0.25, 0.1, 0.25, 1);
  padding: 8rpx 0;
  font-weight: 400;
}

.section-link--pressed {
  color: var(--primary-color);
  transform: translateX(4rpx);
}

/* ===== Section 5: 团购/商城好物（全图卡，杂志式横滑） ===== */
.section-featured {
  padding-right: 0;
}

.featured-scroll {
  height: 400rpx;
  white-space: nowrap;
}

.featured-list {
  display: flex;
  flex-direction: row;
  height: 100%;
  padding-right: var(--page-padding);
}

.featured-card {
  display: flex;
  flex-direction: column;
  width: 300rpx;
  background: linear-gradient(180deg, var(--card-satin) 0%, var(--sheet-paper) 100%);
  border-radius: var(--lux-radius-card);
  overflow: hidden;
  border: 1rpx solid var(--hairline-glass);
  flex-shrink: 0;
  margin-right: var(--zy-space-lg);
  transition-property: transform;
  transition-duration: 280ms;
  transition-timing-function: cubic-bezier(0.34, 1.15, 0.64, 1);
}

.featured-card--pressed {
  transform: scale(0.97);
  border-color: var(--primary-soft);
}

.featured-img {
  width: 300rpx;
  height: 280rpx;
  display: block;
}

.featured-img-ph {
  background: var(--primary-wash);
  display: flex;
  align-items: center;
  justify-content: center;
}

.featured-img-ph-text {
  font-size: 40rpx;
  color: var(--text-on-glass-2);
  font-weight: 400;
}

.featured-body {
  padding: 20rpx 24rpx 24rpx;
}

.featured-name {
  font-size: 26rpx;
  color: var(--text-primary);
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
  font-weight: 400;
}

.featured-price-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-top: 8rpx;
}

.featured-price {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  line-height: 1.2;
}

.featured-price-orig {
  font-size: 22rpx;
  color: var(--text-on-glass-2);
}

/* ===== 商城好物：全图 + 底部渐变信息 ===== */
.mall-card {
  display: flex;
  width: 300rpx;
  height: 400rpx;
  position: relative;
  border-radius: var(--lux-radius-card);
  overflow: hidden;
  flex-shrink: 0;
  margin-right: var(--zy-space-lg);
  border: 1rpx solid var(--hairline-glass);
  transition-property: transform;
  transition-duration: 280ms;
  transition-timing-function: cubic-bezier(0.34, 1.15, 0.64, 1);
}

.mall-card--pressed {
  transform: scale(0.97);
}

.mall-card-img {
  width: 100%;
  height: 100%;
  display: block;
  transition-property: transform;
  transition-duration: 700ms;
  transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
}

.mall-card--pressed .mall-card-img {
  transform: scale(1.04);
}

.mall-card-img-share {
  width: 100%;
  height: 100%;
  display: block;
}

.mall-card-img-ph {
  background: var(--primary-wash);
  display: flex;
  align-items: center;
  justify-content: center;
}

.mall-card-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 55%;
  background: linear-gradient(to top, rgba(15, 36, 16, 0.85) 0%, rgba(15, 36, 16, 0.5) 40%, transparent 100%);
  pointer-events: none;
}

.mall-card-info {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx;
}

.mall-card-name {
  font-size: 26rpx;
  font-weight: 400;
  color: #FFFFFF;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
  letter-spacing: 0;
}

.mall-card-price-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-top: 8rpx;
}

.mall-card-price {
  font-size: 28rpx;
  font-weight: 500;
  color: #FFFFFF;
  line-height: 1.2;
}

.mall-card-original {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.6);
  text-decoration: line-through;
}

.mall-card-sold {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-left: auto;
  letter-spacing: 0;
}

/* ===== Section 6: 近期活动（杂志式横卡） ===== */
.activity-list {
  display: flex;
  flex-direction: column;
  gap: var(--zy-space-lg);
}

.activity-h-card {
  display: flex;
  background: linear-gradient(180deg, var(--card-satin) 0%, var(--sheet-paper) 100%);
  border-radius: var(--lux-radius-card);
  overflow: hidden;
  border: 1rpx solid var(--hairline-glass);
  transition-property: transform;
  transition-duration: 280ms;
  transition-timing-function: cubic-bezier(0.34, 1.15, 0.64, 1);
}

.activity-h-card--pressed {
  transform: scale(0.99);
  border-color: var(--primary-soft);
}

.activity-h-img {
  width: 240rpx;
  height: 240rpx;
  flex-shrink: 0;
  transition-property: transform;
  transition-duration: 700ms;
  transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
}

.activity-h-card--pressed .activity-h-img {
  transform: scale(1.04);
}

.activity-h-img-share {
  width: 240rpx;
  height: 240rpx;
  flex-shrink: 0;
  overflow: hidden;
}

.activity-h-img-ph {
  background: var(--primary-wash);
  display: flex;
  align-items: center;
  justify-content: center;
}

.activity-h-img-ph-text {
  font-size: 28rpx;
  color: var(--text-on-glass-2);
  font-weight: 400;
}

.activity-h-body {
  flex: 1;
  padding: 32rpx 28rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
  min-width: 0;
}

.activity-h-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  letter-spacing: 0;
}

.activity-h-info {
  font-size: 22rpx;
  color: var(--text-on-glass-2);
  line-height: 1.5;
  font-weight: 400;
}

.activity-h-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 4rpx;
}

.activity-h-loc {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 20rpx;
  color: var(--text-on-glass-2);
}

.activity-h-loc-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.activity-h-loc-text {
  font-size: inherit;
  color: inherit;
}

.activity-h-people {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 20rpx;
  color: var(--text-on-glass); /* 原硬编码 #1F3A1F 暗态仅 2.76:1，改主文字色 */
  font-weight: 500;
}

.activity-h-people-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.activity-h-people-text {
  font-size: inherit;
  color: inherit;
}

/* ===== 底部留白（艺术级呼吸） ===== */
.bottom-spacer {
  height: 400rpx; /* 缎面溶解：原 240(container)+160 = 400，全量移入 sheet 内部，保证底部也是纸面而非 page 渐变 */
}

/* ===== Section 2.5: 我的宠物（极简头像行） ===== */
.my-pets-section {
  margin: 0 0 var(--zy-space-lg);
  padding: 64rpx var(--page-padding) 48rpx;
  background: transparent;
}

.my-pets-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--zy-space-lg);
  padding: 0;
}

.my-pets-title-wrap {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  white-space: nowrap;
}

.pet-add-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 24rpx;
  margin-left: 24rpx;
  border-radius: var(--zy-radius-pill);
  background: transparent;
  border: 1rpx solid var(--hairline-glass);
  flex-shrink: 0;
  white-space: nowrap;
  transition-property: transform;
  transition-duration: 180ms;
  transition-timing-function: cubic-bezier(0.25, 0.1, 0.25, 1);
}

.pet-add-btn--pressed {
  transform: scale(0.94);
  border-color: var(--primary-color);
  background: var(--primary-wash);
}

.pet-view-all {
  font-size: 22rpx;
  color: var(--text-on-glass-2);
  line-height: 1;
  transition-property: transform;
  transition-duration: 180ms;
  transition-timing-function: cubic-bezier(0.25, 0.1, 0.25, 1);
  padding: 8rpx 0;
}

.pet-view-all--pressed {
  color: var(--primary-color);
  transform: translateX(4rpx);
}

.pet-add-icon {
  font-size: 24rpx;
  color: var(--text-on-glass-2);
  line-height: 1;
}

.pet-add-text {
  font-size: 22rpx;
  color: var(--text-on-glass-2);
  line-height: 1;
}

.pets-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--zy-space-lg);
}

.pet-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex: 1;
  max-width: calc(50% - 24rpx); /* 50% - spacing-lg/2，与 .qs-item flex:1 平分等价 */
  min-width: 0;
  padding: 24rpx;
  background: linear-gradient(180deg, var(--card-satin) 0%, var(--sheet-paper) 100%); /* Plain Sheet：实心暖石纸卡，单条炭墨发丝边 */
  border-radius: var(--lux-radius-card);
  border: 1rpx solid var(--hairline-glass);
  box-sizing: border-box;
  transition-property: transform;
  transition-duration: 280ms;
  transition-timing-function: cubic-bezier(0.34, 1.15, 0.64, 1);
}

.pet-card--pressed {
  transform: scale(0.97);
  border-color: var(--primary-soft);
}

/* 右侧卡片右移 20rpx，对齐快捷板块视觉宽度 */
.pet-card:nth-child(2) {
  margin-left: 20rpx;
}

.pet-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--primary-wash);
  flex-shrink: 0;
  margin-right: 20rpx;
  box-sizing: border-box;
  transition-property: transform;
  transition-duration: 280ms;
  transition-timing-function: cubic-bezier(0.34, 1.15, 0.64, 1);
  border: 1rpx solid var(--hairline);
}

.pet-card--pressed .pet-avatar {
  transform: scale(0.9);
}

.pet-avatar-male {
  border: 2rpx solid var(--gender-male, #5BB8D6);
}

.pet-avatar-female {
  border: 2rpx solid var(--gender-female, #FFA6C9);
}

.pet-info {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.pet-name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.pet-gender-tag {
  font-size: 18rpx;
  font-weight: 500;
  line-height: 1;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.pet-gender-male {
  color: var(--gender-male, #5BB8D6);
  background: var(--gender-male-tint, rgba(91, 184, 214, 0.10));
}

.pet-gender-female {
  color: var(--gender-female, #FFA6C9);
  background: var(--gender-female-tint, rgba(255, 166, 201, 0.10));
}

.pet-gender-unknown {
  display: none;
}

/* 性别色左侧线：用 inset 内阴影替代 border-left，确保被 40rpx 圆角裁切、随圆角围绕过去；
   规避 Skyline 下"单边加粗 border + 大 radius"拐角不圆、方头戳出圆角的硬边 bug。 */
.pet-card-male {
  box-shadow: inset 3rpx 0 0 0 var(--gender-male, #5BB8D6);
}

.pet-card-female {
  box-shadow: inset 3rpx 0 0 0 var(--gender-female, #FFA6C9);
}

.pet-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-on-glass);
  line-height: 1.2;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pet-breed {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--text-on-glass-2);
  margin-top: 6rpx;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pet-card-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  max-width: calc(50% - 24rpx);
  min-width: 0;
  min-height: 140rpx;
  padding: 24rpx;
  background: linear-gradient(180deg, var(--card-satin) 0%, var(--sheet-paper) 100%); /* Plain Sheet：空态同用实心纸，虚线版位保持"未装帧"语义 */
  border-radius: var(--lux-radius-card);
  border: 1rpx dashed var(--hairline-glass);
  box-sizing: border-box;
  transition-property: transform;
  transition-duration: 180ms;
  transition-timing-function: cubic-bezier(0.25, 0.1, 0.25, 1);
}

.pet-card-empty--pressed {
  border-color: var(--primary-color);
  background: var(--primary-wash);
  transform: scale(0.98);
}

.pet-empty-text {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--text-on-glass-2);
  line-height: 1.4;
  text-align: center;
}

/* ================================================================
   入场动画 · Stagger 丝绸展开（Haute-Luxury 版）
   ----------------------------------------------------------------
   更慢更柔，幅度更小，更克制
   ================================================================ */
@keyframes rise-fade-in {
  0% { opacity: 0; transform: translateY(24rpx); }
  100% { opacity: 1; transform: translateY(0); }
}

@keyframes rise-fade-in-short {
  0% { opacity: 0; transform: translateY(16rpx); }
  100% { opacity: 1; transform: translateY(0); }
}

@keyframes scale-fade-in {
  0% { opacity: 0; transform: scale(0.96); }
  100% { opacity: 1; transform: scale(1); }
}

.stagger-item {
  opacity: 0;
  animation-fill-mode: forwards;
}

/* 可达性兜底：用户开启「减少动态效果」时，入场动画不播，内容直接可见，避免卡在 opacity:0。
   Skyline 不支持 prefers-reduced-motion 媒体特性（报 Unsupported segment 且整段被忽略），
   故改为由 JS 探测 reduceMotion 后给滚动容器加 .reduce-motion 类来驱动。 */
.reduce-motion .stagger-item {
  opacity: 1;
  animation: none;
}

.stagger-rise {
  animation-name: rise-fade-in;
  animation-duration: 700ms;
  animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
}

.stagger-rise-fast {
  animation-name: rise-fade-in-short;
  animation-duration: 500ms;
  animation-timing-function: cubic-bezier(0.19, 1, 0.22, 1);
}

.stagger-scale {
  animation-name: scale-fade-in;
  animation-duration: 600ms;
  animation-timing-function: cubic-bezier(0.34, 1.15, 0.64, 1);
}

.delay-0 { animation-delay: 0ms; }
.delay-1 { animation-delay: 120ms; }
.delay-2 { animation-delay: 240ms; }
.delay-3 { animation-delay: 360ms; }
.delay-4 { animation-delay: 480ms; }
.delay-5 { animation-delay: 600ms; }
.delay-6 { animation-delay: 720ms; }
.delay-7 { animation-delay: 840ms; }
.delay-8 { animation-delay: 960ms; }

/* 顶部栏淡入 */
@keyframes topbar-fade {
  0% { opacity: 0; transform: translateY(-12rpx); }
  100% { opacity: 1; transform: translateY(0); }
}

.topbar-stagger {
  opacity: 0;
  animation-name: topbar-fade;
  animation-duration: 700ms;
  animation-timing-function: cubic-bezier(0.19, 1, 0.22, 1);
  animation-delay: 100ms;
  animation-fill-mode: forwards;
}
