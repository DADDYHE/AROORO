/* ================================================================
   pages/home/index.wxss · AROORO 首页 · 时装屋开场（方案 B）
   设计系统：styles/theme-teal.wxss + styles/lux-page.wxss
   ----------------------------------------------------------------
   2026-09-12：由「Plain Sheet 零装帧极简」升级为方案 B「时装屋开场」。
     旧规则全部保留在下方，新样式集中在文件末尾「B 版式覆盖层」整段（可整段回滚）。
     封面：深绿 165deg 沉浸 + AROORO 字标 + 品牌落款印章（无金竖线 / 无 SCROLL）
     当期橱窗：手动横滑（无 autoplay / 无 circular，一屏一图 + 右侧露边 + 展签 + 金墨细线段页码）
     内容区：纸面流（无纸卡 / 无圆角 / 无发丝边），行线一律 rgba(26,26,23,0.14)
     排版：serif 大标题 + 英文小标 + 金墨短规则线；纸面金字一律 --lux-gold-ink
     节奏：板块间距 88rpx（方案 B 的 g-B = 88rpx）

   历史（已废弃，仅存档）：设计方向：零装帧极简
     · Banner 16:9 纯图，无 scrim / 无文案 / 无描金
     · 下方一整片暖石缎面渐变（--sheet-grad，与 page 同源），与 banner 硬边相接、零透叠
     · 卡片：暖石渐变（--card-satin→--sheet-paper）+ 单条 --hairline-glass 边
     · 排版：中性无衬线、常规字重、零字距处理
   Skyline 兼容：禁用 backdrop-filter / text-shadow / mask-image /
                 :active / position:sticky / text-transform / 负 z-index
                 仅 transform/opacity 动画，GPU 加速
   ================================================================ */

/* ===== 基础容器 ===== */
.home-container {
  --sheet-grad: var(--zy-paper-noise), linear-gradient(180deg, var(--card-satin) 0%, var(--sheet-paper) 50%, var(--background-warm) 100%);
  min-height: 100vh;
  background: transparent;
  font-family: var(--font-sans);
  padding: 0; /* Plain Sheet：整片背景统一暖石缎面渐变（sheet 用 --sheet-grad，与 page 同源），零装帧 */
  margin-top: 0;
  box-sizing: border-box;
}

.home-scroll {
  position: relative;
  z-index: 2;
  background: transparent;
}

page {
  margin: 0;
  padding: 0;
}

/* ===== 下拉刷新指示器（极简） ===== */
.refresh-indicator {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100rpx;
  gap: 12rpx;
}

.refresh-spinner {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.refresh-arrow {
  width: 16rpx;
  height: 16rpx;
  border-right: 2rpx solid var(--primary-color);
  border-bottom: 2rpx solid var(--primary-color);
  transform: rotate(45deg);
  transition-property: transform;
  transition-duration: 400ms;
  transition-timing-function: cubic-bezier(0.34, 1.15, 0.64, 1);
}

.refresh-arrow.refresh-arrow-pulling {
  transform: rotate(225deg);
}

.refresh-text {
  font-size: 20rpx;
  color: var(--text-on-glass-2);
  transition-property: opacity;
  transition-duration: 280ms;
  transition-timing-function: cubic-bezier(0.25, 0.1, 0.25, 1);
}

/* ===== Section 1: 顶部栏（高奢极简） ===== */
/* 顶栏占位：补偿 zy-navbar(root-portal) 占位块失效，避免内容被 fixed 导航栏压住 banner */
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 96rpx;
  padding: 0 var(--page-padding);
  background: linear-gradient(135deg, #2D4F2D 0%, #0F2410 100%);
  position: relative;
  z-index: 30;
}

.topbar-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-width: 0;
  flex: 1;
  transition-property: transform;
  transition-duration: 180ms;
  transition-timing-function: cubic-bezier(0.25, 0.1, 0.25, 1);
}

.topbar-left--pressed {
  transform: scale(0.98);
}

.topbar-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  border: 1rpx solid rgba(255,255,255,0.28);
  transition-property: transform;
  transition-duration: 280ms;
  transition-timing-function: cubic-bezier(0.34, 1.15, 0.64, 1);
}

.topbar-avatar--pressed {
  transform: scale(0.9);
}

.topbar-avatar-ph {
  background: var(--gradient-primary);
  display: flex;
  align-items: center;
  justify-content: center;
}

.topbar-avatar-text {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-on-primary);
  letter-spacing: 0;
}

.topbar-greeting {
  display: flex;
  flex-direction: column;
  min-width: 0;
  gap: 4rpx;
}

/* 极光带底色横跨 #0F2410(暗谷) ~ #5A7C63(热核)，同一行字会跨越两种极端亮度。
   实测唯有纯白全域过 AA（4.67:1 @热核 ~ 16.40:1 @暗谷）；
   金 rgba(201,162,75,.92) 在热核仅 1.85:1，白 85% 仅 3.87:1，均不合格。
   故名字/位置同用纯白，层级交给字号+字重（30rpx/500 vs 22rpx/400），不靠透明度。 */
.topbar-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #FFFFFF;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  letter-spacing: 0;
}

.topbar-loc {
  font-size: 22rpx;
  color: #FFFFFF;
  line-height: 1.2;
}

.topbar-search {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  margin-left: 16rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.14);
  border: 1rpx solid rgba(255,255,255,0.22);
  flex-shrink: 0;
  transition-property: transform;
  transition-duration: 180ms;
  transition-timing-function: cubic-bezier(0.25, 0.1, 0.25, 1);
}

.topbar-search--pressed {
  transform: scale(0.9);
  background: rgba(255,255,255,0.22);
}

.topbar-search-icon {
  width: 28rpx;
  height: 28rpx;
  border: 2rpx solid rgba(255,255,255,0.85);
  border-radius: 50%;
  position: relative;
  flex-shrink: 0;
}

.topbar-search-icon::after {
  content: '';
  position: absolute;
  right: -6rpx;
  bottom: -6rpx;
  width: 12rpx;
  height: 2rpx;
  background: rgba(255,255,255,0.85);
  border-radius: 1rpx;
  transform: rotate(45deg);
}

.topbar-search-text {
  display: none;
}

/* ===== Section 2: Banner 16:9（纯图，无 scrim / 无文案） ===== */
.hero-section { position: relative; z-index: 1; width: 100%; }
.hero-swiper { width: 100%; height: 422rpx; }
.hero-card {
  position: relative; width: 100%; height: 422rpx;
  overflow: hidden; background: var(--skeleton-base);
}
.hero-img { width: 100%; height: 100%; display: block; }
.hero-img-ph { background: var(--skeleton-base); }

/* ===== 内容 sheet：一整片暖石缎面渐变，与 banner 硬边相接（零装帧） ===== */
.home-content-sheet {
  position: relative;
  z-index: 2;
  border-radius: 0;
  padding-top: 0;
  min-height: 100vh;
  background-color: var(--sheet-paper);
  background-image: var(--sheet-grad);
  background-repeat: repeat, no-repeat;
  background-size: auto, 100% 100%;
}

/* ===== Section 3: 登录入口（实心主按钮 CTA） ===== */
.search-section {
  padding: var(--zy-space-xl) var(--page-padding) var(--zy-space-lg);
}

.home-login-btn {
  display: flex; align-items: center; justify-content: center;
  width: 100%; padding: 32rpx;
  background: linear-gradient(118deg, var(--primary-color) 0%, #2D4F2D 48%, #3A5A42 100%);
  color: var(--text-on-primary);
  font-size: 26rpx; font-weight: 500; letter-spacing: 0;
  border-radius: var(--zy-radius-lg); border: none;
  box-shadow: 0 6rpx 18rpx rgba(58, 90, 66, 0.30);
  transition-property: transform, box-shadow;
  transition-duration: 180ms;
  transition-timing-function: cubic-bezier(0.25, 0.1, 0.25, 1);
}

.home-login-btn--pressed {
  transform: scale(0.98); opacity: 0.92;
  box-shadow: 0 3rpx 10rpx rgba(58, 90, 66, 0.22);
}

.home-login-text {
  font-size: 26rpx;
  color: inherit;
  position: relative;
  z-index: 1;
}

/* ===== Section 4: 快捷服务入口（极简网格） ===== */
.quick-services-wrapper {
  margin-top: 0;
  overflow: hidden;
  padding: 0 var(--page-padding);
}

.quick-services {
  display: flex;
  gap: var(--zy-space-lg);
  background: transparent;
  padding: 0;
}

.qs-item {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  flex: 1;
  box-sizing: border-box;
  padding: 36rpx 32rpx;
  background: linear-gradient(180deg, var(--card-satin) 0%, var(--sheet-paper) 100%); /* Plain Sheet：实心暖石纸卡，单条炭墨发丝边 */
  border-radius: var(--lux-radius-card);
  border: 1rpx solid var(--hairline-glass);
  position: relative;
  overflow: hidden;
  transition-property: transform;
  transition-duration: 280ms;
  transition-timing-function: cubic-bezier(0.34, 1.15, 0.64, 1);
}

.qs-item--pressed {
  transform: scale(0.97);
  border-color: var(--primary-color);
}

.qs-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--zy-radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  position: relative;
  transition-property: transform;
  transition-duration: 280ms;
  transition-timing-function: cubic-bezier(0.34, 1.15, 0.64, 1);
}

.qs-item--pressed .qs-icon {
  transform: scale(0.92);
}

.qs-icon-activity {
  background: var(--activity-tint);
}

.qs-icon-mall {
  background: var(--mall-tint);
}

.qs-emoji {
  font-size: 40rpx;
  line-height: 1;
  position: relative;
  z-index: 1;
}

.qs-emoji-img {
  width: 44rpx;
  height: 44rpx;
  position: relative;
  z-index: 1;
}

.qs-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-on-glass);
  line-height: 1.3;
  margin-bottom: 8rpx;
}

.qs-subtitle {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--text-on-glass-2);
  line-height: 1.4;
}

.qs-accent {
  position: absolute;
  top: 0;
  left: 0;
  width: 4rpx;
  height: 100%;
  border-radius: 0 2rpx 2rpx 0;
  transform: scaleY(0);
  transform-origin: top;
  transition-property: transform;
  transition-duration: 500ms;
  transition-timing-function: cubic-bezier(0.19, 1, 0.22, 1);
}

.qs-item--pressed .qs-accent {
  transform: scaleY(1);
}

.qs-accent-activity { background: var(--activity-primary); }
.qs-accent-mall { background: var(--mall-primary); }

/* ===== 通用区块（艺术留白） ===== */
.section {
  margin-top: var(--section-gap);
  padding: 0 var(--page-padding);
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: var(--zy-space-xl);
}

/* Plain Sheet：中性无衬线，常规字重，零字距处理 */
.section-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.2;
}

.section-link {
  font-size: 22rpx;
  color: var(--text-on-glass-2);
  transition-property: transform;
  transition-duration: 180ms;
  transition-timing-function: cubic-bezier(0.25, 0.1, 0.25, 1);
  padding: 8rpx 0;
  font-weight: 400;
}

.section-link--pressed {
  color: var(--primary-color);
  transform: translateX(4rpx);
}

/* ===== Section 5: 团购/商城好物（全图卡，杂志式横滑） ===== */
.section-featured {
  padding-right: 0;
}

/* 区块本身 padding-right:0 是为了让横滑卡列表（featured-list 自带 padding-right）出血到屏幕右缘；
   但标题行应保留页面右内边距，否则「查看全部」会比其他板块更贴右屏边、无法对齐。
   故仅给 .section-head 补回右内边距，横滑区域不受影响。 */
.section-featured .section-head {
  padding-right: var(--page-padding);
}

.featured-scroll {
  height: 400rpx;
  white-space: nowrap;
}

.featured-list {
  display: flex;
  flex-direction: row;
  height: 100%;
  padding-right: var(--page-padding);
}

.featured-card {
  display: flex;
  flex-direction: column;
  width: 300rpx;
  background: linear-gradient(180deg, var(--card-satin) 0%, var(--sheet-paper) 100%);
  border-radius: var(--lux-radius-card);
  overflow: hidden;
  border: 1rpx solid var(--hairline-glass);
  flex-shrink: 0;
  margin-right: var(--zy-space-lg);
  transition-property: transform;
  transition-duration: 280ms;
  transition-timing-function: cubic-bezier(0.34, 1.15, 0.64, 1);
}

.featured-card--pressed {
  transform: scale(0.97);
  border-color: var(--primary-soft);
}

.featured-img {
  width: 300rpx;
  height: 280rpx;
  display: block;
}

.featured-img-ph {
  background: var(--primary-wash);
  display: flex;
  align-items: center;
  justify-content: center;
}

.featured-img-ph-text {
  font-size: 40rpx;
  color: var(--text-on-glass-2);
  font-weight: 400;
}

.featured-body {
  padding: 20rpx 24rpx 24rpx;
}

.featured-name {
  font-size: 26rpx;
  color: var(--text-primary);
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
  font-weight: 400;
}

.featured-price-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-top: 8rpx;
}

.featured-price {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  line-height: 1.2;
}

.featured-price-orig {
  font-size: 22rpx;
  color: var(--text-on-glass-2);
}

/* ===== 商城好物：全图 + 底部渐变信息 ===== */
.mall-card {
  display: flex;
  width: 300rpx;
  height: 400rpx;
  position: relative;
  border-radius: var(--lux-radius-card);
  overflow: hidden;
  flex-shrink: 0;
  margin-right: var(--zy-space-lg);
  border: 1rpx solid var(--hairline-glass);
  transition-property: transform;
  transition-duration: 280ms;
  transition-timing-function: cubic-bezier(0.34, 1.15, 0.64, 1);
}

.mall-card--pressed {
  transform: scale(0.97);
}

.mall-card-img {
  width: 100%;
  height: 100%;
  display: block;
  transition-property: transform;
  transition-duration: 700ms;
  transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
}


.mall-card-img-share {
  width: 100%;
  height: 100%;
  display: block;
}

.mall-card-img-ph {
  background: var(--primary-wash);
  display: flex;
  align-items: center;
  justify-content: center;
}

.mall-card-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 55%;
  background: linear-gradient(to top, rgba(15, 36, 16, 0.85) 0%, rgba(15, 36, 16, 0.5) 40%, transparent 100%);
  pointer-events: none;
}

.mall-card-info {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx;
}

.mall-card-name {
  font-size: 26rpx;
  font-weight: 400;
  color: #FFFFFF;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
  letter-spacing: 0;
}

.mall-card-price-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-top: 8rpx;
}

.mall-card-price {
  font-size: 28rpx;
  font-weight: 500;
  color: #FFFFFF;
  line-height: 1.2;
}

.mall-card-original {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.82);
  text-decoration: line-through;
}

.mall-card-sold {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-left: auto;
  letter-spacing: 0;
}

/* ===== Section 6: 近期活动（杂志式横卡） ===== */
.activity-list {
  display: flex;
  flex-direction: column;
  gap: var(--zy-space-lg);
}

.activity-h-card {
  display: flex;
  background: linear-gradient(180deg, var(--card-satin) 0%, var(--sheet-paper) 100%);
  border-radius: var(--lux-radius-card);
  overflow: hidden;
  position: relative;
  border: 1rpx solid var(--hairline-glass);
  transition-property: transform;
  transition-duration: 280ms;
  transition-timing-function: cubic-bezier(0.34, 1.15, 0.64, 1);
}

.activity-h-card--pressed {
  transform: scale(0.99);
  border-color: var(--primary-soft);
}

.activity-h-img {
  width: 240rpx;
  height: 240rpx;
  flex-shrink: 0;
  transition-property: transform;
  transition-duration: 700ms;
  transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
}


.activity-h-img-share {
  width: 240rpx;
  height: 240rpx;
  flex-shrink: 0;
  overflow: hidden;
}

.activity-h-img-ph {
  background: var(--primary-wash);
  display: flex;
  align-items: center;
  justify-content: center;
}

.activity-h-img-ph-text {
  font-size: 28rpx;
  color: var(--text-on-glass-2);
  font-weight: 400;
}

.activity-h-body {
  flex: 1;
  padding: 32rpx 28rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
  min-width: 0;
}

.activity-h-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  letter-spacing: 0;
}

.activity-h-info {
  font-size: 22rpx;
  color: var(--text-on-glass-2);
  line-height: 1.5;
  font-weight: 400;
}

.activity-h-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 4rpx;
}

.activity-h-loc {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 20rpx;
  color: var(--text-on-glass-2);
}

.activity-h-loc-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.activity-h-loc-text {
  font-size: inherit;
  color: inherit;
}

.activity-h-people {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 20rpx;
  color: var(--text-on-glass); /* 原硬编码主绿（--primary-color）暗态仅 2.76:1，改主文字色 */
  font-weight: 500;
}

.activity-h-people-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.activity-h-people-text {
  font-size: inherit;
  color: inherit;
}

/* ===== Section 2.7: 我的活动（已报名，可首页签到） ===== */
.my-activities-section {
  margin-top: var(--section-gap);
  padding: 0 var(--page-padding);
}

/* 「我的宠物」与「我的活动」同为登录态专属区块，成组紧凑排布，收紧其间的章节间距 */
.my-pets-section + .my-activities-section {
  margin-top: 24rpx;
}

/* 「我的活动」板块底到「快捷导航」顶的间距统一为 36rpx */
.my-activities-section + .quick-services-wrapper {
  margin-top: 36rpx;
}

/* 「我的活动」标题到卡片的间距，比全局 section 标题间距（64rpx）收紧 */
.my-activities-section .section-head {
  margin-bottom: 32rpx;
}

.my-act-list {
  display: flex;
  flex-direction: column;
  gap: var(--zy-space-lg);
}

.my-act-card {
  display: flex;
  align-items: stretch;
  background: linear-gradient(180deg, var(--card-satin) 0%, var(--sheet-paper) 100%);
  border-radius: var(--lux-radius-card);
  overflow: hidden;
  position: relative;
  border: 1rpx solid var(--hairline-glass);
  transition-property: transform;
  transition-duration: 280ms;
  transition-timing-function: cubic-bezier(0.34, 1.15, 0.64, 1);
}

.my-act-card--pressed {
  transform: scale(0.99);
  border-color: var(--primary-soft);
}

.my-act-img {
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
}

.my-act-img-ph {
  background: var(--primary-wash);
