}

/* 计数功能 */
.count-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.count-text {
  font-size: 40rpx;
  font-weight: 900;
  color: #000000;
  margin-bottom: 40rpx;
  text-transform: uppercase;
  letter-spacing: 6rpx;
}

.count-button {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  font-size: 32rpx;
  font-weight: 900;
  background-color: #000000;
  color: white;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-transform: uppercase;
  letter-spacing: 6rpx;
  position: relative;
  overflow: hidden;
  transition: all 0.4s ease;
  box-shadow: 0 8rpx 25rpx rgba(0, 0, 0, 0.1);
}

.count-button::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background-color: rgba(255, 255, 255, 0.2);
  transition: left 0.4s ease;
  z-index: -1;
}

.count-button:active {
  transform: translateY(3rpx);
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.08);
}

.count-button:active::before {
  left: 0;
}

/* 登录加载动画覆盖层样式 */
.login-loading-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  z-index: 10;
}

/* 加载内容样式 */
.loading-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

/* 加载动画样式 */
.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(0, 0, 0, 0.1);
  border-top: 4rpx solid #000000;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

/* 加载文本样式 */
.loading-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #000000;
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

/* 加载动画关键帧 */
@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 登录提交按钮样式 - 添加flex布局 */
.login-submit-btn {
  display: flex;
  align-items: center;
  justify-content: center;
}
