page { height: 100vh; background-color: var(--background-color); }

.service-container {
  width: 100%;
  min-height: 100vh;
  background-color: var(--background-color);
}

.page-content {
  padding: 32rpx;
  max-width: 1000rpx;
  margin: 0 auto;
}

.service-card {
  padding: 32rpx 24rpx;
  background: var(--card-color);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(134, 134, 139, 0.1);
  position: relative;
  overflow: hidden;
}

.service-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: linear-gradient(90deg, var(--activity-primary) 0%, var(--activity-primary-mid) 50%, transparent 100%);
  border-radius: 24rpx 24rpx 0 0;
}

.service-card-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 0 4rpx;
}

.service-card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.service-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
  position: relative;
  z-index: 2;
}

.service-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx 16rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, var(--card-color) 0%, var(--surface-tint) 100%);
  border: 1rpx solid rgba(134, 134, 139, 0.08);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.service-item:active {
  transform: scale(0.96);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.service-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  pointer-events: none;
}

.service-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  position: relative;
  overflow: hidden;
}

.service-icon-image {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
}

.service-icon-feeding {
  background: linear-gradient(135deg, rgba(255, 159, 67, 0.15) 0%, rgba(255, 138, 101, 0.08) 100%);
}

.service-icon-boarding {
  background: linear-gradient(135deg, rgba(78, 205, 196, 0.15) 0%, rgba(69, 183, 170, 0.08) 100%);
}

.service-text {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 4rpx;
  text-align: center;
}

.service-desc {
  font-size: 20rpx;
  color: var(--gray-500);
  text-align: center;
  margin-bottom: 8rpx;
}

.service-accent {
  width: 32rpx;
  height: 2rpx;
  background: linear-gradient(90deg, var(--activity-primary) 0%, var(--activity-primary-mid) 100%);
  border-radius: 1rpx;
  opacity: 0.5;
}
