/* 服务入口 - PETLUX 橄榄绿治愈轻奢风格 */

page {
  height: 100vh;
  background-color: var(--background-color);
}

.service-container {
  width: 100%;
  min-height: 100vh;
  background-color: var(--background-color);
}

.page-content {
  padding: 32rpx;
  max-width: 1000rpx;
  margin: 0 auto;
}

.service-card {
  padding: 32rpx 24rpx;
  background: var(--card-color);
  border-radius: var(--border-radius-md);
  box-shadow: var(--zy-shadow-xs);
  border: 1rpx solid var(--border-color);
  position: relative;
  overflow: hidden;
}

.service-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, var(--primary-color) 0%, var(--primary-light) 60%, transparent 100%);
  border-radius: var(--border-radius-md) var(--border-radius-md) 0 0;
}

.service-card-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 0 4rpx;
}

.service-card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.service-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
  position: relative;
  z-index: 2;
}

.service-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx 16rpx;
  border-radius: var(--border-radius-md);
  background: var(--card-color);
  border: 1rpx solid var(--border-color);
  box-shadow: var(--zy-shadow-xs);
}

.service-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  pointer-events: none;
}

.service-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--border-radius-md);
  background: var(--primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  position: relative;
  overflow: hidden;
}

.service-icon-image {
  width: 48rpx;
  height: 48rpx;
  border-radius: var(--border-radius-xs);
}

.service-icon-feeding {
  background: var(--primary-light);
}

.service-icon-boarding {
  background: var(--primary-light);
}

.service-text {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 4rpx;
  text-align: center;
}

.service-desc {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--text-tertiary);
  text-align: center;
  margin-bottom: 8rpx;
}

.service-accent {
  width: 32rpx;
  height: 2rpx;
  background: linear-gradient(90deg, var(--primary-color) 0%, var(--primary-light) 100%);
  border-radius: 1rpx;
  opacity: 0.5;
}
