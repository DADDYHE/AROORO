/* 聊天页面样式 - 巴黎世家风格 */
.page-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #fafafa;
}

.chat-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  background-color: #fafafa;
  position: relative;
  overflow: hidden;
}

/* 消息列表区域 */
.message-list {
  flex: 1;
  padding: 40rpx;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  padding-bottom: 40rpx;
  transition: all 0.3s ease;
}

/* 底部区域 */
.bottom-area {
  display: flex;
  flex-direction: column;
  background-color: #fafafa;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.03);
  width: 100%;
  box-sizing: border-box;
  z-index: 10;
  margin-top: 0;
  position: relative;
  transition: all 0.3s ease;
  padding-bottom: 20rpx;
}

/* 加载更多提示 */
.loading-more {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.loading-text {
  font-size: 24rpx;
  color: #999999;
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

/* 消息项 */
.message-item {
  display: flex;
  align-items: flex-end;
  gap: 20rpx;
}

/* 自己的消息 */
.self-message {
  flex-direction: row-reverse;
}

/* 对方的消息 */
.other-message {
  flex-direction: row;
}

/* 头像 */
.message-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 1rpx solid #e0e0e0;
  background-color: #f0f0f0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  flex-shrink: 0;
}

.avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  object-fit: cover;
}

/* 消息内容 */
.message-content {
  max-width: 70%;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

/* 位置消息的消息内容 */
.message-content:has(.location-message) {
  max-width: 70%;
  width: 100%;
}

/* 消息气泡 */
.message-bubble {
  padding: 25rpx 30rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid #f0f0f0;
}

/* 自己的消息气泡 */
.self-bubble {
  background-color: #000000;
  border-top-right-radius: 5rpx;
  align-self: flex-end;
}

/* 对方的消息气泡 */
.other-bubble {
  background-color: #ffffff;
  border-top-left-radius: 5rpx;
  align-self: flex-start;
}

/* 消息文本 */
.message-text {
  font-size: 28rpx;
  line-height: 1.4;
  letter-spacing: 1rpx;
}

/* 自己的消息文本 */
.self-bubble .message-text {
  color: #ffffff;
}

/* 对方的消息文本 */
.other-bubble .message-text {
  color: #000000;
}

/* 语音消息 */
.voice-message {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx;
}

.voice-message .voice-icon {
  width: 30rpx;
  height: 30rpx;
}

.voice-message .voice-text {
  font-size: 28rpx;
  line-height: 1.4;
  letter-spacing: 1rpx;
}

.self-bubble .voice-text {
  color: #ffffff;
}

.other-bubble .voice-text {
  color: #000000;
}

/* 图片消息 */
.image-message {
  padding: 10rpx;
}

.message-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 10rpx;
}

/* 视频消息 */
.video-message {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx;
}

.message-video-cover {
  width: 200rpx;
  height: 150rpx;
  border-radius: 10rpx;
}

.video-text {
  font-size: 24rpx;
  line-height: 1.4;
  letter-spacing: 1rpx;
}

.self-bubble .video-text {
  color: #ffffff;
}

.other-bubble .video-text {
  color: #000000;
}

/* 撤回消息 */
.revoked-message {
  font-style: italic;
  opacity: 0.6;
}

.self-bubble .revoked-message {
  color: rgba(255, 255, 255, 0.8);
}

.other-bubble .revoked-message {
  color: rgba(0, 0, 0, 0.6);
}

/* 位置消息 */
.location-message {
  padding: 0;
  min-width: 100%;
  max-width: 100%;
  cursor: pointer;
  background: transparent;
  box-shadow: none;
  border: none;
  border-radius: 0;
}

.location-card {
  background-color: #f5f5f5;
  border-radius: 15rpx;
  padding: 0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  border: 1rpx solid #e0e0e0;
  width: 100%;
  display: flex;
  flex-direction: column;
  min-height: 350rpx;
}

.location-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15rpx;
  border-bottom: 1rpx solid #e0e0e0;
  height: 40rpx;
}

.location-name {
  font-size: 28rpx;
  font-weight: bold;
  line-height: 1.4;
  letter-spacing: 1rpx;
  flex: 1;
  margin-right: 10rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.location-icon {
  width: 30rpx;
  height: 30rpx;
}

.location-address {
  font-size: 24rpx;
  line-height: 1.4;
  letter-spacing: 1rpx;
  padding: 10rpx 15rpx;
  color: #666666;
  border-bottom: 1rpx solid #e0e0e0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  height: 30rpx;
}

.location-map {
  width: 100%;
  height: 300rpx;
  border-radius: 0 0 15rpx 15rpx;
  overflow: hidden;
  background-color: #f0f0f0;
  flex: 1;
}

.map-thumbnail {
  width: 100%;
  height: 100%;
  border-radius: 10rpx;
}

/* 自己的位置消息卡片 */
.self-message .location-card {
  background-color: #000000;
  border-color: #333333;
}

.self-message .location-name {
  color: #ffffff;
}

.self-message .location-address {
  color: #cccccc;
}

/* 对方的位置消息卡片 */
.other-message .location-card {
  background-color: #ffffff;
  border-color: #e0e0e0;
}

.other-message .location-name {
  color: #000000;
}

.other-message .location-address {
  color: #666666;
}

/* 消息时间 */
.message-time {
  display: flex;
  justify-content: center;
}

.time-text {
  font-size: 20rpx;
  color: #999999;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

/* 空消息提示 */
.empty-messages {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 400rpx;
  background-color: #fafafa;
  border-radius: 24rpx;
  border: 2rpx dashed #e0e0e0;
  padding: 60rpx 40rpx;
  margin-top: 40rpx;
}

.empty-text {
  font-size: 36rpx;
  color: #999999;
  text-align: center;
  text-transform: uppercase;
  letter-spacing: 4rpx;
  font-weight: 900;
  font-family: 'Arial Black', 'Arial Bold', sans-serif;
  line-height: 1.2;
}

/* 输入区域 */
.input-container {
  display: flex;
  align-items: center;
  padding: 20rpx 40rpx;
  background-color: #fafafa;
  border-top: 1rpx solid #f0f0f0;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.03);
  gap: 20rpx;
}

/* 语音按钮 */
.voice-button {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}

.voice-icon {
  width: 40rpx;
  height: 40rpx;
}

/* 输入框包装器 */
.input-wrapper {
  flex: 1;
  background-color: #ffffff;
  border: 1rpx solid #f0f0f0;
  border-radius: 25rpx;
  padding: 0 20rpx;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.06);
}

/* 消息输入框 */
.message-input {
  width: 100%;
  height: 80rpx;
  font-size: 28rpx;
  color: #000000;
  letter-spacing: 1rpx;
  padding: 0;
  background-color: transparent;
  border: none;
  outline: none;
}

/* 输入框占位符 */
.input-placeholder {
  color: #999999;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

/* 语音输入包装器 */
.voice-input-wrapper {
  flex: 1;
  background-color: #ffffff;
  border: 1rpx solid #f0f0f0;
  border-radius: 25rpx;
  padding: 0 20rpx;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.06);
}

/* 语音输入区域 */
.voice-input {
  width: 100%;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.2s ease;
}

.voice-input:active {
  background-color: rgba(0, 0, 0, 0.1);
  border-radius: 25rpx;
}

.voice-text {
  font-size: 28rpx;
  color: #000000;
  text-transform: uppercase;
  letter-spacing: 1rpx;
  font-weight: 900;
}

/* 录音状态指示器 */
.recording-indicator {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-left: 20rpx;
}

.recording-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background-color: #ff4757;
  animation: pulse 1.4s infinite ease-in-out;
}

.recording-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.recording-dot:nth-child(3) {
  animation-delay: 0.4s;
}

/* 脉冲动画 */
@keyframes pulse {
  0%, 100% {
    transform: scale(0.8);
    opacity: 0.7;
  }
  50% {
    transform: scale(1.2);
    opacity: 1;
  }
}

/* 多媒体按钮 */
.media-button {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}

.media-icon {
  width: 40rpx;
  height: 40rpx;
}

/* 发送按钮 */
.send-button {
  width: 120rpx;
  height: 80rpx;
  background-color: #000000;
  border-radius: 25rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.06);
  transition: all 0.4s ease;
  cursor: pointer;
}

.send-button:active {
  transform: translateY(3rpx);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  background-color: #333333;
}

/* 发送按钮文本 */
.send-text {
  font-size: 26rpx;
  font-weight: 900;
  color: #ffffff;
  text-transform: uppercase;
  letter-spacing: 2rpx;
  font-family: 'Arial Black', 'Arial Bold', sans-serif;
}

/* 多媒体选项面板容器 */
.media-options-container {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  z-index: 1000;
  animation: slideUp 0.3s ease-out forwards;
}

/* 多媒体选项面板 */
.media-options {
  display: flex;
  flex-wrap: wrap;
  gap: 60rpx;
  padding: 40rpx;
  background-color: #fafafa;
  border-top: 1rpx solid #f0f0f0;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.03);
  width: 100%;
  box-sizing: border-box;
  min-height: 200rpx;
  justify-content: center;
  align-items: center;
}

/* 从底部滑入动画 */
@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(100%);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 向下滑出动画 */
@keyframes slideDown {
  from {
    opacity: 1;
    transform: translateY(0);
  }
  to {
    opacity: 0;
    transform: translateY(100%);
  }
}

/* 多媒体选项 */
.media-option {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  cursor: pointer;
}

/* 多媒体选项图标 */
.media-option-icon {
  width: 90rpx;
  height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f5f5f5;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.08);
  border: 1rpx solid #e0e0e0;
  transition: all 0.3s ease;
}

.media-option-icon:active {
  transform: translateY(3rpx);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  background-color: #e8e8e8;
}

.media-option-icon image {
  width: 50rpx;
  height: 50rpx;
  transition: all 0.3s ease;
}

.media-option:active .media-option-icon image {
  transform: scale(0.9);
}

/* 多媒体选项文本 */
.media-option-text {
  font-size: 24rpx;
  color: #000000;
  text-transform: uppercase;
  letter-spacing: 1rpx;
  font-weight: 900;
}

/* 滚动条样式 */
.message-list::-webkit-scrollbar {
  width: 4rpx;
}

.message-list::-webkit-scrollbar-track {
  background: #f1f1f1;
  border-radius: 2rpx;
}

.message-list::-webkit-scrollbar-thumb {
  background: #000000;
  border-radius: 2rpx;
}

.message-list::-webkit-scrollbar-thumb:hover {
  background: #333333;
}
