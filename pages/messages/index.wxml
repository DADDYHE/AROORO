<!--pages/messages/index.wxml-->
<view class="message-container">
  <!-- 头部区域 -->
  <view class="page-header">
    <view class="header-content">
      <!-- 品牌标识 -->
      <view class="brand-logo">Arooro</view>
      <!-- 消息标题 - 仅在已登录时显示 -->
      <view class="page-title" wx:if="{{isLoggedIn}}">Messages</view>
    </view>
  </view>

  <!-- 未登录提示 -->
  <view wx:if="{{!isLoggedIn}}" class="login-prompt" bindtap="onPageTap">
    <image class="prompt-icon" src="/images/default-avatar.svg" mode="aspectFit"></image>
    <text class="prompt-text">请先登录</text>
  </view>
  
  <!-- 已登录用户的会话列表 -->
  <view wx:else class="conversation-container">
    <!-- 虚拟滚动会话列表 -->
    <view class="test-conversation-list">
      <!-- 空会话提示 -->
      <view wx:if="{{conversationList.length === 0}}" class="empty-conversations">
        <text class="empty-text">暂无消息</text>
      </view>
      
      <!-- 虚拟滚动列表 -->
      <scroll-view 
        wx:else
        class="virtual-scroll-view"
        scroll-y
        bindscroll="handleScroll"
        bindrefresherrefresh="onPullDownRefresh"
        refresher-enabled="true"
        refresher-threshold="100"
        refresher-default-style="black"
        refresher-background="#f8f8f8"
        style="height: {{virtualListHeight}}rpx;"
        enable-back-to-top
        show-scrollbar="false"
      >
        <!-- 占位符，用于模拟整个列表高度 -->
        <view 
          class="scroll-placeholder"
          style="height: {{conversationList.length * itemHeight}}rpx;"
        ></view>
        
        <!-- 可见的会话项 -->
        <view 
          class="virtual-list-content"
          style="transform: translateY({{startIndex * itemHeight}}rpx);"
        >
          <view wx:for="{{visibleConversations}}" wx:key="conversationID" 
                class="conversation-item {{item.unreadCount > 0 ? 'unread' : ''}}" 
                bindtap="onTestConversationTap"
                data-conversation="{{item}}">
            <!-- 头像容器 -->
            <view class="avatar-container">
              <!-- 头像 - 使用懒加载和错误处理 -->
              <image class="avatar" 
                     src="{{item.displayAvatar || '/images/default-avatar.svg'}}" 
                     mode="aspectFill"
                     bindload="onAvatarLoad"
                     binderror="onAvatarLoadError"
                     data-conversation-id="{{item.conversationID}}"></image>
              <!-- 未读消息角标 -->
          <view wx:if="{{item.unreadCount > 0}}" class="unread-badge">{{formatUnreadCount(item.unreadCount)}}</view>
            </view>
            
            <!-- 会话信息 -->
            <view class="conversation-info">
              <!-- 会话头部 -->
              <view class="conversation-header">
                <!-- 会话名称 -->
                <text class="conversation-name">{{item.displayName || '未知用户'}}</text>
                <!-- 会话时间 -->
                <text class="conversation-time">{{formatTime(item.lastMessageTime)}}</text>
              </view>
              <!-- 最后一条消息 -->
              <text class="conversation-last-message">{{formatMessagePreview(item.lastMessage)}}</text>
            </view>
          </view>
        </view>
      </scroll-view>
      
      <!-- 加载更多提示 -->
      <view wx:if="{{loadingConversations}}" class="loading-more">
        <text class="loading-text">加载中...</text>
      </view>
      
      <!-- 没有更多数据提示 -->
      <view wx:if="{{!loadingConversations && !hasMoreConversations && conversationList.length > 0}}" class="no-more-data">
        <text class="no-more-text">没有更多消息</text>
      </view>
    </view>
  </view>
</view>