/* pages/chooseIdentity/chooseIdentity.wxss */
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 40rpx 20rpx;
}

.header {
  text-align: center;
  margin-bottom: 80rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 20rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #666;
  display: block;
}

/* 现有身份和创建新身份的区块样式 */
.existing-identity-section,
.create-identity-section {
  width: 100%;
  max-width: 600rpx;
  margin-bottom: 60rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
  padding-left: 10rpx;
  border-left: 6rpx solid #1890ff;
}

.identity-list {
  display: flex;
  flex-direction: column;
  width: 100%;
  gap: 30rpx;
}

.identity-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  background-color: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
  position: relative;
}

.identity-card:hover {
  transform: translateY(-2rpx);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

/* 现有身份卡片的样式 */
.existing-identity {
  border: 2rpx solid #e8e8e8;
}

.existing-identity:hover {
  border-color: #1890ff;
}

.identity-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 30rpx;
}

.owner-icon {
  background-color: #e6f7ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 50rpx;
  color: #1890ff;
}

.sitter-icon {
  background-color: #f6ffed;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 50rpx;
  color: #52c41a;
}

.identity-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
  display: block;
}

.identity-desc {
  font-size: 24rpx;
  color: #666;
  display: block;
}

/* 身份状态指示器 */
.identity-status {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background-color: #1890ff;
  color: #fff;
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
}

.status-text {
  color: #fff;
}

.tip {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  margin-top: 40rpx;
}