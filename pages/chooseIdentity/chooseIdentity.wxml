<!--pages/chooseIdentity/chooseIdentity.wxml-->
<view class="container">
  <view class="header">
    <text class="title">选择身份</text>
    <text class="subtitle">请选择您要使用的身份</text>
  </view>

  <!-- 显示用户已有的身份列表 -->
  <view wx:if="{{existingRoles.length > 0}}" class="existing-identity-section">
    <text class="section-title">您已有的身份</text>
    <view class="identity-list">
      <view
        wx:for="{{existingRoles}}"
        wx:key="_id"
        class="identity-card existing-identity"
        bindtap="selectExistingRole"
        data-role-type="{{item.roleType}}"
      >
        <view class="identity-icon {{item.roleType === 'owner' ? 'owner-icon' : 'sitter-icon'}}"></view>
        <text class="identity-title">{{item.roleType === 'owner' ? '宠物主人' : '寄养家庭'}}</text>
        <text class="identity-desc">{{item.roleType === 'owner' ? '发布宠物寄养需求' : '接收宠物寄养订单'}}</text>
        <view class="identity-status" wx:if="{{item.isActive}}">
          <text class="status-text">当前身份</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 显示创建新身份的选项 -->
  <view wx:if="{{showCreateOptions}}" class="create-identity-section">
    <text class="section-title">创建新身份</text>
    <view class="identity-list">
      <view class="identity-card" bindtap="createOwnerIdentity">
        <view class="identity-icon owner-icon"></view>
        <text class="identity-title">宠物主人</text>
        <text class="identity-desc">发布宠物寄养需求</text>
      </view>

      <view class="identity-card" bindtap="createSitterIdentity">
        <view class="identity-icon sitter-icon"></view>
        <text class="identity-title">寄养家庭</text>
        <text class="identity-desc">接收宠物寄养订单</text>
      </view>
    </view>
  </view>

  <view class="tip">
    <text>您可以在个人中心随时切换身份</text>
  </view>
</view>