@import '../../styles/loading-animation.wxss';

/* ================================================================
   group-detail · PETLUX 橄榄绿治愈轻奢主题
   全量换肤：橄榄绿品牌色 + 纯白卡片 + 令牌阴影 + 药丸按钮
   ================================================================ */

.tuan-detail {
  padding-bottom: 128rpx;
  background: var(--background-color);
  min-height: 100vh;
}

.loading-dot:nth-child(2) {
}

.loading-dot:nth-child(3) {
}

.empty-page {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100vh;
  color: var(--text-secondary);
  font-size: 28rpx;
  letter-spacing: 2rpx;
}

/* ===== 标题区 ===== */
.detail-title-area {
  background: var(--card-color);
  padding: 32rpx 32rpx 24rpx;
}

.detail-title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  letter-spacing: 1rpx;
  line-height: 1.4;
}

.detail-desc-area {
  background: var(--card-color);
  padding: 24rpx 32rpx;
  margin-top: 16rpx;
}

.detail-desc {
  font-size: 26rpx;
  font-weight: 400;
  color: var(--text-secondary);
  display: block;
  line-height: 1.8;
  letter-spacing: 1rpx;
}

/* ===== 区块标题 ===== */
.detail-section {
  padding: 32rpx 32rpx 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: 2rpx;
}

/* ===== 商品列表 ===== */
.product-list {
  padding: 0 32rpx;
}

.product-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: var(--card-color);
  border-radius: var(--border-radius-md);
  margin-bottom: 24rpx;
  gap: 24rpx;
  box-shadow: var(--zy-shadow-xs);
  border: 1rpx solid var(--border-color);
}

.product-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--border-radius-sm);
  flex-shrink: 0;
  background: linear-gradient(135deg, var(--background-color) 0%, var(--surface-tint) 100%);
}

.product-info {
  flex: 1;
  min-width: 0;
}

.product-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  letter-spacing: 1rpx;
}

.product-price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.product-price-wrap {
  display: flex;
  align-items: baseline;
}

.product-price-symbol {
  font-size: 22rpx;
  color: var(--primary-color);
  font-weight: 600;
}

.product-price {
  font-size: 36rpx;
  color: var(--primary-color);
  font-weight: 600;
}

.product-original {
  font-size: 22rpx;
  color: var(--text-tertiary);
  text-decoration: line-through;
  margin-left: 8rpx;
}

.product-buy-btn {
  background: var(--gradient-primary);
  color: #FAFAF6;
  font-size: 24rpx;
  padding: 16rpx 24rpx;
  border-radius: var(--border-radius-pill);
  font-weight: 600;
  box-shadow: var(--shadow-glow-primary-btn);
}

.product-stock {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--text-secondary);
  margin-top: 8rpx;
  display: block;
}

.product-library-link {
  font-size: 22rpx;
  color: var(--primary-color);
  margin-top: 8rpx;
  display: block;
}

/* ===== 详情图集 ===== */
.detail-images {
  padding: 24rpx 32rpx;
}

.detail-img {
  width: 100%;
  display: block;
  border-radius: var(--border-radius-sm);
  margin-bottom: 16rpx;
  background: linear-gradient(135deg, var(--background-color) 0%, var(--surface-tint) 100%);
}

.detail-img:last-child {
  margin-bottom: 0;
}

/* ===== 底部固定操作栏 ===== */
.detail-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--card-color);
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: var(--zy-shadow-float-tabbar);
  z-index: 10;
  border-top: 1rpx solid var(--divider-color);
}

.bar-actions {
  display: flex;
  gap: 24rpx;
  flex-shrink: 0;
}

.bar-action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  position: relative;
}

.contact-btn {
  display: flex !important;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  position: relative;
  padding: 0 !important;
  margin: 0 !important;
  background: transparent !important;
  border: none !important;
  line-height: normal !important;
  min-width: 0 !important;
  width: auto !important;
  font-size: inherit !important;
  box-sizing: border-box;
}

.contact-btn::after {
  border: none !important;
}

.bar-action-icon-img {
  width: 40rpx;
  height: 40rpx;
}

.bar-action-text {
  font-size: 18rpx;
  color: var(--text-tertiary);
  letter-spacing: 1rpx;
}

.cart-badge {
  position: absolute;
  top: -8rpx;
  right: -16rpx;
  min-width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  text-align: center;
  background: var(--error-color);
  color: #FAFAF6;
  font-size: 18rpx;
  border-radius: var(--border-radius-pill);
  padding: 0 8rpx;
}

.footer-btn {
  flex: 1;
  min-width: 0;
  background: var(--gradient-primary);
  color: #FAFAF6;
  font-size: 30rpx;
  font-weight: 600;
  padding: 24rpx 0;
  border-radius: var(--border-radius-pill);
  text-align: center;
  box-shadow: var(--shadow-glow-primary-btn);
}

/* ===== SKU 选择弹层（参考设计稿风格） ===== */
.sku-popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
  opacity: 0;
  visibility: hidden;
}

.sku-popup-mask.show {
  opacity: 1;
  visibility: visible;
}

.sku-popup {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 201;
  background: var(--card-color);
  border-radius: 48rpx 48rpx 0 0;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
  overflow: visible;
  padding-top: 28rpx;
}

.sku-popup::before {
  content: '';
  position: absolute;
  top: -28rpx;
  left: 0;
  right: 0;
  height: 76rpx;
  background: #9ED44A;
  border-radius: 48rpx 48rpx 0 0;
  z-index: -1;
}

.sku-popup.show {
}

.sku-popup-brand-bar {
  position: absolute;
  top: -28rpx;
  left: 0;
  right: 0;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
}

.sku-popup-brand-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: 1rpx;
  line-height: 1;
  position: relative;
  top: -7rpx;
}

.sku-popup-close-btn {
  position: absolute;
  top: 20rpx;
  right: 24rpx;
  z-index: 10;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.35);
  border-radius: 50%;
  backdrop-filter: blur(4px);
}

.sku-popup-image-wrap {
  width: 100%;
  height: 420rpx;
  flex-shrink: 0;
  overflow: hidden;
}

.sku-popup-image {
  width: 100%;
  height: 100%;
}

.sku-popup-body {
  flex: 1;
  min-height: 0;
}

.sku-popup-body-inner {
  padding: 28rpx 32rpx 16rpx;
}

/* 商品信息 */
.sku-product-info {
  margin-bottom: 28rpx;
}

.sku-product-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  line-height: 1.3;
  margin-bottom: 12rpx;
}

.sku-product-meta {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.sku-product-price {
  font-size: 40rpx;
  color: var(--primary-color);
  font-weight: 600;
  letter-spacing: 1rpx;
}

.sku-product-stock {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--text-secondary);
}

.sku-product-selected {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 规格分组 */
.sku-spec-section {
  margin-bottom: 28rpx;
}

.sku-spec-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  margin-bottom: 16rpx;
  letter-spacing: 1rpx;
}

.sku-spec-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.sku-spec-option {
  padding: 14rpx 36rpx;
  border-radius: 40rpx;
  background: var(--divider-color);
  border: 2rpx solid transparent;
}

.sku-spec-option.selected {
  background: var(--primary-light);
  border-color: var(--primary-color);
}

.sku-spec-option.disabled {
  opacity: 0.35;
  pointer-events: none;
}

.sku-spec-option.selected .sku-spec-option-text {
  color: var(--primary-color);
  font-weight: 600;
}

.sku-spec-option-text {
  font-size: 26rpx;
  font-weight: 400;
  color: var(--text-primary);
}

/* 数量 */
.sku-quantity-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-top: 1rpx solid var(--divider-color);
}

.sku-quantity-section .sku-spec-label {
  margin-bottom: 0;
}

.sku-quantity-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.sku-qty-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--divider-color);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--text-primary);
}

.sku-qty-btn.disabled {
  opacity: 0.35;
}

.sku-qty-value {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 600;
  min-width: 48rpx;
  text-align: center;
}

/* 底部按钮 */
.sku-popup-footer {
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
}

.sku-confirm-btn {
  width: 100%;
  padding: 26rpx 0;
  background: var(--gradient-primary);
  border-radius: 48rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #FAFAF6;
  letter-spacing: 2rpx;
  box-shadow: var(--shadow-glow-primary-btn);
}

.sku-confirm-btn.disabled {
  background: var(--text-tertiary);
  box-shadow: none;
  pointer-events: none;
}
