@import '../../styles/loading-animation.wxss';

/* ================================================================
   group-detail · AROORO 暖陶土棕团购详情页 — Haute-Luxury Editorial v2
   板块色：陶土棕家族 --tuan-primary / --groupbuy-gradient
   衬线大标题 + 发丝描边分节 + 金色点缀 + 编辑式留白
   Skyline 合规：无 :active / backdrop-filter / !important / text-shadow
   ================================================================ */

/* ===== 入场动画 ===== */
@keyframes fadeInUp {
  0% {
    opacity: 0;
    transform: translateY(24rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeIn {
  0% { opacity: 0; }
  100% { opacity: 1; }
}

.tuan-detail {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  background-color: var(--background-color);
  background-image: var(--zy-paper-noise);
  background-repeat: repeat;
  min-height: 100vh;
}

.loading-dot:nth-child(2) {
}

.loading-dot:nth-child(3) {
}

.empty-page {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100vh;
  color: var(--text-tertiary);
  font-size: 26rpx;
  letter-spacing: 0.12em;
  font-family: var(--font-sans);
}

/* ===== 标题区（编辑式：衬线大标 + 顶部留白） ===== */
.detail-title-area {
  background: var(--card-color);
  padding: 48rpx var(--page-padding) 32rpx;
  border-bottom: 1rpx solid var(--hairline);
  animation-name: fadeInUp;
  animation-duration: 420ms;
  animation-timing-function: cubic-bezier(0.16,1,0.3,1);
  animation-fill-mode: forwards;
}

.detail-title {
  font-size: 44rpx;
  font-weight: 500;
  color: var(--text-primary);
  display: block;
  letter-spacing: 0.01em;
  line-height: 1.3;
  font-family: var(--font-serif);
}

.detail-desc-area {
  background: var(--card-color);
  padding: 32rpx var(--page-padding);
  margin-top: 1rpx;
  animation-name: fadeInUp;
  animation-duration: 420ms;
  animation-timing-function: cubic-bezier(0.16,1,0.3,1);
  animation-fill-mode: forwards;
  animation-delay: 40ms;
}

.detail-desc {
  font-size: 28rpx;
  font-weight: 400;
  color: var(--text-secondary);
  display: block;
  line-height: 1.85;
  letter-spacing: 0.02em;
  font-family: var(--font-sans);
}

/* ===== 区块标题（编辑式：金色发丝线 + 宽字距） ===== */
.detail-section {
  padding: 48rpx var(--page-padding) 24rpx;
}

.section-title {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-tertiary);
  display: flex;
  align-items: center;
  gap: 16rpx;
  letter-spacing: 0.20em;
  font-family: var(--font-sans);
}

.label-accent {
  width: 32rpx;
  height: 2rpx;
  background: var(--accent-color);
  flex-shrink: 0;
}

/* ===== 商品列表（编辑式卡片） ===== */
.product-list {
  padding: 0 var(--page-padding);
}

.product-card {
  display: flex;
  align-items: center;
  padding: 28rpx;
  background: var(--card-color);
  border-radius: var(--zy-radius-lg);
  margin-bottom: 20rpx;
  gap: 24rpx;
  border: 1rpx solid var(--hairline);
  animation-name: fadeInUp;
  animation-duration: 420ms;
  animation-timing-function: cubic-bezier(0.19,1,0.22,1);
  animation-fill-mode: forwards;
}

.product-card:nth-child(1) { animation-delay: 40ms; }
.product-card:nth-child(2) { animation-delay: 70ms; }
.product-card:nth-child(3) { animation-delay: 110ms; }
.product-card:nth-child(4) { animation-delay: 160ms; }
.product-card:nth-child(5) { animation-delay: 220ms; }

.product-card--pressed {
  opacity: 0.7;
  transform: scale(0.98);
}

.product-img {
  width: 180rpx;
  height: 180rpx;
  border-radius: var(--zy-radius-md);
  flex-shrink: 0;
  background: var(--card-cream);
}

.product-info {
  flex: 1;
  min-width: 0;
}

.product-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  letter-spacing: 0.02em;
  font-family: var(--font-serif);
}

.product-price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.product-price-wrap {
  display: flex;
  align-items: baseline;
}

.product-price-symbol {
  font-size: 22rpx;
  color: var(--tuan-primary);
  font-weight: 500;
  font-family: var(--font-sans);
}

.product-price {
  font-size: 38rpx;
  color: var(--tuan-primary);
  font-weight: 500;
  font-family: var(--font-sans);
  letter-spacing: 0.01em;
}

.product-original {
  font-size: 22rpx;
  color: var(--text-tertiary);
  text-decoration: line-through;
  margin-left: 8rpx;
}

.product-buy-btn {
  background: var(--groupbuy-gradient);
  color: var(--text-on-primary);
  font-size: 24rpx;
  padding: 14rpx 28rpx;
  border-radius: var(--zy-radius-xs);
  font-weight: 500;
  box-shadow: var(--shadow-glow-groupbuy);
  letter-spacing: 0.12em;
  font-family: var(--font-sans);
  transition: transform var(--dur-fast) var(--ease-refined),
              opacity var(--dur-fast) var(--ease-refined);
}

.product-buy-btn--pressed {
  opacity: 0.85;
  transform: scale(0.96);
}

.product-stock {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--text-tertiary);
  margin-top: 10rpx;
  display: block;
  letter-spacing: 0.04em;
  font-family: var(--font-sans);
}

.product-library-link {
  font-size: 22rpx;
  color: var(--tuan-primary);
  margin-top: 8rpx;
  display: block;
  letter-spacing: 0.04em;
  font-family: var(--font-sans);
}

/* ===== 详情图集（编辑式留白） ===== */
.detail-images {
  padding: 32rpx var(--page-padding);
  animation-name: fadeInUp;
  animation-duration: 420ms;
  animation-timing-function: cubic-bezier(0.16,1,0.3,1);
  animation-fill-mode: forwards;
}

.detail-img {
  width: 100%;
  display: block;
  border-radius: var(--zy-radius-md);
  margin-bottom: 24rpx;
  background: var(--card-cream);
}

.detail-img:last-child {
  margin-bottom: 0;
}

/* ===== 底部固定操作栏 ===== */
.detail-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--glass-bg-95);
  padding: 20rpx var(--page-padding);
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 24rpx;
  z-index: 10;
  border-top: 1rpx solid var(--hairline);
}

.bar-actions {
  display: flex;
  gap: 32rpx;
  flex-shrink: 0;
}

.bar-action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  position: relative;
}

.contact-wrap {
  position: relative;
  transition: opacity var(--dur-fast) var(--ease-refined);
}

.contact-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  background: transparent;
  border: none;
  margin: 0;
  padding: 0;
  line-height: normal;
}

.contact-overlay::after {
  border: none;
}

.contact-wrap--pressed {
  opacity: 0.6;
}

.bar-action-icon-img {
  width: 42rpx;
  height: 42rpx;
}

.bar-action-text {
  font-size: 18rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.12em;
  font-family: var(--font-sans);
}

.cart-badge {
  position: absolute;
  top: -8rpx;
  right: -16rpx;
  min-width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  text-align: center;
  background: var(--brand-red);
  color: var(--text-inverse);
  font-size: 18rpx;
  border-radius: 14rpx;
  padding: 0 6rpx;
  font-weight: 500;
}

.footer-btn {
  flex: 1;
  min-width: 0;
  background: var(--groupbuy-gradient);
  color: var(--text-on-primary);
  font-size: 30rpx;
  font-weight: 500;
  padding: 24rpx 0;
  border-radius: var(--zy-radius-xs);
  text-align: center;
  box-shadow: var(--shadow-glow-groupbuy);
  letter-spacing: 0.15em;
  font-family: var(--font-sans);
  transition: transform var(--dur-fast) var(--ease-refined),
              opacity var(--dur-fast) var(--ease-refined);
}

.footer-btn--pressed {
  opacity: 0.88;
  transform: scale(0.98);
}

/* ===== SKU 选择弹层 ===== */
.sku-popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--overlay-color);
  z-index: 200;
  opacity: 0;
  visibility: hidden;
  transition: opacity var(--dur-base) var(--ease-luxury);
}

.sku-popup-mask.show {
  opacity: 1;
  visibility: visible;
}

.sku-popup {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 201;
  background: var(--card-color);
  border-radius: 32rpx 32rpx 0 0;
  height: 85vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding-top: 0;
  transform: translateY(100vh);
  transition: transform var(--dur-slow) var(--ease-silk);
  pointer-events: none;
}

.sku-popup.show {
  transform: translateY(0);
  pointer-events: auto;
}

/* 顶部品牌条：留白 · 精炼字体 · 植物线描 */
.sku-popup-brand-bar {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: var(--card-cream);
  flex-shrink: 0;
  padding: 26rpx 40rpx 22rpx;
  gap: 14rpx;
}

.brand-gold-thread {
  width: 48rpx;
  height: 1rpx;
  background: var(--tuan-primary);
  opacity: 0.3;
  flex-shrink: 0;
}

.sku-popup-brand-text {
  font-size: 19rpx;
  font-weight: 300;
  color: var(--tuan-primary);
  letter-spacing: 0.32em;
  line-height: 1;
  font-family: var(--font-sans);
  white-space: nowrap;
  opacity: 0.85;
}

.brand-separator {
  width: 240rpx;
  height: 16rpx;
}

.sku-popup-close-btn {
  position: absolute;
  top: 96rpx;
  right: 24rpx;
  z-index: 10;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--card-cream);
  border-radius: 50%;
  border: 1rpx solid var(--hairline);
  transition: transform var(--dur-fast) var(--ease-refined);
}

.sku-popup-close-btn--pressed {
  opacity: 0.7;
  transform: scale(0.92);
}

.sku-popup-close-icon {
  width: 32rpx;
  height: 32rpx;
}

.sku-popup-image-wrap {
  width: 100%;
  height: 400rpx;
  flex-shrink: 0;
  overflow: hidden;
  position: relative;
  background: var(--card-cream);
}

.sku-popup-image {
  width: 100%;
  height: 100%;
}

.sku-popup-body {
  flex: 1;
  min-height: 0;
}

.sku-popup-body-inner {
  padding: 32rpx var(--page-padding) 16rpx;
}

/* 商品信息 */
.sku-product-info {
  margin-bottom: 32rpx;
}

.sku-product-name {
  font-size: 36rpx;
  font-weight: 500;
  color: var(--text-primary);
  display: block;
  line-height: 1.3;
  margin-bottom: 16rpx;
  letter-spacing: 0.01em;
  font-family: var(--font-serif);
}

.sku-product-meta {
  display: flex;
  align-items: baseline;
  gap: 20rpx;
  margin-bottom: 8rpx;
}

.sku-product-price {
  font-size: 44rpx;
  color: var(--tuan-primary);
  font-weight: 500;
  letter-spacing: 0.01em;
  font-family: var(--font-sans);
  line-height: 1;
}

.sku-product-stock {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--text-tertiary);
  letter-spacing: 0.04em;
  font-family: var(--font-sans);
}

.sku-product-selected {
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 0.04em;
  font-family: var(--font-sans);
}

/* 规格分组 */
.sku-spec-section {
  margin-bottom: 32rpx;
}

.sku-spec-label {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-tertiary);
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
  letter-spacing: 0.15em;
  font-family: var(--font-sans);
}

.sku-spec-label .label-accent {
  width: 24rpx;
}

.sku-spec-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.sku-spec-option {
  padding: 16rpx 36rpx;
  border-radius: var(--zy-radius-xs);
  background: var(--tuan-tint);
  border: 1rpx solid transparent;
  transition: transform var(--dur-fast) var(--ease-refined),
              background-color var(--dur-fast) var(--ease-refined),
              border-color var(--dur-fast) var(--ease-refined);
}

.sku-spec-option.selected {
  background: var(--card-color);
  border-color: var(--tuan-primary);
}

.sku-spec-option.disabled {
  opacity: 0.35;
  pointer-events: none;
}

.sku-spec-option--pressed {
  transform: scale(0.96);
}

.sku-spec-option.selected .sku-spec-option-text {
  color: var(--tuan-primary);
  font-weight: 500;
}

.sku-spec-option-text {
  font-size: 26rpx;
  font-weight: 400;
  color: var(--text-secondary);
  letter-spacing: 0.02em;
  font-family: var(--font-sans);
}

/* 数量 */
.sku-quantity-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-top: 1rpx solid var(--hairline);
}

.sku-quantity-section .sku-spec-label {
  margin-bottom: 0;
}

.sku-quantity-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.sku-qty-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--tuan-tint);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 400;
  border: 1rpx solid var(--hairline);
  transition: transform var(--dur-fast) var(--ease-refined),
              opacity var(--dur-fast) var(--ease-refined);
}

.sku-qty-btn.disabled {
  opacity: 0.3;
}

.sku-qty-btn--pressed {
  transform: scale(0.9);
  opacity: 0.7;
}

.sku-qty-value {
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 500;
  min-width: 56rpx;
  text-align: center;
  font-family: var(--font-sans);
}

/* 底部按钮 */
.sku-popup-footer {
  padding: 20rpx var(--page-padding);
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
  border-top: 1rpx solid var(--hairline);
  background: var(--card-color);
}

.sku-confirm-btn {
  width: 100%;
  padding: 26rpx 0;
  background: var(--groupbuy-gradient);
  border-radius: var(--zy-radius-xs);
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-on-primary);
  letter-spacing: 0.20em;
  box-shadow: var(--shadow-glow-groupbuy);
  font-family: var(--font-sans);
  transition: transform var(--dur-fast) var(--ease-refined),
              opacity var(--dur-fast) var(--ease-refined);
}

.sku-confirm-btn--pressed {
  opacity: 0.88;
  transform: scale(0.98);
}

.sku-confirm-btn.disabled {
  background: var(--text-tertiary);
  box-shadow: none;
  opacity: 0.5;
}
