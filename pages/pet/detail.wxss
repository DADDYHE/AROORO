/* 自定义导航栏 */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: calc(var(--status-bar-height) + 100rpx);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--status-bar-height) 30rpx 0;
  box-sizing: border-box;
  z-index: 999;
  background-color: white;
  color: #333;
}

.nav-left, .nav-right {
  width: 80rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

/* 回退按钮 */
.back-icon {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #333;
  border-width: 2rpx 0 0 2rpx;
  transform: rotate(-45deg);
}

.pet-detail-container {
  min-height: 100vh;
  background-color: #f7f8fa;
  padding-bottom: 40rpx;
  padding-top: 0rpx;
  padding-left: 0rpx;
  padding-right: 0rpx;
  margin: 0;
}

.content-area {
  padding-left: 30rpx;
  padding-right: 30rpx;
}

/* 头像区域 */
.avatar-container {
  position: relative;
  width: 100%;
  height: 533.33rpx; /* 9:16 比例 */
  overflow: hidden;
  background: #000000; /* 黑色背景提升高级感 */
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.4);
  margin: 0;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.3s ease;
  position: relative;
  left: 0;
  right: 0;
  padding: 0;
}

.avatar-container:active {
  transform: scale(0.98);
}

.pet-avatar {
  width: 100%;
  height: 100%;
  opacity: 0.95;
  transition: opacity 0.3s ease;
  border-radius: 4rpx;
}

.pet-avatar:hover {
  opacity: 1;
  box-shadow: 0 0 20rpx rgba(255, 255, 255, 0.5);
}

.avatar-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding: 40rpx;
  text-align: center;
}

.plus-icon {
  width: 100rpx;
  height: 100rpx;
  border: 3rpx solid #969799;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 70rpx;
  color: #969799;
  font-weight: 300;
  line-height: 1;
}

.avatar-placeholder-text {
  font-size: 28rpx;
  color: #969799;
  line-height: 1.5;
}

/* 宠物基本信息区域 */
.profile-section {
  position: relative;
  background-color: #ffffff;
  margin: 0 30rpx 30rpx;
  padding: 30rpx;
  border-radius: 24rpx;
  text-align: center;
  z-index: 1;
  margin-top: 80rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.name-section {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  margin-bottom: 15rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #323233;
  letter-spacing: 0.5rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #969799;
  line-height: 1.5;
  text-align: center;
  display: block;
}

.edit-icon {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background-color: #ffffff;
  color: #1989fa !important;
  border: 2rpx solid #1989fa;
  font-size: 22rpx;
  transition: all 0.3s ease;
  position: absolute;
  bottom: 0rpx;
  right: 0rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
}

.edit-icon:active {
  background-color: #f5f7fa;
  transform: translateY(1rpx);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.1);
}

/* 编辑弹窗样式 */
.edit-form {
  padding: 30rpx;
}

.form-item {
  margin-bottom: 0rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 120rpx;
  border-bottom: 1rpx solid #f5f7fa;
}

.form-item:last-child {
  border-bottom: none;
}

.avatar-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.label {
  font-size: 28rpx;
  color: #323233;
  display: block;
}

.avatar-upload-container {
  display: flex;
  align-items: center;
  gap: 20rpx;
  position: relative;
  cursor: pointer;
}

.avatar-thumbnail {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  border: 2rpx solid #e5e7eb;
  overflow: hidden;
  object-fit: cover;
}

.avatar-upload-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  background-color: rgba(0, 0, 0, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.avatar-upload-container:active .avatar-upload-overlay {
  opacity: 1;
}

.field-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
}

.arrow-icon {
  flex-shrink: 0;
  margin-left: 10rpx;
}

.field-value {
  flex: 1;
  font-size: 28rpx;
  color: #323233;
  text-align: right;
}

/* 保留原有的上传按钮样式，以防需要 */
.avatar-upload-btn {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 20rpx;
  background-color: #f5f7fa;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #1989fa;
  transition: background-color 0.2s;
}

.avatar-upload-btn:active {
  background-color: #e8f4fd;
}

.upload-text {
  font-size: 28rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #969799;
  display: block;
}

/* 信息卡片样式 */
.card {
  margin: 0 30rpx 20rpx;
  padding: 20rpx 30rpx;
  background-color: transparent;
  border-radius: 16rpx;
  transition: transform 0.2s ease;
}

.card:active {
  transform: translateY(2rpx);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #323233;
  margin-bottom: 20rpx;
  padding-bottom: 15rpx;
  border-bottom: 2rpx solid #f0f0f0;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.section-title::before {
  content: '';
  width: 6rpx;
  height: 24rpx;
  background: linear-gradient(to bottom, #667eea, #764ba2);
  border-radius: 3rpx;
}

/* 宠物卡片样式 */
.pet-card {
  width: 300rpx;
  height: 400rpx;
  margin: 0 auto 20rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 8rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  transition: transform 0.3s ease;
}

.pet-card:hover {
  transform: scale(1.02);
}

/* 更新宠物档案按钮样式 */
.update-profile-section {
  margin: 0 30rpx 40rpx;
  position: relative;
  z-index: 1000;
}

.update-profile-section .van-button {
  margin-bottom: 0 !important;
  border-radius: 16rpx !important;
  font-size: 32rpx;
  font-weight: bold !important;
  padding: 30rpx 0 !important;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  position: relative;
  z-index: 1000;
}

/* 按钮样式优化 */
.van-button {
  margin-bottom: 15rpx !important;
  border-radius: 12rpx !important;
  font-weight: 500 !important;
}

.van-button--primary {
  background-color: #000000 !important;
  border: none !important;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
}

.van-button--primary:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

.van-button--default {
  border: 1rpx solid #e5e7eb !important;
  background-color: #f8f9fa !important;
  color: #666 !important;
}

/* 宠物详细信息区域样式 */
.pet-info-group {
  background-color: transparent !important;
  margin: 0 30rpx 30rpx !important;
  border-radius: 24rpx !important;
  overflow: hidden !important;
}

/* 列表项样式优化 */
.van-cell {
  font-size: 28rpx;
  padding: 25rpx 0 !important;
  border-bottom: 1rpx solid #f5f7fa;
  min-height: auto !important;
  background-color: transparent !important;
}

.van-cell:last-child {
  border-bottom: none;
}

.van-cell__title {
  color: #606266 !important;
  font-weight: 500 !important;
  min-width: 140rpx;
}

.van-cell__value {
  color: #323233 !important;
  font-weight: normal !important;
  text-align: right !important;
  flex: 1;
}