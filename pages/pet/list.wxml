<!-- 宠物列表页面 - 与详情页面风格一致 -->
<view class="page-container">
  <!-- 头部区域 -->
  <view class="page-header">
    <view class="header-content">
      <!-- 品牌标识 -->
      <view class="brand-logo">Arooro</view>
      <view class="page-title-container">
      <van-icon name="/images/paw-print.png" size="18" />
      <text class="page-title">我的宠物</text>
    </view>
    </view>
  </view>

  <!-- 主要内容 -->
  <view class="page-content">
    <!-- 宠物列表 -->
    <view class="pet-list-section" wx:if="{{petProfiles.length > 0}}">
      <view class="section-header">
        <view class="title-group">
          <text class="section-title">已添加的宠物</text>
          <text class="pet-count">{{petProfiles.length}} 个</text>
        </view>
        <view class="section-actions">
          <van-button 
            wx:if="{{!isManaging}}" 
            size="small" 
            type="default" 
            bindtap="toggleManageMode"
            class="manage-button"
          >
            管理
          </van-button>
          <view wx:else class="manage-actions">
            <van-button 
              size="small" 
              type="default" 
              bindtap="toggleManageMode"
              class="cancel-button"
            >
              取消
            </van-button>
            <van-button 
              size="small" 
              type="danger" 
              bindtap="deleteSelectedPets"
              class="delete-button"
              disabled="{{!hasSelectedPets}}"
            >
              删除
            </van-button>
          </view>
        </view>
      </view>
      
      <view class="pet-list" bindtouchstart="onListTouchStart" bindtouchmove="onListTouchMove" bindtouchend="onListTouchEnd">
        <view class="pet-item {{isManaging ? 'manage-mode' : ''}}" wx:for="{{petProfiles}}" wx:key="id" bindtouchstart="onItemTouchStart" bindtouchend="onItemTouchEnd" data-id="{{item.id}}" data-index="{{index}}">
          <image class="pet-avatar" src="{{item.avatarUrl || '/images/default-pet-avatar.png'}}" mode="aspectFill" binderror="onPetAvatarLoadError" data-index="{{index}}" />
          <view class="pet-info">
            <text class="pet-name">{{item.name}}</text>
            <view class="pet-details">
              <text class="pet-type">{{item.breed || item.type}}</text>
              <text class="pet-age">{{item.age}} 岁</text>
            </view>
          </view>
          <view wx:if="{{isManaging}}" class="pet-selector">
            <view class="selector-circle {{item.checked ? 'selected' : ''}}">
              <van-icon wx:if="{{item.checked}}" name="success" size="16" color="#ffffff" />
            </view>
          </view>
          <van-icon wx:if="{{!isManaging}}" name="arrow" size="18" color="#c8c9cc" />
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:else>
      <van-empty description="还没有添加宠物" image="default" />
      <text class="empty-desc">点击下方按钮添加您的第一个宠物吧</text>
    </view>

    <!-- 创建新宠物档案按钮 -->
    <view class="update-profile-section" wx:if="{{!isManaging}}">
      <van-button 
        type="primary" 
        block 
        bindtap="createNewPet"
      >
        创建新的宠物档案
      </van-button>
    </view>
  </view>
</view>
