.container {
  min-height: 100vh;
  background-color: #f7f8fa;
  padding-bottom: 40rpx;
}

/* 头像区域 */
.avatar-container {
  position: relative;
  width: 100%;
  height: 533.33rpx; /* 9:16 比例 */
  overflow: hidden;
  background: #000000; /* 黑色背景提升高级感 */
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.4);
  margin-bottom: 0;
  z-index: 2;
  border: 4rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.3s ease;
  margin-top: 20rpx;
}

.avatar-container:active {
  transform: scale(0.98);
}

.pet-avatar {
  width: 100%;
  height: 100%;
  opacity: 0.95;
  transition: opacity 0.3s ease;
  border-radius: 4rpx;
}

.pet-avatar:hover {
  opacity: 1;
  box-shadow: 0 0 20rpx rgba(255, 255, 255, 0.5);
}

.avatar-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding: 40rpx;
  text-align: center;
}

.plus-icon {
  width: 100rpx;
  height: 100rpx;
  border: 3rpx solid #969799;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 70rpx;
  color: #969799;
  font-weight: 300;
  line-height: 1;
}

.avatar-placeholder-text {
  font-size: 28rpx;
  color: #969799;
  line-height: 1.5;
}

/* 基本信息区域 */
.basic-info-section {
  margin: 30rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

/* 健康信息区域 */
.health-info-section {
  margin: 0 30rpx 30rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

/* 生活习惯区域 */
.life-info-section {
  margin: 0 30rpx 30rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

/* 紧急联系人区域 */
.emergency-info-section {
  margin: 0 30rpx 30rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

/* 区域标题 */
.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #323233;
  margin-bottom: 0;
  padding: 25rpx 30rpx;
  background-color: #f8f9fa;
  border-bottom: 1rpx solid #f5f7fa;
}

/* 表单字段样式 */
.van-field {
  padding: 25rpx 30rpx !important;
  font-size: 28rpx;
}

.van-field__label {
  color: #606266 !important;
  font-weight: 500 !important;
  min-width: 140rpx;
}

.van-field__control {
  color: #323233 !important;
  font-weight: normal !important;
}

/* 文本域样式优化 */
.van-field__control--textarea {
  min-height: 120rpx !important;
  line-height: 1.5 !important;
  padding-top: 10rpx !important;
  padding-bottom: 10rpx !important;
}

/* 健康信息区域和紧急联系人区域的文本域样式 */
.health-info-section .van-field__control--textarea,
.emergency-info-section .van-field__control--textarea {
  min-height: 60rpx !important;
  max-height: 300rpx !important;
  font-size: 28rpx;
  line-height: 1.6 !important;
  color: #323233;
  overflow-y: auto;
}

/* 生活习惯区域的文本域样式 */
.life-info-section .van-field {
  padding: 30rpx !important;
}

.life-info-section .van-field__control--textarea {
  min-height: 100rpx !important;
  max-height: 400rpx !important;
  font-size: 28rpx;
  line-height: 1.6 !important;
  color: #323233;
  overflow-y: auto;
}

/* 选择框样式 */
.van-cell {
  padding: 25rpx 30rpx !important;
  font-size: 28rpx;
  border-bottom: 1rpx solid #f5f7fa;
  min-height: auto !important;
}

.van-cell:last-child {
  border-bottom: none;
}

.van-cell__title {
  color: #606266 !important;
  font-weight: 500 !important;
  min-width: 140rpx;
}

.van-radio-group {
  display: flex;
  flex-direction: row;
  gap: 40rpx;
}

.van-radio {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #323233;
}

/* 保存按钮 */
.save-section {
  margin: 0 30rpx 40rpx;
}

.save-section .van-button {
  margin-bottom: 0 !important;
  border-radius: 16rpx !important;
  font-size: 32rpx;
  font-weight: bold !important;
  padding: 30rpx 0 !important;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

/* 按钮样式优化 */
.van-button--primary {
  background-color: #000000 !important;
  border: none !important;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
}

.van-button--primary:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}
