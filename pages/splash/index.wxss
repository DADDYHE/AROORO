/* 启动首屏海报 · 独立全屏页（Skyline 安全） */
.splash {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1;
  /* 单值底色（规避多背景简写被丢弃）；展示即覆盖无淡入，杜绝背后首页闪现 */
  background: #0F2410;
  display: flex;
  align-items: center;
  justify-content: center;
}

.splash--closing {
  animation-name: zy-fade-out;
  animation-duration: 280ms;
  animation-timing-function: cubic-bezier(0.4, 0, 1, 1);
  animation-fill-mode: forwards;
}

.splash--reduce.splash--closing {
  opacity: 0;
}

.splash__img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: block;
  opacity: 0;
  animation-name: zy-hero-settle;
  animation-duration: 900ms;
  animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  animation-fill-mode: forwards;
}

.splash__hint {
  position: fixed;
  right: 32rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom, 0));
  padding: 12rpx 28rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.36);
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.22);
  letter-spacing: 0.08em;
  opacity: 0;
  animation-name: zy-fade-in;
  animation-duration: 600ms;
  animation-timing-function: ease;
  animation-fill-mode: forwards;
  animation-delay: 700ms;
}

