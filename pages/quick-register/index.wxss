/* 活动报名 - 艺术画廊展陈风格 */

.quick-register-container {
  min-height: 100vh;
  background-color: var(--background-color);
  padding: 0 0 180rpx;
}

/* 顶部画廊区 */
.gallery-header {
  padding: 0;
  position: relative;
  overflow: hidden;
  background: var(--card-color);
  animation: fadeUp 0.6s ease-out;
  padding-bottom: 20rpx;
}

.brand-block {
  padding: 80rpx 48rpx 64rpx;
  position: relative;
}

.brand-block::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, rgba(78, 205, 196, 0.15) 0%, transparent 70%);
  pointer-events: none;
}

.brand-accent-bar {
  position: absolute;
  top: 0;
  left: 48rpx;
  width: 48rpx;
  height: 6rpx;
  background: linear-gradient(90deg, var(--activity-primary) 0%, var(--activity-primary-mid) 100%);
  border-radius: 0 0 4rpx 4rpx;
  animation: slideDown 0.5s ease-out;
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.brand-main {
  position: relative;
  margin-bottom: 24rpx;
}

.brand-text {
  font-size: 64rpx;
  font-weight: 300;
  color: var(--text-primary);
  letter-spacing: 12rpx;
  display: block;
  line-height: 1;
  position: relative;
}

.brand-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.brand-meta-line {
  width: 40rpx;
  height: 2rpx;
  background: var(--gray-200);
  position: relative;
}

.brand-meta-line::after {
  content: '';
  position: absolute;
  top: 50%;
  right: -4rpx;
  transform: translateY(-50%);
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: var(--activity-primary);
}

.brand-subtitle {
  font-size: 22rpx;
  color: var(--text-secondary);
  letter-spacing: 8rpx;
  font-weight: 400;
}

/* 活动列表 - 画廊展区 */
.activity-list {
  padding: 32rpx;
}

.activity-block {
  background: var(--card-color);
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(134, 134, 139, 0.1);
  transition: all 0.3s ease;
  animation: fadeUp 0.5s ease-out both;
}

.activity-block:active {
  transform: scale(0.99);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.activity-main {
  position: relative;
  width: 100%;
  height: 0;
  padding-bottom: 56.25%;
}

.activity-cover {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  background: linear-gradient(135deg, #E8F5E9 0%, #C8E6C9 50%, #A5D6A7 100%);
}

.activity-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(0,0,0,0) 50%, rgba(0,0,0,0.3) 100%);
  padding: 24rpx;
  display: flex;
  align-items: flex-end;
  justify-content: flex-end;
}

.activity-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: 32rpx;
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}

.activity-badge.badge-active {
  background: rgba(78, 205, 196, 0.9);
}

.activity-badge.badge-stopped {
  background: rgba(255, 107, 107, 0.9);
}

.badge-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #fff;
  flex-shrink: 0;
}

.activity-badge.badge-ended {
  background: rgba(154, 154, 154, 0.8);
}

.badge-text {
  font-size: 20rpx;
  font-weight: 500;
  color: #fff;
}

.activity-category-badge {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.category-text {
  font-size: 20rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.activity-details {
  padding: 24rpx;
}

.activity-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.activity-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  flex: 1;
  line-height: 1.2;
  letter-spacing: 1rpx;
}

.activity-price {
  font-size: 32rpx;
  font-weight: 700;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.activity-price.price-paid {
  color: var(--activity-primary);
}

.activity-price.price-free {
  color: var(--tuan-primary);
}

.activity-time-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 8rpx;
  gap: 16rpx;
}

.activity-time-row .info-item {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
}

.activity-time-row .time-item {
  flex: 1;
  min-width: 0;
}

.activity-time-row .time-item .info-text {
  overflow: visible;
  text-overflow: clip;
  white-space: normal;
  line-height: 1.4;
  word-break: break-all;
}

.activity-time-row .participants-item {
  flex-shrink: 0;
  justify-content: flex-end;
}

.activity-time-row .participants-text {
  font-weight: 500;
  color: var(--activity-primary);
  white-space: nowrap;
}

.activity-info-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 8rpx;
}

.activity-info-row:last-child {
  margin-bottom: 0;
}

.activity-info-row .info-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.info-label {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-primary);
  flex-shrink: 0;
}

.info-text {
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.3;
}

.activity-action {
  padding: 0 24rpx 24rpx;
  display: flex;
  justify-content: center;
}

.action-btn {
  padding: 16rpx 32rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  transition: all 0.3s ease;
}

.action-btn:active {
  transform: scale(0.98);
}

.action-btn.btn-active {
  background: linear-gradient(135deg, var(--activity-primary) 0%, var(--activity-primary-mid) 100%);
  box-shadow: 0 4rpx 12rpx rgba(78, 205, 196, 0.3);
}

.action-btn.btn-active .btn-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #fff;
}

.action-btn.btn-disabled {
  background: linear-gradient(135deg, var(--background-color) 0%, var(--surface-tint) 100%);
  border: 1rpx solid rgba(134, 134, 139, 0.12);
}

.action-btn.btn-disabled .btn-text {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--gray-500);
}

.action-btn.btn-registered {
  background: linear-gradient(135deg, var(--card-color) 0%, #F8FFFE 100%);
  border: 2rpx solid rgba(78, 205, 196, 0.3);
}

.action-btn.btn-registered .btn-text {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--activity-primary);
}

.action-btn.btn-ended {
  background: linear-gradient(135deg, var(--background-color) 0%, var(--surface-tint) 100%);
  border: 1rpx solid rgba(134, 134, 139, 0.12);
}

.action-btn.btn-ended .btn-text {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--gray-500);
}

/* 空状态 - 画廊风格 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
  gap: 16rpx;
}

.empty-text {
  font-size: 36rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.empty-subtitle {
  font-size: 26rpx;
  color: var(--gray-500);
}

@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(24rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
