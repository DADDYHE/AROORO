/* ================================================================
   pages/quick-register/index · AROORO 快速报名 — Haute-Luxury Editorial
   板块色：通用中性 + 暖金点缀 --accent-color
   Skyline 兼容：无 :active / text-transform / backdrop-filter / sticky
   ================================================================ */

/* ===== 入场动画 ===== */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(32rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ===== 页面容器 ===== */
.quick-register-container {
  min-height: 100vh;
  padding: 0 0 calc(200rpx + env(safe-area-inset-bottom));
}

/* ===== 顶部品牌区 ===== */
.gallery-header {
  padding: 0;
  position: relative;
}

.brand-block {
  padding: var(--zy-space-xl) var(--page-padding, 48rpx) var(--zy-space-2xl);
  position: relative;
  animation-name: fadeInUp;
  animation-duration: 600ms;
  animation-timing-function: cubic-bezier(0.19,1,0.22,1);
  animation-fill-mode: forwards;
}

.brand-accent-bar {
  width: 48rpx;
  height: 2rpx;
  background: var(--accent-color, #C9A24B);
  margin-bottom: var(--zy-space-lg);
}

.brand-main {
  position: relative;
  margin-bottom: var(--zy-space-lg);
}

.brand-text {
  font-family: var(--font-serif);
  font-size: 64rpx;
  font-weight: 300;
  color: var(--text-primary, #1A1A17);
  letter-spacing: -0.01em;
  display: block;
  line-height: 1.1;
}

.brand-meta {
  display: flex;
  align-items: center;
  gap: var(--zy-space-lg);
}

.brand-meta-line {
  width: 32rpx;
  height: 1rpx;
  background: var(--text-tertiary);
  opacity: 0.5;
}

.brand-subtitle {
  font-family: var(--font-sans);
  font-size: 24rpx;
  font-weight: 300;
  color: var(--text-tertiary);
  letter-spacing: 0.18em;
}

/* ===== 活动列表 ===== */
.activity-list {
  padding: var(--zy-space-lg);
}

.activity-block,
.activity-card {
  background: var(--card-color);
  border-radius: var(--zy-radius-lg);
  overflow: hidden;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--hairline);
  animation-name: fadeInUp;
  animation-duration: 600ms;
  animation-timing-function: cubic-bezier(0.19,1,0.22,1);
  animation-fill-mode: forwards;
  transition: transform var(--transition-fast);
}

.activity-card--pressed {
  transform: scale(0.99);
}

.activity-main {
  position: relative;
  width: 100%;
  height: 0;
  padding-bottom: 56.25%;
  overflow: hidden;
}

.activity-cover {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
}

.activity-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, transparent 50%, rgba(15,36,16,0.28) 100%);
  padding: var(--zy-space-lg);
  display: flex;
  align-items: flex-end;
  justify-content: flex-end;
}

.activity-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: var(--zy-radius-pill);
  border: 1rpx solid var(--border-inverse-20, rgba(255,255,255,0.20));
}

.activity-badge.badge-active {
  background: var(--gradient-primary);
}

.activity-badge.badge-stopped {
  background: var(--text-secondary);
}

.badge-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--text-on-primary);
  flex-shrink: 0;
}

.activity-badge.badge-ended {
  background: var(--text-tertiary);
}

.badge-text {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--text-on-primary);
  letter-spacing: 0.06em;
  font-family: var(--font-sans);
}

.activity-category-badge {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: var(--zy-radius-pill);
  background: var(--card-color);
  border: 1rpx solid var(--hairline);
}

.category-text {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.04em;
  font-family: var(--font-sans);
}

.activity-details {
  padding: var(--zy-space-lg);
}

.activity-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.activity-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  flex: 1;
  line-height: 1.4;
  letter-spacing: 0.02em;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-family: var(--font-serif);
}

.activity-price {
  font-size: 28rpx;
  font-weight: 500;
  flex-shrink: 0;
  margin-left: 16rpx;
  letter-spacing: 0.02em;
  font-family: var(--font-serif);
}

.activity-price.price-paid {
  color: var(--primary-color);
}

.activity-price.price-free {
  color: var(--primary-color);
}

.activity-time-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 8rpx;
  gap: 16rpx;
}

.activity-time-row .info-item {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
}

.activity-time-row .time-item {
  flex: 1;
  min-width: 0;
}

.activity-time-row .time-item .info-text {
  overflow: visible;
  text-overflow: clip;
  white-space: normal;
  line-height: 1.5;
  word-break: break-all;
}

.activity-time-row .participants-item {
  flex-shrink: 0;
  justify-content: flex-end;
}

.activity-time-row .participants-text {
  font-weight: 500;
  color: var(--primary-color);
  white-space: nowrap;
  letter-spacing: 0.02em;
  font-family: var(--font-sans);
}

.activity-info-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 8rpx;
}

.activity-info-row:last-child {
  margin-bottom: 0;
}

.activity-info-row .info-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.info-label {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--text-primary);
  flex-shrink: 0;
  letter-spacing: 0.02em;
  font-family: var(--font-sans);
}

.info-text {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--text-secondary);
  line-height: 1.5;
  letter-spacing: 0.02em;
  font-family: var(--font-sans);
}

.activity-action {
  padding: 0 var(--zy-space-lg) var(--zy-space-lg);
  display: flex;
  justify-content: center;
}

.action-btn {
  padding: 22rpx 32rpx;
  border-radius: var(--zy-radius-pill);
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  border: none;
  transition: transform var(--transition-fast), opacity var(--transition-fast);
}

.action-btn--pressed {
  transform: scale(0.98);
  opacity: 0.9;
}

.action-btn::after {
  border: none;
}

.action-btn.btn-active {
  background: var(--gradient-primary);
  box-shadow: var(--shadow-glow-primary-btn);
}

.action-btn.btn-active .btn-text {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-on-primary);
  letter-spacing: 0.12em;
  font-family: var(--font-serif);
}

.action-btn.btn-disabled {
  background: var(--primary-tint);
  border: 1rpx solid var(--border-color);
}

.action-btn.btn-disabled .btn-text {
  font-size: 26rpx;
  font-weight: 400;
  color: var(--text-tertiary);
  letter-spacing: 0.06em;
}

.action-btn.btn-registered {
  background: var(--card-color);
  border: 1rpx solid var(--primary-color);
}

.action-btn.btn-registered .btn-text {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--primary-color);
  letter-spacing: 0.08em;
}

.action-btn.btn-ended {
  background: var(--card-cream);
  border: 1rpx solid var(--border-color);
}

.action-btn.btn-ended .btn-text {
  font-size: 26rpx;
  font-weight: 400;
  color: var(--text-tertiary);
  letter-spacing: 0.06em;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
  gap: 16rpx;
}

.empty-text {
  font-size: 30rpx;
  color: var(--text-secondary);
  font-weight: 400;
  letter-spacing: 0.06em;
  font-family: var(--font-serif);
}

.empty-subtitle {
  font-size: 24rpx;
  color: var(--text-tertiary);
  font-weight: 300;
  letter-spacing: 0.04em;
  font-family: var(--font-sans);
}
