/* 活动报名 - PETLUX 橄榄绿治愈轻奢风格 */

.quick-register-container {
  min-height: 100vh;
  background-color: var(--background-color);
  padding: 0 0 180rpx;
}

/* 顶部画廊区 */
.gallery-header {
  padding: 0;
  position: relative;
  overflow: hidden;
  background: var(--card-color);
  padding-bottom: 20rpx;
}

.brand-block {
  padding: 80rpx 48rpx 64rpx;
  position: relative;
}

.brand-block::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, var(--primary-light) 0%, transparent 70%);
  pointer-events: none;
}

.brand-accent-bar {
  position: absolute;
  top: 0;
  left: 48rpx;
  width: 48rpx;
  height: 6rpx;
  background: linear-gradient(90deg, var(--primary-color) 0%, var(--primary-light) 100%);
  border-radius: 0 0 4rpx 4rpx;
}

.brand-main {
  position: relative;
  margin-bottom: 24rpx;
}

.brand-text {
  font-size: 56rpx;
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: 8rpx;
  display: block;
  line-height: 1.1;
  position: relative;
}

.brand-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.brand-meta-line {
  width: 40rpx;
  height: 2rpx;
  background: var(--border-color);
  position: relative;
}

.brand-meta-line::after {
  content: '';
  position: absolute;
  top: 50%;
  right: -4rpx;
  transform: translateY(-50%);
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: var(--primary-color);
}

.brand-subtitle {
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 4rpx;
  font-weight: 400;
}

/* 活动列表 - 画廊展区 */
.activity-list {
  padding: 32rpx;
}

.activity-block,
.activity-card {
  background: var(--card-color);
  border-radius: var(--border-radius-md);
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: var(--zy-shadow-xs);
  border: 1rpx solid var(--border-color);
}

.activity-main {
  position: relative;
  width: 100%;
  height: 0;
  padding-bottom: 56.25%;
}

.activity-cover {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  background: linear-gradient(135deg, var(--primary-light) 0%, var(--background-color) 100%);
}

.activity-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, transparent 50%, rgba(0, 0, 0, 0.22) 100%);
  padding: 24rpx;
  display: flex;
  align-items: flex-end;
  justify-content: flex-end;
}

.activity-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: var(--border-radius-pill);
  box-shadow: var(--zy-shadow-xs);
}

.activity-badge.badge-active {
  background: var(--primary-color);
}

.activity-badge.badge-stopped {
  background: var(--text-secondary);
}

.badge-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #FAFAF6;
  flex-shrink: 0;
}

.activity-badge.badge-ended {
  background: var(--text-tertiary);
}

.badge-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #FAFAF6;
}

.activity-category-badge {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: var(--border-radius-pill);
  background: var(--card-color);
  box-shadow: var(--zy-shadow-xs);
}

.category-text {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.activity-details {
  padding: 24rpx;
}

.activity-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.activity-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  flex: 1;
  line-height: 1.3;
  letter-spacing: 1rpx;
}

.activity-price {
  font-size: 30rpx;
  font-weight: 600;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.activity-price.price-paid {
  color: var(--primary-color);
}

.activity-price.price-free {
  color: var(--primary-color);
}

.activity-time-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 8rpx;
  gap: 16rpx;
}

.activity-time-row .info-item {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
}

.activity-time-row .time-item {
  flex: 1;
  min-width: 0;
}

.activity-time-row .time-item .info-text {
  overflow: visible;
  text-overflow: clip;
  white-space: normal;
  line-height: 1.4;
  word-break: break-all;
}

.activity-time-row .participants-item {
  flex-shrink: 0;
  justify-content: flex-end;
}

.activity-time-row .participants-text {
  font-weight: 600;
  color: var(--primary-color);
  white-space: nowrap;
}

.activity-info-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 8rpx;
}

.activity-info-row:last-child {
  margin-bottom: 0;
}

.activity-info-row .info-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.info-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-primary);
  flex-shrink: 0;
}

.info-text {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--text-secondary);
  line-height: 1.4;
}

.activity-action {
  padding: 0 24rpx 24rpx;
  display: flex;
  justify-content: center;
}

.action-btn {
  padding: 20rpx 32rpx;
  border-radius: var(--border-radius-pill);
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
}

.action-btn.btn-active {
  background: var(--primary-color);
  box-shadow: var(--zy-shadow-xs);
}

.action-btn.btn-active .btn-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #FAFAF6;
}

.action-btn.btn-disabled {
  background: var(--primary-light);
  border: 1rpx solid var(--border-color);
}

.action-btn.btn-disabled .btn-text {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-tertiary);
}

.action-btn.btn-registered {
  background: var(--card-color);
  border: 2rpx solid var(--primary-color);
}

.action-btn.btn-registered .btn-text {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--primary-color);
}

.action-btn.btn-ended {
  background: var(--primary-light);
  border: 1rpx solid var(--border-color);
}

.action-btn.btn-ended .btn-text {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-tertiary);
}

/* 空状态 - 画廊风格 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
  gap: 16rpx;
}

.empty-text {
  font-size: 32rpx;
  color: var(--text-secondary);
  font-weight: 600;
}

.empty-subtitle {
  font-size: 26rpx;
  color: var(--text-tertiary);
  font-weight: 400;
}
