/* 寄养家庭页面样式
   设计系统：AROORO Haute-Luxury v2
   token 来源：styles/variables.wxss → styles/design-tokens.wxss → styles/theme-teal.wxss（app.wxss 按序注入）
   P1-B 改造：清除旧 teal / 外来暖橙 / 通用灰阶硬编码，统一为语义 token */

/* 容器 */
.hosts-container {
  min-height: 100vh;
  position: relative;
  overflow-x: hidden;
}

/* 顶部品牌标识栏：杂志式标题区（对齐 pages/service 页 Haute-Luxury 语法） */
.gallery-header {
  padding-top: var(--zy-space-xl);
  padding-bottom: var(--zy-space-2xl);
}

.brand-accent-bar {
  width: 48rpx;
  height: 2rpx;
  background: var(--accent-color, #C9A24B);
  margin-bottom: var(--zy-space-lg);
}

.brand-main {
  margin-bottom: var(--zy-space-lg);
}

.brand-text {
  font-family: var(--font-sans);
  font-size: 72rpx;
  font-weight: 300;
  color: var(--text-primary, #1A1A17);
  letter-spacing: -0.01em;
  line-height: 1.1;
}

.brand-meta {
  display: flex;
  align-items: center;
  gap: var(--zy-space-lg);
}

.brand-meta-line {
  width: 32rpx;
  height: 1rpx;
  background: var(--text-tertiary);
  opacity: 0.5;
}

.brand-subtitle {
  font-family: var(--font-sans);
  font-size: 24rpx;
  font-weight: 300;
  color: var(--text-tertiary);
  letter-spacing: 0.18em;
}

/* 搜索栏 */
.search-header {
  margin-top: 20rpx;
  padding: 0 24rpx 20rpx;
  position: sticky;
  top: 0;
  z-index: 100;
  /* Skyline 不支持 backdrop-filter，用纸面实底兜底（sticky 时遮住下方滚动内容） */
  background-color: var(--background-color);
  border-bottom: 1rpx solid var(--hairline);
}

.search-bar {
  display: flex;
  align-items: center;
  background: var(--card-color);
  border-radius: 24rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid var(--border-color);
}

.search-bar .search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 24rpx;
  color: var(--text-primary);
  background: transparent;
  border: none;
  padding: 0;
}

/* Skyline 不支持 ::placeholder，placeholder 颜色走 wxml 的 placeholder-class */
.input-placeholder {
  color: var(--text-tertiary);
}

/* 筛选栏：纸面 + 发丝底边（sticky 用纸面实底兜底） */
.filter-bar {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  padding: 16rpx 24rpx;
  background-color: var(--background-color);
  border-bottom: 1rpx solid var(--hairline);
  position: sticky;
  top: 180rpx;
  z-index: 90;
}

.filter-section {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.filter-options {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.filter-option {
  transition: transform 160ms ease, opacity 160ms ease;
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.filter-option text {
  font-size: 22rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.filter-arrow {
  width: 24rpx;
  height: 24rpx;
}

/* 寄养家庭列表 */
.hosts-list {
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.host-card {
  transition: background-color 180ms ease, border-color 180ms ease;
  background: var(--card-cream);
  border-radius: 24rpx;
  overflow: hidden;
  border: 1rpx solid var(--hairline);
  position: relative;
  opacity: 0;
  animation: zy-fade-in-up 520ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

/* 寄养家庭卡首屏依次落位（60ms 步进，与中央 zy-enter--d* 同节奏） */
.hosts-list > .host-card:nth-child(1) { animation-delay: 160ms; }
.hosts-list > .host-card:nth-child(2) { animation-delay: 220ms; }
.hosts-list > .host-card:nth-child(3) { animation-delay: 280ms; }
.hosts-list > .host-card:nth-child(4) { animation-delay: 340ms; }
.hosts-list > .host-card:nth-child(5) { animation-delay: 400ms; }
.hosts-list > .host-card:nth-child(6) { animation-delay: 460ms; }
.hosts-list > .host-card:nth-child(n+7) { animation-delay: 0ms; }

.host-cover-container {
  position: relative;
  height: 240rpx;
  overflow: hidden;
  background: linear-gradient(135deg, var(--gray-100) 0%, var(--gray-200) 100%);
}

.host-swiper {
  width: 100%;
  height: 100%;
}

.host-cover-image {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, var(--primary-mid) 0%, var(--primary-deep) 100%);
}

/* 轮播指示器样式 */
.host-swiper .wx-swiper-dots {
  bottom: 16rpx;
}

.host-swiper .wx-swiper-dot {
  width: 8rpx;
  height: 8rpx;
  margin: 0 4rpx;
}

.host-swiper .wx-swiper-dot-active {
  width: 24rpx;
  border-radius: 4rpx;
}

.host-badge {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  background: linear-gradient(135deg, var(--accent-color), var(--accent-deep));
  color: var(--text-gold);
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
}

.host-badge-text {
  font-size: 16rpx;
  font-weight: 600;
}

.host-info {
  padding: 20rpx 24rpx;
}

.host-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.host-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 2rpx solid var(--primary-tint);
  background: linear-gradient(135deg, var(--gray-100) 0%, var(--gray-200) 100%);
}

.host-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  flex: 1;
}

/* 评分样式已移除 */

.host-description {
  font-size: 20rpx;
  color: var(--gray-700);
  line-height: 1.4;
  margin-bottom: 16rpx;
  display: block;
  overflow: hidden;
}

.host-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.host-tag {
  font-size: 16rpx;
  color: var(--primary-color);
  background: var(--primary-tint);
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--lux-hairline-green);
}

.host-features {
  display: flex;
  gap: 24rpx;
  margin-bottom: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--hairline);
}

.feature-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.feature-icon {
  width: 28rpx;
  height: 28rpx;
}

.feature-text {
  font-size: 18rpx;
  color: var(--text-secondary);
}

.host-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--hairline);
}

.price-info {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

/* 价格：品牌深森林绿纯色（Skyline 无 background-clip 渐变底） */
.price {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--primary-color);
}

.price-unit {
  font-size: 20rpx;
  color: var(--text-tertiary);
}

.book-btn {
  transition: transform 160ms ease, opacity 160ms ease;
  padding: 12rpx 24rpx;
  background: var(--primary-color);
  color: var(--text-on-primary);
  border: none;
  border-radius: var(--zy-radius-lg);
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 140rpx;
}

/* 加载状态 */
.loading-more {
  text-align: center;
  padding: 32rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.loading-dots {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.loading-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--primary-mid);
}

.loading-dot:nth-child(2) {
}

.loading-dot:nth-child(3) {
}

.loading-more-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 4rpx;
}

.no-more {
  padding: 40rpx 0;
  display: flex;
  justify-content: center;
  align-items: center;
}

.no-more-text {
  font-size: 18rpx;
  color: var(--text-tertiary);
}

.empty-state {
  padding: 120rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.empty-icon {
  animation: zy-breathe-glow 4000ms ease-in-out infinite;
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 16rpx;
}

.empty-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.empty-subtitle {
  font-size: 20rpx;
  color: var(--text-tertiary);
  text-align: center;
}

/* 筛选弹窗 */
.modal-overlay {
  transition: transform 160ms ease, opacity 160ms ease;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--overlay-color);
  z-index: 2000;
  opacity: 0;
  visibility: hidden;
}

.modal-overlay.visible {
  opacity: 1;
  visibility: visible;
}

.modal-content {
  transition: transform 160ms ease, opacity 160ms ease;
  position: fixed;
  bottom: -100%;
  left: 0;
  right: 0;
  background: var(--card-color);
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: var(--shadow-top-lg);
  max-height: 80vh;
  overflow-y: auto;
  z-index: 2001;
}

.modal-content.visible {
  bottom: 0;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid var(--hairline);
  position: sticky;
  top: 0;
  background: var(--card-color);
  z-index: 10;
}

.modal-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.modal-close-btn {
  transition: transform 160ms ease, opacity 160ms ease;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--surface-tint);
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-close {
  width: 24rpx;
  height: 24rpx;
}

.filter-content {
  padding: 24rpx;
}

.filter-group {
  margin-bottom: 32rpx;
}

.filter-group-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.filter-checkboxes {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.checkbox-item {
  transition: transform 160ms ease, opacity 160ms ease;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  border-radius: 16rpx;
  background: var(--surface-tint);
  border: 1rpx solid var(--hairline);
}

.checkbox-item.checked {
  background: var(--primary-tint);
  border-color: var(--primary-color);
}

.checkbox {
  width: 20rpx;
  height: 20rpx;
  border-radius: 4rpx;
  border: 2rpx solid var(--border-color);
  position: relative;
}

.checkbox-item.checked .checkbox {
  background: var(--primary-color);
  border-color: var(--primary-color);
}

.checkbox-item.checked .checkbox::after {
  content: '✓';
  position: absolute;
  top: -2rpx;
  left: 2rpx;
  font-size: 16rpx;
  color: var(--text-on-primary);
  font-weight: 600;
}

.checkbox-item text {
  font-size: 20rpx;
  color: var(--gray-700);
}

.checkbox-item.checked text {
  color: var(--primary-color);
  font-weight: 500;
}

.price-range {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.price-input {
  flex: 1;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--border-color);
  font-size: 20rpx;
  color: var(--text-primary);
  text-align: center;
}

.price-separator {
  font-size: 20rpx;
  color: var(--text-tertiary);
}

.modal-footer {
  display: flex;
  gap: 16rpx;
  padding: 24rpx;
  border-top: 1rpx solid var(--hairline);
  position: sticky;
  bottom: 0;
  background: var(--card-color);
  z-index: 10;
}

.reset-btn {
  transition: transform 160ms ease, opacity 160ms ease;
  flex: 1;
  padding: 16rpx;
  background: transparent;
  color: var(--gray-700);
  border: 1rpx solid var(--border-color);
  border-radius: var(--zy-radius-lg);
  font-size: 22rpx;
  font-weight: 500;
}

.apply-btn {
  transition: transform 160ms ease, opacity 160ms ease;
  flex: 1;
  padding: 16rpx;
  background: var(--primary-color);
  color: var(--text-on-primary);
  border: none;
  border-radius: var(--zy-radius-lg);
  font-size: 22rpx;
  font-weight: 600;
}

/* 响应式设计 */
@media (max-width: 375px) {
  .host-card {
    margin-bottom: 20rpx;
  }
  
  .host-features {
    flex-direction: column;
    gap: 8rpx;
    align-items: flex-start;
  }
  
  .feature-item {
    font-size: 16rpx;
  }
}

/* ── 微交互：按压态（hover-class 复用，详见 app.wxss 约定）── */
.filter-option--pressed { transform: scale(0.97); opacity: 0.92; }
.host-card--pressed {
  background-color: var(--primary-wash, #F2F5EC);
  border-color: var(--lux-hairline-green, rgba(31, 58, 31, 0.12));
  box-shadow: var(--shadow-glow-primary-xs, 0 4rpx 16rpx rgba(31, 58, 31, 0.10));
}
.book-btn--pressed { transform: scale(0.97); opacity: 0.92; }
.modal-close-btn--pressed { transform: scale(0.97); opacity: 0.92; }
.checkbox-item--pressed { transform: scale(0.97); opacity: 0.92; }





.reset-btn--pressed { transform: scale(0.97); opacity: 0.92; }
.apply-btn--pressed { transform: scale(0.97); opacity: 0.92; }

/* ── 底部留白（避开自定义 TabBar）──
   TabBar 页专用：--zy-tabbar-height 令牌值 104rpx ≥ 实际平条 80rpx，
   额外 40rpx 呼吸与 service 页对齐。Skyline 下 env(safe-area-inset-bottom)
   在部分机型不生效，故直接用令牌值兜底而非 env()。 */
.bottom-spacer {
  height: calc(var(--zy-tabbar-height, 104rpx) + 40rpx);
}
