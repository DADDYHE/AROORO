/* 寄养家庭页样式
   设计系统：AROORO Haute-Luxury v2 ·「画廊目录」全出血封面版
   token 来源：styles/variables.wxss → styles/design-tokens.wxss → styles/theme-teal.wxss（app.wxss 按序注入）
   卡片：封面铺满整卡（较完整展示家庭照片），信息区叠底部渐晕、背景透明；卡高不增大 */

/* 容器 */
.hosts-container {
  min-height: 100vh;
  position: relative;
  overflow-x: hidden;
}

/* ── 顶部品牌标识栏：杂志式标题区 ── */
.gallery-header {
  padding: var(--zy-space-xl) var(--page-padding) var(--zy-space-lg);
}

.brand-accent-bar {
  width: 48rpx;
  height: 2rpx;
  background: var(--accent-color);
  margin-bottom: 22rpx;
}

/* 金色宽字距 eyebrow（对齐 host-detail chapter-eyebrow 语法） */
.brand-eyebrow {
  display: block;
  font-size: 20rpx;
  font-weight: 400;
  letter-spacing: 0.32em;
  color: var(--accent-color);
  margin-bottom: 18rpx;
}

.brand-main {
  margin-bottom: 20rpx;
}

.brand-text {
  font-family: var(--font-sans);
  font-size: 72rpx;
  font-weight: 300;
  color: var(--text-primary);
  letter-spacing: 0.02em;
  line-height: 1.1;
}

.brand-meta {
  display: flex;
  align-items: center;
  gap: var(--zy-space-lg);
}

.brand-meta-line {
  width: 32rpx;
  height: 1rpx;
  background: var(--text-tertiary);
  opacity: 0.5;
}

.brand-subtitle {
  font-family: var(--font-sans);
  font-size: 24rpx;
  font-weight: 300;
  color: var(--text-tertiary);
  letter-spacing: 0.14em;
}

/* ── 搜索 + 筛选：单一 sticky 纸面工具条 ── */
.toolbar {
  position: sticky;
  top: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx var(--page-padding);
  /* Skyline 不支持 backdrop-filter，用纸面实底兜底（sticky 时遮住下方滚动内容） */
  background-color: var(--background-color);
  border-bottom: 1rpx solid var(--hairline);
}

.search-bar {
  flex: 1;
  display: flex;
  align-items: center;
  background: var(--card-cream);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid var(--hairline);
}

.search-bar .search-icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 24rpx;
  color: var(--text-primary);
  background: transparent;
  border: none;
  padding: 0;
}

/* Skyline 不支持 ::placeholder，placeholder 颜色走 wxml 的 placeholder-class */
.input-placeholder {
  color: var(--text-tertiary);
}

.filter-option {
  transition: transform 160ms ease, opacity 160ms ease;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 4rpx;
  flex-shrink: 0;
}

.filter-option text {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 500;
  letter-spacing: 0.08em;
}

.filter-arrow {
  width: 22rpx;
  height: 22rpx;
}

/* ── 寄养家庭列表：全出血目录行（左竖版封面 9:16 + 右信息列，hairline 分隔） ── */
.hosts-list {
  padding: 0;
  display: flex;
  flex-direction: column;
  border-top: 1rpx solid var(--hairline);
}

.host-card {
  transition: transform 180ms ease;
  position: relative;
  display: flex;
  gap: 26rpx;
  border-bottom: 1rpx solid var(--hairline);
  background-color: var(--card-cream);
  opacity: 0;
  animation: zy-fade-in-up 520ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

/* 首屏依次落位（60ms 步进，与中央 zy-enter--d* 同节奏） */
.hosts-list > .host-card:nth-child(1) { animation-delay: 160ms; }
.hosts-list > .host-card:nth-child(2) { animation-delay: 220ms; }
.hosts-list > .host-card:nth-child(3) { animation-delay: 280ms; }
.hosts-list > .host-card:nth-child(4) { animation-delay: 340ms; }
.hosts-list > .host-card:nth-child(5) { animation-delay: 400ms; }
.hosts-list > .host-card:nth-child(6) { animation-delay: 460ms; }
.hosts-list > .host-card:nth-child(n+7) { animation-delay: 0ms; }

/* 左：竖版封面（高度由 JS 实测首图比例写入 style，卡片严丝合缝等于图高；
   下限 420 由 _computeCoverHeights 控制，横图 aspectFill 居中裁切兜底） */
.host-photo {
  position: relative;
  width: 300rpx;
  flex-shrink: 0;
  overflow: hidden;
}

.host-photo-img {
  width: 100%;
  height: 100%;
}

/* 甄选徽章：深绿底 + 金 hairline 内框（图左上） */
.host-badge {
  position: absolute;
  top: 14rpx;
  left: 14rpx;
  background-color: rgba(15, 36, 16, 0.62);
  border: 1rpx solid var(--lux-hairline-gold);
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  z-index: 3;
}

.host-badge-text {
  font-size: 18rpx;
  font-weight: 400;
  letter-spacing: 0.2em;
  color: #F7F5EF;
}

/* 多图角标：图右下 */
.cover-count {
  position: absolute;
  right: 14rpx;
  bottom: 14rpx;
  background-color: rgba(15, 36, 16, 0.62);
  border: 1rpx solid var(--lux-hairline-gold);
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
  z-index: 3;
}

.cover-count-t {
  font-size: 18rpx;
  letter-spacing: 0.08em;
  color: #F7F5EF;
}

/* 暂停接待：封面灰纱 + 标识 */
.cover-pause {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(236, 228, 212, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 3;
}

.cover-pause-t {
  font-size: 22rpx;
  letter-spacing: 0.18em;
  color: var(--text-primary);
  background-color: rgba(247, 245, 239, 0.92);
  padding: 12rpx 24rpx;
  border-radius: 4rpx;
}

/* 右：信息列（上下撑满图高，底行锚底，右缘留页边距） */
.host-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 28rpx var(--page-padding) 28rpx 0;
}

.host-name {
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 0.04em;
  color: var(--text-primary);
  line-height: 1.4;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 评分 + 计费方式行：金星大号，计费做金 hairline 胶囊提设计感 */
.host-meta-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 14rpx;
}

.host-rating {
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 0.04em;
  color: var(--accent-color);
}

.host-billing {
  font-size: 20rpx;
  letter-spacing: 0.08em;
  color: var(--accent-color);
  border: 1rpx solid var(--lux-hairline-gold);
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

/* 简介：JS 预截断 28 字（Skyline 不支持多行截断属性，截断在 index.js shortDesc 完成） */
.host-desc {
  margin-top: 14rpx;
  font-size: 23rpx;
  letter-spacing: 0.02em;
  line-height: 1.6;
  color: var(--text-secondary);
}

/* 位置：金点 + 区县 */
.host-loc {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  font-size: 22rpx;
  letter-spacing: 0.06em;
  color: var(--text-tertiary);
}

.loc-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--accent-color);
  margin-right: 10rpx;
  flex-shrink: 0;
}

/* 底部：hairline 分隔 + 价格 + 预约（锚底） */
.host-bottom {
  margin-top: 14rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--hairline);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.price-info {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.price-symbol {
  font-size: 22rpx;
  color: var(--text-primary);
}

/* 轻字重大数字（对齐 host-detail 编辑式价格语法） */
.price {
  font-size: 42rpx;
  font-weight: 300;
  letter-spacing: 0.02em;
  color: var(--text-primary);
}

.price-unit {
  font-size: 20rpx;
  color: var(--text-tertiary);
}

/* CTA：深绿渐变底 + cream 字（品牌主语法，纸面卡上权重足够） */
.book-btn {
  transition: transform 160ms ease, opacity 160ms ease;
  padding: 14rpx 30rpx;
  background: var(--lux-green-grad);
  color: #F7F5EF;
  border-radius: 10rpx;
  font-size: 23rpx;
  font-weight: 500;
  letter-spacing: 0.12em;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* 暂停接待：灰纱禁用态 */
.book-btn--off {
  background: rgba(26, 26, 23, 0.35);
  color: rgba(247, 245, 239, 0.75);
}

/* 加载状态 */
.loading-more {
  text-align: center;
  padding: 32rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.loading-more-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 4rpx;
}

.no-more {
  padding: 40rpx 0;
  display: flex;
  justify-content: center;
  align-items: center;
}

.no-more-text {
  font-size: 18rpx;
  letter-spacing: 0.2em;
  color: var(--text-tertiary);
}

.empty-state {
  padding: 120rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.empty-icon {
  animation: zy-breathe-glow 4000ms ease-in-out infinite;
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 16rpx;
}

.empty-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.empty-subtitle {
  font-size: 20rpx;
  color: var(--text-tertiary);
  text-align: center;
}

/* ── 筛选弹窗：纸面 chips ── */
.modal-overlay {
  transition: opacity 200ms ease;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--overlay-color);
  z-index: 2000;
  opacity: 0;
  visibility: hidden;
}

.modal-overlay.visible {
  opacity: 1;
  visibility: visible;
}

.modal-content {
  transition: transform 240ms cubic-bezier(0.16, 1, 0.3, 1);
  position: fixed;
  bottom: -100%;
  left: 0;
  right: 0;
  background: var(--background-color);
  border-radius: 20rpx 20rpx 0 0;
  box-shadow: var(--shadow-top-lg);
  max-height: 80vh;
  overflow-y: auto;
  z-index: 2001;
}

.modal-content.visible {
  bottom: 0;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx var(--page-padding) 20rpx;
  border-bottom: 1rpx solid var(--hairline);
  position: sticky;
  top: 0;
  background: var(--background-color);
  z-index: 10;
}

.modal-head-left {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.modal-eyebrow {
  font-size: 18rpx;
  letter-spacing: 0.32em;
  color: var(--accent-color);
}

.modal-title {
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 0.06em;
  color: var(--text-primary);
}

.modal-close-btn {
  transition: transform 160ms ease, opacity 160ms ease;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 1rpx solid var(--hairline);
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-close {
  width: 24rpx;
  height: 24rpx;
}

.filter-content {
  padding: 28rpx var(--page-padding);
}

.filter-group {
  margin-bottom: 36rpx;
}

.filter-group-title {
  font-size: 24rpx;
  font-weight: 500;
  letter-spacing: 0.10em;
  color: var(--text-secondary);
  margin-bottom: 18rpx;
}

.filter-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

/* 筛选 chip：hairline 描边 + 金点选中（对齐 host-detail 标签语法） */
.chip {
  transition: transform 160ms ease, opacity 160ms ease;
  display: flex;
  align-items: center;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(26, 26, 23, 0.14);
  background: transparent;
}

.chip text {
  font-size: 24rpx;
  letter-spacing: 0.06em;
  color: var(--text-secondary);
}

.chip.checked {
  border-color: var(--primary-color);
  background: var(--primary-tint);
}

.chip.checked text {
  color: var(--primary-color);
  font-weight: 500;
}

.chip-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--accent-color);
  margin-right: 10rpx;
}

.price-range {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.price-input {
  flex: 1;
  padding: 16rpx 20rpx;
  border-radius: 10rpx;
  border: 1rpx solid var(--hairline);
  background: var(--card-cream);
  font-size: 24rpx;
  color: var(--text-primary);
  text-align: center;
}

.price-separator-line {
  width: 24rpx;
  height: 1rpx;
  background: rgba(26, 26, 23, 0.20);
}

.modal-footer {
  display: flex;
  gap: 16rpx;
  padding: 24rpx var(--page-padding) calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--hairline);
  position: sticky;
  bottom: 0;
  background: var(--background-color);
  z-index: 10;
}

.reset-btn {
  transition: transform 160ms ease, opacity 160ms ease;
  flex: 1;
  padding: 18rpx;
  background: transparent;
  color: var(--text-secondary);
  border: 1rpx solid rgba(26, 26, 23, 0.14);
  border-radius: 10rpx;
  font-size: 24rpx;
  font-weight: 500;
  letter-spacing: 0.10em;
}

.apply-btn {
  transition: transform 160ms ease, opacity 160ms ease;
  flex: 1;
  padding: 18rpx;
  background: var(--primary-color);
  color: var(--text-on-primary);
  border: none;
  border-radius: 10rpx;
  font-size: 24rpx;
  font-weight: 500;
  letter-spacing: 0.14em;
}

/* ── 微交互：按压态（hover-class 复用，详见 app.wxss 约定）── */
.filter-option--pressed { transform: scale(0.97); opacity: 0.92; }
.chip--pressed { transform: scale(0.97); opacity: 0.92; }
.book-btn--pressed { transform: scale(0.97); opacity: 0.92; }
.modal-close-btn--pressed { transform: scale(0.97); opacity: 0.92; }
.reset-btn--pressed { transform: scale(0.97); opacity: 0.92; }
.apply-btn--pressed { transform: scale(0.97); opacity: 0.92; }
.host-card--pressed { transform: scale(0.985); opacity: 0.96; }

/* ── 底部留白（避开自定义 TabBar）──
   TabBar 页专用：--zy-tabbar-height 令牌值 104rpx ≥ 实际平条 80rpx，
   额外 40rpx 呼吸与 service 页对齐。Skyline 下 env(safe-area-inset-bottom)
   在部分机型不生效，故直接用令牌值兜底而非 env()。 */
.bottom-spacer {
  height: calc(var(--zy-tabbar-height, 104rpx) + 40rpx);
}
