<zy-navbar title="" showBack="{{false}}" transparent color="#F7F5EF" solid="{{_navbarSolid}}" />
<scroll-view
  scroll-y
  enhanced
  show-scrollbar="{{false}}"
  refresher-enabled="{{true}}"
  refresher-triggered="{{_refresherTriggered}}"
  bindrefresherrefresh="_onRefresherRefresh"
  bindscrolltolower="_onScrollToLower"
  bindscroll="_onScroll"
  lower-threshold="100"
  style="height: 100vh;"
>
<view class="hosts-container">
  <login-prompt visible="{{showLoginPrompt}}" bind:close="onLoginPromptClose" />

  <!-- B · 深绿沉浸标题版（顶天）：杂志式品牌栏升级 -->
  <view class="lux-hero zy-enter" style="padding-top: calc({{_navbarHeight}}px + 24rpx);">
    <text class="lux-hero-eyebrow">AROORO · HOSTING</text>
    <text class="lux-hero-title">家庭寄养</text>
    <text class="lux-hero-sub">{{totalCount > 0 ? totalCount + ' 个在住家庭 · 安心呼噜，放心托付' : '安心呼噜，放心托付'}}</text>
    <view class="lux-hero-sealline"></view>
  </view>

  <!-- 搜索 + 筛选：单一 sticky 纸面条（消除双 sticky 错位） -->
  <view class="toolbar">
    <view class="search-bar">
      <image class="search-icon" src="/images/icons/search-luxury-line.svg" mode="aspectFit"></image>
      <input class="search-input" placeholder-class="input-placeholder" placeholder="搜索寄养家庭、位置、服务..." value="{{searchKeyword}}" bindinput="handleSearchInput" bindconfirm="handleSearch" confirm-type="search" />
    </view>
    <view class="filter-option" bindtap="showFilterModal" hover-class="filter-option--pressed" hover-stay-time="80">
      <text>筛选</text>
      <image class="filter-arrow" src="/images/icons/chevron-down-luxury-line.svg" mode="aspectFit"></image>
    </view>
  </view>

  <!-- 寄养家庭列表 -->
  <zy-skeleton wx:if="{{isLoading && hosts.length === 0}}" type="list" count="{{3}}" />
  <view class="hosts-list">
    <view class="host-card" wx:for="{{hosts}}" wx:key="id" data-id="{{item.id}}" bindtap="selectHost" hover-class="host-card--pressed" hover-stay-time="80">
      <!-- 左：封面图（单图 1:1 裁切，徽章/角标/暂停纱叠图） -->
      <view class="host-photo" style="height:{{item.photoH || 400}}rpx">
        <image lazy-load class="host-photo-img" src="{{item.photos[0]}}" mode="aspectFill" binderror="onCloudImageError" data-src="{{item.photos[0]}}" data-path="hosts[{{index}}].photos[0]"></image>
        <view class="host-badge" wx:if="{{item.isRecommended}}">
          <text class="host-badge-text">甄选</text>
        </view>
        <view class="cover-count" wx:if="{{item.photos.length > 1}}">
          <text class="cover-count-t">{{item.photos.length}}图</text>
        </view>
        <view class="cover-pause" wx:if="{{!item.isAcceptingOrders}}">
          <text class="cover-pause-t">已暂停接待</text>
        </view>
      </view>

      <!-- 右：信息列（名称 / 评分+计费 / 简介 / 位置 / 价格+预约） -->
      <view class="host-info">
        <text class="host-name">{{item.name}}</text>

        <view class="host-meta-row">
          <text class="host-rating" wx:if="{{item.rating > 0}}">★ {{item.rating}}</text>
          <text class="host-billing" wx:if="{{item.billingLabel}}">计费·{{item.billingLabel}}</text>
          <text class="host-billing" wx:if="{{!item.rating && !item.billingLabel}}">欢迎咨询</text>
        </view>

        <text class="host-desc">{{item.shortDesc}}</text>
        <view class="host-loc"><view class="loc-dot"></view><text>{{item.location || '位置待完善'}}</text></view>

        <view class="host-bottom">
          <view class="price-info">
            <text class="price-symbol">¥</text>
            <text class="price">{{item.price}}</text>
            <text class="price-unit">/{{item.priceUnit || '天'}}</text>
          </view>
          <view class="book-btn {{item.isAcceptingOrders ? '' : 'book-btn--off'}}" data-id="{{item.id}}" catchtap="{{item.isAcceptingOrders ? 'bookHost' : ''}}" hover-class="{{item.isAcceptingOrders ? 'book-btn--pressed' : ''}}" hover-stay-time="80">
            <text>{{item.isAcceptingOrders ? '预约' : '暂停接待'}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载状态（翻页指示：仅已有数据时显示，首屏走骨架屏） -->
  <view wx:if="{{isLoading && hosts.length > 0}}" class="loading-more">
    <view class="lux-silk">
  <view class="lux-silk-line" style="background: var(--lux-gold-500, #C9A24B); animation-delay: 0ms;"></view>
  <view class="lux-silk-line" style="background: var(--lux-gold-600, #A8894A); animation-delay: 100ms;"></view>
  <view class="lux-silk-line" style="background: var(--lux-gold-500, #C9A24B); animation-delay: 200ms;"></view>
  <view class="lux-silk-line" style="background: var(--lux-gold-600, #A8894A); animation-delay: 300ms;"></view>
  <view class="lux-silk-line" style="background: var(--lux-gold-500, #C9A24B); animation-delay: 400ms;"></view>
</view>
    <text class="loading-more-text">{{t.BIZ_CSIK0}}</text>
  </view>
  <view class="no-more" wx:if="{{!hasMore && hosts.length > 0}}">
    <text class="no-more-text">— 没有更多了 —</text>
  </view>
  <view class="empty-state" wx:if="{{errorMsg}}">
    <image class="empty-icon" src="/images/icons/warning-luxury-line.svg" mode="aspectFit"></image>
    <text class="empty-title">{{errorMsg}}</text>
    <text class="empty-subtitle">请检查网络后重试</text>
  </view>
  <view class="empty-state" wx:if="{{showEmptyState && !errorMsg}}">
    <image class="empty-icon" src="/images/icons/home-luxury-line.svg" mode="aspectFit"></image>
    <text class="empty-title">暂无寄养家庭</text>
    <text class="empty-subtitle">请尝试调整搜索条件</text>
  </view>

  <!-- 底部留白（避开自定义 TabBar） -->
  <view class="bottom-spacer"></view>
</view>

<!-- 筛选弹窗 -->
<root-portal>
<view class="modal-overlay {{showFilterModal ? 'visible' : ''}}" bindtap="closeFilterModal">
  <view class="modal-content {{showFilterModal ? 'visible' : ''}}" catchtap="">
    <view class="modal-header">
      <view class="modal-head-left">
        <text class="modal-eyebrow">FILTER</text>
        <text class="modal-title">筛选条件</text>
      </view>
      <view class="modal-close-btn" bindtap="closeFilterModal" hover-class="modal-close-btn--pressed" hover-stay-time="80">
        <image class="modal-close" src="/images/icons/close-luxury-line.svg" mode="aspectFit"></image>
      </view>
    </view>

    <view class="filter-content">
      <view class="filter-group">
        <text class="filter-group-title">宠物类型</text>
        <view class="filter-chips">
          <view class="chip {{filters.petTypes.dog ? 'checked' : ''}}" data-category="petTypes" data-key="dog" bindtap="onToggleFilter" hover-class="chip--pressed" hover-stay-time="80">
            <view class="chip-dot" wx:if="{{filters.petTypes.dog}}"></view>
            <text>{{t.BIZ_K5WG}}</text>
          </view>
          <view class="chip {{filters.petTypes.cat ? 'checked' : ''}}" data-category="petTypes" data-key="cat" bindtap="onToggleFilter" hover-class="chip--pressed" hover-stay-time="80">
            <view class="chip-dot" wx:if="{{filters.petTypes.cat}}"></view>
            <text>{{t.BIZ_K1Y7}}</text>
          </view>
          <view class="chip {{filters.petTypes.other ? 'checked' : ''}}" data-category="petTypes" data-key="other" bindtap="onToggleFilter" hover-class="chip--pressed" hover-stay-time="80">
            <view class="chip-dot" wx:if="{{filters.petTypes.other}}"></view>
            <text>{{t.BIZ_EAE8}}</text>
          </view>
        </view>
      </view>

      <view class="filter-group">
        <text class="filter-group-title">服务类型</text>
        <view class="filter-chips">
          <view class="chip {{filters.services.board ? 'checked' : ''}}" data-category="services" data-key="board" bindtap="onToggleFilter" hover-class="chip--pressed" hover-stay-time="80">
            <view class="chip-dot" wx:if="{{filters.services.board}}"></view>
            <text>{{t.BIZ_G20N}}</text>
          </view>
          <view class="chip {{filters.services.walk ? 'checked' : ''}}" data-category="services" data-key="walk" bindtap="onToggleFilter" hover-class="chip--pressed" hover-stay-time="80">
            <view class="chip-dot" wx:if="{{filters.services.walk}}"></view>
            <text>遛狗</text>
          </view>
          <view class="chip {{filters.services.feed ? 'checked' : ''}}" data-category="services" data-key="feed" bindtap="onToggleFilter" hover-class="chip--pressed" hover-stay-time="80">
            <view class="chip-dot" wx:if="{{filters.services.feed}}"></view>
            <text>喂食</text>
          </view>
        </view>
      </view>

      <view class="filter-group">
        <text class="filter-group-title">价格范围</text>
        <view class="price-range">
          <input class="price-input" placeholder-class="input-placeholder" type="number" placeholder="最低" value="{{filters.price.min}}" bindinput="handlePriceInput" data-type="min" />
          <view class="price-separator-line"></view>
          <input class="price-input" placeholder-class="input-placeholder" type="number" placeholder="最高" value="{{filters.price.max}}" bindinput="handlePriceInput" data-type="max" />
        </view>
      </view>
    </view>

    <view class="modal-footer">
      <button class="reset-btn" bindtap="resetFilters" hover-class="reset-btn--pressed" hover-stay-time="80">重置</button>
      <button class="apply-btn" bindtap="applyFilters" hover-class="apply-btn--pressed" hover-stay-time="80">应用筛选</button>
    </view>
  </view>
</view>
</root-portal>
</scroll-view>
