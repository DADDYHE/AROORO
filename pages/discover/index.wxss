/* ================================================================
   AROORO · 宠团团 Discover 页
   Haute-Luxury · Editorial Group-Buy · Skyline 兼容
   ----------------------------------------------------------------
   色彩板块：陶土暖棕（tuan）家族
   排版哲学：杂志式大字距 + 轻字重 + 发丝描边取代阴影
   ================================================================ */

/* ===== 入场动画（仅 transform / opacity，GPU 加速） ===== */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(24rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}

@keyframes scaleIn {
  from {
    opacity: 0;
    transform: scale(0.96);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

/* ===== 页面容器 ===== */
.tuan-page {
  height: 100vh;
  background-color: var(--background-color);
  background-image: var(--zy-paper-noise);
  background-repeat: repeat;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  animation-name: fadeIn;
  animation-duration: 600ms;
  animation-timing-function: cubic-bezier(0.19, 1, 0.22, 1);
  animation-fill-mode: forwards;
}

/* ===== 顶部品牌区（编辑式极简） ===== */
.tuan-header {
  background: var(--background-color);
  padding: 0;
  position: relative;
  flex-shrink: 0;
  animation-name: fadeInUp;
  animation-duration: 700ms;
  animation-timing-function: cubic-bezier(0.19, 1, 0.22, 1);
  animation-fill-mode: forwards;
}

.brand-block {
  padding: calc(var(--safe-area-top) + 32rpx) var(--page-padding) 40rpx;
  position: relative;
}

/* 细金分割线，取代厚重的 accent bar */
.brand-accent-bar {
  position: absolute;
  bottom: 0;
  left: var(--page-padding);
  width: 64rpx;
  height: 1rpx;
  background: var(--accent-color);
}

.brand-main {
  position: relative;
  margin-bottom: 20rpx;
}

.tuan-title {
  font-family: var(--font-sans);
  font-size: 48rpx;
  font-weight: 500;
  color: var(--text-primary);
  letter-spacing: 0.04em;
  display: block;
  line-height: 1.2;
  position: relative;
}

/* 简化品牌副信息：一条细发丝分割线，移除圆点装饰 */
.brand-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 4rpx;
}

.brand-meta-line {
  width: 32rpx;
  height: 1rpx;
  background: var(--hairline);
}

.tuan-subtitle {
  font-family: var(--font-sans);
  font-size: 24rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.12em;
  font-weight: 300;
  line-height: 1.6;
}

/* ===== 团购列表 ===== */
.tuan-list {
  flex: 1;
  overflow: hidden;
}

.tuan-list-inner {
  padding: var(--zy-space-lg) var(--page-padding) calc(var(--zy-space-xl) + env(safe-area-inset-bottom, 0px));
}

/* ===== 团购卡片（白卡 + 发丝描边 + 微圆角） ===== */
.deal-card {
  background: var(--card-color);
  border-radius: var(--lux-radius-card);
  overflow: hidden;
  margin-bottom: var(--zy-space-lg);
  border: 1rpx solid var(--hairline);
  transition: transform 280ms cubic-bezier(0.25, 0.1, 0.25, 1),
              border-color 280ms cubic-bezier(0.25, 0.1, 0.25, 1);
  animation-name: fadeInUp;
  animation-duration: 600ms;
  animation-timing-function: cubic-bezier(0.19, 1, 0.22, 1);
  animation-fill-mode: forwards;
}

.deal-card--pressed {
  transform: scale(0.98);
  border-color: var(--border-color);
}

/* ===== 标题 + 价格区域 ===== */
.deal-top {
  padding: var(--zy-space-lg) var(--zy-space-lg) var(--zy-space-sm2);
}

.deal-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--zy-space-sm2);
}

.deal-name {
  font-family: var(--font-sans);
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  /* Skyline 不支持 -webkit-box 多行截断，使用单行截断 */
  white-space: nowrap;
  letter-spacing: 0.02em;
  line-height: 1.4;
}

.deal-tag {
  font-family: var(--font-sans);
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: var(--zy-radius-xs);
  font-weight: 400;
  flex-shrink: 0;
  letter-spacing: 0.08em;
}

/* 热门标签 — 使用团购板块陶土暖棕 */
.tag-hot {
  background: var(--tuan-accent);
  color: var(--tuan-primary);
}

/* 人数标签 — 浅金米底 */
.tag-count {
  background: var(--accent-wash);
  color: var(--text-secondary);
}

.deal-price-info {
  display: flex;
  align-items: baseline;
  margin-top: var(--zy-space-sm2);
  gap: 8rpx;
}

.deal-price-symbol {
  font-family: var(--font-sans);
  font-size: 24rpx;
  color: var(--tuan-primary);
  font-weight: 500;
  letter-spacing: 0.02em;
}

.deal-price {
  font-family: var(--font-sans);
  font-size: 44rpx;
  color: var(--tuan-primary);
  font-weight: 500;
  line-height: 1.15;
  letter-spacing: -0.01em;
}

.deal-price-from {
  font-family: var(--font-sans);
  font-size: 22rpx;
  color: var(--text-tertiary);
  font-weight: 300;
  letter-spacing: 0.04em;
}

.deal-price-original {
  font-family: var(--font-sans);
  font-size: 22rpx;
  color: var(--text-tertiary);
  text-decoration: line-through;
  font-weight: 300;
  letter-spacing: 0.02em;
}

/* ===== 三张小图区域 ===== */
.deal-images {
  display: flex;
  gap: var(--zy-space-sm);
  padding: 0 var(--zy-space-lg);
}

.deal-thumb {
  flex: 1;
  height: 180rpx;
  border-radius: var(--zy-radius-sm);
  background: var(--primary-wash);
  overflow: hidden;
}

.deal-thumb-more {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--tuan-tint);
}

.thumb-more-text {
  font-family: var(--font-sans);
  font-size: 22rpx;
  color: var(--tuan-primary);
  font-weight: 400;
  letter-spacing: 0.08em;
}

/* ===== 底部按钮区域 ===== */
.deal-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: var(--zy-space-sm2);
  padding: var(--zy-space-sm2) var(--zy-space-lg) var(--zy-space-lg);
}

.deal-action-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin: 0;
  padding: 0;
  border: none;
  line-height: normal;
  background: transparent;
  transition: transform 240ms cubic-bezier(0.25, 0.1, 0.25, 1),
              opacity 240ms cubic-bezier(0.25, 0.1, 0.25, 1);
}

.deal-action-btn::after {
  border: none;
}

.deal-action-btn--pressed {
  transform: scale(0.96);
  opacity: 0.75;
}

/* 分享按钮：透明底 + 发丝描边，移除所有 !important */
.btn-share {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 28rpx;
  border-radius: var(--zy-radius-pill);
  background: transparent;
  border: 1rpx solid var(--hairline);
  font-size: 22rpx;
  min-width: unset;
  width: auto;
  max-width: unset;
  line-height: 1;
  margin: 0;
  box-sizing: border-box;
  color: var(--text-secondary);
  transition: transform 240ms cubic-bezier(0.25, 0.1, 0.25, 1),
              border-color 240ms cubic-bezier(0.25, 0.1, 0.25, 1),
              background-color 240ms cubic-bezier(0.25, 0.1, 0.25, 1);
}

.btn-share::after {
  border: none;
}

.btn-share--pressed {
  transform: scale(0.96);
  border-color: var(--border-color);
  background: var(--accent-wash);
}

.action-icon {
  font-size: 22rpx;
  color: var(--text-secondary);
}

/* 方案 A 发丝线分享图标（image 替代 emoji） */
.action-icon--svg {
  width: 26rpx;
  height: 26rpx;
  flex-shrink: 0;
}

.action-text {
  font-family: var(--font-sans);
  font-size: 22rpx;
  color: var(--text-secondary);
  letter-spacing: 0.06em;
}

/* 参团主按钮 — 团购板块陶土暖棕渐变 CTA */
.btn-join {
  padding: 18rpx 52rpx;
  border-radius: var(--zy-radius-pill);
  background: var(--tuan-primary);
  border: none;
  transition: transform 240ms cubic-bezier(0.25, 0.1, 0.25, 1),
              background-color 240ms cubic-bezier(0.25, 0.1, 0.25, 1),
              box-shadow 240ms cubic-bezier(0.25, 0.1, 0.25, 1);
}

.btn-join::after {
  border: none;
}

.btn-join--pressed {
  transform: scale(0.97);
  background: var(--tuan-secondary);
}

.action-text-join {
  font-family: var(--font-sans);
  font-size: 26rpx;
  color: var(--card-color);
  font-weight: 500;
  letter-spacing: 0.1em;
}

/* ===== 加载 / 空态 ===== */
.tuan-loading {
  text-align: center;
  padding: var(--zy-space-lg) 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--zy-space-sm2);
}

.loading-more-text {
  font-family: var(--font-sans);
  font-size: 22rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.12em;
  font-weight: 300;
}

.loading-dots {
  display: flex;
  gap: var(--zy-space-sm);
  align-items: center;
}

.loading-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: var(--accent-color);
  opacity: 0.4;
  animation-name: dotPulse;
  animation-duration: 1400ms;
  animation-timing-function: cubic-bezier(0.42, 0, 0.58, 1);
  animation-fill-mode: forwards;
  animation-iteration-count: infinite;
}

.loading-dot:nth-child(2) {
  animation-delay: 200ms;
}

.loading-dot:nth-child(3) {
  animation-delay: 400ms;
}

@keyframes dotPulse {
  0%, 80%, 100% {
    opacity: 0.3;
    transform: scale(0.8);
  }
  40% {
    opacity: 1;
    transform: scale(1);
  }
}

.tuan-no-more {
  text-align: center;
  padding: var(--zy-space-lg);
  font-family: var(--font-sans);
  font-size: 22rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.16em;
  font-weight: 300;
}

.tuan-empty {
  text-align: center;
  padding: var(--zy-space-2xl) var(--page-padding);
  animation-name: fadeIn;
  animation-duration: 600ms;
  animation-timing-function: cubic-bezier(0.19, 1, 0.22, 1);
  animation-fill-mode: forwards;
}

.empty-icon {
  font-size: 72rpx;
  display: block;
  opacity: 0.35;
  color: var(--text-tertiary);
}

/* 发丝线空状态图标（image 替代 emoji） */
.empty-icon--svg {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto;
}

.empty-text {
  font-family: var(--font-sans);
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-top: var(--zy-space-lg);
  display: block;
  font-weight: 400;
  letter-spacing: 0.06em;
}

.empty-hint {
  font-family: var(--font-sans);
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-top: var(--zy-space-sm);
  display: block;
  letter-spacing: 0.08em;
  font-weight: 300;
}

/* ================================================================
   优惠券弹窗 — 奢华改版：发丝描边 + 香槟金点缀 + 宽字距
   ================================================================ */
.coupon-popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--overlay-color);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  animation-name: fadeIn;
  animation-duration: 320ms;
  animation-timing-function: cubic-bezier(0.19, 1, 0.22, 1);
  animation-fill-mode: forwards;
}

.coupon-popup {
  width: 600rpx;
  background: var(--card-color);
  border-radius: var(--zy-radius-lg);
  padding: 56rpx 40rpx 40rpx;
  position: relative;
  border: 1rpx solid var(--hairline);
  animation-name: scaleIn;
  animation-duration: 420ms;
  animation-timing-function: cubic-bezier(0.19, 1, 0.22, 1);
  animation-fill-mode: forwards;
}

.popup-close {
  position: absolute;
  top: 28rpx;
  right: 28rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--text-tertiary);
  border-radius: 50%;
  transition: transform 240ms cubic-bezier(0.25, 0.1, 0.25, 1),
              background-color 240ms cubic-bezier(0.25, 0.1, 0.25, 1);
}

.popup-close--pressed {
  transform: scale(0.92);
  background: var(--accent-wash);
}

.popup-close-icon {
  width: 28rpx;
  height: 28rpx;
}

.popup-header {
  text-align: center;
  margin-bottom: var(--zy-space-lg);
  position: relative;
  padding-bottom: var(--zy-space-lg);
}

/* 弹窗标题下一条细金分割线 */
.popup-header::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 1rpx;
  background: var(--accent-color);
}

.popup-title {
  font-family: var(--font-sans);
  font-size: 36rpx;
  font-weight: 500;
  color: var(--text-primary);
  display: block;
  line-height: 1.25;
  letter-spacing: 0.06em;
}

.popup-subtitle {
  font-family: var(--font-sans);
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-top: 12rpx;
  display: block;
  line-height: 1.6;
  letter-spacing: 0.1em;
  font-weight: 300;
}

/* 券卡：奶油纸感底 + 发丝描边 + 金色细边点缀 */
.popup-coupon-card {
  background: var(--card-cream);
  border-radius: var(--zy-radius-md);
  overflow: hidden;
  margin-bottom: var(--zy-space-lg);
  border: 1rpx solid var(--hairline);
  position: relative;
}

/* 顶部 1rpx 香槟金细线（取代厚重 ribbon） */
.popup-coupon-ribbon {
  height: 1rpx;
  background: var(--accent-color);
}

.popup-coupon-body {
  display: flex;
  gap: var(--zy-space-lg);
  padding: var(--zy-space-lg) var(--zy-space-lg);
  align-items: center;
}

.popup-coupon-main {
  flex-shrink: 0;
  padding-right: var(--zy-space-lg);
  border-right: 1rpx solid var(--hairline);
}

.popup-coupon-value {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  color: var(--tuan-primary);
}

.popup-coupon-num {
  font-family: var(--font-sans);
  font-size: 64rpx;
  font-weight: 500;
  letter-spacing: -0.02em;
  line-height: 1;
  color: var(--tuan-primary);
}

.popup-coupon-unit {
  font-family: var(--font-sans);
  font-size: 24rpx;
  font-weight: 400;
  color: var(--tuan-primary);
  letter-spacing: 0.04em;
}

.popup-coupon-threshold {
  font-family: var(--font-sans);
  font-size: 20rpx;
  color: var(--text-tertiary);
  margin-top: 10rpx;
  letter-spacing: 0.1em;
  font-weight: 300;
}

.popup-coupon-info {
  flex: 1;
  padding-top: 4rpx;
}

.popup-coupon-name {
  font-family: var(--font-sans);
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-primary);
  display: block;
  line-height: 1.55;
  letter-spacing: 0.04em;
}

/* 领取按钮 — 主色深森林绿渐变 CTA，胶囊形 */
.popup-claim-btn {
  width: 100%;
  height: 88rpx;
  background: var(--gradient-primary);
  color: var(--text-on-primary);
  font-family: var(--font-sans);
  font-size: 28rpx;
  font-weight: 500;
  border-radius: var(--zy-radius-pill);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 0.16em;
  box-shadow: var(--shadow-glow-primary-btn);
  transition: transform 240ms cubic-bezier(0.25, 0.1, 0.25, 1),
              box-shadow 240ms cubic-bezier(0.25, 0.1, 0.25, 1),
              opacity 240ms cubic-bezier(0.25, 0.1, 0.25, 1);
}

.popup-claim-btn::after {
  border: none;
}

.popup-claim-btn--pressed {
  transform: scale(0.98);
  opacity: 0.92;
  box-shadow: var(--shadow-glow-primary-xs);
}
