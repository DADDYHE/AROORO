/* 宠团团 · PETLUX 橄榄绿治愈轻奢风格 */

.tuan-page {
  height: 100vh;
  background: var(--background-color);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ===== 顶部品牌区 ===== */
.tuan-header {
  background: var(--card-color);
  padding: 0;
  position: relative;
  overflow: hidden;
  padding-bottom: 24rpx;
  flex-shrink: 0;
}

.brand-block {
  padding: 64rpx 32rpx 48rpx;
  position: relative;
}

.brand-accent-bar {
  position: absolute;
  top: 0;
  left: 32rpx;
  width: 48rpx;
  height: 6rpx;
  background: var(--primary-color);
  border-radius: 0 0 var(--border-radius-xs) var(--border-radius-xs);
}

.brand-main {
  position: relative;
  margin-bottom: 16rpx;
}

.tuan-title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: 0;
  display: block;
  line-height: 1.2;
  position: relative;
}

.brand-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.brand-meta-line {
  width: 40rpx;
  height: 2rpx;
  background: var(--border-color);
  position: relative;
}

.brand-meta-line::after {
  content: '';
  position: absolute;
  top: 50%;
  right: -4rpx;
  transform: translateY(-50%);
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: var(--primary-color);
}

.tuan-subtitle {
  font-size: 26rpx;
  color: var(--text-secondary);
  letter-spacing: 0;
  font-weight: 400;
  line-height: 1.55;
}

/* ===== 团购列表 ===== */
.tuan-list {
  flex: 1;
  overflow: hidden;
}

.tuan-list-inner {
  padding: 32rpx;
}

/* ===== 团购卡片 ===== */
.deal-card {
  background: var(--card-color);
  border-radius: var(--border-radius-md);
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: var(--zy-shadow-xs);
  border: 1rpx solid var(--border-color);
}

/* 标题 + 价格区域 */
.deal-top {
  padding: 24rpx 24rpx 16rpx;
}

.deal-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.deal-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  letter-spacing: 0;
  line-height: 1.4;
}

.deal-tag {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: var(--border-radius-xs);
  font-weight: 400;
  flex-shrink: 0;
}

.tag-hot {
  background: var(--primary-light);
  color: var(--primary-color);
}

.tag-count {
  background: var(--primary-light);
  color: var(--text-secondary);
}

.deal-price-info {
  display: flex;
  align-items: baseline;
  margin-top: 16rpx;
  gap: 8rpx;
}

.deal-price-symbol {
  font-size: 24rpx;
  color: var(--primary-color);
  font-weight: 600;
}

.deal-price {
  font-size: 40rpx;
  color: var(--primary-color);
  font-weight: 600;
  line-height: 1.2;
}

.deal-price-from {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 400;
}

.deal-price-original {
  font-size: 24rpx;
  color: var(--text-tertiary);
  text-decoration: line-through;
  font-weight: 400;
}

/* 三张小图区域 */
.deal-images {
  display: flex;
  gap: 16rpx;
  padding: 0 24rpx;
}

.deal-thumb {
  flex: 1;
  height: 160rpx;
  border-radius: var(--border-radius-sm);
  background: var(--primary-light);
}

.deal-thumb-more {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--primary-light);
}

.thumb-more-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 400;
}

/* 底部按钮区域 */
.deal-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  padding: 16rpx 24rpx 24rpx;
}

.deal-action-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin: 0;
  padding: 0;
  border: none;
  line-height: normal;
  background: transparent;
}

.deal-action-btn::after {
  border: none;
}

.btn-share {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  padding: 10rpx 24rpx !important;
  border-radius: var(--border-radius-pill) !important;
  background: var(--primary-light) !important;
  font-size: 24rpx !important;
  min-width: unset !important;
  width: auto !important;
  max-width: unset !important;
  line-height: normal !important;
  margin: 0 !important;
  box-sizing: border-box !important;
}

.action-icon {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.action-text {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.btn-join {
  padding: 16rpx 48rpx;
  border-radius: var(--border-radius-pill);
  background: var(--primary-color);
}

.action-text-join {
  font-size: 26rpx;
  color: #FAFAF6;
  font-weight: 600;
  letter-spacing: 0;
}

/* ===== 加载 / 空态 ===== */
.tuan-loading {
  text-align: center;
  padding: 32rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.loading-more-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 0;
}

.loading-dots {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.loading-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--primary-color);
}

.loading-dot:nth-child(2) {
}

.loading-dot:nth-child(3) {
}

.tuan-no-more {
  text-align: center;
  padding: 32rpx;
  font-size: 24rpx;
  color: var(--text-tertiary);
  letter-spacing: 0;
}

.tuan-empty {
  text-align: center;
  padding: 96rpx 32rpx;
}

.empty-icon {
  font-size: 80rpx;
  display: block;
  opacity: 0.6;
}

.empty-text {
  font-size: 30rpx;
  color: var(--text-secondary);
  margin-top: 24rpx;
  display: block;
  font-weight: 400;
}

.empty-hint {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-top: 8rpx;
  display: block;
}

/* ===== 优惠券弹窗 ===== */
.coupon-popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--overlay-color);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.coupon-popup {
  width: 600rpx;
  background: var(--card-color);
  border-radius: var(--border-radius-lg);
  padding: 48rpx 32rpx 32rpx;
  position: relative;
  box-shadow: var(--zy-shadow-md);
}

.popup-close {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--text-tertiary);
}

.popup-header {
  text-align: center;
  margin-bottom: 32rpx;
}

.popup-title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  line-height: 1.2;
}

.popup-subtitle {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
  display: block;
  line-height: 1.55;
}

.popup-coupon-card {
  background: var(--card-color);
  border-radius: var(--border-radius-sm);
  overflow: hidden;
  margin-bottom: 32rpx;
  border: 1rpx solid var(--border-color);
}

.popup-coupon-ribbon {
  height: 6rpx;
  background: var(--primary-color);
}

.popup-coupon-body {
  display: flex;
  gap: 24rpx;
  padding: 32rpx 24rpx;
}

.popup-coupon-main { flex-shrink: 0; }

.popup-coupon-value {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  color: var(--text-primary);
}

.popup-coupon-num {
  font-size: 64rpx;
  font-weight: 600;
  letter-spacing: 0;
  line-height: 1.2;
  color: var(--text-primary);
}

.popup-coupon-unit {
  font-size: 26rpx;
  font-weight: 400;
  color: var(--text-primary);
}

.popup-coupon-threshold {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
  letter-spacing: 0;
}

.popup-coupon-info {
  flex: 1;
  padding-top: 8rpx;
}

.popup-coupon-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  line-height: 1.55;
}

.popup-claim-btn {
  width: 100%;
  height: 88rpx;
  background: var(--primary-color);
  color: #FAFAF6;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: var(--border-radius-pill);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}
