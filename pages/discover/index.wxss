/* 宠团团 - 艺术画廊展陈风格 */

.tuan-page {
  height: 100vh;
  background: #F5F5F7;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 顶部画廊区 */
.tuan-header {
  background: #FFFFFF;
  padding: 0;
  position: relative;
  overflow: hidden;
  animation: fadeUp 0.6s ease-out;
  padding-bottom: 20rpx;
  flex-shrink: 0;
}

.brand-block {
  padding: 80rpx 48rpx 64rpx;
  position: relative;
}

.brand-block::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, rgba(78, 205, 196, 0.15) 0%, transparent 70%);
  pointer-events: none;
}

.brand-accent-bar {
  position: absolute;
  top: 0;
  left: 48rpx;
  width: 48rpx;
  height: 6rpx;
  background: linear-gradient(90deg, #4ECDC4 0%, #2AB7A9 100%);
  border-radius: 0 0 4rpx 4rpx;
  animation: slideDown 0.5s ease-out;
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.brand-main {
  position: relative;
  margin-bottom: 24rpx;
}

.tuan-title {
  font-size: 64rpx;
  font-weight: 300;
  color: #1D1D1F;
  letter-spacing: 12rpx;
  display: block;
  line-height: 1;
  position: relative;
}

.brand-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.brand-meta-line {
  width: 40rpx;
  height: 2rpx;
  background: #E5E5EA;
  position: relative;
}

.brand-meta-line::after {
  content: '';
  position: absolute;
  top: 50%;
  right: -4rpx;
  transform: translateY(-50%);
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #4ECDC4;
}

.tuan-subtitle {
  font-size: 22rpx;
  color: #8E8E93;
  letter-spacing: 8rpx;
  font-weight: 400;
}

/* 团购列表 */
.tuan-list {
  flex: 1;
  overflow: hidden;
}

.tuan-list-inner {
  padding: 32rpx;
}

/* 团购卡片 */
.deal-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(134, 134, 139, 0.1);
  animation: fadeUp 0.5s ease-out both;
}

/* 标题+价格区域 */
.deal-top {
  padding: 24rpx 24rpx 16rpx;
}

.deal-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.deal-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1D1D1F;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  letter-spacing: 1rpx;
  line-height: 1.4;
}

.deal-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.tag-hot {
  background: linear-gradient(135deg, #FFF5F5 0%, #FFE5E5 100%);
  color: #FF6B6B;
}

.tag-count {
  background: linear-gradient(135deg, #F5F5F7 0%, #E5E5EA 100%);
  color: #8E8E93;
}

.deal-price-info {
  display: flex;
  align-items: baseline;
  margin-top: 12rpx;
  gap: 4rpx;
}

.deal-price-symbol {
  font-size: 22rpx;
  color: #4ECDC4;
  font-weight: 600;
}

.deal-price {
  font-size: 36rpx;
  color: #4ECDC4;
  font-weight: 700;
}

.deal-price-from {
  font-size: 22rpx;
  color: #8E8E93;
  margin-left: 2rpx;
}

.deal-price-original {
  font-size: 22rpx;
  color: #C7C7CC;
  text-decoration: line-through;
  margin-left: 8rpx;
}

/* 三张小图区域 */
.deal-images {
  display: flex;
  gap: 8rpx;
  padding: 0 24rpx;
}

.deal-thumb {
  flex: 1;
  height: 160rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #F5F5F7 0%, #E5E5EA 100%);
}

.deal-thumb-more {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.04);
}

.thumb-more-text {
  font-size: 24rpx;
  color: #8E8E93;
  font-weight: 500;
}

/* 底部按钮区域 */
.deal-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  padding: 20rpx 24rpx 24rpx;
}

.deal-action-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin: 0;
  padding: 0;
  border: none;
  line-height: normal;
  background: transparent;
}

.deal-action-btn::after {
  border: none;
}

.btn-share {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  padding: 10rpx 16rpx !important;
  padding-left: 16rpx !important;
  padding-right: 16rpx !important;
  border-radius: 32rpx !important;
  background: #F5F5F7 !important;
  font-size: 24rpx !important;
  min-width: unset !important;
  width: auto !important;
  max-width: unset !important;
  line-height: normal !important;
  margin: 0 !important;
  box-sizing: border-box !important;
}

.action-icon {
  font-size: 24rpx;
  color: #8E8E93;
}

.action-text {
  font-size: 24rpx;
  color: #8E8E93;
}

.btn-join {
  padding: 14rpx 48rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #4ECDC4 0%, #2AB7A9 100%);
}

.action-text-join {
  font-size: 26rpx;
  color: #FFFFFF;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.tuan-loading,
.tuan-no-more {
  text-align: center;
  padding: 30rpx;
  font-size: 24rpx;
  color: #AEAEB2;
  letter-spacing: 1rpx;
}

.tuan-empty {
  text-align: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  display: block;
  opacity: 0.6;
}

.empty-text {
  font-size: 30rpx;
  color: #8E8E93;
  margin-top: 20rpx;
  display: block;
  font-weight: 500;
}

.empty-hint {
  font-size: 24rpx;
  color: #AEAEB2;
  margin-top: 10rpx;
  display: block;
}

@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(24rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 优惠券弹窗 */
.coupon-popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.coupon-popup {
  width: 600rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 60rpx 48rpx 48rpx;
  position: relative;
  animation: popIn 0.3s ease-out;
}

@keyframes popIn {
  from {
    opacity: 0;
    transform: scale(0.8);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.popup-close {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #999;
}

.popup-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.popup-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1D1D1F;
  display: block;
}

.popup-subtitle {
  font-size: 24rpx;
  color: #8E8E93;
  margin-top: 8rpx;
  display: block;
}

.popup-coupon-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 40rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.popup-coupon-ribbon {
  height: 6rpx;
  background: var(--accent, #C4956A);
}

.popup-coupon-body {
  display: flex;
  gap: 24rpx;
  padding: 32rpx 28rpx;
}

.popup-coupon-main { flex-shrink: 0; }

.popup-coupon-value {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  color: #1D1D1F;
}

.popup-coupon-num {
  font-size: 64rpx;
  font-weight: 300;
  letter-spacing: -2rpx;
  line-height: 1;
}

.popup-coupon-unit {
  font-size: 26rpx;
  font-weight: 400;
  color: #1D1D1F;
}

.popup-coupon-threshold {
  font-size: 22rpx;
  color: #8E8E93;
  margin-top: 10rpx;
  letter-spacing: 1rpx;
}

.popup-coupon-info {
  flex: 1;
  padding-top: 6rpx;
}

.popup-coupon-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1D1D1F;
  display: block;
  line-height: 1.3;
}

.popup-claim-btn {
  width: 100%;
  height: 88rpx;
  background: var(--accent, #C4956A);
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 44rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}
