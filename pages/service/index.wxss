/* ================================================================
   pages/service/index · AROORO 宠物服务页 · Haute-Luxury Editorial
   ----------------------------------------------------------------
   设计语言：奶油米白底 + 鼠尾草绿服务板块色 + 香槟金点缀
   · 杂志式大标题 Hero 区
   · 发丝描边位置选择卡片
   · 全宽主 CTA 预约按钮（深森林绿+金字）
   · 三栏快捷入口（克制图标+字距标签）
   Skyline 兼容：仅 transform/opacity 动画，无 :active/backdrop-filter
   ================================================================ */

.page {
  padding: 0 var(--page-padding, 48rpx);
  padding-bottom: calc(var(--zy-space-4xl) + env(safe-area-inset-bottom, 0px));
}

/* ====== 顶部品牌 Hero ====== */
/* ====== 位置选择卡片 ====== */
.selector-card {
  background: transparent;
  border: 1rpx solid rgba(26, 26, 23, 0.14);
  border-radius: var(--zy-radius-lg);
  padding: var(--zy-space-lg) var(--zy-space-lg);
  margin-bottom: var(--zy-space-xl);
}

.selector-row {
  display: flex;
  align-items: center;
}

.location-row {
  gap: 0;
}

.city-selector-inline {
  display: flex;
  align-items: center;
  gap: var(--zy-space-sm2);
  flex-shrink: 0;
  padding-right: var(--zy-space-lg);
  transition-property: transform, opacity;
  transition-duration: 160ms;
  transition-timing-function: cubic-bezier(0.25, 0.1, 0.25, 1);
}

.city-selector-inline--pressed {
  transform: scale(0.96);
  opacity: 0.7;
}

.city-name {
  font-family: var(--font-sans);
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-primary, #1A1A17);
  letter-spacing: 0.02em;
  max-width: 160rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.city-name.placeholder {
  color: var(--text-tertiary);
  font-weight: 400;
}

.city-arrow {
  width: 12rpx;
  height: 12rpx;
  border-right: 2rpx solid var(--text-secondary, #5A564C);
  border-bottom: 2rpx solid var(--text-secondary, #5A564C);
  transform: rotate(45deg);
  margin-top: -4rpx;
  flex-shrink: 0;
}

.location-divider {
  width: 1rpx;
  height: 48rpx;
  background: var(--hairline, rgba(26,26,23,0.08));
  flex-shrink: 0;
}

.selector-left {
  flex: 1;
  padding: 0 var(--zy-space-lg);
  min-width: 0;
  transition-property: transform, opacity;
  transition-duration: 160ms;
  transition-timing-function: cubic-bezier(0.25, 0.1, 0.25, 1);
}

.selector-left--pressed {
  transform: scale(0.98);
  opacity: 0.7;
}

.selector-label {
  display: block;
  font-family: var(--font-sans);
  font-size: 20rpx;
  font-weight: 400;
  color: var(--text-tertiary);
  letter-spacing: 0.12em;
  margin-bottom: 6rpx;
}

.selector-value {
  display: block;
  font-family: var(--font-sans);
  font-size: 28rpx;
  font-weight: 400;
  color: var(--text-primary, #1A1A17);
  letter-spacing: 0.01em;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.selector-value.secondary {
  color: var(--text-tertiary);
}

.selector-right {
  display: flex;
  align-items: center;
  gap: var(--zy-space-sm);
  flex-shrink: 0;
  padding-left: var(--zy-space-lg);
  transition-property: transform, opacity;
  transition-duration: 160ms;
  transition-timing-function: cubic-bezier(0.25, 0.1, 0.25, 1);
}

.selector-right--pressed {
  transform: scale(0.96);
  opacity: 0.7;
}

.location-text {
  font-family: var(--font-sans);
  font-size: 26rpx;
  font-weight: 400;
  color: var(--text-primary, #1A1A17);
  letter-spacing: 0.06em;
}

.selector-arrow {
  width: 10rpx;
  height: 10rpx;
  border-right: 1rpx solid var(--text-tertiary);
  border-bottom: 1rpx solid var(--text-tertiary);
  transform: rotate(-45deg);
  margin-top: -2rpx;
}

/* ====== 主 CTA 预约按钮 ====== */
.book-btn-section {
  margin-bottom: var(--zy-space-2xl);
}

.book-btn {
  width: 100%;
  height: 104rpx;
  background: var(--primary-color);
  border-radius: var(--zy-radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  padding: 0;
  margin: 0;
  position: relative;
  overflow: hidden;
  transition-property: transform, opacity;
  transition-duration: 160ms;
  transition-timing-function: cubic-bezier(0.25, 0.1, 0.25, 1);
}

.book-btn::after {
  border: none;
}

.book-btn--pressed {
  transform: scale(0.98);
  opacity: 0.92;
}

.book-text {
  font-family: var(--font-sans);
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-on-primary, #F7F5EF);
  letter-spacing: 0.2em;
}

/* ====== 快捷操作三栏 ====== */
.quick-actions {
  display: flex;
  justify-content: space-between;
  gap: var(--zy-space-lg);
}

/* wrapper 承载入场动画（zy-enter），不参与交互 */
.action-item-wrap {
  flex: 1;
}

/* 内层承载卡片视觉 + hover-class 交互，与动画分层避免 forwards 冲突 */
.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--zy-space-lg);
  padding: var(--zy-space-lg) var(--zy-space-sm2);
  background: transparent;
  border: 1rpx solid rgba(26, 26, 23, 0.14);
  border-radius: var(--zy-radius-lg);
  transition-property: transform, opacity;
  transition-duration: 160ms;
  transition-timing-function: cubic-bezier(0.25, 0.1, 0.25, 1);
}

.action-item--pressed {
  transform: scale(0.96);
  opacity: 0.85;
}

/* 快捷入口章牌：与 profile 页同类名（exhibit-medallion/medallion-img，页间不共享 wxss） */
.exhibit-medallion {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(26, 26, 23, 0.22);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.exhibit-medallion::before {
  content: '';
  position: absolute;
  top: 7rpx;
  left: 7rpx;
  right: 7rpx;
  bottom: 7rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(26, 26, 23, 0.08);
}

.medallion-img {
  width: 46rpx;
  height: 46rpx;
}

.action-text {
  font-family: var(--font-sans);
  font-size: 24rpx;
  font-weight: 400;
  color: var(--text-primary, #1A1A17);
  letter-spacing: 0.1em;
}

/* ====== 底部间距（避开 TabBar） ====== */
.bottom-spacer {
  height: 40rpx;
}
