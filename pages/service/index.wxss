/* ================================================================
   pages/service/index · AROORO 宠物服务页 · Haute-Luxury Editorial
   ----------------------------------------------------------------
   设计语言：奶油米白底 + 鼠尾草绿服务板块色 + 香槟金点缀
   · 杂志式大标题 Hero 区
   · 发丝描边位置选择卡片
   · 全宽主 CTA 预约按钮（深森林绿+金字）
   · 三栏快捷入口（克制图标+字距标签）
   Skyline 兼容：仅 transform/opacity 动画，无 :active/backdrop-filter
   ================================================================ */

page {
  height: 100vh;
}

.page {
  min-height: 100vh;
  padding: 0 var(--page-padding, 48rpx);
  padding-bottom: calc(var(--zy-space-4xl) + env(safe-area-inset-bottom, 0px));
}

/* ====== 顶部品牌 Hero ====== */
.gallery-header {
  padding-top: var(--zy-space-xl);
  padding-bottom: var(--zy-space-2xl);
}

.brand-block {
  position: relative;
}

.brand-accent-bar {
  width: 48rpx;
  height: 2rpx;
  background: var(--accent-color, #C9A24B);
  margin-bottom: var(--zy-space-lg);
}

.brand-main {
  margin-bottom: var(--zy-space-lg);
}

.brand-text {
  font-family: var(--font-sans);
  font-size: 72rpx;
  font-weight: 300;
  color: var(--text-primary, #1A1A17);
  letter-spacing: -0.01em;
  line-height: 1.1;
}

.brand-meta {
  display: flex;
  align-items: center;
  gap: var(--zy-space-lg);
}

.brand-meta-line {
  width: 32rpx;
  height: 1rpx;
  background: var(--text-tertiary);
  opacity: 0.5;
}

.brand-subtitle {
  font-family: var(--font-sans);
  font-size: 24rpx;
  font-weight: 300;
  color: var(--text-tertiary);
  letter-spacing: 0.18em;
}

/* ====== 位置选择卡片 ====== */
.selector-card {
  background: var(--card-color, #FFFFFF);
  border: 1rpx solid var(--hairline, rgba(26,26,23,0.08));
  border-radius: var(--zy-radius-lg);
  padding: var(--zy-space-lg) var(--zy-space-lg);
  margin-bottom: var(--zy-space-xl);
}

.selector-row {
  display: flex;
  align-items: center;
}

.location-row {
  gap: 0;
}

.city-selector-inline {
  display: flex;
  align-items: center;
  gap: var(--zy-space-sm2);
  flex-shrink: 0;
  padding-right: var(--zy-space-lg);
  transition-property: transform, opacity;
  transition-duration: 160ms;
  transition-timing-function: cubic-bezier(0.25, 0.1, 0.25, 1);
}

.city-selector-inline--pressed {
  transform: scale(0.96);
  opacity: 0.7;
}

.city-name {
  font-family: var(--font-sans);
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-primary, #1A1A17);
  letter-spacing: 0.02em;
  max-width: 160rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.city-name.placeholder {
  color: var(--text-tertiary);
  font-weight: 400;
}

.city-arrow {
  width: 12rpx;
  height: 12rpx;
  border-right: 2rpx solid var(--text-secondary, #5A564C);
  border-bottom: 2rpx solid var(--text-secondary, #5A564C);
  transform: rotate(45deg);
  margin-top: -4rpx;
  flex-shrink: 0;
}

.location-divider {
  width: 1rpx;
  height: 48rpx;
  background: var(--hairline, rgba(26,26,23,0.08));
  flex-shrink: 0;
}

.selector-left {
  flex: 1;
  padding: 0 var(--zy-space-lg);
  min-width: 0;
  transition-property: transform, opacity;
  transition-duration: 160ms;
  transition-timing-function: cubic-bezier(0.25, 0.1, 0.25, 1);
}

.selector-left--pressed {
  transform: scale(0.98);
  opacity: 0.7;
}

.selector-label {
  display: block;
  font-family: var(--font-sans);
  font-size: 20rpx;
  font-weight: 400;
  color: var(--text-tertiary);
  letter-spacing: 0.12em;
  margin-bottom: 6rpx;
}

.selector-value {
  display: block;
  font-family: var(--font-sans);
  font-size: 28rpx;
  font-weight: 400;
  color: var(--text-primary, #1A1A17);
  letter-spacing: 0.01em;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.selector-value.secondary {
  color: var(--text-tertiary);
}

.selector-right {
  display: flex;
  align-items: center;
  gap: var(--zy-space-sm);
  flex-shrink: 0;
  padding-left: var(--zy-space-lg);
  transition-property: transform, opacity;
  transition-duration: 160ms;
  transition-timing-function: cubic-bezier(0.25, 0.1, 0.25, 1);
}

.selector-right--pressed {
  transform: scale(0.96);
  opacity: 0.7;
}

.location-text {
  font-family: var(--font-sans);
  font-size: 26rpx;
  font-weight: 400;
  color: var(--text-primary, #1A1A17);
  letter-spacing: 0.06em;
}

.selector-arrow {
  width: 10rpx;
  height: 10rpx;
  border-right: 1rpx solid var(--text-tertiary);
  border-bottom: 1rpx solid var(--text-tertiary);
  transform: rotate(-45deg);
  margin-top: -2rpx;
}

/* ====== 主 CTA 预约按钮 ====== */
.book-btn-section {
  margin-bottom: var(--zy-space-2xl);
}

.book-btn {
  width: 100%;
  height: 104rpx;
  background: var(--primary-color, #1F3A1F);
  border-radius: var(--zy-radius-pill);
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  padding: 0;
  margin: 0;
  position: relative;
  overflow: hidden;
  transition-property: transform, opacity;
  transition-duration: 160ms;
  transition-timing-function: cubic-bezier(0.25, 0.1, 0.25, 1);
}

.book-btn::after {
  border: none;
}

.book-btn--pressed {
  transform: scale(0.98);
  opacity: 0.92;
}

.book-text {
  font-family: var(--font-sans);
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-on-primary, #F7F5EF);
  letter-spacing: 0.2em;
}

/* ====== 快捷操作三栏 ====== */
.quick-actions {
  display: flex;
  justify-content: space-between;
  gap: var(--zy-space-lg);
}

/* wrapper 承载入场动画（zy-enter），不参与交互 */
.action-item-wrap {
  flex: 1;
}

/* 内层承载卡片视觉 + hover-class 交互，与动画分层避免 forwards 冲突 */
.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--zy-space-lg);
  padding: var(--zy-space-lg) var(--zy-space-sm2);
  background: var(--card-color, #FFFFFF);
  border: 1rpx solid var(--hairline, rgba(26,26,23,0.08));
  border-radius: var(--zy-radius-lg);
  transition-property: transform, opacity;
  transition-duration: 160ms;
  transition-timing-function: cubic-bezier(0.25, 0.1, 0.25, 1);
}

.action-item--pressed {
  transform: scale(0.96);
  opacity: 0.85;
}

.action-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pricing-wrap {
  background: var(--accent-wash, #F8F3E6);
}

.guide-wrap {
  background: var(--primary-wash, #F2F5EC);
}

.faq-wrap {
  background: var(--boarding-tint, rgba(139,99,80,0.08));
}

.action-icon {
  width: 40rpx;
  height: 40rpx;
  position: relative;
}

/* 价目表图标：¥ 形状（用横线+竖线表示） */
.pricing-icon {
  border-top: 2rpx solid var(--accent-color, #C9A24B);
  border-bottom: 2rpx solid var(--accent-color, #C9A24B);
}

.pricing-icon::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 20rpx;
  height: 2rpx;
  background: var(--accent-color, #C9A24B);
  transform: translate(-50%, -50%);
}

/* 指引图标：指南针/方向 */
.guide-icon {
  border: 2rpx solid var(--primary-color, #1F3A1F);
  border-radius: 50%;
}

.guide-icon::before {
  content: '';
  position: absolute;
  top: 4rpx;
  left: 50%;
  width: 0;
  height: 0;
  border-left: 6rpx solid transparent;
  border-right: 6rpx solid transparent;
  border-bottom: 12rpx solid var(--primary-color, #1F3A1F);
  transform: translateX(-50%);
}

/* FAQ图标：问号 */
.faq-icon {
  border: 2rpx solid var(--boarding-primary, #8B6350);
  border-radius: 50%;
}

.faq-icon::before {
  content: '?';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -58%);
  font-size: 28rpx;
  font-weight: 400;
  color: var(--boarding-primary, #8B6350);
  font-family: var(--font-sans);
  line-height: 1;
}

.action-text {
  font-family: var(--font-sans);
  font-size: 24rpx;
  font-weight: 400;
  color: var(--text-primary, #1A1A17);
  letter-spacing: 0.1em;
}

/* ====== 底部间距（避开 TabBar） ====== */
.bottom-spacer {
  height: 40rpx;
}
