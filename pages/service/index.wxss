/* ====== 页面容器 ====== */
.page {
  background-color: var(--background-color);
  min-height: 100vh;
}

/* ====== 顶部画廊区 ====== */
.gallery-header {
  padding: 0;
  position: relative;
  overflow: hidden;
  background: var(--card-color);
  animation: fadeUp 0.6s ease-out;
  padding-bottom: 20rpx;
}

.brand-block {
  padding: 80rpx 48rpx 64rpx;
  position: relative;
}

.brand-block::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, rgba(78, 205, 196, 0.15) 0%, transparent 70%);
  pointer-events: none;
}

.brand-accent-bar {
  position: absolute;
  top: 0;
  left: 48rpx;
  width: 48rpx;
  height: 6rpx;
  background: linear-gradient(90deg, var(--activity-primary) 0%, var(--activity-primary-mid) 100%);
  border-radius: 0 0 4rpx 4rpx;
  animation: slideDown 0.5s ease-out;
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.brand-main {
  position: relative;
  margin-bottom: 24rpx;
}

.brand-text {
  font-size: 64rpx;
  font-weight: 300;
  color: var(--text-primary);
  letter-spacing: 12rpx;
  display: block;
  line-height: 1;
  position: relative;
}

.brand-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.brand-meta-line {
  width: 40rpx;
  height: 2rpx;
  background: var(--gray-200);
  position: relative;
}

.brand-meta-line::after {
  content: '';
  position: absolute;
  top: 50%;
  right: -4rpx;
  transform: translateY(-50%);
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: var(--activity-primary);
}

.brand-subtitle {
  font-size: 22rpx;
  color: var(--text-secondary);
  letter-spacing: 8rpx;
  font-weight: 400;
}

@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(24rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ====== 选择器卡片 - 展览标签风格 ====== */
.selector-card {
  margin: 32rpx 40rpx;
  background: var(--card-color);
  border-radius: 24rpx;
  padding: 32rpx 40rpx 40rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.08);
  position: relative;
  z-index: 10;
  transition: transform 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.selector-card:active {
  transform: scale(0.99);
}

/* 城市选择器 */
.city-selector-inline {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
  margin-bottom: 24rpx;
}

.city-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--activity-primary);
}

.city-name.placeholder {
  color: var(--text-secondary);
  font-weight: 400;
}

.city-arrow {
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-top: 10rpx solid var(--activity-primary);
}

/* 分隔线 */
.location-divider {
  width: 1rpx;
  height: 48rpx;
  background: rgba(0, 0, 0, 0.08);
  margin: 0 24rpx;
  flex-shrink: 0;
}

.selector-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.location-row {
  padding: 24rpx 0;
  flex-wrap: nowrap;
}

.selector-left {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
}

.selector-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  letter-spacing: 1rpx;
}

.selector-value {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.selector-value.secondary {
  color: var(--text-secondary);
  font-weight: 400;
}

.selector-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.location-icon-wrap {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.location-icon {
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid var(--activity-primary);
  border-radius: 50%;
  position: relative;
}

.location-icon::after {
  content: '';
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  background: var(--activity-primary);
  border-radius: 50%;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.location-text {
  font-size: 26rpx;
  color: var(--activity-primary);
  font-weight: 500;
}

.selector-arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 3rpx solid var(--text-tertiary);
  border-right: 3rpx solid var(--text-tertiary);
  transform: rotate(45deg);
}

.selector-divider {
  height: 1rpx;
  background: rgba(0, 0, 0, 0.06);
  margin: 24rpx 0;
}

/* 宠物类型行 */
.pet-type-row {
  padding: 24rpx 0 8rpx;
}

.pet-selector {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.pet-type-arrow {
  width: 20rpx;
  height: 20rpx;
  border-top: 3rpx solid var(--text-tertiary);
  border-right: 3rpx solid var(--text-tertiary);
  transform: rotate(45deg);
  flex-shrink: 0;
  margin-top: 12rpx;
}

/* ====== 预约按钮 - 极简风格 ====== */
.book-btn-section {
  padding: 0 40rpx;
  margin-bottom: 48rpx;
}

.book-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, var(--activity-primary) 0%, var(--activity-primary-mid) 100%);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(78, 205, 196, 0.3);
  transition: all 0.3s ease;
}

.book-btn::after {
  border: none;
}

.book-btn:active {
  background: linear-gradient(135deg, var(--activity-primary-mid) 0%, var(--activity-primary-mid) 100%);
  transform: scale(0.98);
  box-shadow: 0 2rpx 6rpx rgba(78, 205, 196, 0.2);
}

.book-text {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--card-color);
  letter-spacing: 2rpx;
}

/* ====== 快捷入口 - 网格展陈 ====== */
.quick-actions {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx;
  padding: 0 40rpx;
  margin-bottom: 48rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 32rpx 12rpx;
  background: var(--card-color);
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.action-item:active {
  transform: scale(0.96);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.action-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.2s ease;
}

.action-item:active .action-icon-wrap {
  transform: scale(0.92);
}

.pricing-wrap {
  background: linear-gradient(135deg, rgba(255, 159, 10, 0.15) 0%, rgba(255, 103, 35, 0.08) 100%);
}

.record-wrap {
  background: linear-gradient(135deg, rgba(52, 199, 89, 0.15) 0%, rgba(48, 209, 88, 0.08) 100%);
}

.guide-wrap {
  background: linear-gradient(135deg, rgba(0, 122, 255, 0.15) 0%, rgba(0, 99, 216, 0.08) 100%);
}

.faq-wrap {
  background: linear-gradient(135deg, rgba(191, 90, 242, 0.15) 0%, rgba(175, 82, 222, 0.08) 100%);
}

.action-icon {
  width: 40rpx;
  height: 40rpx;
  position: relative;
}

/* 收费图标 */
.pricing-icon::before {
  content: '';
  position: absolute;
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid var(--warning-color);
  border-radius: 50%;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.pricing-icon::after {
  content: '';
  position: absolute;
  width: 4rpx;
  height: 16rpx;
  background: var(--warning-color);
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  border-radius: 2rpx;
}

/* 记录图标 */
.record-icon::before {
  content: '';
  position: absolute;
  width: 32rpx;
  height: 24rpx;
  background: var(--success-color);
  border-radius: 4rpx;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.record-icon::after {
  content: '';
  position: absolute;
  width: 20rpx;
  height: 3rpx;
  background: var(--card-color);
  top: 12rpx;
  left: 50%;
  transform: translateX(-50%);
  box-shadow: 0 6rpx 0 0 var(--card-color), 0 12rpx 0 0 var(--card-color);
}

/* 指引图标 */
.guide-icon::before {
  content: '';
  position: absolute;
  width: 28rpx;
  height: 28rpx;
  background: var(--info-color);
  clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

/* 问题图标 */
.faq-icon::before {
  content: '';
  position: absolute;
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid #BF5AF2;
  border-radius: 50%;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.faq-icon::after {
  content: '?';
  position: absolute;
  font-size: 22rpx;
  font-weight: 700;
  color: #BF5AF2;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.action-text {
  font-size: 22rpx;
  color: var(--gray-900);
  font-weight: 500;
  text-align: center;
  letter-spacing: 0.5rpx;
}

/* ====== 底部间距 ====== */
.bottom-spacer {
  height: 160rpx;
}
