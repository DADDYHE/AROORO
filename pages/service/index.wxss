/* ====== 页面容器 ====== */
.page {
  background-color: var(--background-color);
  min-height: 100vh;
}

/* ====== 顶部画廊区 ====== */
.gallery-header {
  padding: 0;
  position: relative;
  overflow: hidden;
  background: var(--card-color);
  padding-bottom: 24rpx;
}

.brand-block {
  padding: 80rpx 48rpx 64rpx;
  position: relative;
}

.brand-block::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, var(--primary-light) 0%, transparent 70%);
  pointer-events: none;
}

.brand-accent-bar {
  position: absolute;
  top: 0;
  left: 48rpx;
  width: 48rpx;
  height: 6rpx;
  background: var(--gradient-primary);
  border-radius: 0 0 4rpx 4rpx;
}

.brand-main {
  position: relative;
  margin-bottom: 24rpx;
}

.brand-text {
  font-size: 64rpx;
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: 12rpx;
  display: block;
  line-height: 1;
  position: relative;
}

.brand-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.brand-meta-line {
  width: 40rpx;
  height: 2rpx;
  background: var(--border-color);
  position: relative;
}

.brand-meta-line::after {
  content: '';
  position: absolute;
  top: 50%;
  right: -4rpx;
  transform: translateY(-50%);
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: var(--primary-color);
}

.brand-subtitle {
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 8rpx;
  font-weight: 400;
}

/* ====== 选择器卡片 - 展览标签风格 ====== */
.selector-card {
  margin: 32rpx;
  background: var(--card-color);
  border-radius: var(--border-radius-md);
  padding: 32rpx 32rpx 48rpx;
  box-shadow: var(--zy-shadow-sm);
  position: relative;
  z-index: 10;
}

/* 城市选择器 */
.city-selector-inline {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
  margin-bottom: 24rpx;
}

.city-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--primary-color);
}

.city-name.placeholder {
  color: var(--text-secondary);
  font-weight: 400;
}

.city-arrow {
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-top: 10rpx solid var(--primary-color);
}

/* 分隔线 */
.location-divider {
  width: 1rpx;
  height: 48rpx;
  background: var(--divider-color);
  margin: 0 24rpx;
  flex-shrink: 0;
}

.selector-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.location-row {
  padding: 24rpx 0;
  flex-wrap: nowrap;
}

.selector-left {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
}

.selector-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 1rpx;
  font-weight: 400;
}

.selector-value {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.selector-value.secondary {
  color: var(--text-secondary);
  font-weight: 400;
}

.selector-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.location-icon-wrap {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.location-icon {
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid var(--primary-color);
  border-radius: 50%;
  position: relative;
}

.location-icon::after {
  content: '';
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  background: var(--primary-color);
  border-radius: 50%;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.location-text {
  font-size: 26rpx;
  color: var(--primary-color);
  font-weight: 400;
}

.selector-arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 3rpx solid var(--text-tertiary);
  border-right: 3rpx solid var(--text-tertiary);
  transform: rotate(45deg);
}

.selector-divider {
  height: 1rpx;
  background: var(--divider-color);
  margin: 24rpx 0;
}

/* 宠物类型行 */
.pet-type-row {
  padding: 24rpx 0 8rpx;
}

.pet-selector {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.pet-type-arrow {
  width: 20rpx;
  height: 20rpx;
  border-top: 3rpx solid var(--text-tertiary);
  border-right: 3rpx solid var(--text-tertiary);
  transform: rotate(45deg);
  flex-shrink: 0;
  margin-top: 16rpx;
}

/* ====== 预约按钮 - 极简风格 ====== */
.book-btn-section {
  padding: 0 32rpx;
  margin-bottom: 48rpx;
}

.book-btn {
  width: 100%;
  height: 88rpx;
  background: var(--gradient-primary);
  border-radius: var(--border-radius-pill);
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: var(--shadow-glow-primary-btn);
}

.book-btn::after {
  border: none;
}

.book-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #FAFAF6;
  letter-spacing: 2rpx;
}

/* ====== 快捷入口 - 网格展陈 ====== */
.quick-actions {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx;
  padding: 0 32rpx;
  margin-bottom: 48rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 32rpx 16rpx;
  background: var(--card-color);
  border-radius: var(--border-radius-md);
  box-shadow: var(--zy-shadow-xs);
}

.action-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--border-radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
}

.pricing-wrap {
  background: var(--mall-tint);
}

.record-wrap {
  background: var(--feeding-tint);
}

.guide-wrap {
  background: var(--activity-tint);
}

.faq-wrap {
  background: var(--primary-light);
}

.action-icon {
  width: 40rpx;
  height: 40rpx;
  position: relative;
}

/* 收费图标 */
.pricing-icon::before {
  content: '';
  position: absolute;
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid var(--warning-color);
  border-radius: 50%;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.pricing-icon::after {
  content: '';
  position: absolute;
  width: 4rpx;
  height: 16rpx;
  background: var(--warning-color);
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  border-radius: 2rpx;
}

/* 记录图标 */
.record-icon::before {
  content: '';
  position: absolute;
  width: 32rpx;
  height: 24rpx;
  background: var(--success-color);
  border-radius: 4rpx;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.record-icon::after {
  content: '';
  position: absolute;
  width: 20rpx;
  height: 3rpx;
  background: var(--card-color);
  top: 12rpx;
  left: 50%;
  transform: translateX(-50%);
  box-shadow: 0 6rpx 0 0 var(--card-color), 0 12rpx 0 0 var(--card-color);
}

/* 指引图标 */
.guide-icon::before {
  content: '';
  position: absolute;
  width: 28rpx;
  height: 28rpx;
  background: var(--info-color);
  clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

/* 问题图标 */
.faq-icon::before {
  content: '';
  position: absolute;
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid var(--primary-color);
  border-radius: 50%;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.faq-icon::after {
  content: '?';
  position: absolute;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--primary-color);
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.action-text {
  font-size: 24rpx;
  color: var(--text-primary);
  font-weight: 400;
  text-align: center;
  letter-spacing: 0.5rpx;
}

/* ====== 底部间距 ====== */
.bottom-spacer {
  height: 160rpx;
}
