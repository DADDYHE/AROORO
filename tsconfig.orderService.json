{
  "extends": "./tsconfig.common.json",
  "compilerOptions": {
    "outDir": "./cloudfunctions",
    "rootDir": "./cloudfunctions",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "declaration": true
  },
  "include": [
    "cloudfunctions/orderService/index.ts",
    "cloudfunctions/orderService/orders.ts",
    "cloudfunctions/orderService/stats.ts",
    "cloudfunctions/orderService/common/boarding-state-machine.ts"
  ],
  "exclude": [
    "node_modules",
    "cloudfunctions/orderService/node_modules"
  ]
}
