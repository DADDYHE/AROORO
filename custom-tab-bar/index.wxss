/* custom-tab-bar/index.wxss */
.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 140rpx;
  background: #ffffff;
  display: flex;
  justify-content: space-around;
  align-items: center;
  box-shadow: 0 -2rpx 16rpx rgba(0, 0, 0, 0.05);
  z-index: 1000;
  padding-top: 0rpx;
  padding-bottom: 30rpx;
  box-sizing: border-box;
  overflow: visible;
}

.tab-bar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 100%;
  border-radius: 24rpx;
  position: relative;
  overflow: hidden;
  touch-action: manipulation; /* 防止双击缩放 */
}

.tab-bar-item::before {
  content: '';
  position: absolute;
  top: 10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 80%;
  height: 0;
  background: linear-gradient(135deg, #4ECDC4 0%, #26A69A 100%);
  border-radius: 24rpx;
  transition: height 0.15s cubic-bezier(0.4, 0, 0.2, 1);
  z-index: 0;
  overflow: hidden;
}

.tab-bar-item.active::before {
  height: 90%;
  box-shadow: 0 4rpx 16rpx rgba(78, 205, 196, 0.4), 0 0 20rpx rgba(78, 205, 196, 0.2);
}

.tab-bar-item.active::after {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.3) 0%, transparent 60%);
  animation: shimmer 3s ease-in-out infinite;
  z-index: 1;
  pointer-events: none;
}

@keyframes shimmer {
  0%, 100% {
    transform: translate(-30%, -30%);
    opacity: 0;
  }
  50% {
    transform: translate(30%, 30%);
    opacity: 1;
  }
}

.tab-bar-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 8rpx;
  position: relative;
  z-index: 1;
  transition: transform 0.15s cubic-bezier(0.4, 0, 0.2, 1);
}

.tab-bar-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #666666;
  line-height: 1;
  position: relative;
  z-index: 1;
  transition: color 0.15s cubic-bezier(0.4, 0, 0.2, 1);
}

.tab-bar-item.active .tab-bar-text {
  color: #ffffff !important;
  font-weight: 700;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.1);
}

.tab-bar-item.active .tab-bar-icon {
  transform: scale(1.1);
  filter: drop-shadow(0 1rpx 2rpx rgba(0, 0, 0, 0.1));
}

/* 添加平滑的切换特效 */
.tab-bar-item {
  transition: all 0.15s cubic-bezier(0.4, 0, 0.2, 1);
}

/* 确保 active 状态的样式优先级更高，防止被其他样式覆盖 */
.tab-bar-item.active {
  /* 强制保持 active 状态的样式 */
}

/* 未读消息红点样式 */

@keyframes badge-pop {
  0% {
    transform: scale(0);
    opacity: 0;
  }
  50% {
    transform: scale(1.2);
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

/* 中间一键报名按钮样式 */
.tab-bar-item-center {
  position: relative;
  border-radius: 0 !important;
  overflow: visible !important;
  flex: 0 0 0 !important;
}

/* 禁用中间按钮的 ::before 和 ::after 伪元素（即绿色背景动画） */
.tab-bar-item-center::before,
.tab-bar-item-center::after {
  display: none !important;
}

.center-button {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFD93D 0%, #A8E063 50%, #56AB2F 100%);
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  position: relative;
  overflow: visible;
  transition: all 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  box-shadow:
    0 8rpx 32rpx rgba(168, 224, 99, 0.4),
    0 16rpx 48rpx rgba(86, 171, 47, 0.2),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.4);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  margin-top: -56rpx;
}

/* 外层光晕 */
.center-button::before {
  content: '';
  position: absolute;
  top: -6rpx;
  left: -6rpx;
  right: -6rpx;
  bottom: -6rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(255, 107, 107, 0.3) 0%, rgba(255, 94, 154, 0.05) 100%);
  z-index: -1;
  animation: halo-pulse 3s ease-in-out infinite;
}

@keyframes halo-pulse {
  0%, 100% {
    opacity: 0.5;
    transform: scale(1);
  }
  50% {
    opacity: 1;
    transform: scale(1.08);
  }
}

/* 顶部高光 */
.center-button::after {
  content: '';
  position: absolute;
  top: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 70%;
  height: 40rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.5) 0%, rgba(255, 255, 255, 0) 100%);
  border-radius: 50%;
  z-index: 1;
}

.center-button:active {
  transform: scale(0.95);
  box-shadow:
    0 4rpx 16rpx rgba(255, 107, 107, 0.25),
    0 8rpx 24rpx rgba(255, 107, 107, 0.1),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.3);
}

.center-button-icon {
  width: 48rpx;
  height: 48rpx;
  filter: brightness(0) invert(1) drop-shadow(0 1rpx 1rpx rgba(0, 0, 0, 0.1));
  position: relative;
  z-index: 2;
  margin-bottom: 0;
}

.center-button-text {
  font-size: 16rpx;
  font-weight: 600;
  color: #ffffff;
  line-height: 1;
  position: relative;
  z-index: 2;
  letter-spacing: 1rpx;
  margin-top: 4rpx;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.1);
}

.tab-bar-item-center.active .center-button {
  background: linear-gradient(135deg, #4ECDC4 0%, #26A69A 50%, #2196F3 100%);
  box-shadow:
    0 8rpx 32rpx rgba(78, 205, 196, 0.4),
    0 16rpx 48rpx rgba(78, 205, 196, 0.2),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.4);
}

.tab-bar-item-center.active .center-button::before {
  background: linear-gradient(135deg, rgba(78, 205, 196, 0.35) 0%, rgba(33, 150, 243, 0.05) 100%);
}
