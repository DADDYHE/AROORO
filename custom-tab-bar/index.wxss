/* ================================================================
   custom-tab-bar/index.wxss · AROORO TabBar · Haute-Luxury C6
   ----------------------------------------------------------------
   高奢 TabBar（C6 融合方案）：
     · 暖石纸纹底座（#ECE4D4）+ 金发丝顶线
     · 选中指示：金圆点 = 图标容器（金平涂 + 金晕，取代旧顶部短线）
     · 中央按钮：香槟金平涂 + 深绿实环背衬 + 金属高光（金 CTA 化）
     · 图标线条细，文字极轻；选中态切换炭墨资产
   ----------------------------------------------------------------
   设计系统：styles/theme-teal.wxss（深森林绿体系 · 事实生效层）
   注意：styles/design-tokens.wxss 的 --zy-tabbar-* 为橄榄绿旧值，
        已被 app.wxss 中后置的 theme-teal.wxss 覆盖，勿直接依赖。
   ================================================================ */

/* 显式导入令牌层：即使组件样式隔离，也保证令牌在本组件作用域可解析 */
@import '../styles/theme-teal.wxss';

/* ================================================================
   启动屏覆盖层
   ================================================================ */
.splash-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100vh;
  z-index: 99999;
  background: var(--zy-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 1;
  transition-property: opacity;
  transition-duration: 900ms;
  transition-timing-function: cubic-bezier(0.19, 1, 0.22, 1);
}

.splash-overlay.splash-fade-out {
  opacity: 0;
  pointer-events: none;
}

.splash-image {
  width: 100%;
  height: 100%;
}

/* ================================================================
   导航栏容器 — 暖石纸纹底 + 金发丝顶线
   ================================================================ */
.tab-bar {
  /* ---- 组件内局部令牌 ----------------------------------------
     声明在 .tab-bar 而非 :host：本组件 WXML 用 <root-portal> 包裹，
     子树会被搬出宿主节点，:host 上的自定义属性无法继承进来。
     .tab-bar 是 portal 子树的根，其后代（中心按钮等）均可继承。
     以下值在 theme-teal 中无精确等价物，就地令牌化以保证零外观改变。 */
  --tb-bar-bg: rgba(236, 228, 212, 0.96);            /* 暖石浅底（#ECE4D4 @0.96，= --zy-paper-fallback 值）；DADDY 选定暖石回归 */
  --tb-paper-noise: url("data:image/png;base64,");   /* 纸纹 base64 = styles/design-tokens.wxss --zy-paper-noise 同源值（逐字符复制，48×48 · 4% alpha） */
  --tb-center-bg: var(--zy-accent);                /* 香槟金平涂底（引用 theme-teal 活令牌 #C9A24B） */
  --tb-center-shadow:
    0 6rpx 20rpx rgba(31, 58, 31, 0.40),
    0 2rpx 8rpx rgba(31, 58, 31, 0.20);            /* 深林绿投影（非橄榄绿） */
  --tb-center-shadow-active:
    0 16rpx 44rpx rgba(31, 58, 31, 0.46),
    0 4rpx 14rpx rgba(31, 58, 31, 0.28);
  --tb-center-ring: 0 0 0 6rpx #1F3A1F;               /* 深绿实环 = var(--zy-primary-700)；暖石浅底上 9.87:1 定义金盘边界 */
  --tb-center-highlight: linear-gradient(180deg, rgba(255, 255, 255, 0.05) 0%, transparent 100%);
  --tb-center-inner-shadow: linear-gradient(0deg, rgba(168, 137, 74, 0.30) 0%, transparent 100%);

  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 104rpx;
  background-color: var(--tb-bar-bg);
  background-image: var(--tb-paper-noise);
  display: flex;
  justify-content: space-around;
  align-items: center;
  z-index: 1000;
  padding-top: 8rpx;
  padding-bottom: env(safe-area-inset-bottom, 0);
  box-sizing: border-box;
  overflow: visible;
  animation-name: tabbar-fade-in;
  animation-duration: 700ms;
  animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  animation-delay: 300ms;
  animation-fill-mode: forwards;
}

@keyframes tabbar-fade-in {
  0% {
    opacity: 0;
    transform: translateY(16rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

.tab-bar::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent 0%, #C9A24B 50%, transparent 100%); /* 金发丝顶线 = --lux-gold-line 值 */
  pointer-events: none;
}

/* ================================================================
   标签项 — 基础结构
   ================================================================ */
.tab-bar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 100%;
  position: relative;
}

/* ================================================================
   图标包裹层 — 金圆点容器（64rpx 圆形；选中 = 金平涂 + 深绿描边 + 深绿晕）
   ================================================================ */
.tab-bar-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 4rpx;
  background: rgba(31, 58, 31, 0.06);
  border: 1rpx solid rgba(31, 58, 31, 0.14);
  transition-property: transform, background, border-color, box-shadow;
  transition-duration: 320ms;
  transition-timing-function: cubic-bezier(0.19, 1, 0.22, 1);
}

.tab-bar-item.active .tab-bar-icon-wrap {
  background: #C9A24B;
  border: 2rpx solid #1F3A1F;
  box-shadow: 0 0 0 8rpx rgba(31, 58, 31, 0.15);
  transform: translateY(-2rpx);
}

/* ================================================================
   图标 — 非选中 line 资产（fill=currentColor 随文字色）；选中切换 ink 资产（见 wxml 三元）
   ================================================================ */
.tab-bar-icon {
  width: 36rpx;
  height: 36rpx;
  color: #5A564C; /* line 图标 fill=currentColor 跟随文字色（暖石浅底 5.79:1 AA，= --text-secondary） */
  transition: opacity 320ms cubic-bezier(0.19, 1, 0.22, 1),
              transform 320ms cubic-bezier(0.34, 1.15, 0.64, 1);
  opacity: 1;
}

.tab-bar-item.active .tab-bar-icon {
  color: #1A1A17; /* ink 资产 fill 写死无需跟随；设上防呆 */
  opacity: 1;
  transform: translateY(-1rpx);
}

/* ================================================================
   文字 — 极轻，宽字距；暖石浅底上用暖炭灰表达非选中
   ================================================================ */
.tab-bar-text {
  font-size: 18rpx;
  font-weight: 400;
  color: #5A564C; /* 暖石浅底非选中文字 5.79:1 AA（= --text-secondary / --zy-text-2） */
  line-height: 1;
  transition: opacity 320ms cubic-bezier(0.19, 1, 0.22, 1),
              transform 320ms cubic-bezier(0.19, 1, 0.22, 1);
  letter-spacing: 0.02em;
}

.tab-bar-item.active .tab-bar-text {
  color: #1F3A1F; /* 金在浅底不可作文字 1.90✗ → 深绿 9.87:1（= var(--zy-tabbar-item-active)） */
  font-weight: 600;
  letter-spacing: 0.06em;
}

/* ================================================================
   中心按钮 — 香槟金圆钮（墨绿半透背衬 + 呼吸光晕）
   ================================================================ */
.tab-bar-item-center {
  position: relative;
  overflow: visible !important;
  flex: 1 1 0 !important;
}

.tab-bar-item-center::before,
.tab-bar-item-center::after {
  display: none !important;
}

.center-button {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: var(--tb-center-bg);
  position: relative;
  overflow: visible;
  box-shadow: var(--tb-center-ring), var(--tb-center-shadow);
  margin-top: -48rpx;
  animation-name: center-btn-glow;
  animation-duration: 5000ms;
  animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  animation-delay: 1500ms;
  animation-fill-mode: forwards;
  animation-iteration-count: infinite;
  transition: transform 180ms cubic-bezier(0.25, 0.1, 0.25, 1),
              opacity 320ms cubic-bezier(0.19, 1, 0.22, 1);
}

@keyframes center-btn-glow {
  0%, 100% {
    transform: scale(1);
    opacity: 1;
  }
  50% {
    transform: scale(1.04);
    opacity: 1;
  }
}

/* 顶部金属高光 */
.center-button::before {
  content: '';
  position: absolute;
  top: 6rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 50%;
  height: 24rpx;
  background: var(--tb-center-highlight);
  border-radius: 50%;
  z-index: 1;
  pointer-events: none;
}

/* 底部微阴影凹陷（珠宝感） */
.center-button::after {
  content: '';
  position: absolute;
  bottom: 6rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 40%;
  height: 16rpx;
  background: var(--tb-center-inner-shadow);
  border-radius: 50%;
  z-index: 1;
  pointer-events: none;
}

.center-button-icon {
  width: 40rpx;
  height: 40rpx;
  position: relative;
  z-index: 2;
  margin-bottom: 0;
  transition-property: transform;
  transition-duration: 320ms;
  transition-timing-function: cubic-bezier(0.34, 1.15, 0.64, 1);
}

.center-button-text {
  font-size: 18rpx;
  font-weight: 600;
  color: var(--text-on-accent);
  line-height: 1;
  position: relative;
  z-index: 2;
  letter-spacing: 0.08em;
  margin-top: 4rpx;
}

.tab-bar-item-center.active .center-button {
  box-shadow: var(--tb-center-ring), var(--tb-center-shadow-active);
}

.tab-bar-item-center.active .center-button-icon {
  transform: translateY(-2rpx) scale(1.06);
}

.tab-bar-item-center.active .center-button-text {
  letter-spacing: 0.12em;
}
