/* ================================================================
   custom-tab-bar/index.wxss · AROORO TabBar · 方案A 悬浮缎面珠宝盘
   ----------------------------------------------------------------
   高奢 TabBar（DADDY 选定方案 A · 悬浮缎面珠宝盘）：
     · 悬浮胶囊：缎面渐变底 + 纸纹(::before) + 顶部高光(::after)
     · 选中指示：深绿宝石底(icon-wrap::after 弹入) + 白图标 + 绿晕
     · 中央按钮：香槟金平涂 + 炭墨镶边 + 独立金晕层呼吸
       （珠宝静置托盘上，只有光在呼吸；深绿=选中信号、金=CTA 信号）
     · 图标线条细，文字极轻；选中态切换炭墨资产
   ----------------------------------------------------------------
   设计系统：styles/theme-teal.wxss（深森林绿体系 · 事实生效层）
   注意：styles/design-tokens.wxss 的 --zy-tabbar-* 为橄榄绿旧值，
        已被 app.wxss 中后置的 theme-teal.wxss 覆盖，勿直接依赖。
   ================================================================ */

/* 显式导入令牌层：即使组件样式隔离，也保证令牌在本组件作用域可解析 */
@import '../styles/theme-teal.wxss';

/* ================================================================
   导航栏容器 — 悬浮缎面胶囊（底渐变 + 纸纹 ::before + 高光 ::after）
   ================================================================ */
.tab-bar {
  /* ---- 组件内局部令牌 ----------------------------------------
     声明在 .tab-bar 而非 :host：本组件 WXML 用 <root-portal> 包裹，
     子树会被搬出宿主节点，:host 上的自定义属性无法继承进来。
     .tab-bar 是 portal 子树的根，其后代（中心按钮等）均可继承。
     以下值在 theme-teal 中无精确等价物，就地令牌化以保证零外观改变。 */
  --tb-paper-noise: url("data:image/png;base64,");   /* 纸纹 base64 = styles/design-tokens.wxss --zy-paper-noise 同源值（逐字符复制，48×48 · 4% alpha） */
  --tb-center-bg: var(--zy-accent);                /* 香槟金平涂底（引用 theme-teal 活令牌 #C9A24B） */
  position: fixed;
  bottom: 0; /* 物理贴屏底；68rpx 指示器区被胶囊自身遮罩，Home Indicator 不受影响 */
  left: 0;
  right: 0;
  height: calc(80rpx + env(safe-area-inset-bottom, 0)); /* 可见区 80rpx（二次降高 100→80），safe-area 增量藏于底部；非 safe-area env=0 回原样 */
  border-radius: 0; /* 取消胶囊状态：平条整宽贴底，与顶部极光条呼应 */
  background: linear-gradient(118deg, #2D4F2D 0%, #0F2410 16%, #2D4F2D 28%, #1A361F 40%, #39553F 48%, #142C18 56%, #0F2410 60%, #2E4C36 64%, #4E6D56 67%, #5A7C63 68.5%, #4A6952 70%, #35553E 74%, #16301A 80%, #0F2410 88%, #2D4F2D 100%); /* 极光帘幕：与顶部 navbar/topbar 共用同款 118° 渐变（暗谷/外帘辉光/热核 #5A7C63@68.5%），角度与层次完全对齐 */
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.30); /* 平条贴底：顶部投影托起，去除原胶囊的下投影 */
  display: flex;
  justify-content: space-around;
  align-items: flex-start; /* 80rpx 下 env≈68rpx，center 会让内容整体下沉；改 flex-start 把内容钉回顶部 80rpx 带 */
  z-index: 1000;
  padding: 0 !important; /* 中和 wxml 行内 padding-bottom:{{tabBarPadding}}rpx —— 悬浮胶囊无需内边距（wxml/js 零改动） */
  box-sizing: border-box;
  overflow: visible;
  animation-name: tabbar-fade-in;
  animation-duration: 700ms;
  animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  animation-delay: 300ms;
  animation-fill-mode: forwards;
}

@keyframes tabbar-fade-in {
  0% {
    opacity: 0;
    transform: translateY(12rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 缎面包裹纸纹层：纯装饰、不响应点击；圆角跟随胶囊 */
.tab-bar::before {
  display: none; /* 深绿极光底无需浅色纸纹；保持与顶部极光一致的洁净观感 */
}

/* 顶部缎面高光：左右各留 24rpx，避免 9999rpx 圆角处戳出 */
.tab-bar::after {
  content: '';
  position: absolute;
  top: 1rpx;
  left: 24rpx;
  right: 24rpx;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.65) 50%, transparent);
  pointer-events: none;
}

/* ================================================================
   标签项 — 基础结构
   ================================================================ */
.tab-bar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 80rpx; /* 与胶囊可见区等高；父级 align-items:flex-start，safe-area 增量不参与排版 */
  margin-top: 20rpx; /* 全部 tab 项整体下移 20rpx（仅按钮内容，胶囊外形/位置不变）；flex-start 下相对胶囊顶偏移，内容中心 40→60rpx；中间钮 margin-top:-4rpx 相对项顶，钮心随之落到 60rpx，与普通项对齐 */
  position: relative;
  z-index: 1; /* 提至缎面纸纹层(::before z-index:0)之上 */
}

/* ================================================================
   图标包裹层 — 恒 44×44rpx 锚点（金圆宝石底 ::after + 镶边金晕挂在它上面；
   非选中透明底、图标 36rpx 居中；选中/非选中尺寸一致，文字位不跳）
   ================================================================ */
.tab-bar-icon-wrap {
  position: relative;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: none;
  border: none;
  border-radius: 50%; /* 圆形容器：镶边环/金晕 box-shadow 跟随圆形，与金圆底同构（P1 修复） */
  transition-property: box-shadow;
  transition-duration: 320ms;
  transition-timing-function: cubic-bezier(0.19, 1, 0.22, 1);
}

/* 金圆宝石底：选中态弹入的 44rpx 圆（替换原 8rpx 金点，四边 0 铺满 icon-wrap）；
   中央 CTA 无此结构，天然不出现；仅 .active 显示 */
.tab-bar-icon-wrap::after {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  border-radius: 50%;
  background: rgba(201, 162, 75, 0.22); /* 选中宝石底：淡金圆盘（金=选中信号），图标金叠其上仍可读 */
  z-index: 0;
  opacity: 0;
  transform: scale(0.8);
  pointer-events: none;
}

.tab-bar-item.active .tab-bar-icon-wrap {
  /* 选中金晕（静态，不给圆底加呼吸）；深绿底上金晕醒目 */
  box-shadow: 0 0 16rpx rgba(201, 162, 75, 0.42);
}

.tab-bar-item.active .tab-bar-icon-wrap::after {
  animation: gem-in 150ms cubic-bezier(0.34, 1.56, 0.64, 1) forwards; /* 深绿宝石弹入 overshoot */
}

@keyframes gem-in {
  0% {
    opacity: 0;
    transform: scale(0.8);
  }
  60% {
    opacity: 1;
    transform: scale(1.06);
  }
  100% {
    opacity: 1;
    transform: scale(1);
  }
}

/* ================================================================
   图标 — 非选中 line 资产（fill=currentColor 随文字色）；选中切换 ink 资产（见 wxml 三元）
   ================================================================ */
.tab-bar-icon {
  width: 36rpx;
  height: 36rpx;
  color: #FFFFFF; /* 未选中图标纯白，深绿极光底上清晰（currentColor 跟随 line 资产） */
  position: relative;
  z-index: 1; /* 覆盖金圆宝石底(z-index:0)之上 */
  transition: opacity 320ms cubic-bezier(0.19, 1, 0.22, 1),
              transform 320ms cubic-bezier(0.34, 1.15, 0.64, 1);
  opacity: 1;
}

.tab-bar-item.active .tab-bar-icon {
  color: #C9A24B; /* 选中图标金（金 SVG 已硬编码金；此处兜底 currentColor 情形） */
  opacity: 1;
  transform: scale(0.78); /* 仅作用于图标自身；worklet 按压 scale 作用于 icon-wrap(wrap 层)，无 transform 冲突 */
}

/* ================================================================
   文字 — 极轻，宽字距；缎面上用暖炭灰表达非选中、近墨炭表达选中
   ================================================================ */
.tab-bar-text {
  font-size: 18rpx;
  font-weight: 400;
  color: #FFFFFF; /* 未选中文字纯白，深绿极光底上清晰 */
  line-height: 1;
  margin-top: 5rpx; /* 图标-文字间距 6→5rpx，配合 80rpx 带 */
  transition: opacity 320ms cubic-bezier(0.19, 1, 0.22, 1),
              transform 320ms cubic-bezier(0.19, 1, 0.22, 1);
  letter-spacing: 0.04em;
}

.tab-bar-item.active .tab-bar-text {
  color: #C9A24B; /* 缎面暖石金 · 选中信号 */
  font-weight: 600;
  letter-spacing: 0.08em; /* 编辑级字距 */
}

/* 选中态局部暗座：极光亮带上金字需可读 → 选中项内嵌深绿径向暗座（中心实、边缘透明），
   金图标/金字落在暗座上对比 ~4.6:1（AA）；中央金钮自带金底，用 :not 排除，光带在其余区域完整透出 */
.tab-bar-item.active:not(.tab-bar-item-center) {
  background: radial-gradient(130% 120% at 50% 38%, rgba(11, 26, 14, 0.88) 0%, rgba(11, 26, 14, 0.50) 52%, rgba(11, 26, 14, 0) 100%);
}

/* ================================================================
   中心按钮 — 珠宝化金钮（香槟金平涂 + 炭墨镶边 + 独立金晕呼吸层）
   ================================================================ */
.tab-bar-item-center {
  position: relative;
  overflow: visible !important;
  flex: 1 1 0 !important;
}

.tab-bar-item-center::before,
.tab-bar-item-center::after {
  display: none !important;
}

.center-button {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--tb-center-bg);
  position: relative; /* 绿线外环 ::before / 金晕 ::after 的定位锚点 */
  overflow: visible;
  /* 炭墨镶边(珠宝镶嵌底座，替代旧 6rpx 深绿环) + 金晕 + 中性投影；静态，禁动画化 */
  box-shadow: 0 0 0 1rpx rgba(26, 26, 23, 0.16),
              0 0 28rpx rgba(201, 162, 75, 0.35),
              0 10rpx 24rpx rgba(26, 26, 23, 0.16);
  margin-top: -4rpx; /* 88rpx 钮在 80rpx 可见区垂直居中：钮心 = 40rpx(−4+44)，与胶囊可见区中心重合（上下各凸出 4rpx） */
  transition: transform 180ms cubic-bezier(0.25, 0.1, 0.25, 1),
              opacity 320ms cubic-bezier(0.19, 1, 0.22, 1);
}

/* 绿色细线外环（选中态）：挂在 .center-button 上，与 .tab-bar-item-center::before
   的 display:none 屏蔽层不同级，互不影响；与金晕层 ::after 完全分离。
   几何：四边外扩 4rpx（直径 88→96），2rpx 深绿环占外缘 4→6rpx，
        与炭墨镶边(0→1rpx)之间留 3rpx 净金间隙，外环总直径 100。
   Skyline 铁律：环用 box-shadow spread 通道画，不用 border；四边显式写，不用 inset 简写。 */
.center-button::before {
  content: '';
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  bottom: -4rpx;
  left: -4rpx;
  border-radius: 50%;
  background: none;
  box-shadow: 0 0 0 2rpx rgba(255, 255, 255, 0.9); /* 深绿底上深绿环不可见 → 改白环作选中信号（金钮上白环醒目） */
  opacity: 0;
  pointer-events: none;
  transition: opacity 150ms cubic-bezier(0.19, 1, 0.22, 1); /* 仅淡入，不缩放不呼吸（呼吸交给 ::after 金晕） */
}

.tab-bar-item-center.active .center-button::before {
  opacity: 1;
}

/* 独立金晕层：只有光在呼吸（珠宝静置托盘上，按钮体不再缩放） */
.center-button::after {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  border-radius: inherit;
  box-shadow: 0 0 28rpx rgba(201, 162, 75, 0.35);
  opacity: 0.72;
  animation: halo-breath 1.6s ease-in-out infinite;
  pointer-events: none;
}

@keyframes halo-breath {
  0%, 100% {
    opacity: 0.72;
    transform: scale(1);
  }
  50% {
    opacity: 1;
    transform: scale(1.06);
  }
}

.center-button-icon {
  width: 38rpx;
  height: 38rpx;
  position: relative;
  z-index: 2;
  margin-bottom: 0;
  transition-property: transform;
  transition-duration: 320ms;
  transition-timing-function: cubic-bezier(0.34, 1.15, 0.64, 1);
}

.center-button-text {
  font-size: 18rpx;
  font-weight: 600;
  color: #FFFFFF; /* 极光绿底上纯白（与未选中普通钮一致） */
  line-height: 1;
  position: relative;
  z-index: 2;
  letter-spacing: 0.08em;
  margin-top: 4rpx;
}

.tab-bar-item-center.active .center-button-icon {
  transform: translateY(-2rpx) scale(1.06);
}

.tab-bar-item-center.active .center-button-text {
  color: #C9A24B; /* 选中金（与普通钮选中态一致） */
  letter-spacing: 0.12em;
}

