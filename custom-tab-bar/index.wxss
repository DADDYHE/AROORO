/* ================================================================
   custom-tab-bar/index.wxss · AROORO TabBar · 方案A 悬浮缎面珠宝盘
   ----------------------------------------------------------------
   高奢 TabBar（DADDY 选定方案 A · 悬浮缎面珠宝盘）：
     · 悬浮胶囊：缎面渐变底 + 纸纹(::before) + 顶部高光(::after)
     · 选中指示：金点(icon-wrap::after 弹入) + 图标炭墨 + 金晕
     · 中央按钮：香槟金平涂 + 炭墨镶边 + 独立金晕层呼吸
       （珠宝静置托盘上，只有光在呼吸；深绿完全退出 tabBar）
     · 图标线条细，文字极轻；选中态切换炭墨资产
   ----------------------------------------------------------------
   设计系统：styles/theme-teal.wxss（深森林绿体系 · 事实生效层）
   注意：styles/design-tokens.wxss 的 --zy-tabbar-* 为橄榄绿旧值，
        已被 app.wxss 中后置的 theme-teal.wxss 覆盖，勿直接依赖。
   ================================================================ */

/* 显式导入令牌层：即使组件样式隔离，也保证令牌在本组件作用域可解析 */
@import '../styles/theme-teal.wxss';

/* ================================================================
   启动屏覆盖层
   ================================================================ */
.splash-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100vh;
  z-index: 99999;
  background: var(--zy-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 1;
  transition-property: opacity;
  transition-duration: 900ms;
  transition-timing-function: cubic-bezier(0.19, 1, 0.22, 1);
}

.splash-overlay.splash-fade-out {
  opacity: 0;
  pointer-events: none;
}

.splash-image {
  width: 100%;
  height: 100%;
}

/* ================================================================
   导航栏容器 — 悬浮缎面胶囊（底渐变 + 纸纹 ::before + 高光 ::after）
   ================================================================ */
.tab-bar {
  /* ---- 组件内局部令牌 ----------------------------------------
     声明在 .tab-bar 而非 :host：本组件 WXML 用 <root-portal> 包裹，
     子树会被搬出宿主节点，:host 上的自定义属性无法继承进来。
     .tab-bar 是 portal 子树的根，其后代（中心按钮等）均可继承。
     以下值在 theme-teal 中无精确等价物，就地令牌化以保证零外观改变。 */
  --tb-paper-noise: url("data:image/png;base64,");   /* 纸纹 base64 = styles/design-tokens.wxss --zy-paper-noise 同源值（逐字符复制，48×48 · 4% alpha） */
  --tb-center-bg: var(--zy-accent);                /* 香槟金平涂底（引用 theme-teal 活令牌 #C9A24B） */
  position: fixed;
  bottom: 28rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom, 0));
  left: 40rpx;
  right: 40rpx;
  height: 132rpx;
  border-radius: 9999rpx;
  background: linear-gradient(180deg, #F7F5EF 0%, #ECE4D4 100%);
  box-shadow: 0 10rpx 24rpx rgba(26, 26, 23, 0.10), 0 28rpx 64rpx rgba(26, 26, 23, 0.18);
  display: flex;
  justify-content: space-around;
  align-items: center;
  z-index: 1000;
  padding: 0 !important; /* 中和 wxml 行内 padding-bottom:{{tabBarPadding}}rpx —— 悬浮胶囊无需内边距（wxml/js 零改动） */
  box-sizing: border-box;
  overflow: visible;
  animation-name: tabbar-fade-in;
  animation-duration: 700ms;
  animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  animation-delay: 300ms;
  animation-fill-mode: forwards;
}

@keyframes tabbar-fade-in {
  0% {
    opacity: 0;
    transform: translateY(24rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 缎面包裹纸纹层：纯装饰、不响应点击；圆角跟随胶囊 */
.tab-bar::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background-image: var(--tb-paper-noise);
  background-repeat: repeat;
  z-index: 0;
  pointer-events: none;
}

/* 顶部缎面高光：左右各留 24rpx，避免 9999rpx 圆角处戳出 */
.tab-bar::after {
  content: '';
  position: absolute;
  top: 1rpx;
  left: 24rpx;
  right: 24rpx;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.65) 50%, transparent);
  pointer-events: none;
}

/* ================================================================
   标签项 — 基础结构
   ================================================================ */
.tab-bar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 100%;
  position: relative;
  z-index: 1; /* 提至缎面纸纹层(::before z-index:0)之上 */
}

/* ================================================================
   图标包裹层 — 裸盒锚点（36×36rpx 对齐图标实际尺寸；金点 + 金晕挂在它上面）
   ================================================================ */
.tab-bar-icon-wrap {
  position: relative;
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: none;
  border: none;
  border-radius: 0;
  transition-property: box-shadow;
  transition-duration: 320ms;
  transition-timing-function: cubic-bezier(0.19, 1, 0.22, 1);
}

/* 金点：选中态弹入图标正上方 8rpx；中央 CTA 无此结构，天然不出现 */
.tab-bar-icon-wrap::after {
  content: '';
  position: absolute;
  top: -8rpx;
  left: 50%;
  margin-left: -4rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #C9A24B;
  box-shadow: 0 0 6rpx rgba(201, 162, 75, 0.5);
  opacity: 0;
  transform: scale(0);
  pointer-events: none;
}

.tab-bar-item.active .tab-bar-icon-wrap {
  box-shadow: 0 0 20rpx rgba(201, 162, 75, 0.32); /* 金晕（静态） */
}

.tab-bar-item.active .tab-bar-icon-wrap::after {
  animation: gold-dot-in 150ms cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

@keyframes gold-dot-in {
  0% {
    opacity: 0;
    transform: scale(0);
  }
  70% {
    opacity: 1;
    transform: scale(1.15);
  }
  100% {
    opacity: 1;
    transform: scale(1);
  }
}

/* ================================================================
   图标 — 非选中 line 资产（fill=currentColor 随文字色）；选中切换 ink 资产（见 wxml 三元）
   ================================================================ */
.tab-bar-icon {
  width: 36rpx;
  height: 36rpx;
  color: #7D7768; /* line 图标 fill=currentColor 跟随（缎面深端 3.53:1，非文本 3:1 ✓） */
  transition: opacity 320ms cubic-bezier(0.19, 1, 0.22, 1),
              transform 320ms cubic-bezier(0.34, 1.15, 0.64, 1);
  opacity: 1;
}

.tab-bar-item.active .tab-bar-icon {
  color: #1A1A17; /* 炭墨（缎面深端 13.8:1 AAA）；scale 放图标子层，不与 worklet 按压缩放冲突 */
  opacity: 1;
  transform: scale(1.06);
}

/* ================================================================
   文字 — 极轻，宽字距；缎面上用暖炭灰表达非选中、近墨炭表达选中
   ================================================================ */
.tab-bar-text {
  font-size: 18rpx;
  font-weight: 400;
  color: #6B6559; /* 缎面深端 4.58:1 AA */
  line-height: 1;
  margin-top: 6rpx;
  transition: opacity 320ms cubic-bezier(0.19, 1, 0.22, 1),
              transform 320ms cubic-bezier(0.19, 1, 0.22, 1);
  letter-spacing: 0.04em;
}

.tab-bar-item.active .tab-bar-text {
  color: #2A2820; /* 缎面深端 11.68:1 AAA */
  font-weight: 600;
  letter-spacing: 0.08em; /* 编辑级字距 */
}

/* ================================================================
   中心按钮 — 珠宝化金钮（香槟金平涂 + 炭墨镶边 + 独立金晕呼吸层）
   ================================================================ */
.tab-bar-item-center {
  position: relative;
  overflow: visible !important;
  flex: 1 1 0 !important;
}

.tab-bar-item-center::before,
.tab-bar-item-center::after {
  display: none !important;
}

.center-button {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: var(--tb-center-bg);
  position: relative;
  overflow: visible;
  /* 炭墨镶边(珠宝镶嵌底座，替代旧 6rpx 深绿环) + 金晕 + 中性投影；静态，禁动画化 */
  box-shadow: 0 0 0 1rpx rgba(26, 26, 23, 0.16),
              0 0 28rpx rgba(201, 162, 75, 0.35),
              0 10rpx 24rpx rgba(26, 26, 23, 0.16);
  margin-top: -48rpx;
  transition: transform 180ms cubic-bezier(0.25, 0.1, 0.25, 1),
              opacity 320ms cubic-bezier(0.19, 1, 0.22, 1);
}

/* 独立金晕层：只有光在呼吸（珠宝静置托盘上，按钮体不再缩放） */
.center-button::after {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: inherit;
  box-shadow: 0 0 28rpx rgba(201, 162, 75, 0.35);
  opacity: 0.72;
  animation: halo-breath 1.6s ease-in-out infinite;
  pointer-events: none;
}

@keyframes halo-breath {
  0%, 100% {
    opacity: 0.72;
    transform: scale(1);
  }
  50% {
    opacity: 1;
    transform: scale(1.06);
  }
}

.center-button-icon {
  width: 40rpx;
  height: 40rpx;
  position: relative;
  z-index: 2;
  margin-bottom: 0;
  transition-property: transform;
  transition-duration: 320ms;
  transition-timing-function: cubic-bezier(0.34, 1.15, 0.64, 1);
}

.center-button-text {
  font-size: 18rpx;
  font-weight: 600;
  color: var(--text-on-accent);
  line-height: 1;
  position: relative;
  z-index: 2;
  letter-spacing: 0.08em;
  margin-top: 4rpx;
}

.tab-bar-item-center.active .center-button-icon {
  transform: translateY(-2rpx) scale(1.06);
}

.tab-bar-item-center.active .center-button-text {
  letter-spacing: 0.12em;
}
