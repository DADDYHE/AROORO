/* ================================================================
   custom-tab-bar/index.wxss · AROORO TabBar 选中/未选中效果
   2026-07-29 基于设计系统令牌重新设计
   ----------------------------------------------------------------
   设计系统令牌：
     选中色 --zy-tabbar-item-active: #4F5E35（橄榄绿）
     未选中色 --zy-tabbar-item-inactive: #9A9489（暖灰）
     选中底 --zy-tabbar-item-active-bg: rgba(79, 94, 53, 0.08)
     点缀金 --zy-accent: #B8893A
     动效 --zy-dur-base: 250ms / --zy-ease-standard: cubic-bezier(0.4,0,0.2,1)
   ================================================================ */

/* ================================================================
   AROORO 启动屏覆盖层 — 覆盖全屏（含 tabBar 本身）
   ================================================================ */
.splash-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100vh;
  z-index: 99999;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 1;
}

.splash-overlay.splash-fade-out {
  opacity: 0;
  pointer-events: none;
}

.splash-image {
  width: 100%;
  height: 100%;
}

/* ================================================================
   导航栏容器 — 纯白底 + 顶部细线
   ================================================================ */
.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 128rpx;
  background: #FFFFFF;
  border-top: 2rpx solid var(--border-color, #D8DCCE);
  display: flex;
  justify-content: space-around;
  align-items: center;
  z-index: 1000;
  padding-top: 12rpx;
  padding-bottom: env(safe-area-inset-bottom, 0);
  box-sizing: border-box;
  overflow: visible;
}

.tab-bar::before {
  display: none;
}

/* ================================================================
   标签项 — 基础结构
   ================================================================ */
.tab-bar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 100%;
  position: relative;
}

/* ---- 选中态：顶部金色指示点 ---- */
.tab-bar-item.active::after {
  content: '';
  position: absolute;
  top: 2rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #B8893A;
  opacity: 1;
}

/* ================================================================
   图标包裹层 — 选中态芯片背景
   ================================================================ */
.tab-bar-icon-wrap {
  width: 72rpx;
  height: 56rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 6rpx;
  background: transparent;
}

/* 选中态：浅橄榄绿芯片底 */
.tab-bar-item.active .tab-bar-icon-wrap {
  background: rgba(79, 94, 53, 0.08);
}

/* ================================================================
   图标 — 选中/未选中色彩区分
   ================================================================ */
.tab-bar-icon {
  width: 48rpx;
  height: 48rpx;
}

/* 未选中：暖灰半透明 */
.tab-bar-icon {
  opacity: 0.45;
}

/* 选中：橄榄绿色调滤镜 */
.tab-bar-item.active .tab-bar-icon {
  opacity: 1;
  filter: brightness(0) saturate(100%) invert(31%) sepia(14%) saturate(647%) hue-rotate(41deg) brightness(94%) contrast(93%);
}

/* ================================================================
   文字 — 选中/未选中色彩区分
   ================================================================ */
.tab-bar-text {
  font-size: 20rpx;
  font-weight: 500;
  color: #9A9489;
  line-height: 1;
}

/* 选中态文字：橄榄绿 + 加粗 */
.tab-bar-item.active .tab-bar-text {
  color: #4F5E35;
  font-weight: 600;
}

/* ================================================================
   中心按钮 — 橄榄绿渐变浮动圆钮
   ================================================================ */
.tab-bar-item-center {
  position: relative;
  overflow: visible !important;
  flex: 0 0 0 !important;
}

.tab-bar-item-center::before,
.tab-bar-item-center::after {
  display: none !important;
}

.center-button {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: linear-gradient(160deg, #4F5E35 0%, #3A4626 100%);
  position: relative;
  overflow: visible;
  box-shadow:
    0 8rpx 24rpx rgba(79, 94, 53, 0.30),
    0 3rpx 10rpx rgba(79, 94, 53, 0.18);
  margin-top: -56rpx;
  border: none;
}

/* 顶部微高光 */
.center-button::after {
  content: '';
  position: absolute;
  top: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 56%;
  height: 28rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.18) 0%, transparent 100%);
  border-radius: 50%;
  z-index: 1;
  pointer-events: none;
}

.center-button-icon {
  width: 48rpx;
  height: 48rpx;
  position: relative;
  z-index: 2;
  margin-bottom: 0;
}

.center-button-text {
  font-size: 18rpx;
  font-weight: 600;
  color: #FAFAF6;
  line-height: 1;
  position: relative;
  z-index: 2;
  letter-spacing: 0.5rpx;
  margin-top: 2rpx;
}

/* 选中态中心按钮：加深阴影 */
.tab-bar-item-center.active .center-button {
  box-shadow:
    0 10rpx 28rpx rgba(79, 94, 53, 0.38),
    0 4rpx 14rpx rgba(79, 94, 53, 0.22);
}
