<!-- custom-tab-bar/index.wxml -->
<view class="tab-bar">
  <view class="tab-bar-item {{selected === 0 ? 'active' : ''}}" data-path="/pages/home/index" data-index="{{0}}" catchtap="switchTab">
    <van-icon class="tab-bar-icon" name="{{selected === 0 ? '/images/icons/home-white.svg' : '/images/icons/home-line.svg'}}" size="48" />
    <text class="tab-bar-text">首页</text>
  </view>
  <view class="tab-bar-item {{selected === 1 ? 'active' : ''}}" data-path="/pages/booking/calendar" data-index="{{1}}" catchtap="switchTab">
    <van-icon class="tab-bar-icon" name="{{selected === 1 ? '/images/icons/booking-white.svg' : '/images/icons/booking-line.svg'}}" size="48" />
    <text class="tab-bar-text">预订</text>
  </view>
  <view class="tab-bar-item {{selected === 2 ? 'active' : ''}}" data-path="/pages/messages/index" data-index="{{2}}" catchtap="switchTab">
    <van-icon class="tab-bar-icon" name="{{selected === 2 ? '/images/icons/messages-white.svg' : '/images/icons/messages-line.svg'}}" size="48" />
    <text class="tab-bar-text">消息</text>
  </view>
  <view class="tab-bar-item {{selected === 3 ? 'active' : ''}}" data-path="/pages/profile/index" data-index="{{3}}" catchtap="switchTab">
    <van-icon class="tab-bar-icon" name="{{selected === 3 ? '/images/icons/profile-white.svg' : '/images/icons/profile-line.svg'}}" size="48" />
    <text class="tab-bar-text">我的</text>
  </view>
</view>
